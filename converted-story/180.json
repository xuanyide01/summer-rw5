[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i158"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"紬同学她今天也在那里吧。"},{"op":"text","speaker":"","text":"还哼着那动听又奇妙的小曲守着灯塔吗。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i129"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i14301"},{"op":"text","speaker":"紬","text":"“姆叽叽叽叽叽……姆叽姆叽叽叽叽叽―”"},{"op":"text","speaker":"","text":"她还给她的小曲编了支奇妙的舞蹈。"},{"op":"image","layer":1,"image":"i14293"},{"op":"text","speaker":"紬","text":"“姆叽叽……姆叽叽……叽～”"},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"image","layer":1,"image":"i14266"},{"op":"text","speaker":"紬","text":"“姆叽～叽～叽～叽……叽～叽～叽。”"},{"op":"image","layer":1,"image":"i14278"},{"op":"text","speaker":"紬","text":"“……呼。”"},{"op":"image","layer":1,"image":"i14234"},{"op":"text","speaker":"紬","text":"“鹰原先生，你好啊。”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“……你在干什么。”"},{"op":"image","layer":1,"image":"i14196"},{"op":"text","speaker":"紬","text":"“这是丰胸体操。”"},{"op":"text","speaker":"羽依里","text":"“你还在练这种玩意啊。”"},{"op":"image","layer":1,"image":"i14272"},{"op":"text","speaker":"紬","text":"“是的。”"},{"op":"image","layer":1,"image":"i14333"},{"op":"text","speaker":"紬","text":"“你要是这么说丰胸体操的话，师傅饶不了你的哦？”"},{"op":"text","speaker":"羽依里","text":"“饶不了我？”"},{"op":"image","layer":1,"image":"i14344"},{"op":"text","speaker":"紬","text":"“你会被师傅打得鼻青脸肿的……”"},{"op":"text","speaker":"","text":"相当暴力。"},{"op":"image","layer":1,"image":"i14294"},{"op":"text","speaker":"紬","text":"“……用奶子。”"},{"op":"text","speaker":"羽依里","text":"“这……”"},{"op":"text","speaker":"羽依里","text":"“……真够刺激的。”"},{"op":"image","layer":1,"image":"i14257"},{"op":"text","speaker":"紬","text":"“你要一起来吗？”"},{"op":"text","speaker":"羽依里","text":"“我做丰胸体操？”"},{"op":"choice","variable":6001,"items":[{"text":"一起变大吧！","value":0,"condition":1},{"text":"随便做做就行了吧？","value":1,"condition":1}]},{"op":"if","truth":false,"target":63,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“OK！一起变大吧！”"},{"op":"image","layer":1,"image":"i14265"},{"op":"text","speaker":"紬","text":"“噢～很有干劲呀！”"},{"op":"image","layer":1,"image":"i14277"},{"op":"text","speaker":"紬","text":"“照这股尽头，明天就能变得沉甸甸的。”"},{"op":"text","speaker":"羽依里","text":"“沉甸甸！”"},{"op":"text","speaker":"羽依里","text":"“这有点头疼。”"},{"op":"image","layer":1,"image":"i14289"},{"op":"text","speaker":"紬","text":"“这样半桶水的决心可不行。”"},{"op":"image","layer":1,"image":"i14302"},{"op":"text","speaker":"紬","text":"“会变得软塌塌的。”"},{"op":"text","speaker":"羽依里","text":"“软塌塌！”"},{"op":"text","speaker":"羽依里","text":"“……还是算了吧。”"},{"op":"image","layer":1,"image":"i14196"},{"op":"text","speaker":"紬","text":"“是吗。也不能强迫你。”"},{"op":"goto","target":81},{"op":"text","speaker":"羽依里","text":"“随便做做就行了吧？”"},{"op":"image","layer":1,"image":"i14289"},{"op":"text","speaker":"紬","text":"“为什么呢？”"},{"op":"text","speaker":"羽依里","text":"“要是大过头了会很麻烦，而且我觉得现在这大小最合适。”"},{"op":"image","layer":1,"image":"i14308"},{"op":"text","speaker":"紬","text":"“现在这大小最合适……吗。”"},{"op":"text","speaker":"羽依里","text":"“嗯，这大小最合适。”"},{"op":"image","layer":1,"image":"i14204"},{"op":"text","speaker":"","text":"只见紬盯着自己的胸。"},{"op":"text","speaker":"","text":"接着……"},{"op":"image","layer":1,"image":"i14231"},{"op":"text","speaker":"紬","text":"“姆啾～……”"},{"op":"text","speaker":"","text":"她害羞了。"},{"op":"text","speaker":"羽依里","text":"“啊，我刚才是指我自己奶子的大小。”"},{"op":"image","layer":1,"image":"i14216"},{"op":"text","speaker":"紬","text":"“姆叽!؟”"},{"op":"image","layer":1,"image":"i14311"},{"op":"text","speaker":"紬","text":"“呜呜～……出了不必要的丑。”"},{"op":"text","speaker":"羽依里","text":"“话说，你嘴里的师傅是指苍？”"},{"op":"image","layer":1,"image":"i14196"},{"op":"text","speaker":"紬","text":"“这两位是不同的师傅。”"},{"op":"image","layer":1,"image":"i14239"},{"op":"text","speaker":"紬","text":"“这个师傅是奶子。”"},{"op":"text","speaker":"羽依里","text":"“抱歉，我听不懂。”"},{"op":"image","layer":1,"image":"i14326"},{"op":"text","speaker":"紬","text":"“就是静久。”"},{"op":"text","speaker":"羽依里","text":"“噢，就是传闻中的那个……”"},{"op":"image","layer":1,"image":"i14355"},{"op":"text","speaker":"紬","text":"“这附近发生的奶子事件，基本上都和静久有关系。”"},{"op":"text","speaker":"羽依里","text":"“感觉跟奶子之神似的……”"},{"op":"text","speaker":"羽依里","text":"“那你的体操有效果吗？”"},{"op":"image","layer":1,"image":"i14291"},{"op":"text","speaker":"紬","text":"“没有，0.1毫米都没变。”"},{"op":"text","speaker":"羽依里","text":"“这…呃……这样啊……”"},{"op":"text","speaker":"","text":"不知道该怎么回复她。"},{"op":"image","layer":1,"image":"i14196"},{"op":"text","speaker":"紬","text":"“但我‘想做的事情’也许就是让奶子变大也说不定。”"},{"op":"image","layer":1,"image":"i14239"},{"op":"text","speaker":"紬","text":"“所以我在做这个体操。”"},{"op":"text","speaker":"羽依里","text":"“我还是陪陪你吧。”"},{"op":"text","speaker":"羽依里","text":"“能教教我丰胸体操吗？”"},{"op":"image","layer":1,"image":"i14196"},{"op":"text","speaker":"紬","text":"“好的。首先将两手合掌――……”"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"image","layer":1,"image":"i14279"},{"op":"text","speaker":"紬","text":"“姆～……叽～……”"},{"op":"text","speaker":"羽依里","text":"“姆～……叽～……”"},{"op":"image","layer":257,"image":"i12150"},{"op":"image","layer":513,"image":"i10290"},{"op":"text","speaker":"良一","text":"“……你们在干啥呢？”"},{"op":"text","speaker":"苍","text":"“攒气？”"},{"op":"text","speaker":"羽依里","text":"“啊，你们……怎么在这？”"},{"op":"image","layer":257,"image":"i12144"},{"op":"image","layer":513,"image":"i10235"},{"op":"text","speaker":"苍","text":"“这是我家的空吕客罐。”"},{"op":"image","layer":257,"image":"i12162"},{"op":"text","speaker":"良一","text":"“我这些是秘密基地里的空吕客罐。”"},{"op":"text","speaker":"羽依里","text":"“噢噢，谢谢你们还特意拿到这来。”"},{"op":"text","speaker":"","text":"他们带来了不少吕客罐。"},{"op":"image","layer":1,"image":"i14211"},{"op":"text","speaker":"紬","text":"“噢噢―……鹰原先生！”"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"image","layer":1,"image":"i14253"},{"op":"text","speaker":"紬","text":"“～～～♪”"},{"op":"text","speaker":"羽依里","text":"“是啊，太好了。”"},{"op":"image","layer":1,"image":"i14234"},{"op":"text","speaker":"紬","text":"“离你踏上阳台的日子不远了。”"},{"op":"image","layer":257,"image":"i10298"},{"op":"text","speaker":"苍","text":"“唉？什么阳台？”"},{"op":"text","speaker":"羽依里","text":"“啊……紬她打算用吕客罐造一个阳台。”"},{"op":"image","layer":1,"image":"i14281"},{"op":"text","speaker":"紬","text":"“是的，我要造一个阳台。”"},{"op":"image","layer":1,"image":"i14302"},{"op":"text","speaker":"紬","text":"“这个夏天，我正在阳台ING。”"},{"op":"image","layer":257,"image":"i10270"},{"op":"text","speaker":"苍","text":"“第一次听到这种说法……”"},{"op":"text","speaker":"羽依里","text":"“我也是。”"},{"op":"image","layer":257,"image":"i10200"},{"op":"text","speaker":"苍","text":"“总之，有了新罐子我会再拿过来的。”"},{"op":"image","layer":1,"image":"i14281"},{"op":"text","speaker":"紬","text":"“麻烦你了。”"},{"op":"image","layer":1,"image":"i14211"},{"op":"text","speaker":"紬","text":"“师傅……呃……”"},{"op":"image","layer":1,"image":"i14200"},{"op":"text","speaker":"紬","text":"“……还有这个裸体男，谢谢你们！”"},{"op":"text","speaker":"羽依里","text":"“……你该不会忘记良一名字了？”"},{"op":"image","layer":1,"image":"i14225"},{"op":"text","speaker":"紬","text":"“对、对不起……”"},{"op":"image","layer":513,"image":"i12168"},{"op":"text","speaker":"良一","text":"“不是吧!؟”"},{"op":"image","layer":513,"image":"i12150"},{"op":"text","speaker":"良一","text":"“羽依里天善这种难记的名字都记住了却记不住我的!؟”"},{"op":"image","layer":1,"image":"i10295"},{"op":"text","speaker":"苍","text":"“啊哈哈，好惨！”"},{"op":"image","layer":1,"image":"i10290"},{"op":"text","speaker":"苍","text":"“……”"},{"op":"image","layer":1,"image":"i10130"},{"op":"text","speaker":"苍","text":"“紬呀……你叫我师傅该不会是因为……”"},{"op":"image","layer":257,"image":"i14305"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"image","layer":257,"image":"i14291"},{"op":"text","speaker":"紬","text":"“……师傅就是师傅……”"},{"op":"image","layer":1,"image":"i10138"},{"op":"text","speaker":"苍","text":"“呜啊啊啊啊！好像我的名字也没记住!؟”"},{"op":"image","layer":257,"image":"i14311"},{"op":"text","speaker":"紬","text":"“对不起，我不擅长记别人的名字……”"},{"op":"image","layer":513,"image":"i12141"},{"op":"image","layer":1,"image":"i10130"},{"op":"text","speaker":"良一","text":"“那你是怎么记住羽依里和天善的？”"},{"op":"image","layer":257,"image":"i14281"},{"op":"text","speaker":"紬","text":"“把它们唱进我喜欢的歌里就记住了。”"},{"op":"image","layer":257,"image":"i14219"},{"op":"text","speaker":"紬","text":"“可是你们两位的名字，字数和音节对不上，唱不出来。”"},{"op":"image","layer":513,"image":"i12150"},{"op":"image","layer":1,"image":"i10290"},{"op":"text","speaker":"苍","text":"“有点受打击……”"},{"op":"text","speaker":"羽依里","text":"“不能换个曲子吗？”"},{"op":"image","layer":257,"image":"i14211"},{"op":"text","speaker":"紬","text":"“喔～真是个好主意。”"},{"op":"text","speaker":"羽依里","text":"“这个不穿衣服的叫三谷良一，你嘴里的师傅叫空门苍。”"},{"op":"image","layer":1,"image":"i14294"},{"op":"text","speaker":"紬","text":"“那么……”"},{"op":"image","layer":1,"image":"i14242"},{"op":"text","speaker":"紬","text":"“不～穿衣～的～男人。”"},{"op":"image","layer":257,"image":"i12150"},{"op":"image","layer":513,"image":"i10290"},{"op":"text","speaker":"良一","text":"“这不是名字！”"},{"op":"image","layer":513,"image":"i10189"},{"op":"text","speaker":"苍","text":"“这节奏听着跟广告似的。”"},{"op":"image","layer":1,"image":"i14274"},{"op":"text","speaker":"紬","text":"“我～师傅～空门～苍。”"},{"op":"image","layer":257,"image":"i10135"},{"op":"text","speaker":"苍","text":"“我名字也被编进去了！”"},{"op":"image","layer":1,"image":"i14234"},{"op":"text","speaker":"紬","text":"“我懂了，苍。”"},{"op":"image","layer":257,"image":"i10138"},{"op":"text","speaker":"苍","text":"“而且还记住了！”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"image","layer":1,"image":"i14234"},{"op":"text","speaker":"紬","text":"“苍，三谷，谢谢你们。”"},{"op":"image","layer":7,"image":"i10114"},{"op":"text","speaker":"苍","text":"“啊哈哈……再见啊。”"},{"op":"image","layer":7,"image":"i12164"},{"op":"text","speaker":"良一","text":"“等攒了一些，我再拿过来。”"},{"op":"text","speaker":"","text":"他们俩回去了。"},{"op":"text","speaker":"羽依里","text":"“那我来把这些吕客罐搬到灯塔门口。”"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"text","speaker":"羽依里","text":"“然后就回去。”"},{"op":"image","layer":1,"image":"i14355"},{"op":"text","speaker":"紬","text":"“好的，我再做一会儿丰胸体操。”"},{"op":"text","speaker":"羽依里","text":"“啊，嗯……你加油……”"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i25"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":7,"image":"i14323"},{"op":"text","speaker":"紬","text":"“姆姆姆姆～叽叽叽叽～”"},{"op":"text","speaker":"","text":"开始了吗……"},{"op":"text","speaker":"","text":"奇妙的声音回响在夏日的天空……"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i31"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我要是做了这丰胸体操，胸部会变成什么样呢。"},{"op":"image","layer":0,"image":"i219"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13818"},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i13818"},{"op":"text","speaker":"","text":"……会变成那样吗。"},{"op":"text","speaker":"","text":"嗯，沉甸甸的。"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i31"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13815"},{"op":"image","layer":1,"image":"i13743"},{"op":"text","speaker":"吞噬满月之乳房","text":"“你好啊♪”"},{"op":"text","speaker":"羽依里","text":"“……啊。”"},{"op":"text","speaker":"","text":"是那位吞噬满月之乳房姐姐……"},{"op":"image","layer":1,"image":"i13779"},{"op":"text","speaker":"吞噬满月之乳房","text":"“我们果然很有缘分呢♪”"},{"op":"text","speaker":"羽依里","text":"“看、看来是的呢。”"},{"op":"text","speaker":"","text":"希望我凝视她胸部的事情……没有暴露。"},{"op":"image","layer":1,"image":"i13737"},{"op":"text","speaker":"吞噬满月之乳房","text":"“说起来……”"},{"op":"image","layer":1,"image":"i13743"},{"op":"text","speaker":"吞噬满月之乳房","text":"“你刚才在看哪里呢？”"},{"op":"text","speaker":"羽依里","text":"“没什么……只是在发呆而已。”"},{"op":"text","speaker":"","text":"这种事怎么可能说得出口。"},{"op":"image","layer":1,"image":"i13841"},{"op":"text","speaker":"吞噬满月之乳房","text":"“真的吗？”"},{"op":"text","speaker":"羽依里","text":"“请等一下，我是男校的学生，对女生没什么抵抗力，你这样靠得太近的话……”"},{"op":"image","layer":1,"image":"i13810"},{"op":"text","speaker":"吞噬满月之乳房","text":"“哎呀，我们年纪差不多呢。”"},{"op":"image","layer":1,"image":"i13775"},{"op":"text","speaker":"吞噬满月之乳房","text":"“那么，我可以不用敬语吗？”"},{"op":"text","speaker":"羽依里","text":"“哎？嗯，可以啊。”"},{"op":"image","layer":1,"image":"i13820"},{"op":"text","speaker":"吞噬满月之乳房","text":"“哈哈，谢谢♪”"},{"op":"image","layer":1,"image":"i13823"},{"op":"text","speaker":"吞噬满月之乳房","text":"“那你的语气也变轻松点的话，我会很开心哦。”"},{"op":"text","speaker":"羽依里","text":"“我明白……”"},{"op":"image","layer":1,"image":"i13804"},{"op":"text","speaker":"吞噬满月之乳房","text":"“嗯？”"},{"op":"text","speaker":"羽依里","text":"“好的。”"},{"op":"image","layer":1,"image":"i13743"},{"op":"text","speaker":"吞噬满月之乳房","text":"“嗯♪”"},{"op":"image","layer":1,"image":"i13820"},{"op":"text","speaker":"吞噬满月之乳房","text":"“今天你去哪了？”"},{"op":"text","speaker":"羽依里","text":"“啊，呃，灯塔那边。”"},{"op":"image","layer":1,"image":"i13843"},{"op":"text","speaker":"吞噬满月之乳房","text":"“灯塔？难不成是紬那里？”"},{"op":"image","layer":1,"image":"i13816"},{"op":"text","speaker":"吞噬满月之乳房","text":"“她真是个好孩子啊，不仅有趣，和她在一起还会被她治愈。”"},{"op":"text","speaker":"羽依里","text":"“嗯，确实。”"},{"op":"image","layer":1,"image":"i13794"},{"op":"text","speaker":"吞噬满月之乳房","text":"“虽然奶子有点遗憾，不过真想让她当我的妹妹……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"她刚才好像很自然地把“奶子”说出口了。"},{"op":"text","speaker":"","text":"错觉……吧？"},{"op":"image","layer":1,"image":"i13823"},{"op":"text","speaker":"吞噬满月之乳房","text":"“我也是这个夏天第一次遇见她就迷上了她。”"},{"op":"text","speaker":"羽依里","text":"“这样啊。”"},{"op":"image","layer":1,"image":"i13832"},{"op":"text","speaker":"吞噬满月之乳房","text":"“唉，她要是能再有一点奶子就好了……”"},{"op":"text","speaker":"","text":"奶子。"},{"op":"image","layer":1,"image":"i13816"},{"op":"text","speaker":"吞噬满月之乳房","text":"“你怎么看？”"},{"op":"text","speaker":"","text":"……不知道我刚才把什么听错成奶子了。"},{"op":"text","speaker":"","text":"不过，既然她说什么不足……那我往这个方向回答应该就没问题。"},{"op":"text","speaker":"羽依里","text":"“不管怎么说，不足也就意味着今后的成长值得期待。”"},{"op":"text","speaker":"羽依里","text":"“评价她的时候再考虑上这份期待怎么样？”"},{"op":"image","layer":1,"image":"i13767"},{"op":"text","speaker":"吞噬满月之乳房","text":"“啊……”"},{"op":"image","layer":1,"image":"i13758"},{"op":"text","speaker":"吞噬满月之乳房","text":"“嗯……也许是这样。你说的可真有道理。”"},{"op":"image","layer":1,"image":"i13849"},{"op":"text","speaker":"吞噬满月之乳房","text":"“紬的奶子存在不足……”"},{"op":"text","speaker":"","text":"奶子。"},{"op":"image","layer":1,"image":"i13816"},{"op":"text","speaker":"吞噬满月之乳房","text":"“但是，希望她的奶子能再长大一点这种期待……”"},{"op":"text","speaker":"","text":"奶子。"},{"op":"image","layer":1,"image":"i13832"},{"op":"text","speaker":"吞噬满月之乳房","text":"“也是紬那对奶子的魅力啊。”"},{"op":"text","speaker":"","text":"奶子。"},{"op":"image","layer":1,"image":"i13743"},{"op":"text","speaker":"吞噬满月之乳房","text":"“谢谢你……让我注意到这一点。”"},{"op":"image","layer":1,"image":"i13737"},{"op":"text","speaker":"吞噬满月之乳房","text":"“看来你……对奶子的造诣很深啊？”"},{"op":"text","speaker":"","text":"……她嘴里说的果然是“奶子”。"},{"op":"text","speaker":"","text":"而且她好像还非常赏识我。"},{"op":"text","speaker":"羽依里","text":"“我觉得自己没那么厉害。”"},{"op":"image","layer":1,"image":"i13770"},{"op":"text","speaker":"吞噬满月之乳房","text":"“哈哈，真是谦虚。”"},{"op":"text","speaker":"羽依里","text":"“不是，我说真的……”"},{"op":"image","layer":1,"image":"i13775"},{"op":"text","speaker":"吞噬满月之乳房","text":"“可是，从你的双眼……”"},{"op":"image","layer":1,"image":"i13782"},{"op":"text","speaker":"吞噬满月之乳房","text":"“……我看到了对奶子的热爱。”"},{"op":"image","layer":1,"image":"i13797"},{"op":"text","speaker":"吞噬满月之乳房","text":"“这双瞳孔的深处，有着一对美丽的奶子……”"},{"op":"text","speaker":"","text":"我的眼睛是什么情况。"},{"op":"image","layer":1,"image":"i13770"},{"op":"text","speaker":"吞噬满月之乳房","text":"“看来我和你能成为好朋友。”"},{"op":"text","speaker":"羽依里","text":"“是……是吗……”"},{"op":"image","layer":1,"image":"i13737"},{"op":"text","speaker":"吞噬满月之乳房","text":"“可以告诉我你的名字吗？”"},{"op":"text","speaker":"羽依里","text":"“啊，我叫鹰原羽依里。”"},{"op":"image","layer":1,"image":"i13755"},{"op":"text","speaker":"吞噬满月之乳房","text":"“真是好名字……”"},{"op":"image","layer":1,"image":"i13740"},{"op":"text","speaker":"吞噬满月之乳房","text":"“请多指教，乳依里。”"},{"op":"text","speaker":"羽依里","text":"“且慢。”"},{"op":"text","speaker":"羽依里","text":"“那个……我刚才是不是听错了？”"},{"op":"image","layer":1,"image":"i13816"},{"op":"text","speaker":"吞噬满月之乳房","text":"“没有听错，我叫的就是你的名字。”"},{"op":"image","layer":1,"image":"i13817"},{"op":"text","speaker":"","text":"她说着，将手伸了过来。"},{"op":"text","speaker":"","text":"我也不由自主地伸手握住，紧接着她上下晃着手。"},{"op":"text","speaker":"","text":"眼前的那对奶子晃得更加激烈。"},{"op":"image","layer":1,"image":"i13740"},{"op":"text","speaker":"吞噬满月之乳房","text":"“再见，乳依里。”"},{"op":"text","speaker":"羽依里","text":"“啊……嗯。再见……”"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"text","speaker":"羽依里","text":"“这叫法果然不对劲吧؟!”"},{"op":"text","speaker":"","text":"我朝着她的背影吐槽道。"},{"op":"text","speaker":"","text":"话说，我是报上名了，可她的名字呢？"},{"op":"text","speaker":"","text":"只知道她是吞噬满月之乳房姐姐……"},{"op":"text","speaker":"","text":"先在心里叫她“奶子小姐”吧。"},{"op":"text","speaker":"","text":"举止、表情、奶子……"},{"op":"text","speaker":"羽依里","text":"“真是个处处体现着柔和的人啊。”"},{"op":"text","speaker":"","text":"乳依里……吗。"},{"op":"text","speaker":"","text":"我要是个小学生，恐怕第二天就不肯来学校了…"},{"op":"set","variable":415,"value":1},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]