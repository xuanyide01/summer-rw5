[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i31"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“嗯……”"},{"op":"text","speaker":"","text":"苍和稻荷从路对面走来。"},{"op":"text","speaker":"羽依里","text":"“哟。”"},{"op":"image","layer":1,"image":"i10254"},{"op":"text","speaker":"苍","text":"“啊……”"},{"op":"text","speaker":"羽依里","text":"“嗯……？”"},{"op":"text","speaker":"","text":"不知为什么，她脸上带着一丝尴尬。"},{"op":"image","layer":1,"image":"i10235"},{"op":"text","speaker":"苍","text":"“呃……又在散步？”"},{"op":"text","speaker":"羽依里","text":"“算是吧。”"},{"op":"image","layer":1,"image":"i10215"},{"op":"text","speaker":"苍","text":"“真是有够闲的。”"},{"op":"text","speaker":"羽依里","text":"“别这么说，我可是超级想去整理仓库的。”"},{"op":"text","speaker":"羽依里","text":"“话说，你也是散步吗？”"},{"op":"image","layer":1,"image":"i10200"},{"op":"text","speaker":"苍","text":"“算是吧。”"},{"op":"text","speaker":"羽依里","text":"“你大概也是够闲的。”"},{"op":"image","layer":1,"image":"i10267"},{"op":"text","speaker":"苍","text":"“差不多吧，谁让岛上什么都没有呢。”"},{"op":"image","layer":1,"image":"i10235"},{"op":"text","speaker":"苍","text":"“这座岛，你也差不多逛遍了吧？”"},{"op":"text","speaker":"羽依里","text":"“谁知道呢？”"},{"op":"text","speaker":"羽依里","text":"“我只是沿着道路在四处走而已。”"},{"op":"text","speaker":"羽依里","text":"“没去过的地方，其实说不定要多少有多少呢。”"},{"op":"image","layer":1,"image":"i10269"},{"op":"text","speaker":"苍","text":"“哼……”"},{"op":"image","layer":1,"image":"i10194"},{"op":"text","speaker":"苍","text":"“那我来给你带个路？”"},{"op":"text","speaker":"羽依里","text":"“唉……苍吗？”"},{"op":"choice","variable":6001,"items":[{"text":"请她来带路","value":0,"condition":1},{"text":"拒绝她带路","value":1,"condition":1},{"text":"不如我来给你带路","value":2,"condition":1}]},{"op":"if","truth":false,"target":341,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“那，难得有机会。”"},{"op":"text","speaker":"羽依里","text":"“就麻烦你了。”"},{"op":"image","layer":1,"image":"i10158"},{"op":"text","speaker":"苍","text":"“带你去只有当地人才知道的特别宝地好了。”"},{"op":"text","speaker":"羽依里","text":"“那还真是让人期待。”"},{"op":"image","layer":1,"image":"i10235"},{"op":"text","speaker":"苍","text":"“那就快出发吧。”"},{"op":"image","layer":1,"image":"i10282"},{"op":"text","speaker":"苍","text":"“跟我来。”"},{"op":"text","speaker":"羽依里","text":"“好。”"},{"op":"image","layer":257,"image":"i10672"},{"op":"text","speaker":"稻荷","text":"“嘭。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i31"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"跟着苍和稻荷，来到了几户人家连成一片的居民区。"},{"op":"image","layer":1,"image":"i10416"},{"op":"text","speaker":"苍","text":"“这里可是鸟白岛观光手册上都没有印的超级宝地哦。”"},{"op":"text","speaker":"羽依里","text":"“哦，放在乘船处的那个吗。”"},{"op":"text","speaker":"","text":"毕竟那东西，就是随便写点糊弄人的。"},{"op":"text","speaker":"羽依里","text":"“话说……，看不出来这地方有什么特别的啊？”"},{"op":"image","layer":1,"image":"i10288"},{"op":"text","speaker":"苍","text":"“这里是佐藤家。”"},{"op":"text","speaker":"羽依里","text":"“噢。”"},{"op":"image","layer":1,"image":"i10279"},{"op":"text","speaker":"苍","text":"“隔壁的是铃木家。”"},{"op":"text","speaker":"羽依里","text":"“……嗯。”"},{"op":"image","layer":1,"image":"i10389"},{"op":"text","speaker":"苍","text":"“然后，那对面是高桥家……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i10282"},{"op":"text","speaker":"苍","text":"“再里面就是田中家了。”"},{"op":"image","layer":1,"image":"i10411"},{"op":"text","speaker":"苍","text":"“怎么样，厉害吧？”"},{"op":"text","speaker":"羽依里","text":"“……哪？”"},{"op":"image","layer":1,"image":"i10403"},{"op":"text","speaker":"苍","text":"“唉，没发现吗？”"},{"op":"image","layer":1,"image":"i10165"},{"op":"text","speaker":"苍","text":"“全国姓氏排名最多的前4名，居然是邻居住一起。”"},{"op":"text","speaker":"羽依里","text":"“……所以？”"},{"op":"image","layer":1,"image":"i10258"},{"op":"text","speaker":"苍","text":"“所以？所以这不是很厉害吗？”"},{"op":"text","speaker":"羽依里","text":"“…不，嗯…怎么说呢……？”"},{"op":"image","layer":1,"image":"i10168"},{"op":"text","speaker":"苍","text":"“看来要让你满意是相当有难度的事啊。”"},{"op":"image","layer":1,"image":"i10200"},{"op":"text","speaker":"苍","text":"“算了。那么，去下个地方。”"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i55"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……这里是蓄水池吧？”"},{"op":"image","layer":1,"image":"i10224"},{"op":"text","speaker":"苍","text":"“是啊，但这可不是普通的蓄水池。”"},{"op":"image","layer":1,"image":"i10208"},{"op":"text","speaker":"苍","text":"“在这个蓄水池里，住着谁都没有看到过的真身不明的梦幻水怪！”"},{"op":"text","speaker":"羽依里","text":"“明明没人见过，居然知道有？”"},{"op":"image","layer":1,"image":"i10168"},{"op":"text","speaker":"苍","text":"“所以才说是梦幻嘛。”"},{"op":"image","layer":1,"image":"i10184"},{"op":"text","speaker":"苍","text":"“看到水怪的人，据说会被拽进池子里面，再也回不来。”"},{"op":"image","layer":1,"image":"i10189"},{"op":"text","speaker":"苍","text":"“所以才没能出现在观光小册子上吧……”"},{"op":"image","layer":1,"image":"i10168"},{"op":"text","speaker":"苍","text":"“要是抱着玩玩的心态来的话，那可就完蛋了。完完蛋蛋啊。”"},{"op":"image","layer":1,"image":"i10171"},{"op":"text","speaker":"苍","text":"“就算是我们，现在也是很害怕接近这里的。”"},{"op":"text","speaker":"羽依里","text":"“我说，这个……”"},{"op":"text","speaker":"羽依里","text":"“不过是大人们为了不让孩子们接近这里而编出来的谣言吧？”"},{"op":"text","speaker":"羽依里","text":"“类似晚上吹吹口哨会引蛇出洞的那种。”"},{"op":"image","layer":1,"image":"i10186"},{"op":"text","speaker":"苍","text":"“……”"},{"op":"image","layer":1,"image":"i10258"},{"op":"text","speaker":"苍","text":"“啊啊!؟”"},{"op":"text","speaker":"羽依里","text":"“唉？啊……现在才察觉到？”"},{"op":"image","layer":1,"image":"i10208"},{"op":"text","speaker":"苍","text":"“才、才才、才没有这种事呢！”"},{"op":"image","layer":1,"image":"i10205"},{"op":"text","speaker":"苍","text":"“我、我可是，早……早就知道的啦！”"},{"op":"image","layer":1,"image":"i10249"},{"op":"text","speaker":"苍","text":"“不过，你居然能看穿这个……你、你也很行嘛！”"},{"op":"text","speaker":"羽依里","text":"“啊……”"},{"op":"text","speaker":"羽依里","text":"“是不是太勉强你了？”"},{"op":"image","layer":1,"image":"i10162"},{"op":"text","speaker":"苍","text":"“呜――！小岛也有小岛的优点啦！”"},{"op":"image","layer":1,"image":"i10124"},{"op":"text","speaker":"苍","text":"“别小看乡下啊――！”"},{"op":"text","speaker":"羽依里","text":"“别闹脾气嘛。”"},{"op":"image","layer":1,"image":"i10288"},{"op":"text","speaker":"苍","text":"“才没有闹！”"},{"op":"text","speaker":"","text":"好像害得她闹别扭了。"},{"op":"text","speaker":"","text":"看来得哄哄她才行。"},{"op":"text","speaker":"羽依里","text":"“啊……那，我问些问题行不行？”"},{"op":"image","layer":1,"image":"i10319"},{"op":"text","speaker":"苍","text":"“……什么呀？”"},{"op":"text","speaker":"羽依里","text":"“我想想……”"},{"op":"choice","variable":6001,"items":[{"text":"有关岛上的历史","value":0,"condition":1},{"text":"有关岛上的娱乐","value":1,"condition":1}]},{"op":"if","truth":false,"target":192,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“这座岛历史上有没有什么趣闻？”"},{"op":"image","layer":1,"image":"i10290"},{"op":"text","speaker":"苍","text":"“历史……？”"},{"op":"text","speaker":"羽依里","text":"“城市里人口流动性太高了。”"},{"op":"text","speaker":"羽依里","text":"“因此，对于土地的感情有些淡薄。”"},{"op":"text","speaker":"羽依里","text":"“不过乡下的话，会对自己所住的地方有特别的感情吧？”"},{"op":"text","speaker":"羽依里","text":"“也可以说是特别带感？”"},{"op":"image","layer":1,"image":"i10246"},{"op":"text","speaker":"苍","text":"“我觉得，这话你大概用得不对。”"},{"op":"text","speaker":"羽依里","text":"“总之，我相当憧憬那种紧密结合本地特色的祭典类活动。”"},{"op":"image","layer":1,"image":"i10269"},{"op":"text","speaker":"苍","text":"“哼。”"},{"op":"image","layer":1,"image":"i10160"},{"op":"text","speaker":"苍","text":"“也是，都说城里人对于自己住的地方很冷漠呢。”"},{"op":"image","layer":1,"image":"i10184"},{"op":"text","speaker":"苍","text":"“是叫东京沙漠来着？这个词形容得真妙。”"},{"op":"text","speaker":"羽依里","text":"“那大概不是形容这个的，但能懂你想说什么。”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"苍","text":"“这座岛……”"},{"op":"image","layer":1,"image":"i10203"},{"op":"text","speaker":"苍","text":"“是呢。”"},{"op":"image","layer":0,"image":"i243"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i10232"},{"op":"text","speaker":"苍","text":"“是记忆的……”"},{"op":"text","speaker":"羽依里","text":"“……记忆……？”"},{"op":"image","layer":0,"image":"i55"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i10231"},{"op":"image","layer":1,"image":"i10316"},{"op":"text","speaker":"苍","text":"“啊，不对。暂停。”"},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"image","layer":1,"image":"i10336"},{"op":"text","speaker":"苍","text":"“呃，嗯，对了，这座岛原本是个海盗岛。”"},{"op":"text","speaker":"羽依里","text":"“唉？真的假的؟!我要当海贼王那种的؟!”"},{"op":"image","layer":1,"image":"i10285"},{"op":"text","speaker":"苍","text":"“不、不是那种的，要说的话算是海军？”"},{"op":"text","speaker":"羽依里","text":"“……太让人失望了，鸟白岛。”"},{"op":"image","layer":1,"image":"i10171"},{"op":"text","speaker":"苍","text":"“哼～……善良的海盗只存在在漫画里啦。”"},{"op":"text","speaker":"羽依里","text":"“啊――！啊――！这是不能说出来的吧！”"},{"op":"text","speaker":"羽依里","text":"“从刚才开始，你已经与全日本的小学生为敌了！”"},{"op":"image","layer":1,"image":"i10168"},{"op":"text","speaker":"苍","text":"“你是高中生吧。”"},{"op":"text","speaker":"羽依里","text":"“内心不管什么时候都是小学生啊！”"},{"op":"image","layer":1,"image":"i10246"},{"op":"text","speaker":"苍","text":"“等等，你这问题可不小啊。”"},{"op":"text","speaker":"羽依里","text":"“是呢，自己说出口后也觉得不太妙。”"},{"op":"image","layer":1,"image":"i10154"},{"op":"text","speaker":"苍","text":"“总之，差不多该回去了。”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"goto","target":289},{"op":"text","speaker":"羽依里","text":"“话说在这种乡下……”"},{"op":"text","speaker":"羽依里","text":"“平时娱乐不是很少嘛……听说那什么……”"},{"op":"text","speaker":"羽依里","text":"“会做色色的事来打发时间……真有这种事？”"},{"op":"image","layer":1,"image":"i10298"},{"op":"text","speaker":"苍","text":"“哈……”"},{"op":"image","layer":515,"image":"i18121"},{"op":"image","layer":1,"image":"i10139"},{"op":"text","speaker":"苍","text":" “哈啊啊啊啊啊啊啊!؟” "},{"op":"clear","layer":515},{"op":"clear","layer":768},{"op":"clear","layer":1024},{"op":"image","layer":1,"image":"i10163"},{"op":"text","speaker":"苍","text":"“你在说什么昏话啊!؟”"},{"op":"image","layer":1,"image":"i10176"},{"op":"text","speaker":"苍","text":"“做色、色色的事来……打发时间……”"},{"op":"image","layer":1,"image":"i10165"},{"op":"text","speaker":"苍","text":"“怎么可能啊！”"},{"op":"text","speaker":"羽依里","text":"“也是呢。”"},{"op":"image","layer":1,"image":"i10246"},{"op":"text","speaker":"苍","text":"“等等……你、你这人难道说……平时也是用这种目光，来看我的吗……”"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"image","layer":1,"image":"i10290"},{"op":"text","speaker":"苍","text":"“我、我是说……”"},{"op":"image","layer":1,"image":"i10308"},{"op":"text","speaker":"苍","text":"“你平时……都是带着色心在看我的吗……？”"},{"op":"choice","variable":6001,"items":[{"text":"是的","value":0,"condition":1},{"text":"没有","value":1,"condition":1}]},{"op":"if","truth":false,"target":249,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“说实话……”"},{"op":"text","speaker":"羽依里","text":"“……你太过好哄了，有时候是会感到兴奋的。”"},{"op":"image","layer":1,"image":"i10258"},{"op":"text","speaker":"苍","text":"“啊……因为太过喜欢我了所以开始兴奋了……!؟”"},{"op":"text","speaker":"羽依里","text":"“等等，好像意思变了点味啊。”"},{"op":"image","layer":1,"image":"i10305"},{"op":"text","speaker":"苍","text":"“就、就算你这么说了，我……我也不会觉得开心的！”"},{"op":"image","layer":1,"image":"i10290"},{"op":"text","speaker":"苍","text":"“虽、虽然我也不是一点兴趣都没有……”"},{"op":"text","speaker":"羽依里","text":"“哇……这好哄到爆炸……”"},{"op":"image","layer":1,"image":"i10254"},{"op":"text","speaker":"苍","text":"“不过…等到夏天结束，你不是要回去的吗……”"},{"op":"image","layer":1,"image":"i10270"},{"op":"text","speaker":"苍","text":"“我不太喜欢这种昙花一现的……”"},{"op":"image","layer":1,"image":"i10290"},{"op":"text","speaker":"苍","text":"“但、但要是你愿意循序渐进的话……！”"},{"op":"text","speaker":"羽依里","text":"“循序渐进？”"},{"op":"image","layer":1,"image":"i10301"},{"op":"text","speaker":"苍","text":"“总……总总总…总之，先从朋友开始也不是不可以哦…”"},{"op":"text","speaker":"羽依里","text":"“原来我们还不是朋友啊。”"},{"op":"image","layer":1,"image":"i10176"},{"op":"text","speaker":"苍","text":"“啊，那就从朋友之上开始！”"},{"op":"text","speaker":"羽依里","text":"“这关系还真复杂。”"},{"op":"image","layer":1,"image":"i10166"},{"op":"text","speaker":"苍","text":"“你不愿意吗!؟”"},{"op":"text","speaker":"羽依里","text":"“……那就请多多指教了。”"},{"op":"image","layer":1,"image":"i10290"},{"op":"text","speaker":"苍","text":"“好、好的……那就这样吧……”"},{"op":"text","speaker":"","text":"这孩子也太容易哄了……真让人操碎了心……"},{"op":"goto","target":289},{"op":"text","speaker":"羽依里","text":"“完全没。”"},{"op":"image","layer":1,"image":"i10138"},{"op":"text","speaker":"苍","text":" “居然一点都没――！” "},{"op":"text","speaker":"羽依里","text":"“吐槽真快。”"},{"op":"image","layer":1,"image":"i10246"},{"op":"text","speaker":"苍","text":"“你、你是说我就这么没有魅力吗!؟”"},{"op":"text","speaker":"羽依里","text":"“我不是这个意思……”"},{"op":"text","speaker":"羽依里","text":"“那带着色心看你比较好？”"},{"op":"image","layer":1,"image":"i10269"},{"op":"text","speaker":"苍","text":"“唉……？”"},{"op":"text","speaker":"羽依里","text":"“从现在这个瞬间开始，我就对你抱有色心了。”"},{"op":"image","layer":1,"image":"i10258"},{"op":"text","speaker":"苍","text":"“这个瞬间开始……”"},{"op":"image","layer":1,"image":"i10290"},{"op":"text","speaker":"","text":"苍突然开始扭捏起来。"},{"op":"text","speaker":"","text":"啊，我懂了……"},{"op":"text","speaker":"","text":"这家伙现在脑子里在想的东西。"},{"op":"image","layer":0,"image":"i243"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i10291"},{"op":"image","layer":1,"image":"i10317"},{"op":"text","speaker":"苍","text":"（……哈！不好…和男生在这种没有人烟的地方…独处…）"},{"op":"image","layer":1,"image":"i10291"},{"op":"text","speaker":"苍","text":"（而且还对我抱有色心……）"},{"op":"image","layer":1,"image":"i10136"},{"op":"text","speaker":"苍","text":"（也就是说……他要…）"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"image","layer":0,"image":"i55"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i10135"},{"op":"image","layer":1,"image":"i10301"},{"op":"text","speaker":"苍·羽依里","text":"“请不要太粗暴。”‘请不要太粗暴。’"},{"op":"text","speaker":"羽依里","text":"“一字不差啊。”"},{"op":"image","layer":1,"image":"i10176"},{"op":"text","speaker":"苍","text":"“唉……那果然还是会动粗吗!؟”"},{"op":"text","speaker":"羽依里","text":"“才不会，别把我当作是罪犯好吗。”"},{"op":"text","speaker":"","text":"想法好猜到这地步，反而显得可怕了。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":1},{"op":"image","layer":0,"image":"i34"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"","text":"回到了岛上的居住区。"},{"op":"text","speaker":"羽依里","text":"“嗯……这里是……”"},{"op":"text","speaker":"","text":"走了一会儿后，在这座岛上罕见的有着白色外墙的朴素建筑物吸引住了我的眼球。"},{"op":"text","speaker":"羽依里","text":"“医院？”"},{"op":"image","layer":1,"image":"i10200"},{"op":"text","speaker":"苍","text":"“虽然不大，但该有的设备都有，医生也非常优秀。”"},{"op":"text","speaker":"羽依里","text":"“哦……”"},{"op":"if","truth":false,"target":307,"value":["==",["v",92],1]},{"op":"text","speaker":"","text":"之前小卖铺老奶奶说的“检查”就是在这里吧。"},{"op":"text","speaker":"","text":"……也就是说“小蓝”在这里…？"},{"op":"goto","target":308},{"op":"text","speaker":"","text":"应该是岛上唯一的医院吧。"},{"op":"text","speaker":"","text":"看了苍一眼。"},{"op":"image","layer":0,"image":"i222"},{"op":"set","variable":6714,"value":4},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i10149"},{"op":"text","speaker":"苍","text":"“………”"},{"op":"text","speaker":"","text":"她正用平时不会显露出的神情，注视着诊所。"},{"op":"text","speaker":"","text":"我想这里对苍而言，一定是拥有着什么特别的意义。"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"image","layer":0,"image":"i34"},{"op":"set","variable":6714,"value":4},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i10148"},{"op":"image","layer":1,"image":"i10311"},{"op":"text","speaker":"苍","text":"“唉……”"},{"op":"text","speaker":"羽依里","text":"“嗯？怎么了？”"},{"op":"image","layer":1,"image":"i10308"},{"op":"text","speaker":"苍","text":"“不，只是觉得在你看来这座岛一定很无聊吧。”"},{"op":"image","layer":1,"image":"i10290"},{"op":"text","speaker":"苍","text":"“跟城市比起来的确是什么都没有。”"},{"op":"text","speaker":"羽依里","text":"“确实，什么都没呢。”"},{"op":"image","layer":1,"image":"i10162"},{"op":"text","speaker":"苍","text":"“呜……”"},{"op":"text","speaker":"羽依里","text":"“但也没有城市的喧闹与烦恼。”"},{"op":"image","layer":1,"image":"i10186"},{"op":"text","speaker":"苍","text":"“……嗯？”"},{"op":"text","speaker":"羽依里","text":"“我并不讨厌。”"},{"op":"text","speaker":"羽依里","text":"“这里这种时间慢慢流逝的氛围。”"},{"op":"text","speaker":"","text":"这是我的真心想法。"},{"op":"text","speaker":"","text":"或许……"},{"op":"text","speaker":"","text":"我快要喜欢上这座岛了。"},{"op":"goto","target":500},{"op":"if","truth":false,"target":389,"value":["==",["v",6001],1]},{"op":"text","speaker":"羽依里","text":"“就不麻烦了。”"},{"op":"image","layer":1,"image":"i10156"},{"op":"text","speaker":"苍","text":"“嗯嗯，不用……你倒是麻烦我一下啊――――！”"},{"op":"image","layer":1,"image":"i10179"},{"op":"text","speaker":"羽依里","text":"“还真是崭新的表达方式呢。”"},{"op":"image","layer":1,"image":"i10208"},{"op":"text","speaker":"苍","text":"“一般来说，是会让我带路的吧？”"},{"op":"text","speaker":"羽依里","text":"“就算你这么说……”"},{"op":"text","speaker":"羽依里","text":"“我来这座岛已经过了十多天了啊？”"},{"op":"text","speaker":"羽依里","text":"“带路参观这类活动，一般都是在开头三天吧。”"},{"op":"text","speaker":"羽依里","text":"“要是带我去的地方我已经去过了，不会很尴尬吗？”"},{"op":"image","layer":1,"image":"i10210"},{"op":"text","speaker":"苍","text":"“所、所以我在想，要不要带你去你绝对不知道的地方。”"},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"text","speaker":"羽依里","text":"“你把我带到四处无人的地方想做什么……？”"},{"op":"image","layer":1,"image":"i10246"},{"op":"text","speaker":"苍","text":"“什么都不会做好吗，你脑子里是不是太色情了？”"},{"op":"text","speaker":"羽依里","text":"“唉……给我等等……”"},{"op":"text","speaker":"羽依里","text":"“被你这么说的话……”"},{"op":"text","speaker":"羽依里","text":"“相当伤人啊。”"},{"op":"text","speaker":"羽依里","text":"“说真的……”"},{"op":"image","layer":1,"image":"i10210"},{"op":"text","speaker":"苍","text":"“在你心里，我到底是怎样一个人……？”"},{"op":"text","speaker":"羽依里","text":"“淫乱蓝。”"},{"op":"image","layer":515,"image":"i18121"},{"op":"image","layer":1,"image":"i10209"},{"op":"text","speaker":"苍","text":"“你就没有正经一点的表达方式了吗！”"},{"op":"clear","layer":515},{"op":"clear","layer":768},{"op":"clear","layer":1024},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i31"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i10209"},{"op":"text","speaker":"","text":"这明明是真心话……"},{"op":"image","layer":1,"image":"i10210"},{"op":"text","speaker":"苍","text":"“唉～……算了。”"},{"op":"image","layer":1,"image":"i10213"},{"op":"text","speaker":"苍","text":"“我也早点去打工好了……”"},{"op":"text","speaker":"羽依里","text":"“我稍后过去。”"},{"op":"image","layer":1,"image":"i10288"},{"op":"text","speaker":"苍","text":"“你别来了！”"},{"op":"text","speaker":"羽依里","text":"“真不够意思……”"},{"op":"text","speaker":"","text":"苍带着稻荷，向着小卖铺走去。"},{"op":"text","speaker":"","text":"看来是我辜负了她的一片好心。"},{"op":"text","speaker":"","text":"得反省下才行。"},{"op":"goto","target":500},{"op":"text","speaker":"羽依里","text":"“不……不如我来给你带路吧。”"},{"op":"image","layer":1,"image":"i10218"},{"op":"text","speaker":"苍","text":"“哈？你说什么？”"},{"op":"text","speaker":"羽依里","text":"“我带你去当地人很难注意到的宝地如何？”"},{"op":"image","layer":1,"image":"i10246"},{"op":"text","speaker":"苍","text":"“可我不觉得会有这样的地方？”"},{"op":"image","layer":1,"image":"i10243"},{"op":"text","speaker":"苍","text":"“我们可是从小在这里长大的哦？”"},{"op":"image","layer":1,"image":"i10241"},{"op":"text","speaker":"苍","text":"“也和野美希他们一起在岛上探过险的。”"},{"op":"text","speaker":"羽依里","text":"“是啊。”"},{"op":"text","speaker":"羽依里","text":"“不过你不觉得，可能有些地方会因为太过熟悉反而没注意到吗？”"},{"op":"image","layer":1,"image":"i10235"},{"op":"text","speaker":"苍","text":"“这真有趣。”"},{"op":"image","layer":1,"image":"i10392"},{"op":"text","speaker":"苍","text":"“要是你带我去的地方能让我吃惊的话，我就请你吃刨冰。”"},{"op":"text","speaker":"羽依里","text":"“要是没能让你吃惊的话就我请你刨冰好了。”"},{"op":"text","speaker":"羽依里","text":"“炼乳免费附赠。”"},{"op":"image","layer":1,"image":"i10405"},{"op":"text","speaker":"苍","text":"“那我也送，你想弄多少出来都可以。”"},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"image","layer":1,"image":"i10298"},{"op":"text","speaker":"苍","text":"“……唉？为什么你脸突然那么红啊？”"},{"op":"text","speaker":"羽依里","text":"“不，别在意……只是有点措手不及而已……”"},{"op":"image","layer":1,"image":"i10186"},{"op":"text","speaker":"苍","text":"“唔……”"},{"op":"text","speaker":"羽依里","text":"“总、总之，就这么买定离手了。”"},{"op":"text","speaker":"羽依里","text":"“跟我来呀――――！”"},{"op":"image","layer":1,"image":"i10208"},{"op":"text","speaker":"苍","text":"“去就去！”"},{"op":"image","layer":1,"image":"i10279"},{"op":"text","speaker":"苍","text":"“走了，稻荷！”"},{"op":"image","layer":257,"image":"i10700"},{"op":"text","speaker":"稻荷","text":"“嘭！”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i44"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我带着苍和稻荷，向岛上的某处走去。"},{"op":"image","layer":1,"image":"i10319"},{"op":"text","speaker":"苍","text":"“……我说，这条路走下去真有你说的宝地？”"},{"op":"text","speaker":"羽依里","text":"“……没错。”"},{"op":"image","layer":1,"image":"i10290"},{"op":"text","speaker":"苍","text":"“虽然我确实已经很久没来过这里了……”"},{"op":"image","layer":1,"image":"i10316"},{"op":"text","speaker":"苍","text":"“而且路本身也越来越诡异了……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i10243"},{"op":"text","speaker":"苍","text":"“是我的错觉吗……”"},{"op":"image","layer":1,"image":"i10267"},{"op":"text","speaker":"苍","text":"“感觉你只是在往没有人烟的山里走而已……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i10258"},{"op":"text","speaker":"苍","text":"“……哈!؟”"},{"op":"image","layer":0,"image":"i232"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i10259"},{"op":"image","layer":1,"image":"i10247"},{"op":"text","speaker":"苍","text":"“难、难不成你……”"},{"op":"image","layer":1,"image":"i10250"},{"op":"text","speaker":"苍","text":"“一开始就是这么打算的……？”"},{"op":"text","speaker":"羽依里","text":"“呼……”"},{"op":"text","speaker":"羽依里","text":"“我也差不多快到极限了。”"},{"op":"image","layer":1,"image":"i10291"},{"op":"text","speaker":"苍","text":"“快、快快快到极限了是……”"},{"op":"image","layer":1,"image":"i10309"},{"op":"text","speaker":"苍","text":"“……压抑着你内心的禽兽…这件事吗？”"},{"op":"image","layer":1,"image":"i10163"},{"op":"text","speaker":"苍","text":"“呜……！”"},{"op":"image","layer":1,"image":"i10169"},{"op":"text","speaker":"苍","text":"“……我不会做无谓的抵抗的……”"},{"op":"image","layer":1,"image":"i10172"},{"op":"text","speaker":"苍","text":"“所以，至少……”"},{"op":"image","layer":1,"image":"i10302"},{"op":"text","speaker":"苍","text":"“……请温柔一点……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"image","layer":0,"image":"i44"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i10301"},{"op":"image","layer":1,"image":"i10208"},{"op":"text","speaker":"苍","text":"“喂，你倒是说点什么呀！”"},{"op":"text","speaker":"羽依里","text":"“……苍。”"},{"op":"image","layer":1,"image":"i10138"},{"op":"text","speaker":"苍","text":"“啊，在！”"},{"op":"text","speaker":"羽依里","text":"“我迷路了。”"},{"op":"image","layer":1,"image":"i10146"},{"op":"text","speaker":"苍","text":"“………”"},{"op":"image","layer":1,"image":"i10121"},{"op":"text","speaker":"苍","text":"“……哈？”"},{"op":"text","speaker":"羽依里","text":"“这里是哪？”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i508"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":7,"image":"i10137"},{"op":"text","speaker":"苍","text":"“是……是…是你带的路吧啊啊啊啊――――――！”"},{"op":"image","layer":0,"image":"i44"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i10205"},{"op":"text","speaker":"羽依里","text":"“我装过头了，对不起。”"},{"op":"image","layer":1,"image":"i10208"},{"op":"text","speaker":"苍","text":"“早这么坦率不行吗！”"},{"op":"text","speaker":"羽依里","text":"“要能平安回去，请务必让我请一杯刨冰。”"},{"op":"set","variable":7120,"value":1},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"return"},{"op":"end"}]