[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i68"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……我看看。”"},{"op":"text","speaker":"","text":"镜子阿姨给我后，应该收在这边了才是。"},{"op":"text","speaker":"羽依里","text":"“有了有了。”"},{"op":"text","speaker":"羽依里","text":"“这件衣服是什么尺寸啊。”"},{"op":"text","speaker":"","text":"一边照着镜子，一边测量尺寸。"},{"op":"text","speaker":"","text":"对我来说当然是太小了……"},{"op":"text","speaker":"","text":"鸥的话，嗯，应该没问题。"},{"op":"image","layer":7,"image":"i15467"},{"op":"text","speaker":"羽未","text":"“你在做什么。”"},{"op":"text","speaker":"羽依里","text":"“唉。”"},{"op":"image","layer":1,"image":"i15579"},{"op":"text","speaker":"羽未","text":"“我还纳闷，为什么你房间里会有女生校服。”"},{"op":"image","layer":1,"image":"i15582"},{"op":"text","speaker":"羽未","text":"“现在懂了，是为了穿啊……”"},{"op":"image","layer":1,"image":"i15558"},{"op":"text","speaker":"羽未","text":"“……变态………”"},{"op":"text","speaker":"羽依里","text":"“不是的。而且这尺寸我也穿不下啊。”"},{"op":"image","layer":1,"image":"i15585"},{"op":"text","speaker":"羽未","text":"“所以你才这样，在镜子前比划来享受其中乐趣？”"},{"op":"text","speaker":"羽依里","text":"“不是不是。我要给朋友的。”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“戴眼镜的人和裸体的人？”"},{"op":"image","layer":1,"image":"i15331"},{"op":"text","speaker":"羽未","text":"“哪个要穿؟!”"},{"op":"text","speaker":"羽依里","text":"“哪个都不要啊。是给女孩子的。”"},{"op":"image","layer":1,"image":"i15378"},{"op":"text","speaker":"羽未","text":"“女、女性朋友――؟!”"},{"op":"text","speaker":"羽依里","text":"“唉……为什么最惊讶的点是那个？”"},{"op":"return"},{"op":"end"}]