[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"text","speaker":"羽依里","text":"“羽未。”"},{"op":"image","layer":1,"image":"i15959"},{"op":"text","speaker":"羽未","text":"“!؟”"},{"op":"image","layer":1,"image":"i15940"},{"op":"text","speaker":"羽未","text":"“羽依里哥……”"},{"op":"text","speaker":"","text":"比起我，羽未看起来更加惊讶。"},{"op":"image","layer":1,"image":"i15893"},{"op":"text","speaker":"羽未","text":"“你来这干什么？”"},{"op":"text","speaker":"羽依里","text":"“呃，我是追着蝴蝶来的。”"},{"op":"image","layer":1,"image":"i15896"},{"op":"text","speaker":"羽未","text":"“唉？”"},{"op":"text","speaker":"羽依里","text":"“说起来，倒是羽未你在这干什么？”"},{"op":"image","layer":1,"image":"i15988"},{"op":"text","speaker":"羽未","text":"“……”"},{"op":"image","layer":1,"image":"i15993"},{"op":"text","speaker":"羽未","text":"“没什么。”"},{"op":"image","layer":1,"image":"i15991"},{"op":"text","speaker":"羽未","text":"“只是有点迷路了而已。”"},{"op":"text","speaker":"","text":"迷路？"},{"op":"text","speaker":"羽依里","text":"“那我们一起回去？”"},{"op":"image","layer":1,"image":"i15956"},{"op":"text","speaker":"羽未","text":"“唉，才不要。”"},{"op":"text","speaker":"","text":"她匆匆离去。"},{"op":"text","speaker":"","text":"怎么感觉她好像在生气。"},{"op":"text","speaker":"羽依里","text":"“啊……”"},{"op":"text","speaker":"","text":"我也得回去才行。"},{"op":"text","speaker":"","text":"在离去之际，我又回头看了一眼那棵树。"},{"op":"text","speaker":"","text":"不知道为什么……它给我一种奇妙的感觉。"},{"op":"return"},{"op":"end"}]