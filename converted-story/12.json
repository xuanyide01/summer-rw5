[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"clear","layer":2},{"op":"image","layer":0,"image":"i65"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“早上好……”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“早啊。”"},{"op":"text","speaker":"","text":"羽未今天早上还是一样，在准备着早餐。"},{"op":"text","speaker":"羽依里","text":"“呃……炒饭？”"},{"op":"image","layer":1,"image":"i15401"},{"op":"text","speaker":"羽未","text":"“努力做了！”"},{"op":"text","speaker":"羽依里","text":"“努力了啊。”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i456"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我悄悄看了一眼水槽。"},{"op":"text","speaker":"","text":"那里还放着昨天吃完后洗净的，乌冬杯面的容器。"},{"op":"text","speaker":"","text":"今天的早餐估计也要靠它解决了……"},{"op":"image","layer":7,"image":"i15380"},{"op":"text","speaker":"羽未","text":"“不小心做出来了！”"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"image","layer":0,"image":"i65"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“为什么要用这种怎么就做出来了的语气？”"},{"op":"text","speaker":"羽依里","text":"“嗯，我看看……这什么炒饭？”"},{"op":"image","layer":1,"image":"i15384"},{"op":"text","speaker":"羽未","text":"“乌冬炒饭。”"},{"op":"text","speaker":"羽依里","text":"“哦……”"},{"op":"text","speaker":"","text":"碳水化合物×碳水化合物。"},{"op":"image","layer":1,"image":"i15381"},{"op":"text","speaker":"羽未","text":"“昨天的乌冬杯面那么好吃，所以应该好吃的。”"},{"op":"text","speaker":"羽依里","text":"“唔？”"},{"op":"text","speaker":"","text":"感觉听到了不太妙的话，于是我偷看了一下平底锅。"},{"op":"text","speaker":"羽依里","text":"“哇喔……”"},{"op":"text","speaker":"","text":"砸得粉碎的干乌冬杯面，跟米饭混在了一起。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"两人一起吃早餐。"},{"op":"text","speaker":"","text":"过了这么久，还是感觉怪怪的。"},{"op":"text","speaker":"羽依里","text":"“嗯唔……啪叽……嗯唔……咕噜……”"},{"op":"text","speaker":"","text":"乌冬炒饭，带出柔软米饭和干硬面粒的不和谐音。"},{"op":"image","layer":1,"image":"i15360"},{"op":"text","speaker":"羽未","text":"“不好七……”"},{"op":"text","speaker":"","text":"羽未也摆出了失落的表情。"},{"op":"text","speaker":"羽依里","text":"“等我一下。”"},{"op":"text","speaker":"","text":"我烧起热水。"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“要做什么？”"},{"op":"text","speaker":"羽依里","text":"“总之，至少得先加工成能吃的乌冬吧。”"},{"op":"text","speaker":"","text":"我往装着炒饭的盘里灌进热水。"},{"op":"text","speaker":"","text":"顺便把羽未没有使用的，乌冬杯面的调料包加进去。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"3分钟后――"},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15378"},{"op":"text","speaker":"羽未","text":"“好好吃！”"},{"op":"text","speaker":"羽依里","text":"“搞得跟杂烩粥差不多了。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“乌冬炒饭。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“哥哥好厉害――！”"},{"op":"text","speaker":"羽依里","text":"“是、是吗？”"},{"op":"text","speaker":"","text":"有点小高兴。"},{"op":"return"},{"op":"end"}]