[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i480"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“姆～……”"},{"op":"image","layer":7,"image":"i13766"},{"op":"text","speaker":"静久","text":"“嗯～……”"},{"op":"image","layer":7,"image":"i14218"},{"op":"text","speaker":"紬","text":"“姆啾～……”"},{"op":"image","layer":0,"image":"i129"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i14219"},{"op":"text","speaker":"羽依里","text":"“一点都想不出想干什么吗？”"},{"op":"image","layer":1,"image":"i14299"},{"op":"text","speaker":"紬","text":"“是的。”"},{"op":"image","layer":1,"image":"i14291"},{"op":"text","speaker":"紬","text":"“虽然有了几个点子……但总感觉不是。”"},{"op":"image","layer":1,"image":"i14333"},{"op":"text","speaker":"紬","text":"“我不太确定我真正想做的是不是它们。”"},{"op":"text","speaker":"羽依里","text":"“真头疼。”"},{"op":"image","layer":1,"image":"i14347"},{"op":"text","speaker":"紬","text":"“姆叽……”"},{"op":"image","layer":1,"image":"i14340"},{"op":"image","layer":257,"image":"i13820"},{"op":"text","speaker":"静久","text":"“唉呀，不也挺好的嘛。”"},{"op":"text","speaker":"羽依里","text":"“好？”"},{"op":"image","layer":257,"image":"i13816"},{"op":"text","speaker":"静久","text":"“把想到的那些点子全部做一遍吧。”"},{"op":"image","layer":257,"image":"i13846"},{"op":"text","speaker":"静久","text":"“这样一来，我就能和紬还有乳依里玩个够了。”"},{"op":"text","speaker":"羽依里","text":"“真是积极向上啊。”"},{"op":"image","layer":1,"image":"i14355"},{"op":"text","speaker":"紬","text":"“能玩个够可真不错。”"},{"op":"image","layer":1,"image":"i14375"},{"op":"text","speaker":"紬","text":"“那就把它们一个个都做一遍吧。”"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"静久","text":"“你有了什么点子吗？”"},{"op":"image","layer":1,"image":"i14359"},{"op":"text","speaker":"紬","text":"“嗯―……”"},{"op":"image","layer":1,"image":"i14331"},{"op":"text","speaker":"紬","text":"“啊，有了。”"},{"op":"text","speaker":"羽依里","text":"“还挺快啊。”"},{"op":"image","layer":1,"image":"i14234"},{"op":"text","speaker":"紬","text":"“我们总是在白天见面。”"},{"op":"image","layer":1,"image":"i14237"},{"op":"text","speaker":"紬","text":"“所以想在夜里和你们见面。我想看星星。”"},{"op":"text","speaker":"羽依里","text":"“夜里啊。”"},{"op":"text","speaker":"羽依里","text":"“……还挺暗的，出门走没事？”"},{"op":"image","layer":257,"image":"i13807"},{"op":"text","speaker":"静久","text":"“是啊。几乎没什么路灯，感觉有点吓人。”"},{"op":"text","speaker":"羽依里","text":"“我还听说过有人脚滑掉进海里。”"},{"op":"image","layer":1,"image":"i14272"},{"op":"text","speaker":"紬","text":"“不用担心。在屋里见面就行了。”"},{"op":"text","speaker":"羽依里","text":"“不是要看星星？”"},{"op":"image","layer":1,"image":"i14259"},{"op":"text","speaker":"紬","text":"“要看。”"},{"op":"image","layer":257,"image":"i13764"},{"op":"text","speaker":"静久","text":"“可在屋里就看不到了哦？”"},{"op":"image","layer":257,"image":"i13767"},{"op":"text","speaker":"静久","text":"“而且就算出门，住宅区的光这么亮，也很难看见星星。”"},{"op":"image","layer":1,"image":"i14239"},{"op":"text","speaker":"紬","text":"“没事的。我们看星星的建筑没有光，而且不在住宅区。”"},{"op":"text","speaker":"羽依里","text":"“哪有这种好事。”"},{"op":"image","layer":1,"image":"i14234"},{"op":"text","speaker":"紬","text":"“有的。”"},{"op":"text","speaker":"羽依里","text":"“哪？”"},{"op":"image","layer":1,"image":"i14366"},{"op":"text","speaker":"紬","text":"“远在天边，近在眼前。”"},{"op":"image","layer":0,"image":"i130"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……还真有。”"},{"op":"image","layer":7,"image":"i13763"},{"op":"text","speaker":"静久","text":"“……是有啊。”"},{"op":"text","speaker":"","text":"眼前的……是那座黯淡的灯塔。"},{"op":"text","speaker":"","text":"而且离住宅区有不短一段路。"},{"op":"image","layer":0,"image":"i129"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i14272"},{"op":"image","layer":257,"image":"i13764"},{"op":"text","speaker":"羽依里","text":"“你注意到了盲点。”"},{"op":"image","layer":1,"image":"i14277"},{"op":"text","speaker":"紬","text":"“这就是所谓的灯下暗。”"},{"op":"text","speaker":"羽依里","text":"“这话可不能用在灯塔上。”"},{"op":"image","layer":257,"image":"i13767"},{"op":"text","speaker":"静久","text":"“但是回去的时候，夜路有点恐怖。”"},{"op":"image","layer":1,"image":"i14317"},{"op":"text","speaker":"紬","text":"“不回去就行了。”"},{"op":"image","layer":257,"image":"i13761"},{"op":"text","speaker":"静久","text":"“要住下来？”"},{"op":"image","layer":257,"image":"i13807"},{"op":"text","speaker":"静久","text":"“嗯～……要是睡在地上，实在是有些累啊。”"},{"op":"image","layer":1,"image":"i14216"},{"op":"text","speaker":"紬","text":"“灯塔里有被褥哦？”"},{"op":"text","speaker":"羽依里","text":"“哦？是吗？”"},{"op":"image","layer":1,"image":"i14272"},{"op":"text","speaker":"紬","text":"“里面还能吃饭，厕所浴室也都有。”"},{"op":"text","speaker":"羽依里","text":"“看样子能住。”"},{"op":"image","layer":1,"image":"i14237"},{"op":"text","speaker":"紬","text":"“对。”"},{"op":"image","layer":1,"image":"i14279"},{"op":"text","speaker":"紬","text":"“其实我就住在这里。”"},{"op":"text","speaker":"羽依里","text":"“嘿――……”"},{"op":"text","speaker":"","text":"……"},{"op":"image","layer":257,"image":"i13761"},{"op":"text","speaker":"羽依里","text":"“住在这!؟”"},{"op":"image","layer":1,"image":"i14261"},{"op":"text","speaker":"紬","text":"“住在这。”"},{"op":"image","layer":1,"image":"i14200"},{"op":"text","speaker":"紬","text":"“所以我一直都在这里。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“静久你知道？”"},{"op":"image","layer":257,"image":"i13807"},{"op":"text","speaker":"静久","text":"“不知道……”"},{"op":"image","layer":257,"image":"i13804"},{"op":"text","speaker":"静久","text":"“我确实知道灯塔里面有些紬的私人物品，可实在没想到她就住在这……”"},{"op":"text","speaker":"羽依里","text":"“你家呢？没事吗？”"},{"op":"image","layer":1,"image":"i14317"},{"op":"text","speaker":"紬","text":"“没事的。我也有回家。”"},{"op":"image","layer":1,"image":"i14322"},{"op":"text","speaker":"紬","text":"“再说我要是不见了，家人肯定也会担心的。”"},{"op":"image","layer":257,"image":"i13807"},{"op":"text","speaker":"静久","text":"“那就好……”"},{"op":"text","speaker":"羽依里","text":"“那你是时不时来这里住住？”"},{"op":"image","layer":1,"image":"i14287"},{"op":"text","speaker":"紬","text":"“没错。”"},{"op":"image","layer":1,"image":"i14320"},{"op":"text","speaker":"紬","text":"“所以我觉得你们两位也可以来住。”"},{"op":"image","layer":257,"image":"i13743"},{"op":"text","speaker":"静久","text":"“是……啊。”"},{"op":"image","layer":257,"image":"i13740"},{"op":"text","speaker":"静久","text":"“既然准备这么充足，来这儿一晚可能也不错。”"},{"op":"text","speaker":"羽依里","text":"“真的假的……”"},{"op":"image","layer":257,"image":"i13816"},{"op":"text","speaker":"静久","text":"“我爸妈也不怎么反对我住外面一晚，所以我没问题。”"},{"op":"image","layer":1,"image":"i14234"},{"op":"text","speaker":"紬","text":"“羽依里先生呢？”"},{"op":"text","speaker":"羽依里","text":"“我的话，跟我借宿的那家长辈说一声，在外面住一晚应该没什么。”"},{"op":"image","layer":1,"image":"i14200"},{"op":"text","speaker":"紬","text":"“那就这么定了。”"},{"op":"text","speaker":"羽依里","text":"“真的可以吗？我跟你也没认识多久，就让我住下来。”"},{"op":"image","layer":257,"image":"i13849"},{"op":"text","speaker":"静久","text":"“我没问题。谁让我信任乳依里嘛。”"},{"op":"image","layer":1,"image":"i14237"},{"op":"text","speaker":"紬","text":"“我也是。因为我喜欢羽依里先生。”"},{"op":"text","speaker":"羽依里","text":"“啊，唉……唉唉？”"},{"op":"image","layer":257,"image":"i13810"},{"op":"text","speaker":"静久","text":"“唉呀♪是这样啊？”"},{"op":"image","layer":1,"image":"i14284"},{"op":"text","speaker":"紬","text":"“嗯，和你相处无拘无束，我很喜欢。”"},{"op":"text","speaker":"","text":"无拘无束……"},{"op":"text","speaker":"","text":"我怎么感觉她没把我当异性看。"},{"op":"text","speaker":"","text":"有点失落。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"……失落？"},{"op":"text","speaker":"","text":"失落是意味着……"},{"op":"text","speaker":"","text":"我希望她能把我当成异性看待？"},{"op":"image","layer":1,"image":"i14234"},{"op":"text","speaker":"紬","text":"“期待两位夜里光临。”"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"静久","text":"“是啊，真期待。”"},{"op":"text","speaker":"羽依里","text":"“唉？啊，嗯……”"},{"op":"image","layer":1,"image":"i14320"},{"op":"text","speaker":"紬","text":"“～～～♪”"},{"op":"text","speaker":"","text":"看她也挺开心的，我也不纠结了。"},{"op":"image","layer":257,"image":"i13823"},{"op":"text","speaker":"静久","text":"“我回去还有点东西要准备，到了晚上再集合吧？”"},{"op":"image","layer":1,"image":"i14234"},{"op":"text","speaker":"紬","text":"“嗯。”"},{"op":"image","layer":1,"image":"i14259"},{"op":"text","speaker":"紬","text":"“我会好好准备招待大家。”"},{"op":"text","speaker":"羽依里","text":"“不用太正式的。”"},{"op":"image","layer":1,"image":"i14234"},{"op":"text","speaker":"紬","text":"“好的。”"},{"op":"image","layer":1,"image":"i14237"},{"op":"text","speaker":"紬","text":"“～～～♪”"},{"op":"image","layer":257,"image":"i13740"},{"op":"text","speaker":"静久","text":"“那我们晚上见。”"},{"op":"text","speaker":"羽依里","text":"“嗯，再见。”"},{"op":"image","layer":1,"image":"i14234"},{"op":"text","speaker":"紬","text":"“我等你们。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i68"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“好了……”"},{"op":"text","speaker":"","text":"换洗衣物，牙刷……"},{"op":"text","speaker":"","text":"还有……"},{"op":"text","speaker":"羽依里","text":"“我是不是该带点伴手礼？”"},{"op":"text","speaker":"","text":"想不出该给女孩子带些什么样的伴手礼。"},{"op":"text","speaker":"","text":"话说回来……"},{"op":"text","speaker":"","text":"男女共住……这不就是……"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":1795,"image":"i18201"},{"op":"image","layer":0,"image":"i129"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i14200"},{"op":"image","layer":257,"image":"i13849"},{"op":"text","speaker":"静久","text":"‘我没问题。谁让我信任乳依里嘛。’"},{"op":"image","layer":1,"image":"i14237"},{"op":"text","speaker":"紬","text":"‘我也是。因为我喜欢羽依里先生。’"},{"op":"text","speaker":"羽依里","text":"‘啊，唉……唉唉？’"},{"op":"image","layer":257,"image":"i13810"},{"op":"text","speaker":"静久","text":"‘唉呀♪这样的吗？’"},{"op":"image","layer":1,"image":"i14284"},{"op":"text","speaker":"紬","text":"‘嗯，和你相处无拘无束，我很喜欢。’"},{"op":"clear","layer":1795},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i68"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"text","speaker":"羽依里","text":" “鹰原羽依里！” "},{"op":"text","speaker":"","text":"快停下，不要想入非非。"},{"op":"text","speaker":"","text":"紬只是单纯地希望三个人一起度过一晚。"},{"op":"text","speaker":"","text":"可是啊……那里真的有三套被褥吗？"},{"op":"text","speaker":"","text":"要是只有一套该怎么办？"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"羽依里","text":"“鹰原――”"},{"op":"image","layer":1,"image":"i11566"},{"op":"text","speaker":"镜子","text":"“那个……羽依里？”"},{"op":"text","speaker":"羽依里","text":"“唉？什么事？”"},{"op":"image","layer":1,"image":"i11578"},{"op":"text","speaker":"镜子","text":"“嗯，听到你在喊‘鹰原羽依里’，就想来看看你怎么了……”"},{"op":"text","speaker":"羽依里","text":"“不，没什么。我没事的。”"},{"op":"image","layer":1,"image":"i11563"},{"op":"text","speaker":"镜子","text":"“那就好。”"},{"op":"image","layer":1,"image":"i11622"},{"op":"text","speaker":"镜子","text":"“我也没喊过自己的名字，无法理解你是怎么想的。”"},{"op":"image","layer":1,"image":"i11614"},{"op":"text","speaker":"镜子","text":"“不过你要是有什么烦恼，我可以帮忙出主意哦。”"},{"op":"text","speaker":"羽依里","text":"“谢谢阿姨。”"},{"op":"text","speaker":"羽依里","text":"“我现在就有一个问题，可以问吗？”"},{"op":"image","layer":1,"image":"i11581"},{"op":"text","speaker":"镜子","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“当女性提出要与自己在同一屋檐下共度一晚……”"},{"op":"text","speaker":"羽依里","text":"“你觉得对方是出于什么意图？”"},{"op":"image","layer":1,"image":"i11566"},{"op":"text","speaker":"镜子","text":"“唉？”"},{"op":"image","layer":1,"image":"i11578"},{"op":"text","speaker":"镜子","text":"“……”"},{"op":"image","layer":1,"image":"i11614"},{"op":"text","speaker":"镜子","text":"“现在我们不就住在同一个屋檐下吗？”"},{"op":"image","layer":1,"image":"i11602"},{"op":"text","speaker":"镜子","text":"“你这番话……我该当成是对我的性骚扰吗？”"},{"op":"text","speaker":"羽依里","text":"“误会了误会了。”"},{"op":"text","speaker":"羽依里","text":"“我好像要和这岛上的女孩子变成这种状况了。”"},{"op":"image","layer":1,"image":"i11617"},{"op":"text","speaker":"镜子","text":"“唉唉!؟”"},{"op":"image","layer":1,"image":"i11605"},{"op":"text","speaker":"镜子","text":"“我该怎么处理你这种情况呢？”"},{"op":"image","layer":1,"image":"i11602"},{"op":"text","speaker":"镜子","text":"“还是通知姐姐一声吧……”"},{"op":"text","speaker":"羽依里","text":"“请千万不要通知。”"},{"op":"image","layer":1,"image":"i11554"},{"op":"text","speaker":"镜子","text":"“……”"},{"op":"image","layer":1,"image":"i11552"},{"op":"text","speaker":"镜子","text":"“呃……我要先问清楚，因为你要是跟坏孩子学坏了，我必须及时把你拉回来。”"},{"op":"image","layer":1,"image":"i11563"},{"op":"text","speaker":"镜子","text":"“对方人怎么样？”"},{"op":"text","speaker":"羽依里","text":"“这个嘛……”"},{"op":"text","speaker":"羽依里","text":"“是一个比我小的扎着双马尾的女孩子和――”"},{"op":"image","layer":1,"image":"i11617"},{"op":"text","speaker":"镜子","text":"“和？”"},{"op":"image","layer":1,"image":"i11622"},{"op":"text","speaker":"镜子","text":"“慢着羽依里君……不是一个人？”"},{"op":"text","speaker":"羽依里","text":"“是两个人。”"},{"op":"image","layer":1,"image":"i11552"},{"op":"text","speaker":"镜子","text":"“果然……该和姐姐。”"},{"op":"text","speaker":"羽依里","text":"“不，求你了……真的别告诉家长。”"},{"op":"image","layer":1,"image":"i11560"},{"op":"text","speaker":"镜子","text":"“不过，有两个女孩子的话，应该是把你当朋友才叫上你的吧？”"},{"op":"image","layer":1,"image":"i11611"},{"op":"text","speaker":"镜子","text":"“还是说保镖？这样的话，可能也没什么问题。”"},{"op":"text","speaker":"羽依里","text":"“就是说嘛。”"},{"op":"text","speaker":"","text":"要真是这样，我反而能更轻松些吧。"},{"op":"text","speaker":"","text":"老实说，和她们一起我很开心，所以我也期待过和她们一起住一晚。"},{"op":"text","speaker":"","text":"这里面大概没有其他的意思。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i484"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"……只有涛声回响在耳边。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"往日愉快的地方，到了夜里，却有些瘆人。"},{"op":"text","speaker":"","text":"没有人影，有点恐怖……"},{"op":"image","layer":0,"image":"i133"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“从这里进去就行了吧？”"},{"op":"text","speaker":"","text":"我抓住门把，缓缓打开门。"},{"op":"image","layer":0,"image":"i319"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“紬……我来了……”"},{"op":"text","speaker":"","text":"咚……咚……咚……"},{"op":"text","speaker":"","text":"楼梯传来了有人慢慢走下来的声音。"},{"op":"text","speaker":"","text":"……嗯，好吓人。"},{"op":"text","speaker":"羽依里","text":"“紬？”"},{"op":"image","layer":1,"image":"i14606"},{"op":"text","speaker":"紬","text":"“欢迎光临，羽依里先生。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“这啥？”"},{"op":"image","layer":1,"image":"i14710"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"image","layer":1,"image":"i14730"},{"op":"text","speaker":"紬","text":"“姆喵～”"},{"op":"image","layer":1,"image":"i14617"},{"op":"text","speaker":"紬","text":"“猫。”"},{"op":"text","speaker":"羽依里","text":"“确实是猫。”"},{"op":"text","speaker":"","text":"而且很可爱。"},{"op":"image","layer":1,"image":"i14640"},{"op":"text","speaker":"紬","text":"“请跟我来。”"},{"op":"text","speaker":"羽依里","text":"“这就解释完了!؟”"},{"op":"image","layer":1,"image":"i14638"},{"op":"text","speaker":"紬","text":"“静久在上面等着呢。”"},{"op":"text","speaker":"羽依里","text":"“好吧。”"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i139"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i14118"},{"op":"set","variable":30013,"value":15},{"op":"text","speaker":"静久","text":"“哞～～～♪”"},{"op":"text","speaker":"羽依里","text":"“原来是你干的好事。”"},{"op":"image","layer":1,"image":"i14076"},{"op":"text","speaker":"静久","text":"“啊……”"},{"op":"image","layer":1,"image":"i14107"},{"op":"text","speaker":"静久","text":"“对不起……”"},{"op":"text","speaker":"羽依里","text":"“没什么好道歉的。我又没生气。”"},{"op":"image","layer":1,"image":"i14077"},{"op":"text","speaker":"静久","text":"“不，让我道个歉吧。”"},{"op":"image","layer":1,"image":"i14080"},{"op":"text","speaker":"静久","text":"“其实我本来也想给乳依里准备一件睡衣的。”"},{"op":"image","layer":1,"image":"i14069"},{"op":"text","speaker":"静久","text":"“结果没赶上……本来想给我们三个准备一套的，真的对不起。”"},{"op":"text","speaker":"羽依里","text":"“别，没什么的……”"},{"op":"image","layer":257,"image":"i14566"},{"op":"text","speaker":"紬","text":"“羽依里先生的是什么样式的？”"},{"op":"image","layer":1,"image":"i14083"},{"op":"text","speaker":"静久","text":"“我做的是一件马外形的睡衣。而且还是白马哦。”"},{"op":"text","speaker":"羽依里","text":"“还好你没赶上。”"},{"op":"text","speaker":"羽依里","text":"“话说回来……”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i489"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“原来灯塔内部是这样的啊。”"},{"op":"text","speaker":"","text":"相当陈旧。"},{"op":"text","speaker":"","text":"但是，屋里摆着紬收集的布偶，空瓶里还插着花。"},{"op":"text","speaker":"","text":"这使得屋子里多了几分女孩子气。"},{"op":"image","layer":0,"image":"i139"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“这些全都是漂流物？”"},{"op":"image","layer":1,"image":"i14630"},{"op":"text","speaker":"紬","text":"“是的喵。”"},{"op":"text","speaker":"羽依里","text":"“紬……”"},{"op":"image","layer":1,"image":"i14634"},{"op":"text","speaker":"紬","text":"“姆喵？”"},{"op":"text","speaker":"羽依里","text":"“快打住，我都想摸你头了。”"},{"op":"image","layer":1,"image":"i14685"},{"op":"text","speaker":"紬","text":"“姆喵……”"},{"op":"image","layer":257,"image":"i14063"},{"op":"text","speaker":"静久","text":"“这可不行。”"},{"op":"image","layer":257,"image":"i14066"},{"op":"text","speaker":"静久","text":"“面对猫咪，得摸摸它的脖子才行。”"},{"op":"image","layer":257,"image":"i14068"},{"op":"text","speaker":"静久","text":"“来，乳依里。快摸摸吧。”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"image","layer":1,"image":"i14684"},{"op":"text","speaker":"紬","text":"“如，如果这就是猫的宿命，那我认了。”"},{"op":"text","speaker":"羽依里","text":"“那，那就……”"},{"op":"choice","variable":6001,"items":[{"text":"摸头","value":0,"condition":1},{"text":"摸摸脖子","value":1,"condition":1},{"text":"摸胸","value":2,"condition":1}]},{"op":"if","truth":false,"target":417,"value":["==",["v",6001],0]},{"op":"text","speaker":"","text":"摸摸她的头吧。"},{"op":"text","speaker":"羽依里","text":"“那么紬……是这样吗？”"},{"op":"image","layer":1,"image":"i14592"},{"op":"text","speaker":"紬","text":"“喵!؟”"},{"op":"text","speaker":"","text":"我摸摸她的头，又轻轻拍了拍。"},{"op":"image","layer":1,"image":"i14573"},{"op":"text","speaker":"紬","text":"“啊……”"},{"op":"text","speaker":"羽依里","text":"“怎么样？”"},{"op":"image","layer":1,"image":"i14585"},{"op":"text","speaker":"紬","text":"“这个嘛……”"},{"op":"image","layer":1,"image":"i14575"},{"op":"text","speaker":"紬","text":"“我努力理好的头发都乱了。”"},{"op":"image","layer":1,"image":"i14573"},{"op":"text","speaker":"紬","text":"“感觉很不舒服。”"},{"op":"text","speaker":"羽依里","text":"“唉？抱，抱歉。”"},{"op":"text","speaker":"羽依里","text":"“摸头不舒服吗？”"},{"op":"image","layer":1,"image":"i14104"},{"op":"text","speaker":"静久","text":"“我也没被摸过，不太清楚。”"},{"op":"image","layer":1,"image":"i14064"},{"op":"text","speaker":"静久","text":"“能摸摸我的头试试吗？”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"text","speaker":"","text":"我摸了摸静久的头。"},{"op":"image","layer":1,"image":"i14070"},{"op":"text","speaker":"静久","text":"“……”"},{"op":"image","layer":1,"image":"i14078"},{"op":"text","speaker":"静久","text":"“紬说的没错，发型都……”"},{"op":"text","speaker":"羽依里","text":"“抱歉。”"},{"op":"text","speaker":"","text":"差评连连。"},{"op":"goto","target":505},{"op":"if","truth":false,"target":467,"value":["==",["v",6001],1]},{"op":"text","speaker":"","text":"毕竟是猫，还是摸摸脖子吧。"},{"op":"text","speaker":"羽依里","text":"“那我就……这样吗？”"},{"op":"image","layer":1,"image":"i14621"},{"op":"text","speaker":"紬","text":"“姆喵!؟”"},{"op":"text","speaker":"","text":"我温柔地摸了摸她的脖子。"},{"op":"image","layer":1,"image":"i14626"},{"op":"text","speaker":"紬","text":"“这，这样……”"},{"op":"text","speaker":"羽依里","text":"“怎么样？”"},{"op":"image","layer":1,"image":"i14600"},{"op":"text","speaker":"紬","text":"“好，好难为情。”"},{"op":"text","speaker":"羽依里","text":"“……嗯。”"},{"op":"text","speaker":"","text":"我也很难为情。"},{"op":"image","layer":7,"image":"i14062"},{"op":"text","speaker":"静久","text":"“只有这点感想的话，可分辨不出好坏呀。”"},{"op":"image","layer":1,"image":"i14596"},{"op":"text","speaker":"紬","text":"“说，说的也是……那么……”"},{"op":"image","layer":1,"image":"i14652"},{"op":"text","speaker":"紬","text":"“咕噜咕噜咕噜咕噜～♪”"},{"op":"text","speaker":"","text":"她给小曲加上了猫咪的闷哼声。"},{"op":"text","speaker":"","text":"看来她心情不错。"},{"op":"image","layer":1,"image":"i14632"},{"op":"text","speaker":"紬","text":"“咕～咕噜咕噜咕～♪咕～咕噜咕噜～♪”"},{"op":"image","layer":7,"image":"i14106"},{"op":"text","speaker":"静久","text":"“这一脸陶醉的……就这么舒服吗？”"},{"op":"image","layer":1,"image":"i14648"},{"op":"text","speaker":"紬","text":"“羽依里先生可能是抚摸喉咙的天才。”"},{"op":"text","speaker":"羽依里","text":"“我哪来这没用的才能？”"},{"op":"image","layer":1,"image":"i14599"},{"op":"image","layer":257,"image":"i14117"},{"op":"text","speaker":"静久","text":"“也，也来摸摸我的喉咙吧？”"},{"op":"image","layer":1,"image":"i14624"},{"op":"image","layer":257,"image":"i14134"},{"op":"text","speaker":"紬","text":" “姆喵～～～～～～！” "},{"op":"image","layer":257,"image":"i14128"},{"op":"text","speaker":"静久","text":"“唉？”"},{"op":"image","layer":1,"image":"i14734"},{"op":"text","speaker":"紬","text":"“牛不需要别人摸喉咙，所以不可以。”"},{"op":"image","layer":1,"image":"i14678"},{"op":"image","layer":257,"image":"i14132"},{"op":"text","speaker":"静久","text":"“怎么这样……”"},{"op":"text","speaker":"","text":"静久垂头丧气。"},{"op":"image","layer":257,"image":"i14082"},{"op":"text","speaker":"静久","text":"“啊，那挤奶如何！”"},{"op":"text","speaker":"羽依里","text":"“绝对不干！”"},{"op":"image","layer":257,"image":"i14079"},{"op":"text","speaker":"静久","text":"“哞～……”"},{"op":"image","layer":1,"image":"i14611"},{"op":"text","speaker":"紬","text":"“咕噜咕噜咕噜咕噜～♪”"},{"op":"goto","target":505},{"op":"text","speaker":"","text":"好，摸摸她的胸吧。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"唉……"},{"op":"text","speaker":"","text":"我……认真的？"},{"op":"image","layer":0,"image":"i323"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":1,"image":"i14568"},{"op":"text","speaker":"羽依里","text":"“那，那我上咯……紬。”"},{"op":"image","layer":1,"image":"i14586"},{"op":"text","speaker":"紬","text":"“喵。”"},{"op":"text","speaker":"","text":"我的手朝她的奶子伸去。"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i139"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i14073"},{"op":"text","speaker":"静久","text":"“乳依里！”"},{"op":"text","speaker":"羽依里","text":"“――！”"},{"op":"text","speaker":"","text":"静久用力抓住了我的手腕。"},{"op":"text","speaker":"羽依里","text":"“静……久……？”"},{"op":"image","layer":1,"image":"i14081"},{"op":"text","speaker":"静久","text":"“每个人奶子的发育过程都是不一样的。”"},{"op":"image","layer":1,"image":"i14078"},{"op":"text","speaker":"静久","text":"“如果揉了，形状可能会歪……柔软度也可能会发生变化……”"},{"op":"image","layer":1,"image":"i14085"},{"op":"text","speaker":"静久","text":"“不可以干扰他人的发育过程哦。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"说起来，虽然静久这么热爱奶子，但我还真没见过她揉别人奶子。"},{"op":"text","speaker":"","text":"我还觉得不可思议呢，原来是这么一回事啊……"},{"op":"text","speaker":"","text":"面对他人的奶子，她的真心也丝毫不减，并致以最大的尊敬……"},{"op":"text","speaker":"羽依里","text":"“静久好酷……”"},{"op":"image","layer":1,"image":"i14067"},{"op":"text","speaker":"静久","text":"“谢谢♪”"},{"op":"image","layer":257,"image":"i14672"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"image","layer":257,"image":"i14711"},{"op":"text","speaker":"紬","text":"“刚才你们一来一往的到底是……”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"text","speaker":"羽依里","text":"“啊……这是？”"},{"op":"image","layer":1,"image":"i14659"},{"op":"text","speaker":"紬","text":"“是我的朋友。”"},{"op":"text","speaker":"羽依里","text":"“这就是那时的河童布偶？”"},{"op":"text","speaker":"羽依里","text":"“它是叫……和美来着？变得这么漂亮了啊。”"},{"op":"image","layer":1,"image":"i14649"},{"op":"text","speaker":"紬","text":"“静久有帮忙。”"},{"op":"image","layer":7,"image":"i14062"},{"op":"text","speaker":"静久","text":"“只是稍微修了修。”"},{"op":"text","speaker":"羽依里","text":"“这儿布偶可真多。”"},{"op":"image","layer":1,"image":"i14637"},{"op":"text","speaker":"紬","text":"“这是我的兴趣。”"},{"op":"text","speaker":"羽依里","text":"“原来如此。这兴趣很有女孩子气，很可爱。”"},{"op":"image","layer":1,"image":"i14634"},{"op":"text","speaker":"紬","text":"“可爱……吗？”"},{"op":"image","layer":1,"image":"i14685"},{"op":"text","speaker":"紬","text":"“姆啾……好难为情。”"},{"op":"text","speaker":"","text":"……唔。"},{"op":"text","speaker":"","text":"听她这么毫不遮掩，我也难为情起来了。"},{"op":"text","speaker":"","text":"紬时不时会有很女孩子气的反应，总是让我的心怦怦直跳。"},{"op":"image","layer":0,"image":"i323"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i14688"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"紬是怎么看我的呢？"},{"op":"text","speaker":"","text":"有把我当成一个男性吗？"},{"op":"text","speaker":"","text":"可她要是把我当成男性，才不会叫我一起共住一晚吧……"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i139"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"……唔～"},{"op":"image","layer":1,"image":"i14595"},{"op":"image","layer":257,"image":"i14063"},{"op":"text","speaker":"紬","text":"“呃……我去做饭。”"},{"op":"image","layer":257,"image":"i14066"},{"op":"text","speaker":"静久","text":"“好～”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"image","layer":1,"image":"i14665"},{"op":"text","speaker":"紬","text":"“……姆啾―”"},{"op":"text","speaker":"","text":"没过一会儿，紬一脸沮丧地回来了。"},{"op":"text","speaker":"羽依里","text":"“怎么了？”"},{"op":"image","layer":1,"image":"i14574"},{"op":"text","speaker":"紬","text":"“这里只准备了一人份的食粮……”"},{"op":"image","layer":7,"image":"i14103"},{"op":"text","speaker":"静久","text":"“唉呀，这可不得了。现在去买？”"},{"op":"image","layer":1,"image":"i14675"},{"op":"text","speaker":"紬","text":"“这么晚了……该去哪里买呀？”"},{"op":"text","speaker":"羽依里","text":"“便利店……这岛上好像没有？”"},{"op":"image","layer":1,"image":"i14590"},{"op":"text","speaker":"紬","text":"“没有。……这样下去，我们都要……饿死了。”"},{"op":"text","speaker":"羽依里","text":"“少吃一顿饭没那么夸张……”"},{"op":"text","speaker":"羽依里","text":"“啊……说起来，我有带晚上吃的零食来。”"},{"op":"image","layer":1,"image":"i14628"},{"op":"text","speaker":"紬","text":"“姆啾！不愧是羽依里先生。”"},{"op":"text","speaker":"羽依里","text":"“就是不知道能不能当饭吃……我想着能给紬的寻找自己之旅帮上忙就带来了。”"},{"op":"image","layer":1,"image":"i14661"},{"op":"text","speaker":"紬","text":"“这不是吕客嘛。”"},{"op":"image","layer":1,"image":"i14659"},{"op":"text","speaker":"紬","text":"“无论是薯片还是罐子，都是我现在正需要的……”"},{"op":"image","layer":1,"image":"i14630"},{"op":"text","speaker":"紬","text":"“怎么回事？羽依里先生莫非是神仙吗？”"},{"op":"text","speaker":"羽依里","text":"“太夸张了。”"},{"op":"image","layer":1,"image":"i14610"},{"op":"text","speaker":"紬","text":"“总有一天……我要在灯塔边上建一座抱着一堆吕客的羽依里先生铜像。”"},{"op":"text","speaker":"羽依里","text":"“求你别。”"},{"op":"image","layer":257,"image":"i14113"},{"op":"text","speaker":"静久","text":"“紬是要用空罐造一个阳台？”"},{"op":"image","layer":1,"image":"i14659"},{"op":"text","speaker":"紬","text":"“是的。吕客不仅好吃，还能做阳台的材料。吕客真是无敌。”"},{"op":"text","speaker":"羽依里","text":"“想把它们用来造阳台可能是你想多了。我们先吃吧。”"},{"op":"image","layer":1,"image":"i14628"},{"op":"text","speaker":"紬","text":"“我开动了。”"},{"op":"image","layer":257,"image":"i14066"},{"op":"text","speaker":"静久","text":"“我开动了。”"},{"op":"image","layer":1,"image":"i14588"},{"op":"text","speaker":"紬","text":"“姆啾？”"},{"op":"image","layer":257,"image":"i14076"},{"op":"text","speaker":"静久","text":"“啊……！”"},{"op":"image","layer":1,"image":"i14672"},{"op":"text","speaker":"紬","text":"“羽依里先生……”"},{"op":"image","layer":1,"image":"i14680"},{"op":"text","speaker":"紬","text":"“我发现了一个大问题。”"},{"op":"image","layer":257,"image":"i14104"},{"op":"text","speaker":"静久","text":"“确实……”"},{"op":"text","speaker":"羽依里","text":"“怎么了？”"},{"op":"image","layer":1,"image":"i14622"},{"op":"text","speaker":"紬","text":"“这双手抓不住薯片。”"},{"op":"image","layer":257,"image":"i14100"},{"op":"text","speaker":"静久","text":"“我也是！”"},{"op":"text","speaker":"羽依里","text":"“你不是有手吗？”"},{"op":"image","layer":257,"image":"i14124"},{"op":"text","speaker":"","text":"她把手藏起来了…"},{"op":"image","layer":1,"image":"i14653"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"image","layer":257,"image":"i14137"},{"op":"text","speaker":"静久","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“为什么你们都张嘴朝着我……”"},{"op":"set","variable":26027,"value":1},{"op":"text","speaker":"紬","text":"“请喂偶七。”"},{"op":"set","variable":26027,"value":1},{"op":"text","speaker":"静久","text":"“啊……”"},{"op":"set","variable":26027,"value":1},{"op":"set","variable":26027,"value":0},{"op":"text","speaker":"羽依里","text":"“噢，这个意思啊。”"},{"op":"text","speaker":"","text":"有点难为情啊。"},{"op":"text","speaker":"","text":"不过我不会退缩……"},{"op":"text","speaker":"羽依里","text":"“来，你们俩都有份。”"},{"op":"image","layer":1,"image":"i14696"},{"op":"text","speaker":"紬","text":"“嗯姆……真好吃。”"},{"op":"image","layer":257,"image":"i14067"},{"op":"text","speaker":"静久","text":"“哈姆……嗯―美味♪”"},{"op":"text","speaker":"羽依里","text":"“好，我也……”"},{"op":"image","layer":1,"image":"i14654"},{"op":"text","speaker":"紬","text":"“啊―”"},{"op":"image","layer":257,"image":"i14085"},{"op":"text","speaker":"静久","text":"“啊～”"},{"op":"text","speaker":"羽依里","text":"“唉―……”"},{"op":"text","speaker":"","text":"这样我就没法吃了。"},{"op":"image","layer":1,"image":"i14661"},{"op":"text","speaker":"紬","text":"“～～～♪”"},{"op":"image","layer":7,"image":"i14062"},{"op":"text","speaker":"静久","text":"“你今天经常哼这小曲啊。”"},{"op":"image","layer":1,"image":"i14570"},{"op":"text","speaker":"紬","text":"“是的，因为我很开心。”"},{"op":"text","speaker":"羽依里","text":"“不过你并不知道这是什么曲子吧？”"},{"op":"image","layer":1,"image":"i14605"},{"op":"text","speaker":"紬","text":"“对。不过……它就是我最喜欢的曲子。”"},{"op":"text","speaker":"羽依里","text":"“记得第一次见到你的时候，你也在灯塔上哼着。”"},{"op":"image","layer":1,"image":"i14602"},{"op":"text","speaker":"紬","text":"“是啊。”"},{"op":"image","layer":1,"image":"i14661"},{"op":"text","speaker":"紬","text":"“因为我觉得在那里唱……也许就能找到自己。”"},{"op":"text","speaker":"羽依里","text":"“就能……找到自己。”"},{"op":"text","speaker":"","text":"第一次见到她的时候她也说过这句话。"},{"op":"text","speaker":"","text":"‘寻找自己。’"},{"op":"text","speaker":"","text":"寻找自己说穿了，就和寻找自己想做的事差不多。"},{"op":"text","speaker":"","text":"既然这样……"},{"op":"text","speaker":"羽依里","text":"“既然你觉得靠这支曲子能找到自己……那会不会它跟你想做的事有关？”"},{"op":"image","layer":1,"image":"i14584"},{"op":"text","speaker":"紬","text":"“……？”"},{"op":"text","speaker":"羽依里","text":"“比如说，歌词里就有你想做的事情……或者你想做的就是传播这首曲子。”"},{"op":"image","layer":1,"image":"i14582"},{"op":"text","speaker":"紬","text":"“姆啾～？”"},{"op":"image","layer":1,"image":"i14665"},{"op":"text","speaker":"紬","text":"“……没明白你的意思。”"},{"op":"image","layer":1,"image":"i14672"},{"op":"text","speaker":"紬","text":"“我觉得寻找自己和寻找自己想做的事情不一样。”"},{"op":"text","speaker":"羽依里","text":"“可这不是紬的三大不可思议之一吗？”"},{"op":"image","layer":1,"image":"i14582"},{"op":"text","speaker":"紬","text":"“我的三大不可思议？”"},{"op":"image","layer":257,"image":"i14066"},{"op":"text","speaker":"静久","text":"“指‘寻找想做的事’和‘寻找自己’以及‘丝毫不见成长的奶子’吗？”"},{"op":"text","speaker":"羽依里","text":"“你是怎么从刚才歌曲的话题里蹦出这茬的……？”"},{"op":"image","layer":257,"image":"i14063"},{"op":"text","speaker":"静久","text":"“总之我们先查查这到底是什么歌吧。”"},{"op":"image","layer":1,"image":"i14661"},{"op":"text","speaker":"紬","text":"“好的。”"},{"op":"text","speaker":"羽依里","text":"“具体该怎么做？”"},{"op":"image","layer":257,"image":"i14107"},{"op":"text","speaker":"静久","text":"“嗯～……比如让岛上的人听听看？”"},{"op":"image","layer":1,"image":"i14672"},{"op":"text","speaker":"紬","text":"“这……意思是要给我准备一个舞台吗？”"},{"op":"text","speaker":"羽依里","text":"“就哼个小曲，舞台小题大做了吧？”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i512"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":7,"image":"i14120"},{"op":"text","speaker":"静久","text":"“呼啊……”"},{"op":"image","layer":0,"image":"i139"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i14121"},{"op":"text","speaker":"羽依里","text":"“困了？”"},{"op":"image","layer":1,"image":"i14100"},{"op":"text","speaker":"静久","text":"“啊……对不起。我真是扫兴。”"},{"op":"image","layer":257,"image":"i14690"},{"op":"text","speaker":"紬","text":"“我们也该睡了吧？”"},{"op":"text","speaker":"羽依里","text":"“还没看星星呢，就睡了？”"},{"op":"image","layer":257,"image":"i14639"},{"op":"image","layer":1,"image":"i14063"},{"op":"text","speaker":"紬","text":"“关上灯躺下来，就能从这里看到了。”"},{"op":"text","speaker":"羽依里","text":"“嘿……真是个好地方。”"},{"op":"image","layer":257,"image":"i14602"},{"op":"text","speaker":"紬","text":"“你要住在这里吗？”"},{"op":"text","speaker":"羽依里","text":"“邀请我同居？”"},{"op":"image","layer":257,"image":"i14595"},{"op":"text","speaker":"紬","text":"“姆啾!؟呃……”"},{"op":"text","speaker":"羽依里","text":"“没，我开玩笑的。”"},{"op":"image","layer":1,"image":"i14066"},{"op":"text","speaker":"静久","text":"“哈哈♪真遗憾，紬。”"},{"op":"image","layer":257,"image":"i14685"},{"op":"text","speaker":"紬","text":"“不，不是这个意思……”"},{"op":"image","layer":257,"image":"i14687"},{"op":"text","speaker":"紬","text":"“姆啾……”"},{"op":"text","speaker":"","text":"紬到底是怎么看我的呢？"},{"op":"text","speaker":"","text":"而我……又是怎么看她的呢……"},{"op":"text","speaker":"羽依里","text":"“说起来，今晚一起过夜就是你想做的事情吗？”"},{"op":"image","layer":257,"image":"i14595"},{"op":"text","speaker":"紬","text":"“……我觉得这和我正在寻找的事不太一样。”"},{"op":"image","layer":257,"image":"i14598"},{"op":"text","speaker":"紬","text":"“但是……我还想再来一次。”"},{"op":"text","speaker":"羽依里","text":"“……是啊。”"},{"op":"image","layer":1,"image":"i14083"},{"op":"text","speaker":"静久","text":"“下次再来住一晚吧♪”"},{"op":"image","layer":257,"image":"i14692"},{"op":"text","speaker":"紬","text":"“嗯。”"},{"op":"image","layer":0,"image":"i323"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":1,"image":"i14691"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"image","layer":1,"image":"i14681"},{"op":"text","speaker":"紬","text":"“那个……下次我可以再叫一个人来吗？”"},{"op":"text","speaker":"羽依里","text":"“再叫一个？”"},{"op":"image","layer":1,"image":"i14691"},{"op":"text","speaker":"紬","text":"“是的。”"},{"op":"image","layer":1,"image":"i14575"},{"op":"text","speaker":"紬","text":"“不知道到时候她能不能来……不过她是我非常重要的朋友。”"},{"op":"image","layer":0,"image":"i139"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i14574"},{"op":"image","layer":257,"image":"i14077"},{"op":"text","speaker":"静久","text":"“原来除了我们，紬还有这样的朋友啊。”"},{"op":"image","layer":257,"image":"i14113"},{"op":"text","speaker":"静久","text":"“有点嫉妒了。”"},{"op":"image","layer":1,"image":"i14680"},{"op":"text","speaker":"紬","text":"“不可以吗？”"},{"op":"text","speaker":"静久","text":"“当然可以啦。”"},{"op":"image","layer":257,"image":"i14115"},{"op":"text","speaker":"静久","text":"“紬的朋友肯定也是个好孩子嘛。”"},{"op":"text","speaker":"羽依里","text":"“就是。”"},{"op":"image","layer":1,"image":"i14692"},{"op":"text","speaker":"紬","text":"“谢谢。”"},{"op":"image","layer":1,"image":"i14661"},{"op":"text","speaker":"紬","text":"“～～～♪”"},{"op":"image","layer":257,"image":"i14068"},{"op":"text","speaker":"静久","text":"“唉呀，又是那首曲子。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i512"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“她是什么样的人？”"},{"op":"image","layer":7,"image":"i14571"},{"op":"text","speaker":"紬","text":"“……她不太擅长交朋友。”"},{"op":"image","layer":7,"image":"i14597"},{"op":"text","speaker":"紬","text":"“我也是努力了很久……”"},{"op":"image","layer":7,"image":"i14571"},{"op":"text","speaker":"紬","text":"“然后她……”"},{"op":"image","layer":7,"image":"i14609"},{"op":"text","speaker":"紬","text":"“……就像……羽依里先生一样……”"},{"op":"image","layer":7,"image":"i14607"},{"op":"text","speaker":"紬","text":"“…………”"},{"op":"image","layer":0,"image":"i139"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“……嘶―”"},{"op":"image","layer":1,"image":"i14083"},{"op":"text","speaker":"静久","text":"“睡着了呢。”"},{"op":"text","speaker":"羽依里","text":"“像我一样……什么？”"},{"op":"image","layer":1,"image":"i14063"},{"op":"text","speaker":"静久","text":"“别急嘛，明早再问，或者下次一起住的时候问问她……”"},{"op":"image","layer":1,"image":"i14068"},{"op":"text","speaker":"静久","text":"“暑假离结束还早着呢，有大把的时间。”"},{"op":"text","speaker":"羽依里","text":"“说的也是。”"},{"op":"image","layer":1,"image":"i14075"},{"op":"text","speaker":"静久","text":"“我也快撑不下去了……晚安，乳依里。”"},{"op":"text","speaker":"羽依里","text":"“嗯，晚安。”"},{"op":"text","speaker":"静久","text":"“……嘶……嘶……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“有大把的时间……吗。”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i512"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"仿佛无穷无尽。"},{"op":"text","speaker":"","text":"怎么也用不完。"},{"op":"text","speaker":"","text":"漫长的时间。"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"与她们俩……度过这段时间，也不坏。"},{"op":"text","speaker":"羽依里","text":"“～～♪”"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]