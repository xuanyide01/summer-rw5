[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i48"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“哦？”"},{"op":"image","layer":0,"image":"i236"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13549"},{"op":"text","speaker":"","text":"白羽……？"},{"op":"text","speaker":"","text":"她在岸边的一个角落，一堆岩石的附近闲逛着。"},{"op":"text","speaker":"","text":"在那种地方干什么啊……"},{"op":"image","layer":0,"image":"i48"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13547"},{"op":"text","speaker":"羽依里","text":"“呃。”"},{"op":"text","speaker":"","text":"她穿的是泳装。"},{"op":"text","speaker":"","text":"虽然在泳池见过，不过白天看到还是觉得有一种特别感。"},{"op":"text","speaker":"","text":"……不。"},{"op":"text","speaker":"","text":"区区泳装没什么大不了的。"},{"op":"text","speaker":"","text":"虽然我在学校，总是被一群半裸男人围着。"},{"op":"text","speaker":"","text":"可也不至于嫩到看看泳装就会兴奋。"},{"op":"text","speaker":"","text":"放平常心跟她打声招呼吧。"},{"op":"image","layer":1,"image":"i13548"},{"op":"text","speaker":"羽依里","text":"“耶，白羽。”"},{"op":"image","layer":1,"image":"i13541"},{"op":"text","speaker":"白羽","text":"“!؟”"},{"op":"text","speaker":"","text":"太不自然了！"},{"op":"image","layer":1,"image":"i13523"},{"op":"text","speaker":"白羽","text":"“呀、呀。”"},{"op":"text","speaker":"","text":"她显得有些惊讶，但还是吞吞吐吐地回应了我。"},{"op":"text","speaker":"羽依里","text":"“呀。”"},{"op":"text","speaker":"羽依里","text":"“在做什么呢？”"},{"op":"image","layer":1,"image":"i13572"},{"op":"text","speaker":"白羽","text":"“抓到了。”"},{"op":"text","speaker":"羽依里","text":"“抓、抓到了……什么？”"},{"op":"image","layer":1,"image":"i13548"},{"op":"text","speaker":"白羽","text":"“鱼。”"},{"op":"text","speaker":"羽依里","text":"“哦哦。”"},{"op":"text","speaker":"羽依里","text":"“你会游泳吗？”"},{"op":"image","layer":1,"image":"i13545"},{"op":"text","speaker":"白羽","text":"“这水很浅没关系。”"},{"op":"image","layer":1,"image":"i13459"},{"op":"text","speaker":"白羽","text":"“要吃吗？”"},{"op":"text","speaker":"羽依里","text":"“可以吗？”"},{"op":"set","variable":26027,"value":1},{"op":"text","speaker":"","text":"我吞了吞口水。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i1076"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"她拿起一把小菜刀。"},{"op":"text","speaker":"","text":"身旁已经摆好便携燃气炉。"},{"op":"text","speaker":"","text":"默默地开始烹制。"},{"op":"text","speaker":"","text":"……以娴熟的手法，完成了烹制。"},{"op":"image","layer":0,"image":"i1077"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……唔。”"},{"op":"text","speaker":"","text":"我当即开始品尝她做好的料理。"},{"op":"text","speaker":"羽依里","text":"“这鱼。”"},{"op":"text","speaker":"","text":"太好吃了。"},{"op":"text","speaker":"","text":"好吃到合不拢嘴。"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"她静静地注视着我。"},{"op":"text","speaker":"白羽","text":"“好吃吗？”"},{"op":"text","speaker":"羽依里","text":"“好吃。”"},{"op":"text","speaker":"羽依里","text":"“那个，其他的鱼你也会做吗？”"},{"op":"text","speaker":"白羽","text":"“啊，嗯……常见的鱼应该都会吧。”"},{"op":"text","speaker":"羽依里","text":"“那你跟我来。”"},{"op":"text","speaker":"白羽","text":"“呃，哎？”"},{"op":"text","speaker":"羽依里","text":"“想请你帮我烹制一些东西。”"},{"op":"text","speaker":"","text":"她虽然一副极不乐意的样子，但听完我的话后，还是眨着眼考虑了一会。"},{"op":"text","speaker":"白羽","text":"“好、好吧……”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i48"},{"op":"set","variable":6714,"value":0},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i55"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"于是我带着她，来到了蓄水池。"},{"op":"image","layer":1,"image":"i13076"},{"op":"text","speaker":"白羽","text":"“在这里钓鱼？”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"text","speaker":"","text":"我立刻在池子放下鱼钩。"},{"op":"image","layer":1,"image":"i13164"},{"op":"text","speaker":"白羽","text":"“你要钓什么？”"},{"op":"text","speaker":"","text":"……等了一会。"},{"op":"text","speaker":"羽依里","text":"“上钩了。”"},{"op":"image","layer":1,"image":"i13201"},{"op":"text","speaker":"白羽","text":"“这是……”"},{"op":"text","speaker":"羽依里","text":"“是龙虾。”"},{"op":"image","layer":1,"image":"i13196"},{"op":"text","speaker":"白羽","text":"“是小龙虾吧。”"},{"op":"text","speaker":"羽依里","text":"“这能吃吗？”"},{"op":"image","layer":1,"image":"i13191"},{"op":"text","speaker":"白羽","text":"“这可不是鱼哦。”"},{"op":"text","speaker":"羽依里","text":"“我知道。”"},{"op":"image","layer":1,"image":"i13101"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"image","layer":1,"image":"i13081"},{"op":"text","speaker":"白羽","text":"“去掉毒腺应该可以吧。”"},{"op":"text","speaker":"羽依里","text":"“啊，毒？小龙虾还有毒的吗？”"},{"op":"image","layer":1,"image":"i13091"},{"op":"text","speaker":"白羽","text":"“这岛上的有。”"},{"op":"text","speaker":"羽依里","text":"“那就算了吧。”"},{"op":"image","layer":1,"image":"i13105"},{"op":"text","speaker":"白羽","text":"“没事没事。”"},{"op":"text","speaker":"","text":"不知为何她的眼神已经转换到战斗模式。"},{"op":"text","speaker":"羽依里","text":"“来真的啊。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i1064"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"白羽","text":"“去掉小龙虾的毒腺需要高超的技术。”"},{"op":"text","speaker":"白羽","text":"“让外行乱来的话，会有去不干净的危险。”"},{"op":"text","speaker":"羽依里","text":"“那你算什么，专家吗？”"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"她郑重地摇摇头。"},{"op":"text","speaker":"白羽","text":"“外行。”"},{"op":"text","speaker":"白羽","text":"“不过没事。”"},{"op":"text","speaker":"羽依里","text":"“呃，嗯。”"},{"op":"text","speaker":"","text":"外行……没事……"},{"op":"text","speaker":"羽依里","text":"“没事对吧。”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"她娴熟地处理起来。"},{"op":"text","speaker":"","text":"没事没事。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i55"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13062"},{"op":"text","speaker":"白羽","text":"“好了请用。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"看着就已经能猜到，端出的果然是刺身。"},{"op":"text","speaker":"","text":"明显就是生的。"},{"op":"choice","variable":6001,"items":[{"text":"吃","value":0,"condition":1},{"text":"不吃","value":1,"condition":1}]},{"op":"if","truth":false,"target":210,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"上吧。"},{"op":"text","speaker":"","text":"我豁出去放进嘴中。"},{"op":"text","speaker":"羽依里","text":"“……！”"},{"op":"image","layer":1,"image":"i13076"},{"op":"text","speaker":"","text":"这…刺身。"},{"op":"text","speaker":"","text":"让我全身…麻痹起来。"},{"op":"text","speaker":"羽依里","text":"“呜啊啊啊。”"},{"op":"image","layer":1,"image":"i13144"},{"op":"text","speaker":"白羽","text":"“啊，难道说……”"},{"op":"text","speaker":"羽依里","text":"“好……”"},{"op":"text","speaker":"羽依里","text":"“好吃！”"},{"op":"text","speaker":"羽依里","text":"“真的，太好吃了。”"},{"op":"image","layer":1,"image":"i13115"},{"op":"text","speaker":"白羽","text":"“那个……”"},{"op":"text","speaker":"羽依里","text":"“你用了什么魔法？”"},{"op":"image","layer":1,"image":"i13131"},{"op":"text","speaker":"白羽","text":"“……只是处理了一下而已。”"},{"op":"text","speaker":"羽依里","text":"“我想也是，但不知道为什么会这么好吃。”"},{"op":"text","speaker":"羽依里","text":" “简直就是魔法！” "},{"op":"text","speaker":"","text":"亢奋的我，在胡言乱语后稍微平静了一些。"},{"op":"text","speaker":"羽依里","text":"“说实在真让我全身酥麻了。”"},{"op":"text","speaker":"羽依里","text":"“太厉害了，毒也全都去干净了吧。不过这也是理所当然的。”"},{"op":"image","layer":1,"image":"i13115"},{"op":"text","speaker":"白羽","text":"“哎？”"},{"op":"image","layer":1,"image":"i13174"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"image","layer":1,"image":"i13209"},{"op":"text","speaker":"白羽","text":"“骗人。”"},{"op":"text","speaker":"羽依里","text":"“？”"},{"op":"image","layer":1,"image":"i13174"},{"op":"text","speaker":"白羽","text":"“骗人的。”"},{"op":"text","speaker":"羽依里","text":"“不，真的很好吃啊。”"},{"op":"image","layer":1,"image":"i13128"},{"op":"text","speaker":"白羽","text":"“不是这个。”"},{"op":"image","layer":1,"image":"i13115"},{"op":"text","speaker":"白羽","text":"“我说有毒。”"},{"op":"image","layer":1,"image":"i13209"},{"op":"text","speaker":"白羽","text":"“是……骗你的。”"},{"op":"text","speaker":"羽依里","text":"“呃，唉？”"},{"op":"text","speaker":"","text":"你这也太难懂了。"},{"op":"image","layer":1,"image":"i13124"},{"op":"text","speaker":"白羽","text":"“你信了吗？”"},{"op":"text","speaker":"羽依里","text":"“啊，嗯……”"},{"op":"text","speaker":"","text":"那么严肃的表情谁不信啊。"},{"op":"text","speaker":"","text":"而且白羽这人根本就不像是会说谎的人。"},{"op":"image","layer":1,"image":"i13140"},{"op":"text","speaker":"白羽","text":"“……信了你还吃。”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"image","layer":1,"image":"i13067"},{"op":"text","speaker":"白羽","text":"“真是怪人。”"},{"op":"text","speaker":"","text":"又被她当怪人了。"},{"op":"image","layer":1,"image":"i13062"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"goto","target":265},{"op":"text","speaker":"羽依里","text":"“不，生吃就算了。”"},{"op":"text","speaker":"羽依里","text":"“我怕有什么万一。”"},{"op":"image","layer":1,"image":"i13059"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"image","layer":1,"image":"i13069"},{"op":"text","speaker":"白羽","text":"“骗你的。”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"image","layer":1,"image":"i13059"},{"op":"text","speaker":"白羽","text":"“说有毒是骗你的。”"},{"op":"text","speaker":"羽依里","text":"“呃，唉唉？”"},{"op":"text","speaker":"","text":"撒这种我听不懂的谎话还那么一本正经。"},{"op":"text","speaker":"羽依里","text":"“是吗。”"},{"op":"text","speaker":"羽依里","text":"“既然是假的，那我就不客气了。”"},{"op":"image","layer":1,"image":"i13079"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"image","layer":1,"image":"i13078"},{"op":"text","speaker":"白羽","text":"“不给了。”"},{"op":"text","speaker":"羽依里","text":"“唉唉唉？为什么？”"},{"op":"image","layer":1,"image":"i13194"},{"op":"text","speaker":"白羽","text":"“不给了。”"},{"op":"text","speaker":"","text":"她似乎有些生气。"},{"op":"text","speaker":"","text":"明明是自己撒谎骗人的，能怪我吗。"},{"op":"image","layer":1,"image":"i13164"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"她就像在撒气般，将刺身送进自己嘴中。"},{"op":"text","speaker":"","text":"而我则无可奈何地，看着她吃。"},{"op":"image","layer":1,"image":"i13201"},{"op":"text","speaker":"白羽","text":"“你那么想吃吗？”"},{"op":"text","speaker":"羽依里","text":"“啊!؟啊，嗯。”"},{"op":"image","layer":1,"image":"i13062"},{"op":"text","speaker":"白羽","text":"“那给。”"},{"op":"text","speaker":"羽依里","text":"“谢谢。”"},{"op":"text","speaker":"","text":"开吃……"},{"op":"text","speaker":"","text":"噢，真好吃。令人感动。"},{"op":"text","speaker":"","text":"而在我吃了几口之后，才意识到某个问题。"},{"op":"image","layer":1,"image":"i13062"},{"op":"text","speaker":"羽依里","text":"“呃，这好像是你咬过的……”"},{"op":"image","layer":1,"image":"i13144"},{"op":"text","speaker":"白羽","text":"“!؟”"},{"op":"image","layer":1,"image":"i13135"},{"op":"image","layer":1,"image":"i13134"},{"op":"text","speaker":"","text":"她二话不说把刺身抢走。"},{"op":"image","layer":1,"image":"i13147"},{"op":"text","speaker":"白羽","text":"“!!!!”"},{"op":"text","speaker":"","text":"然后一口气全吃掉了。"},{"op":"text","speaker":"羽依里","text":"“不不，你这样的话……”"},{"op":"text","speaker":"羽依里","text":"“就是把吃过的东西给我吃，然后又把我吃过的吃下去了。”"},{"op":"image","layer":1,"image":"i13144"},{"op":"text","speaker":"白羽","text":"“!!”"},{"op":"image","layer":1,"image":"i13078"},{"op":"text","speaker":"白羽","text":"“一来一回，扯平。”"},{"op":"text","speaker":"羽依里","text":"“来回扯平……吗。”"},{"op":"image","layer":1,"image":"i13094"},{"op":"text","speaker":"白羽","text":"“没错。”"},{"op":"text","speaker":"","text":"好吧。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"return"},{"op":"end"}]