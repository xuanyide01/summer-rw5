[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i18"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"第二天白羽也没有出现。"},{"op":"text","speaker":"","text":"而且其他人也全没来。"},{"op":"text","speaker":"","text":"良一估计是去了山那边吧。"},{"op":"text","speaker":"","text":"我独自一人在泳池旁等了一阵。"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"羽依里","text":"“好吧。”"},{"op":"text","speaker":"","text":"去找找看。"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i87"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“那个。”"},{"op":"text","speaker":"羽依里","text":"“打扰一下。”"},{"op":"text","speaker":"","text":"我下定决心，前往她家寻人。"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"没人应门。"},{"op":"text","speaker":"","text":"里面也察觉不到人的气息。"},{"op":"text","speaker":"羽依里","text":"“没人，吗……”"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i37"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“唔。”"},{"op":"image","layer":1,"image":"i10279"},{"op":"text","speaker":"苍","text":"“啊，土左卫门。”"},{"op":"text","speaker":"羽依里","text":"“我又没死！只是溺水而已。”"},{"op":"text","speaker":"羽依里","text":"“有没有见到白羽？”"},{"op":"image","layer":1,"image":"i10203"},{"op":"text","speaker":"苍","text":"“白羽？今天还没见过。”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"苍","text":"“有事吗？”"},{"op":"text","speaker":"羽依里","text":"“没什么。”"},{"op":"text","speaker":"羽依里","text":"“只是她没来练习了。”"},{"op":"image","layer":1,"image":"i10227"},{"op":"text","speaker":"苍","text":"“咦؟؟你还在教的吗？”"},{"op":"text","speaker":"羽依里","text":"“那当然。”"},{"op":"image","layer":1,"image":"i10254"},{"op":"text","speaker":"苍","text":"“唔……那就怪了。”"},{"op":"text","speaker":"羽依里","text":"“？”"},{"op":"image","layer":1,"image":"i10203"},{"op":"text","speaker":"苍","text":"“昨天，我在村公所那边遇到白羽了。”"},{"op":"text","speaker":"羽依里","text":"“啊!؟真的吗？”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"苍","text":"“嗯。然后，我就问她今天怎么不去练习。”"},{"op":"image","layer":1,"image":"i10213"},{"op":"text","speaker":"苍","text":"“结果她跟我说，虽然对不住你但练习就此结束了。”"},{"op":"text","speaker":"羽依里","text":"“她这么说啊。”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"苍","text":"“所以我还以为，你已经不教了。”"},{"op":"text","speaker":"羽依里","text":"“她什么都没对我说啊。”"},{"op":"image","layer":1,"image":"i10160"},{"op":"text","speaker":"苍","text":"“……”"},{"op":"image","layer":1,"image":"i10171"},{"op":"text","speaker":"苍","text":"“这样啊。”"},{"op":"image","layer":1,"image":"i10308"},{"op":"text","speaker":"苍","text":"“可能是这样，她觉得自己拜托你教游泳，结果害你溺水，心有愧疚吧。”"},{"op":"text","speaker":"羽依里","text":"“也许吧。”"},{"op":"text","speaker":"羽依里","text":"“只是我自己不小心而已，她根本不用放在心上的。”"},{"op":"image","layer":1,"image":"i10322"},{"op":"text","speaker":"苍","text":"“就是啊。”"},{"op":"image","layer":1,"image":"i10276"},{"op":"text","speaker":"苍","text":"“下次再见到她的话，我会告诉她你在找她的。”"},{"op":"text","speaker":"羽依里","text":"“嗯，拜托了。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"if","truth":false,"target":76,"value":["==",["v",6003],1]},{"op":"callScene","scene":80,"target":2},{"op":"goto","target":109},{"op":"if","truth":false,"target":79,"value":["==",["v",6003],2]},{"op":"callScene","scene":79,"target":2},{"op":"goto","target":109},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“我说，羽未啊。”"},{"op":"image","layer":1,"image":"i15496"},{"op":"text","speaker":"羽未","text":"“什么？”"},{"op":"text","speaker":"羽依里","text":"“还记得之前来过的鸣濑姐姐吗？”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“那个漂亮的姐姐？”"},{"op":"text","speaker":"羽依里","text":"“没、没错。”"},{"op":"text","speaker":"羽依里","text":"“你最近有没有见到她？”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“没印象，应该没有见过吧。”"},{"op":"text","speaker":"羽依里","text":"“哦。”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“她怎么了？”"},{"op":"image","layer":1,"image":"i15433"},{"op":"text","speaker":"羽未","text":"“跟你吵架了吗？”"},{"op":"text","speaker":"羽依里","text":"“算不上吵架。”"},{"op":"text","speaker":"羽依里","text":"“不过也差不多吧。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“你想跟她道歉对吧。”"},{"op":"text","speaker":"羽依里","text":"“差不多吧。”"},{"op":"image","layer":1,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“那去找不就行了。”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"image","layer":1,"image":"i15547"},{"op":"text","speaker":"羽未","text":"“这岛又没多大。”"},{"op":"image","layer":1,"image":"i15593"},{"op":"text","speaker":"羽未","text":"“她肯定在岛上的什么地方。”"},{"op":"text","speaker":"羽依里","text":"“你说得对。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i28"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“哟。”"},{"op":"text","speaker":"","text":"我拍了拍摩托的坐垫。"},{"op":"text","speaker":"","text":"最近都是去山里或者泳池，基本都没开过它。"},{"op":"text","speaker":"羽依里","text":"“今天要给我好好工作哦。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"return"},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i12162"},{"op":"text","speaker":"良一","text":"“啊，羽依里。”"},{"op":"text","speaker":"羽依里","text":"“哟。”"},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“你要去哪啊？”"},{"op":"text","speaker":"羽依里","text":"“不去哪……随便逛逛。”"},{"op":"image","layer":1,"image":"i12174"},{"op":"text","speaker":"良一","text":"“是吗？”"},{"op":"image","layer":1,"image":"i12141"},{"op":"text","speaker":"良一","text":"“对了，有人在找你哦。”"},{"op":"image","layer":1,"image":"i12174"},{"op":"text","speaker":"良一","text":"“突然拿照片出来给我看，问我认不认识这个人，吓了我一跳。”"},{"op":"text","speaker":"羽依里","text":"“照片？不会是警察之类的吧。”"},{"op":"image","layer":1,"image":"i12188"},{"op":"text","speaker":"良一","text":"“难不成你还犯过事？”"},{"op":"text","speaker":"羽依里","text":"“没、没有。”"},{"op":"image","layer":1,"image":"i12174"},{"op":"text","speaker":"良一","text":"“不是那种，是个跟我们年纪差不多的……”"},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“很可爱的女孩。”"},{"op":"text","speaker":"","text":"找我的可爱女孩？"},{"op":"text","speaker":"","text":"谁啊。"},{"op":"set","variable":71,"value":1},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"return"},{"op":"image","layer":0,"image":"i31"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“野美希。”"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“哦，你在干什么？”"},{"op":"text","speaker":"羽依里","text":"“有见到白羽吗？”"},{"op":"image","layer":1,"image":"i11731"},{"op":"text","speaker":"美希","text":"“你找她有事吗？”"},{"op":"text","speaker":"羽依里","text":"“嗯，算是吧……”"},{"op":"image","layer":1,"image":"i11709"},{"op":"text","speaker":"美希","text":"“哦？”"},{"op":"image","layer":1,"image":"i11750"},{"op":"text","speaker":"美希","text":"“好吧，我帮你叫叫看。”"},{"op":"text","speaker":"羽依里","text":"“叫叫看？”"},{"op":"image","layer":1,"image":"i11753"},{"op":"text","speaker":"美希","text":"“用那个。”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i158"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"野美希爬上耸立在公所旁边的，那座铁塔。"},{"op":"text","speaker":"","text":"片刻之后。"},{"op":"image","layer":7,"image":"i11730"},{"op":"text","speaker":"美希","text":"‘鸣濑白羽小姐。鸣濑白羽小姐。’"},{"op":"image","layer":7,"image":"i11695"},{"op":"text","speaker":"美希","text":"‘鹰原羽依里先生似乎有重要的事要跟你说。’"},{"op":"image","layer":7,"image":"i11714"},{"op":"text","speaker":"美希","text":"‘请到公所来。’"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i31"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11753"},{"op":"text","speaker":"美希","text":"“这下不管在岛上什么地方都能听到了。”"},{"op":"text","speaker":"羽依里","text":"“羞、羞死人了！”"},{"op":"text","speaker":"羽依里","text":"“谁说有重要的事了？”"},{"op":"image","layer":1,"image":"i11750"},{"op":"text","speaker":"美希","text":"“我觉得还是说得夸张点，更好唬她嘛。”"},{"op":"text","speaker":"羽依里","text":"“～～～”"},{"op":"text","speaker":"羽依里","text":"“太羞人了。说来你在最后一次练习后有见过白羽吗？”"},{"op":"text","speaker":"","text":"听到我的问题后，野美希开始细想。"},{"op":"image","layer":1,"image":"i11731"},{"op":"text","speaker":"美希","text":"“最后那次练习后，我确实也没见过白羽。”"},{"op":"image","layer":1,"image":"i11715"},{"op":"text","speaker":"美希","text":"“虽然令人在意，不过还是交给鹰原你吧。”"},{"op":"image","layer":1,"image":"i11696"},{"op":"text","speaker":"美希","text":"“有什么需要，尽管来找我。”"},{"op":"text","speaker":"羽依里","text":"“嗯，谢谢。”"},{"op":"set","variable":72,"value":1},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"return"},{"op":"image","layer":0,"image":"i37"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“哟。”"},{"op":"image","layer":1,"image":"i10279"},{"op":"text","speaker":"苍","text":"“啊，找到了找到了。”"},{"op":"text","speaker":"羽依里","text":"“找我？怎么？”"},{"op":"image","layer":1,"image":"i10416"},{"op":"text","speaker":"苍","text":"“就在刚才，有人向我打听你的事。”"},{"op":"text","speaker":"羽依里","text":"“唉唉。谁啊？”"},{"op":"image","layer":1,"image":"i10154"},{"op":"text","speaker":"苍","text":"“不认识的女孩。”"},{"op":"text","speaker":"","text":"不认识的女孩؟؟؟"},{"op":"image","layer":1,"image":"i10243"},{"op":"text","speaker":"苍","text":"“唔～～～”"},{"op":"image","layer":1,"image":"i10252"},{"op":"text","speaker":"苍","text":"“我看你也不像是那种会有女孩追到这来的人啊。”"},{"op":"text","speaker":"羽依里","text":"“有女孩在找我吗？”"},{"op":"image","layer":1,"image":"i10235"},{"op":"text","speaker":"苍","text":"“嗯，对。她还给我看了照片，是你没错。”"},{"op":"text","speaker":"","text":"怎么回事啊؟؟"},{"op":"text","speaker":"","text":"在我找白羽的这段时间里，好像还有个神秘女孩在找我。"},{"op":"text","speaker":"","text":"这到底是演的哪出啊？"},{"op":"image","layer":1,"image":"i10200"},{"op":"text","speaker":"苍","text":"“那么，你还在追着白羽不放吗？”"},{"op":"text","speaker":"羽依里","text":"“只是在找她而已！”"},{"op":"image","layer":1,"image":"i10267"},{"op":"text","speaker":"苍","text":"“也不知道是去哪了啊，这白羽，这又没什么地方能去。”"},{"op":"image","layer":1,"image":"i10254"},{"op":"text","speaker":"苍","text":"“看她也不是会一个人进山的那种人。”"},{"op":"text","speaker":"羽依里","text":"“是啊。”"},{"op":"set","variable":73,"value":1},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"return"},{"op":"image","layer":0,"image":"i51"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我来到岛的外围。"},{"op":"text","speaker":"","text":"以前她倒是经常在这一带闲逛……"},{"op":"text","speaker":"","text":"不在吗。"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"我在附近逛了一圈，但谁也没碰上。"},{"op":"text","speaker":"","text":"回去吧。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"set","variable":74,"value":1},{"op":"return"},{"op":"if","truth":false,"target":271,"value":["==",["v",6003],1]},{"op":"callScene","scene":80,"target":28},{"op":"goto","target":298},{"op":"if","truth":false,"target":274,"value":["==",["v",6003],2]},{"op":"callScene","scene":79,"target":29},{"op":"goto","target":298},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“啊，鹰原哥。”"},{"op":"image","layer":1,"image":"i15472"},{"op":"text","speaker":"羽未","text":"“你在外面的时候有电话找你。”"},{"op":"text","speaker":"羽依里","text":"“电话？谁啊？”"},{"op":"text","speaker":"","text":"好像有人在到处找我，是那人吗？"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“鸣濑姐姐打来的。”"},{"op":"text","speaker":"羽依里","text":"“唉唉!؟”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“她让我告诉你。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“‘在泳池等你。’”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“就这样。”"},{"op":"text","speaker":"羽依里","text":"“她这么说的吗？”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“对，就这句而已。”"},{"op":"text","speaker":"羽依里","text":"“在泳池等我……”"},{"op":"text","speaker":"羽依里","text":"“怎么说得跟下战书似的。”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“问我干什么……”"},{"op":"set","variable":75,"value":1},{"op":"return"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i37"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"本以为她故意躲起来，现在却突然约我见面。"},{"op":"text","speaker":"","text":"真不知道她到底在想什么。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i158"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"……看到了。"},{"op":"text","speaker":"","text":"白羽独自一人，坐在泳池边的长椅上。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i18"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13548"},{"op":"text","speaker":"羽依里","text":"“哟。”"},{"op":"image","layer":1,"image":"i13459"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"她站起身，向我点点头。"},{"op":"text","speaker":"羽依里","text":"“还是决定要练习了？”"},{"op":"text","speaker":"","text":"白羽已经穿好了泳装。"},{"op":"image","layer":1,"image":"i13480"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"她摇头。"},{"op":"text","speaker":"羽依里","text":"“？”"},{"op":"text","speaker":"","text":"二话不说地站到了跳水台上。"},{"op":"image","layer":0,"image":"i206"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i13470"},{"op":"text","speaker":"白羽","text":"“吸……”"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i18"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“喂，喂。”"},{"op":"text","speaker":"","text":"没等我制止，她就已经跳了下去。"},{"op":"text","speaker":"羽依里","text":"“噢……”"},{"op":"text","speaker":"","text":"……她的泳姿，并不算优美。"},{"op":"image","layer":7,"image":"i13482"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"但是，比起之前的她已经好到判若两人。"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"游完了25米。"},{"op":"image","layer":0,"image":"i18"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13547"},{"op":"text","speaker":"羽依里","text":"“噢噢。”"},{"op":"text","speaker":"羽依里","text":"“挺厉害的啊。”"},{"op":"text","speaker":"羽依里","text":"“什么时候游这么好了？”"},{"op":"image","layer":1,"image":"i13544"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"image","layer":1,"image":"i13532"},{"op":"text","speaker":"白羽","text":"“约定。”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"image","layer":1,"image":"i13503"},{"op":"text","speaker":"白羽","text":"“等我学会游泳你就回家。”"},{"op":"text","speaker":"羽依里","text":"“……啊，哦。”"},{"op":"text","speaker":"羽依里","text":"“不过要等你真能在大海游起来才行。”"},{"op":"image","layer":1,"image":"i13462"},{"op":"text","speaker":"白羽","text":"“不，足够了。”"},{"op":"image","layer":1,"image":"i13459"},{"op":"text","speaker":"白羽","text":"“我们说好的。”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"image","layer":1,"image":"i13478"},{"op":"text","speaker":"白羽","text":"“回去。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i13545"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"声音","text":"“鹰原。”"},{"op":"text","speaker":"","text":"呃……"},{"op":"text","speaker":"","text":"突然，从另一个方向听到有人叫我。"},{"op":"text","speaker":"","text":"回头一看，是一个很熟悉……但却是不该出现在这座岛上的人，站在那里。"},{"op":"text","speaker":"؟؟؟","text":"“……”"},{"op":"text","speaker":"","text":"及肩的长发。"},{"op":"text","speaker":"","text":"粉红衬衫，紧身牛仔裤。"},{"op":"text","speaker":"","text":"在城里很普遍的装束，但在这岛上却显得非常异样。"},{"op":"text","speaker":"","text":"为什么这家伙，会在这里？"},{"op":"text","speaker":"羽依里","text":"“……惠。”"},{"op":"image","layer":7,"image":"i13477"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"惠","text":"“……”"},{"op":"text","speaker":"","text":"完全搞不清状况。"},{"op":"text","speaker":"","text":"但是，现在我该优先的是白羽。"},{"op":"text","speaker":"羽依里","text":"“抱歉。现在……”"},{"op":"text","speaker":"惠","text":"“不好意思，打断你们的话了吧。”"},{"op":"text","speaker":"惠","text":"“因为好不容易才找到你。就不禁喊出声来了。”"},{"op":"image","layer":1,"image":"i13480"},{"op":"text","speaker":"白羽","text":"“没有。”"},{"op":"image","layer":1,"image":"i13548"},{"op":"text","speaker":"白羽","text":"“我先走了。”"},{"op":"text","speaker":"羽依里","text":"“喂等一下。”"},{"op":"image","layer":1,"image":"i13545"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"image","layer":1,"image":"i13579"},{"op":"text","speaker":"白羽","text":"“拜拜。”"},{"op":"text","speaker":"羽依里","text":"“唉……”"},{"op":"text","speaker":"","text":"她道别后，就径直走到了更衣室中。"},{"op":"text","speaker":"惠","text":"“打扰到你了吗？”"},{"op":"text","speaker":"羽依里","text":"“……没事。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"拜拜，吗。"},{"op":"text","speaker":"羽依里","text":"“你来这干什么？”"},{"op":"text","speaker":"惠","text":"“观光。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i15"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"惠","text":"“你在这多长时间了？”"},{"op":"text","speaker":"羽依里","text":"“半个月左右吧。”"},{"op":"text","speaker":"惠","text":"“真长啊。”"},{"op":"text","speaker":"羽依里","text":"“毕竟是暑假嘛。”"},{"op":"text","speaker":"惠","text":"“鹰原啊。”"},{"op":"text","speaker":"羽依里","text":"“干什么？”"},{"op":"text","speaker":"惠","text":"“……其实我也不想说这么羞耻的话。”"},{"op":"text","speaker":"羽依里","text":"“什，什么啊？”"},{"op":"if","truth":false,"target":431,"value":["==",["v",24],1]},{"op":"text","speaker":"惠","text":"“受伤的翅膀好了吗？”"},{"op":"goto","target":440},{"op":"if","truth":false,"target":434,"value":["==",["v",25],1]},{"op":"text","speaker":"惠","text":"“找回歌声了吗？金丝雀先生。”"},{"op":"goto","target":440},{"op":"if","truth":false,"target":437,"value":["==",["v",26],1]},{"op":"text","speaker":"惠","text":"“拳头的伤还痛吗？”"},{"op":"goto","target":440},{"op":"if","truth":false,"target":440,"value":["==",["v",27],1]},{"op":"text","speaker":"惠","text":"“能回到牛郎的工作中了吗？”"},{"op":"goto","target":440},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“你从哪听来的？”"},{"op":"text","speaker":"惠","text":"“我在岛上打听你的事，就有人很高兴地告诉我这些。”"},{"op":"text","speaker":"惠","text":"“没想到你竟然会有这种想法。”"},{"op":"text","speaker":"惠","text":"“虽然确实发生了很多事。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"惠","text":"“你的停学期间是两周，所以已经结束了吧。”"},{"op":"text","speaker":"羽依里","text":"“没错，虽然本来就是放假，倒也没停学的感觉。”"},{"op":"text","speaker":"惠","text":"“那你是不是该回来了？”"},{"op":"text","speaker":"羽依里","text":"“暑假还没完啊。”"},{"op":"text","speaker":"惠","text":"“社团活动也没停。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"惠","text":"“你要是不抓紧这个夏天复出，那肯定不会再有机会了。”"},{"op":"text","speaker":"惠","text":"“现在不回去的话，以后，就真回不去了。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"惠","text":"“傍晚，我在回去的船上等你。”"},{"op":"text","speaker":"","text":"惠起身往店外走去。"},{"op":"text","speaker":"羽依里","text":"“你要去哪？”"},{"op":"text","speaker":"惠","text":"“难得来一趟，踏上归途前好好观光一下。”"},{"op":"text","speaker":"惠","text":"“毕竟交通费都花了，什么都不做就回去也太浪费了。”"},{"op":"text","speaker":"羽依里","text":"“不用导游吗？”"},{"op":"text","speaker":"惠","text":"“不用了，你就自己好好考虑一下吧。”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"走掉了。"},{"op":"image","layer":1,"image":"i12174"},{"op":"text","speaker":"良一","text":"“喂。”"},{"op":"text","speaker":"","text":"就像等着人家离去般，良一等人闯了进来。"},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“那可爱的人儿是谁啊？”"},{"op":"text","speaker":"羽依里","text":"“熟人。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“我回来了。”"},{"op":"image","layer":1,"image":"i11549"},{"op":"text","speaker":"镜子","text":"“怎么样？见到白羽了吗？”"},{"op":"text","speaker":"羽依里","text":"“嗯……那个，见是见到了。”"},{"op":"text","speaker":"羽依里","text":"“但总感觉事情越发复杂了。”"},{"op":"image","layer":1,"image":"i11578"},{"op":"text","speaker":"羽依里","text":"“我的同学也过来了。”"},{"op":"image","layer":1,"image":"i11581"},{"op":"text","speaker":"镜子","text":"“嗯。我听说了，有个人来找你。”"},{"op":"text","speaker":"羽依里","text":"“说我是时候回去了。”"},{"op":"image","layer":1,"image":"i11578"},{"op":"text","speaker":"镜子","text":"“这样啊。”"},{"op":"image","layer":1,"image":"i11581"},{"op":"text","speaker":"镜子","text":"“你是怎么打算的？”"},{"op":"text","speaker":"羽依里","text":"“不知道啊。”"},{"op":"text","speaker":"羽依里","text":"“如果有一天不得不回去的话……”"},{"op":"text","speaker":"羽依里","text":"“也许真是时候了。”"},{"op":"text","speaker":"羽依里","text":"“唔。”"},{"op":"image","layer":1,"image":"i11617"},{"op":"text","speaker":"镜子","text":"“难道你想一直住在这吗？”"},{"op":"text","speaker":"羽依里","text":"“啊哈哈……不行的吧。”"},{"op":"image","layer":1,"image":"i11635"},{"op":"text","speaker":"镜子","text":"“我倒是没什么意见。”"},{"op":"image","layer":1,"image":"i11599"},{"op":"text","speaker":"镜子","text":"“不过你想在这干什么？”"},{"op":"text","speaker":"羽依里","text":"“想干什么呢。”"},{"op":"text","speaker":"羽依里","text":"“我大概是犯糊涂了吧。”"},{"op":"image","layer":1,"image":"i11595"},{"op":"text","speaker":"镜子","text":"“反正是暑假，不也挺好的嘛。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i68"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我想起刚来这里的时候。"},{"op":"text","speaker":"","text":"不知是不是错觉，感觉蝉鸣没有当时那么吵了。"},{"op":"text","speaker":"","text":"只是时间段的问题吗？"},{"op":"text","speaker":"","text":"8月也才刚过一半。"},{"op":"text","speaker":"","text":"离夏天的结束还长着呢。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"刚来这里的时候，我好像也在船上见到过白羽吧。"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":1795,"image":"i18201"},{"op":"image","layer":0,"image":"i1001"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"她一个人看着大海。"},{"op":"text","speaker":"","text":"或说是大海的另一头？"},{"op":"text","speaker":"","text":"就像是在等待着什么一样。"},{"op":"text","speaker":"","text":"她在等什么啊？"},{"op":"clear","layer":1795},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“镜子阿姨，请问。”"},{"op":"image","layer":1,"image":"i11566"},{"op":"text","speaker":"镜子","text":"“？”"},{"op":"text","speaker":"羽依里","text":"“傍晚的船是几点出航的？”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i435"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"真是不可思议。"},{"op":"text","speaker":"","text":"感觉身体比起半个月前刚到岛上时轻了很多。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"if","truth":false,"target":552,"value":["==",["v",24],1]},{"op":"text","speaker":"","text":"也许翅膀……已经好了。"},{"op":"goto","target":564},{"op":"if","truth":false,"target":556,"value":["==",["v",25],1]},{"op":"text","speaker":"","text":"也许现在，能唱得出歌了。"},{"op":"text","speaker":"","text":"虽然并不会去唱。"},{"op":"goto","target":564},{"op":"if","truth":false,"target":560,"value":["==",["v",26],1]},{"op":"text","speaker":"","text":"也许拳头已经治好了。"},{"op":"text","speaker":"","text":"斗志昂扬，可以再战。"},{"op":"goto","target":564},{"op":"if","truth":false,"target":564,"value":["==",["v",27],1]},{"op":"text","speaker":"","text":"不知不觉间，我似乎重建起所谓的自信了。"},{"op":"text","speaker":"","text":"感觉哄个女孩已不在话下。"},{"op":"goto","target":564},{"op":"text","speaker":"","text":"说笑的。"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":1},{"op":"image","layer":0,"image":"i4"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"羽依里","text":"“哟。”"},{"op":"text","speaker":"惠","text":"“呀。”"},{"op":"text","speaker":"惠","text":"“……这样吗。”"},{"op":"text","speaker":"","text":"看到我的打扮后，惠叹了叹气。"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“我不回去。”"},{"op":"text","speaker":"惠","text":"“看出来了，行李都没带。”"},{"op":"text","speaker":"惠","text":"“这么悠哉的小岛，的确舒适。”"},{"op":"text","speaker":"惠","text":"“但你也不可能一直待在这里。”"},{"op":"text","speaker":"惠","text":"“你还有什么事想在这做？”"},{"op":"text","speaker":"羽依里","text":"“该怎么说呢。”"},{"op":"text","speaker":"羽依里","text":"“我曾经忘掉了。”"},{"op":"text","speaker":"惠","text":"“忘了什么？”"},{"op":"text","speaker":"羽依里","text":"“……唔。”"},{"op":"text","speaker":"羽依里","text":"“暑假的过法。”"},{"op":"text","speaker":"惠","text":"“什么东西？”"},{"op":"text","speaker":"惠","text":"“还有过法的吗？”"},{"op":"text","speaker":"羽依里","text":"“看来还是有的。”"},{"op":"text","speaker":"惠","text":"“那么说……答案能在这座岛上找到？”"},{"op":"text","speaker":"羽依里","text":"“应该是吧。”"},{"op":"text","speaker":"惠","text":"“我听不太懂。”"},{"op":"text","speaker":"惠","text":"“你没事吧？”"},{"op":"text","speaker":"羽依里","text":"“我也不知道。”"},{"op":"text","speaker":"惠","text":"“不过既然你已经决定了。”"},{"op":"text","speaker":"惠","text":"“再说下去就是多管闲事了。”"},{"op":"text","speaker":"惠","text":"“你喜欢怎样就怎样吧。”"},{"op":"text","speaker":"惠","text":"“坏蛋。”"},{"op":"image","layer":0,"image":"i163"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"……船开走了。"},{"op":"image","layer":0,"image":"i3"},{"op":"set","variable":6714,"value":4},{"op":"image","layer":1,"image":"i15038"},{"op":"text","speaker":"天善","text":"“你不走吗？”"},{"op":"image","layer":257,"image":"i12144"},{"op":"text","speaker":"良一","text":"“让人家一个人回去……”"},{"op":"image","layer":257,"image":"i12188"},{"op":"text","speaker":"良一","text":"“真是个坏男人啊，居然惹那么可爱的女孩哭泣。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“……那家伙，是我的同学。”"},{"op":"image","layer":1,"image":"i15011"},{"op":"image","layer":257,"image":"i12180"},{"op":"text","speaker":"良一","text":"“那不是挺好吗。”"},{"op":"text","speaker":"羽依里","text":"“同一所学校的。”"},{"op":"image","layer":257,"image":"i12177"},{"op":"text","speaker":"良一","text":"“那自然是，都说是同学了。”"},{"op":"image","layer":1,"image":"i15032"},{"op":"image","layer":257,"image":"i12174"},{"op":"text","speaker":"良一","text":"“嗯？”"},{"op":"image","layer":257,"image":"i12150"},{"op":"text","speaker":"良一","text":"“我记得你……”"},{"op":"text","speaker":"羽依里","text":"“是读男校的。”"},{"op":"image","layer":1,"image":"i15026"},{"op":"image","layer":257,"image":"i12168"},{"op":"text","speaker":"良一·天善","text":"“!؟”"},{"op":"image","layer":1,"image":"i15149"},{"op":"image","layer":257,"image":"i12220"},{"op":"text","speaker":"良一·天善","text":"“城市好可怕！”"},{"op":"text","speaker":"羽依里","text":"“我过去一趟。”"},{"op":"image","layer":1,"image":"i15038"},{"op":"image","layer":257,"image":"i12174"},{"op":"text","speaker":"良一","text":"“去哪？”"},{"op":"text","speaker":"羽依里","text":"“不知道。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i170"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"太阳已经消失在西边。"},{"op":"text","speaker":"","text":"四周一片漆黑。"},{"op":"text","speaker":"","text":"我骑着摩托，一心一意地寻找着。"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i1091"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i1089"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“白羽！”"},{"op":"image","layer":0,"image":"i1090"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“……咦？”"},{"op":"text","speaker":"白羽","text":"“你……”"},{"op":"text","speaker":"白羽","text":"“你怎么会在这？”"},{"op":"text","speaker":"羽依里","text":"“这还要理由吗。”"},{"op":"text","speaker":"白羽","text":"“为什么……不回去？”"},{"op":"text","speaker":"羽依里","text":"“因为暑假还没过完。”"},{"op":"text","speaker":"羽依里","text":"“然后如果你问我为什么会知道你在这的话。”"},{"op":"text","speaker":"羽依里","text":" “那是因为我找遍了整个岛！” "},{"op":"text","speaker":"白羽","text":"“是、是吗。”"},{"op":"text","speaker":"羽依里","text":"“白天见到你的时候，我发现你鞋子沾了泥。”"},{"op":"text","speaker":"羽依里","text":"“所以我猜，你应该是在某处人烟稀少的海岸。”"},{"op":"text","speaker":"羽依里","text":"“于是就想到哪找到哪。”"},{"op":"text","speaker":"羽依里","text":"“所以，也算是运气吧。”"},{"op":"text","speaker":"羽依里","text":"“你在这干什么？”"},{"op":"text","speaker":"白羽","text":"“已经结束了。”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"image","layer":0,"image":"i1089"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“你要是早点来就好了。”"},{"op":"text","speaker":"羽依里","text":"“什么意思？”"},{"op":"image","layer":0,"image":"i1092"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“秘密。”"},{"op":"text","speaker":"羽依里","text":"“؟؟؟”"},{"op":"image","layer":0,"image":"i1089"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"…………"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"白羽","text":"“我喜欢你。”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"白羽","text":"“有人跟我说。”"},{"op":"text","speaker":"羽依里","text":"“谁？”"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"白羽","text":"“是一个……岛上的男孩。”"},{"op":"text","speaker":"白羽","text":"“我并不认识他。”"},{"op":"text","speaker":"白羽","text":"“不过对方似乎认识我。”"},{"op":"image","layer":0,"image":"i1090"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“为什么啊？”"},{"op":"text","speaker":"","text":"她看似真的很疑惑地说到。"},{"op":"text","speaker":"羽依里","text":"“这还用问……不是很常见的事吗？”"},{"op":"text","speaker":"","text":"一方看得如痴如醉，而另一方却没有丝毫察觉。"},{"op":"text","speaker":"","text":"虽然可悲，但却很常见。大概。"},{"op":"text","speaker":"白羽","text":"“很……常见吗。”"},{"op":"image","layer":0,"image":"i1089"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“总之我，听到后。”"},{"op":"text","speaker":"白羽","text":"“拒绝了。”"},{"op":"text","speaker":"白羽","text":"“可他就是不愿意放弃。”"},{"op":"text","speaker":"白羽","text":"“让我很头疼。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":1795,"image":"i18201"},{"op":"image","layer":0,"image":"i170"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"白羽","text":"“后来，有一天。”"},{"op":"text","speaker":"白羽","text":"“我看到了那人溺水的情景。”"},{"op":"text","speaker":"白羽","text":"“那情景不像梦境非常真实……很可怕。”"},{"op":"text","speaker":"白羽","text":"“我非常担心……就拜托那人的朋友，转告给他。”"},{"op":"text","speaker":"白羽","text":"“但估计是被会错意了。”"},{"op":"text","speaker":"白羽","text":"“传成了我对那人下了诅咒的样子……”"},{"op":"text","speaker":"白羽","text":"“然后。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1795},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":1795,"image":"i18201"},{"op":"image","layer":0,"image":"i147"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“那人就真的从崖上掉下去溺水了。”"},{"op":"text","speaker":"白羽","text":"“虽然命救回来了。”"},{"op":"text","speaker":"白羽","text":"“但是，在那之后……关于我的传言就真的传开了。”"},{"op":"text","speaker":"白羽","text":"“有人说看到我在崖上，怀疑是我把人推下去的。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1795},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":1795,"image":"i18201"},{"op":"image","layer":0,"image":"i154"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“还受到了警察的传唤。”"},{"op":"text","speaker":"白羽","text":"“乘船过去，在一个很大的警察局被问话。”"},{"op":"text","speaker":"白羽","text":"“然后……就传得岛上无人不知了。”"},{"op":"clear","layer":1795},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i1089"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“你当时为什么会在崖上？”"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"白羽","text":"“因为我很担心。”"},{"op":"text","speaker":"白羽","text":"“那个梦实在是太真实了。”"},{"op":"text","speaker":"白羽","text":"“我担心这事真的会发生。”"},{"op":"text","speaker":"白羽","text":"“所以就跟踪了那个男孩。”"},{"op":"text","speaker":"白羽","text":"“然后，他就从崖上掉了下去……我也在场。”"},{"op":"text","speaker":"羽依里","text":"“你没把这些向别人说明吗？”"},{"op":"text","speaker":"白羽","text":"“……你知道，我就这样子。”"},{"op":"text","speaker":"羽依里","text":"“也，也是。”"},{"op":"text","speaker":"白羽","text":"“而且根本无法解释，我为什么会在那。”"},{"op":"text","speaker":"羽依里","text":"“的确，解释不清。”"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"白羽","text":"“而且，说不定真的是我的错。”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"text","speaker":"白羽","text":"“当然，我并没有下什么诅咒。”"},{"op":"text","speaker":"白羽","text":"“虽然没有下……可也许，就是我的错……”"},{"op":"text","speaker":"羽依里","text":"“为什么？”"},{"op":"text","speaker":"白羽","text":"“我有着不可思议的能力。”"},{"op":"text","speaker":"白羽","text":"“自幼开始。”"},{"op":"text","speaker":"白羽","text":"“我就能看到未来。”"},{"op":"text","speaker":"羽依里","text":"“看到……未来？”"},{"op":"text","speaker":"","text":"白羽轻轻地点了点头。"},{"op":"text","speaker":"白羽","text":"“而且还必然是不好的未来。”"},{"op":"text","speaker":"羽依里","text":"“是像预知未来之类的吗？”"},{"op":"text","speaker":"白羽","text":"“可能是吧。”"},{"op":"text","speaker":"白羽","text":"“又或者是，我选定了未来。”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"text","speaker":"羽依里","text":"“你说的，是什么意思？”"},{"op":"text","speaker":"白羽","text":"“哪怕我没想过要下咒，那人也的确令我感到困扰。所以我就希望他能离我远点。然后就……”"},{"op":"text","speaker":"白羽","text":"“所以，那件事肯定是我的错。”"},{"op":"text","speaker":"白羽","text":"“这是我闯下的祸。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"我在脑子里整理白羽所说的一切。"},{"op":"text","speaker":"","text":"思考着该对她说什么好。"},{"op":"text","speaker":"","text":"但是，我想不出来。"},{"op":"text","speaker":"","text":"这种时候，我能做的也就只有听她倾诉。"},{"op":"image","layer":0,"image":"i1089"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"她似乎一直在钻牛角尖。"},{"op":"text","speaker":"","text":"就像是想把藏到现在都没法说出口的东西，一口气全倒出来了一般。"},{"op":"text","speaker":"","text":"我知道，现在只能默默等待。"},{"op":"text","speaker":"白羽","text":"“然后……”"},{"op":"text","speaker":"白羽","text":"“我。”"},{"op":"text","speaker":"白羽","text":"“我会在这个夏天死去。”"},{"op":"text","speaker":"","text":"……啊。"},{"op":"text","speaker":"羽依里","text":"“你说，什么？”"},{"op":"image","layer":259,"image":"i18126"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"白羽","text":"“我看到了。”"},{"op":"text","speaker":"白羽","text":"“天空一片昏暗，大海波涛汹涌。”"},{"op":"text","speaker":"白羽","text":"“我被卷了进去。”"},{"op":"text","speaker":"羽依里","text":"“你是说……”"},{"op":"clear","layer":259},{"op":"image","layer":1795,"image":"i18141"},{"op":"image","layer":0,"image":"i497"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"白羽","text":"“我想应该是溺水了。”"},{"op":"text","speaker":"白羽","text":"“大概，是在夜晚的海里。”"},{"op":"text","speaker":"羽依里","text":"“在夜晚的海里……溺水了？”"},{"op":"text","speaker":"白羽","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“什么时候？”"},{"op":"text","speaker":"白羽","text":"“时间不清楚。不过，我觉得应该不会太远。”"},{"op":"text","speaker":"羽依里","text":"“你为什么会在海里？”"},{"op":"text","speaker":"白羽","text":"“不清楚。”"},{"op":"text","speaker":"白羽","text":"“不过这还不是全部。”"},{"op":"text","speaker":"白羽","text":"“还不是全部。”"},{"op":"text","speaker":"白羽","text":"“不是只有我一个人。”"},{"op":"text","speaker":"白羽","text":"“那里除了我还有人在。”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"text","speaker":"白羽","text":"“这样下去的话，会连累到别人。”"},{"op":"text","speaker":"白羽","text":"“跟我在一起，就会害其他人一起溺水。”"},{"op":"text","speaker":"","text":"白羽说这句话时，一直关切地看着我。"},{"op":"text","speaker":"","text":"哪怕我再愚钝，也该猜出来了。"},{"op":"text","speaker":"羽依里","text":"“你说的那个人，就是我吗？”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1795},{"op":"clear","layer":1539},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i1089"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“……嗯。”"},{"op":"text","speaker":"白羽","text":"“我看到了，那个人手上戴着手表。”"},{"op":"text","speaker":"羽依里","text":"“手表……”"},{"op":"text","speaker":"羽依里","text":"“这个？”"},{"op":"text","speaker":"","text":"她点了点头。"},{"op":"text","speaker":"羽依里","text":"“就是这块能承受水深100米压力的限定版潜水表吗？”"},{"op":"image","layer":0,"image":"i1090"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“我、我不懂这些，反正就是这块手表。”"},{"op":"text","speaker":"羽依里","text":"“这么说，就只能是我了。毕竟这款全世界限量50块。”"},{"op":"text","speaker":"白羽","text":"“没、没错。”"},{"op":"text","speaker":"羽依里","text":"“……限定版……”"},{"op":"text","speaker":"羽依里","text":"“不对，我会溺水!؟”"},{"op":"text","speaker":"白羽","text":"“是的。”"},{"op":"text","speaker":"羽依里","text":"“这样啊。”"},{"op":"text","speaker":"","text":"就是说，我也很危险？"},{"op":"text","speaker":"","text":"这实在是一时间让人难以保持平静。"},{"op":"text","speaker":"羽依里","text":"“不过，水深100米以内它都没问题。”"},{"op":"text","speaker":"白羽","text":"“手表没问题但是你有问题。”"},{"op":"text","speaker":"羽依里","text":"“你说得对。”"},{"op":"text","speaker":"羽依里","text":"“说得对啊。”"},{"op":"text","speaker":"","text":"水深100米会是什么状况呢。除手表之外全部爆炸？"},{"op":"text","speaker":"","text":"不过要较真的话，溺水根本就不可能沉到水深100米啊！"},{"op":"text","speaker":"","text":"真的有点慌了神。"},{"op":"image","layer":0,"image":"i1089"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“我……”"},{"op":"text","speaker":"白羽","text":"“我就算死掉也无所谓。”"},{"op":"text","speaker":"白羽","text":"“但是，我不想牵连其他人。”"},{"op":"text","speaker":"羽依里","text":"“你……”"},{"op":"text","speaker":"羽依里","text":"“你说什么傻话呢。”"},{"op":"text","speaker":"白羽","text":"“因为我命中注定如此。”"},{"op":"text","speaker":"羽依里","text":"“命中注定……”"},{"op":"text","speaker":"羽依里","text":"“这是什么意思？”"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"白羽","text":"“总之。”"},{"op":"text","speaker":"白羽","text":"“我不想牵连任何人。”"},{"op":"text","speaker":"白羽","text":"“不管是羽依里还是别人。”"},{"op":"text","speaker":"羽依里","text":"“白羽……”"},{"op":"text","speaker":"白羽","text":"“可是为什么。”"},{"op":"text","speaker":"白羽","text":"“为什么……”"},{"op":"text","speaker":"白羽","text":"“你要接近我。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":0,"image":"i170"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"我们默不作声，两眼相对。"},{"op":"text","speaker":"","text":"现在有话必须对她说。"},{"op":"text","speaker":"","text":"但我却在想，轻易地将这句话说出口真的好吗？"},{"op":"text","speaker":"","text":"一说出口，从某种意义来说，我就必须负起责任来了。"},{"op":"text","speaker":"","text":"对她所肩负的东西。"},{"op":"text","speaker":"","text":"我有这种觉悟，有这种能力吗？"},{"op":"text","speaker":"","text":"不敢面对自己的困境，逃到这岛来，只求片刻安息的我。"},{"op":"text","speaker":"","text":"我……"},{"op":"image","layer":0,"image":"i50"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":1,"image":"i13253"},{"op":"text","speaker":"羽依里","text":"“白羽你说的，我都相信。”"},{"op":"text","speaker":"羽依里","text":"“虽然都很不现实。”"},{"op":"text","speaker":"羽依里","text":"“我也不敢说自己都理解了。”"},{"op":"text","speaker":"羽依里","text":"“但是，我就是相信你。”"},{"op":"text","speaker":"羽依里","text":"“这可不是没经大脑乱说的。”"},{"op":"image","layer":1,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“谢谢……”"},{"op":"image","layer":1,"image":"i13426"},{"op":"text","speaker":"白羽","text":"“所以，你就别再跟我……”"},{"op":"text","speaker":"羽依里","text":"“所以！”"},{"op":"image","layer":1,"image":"i13418"},{"op":"text","speaker":"白羽","text":"“!؟”"},{"op":"text","speaker":"羽依里","text":"“我们一起加油吧。”"},{"op":"image","layer":1,"image":"i13259"},{"op":"text","speaker":"白羽","text":"“唉……？”"},{"op":"text","speaker":"羽依里","text":"“假如你所见到的未来真的在等着我们。”"},{"op":"text","speaker":"羽依里","text":"“那我们就一起尽一切努力，想办法避开它吧。”"},{"op":"image","layer":1,"image":"i13235"},{"op":"text","speaker":"白羽","text":"“尽一切努力……”"},{"op":"image","layer":1,"image":"i13346"},{"op":"text","speaker":"白羽","text":"“根本就不会有办法。”"},{"op":"image","layer":1,"image":"i13304"},{"op":"text","speaker":"白羽","text":"“因为，未来已有定数。”"},{"op":"text","speaker":"羽依里","text":"“也许你说得对。”"},{"op":"text","speaker":"羽依里","text":"“但那个男孩不是也没死吗？”"},{"op":"image","layer":1,"image":"i13340"},{"op":"text","speaker":"白羽","text":"“嗯……”"},{"op":"text","speaker":"羽依里","text":"“也许就是由于你出于担心，拿出勇气提醒了他。”"},{"op":"text","speaker":"羽依里","text":"“他才会多加注意，避开了最糟糕的结局。”"},{"op":"image","layer":1,"image":"i13304"},{"op":"text","speaker":"白羽","text":"“可是，他最终还是从崖上掉了下去，我没能阻止事情发生。”"},{"op":"text","speaker":"羽依里","text":"“但是，他活下来了。”"},{"op":"text","speaker":"羽依里","text":"“要是那个男孩好好接受你的提醒，也许就真什么都不会发生了。”"},{"op":"image","layer":1,"image":"i13373"},{"op":"text","speaker":"白羽","text":"“……未来是不会变的。”"},{"op":"text","speaker":"羽依里","text":"“你刚才说的话，是当真那么想的吗？”"},{"op":"text","speaker":"羽依里","text":"“说自己死也无所谓。”"},{"op":"image","layer":1,"image":"i13384"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“肯定不是的吧。”"},{"op":"text","speaker":"羽依里","text":"“你不也是……”"},{"op":"text","speaker":"羽依里","text":"“因为不想死才拼命想去学游泳的吗？”"},{"op":"image","layer":1,"image":"i13426"},{"op":"text","speaker":"白羽","text":"“这……”"},{"op":"text","speaker":"羽依里","text":"“我不知道你的预言会不会真的发生。”"},{"op":"text","speaker":"羽依里","text":"“但起码把该做的都做尽了。”"},{"op":"text","speaker":"羽依里","text":"“如果你正在为此而努力的话。”"},{"op":"text","speaker":"羽依里","text":"“就让我来帮你吧。”"},{"op":"image","layer":1,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“……羽依里。”"},{"op":"image","layer":1,"image":"i13246"},{"op":"text","speaker":"白羽","text":"“谢谢你。”"},{"op":"text","speaker":"羽依里","text":"“把能做的都做好吧。”"},{"op":"image","layer":1,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“所以说，脑子是越多越好。”"},{"op":"image","layer":1,"image":"i13259"},{"op":"text","speaker":"白羽","text":"“嗯？”"},{"op":"text","speaker":"羽依里","text":"“去找大家商量吧。”"},{"op":"image","layer":1,"image":"i13334"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"image","layer":1,"image":"i13314"},{"op":"text","speaker":"白羽","text":"“商量这件事？”"},{"op":"text","speaker":"羽依里","text":"“对。”"},{"op":"image","layer":1,"image":"i13304"},{"op":"text","speaker":"白羽","text":"“要给大家说？”"},{"op":"text","speaker":"羽依里","text":"“对。”"},{"op":"image","layer":1,"image":"i13408"},{"op":"text","speaker":"白羽","text":"“不要。”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i170"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“不行。”"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]