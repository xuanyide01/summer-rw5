[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i68"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“好嘞，今天也去紬那儿吧。”"},{"op":"image","layer":0,"image":"i508"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我望向窗外。"},{"op":"text","speaker":"羽依里","text":"“今天好像也很热啊。”"},{"op":"text","speaker":"","text":"阳光非常刺眼。"},{"op":"text","speaker":"","text":"但我仍然心情愉悦。"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“早上好。”"},{"op":"image","layer":1,"image":"i11581"},{"op":"text","speaker":"镜子","text":"“早上好，羽依里。你看……有什么东西寄到了。”"},{"op":"text","speaker":"","text":"哦哦，是之前订的的丝带。"},{"op":"text","speaker":"羽依里","text":"“谢谢。”"},{"op":"image","layer":1,"image":"i11599"},{"op":"text","speaker":"镜子","text":"“还有，我有件事想在你出去玩之前拜托你。”"},{"op":"image","layer":1,"image":"i11622"},{"op":"text","speaker":"镜子","text":"“我整理遗物时，有些重物一个人搬起来有些勉强。”"},{"op":"image","layer":1,"image":"i11629"},{"op":"text","speaker":"镜子","text":"“可以的话，希望你能帮忙把它搬到墙边。”"},{"op":"text","speaker":"羽依里","text":"“行啊，是什么东西？”"},{"op":"image","layer":1,"image":"i11546"},{"op":"text","speaker":"镜子","text":"“台球桌。”"},{"op":"text","speaker":"羽依里","text":"“这……”"},{"op":"text","speaker":"羽依里","text":"“……真让人羡慕。”"},{"op":"image","layer":1,"image":"i11581"},{"op":"text","speaker":"镜子","text":"“你喜欢的话，可以带回去哦？”"},{"op":"text","speaker":"羽依里","text":"“不了，会很碍事。”"},{"op":"text","speaker":"","text":"不过，要搬台球桌的话，多我一个人也帮不上什么大忙。"},{"op":"text","speaker":"羽依里","text":"“我去找些帮手来。”"},{"op":"text","speaker":"","text":"我骑上摩托车去找帮手。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i76"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i14384"},{"op":"text","speaker":"紬","text":"“打扰了。”"},{"op":"image","layer":257,"image":"i13846"},{"op":"text","speaker":"静久","text":"“你好～”"},{"op":"text","speaker":"羽依里","text":"“哦，你们俩都来了啊……”"},{"op":"text","speaker":"羽依里","text":"“不过就多两个女孩子感觉也帮不上什么大忙……”"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"静久","text":"“不是两个哦。”"},{"op":"text","speaker":"","text":"嗯？"},{"op":"image","layer":513,"image":"i11357"},{"op":"text","speaker":"鸥","text":"“我也来了。”"},{"op":"image","layer":257,"image":"i13740"},{"op":"text","speaker":"静久","text":"“哈哈，我们是在半路上碰到的。”"},{"op":"text","speaker":"羽依里","text":"“来了个派不上用场的。”"},{"op":"image","layer":513,"image":"i11243"},{"op":"text","speaker":"鸥","text":"“嗯，我没打算帮忙哦。”"},{"op":"text","speaker":"","text":"那你来干嘛！"},{"op":"text","speaker":"羽依里","text":"“不过还是谢谢你们三个了。”"},{"op":"image","layer":1,"image":"i14508"},{"op":"text","speaker":"紬","text":"“只要是羽依里先生遇到困难，我就迫不及待想来帮忙！”"},{"op":"text","speaker":"羽依里","text":"“呃，不用这么拼。就整理东西而已。”"},{"op":"image","layer":1,"image":"i14532"},{"op":"text","speaker":"紬","text":"“不，我会竭尽全力的。”"},{"op":"image","layer":1,"image":"i14562"},{"op":"text","speaker":"紬","text":"“看我把这里夷为平地！”"},{"op":"text","speaker":"羽依里","text":"“别夷为平地啊。”"},{"op":"image","layer":257,"image":"i13810"},{"op":"text","speaker":"静久","text":"“哈哈♪干劲满满的呢。”"},{"op":"image","layer":513,"image":"i11307"},{"op":"text","speaker":"鸥","text":"“说起来，我听说你们俩开始交往了？”"},{"op":"text","speaker":"羽依里","text":"“嗯……是。”"},{"op":"image","layer":1,"image":"i14503"},{"op":"text","speaker":"紬","text":"“是，是的……”"},{"op":"image","layer":513,"image":"i11326"},{"op":"text","speaker":"鸥","text":"“咻～咻～！”"},{"op":"image","layer":257,"image":"i13797"},{"op":"text","speaker":"静久","text":"“这是学海鸥叫吧？”"},{"op":"image","layer":513,"image":"i11342"},{"op":"text","speaker":"鸥","text":"“不是，刚才只是普通的起哄。”"},{"op":"image","layer":257,"image":"i13800"},{"op":"text","speaker":"静久","text":"“……”"},{"op":"text","speaker":"","text":"她们俩虽然在奶子上是同一阵线，可却微妙地不在同一个频道。"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"text","speaker":"羽依里","text":"“就是这个。”"},{"op":"image","layer":1,"image":"i14489"},{"op":"image","layer":257,"image":"i13764"},{"op":"image","layer":513,"image":"i11333"},{"op":"text","speaker":"紬","text":"“……这是床吗？”"},{"op":"image","layer":513,"image":"i11321"},{"op":"text","speaker":"鸥","text":"“感觉能睡个痛快呢。”"},{"op":"text","speaker":"羽依里","text":"“是台球桌。”"},{"op":"image","layer":257,"image":"i13767"},{"op":"text","speaker":"静久","text":"“私宅里竟然还有这种东西。”"},{"op":"text","speaker":"羽依里","text":"“刚才我看了看，这儿还有飞镖靶和麻将桌。”"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"静久","text":"“应有尽有啊。”"},{"op":"image","layer":1,"image":"i14548"},{"op":"text","speaker":"紬","text":"“和便利店差不多呢。”"},{"op":"text","speaker":"","text":"差远了。"},{"op":"image","layer":513,"image":"i11243"},{"op":"text","speaker":"鸥","text":"“真是游乐园呢。”"},{"op":"text","speaker":"","text":"那也太冷清了。"},{"op":"image","layer":257,"image":"i13807"},{"op":"text","speaker":"静久","text":"“要靠四个人把这个抬起来？”"},{"op":"image","layer":513,"image":"i11345"},{"op":"text","speaker":"鸥","text":"“这种脑力活就交给我吧。”"},{"op":"text","speaker":"","text":"……脑中尽是不安。"},{"op":"image","layer":513,"image":"i11311"},{"op":"text","speaker":"鸥","text":"“行李箱上有轮子，所以把一个桌脚抬到行李箱上来搬就行了。”"},{"op":"text","speaker":"","text":"没想到她提出了个挺正经的点子。"},{"op":"image","layer":1,"image":"i14417"},{"op":"text","speaker":"紬","text":"“原来如此……那我们一起把桌脚抬上去吧。”"},{"op":"text","speaker":"","text":"我们一起抬着一个桌脚，压在了行李箱上。"},{"op":"image","layer":1,"image":"i11253"},{"op":"text","speaker":"鸥","text":"“在，在吱呀作响……”"},{"op":"image","layer":257,"image":"i14451"},{"op":"text","speaker":"紬","text":"“行李箱……好像要坏掉了。”"},{"op":"image","layer":1,"image":"i11256"},{"op":"text","speaker":"鸥","text":"“快，快垫些柔软的东西。”"},{"op":"image","layer":1,"image":"i11267"},{"op":"text","speaker":"鸥","text":"“……静静！”"},{"op":"image","layer":257,"image":"i13838"},{"op":"text","speaker":"静久","text":"“唉？”"},{"op":"image","layer":1,"image":"i11267"},{"op":"text","speaker":"鸥","text":"“奶子借我一用！”"},{"op":"image","layer":257,"image":"i13768"},{"op":"text","speaker":"静久","text":"“……”"},{"op":"image","layer":257,"image":"i13762"},{"op":"text","speaker":"静久","text":"“……会，会死的！”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"text","speaker":"羽依里","text":"“呼……谢谢你们。”"},{"op":"image","layer":1,"image":"i14461"},{"op":"text","speaker":"紬","text":"“哪里。这种小事轻轻松松。”"},{"op":"image","layer":257,"image":"i13775"},{"op":"text","speaker":"静久","text":"“还有其他活吗？”"},{"op":"text","speaker":"羽依里","text":"“暂时应该没了吧。”"},{"op":"text","speaker":"","text":"要是整理太多，可能还会让镜子阿姨失望。"},{"op":"image","layer":1,"image":"i11240"},{"op":"text","speaker":"鸥","text":"“那我回去咯。”"},{"op":"image","layer":257,"image":"i14473"},{"op":"text","speaker":"紬","text":"“啊……请留步。”"},{"op":"image","layer":1,"image":"i11333"},{"op":"text","speaker":"鸥","text":"“……？”"},{"op":"image","layer":257,"image":"i14506"},{"op":"text","speaker":"紬","text":"“你听过……这首歌吗？”"},{"op":"image","layer":257,"image":"i14510"},{"op":"text","speaker":"紬","text":"“～～～♪”"},{"op":"image","layer":1,"image":"i11327"},{"op":"text","speaker":"鸥","text":"“这是外国的民谣吧？”"},{"op":"image","layer":257,"image":"i14489"},{"op":"text","speaker":"紬","text":"“姆啾!؟”"},{"op":"image","layer":513,"image":"i13761"},{"op":"text","speaker":"静久","text":"“你知道？”"},{"op":"image","layer":1,"image":"i11279"},{"op":"text","speaker":"鸥","text":"“也就是听过而已吧……因为我妈妈经常出国。”"},{"op":"text","speaker":"羽依里","text":"“歌名呢!؟”"},{"op":"image","layer":1,"image":"i11259"},{"op":"text","speaker":"鸥","text":"“不记得了。”"},{"op":"image","layer":513,"image":"i13807"},{"op":"text","speaker":"静久","text":"“这下知道了这不是紬自编的曲子呢。”"},{"op":"image","layer":257,"image":"i14492"},{"op":"text","speaker":"紬","text":"“是啊。”"},{"op":"image","layer":1,"image":"i11286"},{"op":"text","speaker":"鸥","text":"“那我下次再来。”"},{"op":"text","speaker":"羽依里","text":"“嗯，多谢了。”"},{"op":"image","layer":1,"image":"i13737"},{"op":"text","speaker":"静久","text":"“我去通知一下镜子阿姨。”"},{"op":"text","speaker":"","text":"鸥和静久离开了仓库。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i14377"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"text","speaker":"","text":"我和紬独处了。"},{"op":"text","speaker":"","text":"说不定是她刻意为我们创造的这个空间。"},{"op":"image","layer":1,"image":"i14384"},{"op":"text","speaker":"紬","text":"“羽依里先生。”"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"image","layer":1,"image":"i14445"},{"op":"text","speaker":"紬","text":"“我帮上忙了吗？”"},{"op":"text","speaker":"羽依里","text":"“嗯，当然了。谢谢你。”"},{"op":"image","layer":1,"image":"i14461"},{"op":"text","speaker":"紬","text":"“嘿嘿……好开心。”"},{"op":"image","layer":1,"image":"i14470"},{"op":"text","speaker":"紬","text":"“～～～♪”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"在安静的仓库里，我听着紬哼曲子。"},{"op":"text","speaker":"","text":"仿佛都要忘记了时间。"},{"op":"image","layer":1,"image":"i14423"},{"op":"text","speaker":"紬","text":"“～～～……♪”"},{"op":"image","layer":1,"image":"i14401"},{"op":"text","speaker":"紬","text":"“啊……”"},{"op":"text","speaker":"羽依里","text":"“嗯？有什么在意的东西吗？”"},{"op":"image","layer":1,"image":"i14506"},{"op":"text","speaker":"紬","text":"“我发现了朋友。”"},{"op":"text","speaker":"","text":"视线前方，有一只积了灰的小恐龙。"},{"op":"text","speaker":"羽依里","text":"“原来如此，是说那些布偶吗。”"},{"op":"image","layer":1,"image":"i14470"},{"op":"text","speaker":"紬","text":"“是的。灯塔里也有很多朋友。”"},{"op":"text","speaker":"羽依里","text":"“喜欢的话就带回去吧？”"},{"op":"image","layer":1,"image":"i14417"},{"op":"text","speaker":"紬","text":"“不行，它是这家的孩子，我不能把它带回去。”"},{"op":"text","speaker":"羽依里","text":"“是吗。”"},{"op":"image","layer":1,"image":"i14381"},{"op":"text","speaker":"紬","text":"“是的。不然它和它的主人都太可怜了。”"},{"op":"text","speaker":"","text":"……好想告诉别人。"},{"op":"text","speaker":"","text":"我的女朋友是个非常善良的女孩。"},{"op":"image","layer":1,"image":"i14520"},{"op":"text","speaker":"紬","text":"“这里好像还有很多其他有意思的东西呀。”"},{"op":"text","speaker":"羽依里","text":"“在静久回来前，我们找找吧。”"},{"op":"image","layer":1,"image":"i14518"},{"op":"text","speaker":"紬","text":"“好的。”"},{"op":"text","speaker":"紬","text":"“～～～♪”"},{"op":"text","speaker":"","text":"紬正在把布偶身上的灰尘掸干净。"},{"op":"text","speaker":"","text":"她好像挺开心的，我还是不打扰她了吧。"},{"op":"text","speaker":"羽依里","text":"“……哦。”"},{"op":"text","speaker":"","text":"发现了一叠旧照片。"},{"op":"text","speaker":"","text":"我翻开其中一张。"},{"op":"text","speaker":"羽依里","text":"“黑白的。”"},{"op":"text","speaker":"","text":"有种年代感。"},{"op":"text","speaker":"","text":"照片上的服装和发型，也非常老式。"},{"op":"text","speaker":"羽依里","text":"“……这是。”"},{"op":"text","speaker":"","text":"一个长相和良一相似的男性，光着膀子出现在照片里。"},{"op":"text","speaker":"","text":"大概是他爷爷之类的吧。"},{"op":"text","speaker":"羽依里","text":"“他的裸体习惯是代代相传的吗。”"},{"op":"text","speaker":"","text":"我仔细翻阅，一些照片里的人和岛上的人面容有些相似，还挺好玩的。"},{"op":"text","speaker":"","text":"这其中――"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"羽依里","text":"“――唉？”"},{"op":"text","speaker":"","text":"我浑身一凉。"},{"op":"image","layer":0,"image":"i1333"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"也许我期待的，就是这样的照片……"},{"op":"text","speaker":"","text":"可话说回来，这也太……"},{"op":"image","layer":0,"image":"i1332"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"这……根本就是紬啊。"},{"op":"text","speaker":"","text":"发型不一样。"},{"op":"text","speaker":"","text":"年龄估计也比现在更小。"},{"op":"text","speaker":"","text":"虽然有这些区别，但肯定没错。"},{"op":"text","speaker":"","text":"这已经不是有血缘关系的程度了。"},{"op":"text","speaker":"","text":"尽管我知道这逻辑上说不通，但我还是不禁觉得――"},{"op":"text","speaker":"","text":"这……就是紬。"},{"op":"text","speaker":"","text":"我再次感受到了一股寒意。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"静久","text":"“唉呀，乳依里在看什么呢？”"},{"op":"image","layer":0,"image":"i76"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13821"},{"op":"text","speaker":"羽依里","text":"“――!؟”"},{"op":"text","speaker":"","text":"我隐约觉得不能让别人看到这个，于是把照片藏在身后。"},{"op":"image","layer":1,"image":"i13838"},{"op":"text","speaker":"静久","text":"“怎，怎么了……为什么这么慌张？”"},{"op":"text","speaker":"羽依里","text":"“不，不是……没什么。”"},{"op":"image","layer":257,"image":"i14466"},{"op":"text","speaker":"紬","text":"“……？”"},{"op":"text","speaker":"","text":"怎么回事？"},{"op":"text","speaker":"","text":"到底是怎么回事？"},{"op":"text","speaker":"","text":"几十年前……"},{"op":"text","speaker":"","text":"甚至有可能是一百多年前的照片里，为什么紬会……？"},{"op":"image","layer":1,"image":"i14417"},{"op":"text","speaker":"紬","text":"“你发现什么了吗？”"},{"op":"text","speaker":"羽依里","text":"“没，没什么……”"},{"op":"image","layer":1,"image":"i14522"},{"op":"text","speaker":"紬","text":"“好可疑。”"},{"op":"image","layer":1,"image":"i14518"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"静久","text":"“真可疑。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"正值盛夏，我却渗出了冷汗。"},{"op":"text","speaker":"","text":"这张照片……如果被紬看到……"},{"op":"text","speaker":"","text":"……不能给她看。"},{"op":"image","layer":1,"image":"i14386"},{"op":"text","speaker":"紬","text":"“背后好像藏着什么。”"},{"op":"image","layer":257,"image":"i13816"},{"op":"text","speaker":"静久","text":"“是啊。在藏着什么。”"},{"op":"text","speaker":"羽依里","text":"“没……我可没藏什么……”"},{"op":"image","layer":1,"image":"i14532"},{"op":"text","speaker":"紬","text":"“骗人。我听得出来。”"},{"op":"image","layer":257,"image":"i13810"},{"op":"text","speaker":"静久","text":"“唉呀，这就是爱的力量♪”"},{"op":"image","layer":1,"image":"i14501"},{"op":"text","speaker":"紬","text":"“姆啾……”"},{"op":"image","layer":257,"image":"i13758"},{"op":"text","speaker":"静久","text":"“真是的，羽依里也别这么卖关子啦，还是拿出来吧？”"},{"op":"text","speaker":"羽依里","text":"“呃……可是……”"},{"op":"text","speaker":"","text":"要是给她看了……"},{"op":"text","speaker":"","text":"会发生无可挽回的事态。"},{"op":"text","speaker":"","text":"我有这种预感。"},{"op":"image","layer":257,"image":"i13743"},{"op":"text","speaker":"静久","text":"“来，交给她吧。”"},{"op":"image","layer":257,"image":"i13770"},{"op":"text","speaker":"静久","text":"“恋人纪念礼♪”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"image","layer":1,"image":"i14377"},{"op":"text","speaker":"紬","text":"“姆啾？”"},{"op":"text","speaker":"羽依里","text":"“礼……物？”"},{"op":"image","layer":257,"image":"i13764"},{"op":"text","speaker":"静久","text":"“不是吗？”"},{"op":"text","speaker":"羽依里","text":"“啊……呃……”"},{"op":"text","speaker":"","text":"我把照片塞进口袋，掏出丝带。"},{"op":"text","speaker":"","text":"对了。"},{"op":"text","speaker":"","text":"今天是计划把这个交给紬的。"},{"op":"image","layer":1,"image":"i14401"},{"op":"image","layer":257,"image":"i13816"},{"op":"text","speaker":"紬","text":"“唉？唉？唉？”"},{"op":"image","layer":1,"image":"i14396"},{"op":"text","speaker":"紬","text":"“这，这是什么呀？”"},{"op":"image","layer":257,"image":"i13846"},{"op":"text","speaker":"静久","text":"“乳依里给你的礼物哦。”"},{"op":"text","speaker":"羽依里","text":"“没……没错。”"},{"op":"text","speaker":"","text":"我镇定下来，面向紬。"},{"op":"image","layer":0,"image":"i264"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":1,"image":"i14397"},{"op":"text","speaker":"羽依里","text":"“紬，那个……为了纪念我们交往，我想把这个……”"},{"op":"image","layer":1,"image":"i14402"},{"op":"text","speaker":"紬","text":"“姆啾!؟”"},{"op":"image","layer":1,"image":"i14498"},{"op":"text","speaker":"紬","text":"“唉？那个……礼物什么的……太贵重了啦。”"},{"op":"image","layer":1,"image":"i14502"},{"op":"text","speaker":"紬","text":"“我，我什么都没准备……真的可以收下吗？”"},{"op":"text","speaker":"羽依里","text":"“当然可以。这是我想着紬，和静久一起精心挑选的。”"},{"op":"image","layer":1,"image":"i14415"},{"op":"text","speaker":"紬","text":"“和静久一起送给我……的吗？”"},{"op":"text","speaker":"羽依里","text":"“你能收下我会很开心的。”"},{"op":"image","layer":1,"image":"i14411"},{"op":"text","speaker":"紬","text":"“呃……那个……”"},{"op":"image","layer":1,"image":"i14413"},{"op":"text","speaker":"紬","text":"“我很开心。”"},{"op":"text","speaker":"羽依里","text":"“你能这么说，我也很开心。”"},{"op":"image","layer":1,"image":"i14504"},{"op":"text","speaker":"紬","text":"“那个……羽依里先生。”"},{"op":"image","layer":1,"image":"i14502"},{"op":"text","speaker":"紬","text":"“最，最喜欢你了。”"},{"op":"text","speaker":"羽依里","text":"“――！”"},{"op":"image","layer":0,"image":"i76"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i14501"},{"op":"text","speaker":"紬","text":"“姆啾～――！”"},{"op":"image","layer":1,"image":"i14502"},{"op":"image","layer":257,"image":"i13838"},{"op":"text","speaker":"静久","text":"“哎!؟”"},{"op":"image","layer":257,"image":"i13844"},{"op":"text","speaker":"静久","text":"“不，不要抱我，去抱抱乳依里吧？”"},{"op":"image","layer":1,"image":"i14504"},{"op":"text","speaker":"紬","text":"“太难为情了，办不到！”"},{"op":"text","speaker":"","text":"要是被她抱住了，我也会害羞得要死的。"},{"op":"image","layer":1,"image":"i14412"},{"op":"text","speaker":"紬","text":"“那个……羽依里先生，静久……我可以打开吗？”"},{"op":"text","speaker":"羽依里","text":"“当然了。”"},{"op":"image","layer":7,"image":"i13819"},{"op":"text","speaker":"静久","text":"“请吧。”"},{"op":"image","layer":1,"image":"i14396"},{"op":"text","speaker":"紬","text":"“这个……看上去是丝带……”"},{"op":"image","layer":1,"image":"i14417"},{"op":"text","speaker":"紬","text":"“不过，既然是和静久一起选的，那肯定是当成文胸来用的吧。”"},{"op":"text","speaker":"羽依里","text":"“你等下……紬？”"},{"op":"image","layer":1,"image":"i14477"},{"op":"text","speaker":"紬","text":"“这面积真是小……”"},{"op":"image","layer":1,"image":"i14494"},{"op":"text","speaker":"紬","text":"“既然成为了恋人，就必须面对这样的挑战吧。”"},{"op":"image","layer":1,"image":"i14526"},{"op":"text","speaker":"紬","text":"“我明白了。”"},{"op":"image","layer":1,"image":"i14530"},{"op":"text","speaker":"紬","text":"“可是这个要怎么戴……”"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"静久","text":"“交给我来吧？”"},{"op":"image","layer":1,"image":"i14396"},{"op":"text","speaker":"紬","text":"“姆啾!؟在，在羽依里先生面前换衣服……”"},{"op":"image","layer":1,"image":"i14404"},{"op":"text","speaker":"紬","text":"“会犯法的！”"},{"op":"image","layer":257,"image":"i13849"},{"op":"text","speaker":"静久","text":"“来，转个身。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"image","layer":1,"image":"i13779"},{"op":"text","speaker":"静久","text":"“嗯，不错嘛。”"},{"op":"image","layer":0,"image":"i264"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i14846"},{"op":"image","layer":1539,"image":"i14847"},{"op":"clear","layer":1},{"op":"clear","layer":1},{"op":"text","speaker":"紬","text":"“啊……”"},{"op":"text","speaker":"","text":"丝带系在了它该在的地方。"},{"op":"clear","layer":1539},{"op":"image","layer":0,"image":"i76"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i14844"},{"op":"image","layer":1,"image":"i14939"},{"op":"text","speaker":"紬","text":"“哦，哦―……”"},{"op":"image","layer":1,"image":"i14953"},{"op":"text","speaker":"紬","text":"“怎，怎么样？”"},{"op":"text","speaker":"羽依里","text":"“啊，嗯……”"},{"op":"text","speaker":"羽依里","text":"“非常……适合你。”"},{"op":"image","layer":1,"image":"i14951"},{"op":"text","speaker":"紬","text":"“是，是吗……”"},{"op":"image","layer":1,"image":"i14953"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"image","layer":1,"image":"i14879"},{"op":"text","speaker":"紬","text":"“那，那个……”"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"image","layer":1,"image":"i14874"},{"op":"text","speaker":"紬","text":"“有镜子吗？”"},{"op":"text","speaker":"羽依里","text":"“嗯～，这里应该有吧？”"},{"op":"image","layer":1,"image":"i14860"},{"op":"text","speaker":"紬","text":"“来挖掘吧～！”"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"静久","text":"“要是挖得太入迷，丝带会脏哦？”"},{"op":"image","layer":1,"image":"i14939"},{"op":"text","speaker":"紬","text":"“大意了！”"},{"op":"image","layer":1,"image":"i14980"},{"op":"text","speaker":"紬","text":"“那，那该怎么办。”"},{"op":"text","speaker":"羽依里","text":"“去屋里的盥洗台或者回灯塔吧？”"},{"op":"text","speaker":"","text":"想搬的东西也搬走了，镜子阿姨应该也会允许我出门了。"},{"op":"image","layer":1,"image":"i15006"},{"op":"text","speaker":"紬","text":"“那我们回灯塔吧～”"},{"op":"image","layer":257,"image":"i13740"},{"op":"text","speaker":"静久","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“好，那我去和镜子阿姨说一声。”"},{"op":"text","speaker":"羽依里","text":"“告诉她我先回灯塔了。”"},{"op":"image","layer":1,"image":"i14849"},{"op":"text","speaker":"紬","text":"“好！”"},{"op":"image","layer":1,"image":"i14852"},{"op":"text","speaker":"紬","text":"“那个……羽依里先生，静久……这条丝带，我会永远细心保管的！”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"image","layer":257,"image":"i13743"},{"op":"text","speaker":"静久","text":"“嗯。”"},{"op":"image","layer":1,"image":"i14927"},{"op":"text","speaker":"紬","text":"“那我们待会儿再见。”"},{"op":"text","speaker":"羽依里","text":"“嗯，一会儿见。”"},{"op":"image","layer":1,"image":"i14924"},{"op":"text","speaker":"紬","text":"“～～～♪”"},{"op":"text","speaker":"","text":"紬哼着比平时都要响亮的小曲，和静久向灯塔走去。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"她这么开心，真是太好了。"},{"op":"text","speaker":"","text":"这就是幸福的感觉。"},{"op":"text","speaker":"","text":"可是……"},{"op":"text","speaker":"羽依里","text":"“那到底是什么啊……”"},{"op":"text","speaker":"","text":"我的心中，仍残留着难以名状的不安。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]