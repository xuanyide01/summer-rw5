[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i69"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"早上醒得比平时还要早。"},{"op":"text","speaker":"","text":"……？"},{"op":"text","speaker":"","text":"房间外响起了脚步声。"},{"op":"text","speaker":"","text":"有谁在客厅跑动。"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":7,"image":"i15898"},{"op":"text","speaker":"羽未","text":"“呜哇――――要迟到啦。”"},{"op":"text","speaker":"","text":"是羽未。"},{"op":"text","speaker":"","text":"慌张地跑来跑去。"},{"op":"text","speaker":"羽依里","text":"“一大早就这么热闹啊。”"},{"op":"image","layer":1,"image":"i15779"},{"op":"text","speaker":"羽未","text":"“今天开始那个了。那个――要迟到了要迟到了。”"},{"op":"if","truth":false,"target":22,"value":["==",["v",24003],0]},{"op":"image","layer":1,"image":"i15948"},{"op":"goto","target":22},{"op":"if","truth":false,"target":25,"value":["==",["v",24003],0]},{"op":"image","layer":1,"image":"i15783"},{"op":"goto","target":25},{"op":"if","truth":false,"target":28,"value":["==",["v",24003],0]},{"op":"image","layer":1,"image":"i15941"},{"op":"goto","target":28},{"op":"text","speaker":"羽依里","text":"“哪个？”"},{"op":"image","layer":1,"image":"i15820"},{"op":"text","speaker":"羽未","text":"“广播体操！”"},{"op":"text","speaker":"羽依里","text":"“是吗。”"},{"op":"text","speaker":"","text":"不管在哪都有人搞啊，那个。"},{"op":"image","layer":1,"image":"i15808"},{"op":"text","speaker":"羽未","text":"“羽依里哥不去吗？”"},{"op":"text","speaker":"羽依里","text":"“我不去。”"},{"op":"image","layer":1,"image":"i15811"},{"op":"text","speaker":"羽未","text":"“要是拿到全勤奖的话，会有很棒的奖品哦？”"},{"op":"text","speaker":"羽依里","text":"“很棒的奖品？”"},{"op":"text","speaker":"羽依里","text":"“无非是温泉精华，或是小熊挂件之类的东西吧。”"},{"op":"image","layer":1,"image":"i15767"},{"op":"text","speaker":"羽未","text":"“啊，很接近了。”"},{"op":"text","speaker":"羽依里","text":"“接近？”"},{"op":"image","layer":1,"image":"i15763"},{"op":"text","speaker":"羽未","text":"“是集两者大成的东西哦。”"},{"op":"text","speaker":"羽依里","text":"“集两者……”"},{"op":"text","speaker":"","text":"我想了想。"},{"op":"text","speaker":"羽依里","text":"“熊精华？”"},{"op":"image","layer":1,"image":"i15779"},{"op":"text","speaker":"羽未","text":"“那是什么。”"},{"op":"text","speaker":"羽依里","text":"“温泉挂件……”"},{"op":"image","layer":1,"image":"i15803"},{"op":"text","speaker":"羽未","text":"“那个我也想象不出。”"},{"op":"text","speaker":"羽依里","text":"“那是什么啊？”"},{"op":"image","layer":1,"image":"i15763"},{"op":"text","speaker":"羽未","text":"“是‘因为有熊出没所以没人敢泡的秘泉精华’。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"稍微有点兴趣。"},{"op":"image","layer":1,"image":"i15811"},{"op":"text","speaker":"羽未","text":"“对了，我做了早饭。”"},{"op":"text","speaker":"羽依里","text":"“谢谢。”"},{"op":"image","layer":1,"image":"i15885"},{"op":"text","speaker":"羽未","text":"“吃完记得餐具用水泡着。”"},{"op":"text","speaker":"","text":"走掉了。"},{"op":"text","speaker":"","text":"如同羽未所说的，餐桌上已经准备好了炒饭。"},{"op":"text","speaker":"","text":"而且还封好了保鲜膜。"},{"op":"text","speaker":"","text":"真是懂事的孩子。"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"独自一人吃着。"},{"op":"text","speaker":"羽依里","text":"“……好酸……”"},{"op":"text","speaker":"","text":"是酸口的啊。"},{"op":"text","speaker":"","text":"太阳和蝉鸣都从一大早就火力全开的样子。"},{"op":"text","speaker":"","text":"看来今天也会很热。"},{"op":"return"},{"op":"image","layer":1,"image":"i15895"},{"op":"text","speaker":"羽未","text":"“怎么了？”"},{"op":"text","speaker":"羽依里","text":"“噢。”"},{"op":"text","speaker":"羽依里","text":"“回来啦。”"},{"op":"image","layer":1,"image":"i15812"},{"op":"text","speaker":"羽未","text":"“我回来了。”"},{"op":"text","speaker":"","text":"似乎是做完广播体操回来了。"},{"op":"image","layer":1,"image":"i15809"},{"op":"text","speaker":"羽未","text":"“你刚才在说话吧？”"},{"op":"image","layer":1,"image":"i15798"},{"op":"text","speaker":"羽未","text":"“……和摩托车。”"},{"op":"text","speaker":"","text":"被听到了啊……"},{"op":"image","layer":1,"image":"i15809"},{"op":"text","speaker":"羽未","text":"“你能和摩托车对话吗？”"},{"op":"text","speaker":"羽依里","text":"“不、不是啦。”"},{"op":"text","speaker":"","text":"虽然没错。"},{"op":"text","speaker":"羽依里","text":"“是跟站在摩托车前面的那个人。”"},{"op":"image","layer":1,"image":"i15794"},{"op":"text","speaker":"羽未","text":"“……唉。”"},{"op":"image","layer":1,"image":"i15780"},{"op":"text","speaker":"羽未","text":"“不是没人吗……？”"},{"op":"image","layer":1,"image":"i15824"},{"op":"text","speaker":"羽未","text":"“不要说这种奇怪的话啊。”"},{"op":"image","layer":1,"image":"i15915"},{"op":"text","speaker":"","text":"引擎突然发动了起来。"},{"op":"text","speaker":"羽未","text":"“咿呀！为什么会突然响起来؟؟”"},{"op":"text","speaker":"","text":"然后立刻又熄火了。"},{"op":"image","layer":1,"image":"i15977"},{"op":"text","speaker":"羽未","text":"“有谁在吗……？”"},{"op":"text","speaker":"羽依里","text":"“没有的，放心吧。”"},{"op":"image","layer":1,"image":"i15986"},{"op":"text","speaker":"羽未","text":"“看来是呢……”"},{"op":"text","speaker":"","text":"她一脸不安地看着，然后小跑着回到了屋内。"},{"op":"text","speaker":"","text":"真不知道她平时都在干什么。"},{"op":"text","speaker":"","text":"好吧，我也搞不清楚自己平时在干什么就是了。"},{"op":"return"},{"op":"image","layer":0,"image":"i29"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"羽依里","text":"“呼哧……呼哧……”"},{"op":"text","speaker":"","text":"累死个人了。"},{"op":"text","speaker":"","text":"我呆站在玄关前。"},{"op":"text","speaker":"","text":"光着身子进去也挺奇怪的。"},{"op":"text","speaker":"","text":"手上拿着因湿透而变重的衣服。"},{"op":"text","speaker":"","text":"怎么办？"},{"op":"choice","variable":6001,"items":[{"text":"不穿直接进门","value":0,"condition":1},{"text":"穿上再进门","value":1,"condition":1}]},{"op":"if","truth":false,"target":160,"value":["==",["v",6001],0]},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i62"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15472"},{"op":"text","speaker":"羽未","text":"“欢迎回来。”"},{"op":"text","speaker":"羽依里","text":"“我回来了。”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“饭已经做好了哦。”"},{"op":"text","speaker":"羽依里","text":"“嗯。肚子饿啦～”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“先去把手洗了。”"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"羽依里","text":"“这个好好吃啊。”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“是吗？”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“羽依里哥。乳头上粘米饭了。”"},{"op":"text","speaker":"羽依里","text":"“啊，抱歉。”"},{"op":"image","layer":1,"image":"i15338"},{"op":"text","speaker":"羽未","text":"“吃相真差。”"},{"op":"image","layer":1,"image":"i15332"},{"op":"text","speaker":"羽未","text":"“不对，你都让我说了什么啊؟!恶心!!”"},{"op":"image","layer":1,"image":"i15563"},{"op":"text","speaker":"羽未","text":"“害我非常自然地向乳头伸出手，想拿掉上面的米饭！”"},{"op":"text","speaker":"羽依里","text":"“呀～”"},{"op":"image","layer":1,"image":"i15542"},{"op":"text","speaker":"羽未","text":"“不许发怪声！”"},{"op":"image","layer":1,"image":"i15389"},{"op":"text","speaker":"羽未","text":"“话说为什么光着身子啊!؟变态!؟”"},{"op":"text","speaker":"羽依里","text":"“发现得太晚了吧。”"},{"op":"image","layer":1,"image":"i15394"},{"op":"text","speaker":"羽未","text":"“因为没有任何的不协调竟然疏忽了！”"},{"op":"text","speaker":"羽依里","text":"“呃，我不小心掉到了海里。”"},{"op":"image","layer":1,"image":"i15387"},{"op":"text","speaker":"羽未","text":"“要怎么不小心才会掉海里啊……”"},{"op":"goto","target":183},{"op":"if","truth":false,"target":183,"value":["==",["v",6001],1]},{"op":"image","layer":0,"image":"i62"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15472"},{"op":"text","speaker":"羽未","text":"“欢迎回来”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“哇，全身湿透！怎么了？”"},{"op":"text","speaker":"羽依里","text":"“因为下雨了。”"},{"op":"image","layer":1,"image":"i15504"},{"op":"text","speaker":"羽未","text":"“啊!؟得赶紧去收衣物。”"},{"op":"text","speaker":"","text":"……"},{"op":"image","layer":1,"image":"i15389"},{"op":"text","speaker":"羽未","text":"“外面晴空万里啊！为什么要说谎话！”"},{"op":"text","speaker":"羽依里","text":"“我怕我莫名其妙地全身湿透会让你担心。”"},{"op":"image","layer":1,"image":"i15406"},{"op":"text","speaker":"羽未","text":"“担心？才不会呢……？”"},{"op":"text","speaker":"羽依里","text":"“你倒是担心一下啊……”"},{"op":"image","layer":1,"image":"i15387"},{"op":"text","speaker":"羽未","text":"“唉。所以是怎么回事？掉海里去了吗。”"},{"op":"text","speaker":"羽依里","text":"“对。”"},{"op":"image","layer":1,"image":"i15378"},{"op":"text","speaker":"羽未","text":"“还真掉下去了啊！你做了什么؟!”"},{"op":"goto","target":183},{"op":"text","speaker":"羽依里","text":"“天知道。”"},{"op":"text","speaker":"羽依里","text":"“骑着行李箱就掉下去了。”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“……听不懂你在说什么……”"},{"op":"text","speaker":"羽依里","text":"“我想也是。”"},{"op":"text","speaker":"","text":"连我自己都搞不懂。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i516"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"电视上正在直播棒球比赛。"},{"op":"image","layer":1,"image":"i11578"},{"op":"text","speaker":"","text":"镜子阿姨她心不在焉地看着。"},{"op":"text","speaker":"羽依里","text":"“支持哪边的队呀？”"},{"op":"image","layer":1,"image":"i11581"},{"op":"text","speaker":"镜子","text":"“红色落后的那一队。”"},{"op":"text","speaker":"羽依里","text":"“我也有同感。”"},{"op":"text","speaker":"广播播报员","text":"‘至今一直以压倒性强势独控锦旗的赤红机器，想不到走到这里居然会被垫底的海洋之星拉入苦战。’"},{"op":"image","layer":1,"image":"i11578"},{"op":"text","speaker":"","text":"听到解说员的话后，镜子阿姨点了点头。"},{"op":"image","layer":1,"image":"i11546"},{"op":"text","speaker":"镜子","text":"“还是支持蓝色那边吧。”"},{"op":"text","speaker":"羽依里","text":"“同感。”"},{"op":"image","layer":257,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“啊，羽依里哥，洗澡水烧好了你先去洗吧。”"},{"op":"text","speaker":"羽依里","text":"“可以吗？”"},{"op":"image","layer":257,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“不是掉海里去了吗？身上不觉得黏糊糊的吗。”"},{"op":"text","speaker":"羽依里","text":"“这么一说的确是。”"},{"op":"image","layer":257,"image":"i15406"},{"op":"text","speaker":"羽未","text":"“那么，快去吧。”"},{"op":"text","speaker":"羽依里","text":"“谢谢。”"},{"op":"image","layer":257,"image":"i15496"},{"op":"text","speaker":"羽未","text":"“记得洗完后要把水放了冲洗干净，再重新烧点水哦。”"},{"op":"text","speaker":"羽依里","text":"“哎呀，温柔之后的扎心……”"},{"op":"return"},{"op":"end"}]