[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i15"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11731"},{"op":"text","speaker":"美希","text":"“昨夜，公所召开了紧急会议。”"},{"op":"image","layer":1,"image":"i11701"},{"op":"text","speaker":"美希","text":"“议题是能否在1周后开办的夏鸟之仪上，让鸣濑白羽和鹰原羽依里的蝶番之契插进流程中。”"},{"op":"text","speaker":"羽依里","text":"“蝶番之契？”"},{"op":"image","layer":1,"image":"i11689"},{"op":"text","speaker":"美希","text":"“也就是结为夫妻。”"},{"op":"text","speaker":"羽依里","text":"“蝶番，是装在门上那东西吧？”"},{"op":"image","layer":1,"image":"i11709"},{"op":"text","speaker":"美希","text":"“原本就是因为它看起来像是两只蝴蝶在交配，才叫蝶番的。”"},{"op":"text","speaker":"羽依里","text":"“是这样的吗؟؟”"},{"op":"image","layer":1,"image":"i11699"},{"op":"text","speaker":"美希","text":"“这是常识。”"},{"op":"image","layer":7,"image":"i12173"},{"op":"text","speaker":"良一","text":"“我就不知道。”"},{"op":"image","layer":7,"image":"i10145"},{"op":"text","speaker":"苍","text":"“我也不知道。”"},{"op":"image","layer":1,"image":"i11712"},{"op":"text","speaker":"美希","text":"“……”"},{"op":"image","layer":1,"image":"i11750"},{"op":"text","speaker":"美希","text":"“先说结论，议案通过了。”"},{"op":"image","layer":1,"image":"i11758"},{"op":"text","speaker":"美希","text":"“只是由于这次更改离期限太近，闹起了不小的争议。”"},{"op":"text","speaker":"羽依里","text":"“有争议还能通过啊。”"},{"op":"image","layer":1,"image":"i11771"},{"op":"text","speaker":"美希","text":"“据说最后是鸣濑翁一锤定音的。”"},{"op":"image","layer":1,"image":"i11731"},{"op":"text","speaker":"美希","text":"“我觉得公所方面的意思是，要能协调好的话，插进去会比较有意思。”"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“并不尽是坏事。”"},{"op":"image","layer":1,"image":"i11696"},{"op":"text","speaker":"美希","text":"“他们似乎也想借此机会，讨论能否打造一个结缘活动招揽观光客。”"},{"op":"image","layer":1,"image":"i11715"},{"op":"text","speaker":"美希","text":"“而且。”"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“既然是白羽本人发话说想这么做的，那岛上的大人们也只能接受了。”"},{"op":"text","speaker":"羽依里","text":"“白羽她有这么大的权利？”"},{"op":"image","layer":7,"image":"i15007"},{"op":"text","speaker":"天善","text":"“毕竟越是上年纪的人，就越尊崇她。”"},{"op":"text","speaker":"羽依里","text":"“那白羽她现在在哪呢？”"},{"op":"image","layer":1,"image":"i11777"},{"op":"text","speaker":"美希","text":"“有很多事情需要准备。”"},{"op":"image","layer":1,"image":"i11750"},{"op":"text","speaker":"美希","text":"“她今天大概得一大早就去公所那边吧。”"},{"op":"text","speaker":"羽依里","text":"“这样啊。”"},{"op":"text","speaker":"羽依里","text":"“那么，那个什么蝶番之契。”"},{"op":"text","speaker":"羽依里","text":"“具体说，是要做什么？”"},{"op":"image","layer":257,"image":"i15038"},{"op":"text","speaker":"天善","text":"“就是在夏鸟之仪当天，到山上的神堂里交换誓言吧。”"},{"op":"text","speaker":"羽依里","text":"“是跟婚礼上的那种差不多吗？”"},{"op":"image","layer":257,"image":"i15008"},{"op":"text","speaker":"天善","text":"“因为不能参观，所以我们也不知道详情。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"if","truth":false,"target":64,"value":["==",["v",6003],1]},{"op":"callScene","scene":85,"target":2},{"op":"goto","target":125},{"op":"if","truth":false,"target":67,"value":["==",["v",6003],2]},{"op":"callScene","scene":84,"target":2},{"op":"goto","target":125},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11549"},{"op":"text","speaker":"镜子","text":"“真有你的啊，羽依里。”"},{"op":"text","speaker":"羽依里","text":"“是说昨天那事吗？”"},{"op":"text","speaker":"","text":"我跟小鸠老爷子的大战，似乎转眼就传得家喻户晓了。"},{"op":"text","speaker":"羽依里","text":"“呃，还好吧。”"},{"op":"text","speaker":"","text":"可能在听说后也吓了镜子阿姨一跳吧。"},{"op":"text","speaker":"羽依里","text":"“我藏着的一面，似乎是暴露出来了。”"},{"op":"image","layer":257,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“你干了什么啊？”"},{"op":"image","layer":1,"image":"i11566"},{"op":"text","speaker":"镜子","text":"“你还不知道吗؟؟”"},{"op":"image","layer":1,"image":"i11546"},{"op":"text","speaker":"镜子","text":"“羽依里干掉了一个老爷爷。”"},{"op":"image","layer":257,"image":"i15585"},{"op":"text","speaker":"羽未","text":"“唉唉……离我远点。”"},{"op":"text","speaker":"羽依里","text":"“请不要说得这么精简。”"},{"op":"image","layer":1,"image":"i11581"},{"op":"text","speaker":"镜子","text":"“然后，他因为这件事。”"},{"op":"image","layer":1,"image":"i11575"},{"op":"text","speaker":"镜子","text":"“要准备结婚了。”"},{"op":"image","layer":257,"image":"i15533"},{"op":"text","speaker":"羽未","text":"“跟老爷爷吗？”"},{"op":"text","speaker":"羽依里","text":"“怎么想的!؟”"},{"op":"text","speaker":"羽依里","text":"“镜子阿姨，你的说明也太笼统了。”"},{"op":"image","layer":1,"image":"i11638"},{"op":"text","speaker":"镜子","text":"“有吗？”"},{"op":"image","layer":1,"image":"i11635"},{"op":"text","speaker":"镜子","text":"“是跟老爷爷的外孙女。”"},{"op":"image","layer":257,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“哦，是这么回事啊。”"},{"op":"text","speaker":"羽依里","text":"“原来大家都知道了啊。”"},{"op":"image","layer":1,"image":"i11546"},{"op":"text","speaker":"镜子","text":"“大家都知道了。”"},{"op":"image","layer":257,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“结婚……”"},{"op":"text","speaker":"羽依里","text":"“假装而已。”"},{"op":"text","speaker":"","text":"……我给羽未大致说明了事情经过。"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“原来出了这种事啊。”"},{"op":"image","layer":1,"image":"i15412"},{"op":"text","speaker":"羽未","text":"“恭喜你。”"},{"op":"text","speaker":"羽依里","text":"“也不用说得这么隆重啊。”"},{"op":"image","layer":1,"image":"i15472"},{"op":"text","speaker":"羽未","text":"“真让人感慨。”"},{"op":"image","layer":1,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“想不到鹰原哥竟然要结婚了。”"},{"op":"text","speaker":"羽依里","text":"“都说了不是真结婚。”"},{"op":"image","layer":1,"image":"i15499"},{"op":"text","speaker":"羽未","text":"“没准就会变成真的哦。”"},{"op":"text","speaker":"羽依里","text":"“你、你说什么傻话呢，真是的。”"},{"op":"text","speaker":"羽依里","text":"“我都说是假装的了。”"},{"op":"image","layer":1,"image":"i15472"},{"op":"text","speaker":"羽未","text":"“既然是假装的，那脸为什么会这么红？”"},{"op":"text","speaker":"羽依里","text":"“我、我哪有脸红……胡说八道……”"},{"op":"image","layer":1,"image":"i15455"},{"op":"text","speaker":"羽未","text":"“越来越红了。真是怪人……”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i158"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"؟؟؟","text":"“请问有人在吗。”"},{"op":"text","speaker":"羽依里","text":"“？”"},{"op":"text","speaker":"","text":"这声音是……"},{"op":"image","layer":0,"image":"i58"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11728"},{"op":"image","layer":257,"image":"i10235"},{"op":"text","speaker":"羽依里","text":"“哟。”"},{"op":"text","speaker":"","text":"门前站着野美希和苍。"},{"op":"image","layer":257,"image":"i10200"},{"op":"text","speaker":"苍","text":"“啊来了来了。”"},{"op":"text","speaker":"羽依里","text":"“有什么事？”"},{"op":"image","layer":257,"image":"i10235"},{"op":"text","speaker":"苍","text":"“下午4点开始有个讲习班。”"},{"op":"text","speaker":"羽依里","text":"“讲习班？”"},{"op":"image","layer":257,"image":"i10226"},{"op":"text","speaker":"苍","text":"“既然担了仪式的主角，自然就有不少东西需要你去学习。”"},{"op":"image","layer":257,"image":"i10235"},{"op":"text","speaker":"苍","text":"“而讲习班就是为此举办的。”"},{"op":"text","speaker":"羽依里","text":"“还特意为我开这种班啊？”"},{"op":"image","layer":257,"image":"i10285"},{"op":"text","speaker":"苍","text":"“也不是特意为你而已。”"},{"op":"image","layer":1,"image":"i11696"},{"op":"text","speaker":"美希","text":"“总之，4点要到小学的泳池那去。”"},{"op":"text","speaker":"羽依里","text":"“为什么是在泳池啊？”"},{"op":"image","layer":1,"image":"i11693"},{"op":"text","speaker":"美希","text":"“你去了就知道。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i37"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“唔。”"},{"op":"text","speaker":"","text":"我还以为是坐在教室里听课的，看来并不是。"},{"op":"text","speaker":"","text":"在泳池讲习。"},{"op":"text","speaker":"","text":"感觉非常不对劲。"},{"op":"text","speaker":"","text":"我想到好几个像小鸠老爷子那样的人一字排开。"},{"op":"text","speaker":"","text":"然后，要我跟他们比什么水中格斗技。"},{"op":"text","speaker":"","text":"好可怕。"},{"op":"text","speaker":"","text":"可是又不能不去。"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i18"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"小学女教师","text":"“大家好。”"},{"op":"text","speaker":"孩子们","text":"“老师好。”"},{"op":"text","speaker":"","text":"小学的泳池。"},{"op":"text","speaker":"","text":"我混在从幼儿园到小学低年级的小鬼之中，跟着一起听讲。"},{"op":"text","speaker":"小学女教师","text":"“今天，我要教大家制作在祭典时用到的灯笼。”"},{"op":"text","speaker":"孩子们","text":"“好！”"},{"op":"text","speaker":"小学女教师","text":"“大家知道为什么要放灯笼吗？”"},{"op":"text","speaker":"岛上的女孩A","text":"“因为漂亮。”"},{"op":"text","speaker":"小学女教师","text":"“你说得对。”"},{"op":"text","speaker":"小学女教师","text":"“不过，其实呢，还有很多其他的原因。”"},{"op":"text","speaker":"岛上的男孩A","text":"“因为很浪漫。”"},{"op":"text","speaker":"岛上的男孩B","text":"“因为很震撼人心。”"},{"op":"text","speaker":"小学女教师","text":"“都没错。”"},{"op":"text","speaker":"小学女教师","text":"“鹰原同学你觉得呢？”"},{"op":"text","speaker":"羽依里","text":"“唉!؟”"},{"op":"text","speaker":"羽依里","text":"“呃……我想可能是有更加神秘的理由。”"},{"op":"text","speaker":"小学女教师","text":"“嗯嗯。”"},{"op":"text","speaker":"羽依里","text":"“比如说……”"},{"op":"text","speaker":"羽依里","text":"“据传在古阿兹特克帝国有向太阳奉献心脏的习俗。”"},{"op":"text","speaker":"羽依里","text":"“而这灯笼就好比心脏。”"},{"op":"text","speaker":"羽依里","text":"“放灯笼，也许就有着将心脏奉献给海神的意义。”"},{"op":"text","speaker":"小学女教师","text":"“没有这种意义。”"},{"op":"text","speaker":"岛上的女孩B","text":"“灯笼原来是心脏吗……”"},{"op":"text","speaker":"岛上的女孩C","text":"“我们要被挖掉心脏了吗？”"},{"op":"text","speaker":"小学女教师","text":"“你看都吓到她们了！不要提出这种奇怪的假说。”"},{"op":"text","speaker":"羽依里","text":"“对不起！”"},{"op":"text","speaker":"小学女教师","text":"“这灯笼原本是……”"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i18"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"……老师简单地说明缘由后，就开始制作灯笼。"},{"op":"text","speaker":"","text":"我本以为既然能让孩子做应该不会有多难，可做起来，还真挺复杂的。"},{"op":"text","speaker":"","text":"而在苦苦研究的我旁边，其他孩子们已经开始娴熟地组装起来。"},{"op":"text","speaker":"","text":"我猜大概有不少孩子每年都做着同样的事吧。"},{"op":"text","speaker":"小学女教师","text":"“大家，都做好了吗？”"},{"op":"text","speaker":"小学女教师","text":"“做好了就装在塑料袋里，试着漂一下看看。”"},{"op":"text","speaker":"羽依里","text":"“这灯笼，要在当天放海里去吗？”"},{"op":"text","speaker":"小学女教师","text":"“没错。”"},{"op":"text","speaker":"小学女教师","text":"“要拿回去好好保管，到祭典当天再带过来哦。”"},{"op":"text","speaker":"孩子们","text":"“好！”"},{"op":"text","speaker":"女孩子","text":"“……”"},{"op":"text","speaker":"","text":"我突然发现，有个小女孩藏在我背后坐着。"},{"op":"text","speaker":"","text":"仔细一看，发现她灯笼没做好，就这么丢在了一边。"},{"op":"text","speaker":"羽依里","text":"“你不做灯笼吗？”"},{"op":"text","speaker":"女孩子","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“我帮你？”"},{"op":"text","speaker":"","text":"我一伸手，她就轻轻将做了一半的灯笼移开。"},{"op":"text","speaker":"女孩子","text":"“请不要多管闲事。”"},{"op":"text","speaker":"羽依里","text":"“对不起。”"},{"op":"text","speaker":"小学女教师","text":"“能请你过来一下吗，鹰原同学？”"},{"op":"text","speaker":"小学女教师","text":"“那孩子叫堀田。”"},{"op":"text","speaker":"小学女教师","text":"“她……”"},{"op":"text","speaker":"小学女教师","text":"“她的妈妈，因为生病……”"},{"op":"text","speaker":"小学女教师","text":"“在去年冬天才刚过世。”"},{"op":"text","speaker":"小学女教师","text":"“然后她就一直处于自闭状态了。”"},{"op":"text","speaker":"羽依里","text":"“是这样啊。”"},{"op":"text","speaker":"小学女教师","text":"“所以能请你跟她聊聊天吗？”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“不过，我才刚被她嫌弃了。”"},{"op":"text","speaker":"小学女教师","text":"“哎，她对谁都是那样的。”"},{"op":"text","speaker":"小学女教师","text":"“我还得照看其他孩子。”"},{"op":"text","speaker":"小学女教师","text":"“就拜托你啦。”"},{"op":"text","speaker":"","text":"就这么给我摊了个问题儿童过来。"},{"op":"text","speaker":"","text":"老师你也太随性了吧。"},{"op":"text","speaker":"","text":"居然把这种事轻易推给别人。"},{"op":"text","speaker":"","text":"唉，算了。"},{"op":"text","speaker":"羽依里","text":"“哟。”"},{"op":"text","speaker":"堀田","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“你知道什么是盂兰盆吗？”"},{"op":"text","speaker":"堀田","text":"“盂兰盆？”"},{"op":"text","speaker":"堀田","text":"“不是盛料理用的吧？”"},{"op":"text","speaker":"羽依里","text":"“不是。”"},{"op":"text","speaker":"堀田","text":"“现在正是盂兰盆节……我知道。”"},{"op":"text","speaker":"堀田","text":"“快结束了？”"},{"op":"text","speaker":"羽依里","text":"“是啊。具体期间，各地习俗都有些不一样。”"},{"op":"text","speaker":"羽依里","text":"“那么，你知道盂兰盆节具体是什么吗？”"},{"op":"text","speaker":"堀田","text":"“……不知道。”"},{"op":"text","speaker":"羽依里","text":"“其实我也不是知道得很清楚。”"},{"op":"text","speaker":"堀田","text":"“喂喂。”"},{"op":"text","speaker":"羽依里","text":"“据说盂兰盆节时，死去的人，会暂时回来。”"},{"op":"text","speaker":"堀田","text":"“……死去的人会回来？”"},{"op":"text","speaker":"羽依里","text":"“嗯。然后在夏鸟之仪那天，我们目送那些人离去。”"},{"op":"text","speaker":"羽依里","text":"“比如说你的祖父……”"},{"op":"text","speaker":"堀田","text":"“我的两个祖父都还活得好好的。”"},{"op":"text","speaker":"羽依里","text":"“呃，那……”"},{"op":"text","speaker":"堀田","text":"“妈妈……？”"},{"op":"text","speaker":"羽依里","text":"“对。”"},{"op":"text","speaker":"羽依里","text":"“盂兰盆节回来看你的妈妈，她又要离去了。”"},{"op":"text","speaker":"堀田","text":"“她没来看我。”"},{"op":"text","speaker":"羽依里","text":"“不，来了的。”"},{"op":"text","speaker":"羽依里","text":"“只是你看不到而已。”"},{"op":"text","speaker":"堀田","text":"“真的？”"},{"op":"text","speaker":"羽依里","text":"“真的。前人，还有那些名人都这么说。”"},{"op":"text","speaker":"羽依里","text":"“然后盂兰盆节结束时那些人就要离去。”"},{"op":"text","speaker":"堀田","text":"“为什么要走？”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"text","speaker":"堀田","text":"“不走也行啊。”"},{"op":"text","speaker":"堀田","text":"“家就在这边。”"},{"op":"text","speaker":"羽依里","text":"“因为规矩就是这样的。”"},{"op":"text","speaker":"堀田","text":"“……规矩啊。”"},{"op":"text","speaker":"羽依里","text":"“所以说，在祭典那个晚上就要离去。”"},{"op":"text","speaker":"羽依里","text":"“横渡大海而去……”"},{"op":"text","speaker":"羽依里","text":"“可黑漆漆一片会害怕的吧？”"},{"op":"text","speaker":"堀田","text":"“会害怕。”"},{"op":"text","speaker":"羽依里","text":"“所以我们要为他们把海照亮。”"},{"op":"text","speaker":"羽依里","text":"“到时候就要用到灯笼。”"},{"op":"text","speaker":"堀田","text":"“……”"},{"op":"text","speaker":"堀田","text":"“嗯。”"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":1},{"op":"image","layer":0,"image":"i38"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"","text":"带着有些难看可也算是做好了的灯笼，回家。"},{"op":"text","speaker":"","text":"从岛上离去时的路标……吗。"},{"op":"text","speaker":"","text":"浑然醒觉，夏天好像就快要过完了。"},{"op":"text","speaker":"","text":"在不知不觉间。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]