[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"set","variable":7120,"value":1},{"op":"image","layer":0,"image":"i62"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“我们回来了。”"},{"op":"image","layer":1,"image":"i12740"},{"op":"text","speaker":"识","text":"“回来咯。”"},{"op":"image","layer":257,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“欢迎回来～”"},{"op":"image","layer":257,"image":"i15597"},{"op":"text","speaker":"羽未","text":"“等等，哇！海螺؟!”"},{"op":"image","layer":257,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“这是哪里来的？”"},{"op":"text","speaker":"","text":"羽未看到我手上的网兜里装满了海螺，一下愣住了。"},{"op":"image","layer":257,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“……偷捕来的？”"},{"op":"text","speaker":"羽依里","text":"“这次不是。”"},{"op":"image","layer":257,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“这次？”"},{"op":"text","speaker":"羽依里","text":"“不，我可从没干过偷捕这种事啊。”"},{"op":"image","layer":257,"image":"i15387"},{"op":"text","speaker":"羽未","text":"“我？”"},{"op":"text","speaker":"羽依里","text":"“不，没什么。”"},{"op":"text","speaker":"","text":"为了维护识的名誉，我还是不说了。"},{"op":"image","layer":1,"image":"i12789"},{"op":"text","speaker":"识","text":"“嗯嘿嘿，是帮忙捕鱼后人家分给我们的。”"},{"op":"image","layer":257,"image":"i15372"},{"op":"text","speaker":"羽依里","text":"“对，是劳动的报酬。”"},{"op":"image","layer":1,"image":"i12743"},{"op":"text","speaker":"识","text":"“我们把海螺的壳擦得干干净净，苔藓也都清理掉了。”"},{"op":"image","layer":1,"image":"i12740"},{"op":"text","speaker":"识","text":"“处理这个还蛮有意思的。”"},{"op":"text","speaker":"羽依里","text":"“还帮忙搬了打捞上来的海螺。”"},{"op":"text","speaker":"羽依里","text":"“不过，海螺实在是太沉了。”"},{"op":"image","layer":257,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“话说回来真的有好多啊。”"},{"op":"text","speaker":"羽依里","text":"“大家一起吃吧。”"},{"op":"image","layer":257,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“那应该要做成海螺炒饭吧。”"},{"op":"text","speaker":"羽依里","text":"“哎？啊，嗯，嗯……？”"},{"op":"text","speaker":"","text":"不妙……这个也要做进炒饭了。"},{"op":"text","speaker":"","text":"总感觉很对不住渔夫和海螺。"},{"op":"image","layer":257,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“那么，作为谢礼，我要送给你们这个。”"},{"op":"image","layer":1,"image":"i12783"},{"op":"text","speaker":"羽依里","text":"“……烟花套装？”"},{"op":"text","speaker":"","text":"她递过来一个装有各种烟花的套装。"},{"op":"text","speaker":"羽依里","text":"“这是哪里来的？”"},{"op":"image","layer":257,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“是做广播体操时拿到的。”"},{"op":"text","speaker":"羽依里","text":"“这岛上广播体操的奖品都是些什么啊……”"},{"op":"text","speaker":"","text":"也好，算是夏日回忆套装吧。"},{"op":"text","speaker":"羽依里","text":"“那，干脆今晚就去放烟花吧？”"},{"op":"image","layer":257,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“啊，我就不去了。”"},{"op":"text","speaker":"羽依里","text":"“哎？但是，这东西是给羽未的，你也一起来嘛。”"},{"op":"image","layer":257,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“但是我要早点睡。”"},{"op":"image","layer":257,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“所以不用管我啦。”"},{"op":"text","speaker":"羽依里","text":"“是吗？”"},{"op":"image","layer":1,"image":"i12740"},{"op":"text","speaker":"识","text":"“谢谢你啊，羽未。”"},{"op":"image","layer":257,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“不用谢。”"},{"op":"return"},{"op":"end"}]