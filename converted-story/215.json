[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":2,"image":"i743"},{"op":"image","layer":0,"image":"i513"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":2},{"op":"image","layer":0,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i1408"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":512},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i11"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15347"},{"op":"text","speaker":"羽未","text":"“呼哇～……”"},{"op":"text","speaker":"","text":"已经彻底成为每日例行活动的广播体操。"},{"op":"text","speaker":"","text":"不过今天早上的羽未有些困意。"},{"op":"image","layer":1,"image":"i15343"},{"op":"text","speaker":"羽未","text":"“呼啊……”"},{"op":"text","speaker":"羽依里","text":"“也不用一口气全画满了吧？”"},{"op":"image","layer":1,"image":"i15426"},{"op":"text","speaker":"羽未","text":"“……因为很开心嘛。”"},{"op":"text","speaker":"","text":"羽未强忍着呵欠露出笑容。"},{"op":"text","speaker":"羽依里","text":"“这样啊。”"},{"op":"text","speaker":"","text":"既然开心就由她吧。"},{"op":"image","layer":1,"image":"i15343"},{"op":"text","speaker":"羽未","text":"“呼啊～……”"},{"op":"text","speaker":"","text":"本来做这些事就是为了羽未能开心度过暑假。"},{"op":"text","speaker":"","text":"让我感觉这个提议有了价值。"},{"op":"text","speaker":"","text":"不过，羽未到底写了什么呢……"},{"op":"text","speaker":"羽依里","text":"“唔……”"},{"op":"text","speaker":"","text":"唯独这点令人不安。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"广播体操登录奖励送的新鲜鸡蛋，做成生鸡蛋拌饭当做了早餐。"},{"op":"text","speaker":"羽依里","text":"“……!!鸡蛋的香味…不同！”"},{"op":"image","layer":1,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“咕咕！”"},{"op":"text","speaker":"羽依里","text":"“在浓郁蛋黄香味中，又感觉到了嫩叶般的清爽。”"},{"op":"image","layer":1,"image":"i15455"},{"op":"text","speaker":"羽未","text":"“咕咕！”"},{"op":"text","speaker":"羽依里","text":"“至上的生蛋拌饭！”"},{"op":"image","layer":1,"image":"i15538"},{"op":"text","speaker":"羽未","text":"“咕咕！”"},{"op":"text","speaker":"","text":"在令人激动的早餐过后，我从羽未手中接过了日记本。"},{"op":"text","speaker":"","text":"8月2日，打开了今天的这一页，上半部分画着重叠的三角形状物体。"},{"op":"text","speaker":"羽依里","text":"“今天是……”"},{"op":"text","speaker":"羽依里","text":"“吃生八桥饼吗？”"},{"op":"text","speaker":"","text":"也不知道小卖铺有没有货……"},{"op":"image","layer":1,"image":"i15496"},{"op":"text","speaker":"羽未","text":"“折纸……”"},{"op":"text","speaker":"羽依里","text":"“喔，是这样啊。”"},{"op":"text","speaker":"","text":"折纸的话，小卖铺应该有卖。"},{"op":"text","speaker":"","text":"再次看了看日记本。"},{"op":"text","speaker":"","text":"天气栏写着，晴。"},{"op":"text","speaker":"","text":"一看屋外晴空万里。松了口气。"},{"op":"text","speaker":"羽依里","text":"“好，那我出门一趟买折纸回来。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“我看家吗？”"},{"op":"text","speaker":"羽依里","text":"“我很快回来。”"},{"op":"image","layer":1,"image":"i15450"},{"op":"text","speaker":"羽未","text":"“……嗯。”"},{"op":"text","speaker":"","text":"虽然提及了看家这个词，但却不再是昨天那孤单的表情。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“不好意思，我要买折纸。”"},{"op":"text","speaker":"","text":"咦？又不在？"},{"op":"text","speaker":"羽依里","text":"“有人在吗！”"},{"op":"text","speaker":"苍","text":"“稍等一下。”"},{"op":"text","speaker":"","text":"内屋推拉门里传来了声音。"},{"op":"text","speaker":"羽依里","text":"“什么嘛，这不有人嘛。”"},{"op":"text","speaker":"","text":"拉开门。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i1046"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"苍","text":"“喂……！”"},{"op":"text","speaker":"羽依里","text":" “呀啊啊啊啊啊啊啊！” "},{"op":"image","layer":0,"image":"i1047"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"苍","text":"“喂！我就不懂为什么每次都是你先叫出来！”"},{"op":"text","speaker":"羽依里","text":"“因为……有痴女……”"},{"op":"text","speaker":"苍","text":"“是你自己进来的好吗！”"},{"op":"text","speaker":"羽依里","text":"“其实你是有企图的吧……？馋我的……贞操……”"},{"op":"text","speaker":"苍","text":"“企图个鬼！”"},{"op":"text","speaker":"苍","text":"“话说，你还不给我出去！”"},{"op":"image","layer":0,"image":"i158"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"哐当!!"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i31"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“苍真是凶残啊。”"},{"op":"text","speaker":"羽依里","text":"“不过既然弄到了折纸，也就不计较了。”"},{"op":"text","speaker":"","text":"一边揉着被踹得生疼的胸口，一边骑着摩托前进。"},{"op":"text","speaker":"羽依里","text":"“……嗯？”"},{"op":"text","speaker":"","text":"看见一个熟悉的身影后停下车来。"},{"op":"image","layer":1,"image":"i13418"},{"op":"text","speaker":"白羽","text":"“……啊。”"},{"op":"text","speaker":"","text":"白羽也发现我了。"},{"op":"text","speaker":"羽依里","text":"“这是打算去我家吗？”"},{"op":"image","layer":1,"image":"i13235"},{"op":"text","speaker":"白羽","text":"“毕竟都约好了。”"},{"op":"text","speaker":"羽依里","text":"“那上车吗？”"},{"op":"text","speaker":"","text":"用大拇指朝货架比了比。"},{"op":"image","layer":1,"image":"i13343"},{"op":"text","speaker":"白羽","text":"“……呃…我不要……”"},{"op":"text","speaker":"","text":"一脸露骨的嫌弃表情。"},{"op":"text","speaker":"","text":"略感打击。"},{"op":"image","layer":1,"image":"i13253"},{"op":"text","speaker":"白羽","text":"“……毕竟穿着裙子。”"},{"op":"text","speaker":"羽依里","text":"“哦哦，是这个原因啊。”"},{"op":"image","layer":1,"image":"i13244"},{"op":"text","speaker":"白羽","text":"“……而且还在坐你身后。”"},{"op":"text","speaker":"羽依里","text":"“你可真是会先捧后摔啊。”"},{"op":"text","speaker":"","text":"一种心如刀割的感觉。"},{"op":"text","speaker":"","text":"感觉先扬长而去也不太礼貌，于是就下车来，推着车和她并排走。"},{"op":"image","layer":1,"image":"i13370"},{"op":"text","speaker":"白羽","text":"“你先走你的咯。”"},{"op":"text","speaker":"","text":"再一次受到打击。"},{"op":"image","layer":1,"image":"i13373"},{"op":"text","speaker":"白羽","text":"“……羽未一个人在家等着的吧？”"},{"op":"text","speaker":"羽依里","text":"“哦哦，是这个原因啊。”"},{"op":"image","layer":1,"image":"i13426"},{"op":"text","speaker":"白羽","text":"“……而且走在你身边有点……”"},{"op":"text","speaker":"羽依里","text":"“你果真是先捧后摔的高手。”"},{"op":"text","speaker":"","text":"…咦？难不成我被她讨厌了……？"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"text","speaker":"","text":"无言地走了一小会儿。"},{"op":"text","speaker":"","text":"她虽说有些不情愿，但依旧是走在我身旁。"},{"op":"image","layer":1,"image":"i13373"},{"op":"text","speaker":"白羽","text":"“………”"},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"text","speaker":"","text":"只不过两者没有对话。"},{"op":"image","layer":1,"image":"i13274"},{"op":"text","speaker":"白羽","text":"“……喂。”"},{"op":"text","speaker":"羽依里","text":"“什米？”"},{"op":"text","speaker":"","text":"突然间被搭话，害得我一不小心有些破音。"},{"op":"image","layer":1,"image":"i13235"},{"op":"text","speaker":"白羽","text":"“你去哪里了？”"},{"op":"text","speaker":"羽依里","text":"“喔，我去买这个了。”"},{"op":"text","speaker":"","text":"给她看了看在小卖铺买的东西。"},{"op":"image","layer":1,"image":"i13314"},{"op":"text","speaker":"白羽","text":"“折纸？为什么？”"},{"op":"text","speaker":"羽依里","text":"“羽未的日记。”"},{"op":"text","speaker":"羽依里","text":"“上面写着和妈妈折纸。”"},{"op":"text","speaker":"羽依里","text":"“白羽，你会折纸吗？”"},{"op":"image","layer":1,"image":"i13418"},{"op":"text","speaker":"白羽","text":"“……嗯。”"},{"op":"text","speaker":"羽依里","text":"“噢，那就好。”"},{"op":"image","layer":1,"image":"i13373"},{"op":"text","speaker":"白羽","text":"“……因为折纸很适合一个人玩。”"},{"op":"text","speaker":"","text":"一不小心知道了并不是那么想知道的事……"},{"op":"text","speaker":"羽依里","text":"“不过也好，会折纸就没问题了。”"},{"op":"text","speaker":"羽依里","text":"“日记上写的是妈妈很擅长折纸。”"},{"op":"image","layer":1,"image":"i13405"},{"op":"text","speaker":"白羽","text":"“哦……”"},{"op":"image","layer":1,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“不过，我只会折一些动物之类的吧。”"},{"op":"text","speaker":"羽依里","text":"“这些小女孩才更喜欢。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“羽未，妈妈来咯。”"},{"op":"image","layer":7,"image":"i15572"},{"op":"text","speaker":"羽未","text":"“啊……”"},{"op":"text","speaker":"","text":"从屏风背后探出头来，观察着我们的情况。"},{"op":"image","layer":1,"image":"i13379"},{"op":"text","speaker":"白羽","text":"“呃，你好……”"},{"op":"text","speaker":"","text":"白羽有些犹豫地打了声招呼，羽未连忙把头缩了回去。"},{"op":"text","speaker":"","text":"还在害羞吧？"},{"op":"image","layer":257,"image":"i15569"},{"op":"text","speaker":"","text":"正当我这么想的时候，羽未走了出来，朝着白羽一路小跑过来。"},{"op":"image","layer":1,"image":"i13343"},{"op":"text","speaker":"白羽","text":"“唉？啊……哇！……啊……”"},{"op":"text","speaker":"","text":"羽未一路冲过来，迎面扑在了白羽身上后搂住了她的腰。"},{"op":"text","speaker":"","text":"（紧紧搂住）。"},{"op":"text","speaker":"","text":"像是为了不让自己的表情被人看见一样，将额头埋在白羽的腹部。"},{"op":"image","layer":1,"image":"i13294"},{"op":"text","speaker":"白羽","text":"“呃…这……”"},{"op":"text","speaker":"","text":"白羽对羽未的表现有些不知所措，但我反而却有些开心。"},{"op":"text","speaker":"","text":"因为羽未虽然害羞，但还是表达出了她的欢喜。"},{"op":"text","speaker":"羽依里","text":"“好啦，羽未，好好打招呼。”"},{"op":"image","layer":257,"image":"i15476"},{"op":"text","speaker":"羽未","text":"“你……你好……”"},{"op":"text","speaker":"","text":"羽未稍微将头挪开一点，抬头向白羽问好。"},{"op":"image","layer":1,"image":"i13379"},{"op":"text","speaker":"白羽","text":"“……嗯。你好。”"},{"op":"text","speaker":"","text":"白羽依旧有些不知所措，但也将手绕在了羽未的身后。"},{"op":"text","speaker":"","text":"虽然没有紧紧地搂在怀里，但依旧勾勒出了一副接纳包容的画面。"},{"op":"image","layer":257,"image":"i15442"},{"op":"text","speaker":"羽未","text":"“那…那个……”"},{"op":"image","layer":1,"image":"i13265"},{"op":"text","speaker":"白羽","text":"“什么？”"},{"op":"image","layer":257,"image":"i15445"},{"op":"text","speaker":"羽未","text":"“………”"},{"op":"image","layer":257,"image":"i15576"},{"op":"text","speaker":"羽未","text":"“我……我……”"},{"op":"image","layer":257,"image":"i15579"},{"op":"text","speaker":"羽未","text":"“我可以……叫你……妈妈吗？”"},{"op":"text","speaker":"","text":"她一脸羞涩，但声音中又带着一丝不安。"},{"op":"image","layer":1,"image":"i13405"},{"op":"text","speaker":"","text":"白羽愣了一下，看向了我。"},{"op":"text","speaker":"","text":"我没有说话，而是低下了头表达了请求之意。"},{"op":"image","layer":1,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“嗯…嗯，可以哦。”"},{"op":"image","layer":257,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“啊……”"},{"op":"image","layer":257,"image":"i15573"},{"op":"text","speaker":"羽未","text":"“妈妈……妈妈，妈妈！”"},{"op":"image","layer":257,"image":"i15593"},{"op":"text","speaker":"羽未","text":"“妈妈……嘻嘻，唉嘿嘿。”"},{"op":"text","speaker":"","text":"感觉她十分地开心。"},{"op":"text","speaker":"羽依里","text":"“羽未，今天不是要让妈妈教你折纸吗？”"},{"op":"image","layer":257,"image":"i15347"},{"op":"text","speaker":"羽未","text":"“嗯！可以教我吗……？”"},{"op":"image","layer":1,"image":"i13337"},{"op":"text","speaker":"白羽","text":"“嗯，我们一起折吧。”"},{"op":"text","speaker":"","text":"虽然还有些生硬，但白羽也露出了笑容。"},{"op":"text","speaker":"","text":"我们来到桌前，把从小卖铺买来的折纸摊开。"},{"op":"image","layer":257,"image":"i15378"},{"op":"text","speaker":"羽未","text":"“哇，好漂亮。”"},{"op":"image","layer":1,"image":"i13314"},{"op":"text","speaker":"白羽","text":"“羽未，你会折什么东西吗？”"},{"op":"image","layer":257,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“花。”"},{"op":"text","speaker":"羽依里","text":"“咦，还能折花的吗？”"},{"op":"text","speaker":"羽依里","text":"“折一个来看看。”"},{"op":"image","layer":257,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“嗯。”"},{"op":"text","speaker":"","text":"羽未开始折了起来。"},{"op":"text","speaker":"","text":"先沿对角线对折形成一个三角形……"},{"op":"text","speaker":"","text":"然后再对折，又变成一个更小的三角形。"},{"op":"image","layer":1,"image":"i15593"},{"op":"text","speaker":"羽未","text":"“好了！”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":2304,"image":"i1409"},{"op":"text","speaker":"羽依里","text":"“唉？三角形的……花……？”"},{"op":"text","speaker":"","text":"羽未将折好的纸罩在自己鼻子上。"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":1792},{"op":"clear","layer":2304},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15499"},{"op":"text","speaker":"羽未","text":"“Good morning”"},{"op":"image","layer":257,"image":"i13294"},{"op":"text","speaker":"白羽","text":"“鼻子？”"},{"op":"text","speaker":"","text":"原来不是花是鼻子啊。"},{"op":"text","speaker":"羽依里","text":"“蛮古怪的。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“接着，妈妈来折。”"},{"op":"text","speaker":"","text":"羽未将折纸递给白羽。"},{"op":"text","speaker":"","text":"白羽仍旧有些困惑，但还是接了过来。"},{"op":"image","layer":257,"image":"i13274"},{"op":"text","speaker":"白羽","text":"“那……”"},{"op":"text","speaker":"","text":"也不说要折什么就开始动起手来。"},{"op":"text","speaker":"","text":"看了一会儿，很快就知道她折的是什么了。"},{"op":"image","layer":1,"image":"i15378"},{"op":"text","speaker":"羽未","text":"“哇啊！”"},{"op":"text","speaker":"","text":"羽未两眼放着光，她应该也知道是什么了吧，。"},{"op":"image","layer":257,"image":"i13376"},{"op":"text","speaker":"白羽","text":"“……折好了。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":2304,"image":"i1410"},{"op":"image","layer":7,"image":"i13237"},{"op":"text","speaker":"白羽","text":"“知道是什么吗？”"},{"op":"image","layer":7,"image":"i15346"},{"op":"text","speaker":"羽未","text":"“是花！郁金香！”"},{"op":"image","layer":7,"image":"i13276"},{"op":"text","speaker":"白羽","text":"“正确。”"},{"op":"text","speaker":"","text":"她是考虑到了羽未的“花”才会折出这个来的。"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":1792},{"op":"clear","layer":2304},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15538"},{"op":"image","layer":257,"image":"i13277"},{"op":"text","speaker":"羽未","text":"“好厉害，好厉害哦。”"},{"op":"image","layer":1,"image":"i15552"},{"op":"text","speaker":"羽未","text":"“还有别的吗，有别的吗？”"},{"op":"image","layer":257,"image":"i13301"},{"op":"text","speaker":"白羽","text":"“我看看啊……”"},{"op":"text","speaker":"","text":"白羽又动起手来。"},{"op":"text","speaker":"","text":"她的动作行云流水，创造出了某种生物的形状。"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":2304,"image":"i1411"},{"op":"image","layer":7,"image":"i13276"},{"op":"text","speaker":"白羽","text":"“你看。”"},{"op":"image","layer":7,"image":"i15510"},{"op":"text","speaker":"羽未","text":"“哇！是小狗！”"},{"op":"text","speaker":"","text":"这次折出了狗。"},{"op":"text","speaker":"","text":"一个侧面的小狗全影。"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":1792},{"op":"clear","layer":2304},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"白羽一个接一个地折了起来。"},{"op":"text","speaker":"","text":"一开始还显得没自信，但从她灵活的指尖诞生出了各种各样物体，令人敬佩。"},{"op":"image","layer":1,"image":"i15321"},{"op":"image","layer":257,"image":"i13238"},{"op":"text","speaker":"羽未","text":"“妈妈，好厉害！”"},{"op":"text","speaker":"","text":"一下子就让羽未崇拜得五体投地。"},{"op":"text","speaker":"羽依里","text":"“刚才那么谦虚，结果这么厉害啊。”"},{"op":"image","layer":257,"image":"i13418"},{"op":"text","speaker":"白羽","text":"“因为很久没折过了。”"},{"op":"image","layer":257,"image":"i13376"},{"op":"text","speaker":"白羽","text":"“不过，折着折着好像就想起来了。”"},{"op":"image","layer":1,"image":"i15573"},{"op":"text","speaker":"羽未","text":"“那…那个……妈妈。”"},{"op":"image","layer":257,"image":"i13373"},{"op":"text","speaker":"白羽","text":"“………”"},{"op":"image","layer":1,"image":"i15468"},{"op":"text","speaker":"羽未","text":"“……妈妈？”"},{"op":"text","speaker":"羽依里","text":"“白羽，她是在叫你呢。”"},{"op":"image","layer":257,"image":"i13343"},{"op":"text","speaker":"白羽","text":"“啊！嗯嗯！对不起，怎么了？”"},{"op":"image","layer":1,"image":"i15573"},{"op":"text","speaker":"羽未","text":"“我…我也想试试折各种各样的东西。”"},{"op":"image","layer":257,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“那我们一起折折看？”"},{"op":"image","layer":1,"image":"i15506"},{"op":"text","speaker":"羽未","text":"“嗯！”"},{"op":"image","layer":257,"image":"i13340"},{"op":"text","speaker":"白羽","text":"“折个什么好呢？”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“唔……”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“纸鹤！”"},{"op":"text","speaker":"羽依里","text":"“从折鼻子一下子提升这么多难度啊。”"},{"op":"image","layer":257,"image":"i13259"},{"op":"text","speaker":"白羽","text":"“有点复杂，我们慢慢折吧。”"},{"op":"image","layer":257,"image":"i13277"},{"op":"text","speaker":"白羽","text":"“你跟着我学。”"},{"op":"image","layer":1,"image":"i15412"},{"op":"text","speaker":"羽未","text":"“嗯！”"},{"op":"text","speaker":"","text":"两个人一起折起了纸鹤。"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i1412"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"这是只属于她们的世界。"},{"op":"text","speaker":"","text":"令人感到欣慰。"},{"op":"text","speaker":"","text":"不过这样一来，我就无事可做了。"},{"op":"text","speaker":"羽依里","text":"“我也折点什么吧。”"},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"取了一张折纸。"},{"op":"text","speaker":"","text":"好了，折个什么呢。"},{"op":"text","speaker":"","text":"既然要折，就选白羽应该不会折的东西吧。"},{"op":"text","speaker":"","text":"折折……叠叠…"},{"op":"text","speaker":"","text":"折折……叠叠…"},{"op":"image","layer":7,"image":"i15592"},{"op":"text","speaker":"羽未","text":"“纸鹤，折好啦！”"},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":2304,"image":"i1413"},{"op":"image","layer":7,"image":"i13391"},{"op":"text","speaker":"白羽","text":"“嗯，折得真好。”"},{"op":"image","layer":7,"image":"i15592"},{"op":"text","speaker":"羽未","text":"“唉嘿嘿～”"},{"op":"text","speaker":"羽依里","text":"“我也折好了。”"},{"op":"image","layer":7,"image":"i13273"},{"op":"text","speaker":"白羽","text":"“你折了什么？”"},{"op":"text","speaker":"羽依里","text":"“哼，你看！纸鹤！”"},{"op":"image","layer":2304,"image":"i1414"},{"op":"image","layer":7,"image":"i15349"},{"op":"text","speaker":"羽未","text":"“哇，爸爸也一起……呃？”"},{"op":"image","layer":7,"image":"i13240"},{"op":"text","speaker":"白羽","text":"“怪里怪气的……”"},{"op":"image","layer":7,"image":"i15336"},{"op":"text","speaker":"羽未","text":"“……长着……脚……”"},{"op":"text","speaker":"羽依里","text":"“酷不酷？”"},{"op":"image","layer":7,"image":"i15327"},{"op":"text","speaker":"羽未","text":"“恶心。”"},{"op":"text","speaker":"羽依里","text":"“唉……？”"},{"op":"text","speaker":"羽依里","text":"“不觉得很酷吗？”"},{"op":"image","layer":7,"image":"i15524"},{"op":"text","speaker":"羽未","text":"“不！不！不！”"},{"op":"text","speaker":"","text":"被强烈否定了。"},{"op":"text","speaker":"","text":"明明是我的自信之作。"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":1792},{"op":"clear","layer":2304},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15552"},{"op":"image","layer":257,"image":"i13373"},{"op":"text","speaker":"羽未","text":"“妈妈，下一个，下一个。”"},{"op":"image","layer":257,"image":"i13392"},{"op":"text","speaker":"白羽","text":"“嗯，那接下来……”"},{"op":"text","speaker":"","text":"两个人抛下我后，又开始折了起来。"},{"op":"text","speaker":"","text":"谁怕谁，我就让你见识见识什么叫能哄小孩开心的折纸。"},{"op":"image","layer":1,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“蝴蝶折好了！”"},{"op":"image","layer":7,"image":"i13237"},{"op":"text","speaker":"白羽","text":"“嗯，厉害。”"},{"op":"image","layer":1,"image":"i15499"},{"op":"text","speaker":"羽未","text":"“嘻嘻。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“爸爸，你看……”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“咦？”"},{"op":"text","speaker":"","text":"羽未的目光停留在了我的手中。"},{"op":"text","speaker":"羽未","text":"“那是什么？”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":2304,"image":"i1415"},{"op":"text","speaker":"羽依里","text":"“是青蛙。”"},{"op":"text","speaker":"","text":"接下来我选择折青蛙。"},{"op":"text","speaker":"","text":"用手指摁屁股会跳的那种。"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":1792},{"op":"clear","layer":2304},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“看好了哦？”"},{"op":"text","speaker":"","text":"蹦♪"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“哇！跳起来了！”"},{"op":"text","speaker":"","text":"出乎意料地上钩了。"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“再来一次！”"},{"op":"text","speaker":"羽依里","text":"“瞧！”"},{"op":"text","speaker":"","text":"蹦！蹦！"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“哇！青蛙先生一蹦一跳的！”"},{"op":"text","speaker":"","text":"羽未的兴趣已经完全转移到我这边了。"},{"op":"image","layer":7,"image":"i13389"},{"op":"text","speaker":"","text":"白羽静静地看着这一幕。"},{"op":"text","speaker":"","text":"刚这么一想，她就立马动手折了起来。"},{"op":"image","layer":1,"image":"i15372"},{"op":"image","layer":257,"image":"i13392"},{"op":"text","speaker":"白羽","text":"“羽未，是海豚哟。”"},{"op":"image","layer":1,"image":"i15538"},{"op":"text","speaker":"羽未","text":"“哇！就像在游泳一样！”"},{"op":"text","speaker":"","text":"白羽用立体式的折纸来对抗我的青蛙。"},{"op":"text","speaker":"","text":"羽未接过纸海豚一脸欢心的样子。"},{"op":"image","layer":257,"image":"i13376"},{"op":"text","speaker":"白羽","text":"“呵呵……”"},{"op":"text","speaker":"","text":"看到她那副模样后，白羽朝我露出了自信的笑容。"},{"op":"text","speaker":"","text":"原来如此，我懂了。"},{"op":"text","speaker":"","text":"说白了，就是要决个胜负是吧。"},{"op":"text","speaker":"羽依里","text":"“羽未，你等一等。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我去厨房拿来了一张昨天的报纸"},{"op":"text","speaker":"","text":"麻溜地折起了某样东西。"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“是帽子！”"},{"op":"text","speaker":"羽依里","text":"“差那么一点，其实是头盔啦。”"},{"op":"text","speaker":"","text":"戴上给她看。"},{"op":"image","layer":1,"image":"i15378"},{"op":"text","speaker":"羽未","text":"“哇，好厉害。”"},{"op":"text","speaker":"","text":"出乎意料地开心。"},{"op":"image","layer":7,"image":"i13413"},{"op":"text","speaker":"白羽","text":"“羽未，你看，金色的小鸟哦。”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":2304,"image":"i1416"},{"op":"image","layer":7,"image":"i15543"},{"op":"text","speaker":"羽未","text":"“哇！闪亮亮的！”"},{"op":"text","speaker":"羽依里","text":"“你耍赖！这是一套里面只有一张的金纸啊。”"},{"op":"image","layer":2304,"image":"i1417"},{"op":"image","layer":7,"image":"i13391"},{"op":"text","speaker":"白羽","text":"“还有银色的小鸟呢。”"},{"op":"image","layer":7,"image":"i15532"},{"op":"text","speaker":"羽未","text":"“哇！闪闪发光！”"},{"op":"text","speaker":"羽依里","text":"“居然毫不顾虑就使用稀有纸张……”"},{"op":"text","speaker":"","text":"没想到白羽这么争强好胜。"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":1792},{"op":"clear","layer":2304},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13373"},{"op":"text","speaker":"白羽","text":"“那接下来就用这张彩虹色的纸……”"},{"op":"text","speaker":"羽依里","text":"“白羽……劝你见好就收哦。”"},{"op":"image","layer":1,"image":"i13259"},{"op":"text","speaker":"白羽","text":"“唉……？”"},{"op":"text","speaker":"","text":"我多少也留了一手的。"},{"op":"text","speaker":"","text":"我开始用和报纸一同投递的广告纸折起了某样东西。"},{"op":"text","speaker":"","text":"这是一种会让人上瘾的折纸。"},{"op":"text","speaker":"","text":"小学时候就因为太风靡了甚至还下了禁令。"},{"op":"image","layer":1,"image":"i13387"},{"op":"text","speaker":"白羽","text":"“……！”"},{"op":"text","speaker":"","text":"白羽似乎已经察觉到我在折什么了。"},{"op":"text","speaker":"","text":"但为时已晚。"},{"op":"text","speaker":"羽依里","text":"“……成了。”"},{"op":"text","speaker":"羽依里","text":"“嘿！”"},{"op":"text","speaker":"","text":"将折好的纸用力一甩。"},{"op":"text","speaker":"","text":"啪!!!"},{"op":"image","layer":1,"image":"i15343"},{"op":"text","speaker":"羽未","text":"“呀啊！”"},{"op":"text","speaker":"","text":"一声巨响吓得羽未跳了起来。"},{"op":"text","speaker":"羽依里","text":"“怎么样，纸大炮。”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“……好吵好讨厌。”"},{"op":"image","layer":1,"image":"i15485"},{"op":"text","speaker":"","text":"见她赌气地转过脸去，我当场跪倒在地。"},{"op":"image","layer":257,"image":"i13246"},{"op":"text","speaker":"白羽","text":"“呵呵……”"},{"op":"text","speaker":"","text":"接着白羽露出洋洋得意的笑容继续追击。"},{"op":"image","layer":257,"image":"i13376"},{"op":"text","speaker":"白羽","text":"“羽未，想不想看好玩的折纸？”"},{"op":"image","layer":1,"image":"i15468"},{"op":"text","speaker":"羽未","text":"“什么样的？”"},{"op":"image","layer":257,"image":"i13392"},{"op":"text","speaker":"白羽","text":"“等等哦。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":2304,"image":"i1418"},{"op":"text","speaker":"","text":"白羽折出来的是一艘船。"},{"op":"image","layer":7,"image":"i15457"},{"op":"text","speaker":"羽未","text":"“哇！会在水上漂吗？”"},{"op":"image","layer":7,"image":"i13417"},{"op":"text","speaker":"白羽","text":"“这个不是这样玩的。”"},{"op":"image","layer":7,"image":"i13375"},{"op":"text","speaker":"白羽","text":"“来，你把船帆捏住。”"},{"op":"text","speaker":"","text":"让羽未抓住船帆。"},{"op":"image","layer":7,"image":"i13391"},{"op":"text","speaker":"白羽","text":"“闭上眼睛。”"},{"op":"image","layer":7,"image":"i15454"},{"op":"text","speaker":"羽未","text":"“嗯……”"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":1792},{"op":"clear","layer":2304},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“骗骗船啊……”"},{"op":"image","layer":7,"image":"i13420"},{"op":"text","speaker":"白羽","text":"“……好了，可以睁开眼睛了。”"},{"op":"text","speaker":"羽依里","text":"“哈哈哈，这种骗小孩的折纸还想有效果……”"},{"op":"image","layer":1,"image":"i15544"},{"op":"text","speaker":"羽未","text":"“哇啊啊啊!؟”"},{"op":"image","layer":1,"image":"i15533"},{"op":"text","speaker":"羽未","text":"“明明抓的是船帆，结果现在抓的是船头了！”"},{"op":"text","speaker":"","text":"居然真的上当了。"},{"op":"image","layer":1,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“为什么!؟为什么呢？”"},{"op":"image","layer":257,"image":"i13421"},{"op":"text","speaker":"白羽","text":"“很神奇吧？”"},{"op":"image","layer":1,"image":"i15493"},{"op":"text","speaker":"羽未","text":"“是魔法！”"},{"op":"image","layer":257,"image":"i13392"},{"op":"text","speaker":"白羽","text":"“呵呵，或许是吧。”"},{"op":"image","layer":1,"image":"i15499"},{"op":"text","speaker":"羽未","text":"“教我魔法！”"},{"op":"image","layer":257,"image":"i13376"},{"op":"text","speaker":"白羽","text":"“好的。”"},{"op":"text","speaker":"","text":"不好……这样下去，羽未的兴趣会全都被白羽吸引走的。"},{"op":"text","speaker":"","text":"这令我感到很不甘……"},{"op":"text","speaker":"","text":"为了不输给白羽，我继续折了起来。"},{"op":"text","speaker":"羽依里","text":"“羽未，你看看这个，觉得是什么？”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“……？”"},{"op":"text","speaker":"","text":"咦？不知道的吗……？"},{"op":"image","layer":257,"image":"i13259"},{"op":"text","speaker":"白羽","text":"“手里剑啊，真是怀念。”"},{"op":"image","layer":257,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“男生经常折出来扔呢。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“用来扔着玩的吗？”"},{"op":"text","speaker":"羽依里","text":"“嗯，就像这样……忍法！”"},{"op":"text","speaker":"","text":"咻……！"},{"op":"image","layer":1,"image":"i15343"},{"op":"text","speaker":"羽未","text":"“呜喵!؟”"},{"op":"text","speaker":"","text":"打中了羽未的脸。"},{"op":"text","speaker":"羽依里","text":"“啊，坏了……”"},{"op":"image","layer":257,"image":"i13424"},{"op":"text","speaker":"白羽","text":"“羽未!؟”"},{"op":"image","layer":1,"image":"i15474"},{"op":"text","speaker":"羽未","text":"“呜咪……”"},{"op":"image","layer":257,"image":"i13270"},{"op":"text","speaker":"白羽","text":"“喂，很危险的啊！”"},{"op":"image","layer":257,"image":"i13263"},{"op":"text","speaker":"白羽","text":"“要是打中眼睛怎么办？”"},{"op":"text","speaker":"羽依里","text":"“对不起，我得意忘形了。”"},{"op":"image","layer":257,"image":"i13262"},{"op":"text","speaker":"白羽","text":"“所以说你们这些男生啊……”"},{"op":"text","speaker":"","text":"感觉好像小学时候也被这样在班会课上批斗过。"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"小学女生A","text":"‘鹰原用手里剑扔中亚梨子的脸了。’"},{"op":"text","speaker":"小学女生A","text":"‘为什么要做这样的事呢？’"},{"op":"text","speaker":"羽依里","text":"‘……扔到她的时候我有道过歉的啊……’"},{"op":"text","speaker":"小学女生B","text":"‘要是扔中眼睛就严重了，你一点都没有反省的意思。’"},{"op":"text","speaker":"小学女生C","text":"‘亚梨子好可怜哦。’"},{"op":"text","speaker":"小学女生A","text":"‘诚心向她道歉。’"},{"op":"set","variable":1,"value":0},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“唔……我明明已经道过歉了……”"},{"op":"text","speaker":"羽依里","text":"“这些女生怎么这么团结啊……”"},{"op":"text","speaker":"羽依里","text":"“你们平时关系都没有那么好的……”"},{"op":"image","layer":1,"image":"i13253"},{"op":"text","speaker":"白羽","text":"“……没事吧？”"},{"op":"text","speaker":"羽依里","text":"“……哈…！没事。”"},{"op":"text","speaker":"羽依里","text":"“只是脑海中闪过一些童年阴影。”"},{"op":"image","layer":257,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“……别在意。”"},{"op":"text","speaker":"","text":"拍了拍我的肩。"},{"op":"text","speaker":"","text":"为什么变成我被安慰了。"},{"op":"image","layer":257,"image":"i15426"},{"op":"text","speaker":"羽未","text":"“那…你折个什么吧。”"},{"op":"text","speaker":"","text":"而且还照顾我的感受。"},{"op":"text","speaker":"羽依里","text":"“嗯……那你看这样的如何？”"},{"op":"text","speaker":"","text":"虽然同样是用来扔的，但是这个安全而且也热衷过。"},{"op":"text","speaker":"","text":"这个小学时也被禁止过吧。"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":2304,"image":"i1419"},{"op":"text","speaker":"羽依里","text":"“折好了。”"},{"op":"image","layer":7,"image":"i15371"},{"op":"text","speaker":"羽未","text":"“……章鱼？”"},{"op":"text","speaker":"羽依里","text":"“不对，这是飞机。”"},{"op":"text","speaker":"","text":"凭着以前的记忆，试着折了一个纸飞机。"},{"op":"text","speaker":"","text":"我记得这个在班上也算飞得远的了。"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":1792},{"op":"clear","layer":2304},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“你看好了。”"},{"op":"text","speaker":"","text":"投了出去。"},{"op":"image","layer":0,"image":"i453"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"咻――――――――……"},{"op":"text","speaker":"","text":"纸飞机如滑行般，华丽地穿过了房间。"},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15544"},{"op":"text","speaker":"羽未","text":"“噢……”"},{"op":"text","speaker":"","text":"羽未意外地两眼放光。"},{"op":"text","speaker":"","text":"莫非她开始崇拜我了？"},{"op":"image","layer":1,"image":"i15511"},{"op":"text","speaker":"羽未","text":"“飞得好远啊。”"},{"op":"text","speaker":"羽依里","text":"“扔飞机的诀窍呢，就是动作要轻柔一些。”"},{"op":"image","layer":1,"image":"i15538"},{"op":"text","speaker":"羽未","text":"“第一次看见飞那么远的呢。”"},{"op":"text","speaker":"羽依里","text":"“我是最远的吗？”"},{"op":"image","layer":1,"image":"i15547"},{"op":"text","speaker":"羽未","text":"“嗯，最远的。”"},{"op":"text","speaker":"","text":"欢喜得我不禁嘴角上扬。"},{"op":"image","layer":7,"image":"i13389"},{"op":"text","speaker":"白羽","text":"“………”"},{"op":"text","speaker":"","text":"白羽见状后，眯起了眼。"},{"op":"text","speaker":"","text":"然后慢慢地抽出一张折纸，麻溜地折了起来。"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":2304,"image":"i1420"},{"op":"text","speaker":"","text":"不一会儿，纸飞机就折好了。"},{"op":"text","speaker":"","text":"和我那个形状完全不同的纸飞机。"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":1792},{"op":"clear","layer":2304},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13280"},{"op":"text","speaker":"白羽","text":"“………”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i453"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"咻――――――――――――――――――――……"},{"op":"text","speaker":"羽依里","text":"“!؟”"},{"op":"text","speaker":"","text":"太远了吧！"},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"白羽的飞机轻而易举地超过了我那架的飞行距离，然后平稳地着地了。"},{"op":"image","layer":1,"image":"i13376"},{"op":"text","speaker":"白羽","text":"“呵呵。”"},{"op":"text","speaker":"","text":"接着又是洋洋得意的笑容。"},{"op":"image","layer":257,"image":"i15533"},{"op":"text","speaker":"羽未","text":"“妈妈的飞机好厉害！”"},{"op":"image","layer":1,"image":"i13277"},{"op":"text","speaker":"白羽","text":"“是我的Hyper Mustang Special Dimension IV MarkIII更能飞呢。”"},{"op":"text","speaker":"羽依里","text":"“虽然你这机名很让人想吐槽，不过你觉得刚才我那架是我的真本事吗？”"},{"op":"text","speaker":"","text":"我立马折起了别的飞机。"},{"op":"text","speaker":"","text":"想办法将刚才那架飞机的尾翼和侧翼角度加以改良。"},{"op":"text","speaker":"羽依里","text":"“嘿！”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i453"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"咻――――――――――――――――――――――――――……"},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我的改良型比白羽的纸飞机飞得略远一点。"},{"op":"text","speaker":"羽依里","text":"“呵呵……”"},{"op":"image","layer":1,"image":"i13263"},{"op":"text","speaker":"白羽","text":"“上头了。”"},{"op":"text","speaker":"","text":"白羽又抽了一张折纸。"},{"op":"image","layer":1,"image":"i13284"},{"op":"text","speaker":"白羽","text":"“我还有Super Mustang Fire Cosmic Mode Level VII。”"},{"op":"image","layer":2048,"image":"i18121"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":2304,"image":"i1421"},{"op":"text","speaker":"羽依里","text":"“我还没拿出真本事呢！”"},{"op":"image","layer":2304,"image":"i1422"},{"op":"text","speaker":"","text":"纸飞机大战爆发。"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":2048},{"op":"clear","layer":1792},{"op":"clear","layer":2304},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“这里有墙挡着碍事。”"},{"op":"text","speaker":"羽依里","text":"“出去比。”"},{"op":"image","layer":1,"image":"i13319"},{"op":"text","speaker":"白羽","text":"“求之不得。”"},{"op":"text","speaker":"","text":"带着一触即发的紧张感，我们来到了家外。"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i28"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“我也要来～”"},{"op":"text","speaker":"","text":"来到屋外，羽未也欢喜地跟着出来。"},{"op":"text","speaker":"羽依里","text":"“羽未，要染指纸飞机，想必你也有了相当的觉悟了吧？”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“……唉？”"},{"op":"text","speaker":"羽依里","text":"“在纸飞机的战场上，就算是父母兄弟也绝不留情。”"},{"op":"text","speaker":"羽依里","text":"“我不会手下留情的。”"},{"op":"text","speaker":"羽依里","text":"“输了可别哭哦？”"},{"op":"image","layer":1,"image":"i15436"},{"op":"text","speaker":"羽未","text":"“啊……呜……”"},{"op":"text","speaker":"","text":"然而羽未已然一副欲哭的表情。"},{"op":"image","layer":257,"image":"i13284"},{"op":"text","speaker":"白羽","text":"“你说话能不能有点大人样……”"},{"op":"image","layer":257,"image":"i13392"},{"op":"text","speaker":"白羽","text":"“羽未，别怕，我们一起打败坏飞机。”"},{"op":"image","layer":1,"image":"i15442"},{"op":"text","speaker":"羽未","text":"“嗯…嗯……”"},{"op":"text","speaker":"","text":"是不是吓唬过头了……她回答得还支支吾吾。"},{"op":"image","layer":1,"image":"i15436"},{"op":"text","speaker":"羽未","text":"“那…那个……”"},{"op":"image","layer":1,"image":"i15445"},{"op":"text","speaker":"羽未","text":"“我想……开开心心地玩。”"},{"op":"image","layer":257,"image":"i13405"},{"op":"text","speaker":"白羽","text":"“唉……”"},{"op":"image","layer":1,"image":"i15573"},{"op":"text","speaker":"羽未","text":"“大家一起……”"},{"op":"image","layer":1,"image":"i15569"},{"op":"text","speaker":"羽未","text":"“开心地玩纸飞机。”"},{"op":"image","layer":257,"image":"i13253"},{"op":"text","speaker":"","text":"白羽面露难色地看向我。"},{"op":"text","speaker":"","text":"嗯，也是哦。"},{"op":"text","speaker":"","text":"既然要度过一个开心的暑假，那还是大家都和睦开心的好。"},{"op":"text","speaker":"羽依里","text":"“好，那我们大家一起飞。”"},{"op":"text","speaker":"羽依里","text":"“不比输赢，大家和睦地一起飞。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"image","layer":257,"image":"i13238"},{"op":"text","speaker":"羽未","text":"“嗯。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"回到家后，我们立马折了三只纸飞机。"},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":2304,"image":"i1423"},{"op":"text","speaker":"","text":"虽然颜色不同，但形状都一样。"},{"op":"image","layer":7,"image":"i13258"},{"op":"text","speaker":"白羽","text":"“这飞机叫什么名字？”"},{"op":"text","speaker":"羽依里","text":"“还真没取名呢。”"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":1792},{"op":"clear","layer":2304},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13337"},{"op":"text","speaker":"白羽","text":"“……那可以让我来取名吗？”"},{"op":"text","speaker":"羽依里","text":"“唉……不了吧……”"},{"op":"image","layer":1,"image":"i13296"},{"op":"text","speaker":"白羽","text":"“………”"},{"op":"text","speaker":"","text":"不满地鼓起了脸颊。"},{"op":"text","speaker":"","text":"因为感觉她会取Ultra Hawk Horizon Wing Extra III之类的名字。"},{"op":"text","speaker":"羽依里","text":"“那就当做参考吧，你准备取什么名？”"},{"op":"image","layer":1,"image":"i13267"},{"op":"text","speaker":"白羽","text":"“Ultra Hawk Horizon Wing Extra IV。”"},{"op":"text","speaker":"羽依里","text":"“该死……居然超越了我的预判……”"},{"op":"image","layer":257,"image":"i15511"},{"op":"text","speaker":"羽未","text":"“快放飞吧。”"},{"op":"image","layer":1,"image":"i13238"},{"op":"text","speaker":"羽依里","text":"“嗯，好的，那这是羽未的飞机。”"},{"op":"image","layer":257,"image":"i15593"},{"op":"text","speaker":"羽未","text":"“嗯！”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i28"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"再次来到外面。"},{"op":"text","speaker":"","text":"羽未两眼放光地看着我递给她的飞机，如视珍宝。"},{"op":"image","layer":1,"image":"i13376"},{"op":"text","speaker":"白羽","text":"“羽未来下令吧。”"},{"op":"image","layer":257,"image":"i15511"},{"op":"text","speaker":"羽未","text":"“可以吗？”"},{"op":"text","speaker":"羽依里","text":"“可以啊。”"},{"op":"image","layer":257,"image":"i15552"},{"op":"text","speaker":"羽未","text":"“那就……”"},{"op":"image","layer":257,"image":"i15538"},{"op":"text","speaker":"羽未","text":"“Ultra Pork... Horror Zone... We Execution Four。”"},{"op":"text","speaker":"","text":"我纸飞机的名字好像变得有些可怕了。"},{"op":"image","layer":257,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“发射！”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":2,"image":"i740"},{"op":"image","layer":0,"image":"i513"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"配合羽未的一声号令，纸飞机随之脱手。"},{"op":"text","speaker":"","text":"三只纸飞机并排着飞了出去。"},{"op":"text","speaker":"","text":"机影在阳光下显得光彩夺目。"},{"op":"image","layer":7,"image":"i15324"},{"op":"text","speaker":"羽未","text":"“哇……！”"},{"op":"text","speaker":"","text":"羽未瞪大闪亮的双眼，目光紧跟着无限飞翔的纸飞机。"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":2},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"set","variable":1,"value":0},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i455"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":7,"image":"i11580"},{"op":"text","speaker":"镜子","text":"“咦，羽未在这里睡着了呀。”"},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“就是啊。看着电视不知不觉就睡着了。”"},{"op":"text","speaker":"","text":"白天闹腾得那么欢，看来还是疲惫了。"},{"op":"image","layer":7,"image":"i15346"},{"op":"text","speaker":"羽未","text":"“呼……呼……”"},{"op":"image","layer":1,"image":"i11584"},{"op":"text","speaker":"镜子","text":"“不过，你看她那一脸幸福的表情。”"},{"op":"text","speaker":"羽依里","text":"“是啊。”"},{"op":"text","speaker":"羽依里","text":"“今天似乎玩得很开心。”"},{"op":"image","layer":1,"image":"i11581"},{"op":"text","speaker":"镜子","text":"“你今天陪她玩了一天吧？”"},{"op":"image","layer":1,"image":"i11546"},{"op":"text","speaker":"镜子","text":"“谢谢了。”"},{"op":"text","speaker":"羽依里","text":"“不，不止是我一个人。”"},{"op":"text","speaker":"羽依里","text":"“白羽也……那个，鸣濑小姐也有帮忙。”"},{"op":"text","speaker":"羽依里","text":"“而且，其实我也玩得挺开心的。”"},{"op":"image","layer":1,"image":"i11584"},{"op":"text","speaker":"镜子","text":"“呵呵，那看来挺投缘的嘛。”"},{"op":"text","speaker":"羽依里","text":"“唉？我和白羽吗……？”"},{"op":"image","layer":1,"image":"i11575"},{"op":"text","speaker":"镜子","text":"“是羽未和羽依里哦。”"},{"op":"text","speaker":"羽依里","text":"“啊……哦，是啊。”"},{"op":"image","layer":1,"image":"i11581"},{"op":"text","speaker":"镜子","text":"“不过听你这么一说，白羽妹妹和你似乎也挺投缘的。”"},{"op":"text","speaker":"羽依里","text":"“这可不好说了，虽然我觉得她是个好姑娘。”"},{"op":"text","speaker":"","text":"毕竟都愿意扮演羽未的母亲了。"},{"op":"text","speaker":"","text":"嗯，至始至终也只是扮演羽未的母亲。"},{"op":"image","layer":7,"image":"i15346"},{"op":"text","speaker":"羽未","text":"“呼……呼……”"},{"op":"text","speaker":"羽依里","text":"“不过她睡得还真是香啊。”"},{"op":"image","layer":1,"image":"i11571"},{"op":"text","speaker":"镜子","text":"“不好意思，能麻烦你把她抱去卧室吗？”"},{"op":"text","speaker":"羽依里","text":"“啊，好的。”"},{"op":"text","speaker":"","text":"我轻轻地将羽未用公主抱的方式抱了起来，生怕惊醒了她。"},{"op":"image","layer":7,"image":"i15425"},{"op":"text","speaker":"羽未","text":"“唔……妈妈……唔……”"},{"op":"text","speaker":"","text":"即便在梦里，也依旧在和白羽玩耍吧。"},{"op":"text","speaker":"","text":"羽未睡得一脸幸福。"},{"op":"text","speaker":"","text":"虽然只是一件小事，但是能让羽未体验到一次愉快的暑假，我而跟着高兴了起来。"},{"op":"text","speaker":"","text":"羽未所渴望的，与妈妈度过一个快乐的暑假。"},{"op":"image","layer":1,"image":"i11632"},{"op":"text","speaker":"镜子","text":"“对了，我看见冰箱里有好多西瓜棒，你很喜欢吃吗？”"},{"op":"text","speaker":"羽依里","text":"“不，那只是合约报酬。”"},{"op":"image","layer":1,"image":"i11617"},{"op":"text","speaker":"","text":"稍微被拉回了现实。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]