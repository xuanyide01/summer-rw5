[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i69"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……呼啊～”"},{"op":"text","speaker":"羽依里","text":"“怎么感觉……头好重。”"},{"op":"text","speaker":"","text":"因为睡眠不足吗。"},{"op":"text","speaker":"","text":"……虽然记不得内容了，不过好像是做了个噩梦。"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“早上好。”"},{"op":"image","layer":1,"image":"i11613"},{"op":"text","speaker":"镜子","text":"“早，早上好……”"},{"op":"text","speaker":"羽依里","text":"“……？”"},{"op":"image","layer":1,"image":"i11562"},{"op":"text","speaker":"镜子","text":"“早饭吃了？”"},{"op":"text","speaker":"羽依里","text":"“我正想吃呢。”"},{"op":"image","layer":1,"image":"i11570"},{"op":"text","speaker":"镜子","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“唉？我犯什么事了？”"},{"op":"image","layer":1,"image":"i11562"},{"op":"text","speaker":"镜子","text":"“……嗯。”"},{"op":"text","speaker":"","text":"唉……"},{"op":"text","speaker":"","text":"真有!؟"},{"op":"image","layer":1,"image":"i11604"},{"op":"text","speaker":"镜子","text":"“你夜里大叫。”"},{"op":"text","speaker":"羽依里","text":"“啊……那是因为和她们不知怎的就开始喊起自己的名字了。”"},{"op":"image","layer":1,"image":"i11601"},{"op":"text","speaker":"镜子","text":"“不是这个。你晚上说梦话……说什么奶子。”"},{"op":"text","speaker":"","text":"奶子？"},{"op":"image","layer":1,"image":"i11613"},{"op":"text","speaker":"镜子","text":"“还喊得很痛苦。”"},{"op":"text","speaker":"羽依里","text":"“唉……喊？”"},{"op":"image","layer":1,"image":"i11601"},{"op":"text","speaker":"镜子","text":"“邻居似乎没听到就是了。”"},{"op":"text","speaker":"羽依里","text":"“有这么响？”"},{"op":"text","speaker":"","text":"都怪那枕头。"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i129"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“早……”"},{"op":"image","layer":1,"image":"i14281"},{"op":"image","layer":257,"image":"i13840"},{"op":"text","speaker":"紬","text":"“早上好。”"},{"op":"image","layer":257,"image":"i13843"},{"op":"text","speaker":"静久","text":"“你是不是没什么精神？”"},{"op":"text","speaker":"羽依里","text":"“是啊，有点睡眠不足……”"},{"op":"image","layer":1,"image":"i14216"},{"op":"text","speaker":"紬","text":"“不睡个好觉对健康不好哦？”"},{"op":"image","layer":1,"image":"i14211"},{"op":"text","speaker":"紬","text":"“要睡午觉吗？”"},{"op":"text","speaker":"羽依里","text":"“不了，这才早晨呢。而且我也得帮你找你想做的事。”"},{"op":"image","layer":257,"image":"i13820"},{"op":"text","speaker":"静久","text":"“是啊。”"},{"op":"image","layer":1,"image":"i14311"},{"op":"text","speaker":"紬","text":"“谢谢你们。”"},{"op":"image","layer":1,"image":"i14365"},{"op":"text","speaker":"紬","text":"“那我来帮你精神起来。”"},{"op":"text","speaker":"羽依里","text":"“嗯，交给你了。”"},{"op":"image","layer":1,"image":"i14275"},{"op":"text","speaker":"紬","text":"“加油～”"},{"op":"image","layer":257,"image":"i13811"},{"op":"text","speaker":"静久","text":"“加油♪”"},{"op":"image","layer":1,"image":"i15085"},{"op":"text","speaker":"天善","text":"“加油。”"},{"op":"image","layer":257,"image":"i14272"},{"op":"image","layer":513,"image":"i13775"},{"op":"text","speaker":"紬","text":"“有精神了吗？”"},{"op":"text","speaker":"羽依里","text":"“好像多了什么。”"},{"op":"image","layer":1,"image":"i15038"},{"op":"text","speaker":"天善","text":"“说我吗？”"},{"op":"text","speaker":"羽依里","text":"“你怎么在这？”"},{"op":"image","layer":1,"image":"i15011"},{"op":"text","speaker":"天善","text":"“我是来给你我攒的吕客罐……”"},{"op":"image","layer":1,"image":"i15041"},{"op":"text","speaker":"天善","text":"“和帮忙组装阳台！”"},{"op":"image","layer":1,"image":"i15029"},{"op":"image","layer":257,"image":"i14234"},{"op":"text","speaker":"紬","text":"“多亏了加纳，围栏做好了。”"},{"op":"text","speaker":"羽依里","text":"“为什么从围栏开始做？”"},{"op":"image","layer":1,"image":"i15038"},{"op":"text","speaker":"天善","text":"“安全第一。”"},{"op":"text","speaker":"羽依里","text":"“嗯。也对。”"},{"op":"image","layer":1,"image":"i15014"},{"op":"text","speaker":"天善","text":"“我还有晨练，先回去了。”"},{"op":"image","layer":513,"image":"i13770"},{"op":"text","speaker":"静久","text":"“加纳加油哦。今天谢谢你啦。”"},{"op":"image","layer":1,"image":"i15140"},{"op":"text","speaker":"天善","text":"“小，小事而已！”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"image","layer":1,"image":"i14317"},{"op":"image","layer":257,"image":"i13823"},{"op":"text","speaker":"紬","text":"“今天我们干什么？”"},{"op":"image","layer":257,"image":"i13820"},{"op":"text","speaker":"静久","text":"“昨天我们出了门，那今天做些在灯塔就能做的事怎么样？”"},{"op":"image","layer":1,"image":"i14326"},{"op":"text","speaker":"紬","text":"“可是，能在灯塔做的事情基本上都做过了。”"},{"op":"text","speaker":"羽依里","text":"“毕竟都开始用吕客罐造阳台了呢……”"},{"op":"image","layer":1,"image":"i14257"},{"op":"text","speaker":"静久","text":"“那一直都是你一个人做的吧。”"},{"op":"image","layer":257,"image":"i13810"},{"op":"text","speaker":"静久","text":"“肯定也有些只能我们三人一起才能做的事吧？”"},{"op":"text","speaker":"羽依里","text":"“原来如此……”"},{"op":"image","layer":1,"image":"i14340"},{"op":"text","speaker":"紬","text":"“这是盲点啊。”"},{"op":"image","layer":257,"image":"i13816"},{"op":"text","speaker":"静久","text":"“那我们来一起想想三个人才能做的事情吧？”"},{"op":"image","layer":1,"image":"i14365"},{"op":"text","speaker":"紬","text":"“哦―！”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i130"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":7,"image":"i14335"},{"op":"text","speaker":"紬","text":"“三个人……把灯塔……”"},{"op":"image","layer":7,"image":"i14367"},{"op":"text","speaker":"紬","text":"“……推倒。”"},{"op":"image","layer":7,"image":"i13766"},{"op":"text","speaker":"静久","text":"“需要多叫几个男孩子帮忙呢。”"},{"op":"image","layer":7,"image":"i13806"},{"op":"text","speaker":"静久","text":"“……不知道三谷同学和加纳同学有没有空。”"},{"op":"text","speaker":"羽依里","text":"“空肯定是有的，不过我还有他们俩估计都没有推倒灯塔的想法。”"},{"op":"image","layer":7,"image":"i14335"},{"op":"text","speaker":"紬","text":"“那得怎么办呢……”"},{"op":"text","speaker":"羽依里","text":"“灯塔跟你有仇吗？”"},{"op":"text","speaker":"","text":"想不出什么好主意。"},{"op":"text","speaker":"","text":"连推倒灯塔这种点子都出来了，真是陷入僵局了。"},{"op":"image","layer":0,"image":"i129"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i14270"},{"op":"text","speaker":"紬","text":"“姆叽叽叽叽叽叽～”"},{"op":"text","speaker":"羽依里","text":"“这表情真夸张……”"},{"op":"image","layer":257,"image":"i13764"},{"op":"text","speaker":"静久","text":"“毕竟一直在这大热天里用脑筋嘛……”"},{"op":"image","layer":1,"image":"i14219"},{"op":"text","speaker":"紬","text":"“姆啾～……”"},{"op":"image","layer":257,"image":"i13794"},{"op":"text","speaker":"静久","text":"“对了……我去买点刨冰回来。”"},{"op":"image","layer":257,"image":"i13810"},{"op":"text","speaker":"静久","text":"“有谁想吃～”"},{"op":"image","layer":1,"image":"i14200"},{"op":"text","speaker":"紬","text":"“我！”"},{"op":"text","speaker":"羽依里","text":"“我也想吃，能麻烦你吗？”"},{"op":"image","layer":257,"image":"i13816"},{"op":"text","speaker":"静久","text":"“嗯，交给我吧。”"},{"op":"text","speaker":"","text":"静久咚咚地敲着胸脯。"},{"op":"text","speaker":"","text":"引起波涛阵阵。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"感觉好像快想起我那噩梦了。"},{"op":"image","layer":257,"image":"i13846"},{"op":"text","speaker":"静久","text":"“啊，对了♪”"},{"op":"image","layer":1,"image":"i14281"},{"op":"text","speaker":"紬","text":"“怎么了？”"},{"op":"image","layer":257,"image":"i13823"},{"op":"text","speaker":"静久","text":"“我不在的时候，你们俩做些恋人做的事情怎么样？”"},{"op":"image","layer":1,"image":"i14297"},{"op":"text","speaker":"羽依里","text":"“唉!؟”"},{"op":"image","layer":257,"image":"i13775"},{"op":"text","speaker":"静久","text":"“刚才都被三个人这个条件束缚了思维。”"},{"op":"image","layer":257,"image":"i13810"},{"op":"text","speaker":"静久","text":"“你们开始交往后，都没怎么两人独处过吧♪”"},{"op":"text","speaker":"羽依里","text":"“话是这么说。”"},{"op":"image","layer":1,"image":"i14225"},{"op":"text","speaker":"紬","text":"“……我，我觉得……这个主意不错。”"},{"op":"text","speaker":"","text":"紬这么大胆!؟"},{"op":"image","layer":257,"image":"i13773"},{"op":"text","speaker":"静久","text":"“唉哟♪那我回来的时候慢点吧？”"},{"op":"image","layer":1,"image":"i14206"},{"op":"text","speaker":"紬","text":"“羽依里先生……不愿意吗？”"},{"op":"text","speaker":"羽依里","text":"“怎，怎么可能！”"},{"op":"image","layer":1,"image":"i14231"},{"op":"text","speaker":"紬","text":"“这，这样啊……我很开心。”"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"羽依里","text":"“不过，该做些什么呢？”"},{"op":"image","layer":1,"image":"i14297"},{"op":"text","speaker":"紬","text":"“……该做什么？”"},{"op":"image","layer":1,"image":"i14333"},{"op":"text","speaker":"紬","text":"“姆叽―……？”"},{"op":"image","layer":1,"image":"i14336"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"image","layer":1,"image":"i14333"},{"op":"text","speaker":"紬","text":"“那个……静久。”"},{"op":"image","layer":257,"image":"i13740"},{"op":"text","speaker":"静久","text":"“怎么啦？”"},{"op":"image","layer":1,"image":"i14341"},{"op":"text","speaker":"紬","text":"“我要砂糖刨冰。”"},{"op":"text","speaker":"","text":"她不知什么时候考虑起了刨冰。"},{"op":"text","speaker":"","text":"把我抛在了脑后。"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"静久","text":"“乳依里要炼乳的？”"},{"op":"text","speaker":"羽依里","text":"“我要蓝色夏威夷。”"},{"op":"image","layer":257,"image":"i13740"},{"op":"text","speaker":"静久","text":"“那就是蓝色夏威夷炼乳啦。”"},{"op":"text","speaker":"羽依里","text":"“这组合听上去没什么食欲啊。”"},{"op":"image","layer":7,"image":"i14210"},{"op":"text","speaker":"紬","text":"“走好――”"},{"op":"text","speaker":"","text":"静久离开了。"},{"op":"text","speaker":"","text":"一边小心着库柏韧带，一边慢慢走远了。"},{"op":"image","layer":1,"image":"i14272"},{"op":"text","speaker":"紬","text":"“那我们开始吧？”"},{"op":"text","speaker":"羽依里","text":"“嗯？开始什么？”"},{"op":"image","layer":1,"image":"i14308"},{"op":"text","speaker":"紬","text":"“开始做像恋人做的事。”"},{"op":"text","speaker":"羽依里","text":"“我还以为你的脑子里已经满是刨冰了呢。”"},{"op":"image","layer":1,"image":"i14305"},{"op":"text","speaker":"紬","text":"“不是的。……因为快点想好吃什么味道，就能快点和你独处了。”"},{"op":"image","layer":1,"image":"i14314"},{"op":"text","speaker":"紬","text":"“于是一下子就想好了。”"},{"op":"text","speaker":"羽依里","text":"“是，是这样啊。”"},{"op":"image","layer":1,"image":"i14311"},{"op":"text","speaker":"紬","text":"“……我想要我们俩单独在一起久一点。”"},{"op":"text","speaker":"","text":"唔……怎么感觉，晕乎乎的。"},{"op":"image","layer":1,"image":"i14228"},{"op":"text","speaker":"紬","text":"“那我们开始吧。……做些情侣会做的事。”"},{"op":"text","speaker":"羽依里","text":"“呃，嗯。”"},{"op":"text","speaker":"","text":"情侣会做的事……"},{"op":"text","speaker":"","text":"到底该做些什么？"},{"op":"text","speaker":"","text":"比如牵牵手……又比如亲，亲个嘴……"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"不好，光是想了想就开始恍惚了……"},{"op":"image","layer":7,"image":"i14215"},{"op":"text","speaker":"紬","text":"“羽依里先生？”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"……咦？"},{"op":"text","speaker":"","text":"慢着。"},{"op":"text","speaker":"","text":"这阵恍惚……该不会是生理上的那种？"},{"op":"text","speaker":"","text":"感觉……地面离我越来越近……"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i129"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":7,"image":"i14307"},{"op":"text","speaker":"紬","text":"“羽依里先生！”"},{"op":"text","speaker":"","text":"啊……"},{"op":"text","speaker":"","text":"毕竟天这么热，再加上自己睡眠不足。"},{"op":"clear","layer":2050},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":7,"image":"i14310"},{"op":"text","speaker":"紬","text":"“羽依里先生！羽依里先生！”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"脸上吹来一阵风。"},{"op":"text","speaker":"","text":"还有什么软软的枕在我的脑后。"},{"op":"text","speaker":"","text":"似乎是水滴的液体一滴滴地落在我的脸上。"},{"op":"text","speaker":"","text":"这……是？"},{"op":"image","layer":0,"image":"i1320"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":2050},{"op":"text","speaker":"羽依里","text":"“……唔唔……嗯？”"},{"op":"image","layer":0,"image":"i1321"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“羽依里先生……你醒了吗？”"},{"op":"text","speaker":"羽依里","text":"“唔……紬……？”"},{"op":"image","layer":0,"image":"i1322"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“啊，可能先不要起来比较好。”"},{"op":"text","speaker":"羽依里","text":"“呃，好……”"},{"op":"text","speaker":"羽依里","text":"“嗯……这是。”"},{"op":"image","layer":0,"image":"i1321"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“呼……太好了。”"},{"op":"text","speaker":"羽依里","text":"“呃……什么情况？”"},{"op":"text","speaker":"紬","text":"“因为你突然倒下了，所以我想让你好好休息一下。”"},{"op":"text","speaker":"","text":"嗯。"},{"op":"text","speaker":"","text":"我勉强还记得自己倒下。"},{"op":"text","speaker":"","text":"不对。"},{"op":"text","speaker":"","text":"……膝枕。"},{"op":"text","speaker":"羽依里","text":"“谢，谢谢你。”"},{"op":"text","speaker":"紬","text":"“没什么。”"},{"op":"text","speaker":"羽依里","text":"“我马上就起来。”"},{"op":"image","layer":0,"image":"i1323"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“羽依里先生，要好好休息才行哦。”"},{"op":"text","speaker":"羽依里","text":"“呃……可是……”"},{"op":"text","speaker":"紬","text":"“……我好担心。”"},{"op":"text","speaker":"羽依里","text":"“嗯……抱歉。”"},{"op":"text","speaker":"紬","text":"“……你起来我会很担心。所以请继续保持这样一会儿。”"},{"op":"text","speaker":"羽依里","text":"“听你这么说，我都不知道说什么了。”"},{"op":"text","speaker":"紬","text":"“不用说什么。请好好休息吧。”"},{"op":"text","speaker":"羽依里","text":"“……是。”"},{"op":"text","speaker":"","text":"……"},{"op":"image","layer":0,"image":"i1325"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“那啥……让我用你的膝枕真的好吗？”"},{"op":"text","speaker":"紬","text":"“羽依里先生……我们可是恋人。这种小事根本没什么。”"},{"op":"text","speaker":"羽依里","text":"“这样啊。”"},{"op":"text","speaker":"紬","text":"“……其实我的心脏正在扑通扑通响。”"},{"op":"text","speaker":"羽依里","text":"“啊哈哈。”"},{"op":"image","layer":0,"image":"i1326"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“你为什么笑呀？”"},{"op":"text","speaker":"羽依里","text":"“因为咱们贴这么紧，这声音我都听到啦。”"},{"op":"image","layer":0,"image":"i1324"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“真的吗？”"},{"op":"image","layer":0,"image":"i1325"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“……不过，和你在一起时我一直都是扑通扑通的，结果现在才察觉到这点。”"},{"op":"text","speaker":"羽依里","text":"“嗯，我也是。”"},{"op":"text","speaker":"","text":"接着，我们相互无言。"},{"op":"text","speaker":"","text":"我望着在紬在风中摇曳的头发……与天空中飘着的云。"},{"op":"image","layer":0,"image":"i1323"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“～～～♪”"},{"op":"text","speaker":"","text":"云……还有时间……缓缓流动着……"},{"op":"text","speaker":"羽依里","text":"“……紬，夏天结束后你就要回去了吧。”"},{"op":"image","layer":0,"image":"i1325"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“是的。”"},{"op":"text","speaker":"羽依里","text":"“……我会寂寞的。”"},{"op":"text","speaker":"紬","text":"“是吗。”"},{"op":"text","speaker":"紬","text":"“夏天结束后，你也要回去吧？”"},{"op":"text","speaker":"羽依里","text":"“是啊。”"},{"op":"image","layer":0,"image":"i1323"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“我会很寂寞。”"},{"op":"text","speaker":"羽依里","text":"“是吗。”"},{"op":"text","speaker":"","text":"再也无法和恋人见面，实在是让人寂寞。"},{"op":"text","speaker":"","text":"当然了，我们三人不能再相见，也很寂寞。"},{"op":"text","speaker":"","text":"可是，想到今后再也没有人会来这个我们曾一起玩耍过的地方……"},{"op":"text","speaker":"","text":"就感觉。"},{"op":"text","speaker":"","text":"……悲从中来……"},{"op":"text","speaker":"羽依里","text":"“本觉得暑假的时间无穷无尽……可终究会结束啊。”"},{"op":"image","layer":0,"image":"i1325"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“是啊。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“今天还有不少时间，再多做做各种事吧？”"},{"op":"text","speaker":"紬","text":"“哦～好主意～”"},{"op":"text","speaker":"紬","text":"“不过……我也很喜欢和你一起这样度过的时间。”"},{"op":"text","speaker":"羽依里","text":"“……我也是。”"},{"op":"text","speaker":"紬","text":"“哈哈，那我们一样呢。”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"在这个距离下，根本遮不住脸。"},{"op":"text","speaker":"","text":"我害羞的神情会被一览无余。"},{"op":"text","speaker":"紬","text":"“告别那天，我可能会哭。”"},{"op":"text","speaker":"","text":"我说不定也会。"},{"op":"text","speaker":"羽依里","text":"“说起来。紬，你刚才该不会哭了？”"},{"op":"image","layer":0,"image":"i1326"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“姆啾？”"},{"op":"text","speaker":"羽依里","text":"“有水珠掉在我的脸上。”"},{"op":"image","layer":0,"image":"i1327"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“……没哭呀。”"},{"op":"text","speaker":"羽依里","text":"“真的？”"},{"op":"image","layer":0,"image":"i1324"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“真的。”"},{"op":"text","speaker":"羽依里","text":"“可这附近……有水。”"},{"op":"text","speaker":"","text":"我摸了摸水滴落的位置。"},{"op":"text","speaker":"羽依里","text":"“……？”"},{"op":"text","speaker":"羽依里","text":"“感觉黏糊糊的。”"},{"op":"image","layer":0,"image":"i1327"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“姆啾……”"},{"op":"text","speaker":"羽依里","text":"“……紬。”"},{"op":"text","speaker":"羽依里","text":"“别在别人脸上吃刨冰。”"},{"op":"text","speaker":"羽依里","text":"“会滴下来的。”"},{"op":"text","speaker":"紬","text":"“……因为快融化了，所以就吃了。”"},{"op":"text","speaker":"","text":"她一副不好意思的表情。"},{"op":"text","speaker":"羽依里","text":"“那作为惩罚……”"},{"op":"text","speaker":"羽依里","text":"“啊～……”"},{"op":"image","layer":0,"image":"i1326"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“啊～？”"},{"op":"text","speaker":"羽依里","text":"“我们是要做像恋人的事吧……”"},{"op":"text","speaker":"羽依里","text":"“我也想吃刨冰。”"},{"op":"image","layer":0,"image":"i1328"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“原来如此……我，我懂了。”"},{"op":"image","layer":0,"image":"i1329"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“啊～”"},{"op":"text","speaker":"羽依里","text":"“嗯姆……”"},{"op":"text","speaker":"","text":"……躺着吃有些不方便。"},{"op":"text","speaker":"","text":"可是……"},{"op":"text","speaker":"","text":"非常幸福。"},{"op":"text","speaker":"羽依里","text":"“真好吃。”"},{"op":"image","layer":0,"image":"i1330"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“哈哈，谢谢。”"},{"op":"text","speaker":"羽依里","text":"“再来一口。”"},{"op":"image","layer":0,"image":"i1329"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“好。来，啊～”"},{"op":"text","speaker":"羽依里","text":"“啊～”"},{"op":"text","speaker":"","text":"好甜。"},{"op":"image","layer":0,"image":"i1331"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"甜的不仅是刨冰，也是这个气氛。"},{"op":"text","speaker":"","text":"……刨冰？"},{"op":"image","layer":0,"image":"i1330"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“要把刨冰吃完吗？”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"等一下，有了刨冰就意味着……"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i129"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13820"},{"op":"text","speaker":"静久","text":"“……哈哈♪”"},{"op":"text","speaker":"","text":"去买刨冰的静久……已经回来了。"},{"op":"text","speaker":"羽依里","text":"“……欢迎…回来。”"},{"op":"image","layer":1,"image":"i13846"},{"op":"text","speaker":"静久","text":"“我回来啦♪”"},{"op":"text","speaker":"羽依里","text":"“呃……都…看到了？”"},{"op":"image","layer":1,"image":"i13832"},{"op":"text","speaker":"静久","text":"“你还是先擦擦脸吧？”"},{"op":"text","speaker":"羽依里","text":"“啊，嗯。”"},{"op":"text","speaker":"","text":"好……好难为情！"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i133"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“那就明天见。”"},{"op":"image","layer":1,"image":"i14237"},{"op":"text","speaker":"紬","text":"“再见～”"},{"op":"image","layer":257,"image":"i13816"},{"op":"text","speaker":"静久","text":"“路上小心哦。”"},{"op":"text","speaker":"羽依里","text":"“咦？静久你不回去吗？”"},{"op":"image","layer":1,"image":"i14234"},{"op":"text","speaker":"紬","text":"“嗯，她好像要住下来。”"},{"op":"text","speaker":"羽依里","text":"“啊？怎么就我被排除在外了。”"},{"op":"image","layer":257,"image":"i13813"},{"op":"text","speaker":"静久","text":"“羽依里永远在我们的心中陪伴着我们哦。”"},{"op":"text","speaker":"羽依里","text":"“话说的倒挺不错，可我到底还是被排除在外了。”"},{"op":"image","layer":1,"image":"i14219"},{"op":"text","speaker":"紬","text":"“羽依里先生……其实我也想和你一起玩。”"},{"op":"image","layer":1,"image":"i14206"},{"op":"text","speaker":"紬","text":"“不过现在还是请回去静养吧。我好担心你。”"},{"op":"text","speaker":"羽依里","text":"“……是。”"},{"op":"image","layer":257,"image":"i13816"},{"op":"text","speaker":"静久","text":"“不管是明天还是后天，我都会陪着你的……所以今天你就回去吧。”"},{"op":"text","speaker":"羽依里","text":"“嗯。那明天见。”"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]