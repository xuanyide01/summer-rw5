[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"text","speaker":"羽依里","text":"“唔……”"},{"op":"image","layer":0,"image":"i69"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“什么情况。”"},{"op":"text","speaker":"","text":"不知何来的压迫感带来的窒息感使我睁开双眼。"},{"op":"text","speaker":"","text":"好，好难受。"},{"op":"text","speaker":"羽依里","text":"“好重！”"},{"op":"text","speaker":"","text":"感觉胸口好像被压碎了。"},{"op":"image","layer":0,"image":"i257"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i10933"},{"op":"text","speaker":"鸥","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“嘿。”"},{"op":"image","layer":1,"image":"i10936"},{"op":"text","speaker":"鸥","text":"“ZZZZZZ”"},{"op":"text","speaker":"羽依里","text":"“!؟”"},{"op":"text","speaker":"","text":"压在别人身上，睡得非常安详。"},{"op":"text","speaker":"","text":"怎，怎么办……"},{"op":"text","speaker":"","text":"犹豫着要不要把她推开，我僵硬住了。"},{"op":"text","speaker":"羽依里","text":"“喂，喂。”"},{"op":"text","speaker":"鸥","text":"“ZZZZZZ”"},{"op":"text","speaker":"羽依里","text":"“喂！”"},{"op":"image","layer":1,"image":"i10939"},{"op":"text","speaker":"鸥","text":"“唉。”"},{"op":"text","speaker":"","text":"她迷糊地睁开了眼。"},{"op":"image","layer":1,"image":"i10938"},{"op":"text","speaker":"鸥","text":"“……”"},{"op":"text","speaker":"","text":"接着看着眼前的我……"},{"op":"image","layer":1,"image":"i10914"},{"op":"text","speaker":"鸥","text":"“救命呀！”"},{"op":"image","layer":1,"image":"i10919"},{"op":"text","speaker":"鸥","text":"“我被吃豆腐了！”"},{"op":"text","speaker":"","text":"手脚乱挥。"},{"op":"text","speaker":"羽依里","text":"“唔。”"},{"op":"text","speaker":"羽依里","text":"“赶紧让开。是你自己压上来的吧。”"},{"op":"image","layer":1,"image":"i10923"},{"op":"text","speaker":"鸥","text":"“哎呀。”"},{"op":"image","layer":1,"image":"i10948"},{"op":"text","speaker":"鸥","text":"“非常抱歉。”"},{"op":"text","speaker":"羽依里","text":"“什么非常抱歉哦。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"if","truth":false,"target":49,"value":["==",["v",6003],1]},{"op":"callScene","scene":158,"target":2},{"op":"goto","target":96},{"op":"if","truth":false,"target":52,"value":["==",["v",6003],2]},{"op":"callScene","scene":157,"target":2},{"op":"goto","target":96},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"吃过早饭后，我们开始做出发的准备。"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“好多行李啊。”"},{"op":"text","speaker":"","text":"一边看着的羽未眼睛睁得大大的。"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“今天是要出门吗。”"},{"op":"text","speaker":"羽依里","text":"“去山里。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“去个山里，为什么会有这么大的行李啊。”"},{"op":"image","layer":257,"image":"i10972"},{"op":"text","speaker":"鸥","text":"“说不定会露宿一宿。”"},{"op":"image","layer":257,"image":"i10975"},{"op":"text","speaker":"鸥","text":"“里面装了帐篷。”"},{"op":"image","layer":1,"image":"i15496"},{"op":"text","speaker":"羽未","text":"“哈。”"},{"op":"image","layer":1,"image":"i15482"},{"op":"text","speaker":"羽未","text":"“你们两个人去露营吗。”"},{"op":"text","speaker":"","text":"羽未看着我们的行李，陷入了沉思。"},{"op":"text","speaker":"羽依里","text":"“羽未也要一起去吗？”"},{"op":"image","layer":257,"image":"i11064"},{"op":"text","speaker":"鸥","text":"“来吧。”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“不，我不去。”"},{"op":"image","layer":513,"image":"i11488"},{"op":"text","speaker":"镜子","text":"“手臂没事了？”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"image","layer":513,"image":"i11490"},{"op":"text","speaker":"镜子","text":"“不要再做危险的事情了哦。”"},{"op":"text","speaker":"羽依里","text":"“没关系的。”"},{"op":"image","layer":513,"image":"i11486"},{"op":"text","speaker":"镜子","text":"“还有，采石场旧址是不允许进入的哦。”"},{"op":"text","speaker":"羽依里","text":"“唉。”"},{"op":"text","speaker":"羽依里","text":"“知，知道的啦。之前也说过了。”"},{"op":"image","layer":513,"image":"i11464"},{"op":"text","speaker":"镜子","text":"“我和美希打过招呼了。”"},{"op":"text","speaker":"羽依里","text":"“看来是这样了。”"},{"op":"image","layer":513,"image":"i11490"},{"op":"text","speaker":"镜子","text":"“因为你看起来很感兴趣的样子。”"},{"op":"image","layer":513,"image":"i11493"},{"op":"text","speaker":"镜子","text":"“我告诉她，如果你要进入禁止进入的地方，不要客气。”"},{"op":"text","speaker":"羽依里","text":"“我，我不会的……”"},{"op":"text","speaker":"","text":"看来要做好思想准备了啊。"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i158"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":7,"image":"i11315"},{"op":"text","speaker":"鸥","text":"“报数！”"},{"op":"image","layer":7,"image":"i11315"},{"op":"text","speaker":"鸥","text":"“鹰原羽依里。”"},{"op":"text","speaker":"羽依里","text":"“到！”"},{"op":"image","layer":7,"image":"i11318"},{"op":"text","speaker":"鸥","text":"“报数完毕。”"},{"op":"text","speaker":"羽依里","text":"“哦～……”"},{"op":"image","layer":7,"image":"i11285"},{"op":"text","speaker":"鸥","text":"“那么，出发！”"},{"op":"text","speaker":"羽依里","text":"“哦～”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i432"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"今天也是个晴朗的夏天。"},{"op":"text","speaker":"","text":"而鸥的兴致似乎也是绝佳。"},{"op":"image","layer":7,"image":"i11310"},{"op":"text","speaker":"鸥","text":"“～～～♪”"},{"op":"text","speaker":"","text":"边哼着歌边走着路，但……"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i435"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":7,"image":"i11306"},{"op":"text","speaker":"鸥","text":"“……”"},{"op":"text","speaker":"","text":"这样并肩走就再次感觉到，这家伙速度好慢啊。"},{"op":"text","speaker":"","text":"配合着鸥嘎啦嘎啦拖着行李箱的步伐，前进速度相当迟缓。"},{"op":"text","speaker":"","text":"虽然她本人好像完全不在意的样子。"},{"op":"text","speaker":"","text":"因为我也背着行李，也走不了太快。"},{"op":"text","speaker":"","text":"好了，慢慢走吧。"},{"op":"image","layer":0,"image":"i37"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“STOP。快看。”"},{"op":"text","speaker":"","text":"指着头顶上方。"},{"op":"image","layer":0,"image":"i158"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":772,"image":"i184"},{"op":"image","layer":1028,"image":"i11761"},{"op":"image","layer":1284,"image":"i25242"},{"op":"image","layer":1540,"image":"i25242"},{"op":"image","layer":7,"image":"i11332"},{"op":"text","speaker":"鸥","text":"“那里的是野美希吧。”"},{"op":"text","speaker":"","text":"她今天也在铁塔上严阵以待。"},{"op":"text","speaker":"","text":"是我的错觉吗，总觉得她的双筒镜看向了我们这边。"},{"op":"clear","layer":772},{"op":"clear","layer":1028},{"op":"clear","layer":1284},{"op":"clear","layer":1540},{"op":"clear","layer":1791},{"op":"clear","layer":1279},{"op":"clear","layer":1023},{"op":"image","layer":0,"image":"i37"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11333"},{"op":"text","speaker":"羽依里","text":"“笔直朝采石场前进的话会被狙击吧。”"},{"op":"image","layer":1,"image":"i11259"},{"op":"text","speaker":"鸥","text":"“那我们闪电型前进？”"},{"op":"text","speaker":"羽依里","text":"“没错，闪电型……”"},{"op":"text","speaker":"羽依里","text":"“不不。不是这个问题。”"},{"op":"text","speaker":"羽依里","text":"“我们必须选一条不会被野美希发现的路线。”"},{"op":"text","speaker":"羽依里","text":"“关于路线，我昨天和良一讨论好了。”"},{"op":"text","speaker":"羽依里","text":"“已经在地图上标出。”"},{"op":"image","layer":1,"image":"i11261"},{"op":"text","speaker":"鸥","text":"“哦哦。”"},{"op":"image","layer":1,"image":"i11286"},{"op":"text","speaker":"鸥","text":"“像谍战一样，好有趣。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i25654"},{"op":"image","layer":7,"image":"i11335"},{"op":"text","speaker":"鸥","text":"“是要根据标出的路线走吧。”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"image","layer":7,"image":"i11306"},{"op":"text","speaker":"鸥","text":"“穿过竹本家的院子。”"},{"op":"image","layer":7,"image":"i11239"},{"op":"text","speaker":"鸥","text":"“通过干货店的后方。”"},{"op":"image","layer":7,"image":"i11242"},{"op":"text","speaker":"鸥","text":"“再借道富士见家的屋子。”"},{"op":"image","layer":7,"image":"i11260"},{"op":"text","speaker":"鸥","text":"“请问，可以吗。”"},{"op":"text","speaker":"家庭主妇C","text":"“嗯，三谷家的良一有时会走这里哦。”"},{"op":"text","speaker":"家庭主妇C","text":"“请吧请吧。”"},{"op":"image","layer":7,"image":"i11306"},{"op":"text","speaker":"鸥","text":"“穿过神社的后方。”"},{"op":"image","layer":7,"image":"i11335"},{"op":"text","speaker":"鸥","text":"“接下来，要借道饭野家的屋子。”"},{"op":"image","layer":7,"image":"i11306"},{"op":"text","speaker":"鸥","text":"“能不能打扰一下？”"},{"op":"text","speaker":"蓄着胡须的老爷爷","text":"“嗯，好久不见了呢。”"},{"op":"text","speaker":"蓄着胡须的老爷爷","text":"“良一也长大了啊。”"},{"op":"text","speaker":"羽依里","text":"“我不是良一。”"},{"op":"text","speaker":"蓄着胡须的老爷爷","text":"“还带了个这么漂亮的女朋友。”"},{"op":"text","speaker":"羽依里","text":"“这不是女朋友。”"},{"op":"image","layer":7,"image":"i11350"},{"op":"text","speaker":"鸥","text":"“唉嘿嘿。他夸我漂亮。”"},{"op":"set","variable":1,"value":0},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i158"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"羽依里","text":"“很好，到了哦。爬上这里，似乎就到采石场了。”"},{"op":"image","layer":7,"image":"i11242"},{"op":"text","speaker":"鸥","text":"“太好了。通过第一关了。”"},{"op":"text","speaker":"","text":"沿着良一告诉我的神秘路线，到达了我们目的地那座山的山脚下。"},{"op":"text","speaker":"","text":"虽然有些陡峭，但只要爬上这个斜坡就能到达了。"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i44"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"我们进入了植物茂盛的山里。"},{"op":"text","speaker":"","text":"曾经似乎是个繁盛的采石场。"},{"op":"text","speaker":"","text":"但是，后来过度挖掘导致了山崩。"},{"op":"text","speaker":"","text":"之后，采石场好像就被封闭，不让任何人靠近了。"},{"op":"text","speaker":"","text":"也许是人烟罕至的原因，这座山的气氛和岛上别的山不同。"},{"op":"image","layer":1,"image":"i11342"},{"op":"text","speaker":"鸥","text":"“稍微休息一下吧。”"},{"op":"text","speaker":"羽依里","text":"“是啊。”"},{"op":"text","speaker":"","text":"我们坐在树荫下。"},{"op":"text","speaker":"","text":"……喝了些装在保温瓶里的麦茶。"},{"op":"text","speaker":"羽依里","text":"“哈。”"},{"op":"text","speaker":"羽依里","text":"“真的是夏天了。”"},{"op":"text","speaker":"","text":"我说着理所当然的废话。"},{"op":"image","layer":1,"image":"i11291"},{"op":"text","speaker":"鸥","text":"“快看。”"},{"op":"text","speaker":"羽依里","text":"“那个是。”"},{"op":"text","speaker":"","text":"隐约地……"},{"op":"text","speaker":"","text":"虽然被草覆盖，还是能够发现道路的另一头有轨道。"},{"op":"text","speaker":"","text":"已经荒废的轨道，静静地通往森林深处。"},{"op":"image","layer":1,"image":"i11301"},{"op":"text","speaker":"鸥","text":"“这里就是起点了吧。”"},{"op":"text","speaker":"羽依里","text":"“看来是了。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":1,"value":0},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i1253"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我们沿着废弃铁轨前进。"},{"op":"text","speaker":"","text":"南面的山上确实有一座小矿山，因此建造的矿车轨道至今依然残存着。"},{"op":"text","speaker":"","text":"当然现在已经没有人用了。"},{"op":"text","speaker":"","text":"沿着轨道前进，至少不会迷路。"},{"op":"text","speaker":"","text":"的确在没有成年人的陪同下进去深山，沿着轨道走是最安全的方法了。"},{"op":"text","speaker":"","text":"而且沿着轨道走的话，途中就会路过洞窟的入口。"},{"op":"text","speaker":"","text":"那个洞窟似乎是天然的钟乳洞，像迷宫一般错综复杂，好像能通往海湾。"},{"op":"text","speaker":"","text":"根据鸥所说，就是在那海湾发现海盗船的。"},{"op":"text","speaker":"","text":"是不是真的啊。"},{"op":"text","speaker":"","text":"海盗船。"},{"op":"image","layer":0,"image":"i1254"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“～～～♪”"},{"op":"text","speaker":"","text":"在思前顾后的我身边，鸥的心情超好。"},{"op":"text","speaker":"羽依里","text":"“这首是什么歌，之前也听你哼过。”"},{"op":"image","layer":0,"image":"i1252"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“米迪安·夏洛特的《with》。曾经很流行哦。”"},{"op":"text","speaker":"羽依里","text":"“哦哦。”"},{"op":"image","layer":0,"image":"i1254"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“～～～♪”"},{"op":"image","layer":0,"image":"i1252"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“你经常听歌吗？”"},{"op":"text","speaker":"鸥","text":"“经常哦。小时候开始就一直听。”"},{"op":"text","speaker":"羽依里","text":"“什么类型的。”"},{"op":"text","speaker":"鸥","text":"“电影的主题曲之类的。”"},{"op":"text","speaker":"羽依里","text":"“你喜欢电影吗。”"},{"op":"text","speaker":"鸥","text":"“不管是看书，还是电影我都很喜欢。”"},{"op":"text","speaker":"羽依里","text":"“喜欢看什么类型的。”"},{"op":"text","speaker":"鸥","text":"“探险故事。”"},{"op":"text","speaker":"羽依里","text":"“嗯―？”"},{"op":"text","speaker":"","text":"…………"},{"op":"image","layer":2,"image":"i740"},{"op":"image","layer":0,"image":"i513"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"虽然日照依旧强烈，但偶尔会有风像是要超越我们一样从身后吹来。"},{"op":"text","speaker":"","text":"我们像是被风推着一般，缓缓前行。"},{"op":"text","speaker":"","text":"鸥拖着她的行李箱。"},{"op":"text","speaker":"","text":"我背着我大大的登山包。"},{"op":"text","speaker":"","text":"慢吞吞地前行着。"},{"op":"text","speaker":"","text":"按照这速度，不一会儿天就像要黑了。"},{"op":"clear","layer":2},{"op":"image","layer":0,"image":"i1255"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“对不起哦。”"},{"op":"text","speaker":"羽依里","text":"“唉。”"},{"op":"text","speaker":"鸥","text":"“我走路这么慢。”"},{"op":"text","speaker":"羽依里","text":"“没事。”"},{"op":"text","speaker":"羽依里","text":"“这也没办法。”"},{"op":"text","speaker":"羽依里","text":"“轨道上面，行李箱不好拖吧。”"},{"op":"image","layer":0,"image":"i1256"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“不见得哦。”"},{"op":"text","speaker":"","text":"她得意地笑了。"},{"op":"text","speaker":"鸥","text":"“我在出门前，已经调成登山模式了。”"},{"op":"text","speaker":"羽依里","text":"“什么叫登山模式啊。”"},{"op":"text","speaker":"鸥","text":"“把轮子改为定制款。”"},{"op":"text","speaker":"羽依里","text":"“是，是吗。”"},{"op":"text","speaker":"","text":"登山模式啊……"},{"op":"text","speaker":"","text":"不是，即使那么说……"},{"op":"text","speaker":"羽依里","text":"“我来拿好了。”"},{"op":"image","layer":0,"image":"i1252"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“不用了。没关系的。”"},{"op":"text","speaker":"鸥","text":"“我会努力的。”"},{"op":"text","speaker":"羽依里","text":"“是吗。”"},{"op":"image","layer":0,"image":"i1254"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"鸥","text":"“以前也是。”"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"image","layer":0,"image":"i1255"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“我记得，以前也给大家添麻烦了。”"},{"op":"text","speaker":"鸥","text":"“只有我走得特别慢。”"},{"op":"text","speaker":"羽依里","text":"“是吗。”"},{"op":"text","speaker":"羽依里","text":"“不过别在意。”"},{"op":"text","speaker":"鸥","text":"“唉？”"},{"op":"text","speaker":"羽依里","text":"“我们只是在追寻你的回忆而已。”"},{"op":"text","speaker":"羽依里","text":"“慢慢地，一边回忆各种各样的事情一边前进不也很好吗。”"},{"op":"text","speaker":"鸥","text":"“……羽依里。”"},{"op":"image","layer":0,"image":"i1256"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“好孩子。”"},{"op":"text","speaker":"羽依里","text":"“什、什么啊。”"},{"op":"text","speaker":"鸥","text":"“不用害羞啦。”"},{"op":"text","speaker":"鸥","text":"“羽依里is好孩子。”"},{"op":"text","speaker":"羽依里","text":"“你好烦啊。”"},{"op":"text","speaker":"羽依里","text":"“咦。”"},{"op":"text","speaker":"","text":"我停下了脚步。"},{"op":"text","speaker":"","text":"感觉到了一丝不协调感。"},{"op":"image","layer":0,"image":"i1252"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“怎么了？”"},{"op":"text","speaker":"羽依里","text":"“不……总觉得……”"},{"op":"text","speaker":"羽依里","text":"“之前好像走过这里……”"},{"op":"text","speaker":"","text":"不会错的。"},{"op":"text","speaker":"羽依里","text":"“我们一直在原地转圈。”"},{"op":"text","speaker":"","text":"废弃的轨道呈一个巨大的圆形，我们只是沿着它转了两圈左右。"},{"op":"image","layer":0,"image":"i1255"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“确，确实啊。经你这么一说。”"},{"op":"text","speaker":"","text":"毕竟是运输用的轨道。也不可能是直线吧。"},{"op":"text","speaker":"鸥","text":"“没有看到入口呢。”"},{"op":"text","speaker":"羽依里","text":"“果然，现在已经被封起来了吧。”"},{"op":"text","speaker":"羽依里","text":"“回去吧。”"},{"op":"text","speaker":"鸥","text":"“哎。”"},{"op":"text","speaker":"鸥","text":"“对，对了。还有没解读完的笔记呢。”"},{"op":"text","speaker":"羽依里","text":"“‘在下午茶的时间前进’这句吗。”"},{"op":"text","speaker":"鸥","text":"“马上就要下午三点了，先等到那时候吧。”"},{"op":"text","speaker":"羽依里","text":"“下午三点会发生什么啊？”"},{"op":"text","speaker":"羽依里","text":"“会突然冒出一条道路吗？”"},{"op":"text","speaker":"","text":"怎么可能啊。"},{"op":"text","speaker":"鸥","text":"“说不定会哦。”"},{"op":"text","speaker":"羽依里","text":"“总之……不抱期待地等等吧。”"},{"op":"text","speaker":"","text":"都来到这里了。就这么回去，也挺可惜的。"},{"op":"image","layer":0,"image":"i1256"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“嗯！”"},{"op":"image","layer":0,"image":"i158"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我们坐在树荫下。"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"羽依里","text":"“好热啊。”"},{"op":"image","layer":7,"image":"i11322"},{"op":"text","speaker":"鸥","text":"“很热呢。”"},{"op":"text","speaker":"","text":"距离下午三点还有一段时间。"},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"text","speaker":"","text":"……30分钟后。"},{"op":"text","speaker":"","text":"已经是下午三点了。"},{"op":"text","speaker":"","text":"理所当然的，什么事都没有发生。"},{"op":"text","speaker":"羽依里","text":"“总之再转一圈看看吧。”"},{"op":"image","layer":7,"image":"i11239"},{"op":"text","speaker":"鸥","text":"“嗯。”"},{"op":"text","speaker":"","text":"……于是。"},{"op":"text","speaker":"","text":"又转了一圈，依旧什么都没有发现。"},{"op":"text","speaker":"","text":"这么一来就结束了吧。"},{"op":"text","speaker":"","text":"结论――什么都没有。"},{"op":"text","speaker":"","text":"说不定，以前确实有通往入口的道路。"},{"op":"text","speaker":"","text":"可是经过时间的推移，道路和入口被堵上了……之类的。"},{"op":"text","speaker":"","text":"虽说有些扫兴，但也许探险的结果大多都是这样的吧。"},{"op":"text","speaker":"羽依里","text":"“回去吧。”"},{"op":"image","layer":7,"image":"i11328"},{"op":"text","speaker":"鸥","text":"“……”"},{"op":"image","layer":7,"image":"i11330"},{"op":"text","speaker":"鸥","text":"“嗯……”"},{"op":"text","speaker":"","text":"理所当然地，有些依依不舍。"},{"op":"text","speaker":"","text":"我们也不能一直这么待下去。"},{"op":"text","speaker":"","text":"已经等到了下午三点，却还是什么都没发生。"},{"op":"text","speaker":"","text":"太阳也已经向着西方倾斜……"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"等一下。"},{"op":"text","speaker":"","text":"下午三点，前进……"},{"op":"text","speaker":"","text":"这也就是说……"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"圆形的轨道……下午三点。"},{"op":"text","speaker":"","text":"难不成。"},{"op":"image","layer":7,"image":"i11258"},{"op":"text","speaker":"鸥","text":"“？怎么了。”"},{"op":"text","speaker":"","text":"我拿起地图，和周围景色进行对比。"},{"op":"text","speaker":"羽依里","text":"“假设这里是西边。”"},{"op":"text","speaker":"羽依里","text":"“正东在……”"},{"op":"image","layer":7,"image":"i11239"},{"op":"text","speaker":"鸥","text":"“有指南针哦。”"},{"op":"text","speaker":"羽依里","text":"“啊，对哦。”"},{"op":"text","speaker":"","text":"因为指南针在日常生活中不怎么用得到，一不小心就把它忘了。"},{"op":"text","speaker":"羽依里","text":"“东边在……”"},{"op":"text","speaker":"羽依里","text":"“这边吗。去看看吧。”"},{"op":"image","layer":7,"image":"i11258"},{"op":"text","speaker":"鸥","text":"“这边只有密林而已哦？”"},{"op":"text","speaker":"羽依里","text":"“来就是了。”"},{"op":"image","layer":7,"image":"i11248"},{"op":"text","speaker":"鸥","text":"“好、好的。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i44"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"怎么回事呢。"},{"op":"text","speaker":"","text":"虽然只是我的直觉。"},{"op":"text","speaker":"","text":"但是我敢确定，自己的直觉没错。"},{"op":"text","speaker":"","text":"朝这里走……一定可以……"},{"op":"text","speaker":"","text":"走过一段草木丛生的路……"},{"op":"text","speaker":"羽依里","text":"“――啊。”"},{"op":"image","layer":1,"image":"i11295"},{"op":"text","speaker":"鸥","text":"“找到了！”"},{"op":"text","speaker":"","text":"拨开树丛走了一会，延伸的轨道再次映入眼帘。"},{"op":"image","layer":1,"image":"i11301"},{"op":"text","speaker":"鸥","text":"“为什么会在这里。”"},{"op":"text","speaker":"羽依里","text":"“谁知道了啊。”"},{"op":"text","speaker":"羽依里","text":"“可能是时间过去久了，被草木给遮挡住了。”"},{"op":"text","speaker":"","text":"又或者是被谁给人为地阻断了。"},{"op":"text","speaker":"","text":"我感觉后者的可能性比较高。"},{"op":"text","speaker":"","text":"因为轨道剩得不完整，所以即使孩子们饶有兴趣地来了，也只要沿着轨道绕几圈就会放弃回家去了。"},{"op":"text","speaker":"","text":"也算是某种陷阱吧。"},{"op":"image","layer":1,"image":"i11261"},{"op":"text","speaker":"羽依里·鸥","text":"“……”"},{"op":"text","speaker":"","text":"我望着延伸在平缓坡道上的轨道。"},{"op":"image","layer":1,"image":"i11240"},{"op":"text","speaker":"鸥","text":"“这条铁道的尽头，会不会有洞窟呢。”"},{"op":"text","speaker":"羽依里","text":"“希望有吧。”"},{"op":"text","speaker":"羽依里","text":"“都到这里了，你还是回忆不起什么吗。”"},{"op":"image","layer":1,"image":"i11354"},{"op":"text","speaker":"鸥","text":"“不。我记得有人发现了轨道……”"},{"op":"image","layer":1,"image":"i11342"},{"op":"text","speaker":"鸥","text":"“接着走了一段路之后，就有一个那样的洞窟。”"},{"op":"text","speaker":"","text":"目前看来，轨道呈直线延伸。"},{"op":"text","speaker":"","text":"平缓向上的坡道前方有着什么，现在还无从得知。"},{"op":"text","speaker":"","text":"总之，只能过去看看了。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i1254"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"……轨道在森林中延伸着。"},{"op":"text","speaker":"","text":"日照依然强烈，但可能是因为进到山里的缘故，感觉清凉了不少。"},{"op":"text","speaker":"","text":"感觉四周传来的鸟叫虫鸣声，也和平时的不同。"},{"op":"image","layer":0,"image":"i1252"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“对了对了。”"},{"op":"text","speaker":"","text":"沉默地走了一会，不知道是不是鸥觉得无聊了，开始向我搭话。"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"text","speaker":"鸥","text":"“你的初恋是什么时候？”"},{"op":"text","speaker":"羽依里","text":"“干，干嘛啊，突然这么问。”"},{"op":"text","speaker":"羽依里","text":"“我该说是你吗。”"},{"op":"image","layer":0,"image":"i1255"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“我才没这么厚脸皮，而且要真是这样也太晚了。你也太不积极了吧。”"},{"op":"text","speaker":"羽依里","text":"“初恋啊……”"},{"op":"image","layer":0,"image":"i1254"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“我的初恋，是书中的角色。”"},{"op":"text","speaker":"羽依里","text":"“书中的角色？”"},{"op":"image","layer":0,"image":"i1252"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“是一个养金鱼的男孩子的故事。”"},{"op":"text","speaker":"鸥","text":"“那个男孩子非常重视金鱼，无论去哪里都会带着金鱼缸。”"},{"op":"text","speaker":"鸥","text":"“虽然周围的人告诫他说这样很危险，金鱼也很可怜，可他还是一直带在身边。”"},{"op":"image","layer":0,"image":"i1254"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“那样的一个故事。”"},{"op":"text","speaker":"羽依里","text":"“你喜欢的就是那个男孩子吗。”"},{"op":"image","layer":0,"image":"i1252"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“唉，不是啊。”"},{"op":"text","speaker":"鸥","text":"“我喜欢的是金鱼。”"},{"op":"text","speaker":"羽依里","text":"“……唉。”"},{"op":"text","speaker":"羽依里","text":"“甚至不是个人吗。”"},{"op":"text","speaker":"鸥","text":"“是啊。插画非常的可爱，金鱼也一定在用它的方式非常珍惜着男孩子。”"},{"op":"text","speaker":"羽依里","text":"“明明不会说话？”"},{"op":"text","speaker":"鸥","text":"“明明不会说话，也可以明白。书真的是好神奇。”"},{"op":"text","speaker":"羽依里","text":"“是啊。”"},{"op":"text","speaker":"鸥","text":"“所以我才觉得那条金鱼非常的可爱。是我的初恋。”"},{"op":"image","layer":0,"image":"i1255"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“但是，初恋是书中角色很奇怪吧。”"},{"op":"text","speaker":"羽依里","text":"“会吗。”"},{"op":"text","speaker":"羽依里","text":"“对象是金鱼确实会让人觉得有点奇怪，但其实很平常的吧。”"},{"op":"image","layer":0,"image":"i1252"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“是吗？”"},{"op":"text","speaker":"羽依里","text":"“我以前大概也喜欢过书中的角色。”"},{"op":"text","speaker":"羽依里","text":"“虽然记不清是不是初恋了。”"},{"op":"text","speaker":"鸥","text":"“南丁格尔？”"},{"op":"text","speaker":"羽依里","text":"“唉。”"},{"op":"text","speaker":"羽依里","text":"“为什么是她。”"},{"op":"image","layer":0,"image":"i1256"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“因为是个很优秀的女性。”"},{"op":"text","speaker":"羽依里","text":"“虽然很优秀，但我不会喜欢上她。”"},{"op":"image","layer":0,"image":"i1252"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“那是谁。海伦凯勒？”"},{"op":"text","speaker":"羽依里","text":"“不，虽然她很伟大我很尊敬，可应该不是。”"},{"op":"image","layer":0,"image":"i1255"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“哎。”"},{"op":"text","speaker":"鸥","text":"“那是谁啊。”"},{"op":"text","speaker":"羽依里","text":"“是谁呢。”"},{"op":"text","speaker":"羽依里","text":"“我忘了。”"},{"op":"image","layer":0,"image":"i1252"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"……是谁啊。"},{"op":"text","speaker":"","text":"记得曾经读过一本小说，然后很憧憬书中担任主角的女孩子。"},{"op":"text","speaker":"","text":"那时候我自命不凡，并不怎么擅长应付同年龄的……开始有女人味的女生们。"},{"op":"text","speaker":"","text":"所以才会憧憬小说中描绘的、勇敢的女孩子吧。"},{"op":"text","speaker":"","text":"好像可以成为好朋友的女孩子。"},{"op":"text","speaker":"","text":"回想起来，那个应该就是初恋了吧。"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"羽依里","text":"“好热。”"},{"op":"image","layer":0,"image":"i1255"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“很热呢。”"},{"op":"text","speaker":"","text":"时间已经快到16点了。"},{"op":"text","speaker":"","text":"可不能再慢慢悠悠了。"},{"op":"text","speaker":"","text":"我想尽量避免走了很久，结果走进死路的情况。"},{"op":"text","speaker":"羽依里","text":"“我先去前面看看情况。”"},{"op":"image","layer":0,"image":"i1252"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“你慢点跟来就好了，不用着急的。”"},{"op":"image","layer":0,"image":"i1255"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“好的。”"},{"op":"image","layer":0,"image":"i1256"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“走好。”"},{"op":"text","speaker":"","text":"我丢下朝我挥手的鸥，小跑着前行。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i158"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"快步地离开了。"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"废弃的轨道笔直延伸。"},{"op":"text","speaker":"","text":"就是说前路还很长吗。"},{"op":"text","speaker":"","text":"前方的景象因热浪而模糊的晃动着。"},{"op":"text","speaker":"","text":"忽然让我想起了电影中的一个场景。把耳朵贴在轨道上听声音。"},{"op":"text","speaker":"","text":"说不定能听到鸥拖着行李箱发出的嘎啦嘎啦声。"},{"op":"text","speaker":"","text":"……耳朵贴上去。"},{"op":"text","speaker":"羽依里","text":"“好烫!!”"},{"op":"text","speaker":"","text":"自然是很烫的。"},{"op":"text","speaker":"","text":"……而且压根听不到行李箱的声音。"},{"op":"text","speaker":"","text":"咦？这么说来。"},{"op":"text","speaker":"","text":"我突然注意到后方行李箱的声音消失了。"},{"op":"text","speaker":"","text":"鸥？"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"不在。"},{"op":"text","speaker":"","text":"失散了？"},{"op":"text","speaker":"","text":"轨道笔直地延伸着。"},{"op":"text","speaker":"","text":"只要不走进旁边的林子里，应该不会走散才是。"},{"op":"text","speaker":"","text":"真没办法，等等看吧。"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"突然。"},{"op":"text","speaker":"","text":"听到了声音。"},{"op":"text","speaker":"羽依里","text":"“那是……”"},{"op":"text","speaker":"","text":"孩子们在走路。"},{"op":"text","speaker":"","text":"在这种地方做什么呢。"},{"op":"text","speaker":"羽依里","text":"“喂。”"},{"op":"text","speaker":"羽依里","text":"“喂，你们几个。”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i1258"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"小鸥","text":"“只要和你在一起。”"},{"op":"text","speaker":"小鸥","text":"“我可以去到任何地方～♪”"},{"op":"text","speaker":"小雀","text":"“你在唱什么歌。”"},{"op":"text","speaker":"小雀","text":"“感觉是一首明快的曲子。”"},{"op":"text","speaker":"小鸥","text":"“《with》。”"},{"op":"text","speaker":"小雀","text":"“‘with’是什么？”"},{"op":"text","speaker":"小燕","text":"“英语‘一起’的意思是也。”"},{"op":"text","speaker":"小鸥","text":"“是一起的意思吗？”"},{"op":"text","speaker":"小鹰","text":"“你连意思都不知道就唱了啊。”"},{"op":"text","speaker":"小雀","text":"“名字就叫一起？好奇怪。”"},{"op":"text","speaker":"小鸥","text":"“要说名字，我觉得应该起一个队伍名。”"},{"op":"text","speaker":"小鹰","text":"“队伍名？”"},{"op":"text","speaker":"小鹰","text":"“感觉好羞耻啊。才不要呢。”"},{"op":"text","speaker":"小鸥","text":"“然后我想了一整晚。”"},{"op":"text","speaker":"小雀","text":"“啊，你已经想好了啊。”"},{"op":"text","speaker":"小鸥","text":"“海鸥团怎么样啊。”"},{"op":"text","speaker":"一同","text":"“……”"},{"op":"text","speaker":"小鹰","text":"“要点脸好吧。”"},{"op":"text","speaker":"小鹰","text":"“居然好意思光明正大地把自己名字加进去。”"},{"op":"text","speaker":"小鸥","text":"“唉。因为，我是队长嘛。”"},{"op":"text","speaker":"小隼","text":"“等一下。你们把班长晾在一边说些什么呢。”"},{"op":"text","speaker":"小雀","text":"“我喜欢更可爱的名字。”"},{"op":"text","speaker":"小鸥","text":"“我不够可爱吗!؟因为不够可爱所以不能当队长؟؟”"},{"op":"text","speaker":"小雀","text":"“不是说队长，在说队名。”"},{"op":"text","speaker":"小燕","text":"“什么才可爱呢。”"},{"op":"text","speaker":"小雀","text":"“猫咪之类的就很好啊。”"},{"op":"text","speaker":"小鹰","text":"“猫؟؟傻死了。”"},{"op":"text","speaker":"小雀","text":"“啊……对不起。”"},{"op":"text","speaker":"小鸥","text":"“说话不要这么过分。”"},{"op":"text","speaker":"小隼","text":"“用猫当象征太女孩子气，我也不喜欢。”"},{"op":"text","speaker":"小鸥","text":"“那这样就行了吧。”"},{"op":"image","layer":2304,"image":"i1057"},{"op":"text","speaker":"小鹰","text":"“什么啊。”"},{"op":"text","speaker":"小隼","text":"“胡子……？”"},{"op":"text","speaker":"小鸥","text":"“看。这样就有男子汉气概了。”"},{"op":"text","speaker":"小鹰","text":"“是这问题吗。”"},{"op":"text","speaker":"小雀","text":"“我不喜欢这样的猫咪。”"},{"op":"text","speaker":"小燕","text":"“这个方案不会让任何人得到幸福是也。”"},{"op":"text","speaker":"小雀","text":"“……”"},{"op":"text","speaker":"小雀","text":"“但是仔细看看还是挺可爱的。”"},{"op":"text","speaker":"小隼","text":"“不会吧。”"},{"op":"text","speaker":"小隼","text":"“总之比只叫猫咪好一点。”"},{"op":"text","speaker":"小鹰","text":"“随便啦。”"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":1792},{"op":"clear","layer":2304},{"op":"image","layer":0,"image":"i1257"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"小鸥","text":"“决定了。”"},{"op":"text","speaker":"小鸥","text":"“我们的队名。”"},{"op":"text","speaker":"小鸥","text":"“胡子猫海鸥团！”"},{"op":"text","speaker":"小鹰","text":"“别把海鸥加进去。”"},{"op":"text","speaker":"小鸥","text":"“胡子猫团。”"},{"op":"text","speaker":"小雀","text":"“哦！”"},{"op":"text","speaker":"小鹰","text":"“哦――……”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i1259"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"小雀","text":"“唉。”"},{"op":"text","speaker":"小雀","text":"“我说还要走多久啊。”"},{"op":"text","speaker":"小燕","text":"“好热，是也。”"},{"op":"text","speaker":"小鹰","text":"“把你的围脖取下来如何。”"},{"op":"text","speaker":"小燕","text":"“那可不行是也。”"},{"op":"text","speaker":"小鹰","text":"“为什么。”"},{"op":"text","speaker":"小燕","text":"“因为是忍者，是也。”"},{"op":"text","speaker":"小雀","text":"“这条轨道，到底有多长啊。”"},{"op":"text","speaker":"小隼","text":"“小鸥队员，请快一点。”"},{"op":"text","speaker":"小鸥","text":"“抱歉～”"},{"op":"text","speaker":"小鸥","text":"“抱歉。我一边欣赏景色一边走，所以你们先去吧。”"},{"op":"text","speaker":"小鹰","text":"“那个箱子不重吗。我来拿吧。”"},{"op":"text","speaker":"小鸥","text":"“没关系的。”"},{"op":"text","speaker":"小鹰","text":"“为什么啊。”"},{"op":"text","speaker":"小鸥","text":"“我自己拿。”"},{"op":"text","speaker":"小鹰","text":"“你要是慢了，大家就都慢了。”"},{"op":"text","speaker":"小鹰","text":"“别啰嗦了快给我。”"},{"op":"text","speaker":"小鸥","text":"“不要。”"},{"op":"text","speaker":"小鹰","text":"“队长就不要闹奇怪的别扭给人添麻烦了。”"},{"op":"text","speaker":"小鸥","text":"“这不是别扭。”"},{"op":"text","speaker":"小鹰","text":"“好了，快给我。”"},{"op":"text","speaker":"小鸥","text":"“住手啊。”"},{"op":"text","speaker":"小鹰","text":"“你……”"},{"op":"text","speaker":"小鸥","text":"“你们先走。”"},{"op":"text","speaker":"小鹰","text":"“什么。”"},{"op":"text","speaker":"小鸥","text":"“我不想给你们添麻烦。”"},{"op":"text","speaker":"小鸥","text":"“你们先走。”"},{"op":"text","speaker":"一同","text":"“……”"},{"op":"text","speaker":"小隼","text":"“怎么办呢。”"},{"op":"text","speaker":"小雀","text":"“我想快点走到可以休息的地方。”"},{"op":"text","speaker":"小鹰","text":"“那我们先走吧。”"},{"op":"text","speaker":"小燕","text":"“但是……”"},{"op":"text","speaker":"小鹰","text":"“她本人都这么说了，没关系的。”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":515,"image":"i25658"},{"op":"image","layer":0,"image":"i100"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"小雀","text":"“快看！是不是这里？”"},{"op":"text","speaker":"小鹰","text":"“哦。”"},{"op":"text","speaker":"小隼","text":"“那边有个入口。”"},{"op":"text","speaker":"小燕","text":"“洞窟是也。”"},{"op":"text","speaker":"小隼","text":"“终于到了呢。”"},{"op":"text","speaker":"小雀","text":"“累死了。”"},{"op":"text","speaker":"小雀","text":"“看，那边有水流哦。”"},{"op":"text","speaker":"小雀","text":"“我去洗一把脸。”"},{"op":"text","speaker":"小鹰","text":"“小心一点哦。谁知道会冒出什么来。”"},{"op":"text","speaker":"小雀","text":"“唔……有什么东西吗。”"},{"op":"text","speaker":"小鹰","text":"“不，就是因为不知道。才叫你小心的。”"},{"op":"text","speaker":"小隼","text":"“小鸥队员呢……”"},{"op":"text","speaker":"小鹰","text":"“已经来了哦。没关系的。”"},{"op":"text","speaker":"小隼","text":"“这么说来，你很在意一直回头看呢。”"},{"op":"text","speaker":"小鹰","text":"“啰嗦。”"},{"op":"text","speaker":"小隼","text":"“哼哼。”"},{"op":"text","speaker":"小隼","text":"“不管怎么说，今天都要在这里露宿了。”"},{"op":"text","speaker":"小鹰","text":"“果然变成这样了吗。”"},{"op":"text","speaker":"小隼","text":"“现在进洞窟太危险了。再过一会，天也要黑了。”"},{"op":"text","speaker":"小鹰","text":"“嗯。”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"小鸥","text":"“久等了。”"},{"op":"text","speaker":"小雀","text":"“啊，小鸥辛苦了。”"},{"op":"text","speaker":"小燕","text":"“辛苦了是也。”"},{"op":"text","speaker":"小雀","text":"“快看那边，有一个入口哦。”"},{"op":"text","speaker":"小鸥","text":"“真的！”"},{"op":"text","speaker":"小鸥","text":"“洞窟……真的有啊。”"},{"op":"text","speaker":"小雀","text":"“为什么在这里会有个洞窟呢。”"},{"op":"text","speaker":"小鹰","text":"“因为在这里挖过什么吧。”"},{"op":"text","speaker":"小雀","text":"“挖什么呢？”"},{"op":"text","speaker":"小鹰","text":"“黄金或者白银……吧。我也不清楚。”"},{"op":"text","speaker":"小隼","text":"“今晚在这里露宿。大家准备起来。”"},{"op":"text","speaker":"小雀","text":"“唉。”"},{"op":"text","speaker":"小雀","text":"“要睡在这里吗؟؟”"},{"op":"text","speaker":"小鹰","text":"“只能这样了。”"},{"op":"text","speaker":"小燕","text":"“我不介意是也。”"},{"op":"text","speaker":"小雀","text":"“不，不会吧。”"},{"op":"text","speaker":"小雀","text":"“我不能在外面过夜啦。先回去嘛……”"},{"op":"text","speaker":"小鹰","text":"“就因为回不去才露宿的。先回去再过来的话还要花时间吧。”"},{"op":"text","speaker":"小雀","text":"“嗯。”"},{"op":"text","speaker":"小雀","text":"“我知道了。”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":515},{"op":"clear","layer":259},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i158"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“唉。”"},{"op":"text","speaker":"","text":"……回过神来。"},{"op":"text","speaker":"","text":"我独自一人，站在笔直延伸的废弃轨道上。"},{"op":"text","speaker":"","text":"刚才的是什么啊。"},{"op":"text","speaker":"","text":"看到了沿着轨道前进的孩子们。"},{"op":"text","speaker":"","text":"不知不觉中，我好像也成为了他们中的一员。"},{"op":"text","speaker":"","text":"白日梦？"},{"op":"text","speaker":"羽依里","text":"“不妙啊。”"},{"op":"text","speaker":"","text":"说不定是中暑了。"},{"op":"text","speaker":"","text":"我一边擦着额头的汗水，一边蹒跚前行。"},{"op":"text","speaker":"","text":"忽然，我注意到一直延伸的轨道中断了。"},{"op":"text","speaker":"羽依里","text":"“这里是。”"},{"op":"text","speaker":"","text":"停下脚步抬起头。"},{"op":"image","layer":0,"image":"i473"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"岩壁上裂开了一个洞。"},{"op":"text","speaker":"羽依里","text":"“洞窟……”"},{"op":"text","speaker":"","text":"真的存在啊。"},{"op":"image","layer":0,"image":"i100"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我朝洞中看了看，空洞的高度大概够一个成年人站立通行，里面相当深。"},{"op":"text","speaker":"","text":"凉风拂过脸颊，还能听到像水流一样的哗哗声。"},{"op":"image","layer":7,"image":"i11335"},{"op":"text","speaker":"鸥","text":"“喂――”"},{"op":"text","speaker":"","text":"终于赶上来了。"},{"op":"text","speaker":"","text":"鸥嘎啦嘎啦地拖着行李箱，追了上来。"},{"op":"image","layer":1,"image":"i11307"},{"op":"text","speaker":"羽依里","text":"“来得好慢啊。你是不是去溜达了？”"},{"op":"image","layer":1,"image":"i11261"},{"op":"text","speaker":"鸥","text":"“我从那边走过来的。”"},{"op":"image","layer":1,"image":"i11240"},{"op":"text","speaker":"鸥","text":"“那条轨道。”"},{"op":"text","speaker":"羽依里","text":"“是吗？”"},{"op":"text","speaker":"羽依里","text":"“半路上发现你不见了哦。”"},{"op":"image","layer":1,"image":"i11245"},{"op":"text","speaker":"鸥","text":"“没有啊。我好好沿着轨道走过来了。”"},{"op":"text","speaker":"羽依里","text":"“是吗……”"},{"op":"clear","layer":0},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i100"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我再次看向洞窟。"},{"op":"image","layer":7,"image":"i11294"},{"op":"text","speaker":"鸥","text":"“……找到洞窟了呢。”"},{"op":"text","speaker":"羽依里","text":"“……是啊。”"},{"op":"text","speaker":"","text":"毫无疑问我是第一次来。"},{"op":"image","layer":0,"image":"i100"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11252"},{"op":"text","speaker":"鸥","text":"“你怎么了。”"},{"op":"text","speaker":"羽依里","text":"“唉。”"},{"op":"image","layer":1,"image":"i11240"},{"op":"text","speaker":"鸥","text":"“一直在发呆哦。”"},{"op":"text","speaker":"羽依里","text":"“啊。”"},{"op":"text","speaker":"","text":"刚才的光景，还模糊地残留在我的脑海中。"},{"op":"text","speaker":"","text":"总觉得，有点飘乎乎的。"},{"op":"image","layer":1,"image":"i11259"},{"op":"text","speaker":"鸥","text":"“累了？”"},{"op":"text","speaker":"羽依里","text":"“不是。”"},{"op":"text","speaker":"羽依里","text":"“以前……”"},{"op":"text","speaker":"羽依里","text":"“你们来过这里吧。”"},{"op":"text","speaker":"羽依里","text":"“然后，在洞口露宿度过夜晚。”"},{"op":"image","layer":1,"image":"i11240"},{"op":"text","speaker":"鸥","text":"“嗯，没错。”"},{"op":"text","speaker":"羽依里","text":"“是吗。”"},{"op":"text","speaker":"","text":"听了鸥的话，才会自说自话做白日梦的吧。"},{"op":"text","speaker":"","text":"总感觉好像是热傻了。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":1},{"op":"image","layer":0,"image":"i163"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"","text":"快要到17点了。"},{"op":"text","speaker":"","text":"夕阳西下，渐渐给天空染上更深的颜色。"},{"op":"text","speaker":"","text":"花了4小时才来到这里啊。"},{"op":"image","layer":0,"image":"i102"},{"op":"set","variable":6714,"value":4},{"op":"image","layer":1,"image":"i11370"},{"op":"text","speaker":"鸥","text":"“好累啊。”"},{"op":"text","speaker":"羽依里","text":"“确实累人。”"},{"op":"text","speaker":"羽依里","text":"“你没事吧。”"},{"op":"image","layer":1,"image":"i11311"},{"op":"text","speaker":"鸥","text":"“嗯，因为我是慢慢走的。”"},{"op":"text","speaker":"羽依里","text":"“是吗。”"},{"op":"text","speaker":"","text":"体力方面似乎还多少留有余裕。"},{"op":"text","speaker":"","text":"但是……"},{"op":"image","layer":1,"image":"i11240"},{"op":"text","speaker":"","text":"我们看着开在岩壁上的洞窟入口。"},{"op":"text","speaker":"羽依里","text":"“对了，这个洞有多深啊。”"},{"op":"image","layer":1,"image":"i11289"},{"op":"text","speaker":"鸥","text":"“嗯～我印象当中很深……但那也只是儿时的记忆了。”"},{"op":"text","speaker":"羽依里","text":"“不管怎么说，都不可能现在进去。”"},{"op":"text","speaker":"","text":"太阳已经快要下山了。"},{"op":"text","speaker":"","text":"无论如何都要避免在洞窟中迎来日落的情况。"},{"op":"image","layer":1,"image":"i11307"},{"op":"text","speaker":"鸥","text":"“这里似乎可以搭帐篷呢。”"},{"op":"text","speaker":"羽依里","text":"“是啊。”"},{"op":"text","speaker":"羽依里","text":"“搞了半天还是要露宿啊。”"},{"op":"text","speaker":"","text":"有备无患。"},{"op":"text","speaker":"","text":"还好有把重死人的露营装备背来。"},{"op":"image","layer":1,"image":"i11339"},{"op":"text","speaker":"鸥","text":"“那么开始搭帐篷吧。”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"良一那里借来的便携帐篷是折叠式的，很简便。"},{"op":"text","speaker":"","text":"可是不熟悉的两个人来搭，还是花了番功夫。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":1},{"op":"image","layer":0,"image":"i102"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"羽依里","text":"“搞定。”"},{"op":"image","layer":1,"image":"i11243"},{"op":"text","speaker":"鸥","text":"“辛苦了。”"},{"op":"clear","layer":1},{"op":"image","layer":2,"image":"i747"},{"op":"image","layer":0,"image":"i514"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"","text":"抬头一看，天色已经慢慢开始暗了下来。"},{"op":"text","speaker":"","text":"一天就要结束了。"},{"op":"image","layer":7,"image":"i11239"},{"op":"text","speaker":"鸥","text":"“趁天没黑点个火吧。”"},{"op":"image","layer":7,"image":"i11306"},{"op":"text","speaker":"鸥","text":"“我去找点能点燃的东西。”"},{"op":"text","speaker":"羽依里","text":"“嗯，麻烦你了。”"},{"op":"image","layer":7,"image":"i11338"},{"op":"text","speaker":"鸥","text":"“我去啦――”"},{"op":"text","speaker":"","text":"即使要露宿，鸥也是很愉快的样子。"},{"op":"text","speaker":"","text":"她的积极乐观，让我由衷佩服。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":2},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":2},{"op":"text","speaker":"","text":"天完全黑了。"},{"op":"image","layer":0,"image":"i1261"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i1260"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"用树枝点起了篝火。"},{"op":"text","speaker":"","text":"按照良一给我的指南手册上的方法试了试，点起了像模像样的篝火。"},{"op":"text","speaker":"","text":"同样是用指南手册上登载的方法，还用野炊锅具做出了热饭。"},{"op":"text","speaker":"","text":"就着带来的罐头吃着……围坐在篝火边。"},{"op":"text","speaker":"","text":"鸥没有说话。"},{"op":"text","speaker":"","text":"……我们两个，就这么呆呆地望着篝火。"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":515,"image":"i25658"},{"op":"image","layer":0,"image":"i105"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"小雀","text":"“晚安了。”"},{"op":"text","speaker":"小隼","text":"“晚安。”"},{"op":"text","speaker":"小鸥","text":"“男生睡在那边哦。”"},{"op":"text","speaker":"小雀","text":"“不准进到我们的帐篷里。”"},{"op":"text","speaker":"小鹰","text":"“谁，谁会去啊。”"},{"op":"text","speaker":"小隼","text":"“好了，睡吧。”"},{"op":"text","speaker":"小鹰","text":"“嗯。”"},{"op":"text","speaker":"小隼","text":"“你打呼噜声音大吗。”"},{"op":"text","speaker":"小鹰","text":"“不清楚啊。也没有人跟我抱怨过这个。”"},{"op":"text","speaker":"小隼","text":"“那就好。因为我比较敏感，没法和呼噜声大的人一起睡。”"},{"op":"text","speaker":"小隼","text":"“要是大的话你就去睡外面。”"},{"op":"text","speaker":"小鹰","text":"“不是吧。”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":515},{"op":"clear","layer":259},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":515,"image":"i25658"},{"op":"image","layer":0,"image":"i170"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"小隼","text":"“呼呼呼呼呼。”"},{"op":"text","speaker":"小鹰","text":"“……”"},{"op":"text","speaker":"小隼","text":"“呼呼呼呼。”"},{"op":"text","speaker":"小隼","text":"“哼哼哼哼哼哼。”"},{"op":"text","speaker":"小鹰","text":"“完全没法睡……”"},{"op":"image","layer":515,"image":"i25658"},{"op":"image","layer":0,"image":"i105"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"小鹰","text":"“唉。”"},{"op":"text","speaker":"小鹰","text":"“去上个厕所算了……”"},{"op":"text","speaker":"小鹰","text":"“我记得这附近……”"},{"op":"text","speaker":"小鸥","text":"“呜呜。”"},{"op":"text","speaker":"小鹰","text":"“谁!؟”"},{"op":"text","speaker":"小鸥","text":"“呜呜。”"},{"op":"text","speaker":"小鹰","text":"“……还在坚持。”"},{"op":"text","speaker":"小鸥","text":"“呜呜。”"},{"op":"text","speaker":"小鹰","text":"“相当大的家伙吗？”"},{"op":"text","speaker":"小鹰","text":"“加油……”"},{"op":"text","speaker":"小鹰","text":"“等等，是鸥？”"},{"op":"text","speaker":"小鸥","text":"“呜，呜呜呜。”"},{"op":"text","speaker":"小鸥","text":"“嘤。”"},{"op":"text","speaker":"小鹰","text":"“喂，你没事吧。”"},{"op":"text","speaker":"小鸥","text":"“好痛……”"},{"op":"text","speaker":"小鹰","text":"“喂。”"},{"op":"text","speaker":"小鸥","text":"“唉。”"},{"op":"text","speaker":"小鹰","text":"“你怎么了。”"},{"op":"text","speaker":"小鸥","text":"“我的脚。”"},{"op":"text","speaker":"小鹰","text":"“脚很痛吗。”"},{"op":"text","speaker":"小鸥","text":"“………嗯。”"},{"op":"text","speaker":"小鸥","text":"“但是没关系，马上就会好的……”"},{"op":"text","speaker":"小鹰","text":"“骗谁啊。”"},{"op":"text","speaker":"小鹰","text":"“说到底，不是从今天白天开始就在痛了吗。”"},{"op":"text","speaker":"小鹰","text":"“不肯把行李箱给我也是这个原因。”"},{"op":"text","speaker":"小鹰","text":"“因为可以当拐杖支撑身体是吧？”"},{"op":"text","speaker":"小鸥","text":"“…………”"},{"op":"text","speaker":"小鸥","text":"“嗯。”"},{"op":"text","speaker":"小鹰","text":"“说出来。”"},{"op":"text","speaker":"小鸥","text":"“说什么？”"},{"op":"text","speaker":"小鹰","text":"“所有的一切。”"},{"op":"text","speaker":"小鸥","text":"“呜。”"},{"op":"text","speaker":"小鸥","text":"“从以前开始，我就一直住院。”"},{"op":"text","speaker":"小鹰","text":"“生病吗。”"},{"op":"text","speaker":"小鸥","text":"“嗯。”"},{"op":"text","speaker":"小鸥","text":"“按照医生说的，我身体里面缺乏应有的酶……所以会使不上力气，是这样的一种病。”"},{"op":"text","speaker":"小鸥","text":"“平时的话，只是走路有点吃力而已……”"},{"op":"text","speaker":"小鸥","text":"“可有时候痛苦到无法呼吸，一点力气都使不出。”"},{"op":"text","speaker":"小鸥","text":"“全身都会痛。”"},{"op":"text","speaker":"小鹰","text":"“那算什么啊。”"},{"op":"text","speaker":"小鹰","text":"“别开玩笑了。”"},{"op":"text","speaker":"小鸥","text":"“!؟”"},{"op":"text","speaker":"小鹰","text":"“为什么，会这样……这种事情……”"},{"op":"text","speaker":"小鸥","text":"“啊……”"},{"op":"text","speaker":"小鸥","text":"“对不起。”"},{"op":"text","speaker":"小鸥","text":"“我……感觉还不错……就以为没事了。”"},{"op":"text","speaker":"小鹰","text":"“等到天亮，就回去吧。”"},{"op":"text","speaker":"小鸥","text":"“不，不要！”"},{"op":"text","speaker":"小鹰","text":"“什么؟!”"},{"op":"text","speaker":"小鹰","text":"“你都这样了，还打算进洞窟吗؟؟别闹了。”"},{"op":"text","speaker":"小鸥","text":"“求你了……”"},{"op":"text","speaker":"小鸥","text":"“求求你了。”"},{"op":"text","speaker":"小鹰","text":"“什么啊。为什么这么执着……”"},{"op":"text","speaker":"小鸥","text":"“……”"},{"op":"text","speaker":"小鸥","text":"“我一直，都在医院里。”"},{"op":"text","speaker":"小鸥","text":"“不能去学校，不能和朋友一起玩，一天到晚只能看书。”"},{"op":"text","speaker":"小鸥","text":"“我一直梦想，将来能交上朋友……进行一场让人心动的探险。”"},{"op":"text","speaker":"小鸥","text":"“看着书幻想着。”"},{"op":"text","speaker":"小鸥","text":"“现在，我就在梦想之中。”"},{"op":"text","speaker":"小鸥","text":"“还不想醒来。”"},{"op":"text","speaker":"小鸥","text":"“无论如何我都想去。”"},{"op":"text","speaker":"小鹰","text":"“…………”"},{"op":"text","speaker":"小鹰","text":"“我懂了。”"},{"op":"text","speaker":"小鹰","text":"“但是你要答应我。”"},{"op":"text","speaker":"小鹰","text":"“觉得难受了要说出来。”"},{"op":"text","speaker":"小鸥","text":"“……唉。”"},{"op":"text","speaker":"小鸥","text":"“嗯。”"},{"op":"text","speaker":"小鸥","text":"“我会好好说出来的。”"},{"op":"text","speaker":"小鹰","text":"“……”"},{"op":"text","speaker":"小鹰","text":"“抱歉。”"},{"op":"text","speaker":"小鸥","text":"“唉。”"},{"op":"text","speaker":"小鹰","text":"“白天的事情……对不起。”"},{"op":"text","speaker":"小鹰","text":"“我不知道你脚的情况。”"},{"op":"text","speaker":"小鸥","text":"“因为我没有说出来呀。”"},{"op":"text","speaker":"小鹰","text":"“话虽如此。”"},{"op":"text","speaker":"小鹰","text":"“……对不起。”"},{"op":"text","speaker":"小鸥","text":"“不用客气。”"},{"op":"text","speaker":"小鹰","text":"“回答不用客气，是不是有点怪。”"},{"op":"text","speaker":"小鸥","text":"“是呢。”"},{"op":"text","speaker":"小鸥","text":"“呵呵。”"},{"op":"text","speaker":"小鹰","text":"“啊哈哈。”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":515},{"op":"clear","layer":259},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]