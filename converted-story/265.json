[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i21"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我来到了秘密基地。"},{"op":"image","layer":1540,"image":"i209"},{"op":"image","layer":1796,"image":"i15087"},{"op":"image","layer":2052,"image":"i25242"},{"op":"text","speaker":"","text":"今天也是一如既往，良一坐在靠椅上，天善在打乒乓球。"},{"op":"text","speaker":"","text":"而我则是在无所事事。"},{"op":"text","speaker":"","text":"一成不变的景象。"},{"op":"text","speaker":"","text":"甚至已经是和平的象征了。"},{"op":"text","speaker":"","text":"也许有朝一日我们都能被立为铜像。"},{"op":"clear","layer":1540},{"op":"clear","layer":1796},{"op":"clear","layer":2052},{"op":"clear","layer":2047},{"op":"clear","layer":1535},{"op":"image","layer":1,"image":"i12174"},{"op":"text","speaker":"良一","text":"“羽依里，我有件事想问。”"},{"op":"image","layer":1,"image":"i12171"},{"op":"text","speaker":"良一","text":"“我们到底怎样才能变得受欢迎啊？”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"来了个预料外的提问。"},{"op":"text","speaker":"羽依里","text":"“这个问题你为什么要问我啊？”"},{"op":"image","layer":1,"image":"i12159"},{"op":"text","speaker":"良一","text":"“因为啊，城里面的学校在各个方面都比较前卫吧？”"},{"op":"image","layer":1,"image":"i12141"},{"op":"text","speaker":"良一","text":"“你也是在那里上学的，多少会知道一些事吧？”"},{"op":"text","speaker":"羽依里","text":"“不，完全不知道。”"},{"op":"image","layer":1,"image":"i12153"},{"op":"text","speaker":"良一","text":"“我明白的！”"},{"op":"image","layer":1,"image":"i12150"},{"op":"text","speaker":"良一","text":"“哪怕是对你来说没什么了不起的事，对我们来说也可能是非比寻常的大事了吧？”"},{"op":"text","speaker":"","text":"完全错误，我真的什么都不知道。"},{"op":"text","speaker":"","text":"毕竟我上的是男校。"},{"op":"image","layer":1,"image":"i12171"},{"op":"text","speaker":"良一","text":"“你就给我们说说吧。我们怎么才能受欢迎，能受欢迎到什么程度。”"},{"op":"image","layer":257,"image":"i15125"},{"op":"text","speaker":"天善","text":"“喂，良一”"},{"op":"image","layer":257,"image":"i15120"},{"op":"text","speaker":"天善","text":"“刚才开始你就一口一个‘我们’的，你难道把我也算进去了？”"},{"op":"image","layer":1,"image":"i12174"},{"op":"text","speaker":"良一","text":"“当然了。天善你也应该很在意的吧？”"},{"op":"image","layer":257,"image":"i15078"},{"op":"text","speaker":"天善","text":"“无聊透顶……”"},{"op":"image","layer":1,"image":"i12168"},{"op":"text","speaker":"良一","text":"“什么!؟”"},{"op":"image","layer":257,"image":"i15008"},{"op":"text","speaker":"天善","text":"“我正在练习……不要打扰我。”"},{"op":"image","layer":257,"image":"i15137"},{"op":"text","speaker":"天善","text":"“哼――哈！”"},{"op":"image","layer":1,"image":"i12147"},{"op":"text","speaker":"良一","text":"“这家伙……我们不要管他了，来继续讨论受欢迎的话题吧。”"},{"op":"text","speaker":"羽依里","text":"“啊，嗯……”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“那我要提个问。”"},{"op":"image","layer":1,"image":"i12171"},{"op":"text","speaker":"良一","text":"“我和天善的话，谁看起来更受欢迎？”"},{"op":"text","speaker":"羽依里","text":"“这个嘛……”"},{"op":"choice","variable":6001,"items":[{"text":"良一","value":0,"condition":1},{"text":"天善","value":1,"condition":1},{"text":"我","value":2,"condition":1}]},{"op":"if","truth":false,"target":145,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“良一吧。”"},{"op":"image","layer":1,"image":"i12162"},{"op":"text","speaker":"良一","text":"“噢噢！我很受欢迎是么？”"},{"op":"text","speaker":"羽依里","text":"“一眼看上去很轻浮但是骨子里确是个挺好的家伙。”"},{"op":"text","speaker":"羽依里","text":"“努努力的话应该会很受欢迎吧？”"},{"op":"image","layer":1,"image":"i12165"},{"op":"text","speaker":"良一","text":"“天善你听到了吗！我比你要更受欢迎！”"},{"op":"image","layer":772,"image":"i209"},{"op":"image","layer":1028,"image":"i15087"},{"op":"image","layer":1284,"image":"i25242"},{"op":"text","speaker":"","text":"良一露出了一脸得意的笑容，朝乒乓球桌方向望去。"},{"op":"clear","layer":772},{"op":"clear","layer":1028},{"op":"clear","layer":1284},{"op":"clear","layer":1791},{"op":"clear","layer":1279},{"op":"image","layer":257,"image":"i15113"},{"op":"text","speaker":"天善","text":"“你受欢迎的时候我可真是一次也没见过。”"},{"op":"image","layer":257,"image":"i15088"},{"op":"image","layer":1,"image":"i12150"},{"op":"text","speaker":"天善","text":"“你这自信到底从哪来的？”"},{"op":"image","layer":1,"image":"i12153"},{"op":"text","speaker":"良一","text":"“之后我就会受欢迎了！”"},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“是吧，羽依里！”"},{"op":"text","speaker":"羽依里","text":"“大概吧。”"},{"op":"image","layer":1,"image":"i12153"},{"op":"text","speaker":"良一","text":"“你看！”"},{"op":"image","layer":257,"image":"i15072"},{"op":"text","speaker":"天善","text":"“他只是在随便敷衍你。”"},{"op":"image","layer":1,"image":"i12174"},{"op":"text","speaker":"良一","text":"“话说，努力的话是指哪方面啊？”"},{"op":"text","speaker":"羽依里","text":"“这个的话……”"},{"op":"image","layer":257,"image":"i15008"},{"op":"text","speaker":"","text":"稍微想了想。"},{"op":"text","speaker":"羽依里","text":"“一般像你这样的外表的家伙，懂时尚的人比较受欢迎。”"},{"op":"image","layer":1,"image":"i12162"},{"op":"text","speaker":"良一","text":"“时尚啊！”"},{"op":"image","layer":257,"image":"i15082"},{"op":"text","speaker":"天善","text":"“死路一条啊。”"},{"op":"image","layer":1,"image":"i12153"},{"op":"text","speaker":"良一","text":"“才不是！”"},{"op":"image","layer":257,"image":"i15065"},{"op":"text","speaker":"天善","text":"“一个每天光着身子的家伙懂时尚？”"},{"op":"image","layer":1,"image":"i12171"},{"op":"text","speaker":"良一","text":"“喂喂，你可别小看我啊？”"},{"op":"image","layer":1,"image":"i12180"},{"op":"text","speaker":"良一","text":"“对于一个很会穿衣打扮的人来说，赤身裸体也是能非常时尚的。”"},{"op":"text","speaker":"羽依里","text":"“光着身子的穿衣打扮是什么啊？”"},{"op":"image","layer":257,"image":"i15082"},{"op":"text","speaker":"天善","text":"“不要把你那独特的价值观强加于人啊。”"},{"op":"image","layer":1,"image":"i12150"},{"op":"text","speaker":"良一","text":"“……”"},{"op":"image","layer":1,"image":"i12141"},{"op":"text","speaker":"良一","text":"“算了……不过。”"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"image","layer":1,"image":"i12147"},{"op":"text","speaker":"良一","text":"“对我来说的话，到底是怎样……还说不定呢。”"},{"op":"image","layer":1,"image":"i12150"},{"op":"text","speaker":"良一","text":"“怎么说呢，人的话不管外在装饰成什么样子，最重要的还是内在吧？”"},{"op":"image","layer":1,"image":"i12141"},{"op":"text","speaker":"良一","text":"“我还是更加磨练自己的内在美吧。然后去寻找能喜欢光着身子的我的人。”"},{"op":"text","speaker":"羽依里","text":"“良一……”"},{"op":"text","speaker":"羽依里","text":"“你是在说笑话吗？”"},{"op":"image","layer":1,"image":"i12153"},{"op":"text","speaker":"良一","text":"“才不是开玩笑啊！我明明说的挺好的！”"},{"op":"image","layer":257,"image":"i15082"},{"op":"text","speaker":"天善","text":"“平常就光着身子的家伙就算说什么‘裸体的我’，也没法引起人的共鸣啊。”"},{"op":"image","layer":257,"image":"i15086"},{"op":"text","speaker":"天善","text":"“归根结底你准备努力什么，以及怎么努力啊？”"},{"op":"image","layer":1,"image":"i12147"},{"op":"text","speaker":"良一","text":"“这个……那就去做个什么大事吧！”"},{"op":"text","speaker":"","text":"听起来就不行。"},{"op":"text","speaker":"羽依里","text":"“总之，你加油。”"},{"op":"image","layer":1,"image":"i12190"},{"op":"text","speaker":"良一","text":"“噢噢！看我搞点大事，然后成为受欢迎的人！”"},{"op":"text","speaker":"","text":"简直庸俗透顶。"},{"op":"text","speaker":"","text":"看来他就算要磨练内在美，也还有很长的路。"},{"op":"goto","target":341},{"op":"if","truth":false,"target":260,"value":["==",["v",6001],1]},{"op":"text","speaker":"羽依里","text":"“天善不是很受欢迎么？”"},{"op":"image","layer":1,"image":"i12168"},{"op":"text","speaker":"良一","text":"“真的假的!؟就这种满脑子只有乒乓球的家伙？”"},{"op":"text","speaker":"羽依里","text":"“毕竟，天善看起来挺冷淡的而且很沉稳。”"},{"op":"image","layer":1,"image":"i12153"},{"op":"text","speaker":"良一","text":"“可恶！听起来真不错啊，天善!!”"},{"op":"image","layer":1540,"image":"i209"},{"op":"image","layer":1796,"image":"i15112"},{"op":"image","layer":2052,"image":"i25242"},{"op":"text","speaker":"天善","text":"“我说过我怕没兴趣了。不要打扰我练习。”"},{"op":"clear","layer":1540},{"op":"clear","layer":1796},{"op":"clear","layer":2052},{"op":"clear","layer":2047},{"op":"clear","layer":1535},{"op":"text","speaker":"","text":"天善说罢就又回去练球了。"},{"op":"image","layer":1,"image":"i12150"},{"op":"text","speaker":"良一","text":"“搞不懂啊……为什么这家伙能受欢迎，完全搞不懂。”"},{"op":"if","truth":false,"target":258,"value":["||",["==",["v",131],1],["==",["v",424],1]]},{"op":"text","speaker":"羽依里","text":"“像他那种看起来冷淡的家伙，要是有些可爱的地方就好了。”"},{"op":"image","layer":1,"image":"i12171"},{"op":"text","speaker":"良一","text":"“啊……毕竟女生比较喜欢可爱的东西啊。”"},{"op":"text","speaker":"羽依里","text":"“然后就是，如何展现可爱之处了。”"},{"op":"image","layer":1540,"image":"i209"},{"op":"image","layer":1796,"image":"i15115"},{"op":"image","layer":2052,"image":"i25242"},{"op":"text","speaker":"天善","text":"“――哈！――啊！”"},{"op":"image","layer":1,"image":"i12174"},{"op":"text","speaker":"良一","text":"“像苍那样每天带着稻荷到处走怎么样？”"},{"op":"text","speaker":"羽依里","text":"“那是动物很可爱，跟这个是两码事吧。”"},{"op":"image","layer":1540,"image":"i209"},{"op":"image","layer":1796,"image":"i15147"},{"op":"text","speaker":"天善","text":"“――哼！――喝！”"},{"op":"text","speaker":"羽依里","text":"“我是说更加偏向人类的那种”"},{"op":"image","layer":1,"image":"i12147"},{"op":"text","speaker":"良一","text":"“那紬怎么样？水织学姐也很喜欢她。”"},{"op":"image","layer":1540,"image":"i209"},{"op":"image","layer":1796,"image":"i15101"},{"op":"text","speaker":"天善","text":"“――哼！――哼！――哈！”"},{"op":"image","layer":1540,"image":"i209"},{"op":"image","layer":1796,"image":"i15034"},{"op":"text","speaker":"天善","text":"“――姆啾啊啊啊啊！”"},{"op":"clear","layer":1540},{"op":"clear","layer":1796},{"op":"clear","layer":2052},{"op":"clear","layer":2047},{"op":"clear","layer":1535},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"良一","text":"“……”"},{"op":"text","speaker":"","text":"刚才的吼声里好像混进去了什么奇怪的东西……"},{"op":"image","layer":1540,"image":"i209"},{"op":"image","layer":1796,"image":"i15115"},{"op":"image","layer":2052,"image":"i25242"},{"op":"text","speaker":"天善","text":"“――姆啾！――哼！――姆啾！”"},{"op":"text","speaker":"","text":"……果然没听错。"},{"op":"text","speaker":"","text":"他在喊姆啾。"},{"op":"clear","layer":1540},{"op":"clear","layer":1796},{"op":"clear","layer":2052},{"op":"clear","layer":2047},{"op":"clear","layer":1535},{"op":"text","speaker":"良一","text":"“喂……不是说反差会变得可爱吗？”"},{"op":"image","layer":1,"image":"i12150"},{"op":"text","speaker":"良一","text":"“但是这怎么完全不觉得可爱？”"},{"op":"text","speaker":"羽依里","text":"“方向完全搞错了啊。”"},{"op":"image","layer":257,"image":"i15038"},{"op":"text","speaker":"天善","text":"“不，你们两个……不要误会。”"},{"op":"text","speaker":"","text":"天善放下了球拍朝我们走了过来。"},{"op":"image","layer":257,"image":"i15014"},{"op":"text","speaker":"天善","text":"“我现在正在寻找各种能提起干劲的口号”"},{"op":"image","layer":257,"image":"i15032"},{"op":"text","speaker":"天善","text":"“所以说不是你们想的那样。”"},{"op":"image","layer":257,"image":"i15011"},{"op":"text","speaker":"天善","text":"“我不是在模仿紬的可爱之处。”"},{"op":"image","layer":257,"image":"i15041"},{"op":"text","speaker":"天善","text":"“只是听起来有点像罢了。”"},{"op":"image","layer":1,"image":"i12171"},{"op":"text","speaker":"良一","text":"“噢，噢……那就这样吧……”"},{"op":"image","layer":257,"image":"i15011"},{"op":"text","speaker":"天善","text":"“不过，这个吼声倒是感觉不错。”"},{"op":"image","layer":257,"image":"i15044"},{"op":"text","speaker":"天善","text":"“今后我可能也会用。”"},{"op":"text","speaker":"","text":"还是不要了吧。"},{"op":"image","layer":257,"image":"i15038"},{"op":"text","speaker":"天善","text":"“要是可以的话能不能跟我打一局？”"},{"op":"image","layer":257,"image":"i15122"},{"op":"text","speaker":"天善","text":"“我想试试这个吼声能发挥多大的力量。”"},{"op":"text","speaker":"","text":"天善做好了发球的姿势。"},{"op":"text","speaker":"天善","text":"“呼……姆叽――――――――!!!”"},{"op":"text","speaker":"","text":"……感觉和平时没什么两样。"},{"op":"text","speaker":"","text":"而且我也不想跟这件事扯上关系。"},{"op":"text","speaker":"羽依里","text":"“抱歉，我今天胳膊受伤了。”"},{"op":"image","layer":1,"image":"i12220"},{"op":"text","speaker":"良一","text":"“噢，噢噢！我也是！”"},{"op":"image","layer":257,"image":"i15072"},{"op":"text","speaker":"天善","text":"“……这样啊。”"},{"op":"text","speaker":"","text":"天善沮丧了起来。"},{"op":"text","speaker":"","text":"感觉有点可爱。"},{"op":"image","layer":257,"image":"i15065"},{"op":"text","speaker":"天善","text":"“没办法了，那今天就练肌肉吧。”"},{"op":"text","speaker":"羽依里","text":"“嗯，加油吧。”"},{"op":"text","speaker":"","text":"天善用双手抓住了门框。"},{"op":"image","layer":7,"image":"i15019"},{"op":"text","speaker":"天善","text":"“姆叽！姆叽！姆叽！姆叽！姆叽！姆叽！姆叽！姆叽！”"},{"op":"text","speaker":"","text":"然后开始做起了引体向上。"},{"op":"image","layer":1,"image":"i12159"},{"op":"text","speaker":"羽依里","text":"“他到底咋回事？”"},{"op":"text","speaker":"良一","text":"“天善他的心上人其实是水织学姐。”"},{"op":"text","speaker":"羽依里","text":"“啊……这样啊。”"},{"op":"text","speaker":"","text":"所以他才会姆叽姆叽的喊着啊。"},{"op":"text","speaker":"","text":"谜团解开了。"},{"op":"goto","target":259},{"op":"text","speaker":"羽依里","text":"“他那种对自己严格要求的态度，是很吸引女孩子的。”"},{"op":"goto","target":341},{"op":"text","speaker":"羽依里","text":"“大概就是我这样的吧。”"},{"op":"image","layer":1,"image":"i12147"},{"op":"text","speaker":"良一","text":"“喂喂，你在说些什么？”"},{"op":"image","layer":257,"image":"i15032"},{"op":"text","speaker":"天善","text":"“就是，没你这么回答的。”"},{"op":"text","speaker":"","text":"天善甚至放下了球拍，把脸转了过来。"},{"op":"text","speaker":"羽依里","text":"“哈哈，也是啊。”"},{"op":"image","layer":257,"image":"i15014"},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“你受欢迎我们早就知道了。”"},{"op":"text","speaker":"羽依里","text":"“哎？”"},{"op":"text","speaker":"","text":"收到了意料之外的回答。"},{"op":"image","layer":257,"image":"i15008"},{"op":"text","speaker":"天善","text":"“不过，就连这种惹人厌的话都能这么爽快地说出来……”"},{"op":"image","layer":257,"image":"i15044"},{"op":"text","speaker":"天善","text":"“这大概也是受欢迎的一个因素吧。”"},{"op":"image","layer":1,"image":"i12156"},{"op":"text","speaker":"良一","text":"“咻――！”"},{"op":"text","speaker":"","text":"咻什么啊。"},{"op":"text","speaker":"羽依里","text":"“不，你们等下！不是那样的啊。”"},{"op":"text","speaker":"","text":"本来只是开个玩笑的，没想到他们当真了。"},{"op":"image","layer":257,"image":"i15014"},{"op":"text","speaker":"天善","text":"“不管你怎么隐藏，那受欢迎的气场可是都藏不住的。”"},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“是啊，就连那个白羽都能和你关系那么好。”"},{"op":"image","layer":257,"image":"i15038"},{"op":"text","speaker":"天善","text":"“而且是关系好到能直呼其名的程度啊。”"},{"op":"text","speaker":"羽依里","text":"“不……那只是碰巧，不是什么大事啊。”"},{"op":"image","layer":1,"image":"i12171"},{"op":"text","speaker":"良一","text":"“出现了，对你来说没什么了不起的对我们来说是却非比寻常的展开。”"},{"op":"text","speaker":"羽依里","text":"“不是啊，这话题打住。”"},{"op":"text","speaker":"","text":"我开始坐立不安了。"},{"op":"image","layer":257,"image":"i15011"},{"op":"text","speaker":"天善","text":"“而且和那个看起来很有修养的旅行箱女生还有紬的关系也很好。”"},{"op":"image","layer":1,"image":"i12174"},{"op":"text","speaker":"良一","text":"“和我们都不太熟的岛上的女生关系也不错。”"},{"op":"image","layer":1,"image":"i12165"},{"op":"text","speaker":"良一","text":"“在这岛上，没人会怀疑你的受欢迎程度!!”"},{"op":"text","speaker":"","text":"饶了我吧。"},{"op":"image","layer":257,"image":"i15008"},{"op":"text","speaker":"天善","text":"“说起来，鹰原你有个有趣的称呼吧？”"},{"op":"if","truth":false,"target":306,"value":["==",["v",24],1]},{"op":"text","speaker":"羽依里","text":"“姑且算有个，他们叫我路西法……”"},{"op":"image","layer":1,"image":"i12162"},{"op":"text","speaker":"良一","text":"“那从今天开始你就是超受欢迎的路西法了。”"},{"op":"goto","target":321},{"op":"if","truth":false,"target":311,"value":["==",["v",25],1]},{"op":"text","speaker":"羽依里","text":"“姑且算有个，他们叫我金丝雀……”"},{"op":"image","layer":1,"image":"i12162"},{"op":"text","speaker":"良一","text":"“那从今天开始你就是超受欢迎的金丝雀了。”"},{"op":"goto","target":321},{"op":"if","truth":false,"target":316,"value":["==",["v",26],1]},{"op":"text","speaker":"羽依里","text":"“姑且算有个，他们叫我王者……”"},{"op":"image","layer":1,"image":"i12162"},{"op":"text","speaker":"良一","text":"“那从今天开始你就是超受欢迎的王者了。”"},{"op":"goto","target":321},{"op":"if","truth":false,"target":321,"value":["==",["v",27],1]},{"op":"text","speaker":"羽依里","text":"“姑且算有个，他们叫我殇鹰……”"},{"op":"image","layer":1,"image":"i12162"},{"op":"text","speaker":"良一","text":"“那从今天开始你就是超受欢迎的殇鹰了。”"},{"op":"goto","target":321},{"op":"image","layer":257,"image":"i15026"},{"op":"text","speaker":"天善","text":"“这称号真是恰当……！”"},{"op":"if","truth":false,"target":327,"value":["==",["v",24],1]},{"op":"set","variable":6001,"value":44},{"op":"callScene","scene":4,"target":2},{"op":"goto","target":339},{"op":"if","truth":false,"target":331,"value":["==",["v",25],1]},{"op":"set","variable":6001,"value":45},{"op":"callScene","scene":4,"target":2},{"op":"goto","target":339},{"op":"if","truth":false,"target":335,"value":["==",["v",26],1]},{"op":"set","variable":6001,"value":46},{"op":"callScene","scene":4,"target":2},{"op":"goto","target":339},{"op":"if","truth":false,"target":339,"value":["==",["v",27],1]},{"op":"set","variable":6001,"value":47},{"op":"callScene","scene":4,"target":2},{"op":"goto","target":339},{"op":"text","speaker":"","text":"真的假的……"},{"op":"text","speaker":"","text":"称号变得难为情了。"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"image","layer":1,"image":"i15011"},{"op":"image","layer":257,"image":"i12144"},{"op":"text","speaker":"良一","text":"“真是让我学到不少。不愧是你啊。”"},{"op":"image","layer":1,"image":"i15014"},{"op":"text","speaker":"天善","text":"“虽然我没什么兴趣，不过万一的时候我就拿来做参考了。”"},{"op":"text","speaker":"羽依里","text":"“好吧……”"},{"op":"text","speaker":"","text":"我试着回想刚才的事。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"不管怎么努力……都没感觉受欢迎。"},{"op":"text","speaker":"","text":"话说到底，从跑到这里的时点开始就不可能啊。"},{"op":"text","speaker":"羽依里","text":"“唔……”"},{"op":"text","speaker":"","text":"我们肯定是放跑了很多能受欢迎的机会……"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"return"},{"op":"end"}]