[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“早上好。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“早上好。”"},{"op":"text","speaker":"羽依里","text":"“呼啊。”"},{"op":"text","speaker":"","text":"咦。"},{"op":"text","speaker":"","text":"桌子上空空如也。"},{"op":"text","speaker":"羽依里","text":"“今天没有早饭吗。”"},{"op":"image","layer":1,"image":"i15401"},{"op":"text","speaker":"羽未","text":"“哼哼哼。”"},{"op":"text","speaker":"","text":"羽未打开冰箱。拿出了某样东西。"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“请用。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"眼前并列着方形物体。"},{"op":"text","speaker":"羽依里","text":"“这是……盒装饮料？”"},{"op":"text","speaker":"羽依里","text":"“这是什么情况。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“哥哥要的东西，我找到了。”"},{"op":"text","speaker":"羽依里","text":"“我要的؟؟要的什么？”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“昨天，说过的。”"},{"op":"text","speaker":"羽依里","text":"“昨天……”"},{"op":"text","speaker":"羽依里","text":"“‘牧场美味咖啡牛奶’。”"},{"op":"image","layer":1,"image":"i15381"},{"op":"text","speaker":"羽未","text":"“卡布奇诺！”"},{"op":"text","speaker":"羽依里","text":"“这是加了玉米的……味噌汤……？”"},{"op":"image","layer":1,"image":"i15384"},{"op":"text","speaker":"羽未","text":"“玉米浓汤！”"},{"op":"text","speaker":"羽依里","text":"“橙……汁؟!”"},{"op":"image","layer":1,"image":"i15401"},{"op":"text","speaker":"羽未","text":"“新鲜橙汁！”"},{"op":"text","speaker":"羽依里","text":"“果汁含量3％，还临近过期……”"},{"op":"text","speaker":"羽依里","text":"“这么一来，牛角面包……”"},{"op":"text","speaker":"","text":"叮！"},{"op":"image","layer":1,"image":"i15538"},{"op":"text","speaker":"羽未","text":"“啊，烤好了。”"},{"op":"text","speaker":"羽依里","text":"“咦？”"},{"op":"text","speaker":"","text":"烤了面包的啊。"},{"op":"text","speaker":"","text":"那么会是你吗？牛角面包！"},{"op":"image","layer":1,"image":"i15445"},{"op":"text","speaker":"羽未","text":"“……请、请用。”"},{"op":"text","speaker":"羽依里","text":"“黑炭……”"},{"op":"image","layer":1,"image":"i15436"},{"op":"text","speaker":"羽未","text":"“烤过头了……”"},{"op":"text","speaker":"羽依里","text":"“再说，这玩意大概原本是吐司吧。”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“我没找到牛角面包。”"},{"op":"image","layer":1,"image":"i15363"},{"op":"text","speaker":"羽未","text":"“昨天找了很久，但是找不到。”"},{"op":"text","speaker":"羽依里","text":"“谢谢你为我做这么多。”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“没什么的。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“吃吧。”"},{"op":"text","speaker":"羽依里","text":"“嗯，一起吃吧。”"},{"op":"text","speaker":"羽依里","text":"“但是，面包还是别吃了吧。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“嗯！”"},{"op":"return"},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"if","truth":false,"target":122,"value":["==",["v",55],1]},{"op":"image","layer":1,"image":"i15552"},{"op":"text","speaker":"羽未","text":"“我开动啦。”"},{"op":"text","speaker":"羽依里","text":"“我开动了。”"},{"op":"text","speaker":"","text":"晚餐吃回了乌冬杯面。"},{"op":"text","speaker":"","text":"味道稳定又好吃。"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“嘶嘶……吸吸……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i15468"},{"op":"text","speaker":"羽未","text":"“……?”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“怎么了？”"},{"op":"text","speaker":"羽依里","text":"“……没什么。”"},{"op":"text","speaker":"","text":"不好不好。一不留神就盯着她看了。"},{"op":"text","speaker":"","text":"不喜欢被人盯着吗。"},{"op":"text","speaker":"","text":"果然是这么回事吧。"},{"op":"choice","variable":6001,"items":[{"text":"注视","value":0,"condition":1},{"text":"移开视线","value":1,"condition":1}]},{"op":"if","truth":false,"target":115,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i15468"},{"op":"text","speaker":"羽未","text":"“……？”"},{"op":"choice","variable":6001,"items":[{"text":"继续注视","value":0,"condition":1},{"text":"还是算了","value":1,"condition":1}]},{"op":"if","truth":false,"target":113,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“唔～…为什么盯着我看啊……？”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“唔～～～”"},{"op":"choice","variable":6001,"items":[{"text":"仍然继续注视","value":0,"condition":1},{"text":"差不多算了","value":1,"condition":1}]},{"op":"if","truth":false,"target":111,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“你，你在意淫吗……？”"},{"op":"text","speaker":"羽依里","text":"“怎么可能！”"},{"op":"text","speaker":"羽依里","text":"“我听说女孩子吃饭的时候讨厌被人盯着看，就想确认下。”"},{"op":"image","layer":1,"image":"i15340"},{"op":"text","speaker":"羽未","text":"“嗯，讨厌的。”"},{"op":"image","layer":1,"image":"i15360"},{"op":"text","speaker":"羽未","text":"“非常……讨厌，所以别看了。”"},{"op":"text","speaker":"羽依里","text":"“嗯，对不起。”"},{"op":"text","speaker":"","text":"结论。"},{"op":"text","speaker":"","text":"不能盯着吃饭的女孩子看。"},{"op":"goto","target":112},{"op":"goto","target":115},{"op":"goto","target":114},{"op":"goto","target":115},{"op":"goto","target":117},{"op":"text","speaker":"","text":"好孩子不要学我。"},{"op":"text","speaker":"","text":"稍微站在别人角度想想吧。"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"text","speaker":"","text":"晚饭后――"},{"op":"goto","target":122},{"op":"text","speaker":"","text":"羽未靠着柱子，看起了我带来的漫画。"},{"op":"text","speaker":"","text":"虽然是多管闲事，但我还是想问一句。"},{"op":"text","speaker":"羽依里","text":"“你不用写作业之类的吗。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“嗯……要写哦。”"},{"op":"text","speaker":"羽依里","text":"“你有写吗。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“有哦。”"},{"op":"text","speaker":"羽依里","text":"“好厉害啊，一天到晚都跑出去玩我还以为你没写呢。”"},{"op":"image","layer":1,"image":"i15401"},{"op":"text","speaker":"羽未","text":"“有安排好计划了的。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“哥哥呢？”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“没见过你在写哦？”"},{"op":"text","speaker":"羽依里","text":"“我属于被逼到绝境才会努力的那种人。”"},{"op":"image","layer":1,"image":"i15589"},{"op":"text","speaker":"羽未","text":"“好厉害！”"},{"op":"text","speaker":"羽依里","text":"“啊……毫无保留的信赖太耀眼了……”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"之后，我回到了房间……"},{"op":"image","layer":0,"image":"i516"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“……嗯，我记得作业是放在这里来着吧。”"},{"op":"text","speaker":"","text":"决定写一写作业。"},{"op":"text","speaker":"","text":"我着笔于尚且一片空白的作业本。"},{"op":"return"},{"op":"end"}]