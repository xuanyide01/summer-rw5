[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i69"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"","text":"早上，我神清气爽地醒了过来。"},{"op":"text","speaker":"","text":"昨天那种阴郁的心情仿佛都是假的一样。"},{"op":"text","speaker":"","text":"一口气利落地坐了起来。"},{"op":"text","speaker":"羽依里","text":"“好。”"},{"op":"text","speaker":"","text":"身体也很轻盈。就像是重获新生了一样。"},{"op":"text","speaker":"","text":"不，或许我真的在这座岛上脱胎换骨了。"},{"op":"text","speaker":"","text":"但这还不是结束。"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“早上好。”"},{"op":"image","layer":1,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“早上好。”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“看来你已经彻底打起精神了呢。”"},{"op":"text","speaker":"羽依里","text":"“是啊，这都要感谢你。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"if","truth":false,"target":27,"value":["==",["v",24],1]},{"op":"text","speaker":"羽未","text":"“受伤的翅膀痊愈了吗？”"},{"op":"goto","target":36},{"op":"if","truth":false,"target":30,"value":["==",["v",25],1]},{"op":"text","speaker":"羽未","text":"“金丝雀回想起歌声了吗？”"},{"op":"goto","target":36},{"op":"if","truth":false,"target":33,"value":["==",["v",26],1]},{"op":"text","speaker":"羽未","text":"“拳击手的拳头治好了吗？”"},{"op":"goto","target":36},{"op":"if","truth":false,"target":36,"value":["==",["v",27],1]},{"op":"text","speaker":"羽未","text":"“牛郎想起来怎么搭讪了吗？”"},{"op":"goto","target":36},{"op":"text","speaker":"羽依里","text":"“哈哈，这台词也挺怀念的。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“呵呵，这样就能放心回去了呢。”"},{"op":"text","speaker":"","text":"羽未虽然笑着，但语气中却略微带着些寂寞。"},{"op":"text","speaker":"","text":"我对着羽未摇了摇头。"},{"op":"text","speaker":"羽依里","text":"“不，我还不能回去。”"},{"op":"text","speaker":"羽依里","text":"“我还有事情要做。”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“……？什么事情啊？”"},{"op":"text","speaker":"","text":"我直视着有些困惑的羽未。"},{"op":"text","speaker":"羽依里","text":"“这件事，我也想请羽未帮帮忙。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“哎？”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i513"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i18"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我和羽未来到了小学的游泳池。"},{"op":"image","layer":1,"image":"i15780"},{"op":"text","speaker":"羽未","text":"“我们随便进来这里没问题吗？”"},{"op":"text","speaker":"羽依里","text":"“没事的，我已经取得许可了。”"},{"op":"text","speaker":"","text":"我去村公所商量了一下，就帮我向学校申请到了许可。"},{"op":"text","speaker":"","text":"所以现在可以光明正大地使用游泳池。"},{"op":"text","speaker":"","text":"我在这里要做的，当然只有那一件事。"},{"op":"text","speaker":"羽依里","text":"“我要重新找回以前游泳时的那种状态。”"},{"op":"image","layer":1,"image":"i15809"},{"op":"text","speaker":"羽未","text":"“真的要这样吗？”"},{"op":"text","speaker":"羽依里","text":"“羽未不是也说了吗，休息时间已经结束了。”"},{"op":"image","layer":1,"image":"i15801"},{"op":"text","speaker":"羽未","text":"“确实说过。”"},{"op":"text","speaker":"羽依里","text":"“而且，你还说过想看我游泳来着。”"},{"op":"image","layer":1,"image":"i15812"},{"op":"text","speaker":"羽未","text":"“鹰原哥……”"},{"op":"text","speaker":"羽依里","text":"“要想回到他们身边的话，至少得做到这个程度才行啊。”"},{"op":"text","speaker":"","text":"现在回去，也只会拖累他们而已。"},{"op":"text","speaker":"","text":"如果只是一味地接受他们的善意，那也太不像话了。"},{"op":"image","layer":1,"image":"i15768"},{"op":"text","speaker":"羽未","text":"“我明白了。那我需要做些什么呢？”"},{"op":"text","speaker":"羽依里","text":"“用这个，帮我计下时。”"},{"op":"image","layer":1,"image":"i15812"},{"op":"text","speaker":"","text":"我把秒表递给了羽未。"},{"op":"text","speaker":"","text":"这也是从村公所那里借来的。使用方法也已经都告诉了我。"},{"op":"text","speaker":"","text":"我唰地一下脱掉衣服。"},{"op":"image","layer":1,"image":"i15815"},{"op":"text","speaker":"羽未","text":"“呀!؟”"},{"op":"text","speaker":"羽依里","text":"“你害羞什么啊？我穿着泳衣呢。”"},{"op":"image","layer":1,"image":"i15807"},{"op":"text","speaker":"羽未","text":"“是、是这样没错……但是太突然了嘛。”"},{"op":"text","speaker":"羽依里","text":"“咱们不是都是一起泡过澡的关系吗。”"},{"op":"image","layer":1,"image":"i15774"},{"op":"text","speaker":"羽未","text":"“这种说法有歧义！”"},{"op":"image","layer":1,"image":"i15782"},{"op":"text","speaker":"羽未","text":"“总之我会帮你计时的。”"},{"op":"text","speaker":"羽依里","text":"“嗯，拜托你了。”"},{"op":"text","speaker":"","text":"我站在泳池边上，看着水面。"},{"op":"text","speaker":"","text":"因为是游泳的季节，泳池彻底清洁过一番，水也非常清澈。"},{"op":"text","speaker":"","text":"水底都能看得一清二楚。"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"","text":"然而，我却感觉那就像是无底深渊。"},{"op":"image","layer":1,"image":"i15896"},{"op":"text","speaker":"羽未","text":"“怎么了吗？”"},{"op":"text","speaker":"羽依里","text":"“唉……”"},{"op":"text","speaker":"羽依里","text":"“羽未……”"},{"op":"image","layer":1,"image":"i15917"},{"op":"text","speaker":"羽未","text":"“你说。”"},{"op":"text","speaker":"羽依里","text":"“我有点怕水啊，该怎么办？”"},{"op":"image","layer":1,"image":"i15922"},{"op":"text","speaker":"羽未","text":"“刚才那个帅气的鹰原哥去哪儿了啊！”"},{"op":"text","speaker":"羽依里","text":"“不是，我以为一鼓作气跳下去就行了，但果然还是会害怕啊，嗯。”"},{"op":"image","layer":1,"image":"i15824"},{"op":"text","speaker":"羽未","text":"“别说这些不争气的话了，快点下水吧。”"},{"op":"text","speaker":"羽依里","text":"“啊，对了，我得好好做下准备运动。”"},{"op":"image","layer":1,"image":"i15827"},{"op":"text","speaker":"羽未","text":"“别管那些了快点下去！”"},{"op":"text","speaker":"羽依里","text":"“呀啊啊啊――！”"},{"op":"text","speaker":"羽依里","text":"“你、你要干什……么……要、要淹死了……！”"},{"op":"image","layer":1,"image":"i15812"},{"op":"text","speaker":"羽未","text":"“这可是小学生用的游泳池，在水里能站住的吧？”"},{"op":"text","speaker":"羽依里","text":"“……啊。”"},{"op":"text","speaker":"","text":"站住了。水非常浅，才刚到腰的附近。"},{"op":"image","layer":1,"image":"i15764"},{"op":"text","speaker":"羽未","text":"“快点游起来吧。需要浮板吗？”"},{"op":"text","speaker":"羽依里","text":"“……不用了，没问题，我可以游。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i18"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“嗯……哦哦……”"},{"op":"text","speaker":"","text":"我拼命地拨弄着水。"},{"op":"text","speaker":"","text":"对水依然有着不小的恐惧感。"},{"op":"text","speaker":"","text":"可能就是因为这样，我很快就会喘不过气来。身体也不太听使唤，就好像不是自己的一样。"},{"op":"image","layer":7,"image":"i15885"},{"op":"text","speaker":"羽未","text":"“鹰原哥，加油啊――！”"},{"op":"text","speaker":"","text":"听到了羽未的加油声。"},{"op":"text","speaker":"","text":"这声音反而让我感到了压力，身体就越发僵硬，姿势也都乱套了。"},{"op":"text","speaker":"羽依里","text":"“呜噗……”"},{"op":"text","speaker":"","text":"结果因为太过难受，游到一半就站了起来。"},{"op":"image","layer":7,"image":"i15924"},{"op":"text","speaker":"羽未","text":"“唉，明明就只差一点了！”"},{"op":"text","speaker":"羽依里","text":"“不，完全不行。这样根本就算不上会游泳。”"},{"op":"image","layer":7,"image":"i15779"},{"op":"text","speaker":"羽未","text":"“不要这么没信心嘛。”"},{"op":"text","speaker":"羽依里","text":"“唉，突然下水果然还是太勉强了吗……”"},{"op":"text","speaker":"","text":"不禁说出了泄气的话。"},{"op":"image","layer":1,"image":"i15812"},{"op":"text","speaker":"羽未","text":"“我想到了。”"},{"op":"image","layer":1,"image":"i15764"},{"op":"text","speaker":"羽未","text":"“我也要跟你一起游。”"},{"op":"text","speaker":"羽依里","text":"“哎？一起游是……”"},{"op":"image","layer":1,"image":"i15886"},{"op":"text","speaker":"","text":"羽未站在泳池边上，突然脱起了衣服。"},{"op":"text","speaker":"羽依里","text":"“咦？等等，你在想什……”"},{"op":"image","layer":1,"image":"i15920"},{"op":"text","speaker":"羽未","text":"“嘿!!”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"羽依里","text":"“哇啊啊啊啊啊!!”"},{"op":"text","speaker":"","text":"我下意识用手捂住了脸。"},{"op":"image","layer":7,"image":"i16025"},{"op":"text","speaker":"羽未","text":"“你在做什么啊？”"},{"op":"text","speaker":"羽依里","text":"“因、因为羽未要脱光……”"},{"op":"image","layer":7,"image":"i16019"},{"op":"text","speaker":"羽未","text":"“怎么可能啊。你仔细看看啦。”"},{"op":"text","speaker":"羽依里","text":"“咦……？”"},{"op":"image","layer":0,"image":"i18"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i16023"},{"op":"text","speaker":"羽未","text":"“锵――！”"},{"op":"text","speaker":"羽依里","text":"“咦，泳衣？原来你里面穿着泳衣啊？”"},{"op":"image","layer":1,"image":"i16027"},{"op":"text","speaker":"羽未","text":"“既然要来游泳池，我就提前穿好了。”"},{"op":"image","layer":1,"image":"i16010"},{"op":"text","speaker":"羽未","text":"“不然我怎么可能在这里脱衣服啊。”"},{"op":"image","layer":1,"image":"i16015"},{"op":"text","speaker":"羽未","text":"“我才没有那么小孩子气呢。”"},{"op":"text","speaker":"羽依里","text":"“也是啊。”"},{"op":"text","speaker":"","text":"明明就还是个小孩子――……虽然我这么想，但还是不要说出来了吧。"},{"op":"text","speaker":"","text":"我在这个岛上学到了一个道理，那就是祸从口出。"},{"op":"text","speaker":"羽依里","text":"“那么，换上泳衣之后呢？”"},{"op":"image","layer":1,"image":"i16010"},{"op":"text","speaker":"羽未","text":"“你来教教我怎么游泳。”"},{"op":"text","speaker":"羽依里","text":"“啊，教羽未？我来教吗？”"},{"op":"image","layer":1,"image":"i16013"},{"op":"text","speaker":"羽未","text":"“对。不是说教别人的时候，自己也能领悟到一些东西吗。”"},{"op":"text","speaker":"羽依里","text":"“啊，确实是这样。”"},{"op":"text","speaker":"","text":"教导别人的时候，或许就能回想起正确的姿势了。"},{"op":"text","speaker":"羽依里","text":"“明白了，我试试看。”"},{"op":"image","layer":1,"image":"i16010"},{"op":"text","speaker":"羽未","text":"“好的。”"},{"op":"text","speaker":"羽依里","text":"“羽未，谢谢你啊。”"},{"op":"image","layer":1,"image":"i16024"},{"op":"text","speaker":"羽未","text":"“道、道谢就不必了，我们快点开始吧！”"},{"op":"text","speaker":"羽依里","text":"“好！”"},{"op":"text","speaker":"羽依里","text":"“那就先从摆腿开始吧！”"},{"op":"image","layer":1,"image":"i16013"},{"op":"text","speaker":"羽未","text":"“好的！”"},{"op":"text","speaker":"","text":"于是，我们两个人就一直练习游泳，直到太阳下山。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]