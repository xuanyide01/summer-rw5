[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"set","variable":7120,"value":0},{"op":"image","layer":2,"image":"i743"},{"op":"image","layer":0,"image":"i513"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"第二天早上，我们再次来到食堂挑战做炒饭。"},{"op":"text","speaker":"","text":"炒的时候，我加上了新弄到的葵花籽。"},{"op":"text","speaker":"","text":"接下来，还是按照我印象里的方法做。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":2},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i15"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"七海","text":"“……”"},{"op":"image","layer":1,"image":"i12292"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"七海","text":"“最后撒上胡椒。”"},{"op":"text","speaker":"","text":"再翻炒一下。"},{"op":"image","layer":1,"image":"i12304"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"七海","text":"“……”"},{"op":"text","speaker":"","text":"这样就完成了吧？"},{"op":"text","speaker":"","text":"不知道这次做出来的是不是白羽爸爸做的烤饭。"},{"op":"text","speaker":"七海","text":"“好了，来尝尝吧。”"},{"op":"image","layer":1,"image":"i12295"},{"op":"text","speaker":"白羽","text":"“嗯！”"},{"op":"image","layer":1,"image":"i12322"},{"op":"text","speaker":"白羽","text":"“嚼嚼……”"},{"op":"text","speaker":"七海","text":"“怎么样？”"},{"op":"image","layer":1,"image":"i12298"},{"op":"text","speaker":"白羽","text":"“……好吃！”"},{"op":"text","speaker":"七海","text":"“味道一样吗？”"},{"op":"image","layer":1,"image":"i12292"},{"op":"text","speaker":"白羽","text":"“还差一点，胡椒味好像应该再重一点。”"},{"op":"text","speaker":"七海","text":"“好嘞。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i15"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"七海","text":"“这次怎么样？”"},{"op":"image","layer":1,"image":"i12301"},{"op":"text","speaker":"白羽","text":"“对不起，这次又太重了。”"},{"op":"text","speaker":"七海","text":"“嗯嗯。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i15"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"七海","text":"“那这次呢？”"},{"op":"image","layer":1,"image":"i12304"},{"op":"text","speaker":"白羽","text":"“啊……”"},{"op":"text","speaker":"七海","text":"“怎、怎么了？”"},{"op":"image","layer":1,"image":"i12322"},{"op":"text","speaker":"白羽","text":"“……就是这个。”"},{"op":"image","layer":1,"image":"i12295"},{"op":"text","speaker":"白羽","text":"“这个，就是爸爸的味道。”"},{"op":"text","speaker":"七海","text":"“这样啊。”"},{"op":"image","layer":1,"image":"i12322"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"image","layer":1,"image":"i12295"},{"op":"text","speaker":"白羽","text":"“谢谢你。”"},{"op":"text","speaker":"七海","text":"“这是咱们共同努力的成果啊。”"},{"op":"image","layer":1,"image":"i12298"},{"op":"text","speaker":"白羽","text":"“嗯！”"},{"op":"text","speaker":"七海","text":"“好，我也来尝尝看吧。”"},{"op":"text","speaker":"七海","text":"“……”"},{"op":"text","speaker":"","text":"好吃。"},{"op":"text","speaker":"","text":"而且，这个味道……"},{"op":"text","speaker":"七海","text":"“好怀念。”"},{"op":"image","layer":1,"image":"i12304"},{"op":"text","speaker":"白羽","text":"“哎？”"},{"op":"text","speaker":"七海","text":"“这个，我有吃过。”"},{"op":"image","layer":1,"image":"i12322"},{"op":"text","speaker":"白羽","text":"“真的吗？”"},{"op":"image","layer":1,"image":"i12295"},{"op":"text","speaker":"白羽","text":"“难道七海你以前有来岛上，在这里吃过吗？”"},{"op":"text","speaker":"七海","text":"“这我就不清楚了。”"},{"op":"text","speaker":"七海","text":"“怎么说呢。”"},{"op":"text","speaker":"","text":"为什么呢？"},{"op":"text","speaker":"","text":"泪水从眼角溢出。"},{"op":"image","layer":1,"image":"i12339"},{"op":"text","speaker":"白羽","text":"“七海？”"},{"op":"text","speaker":"","text":"是啊。"},{"op":"text","speaker":"","text":"我一定是在哪里吃过这个。"},{"op":"image","layer":1,"image":"i12337"},{"op":"text","speaker":"白羽","text":"“你没事吧？”"},{"op":"text","speaker":"七海","text":"“啊。”"},{"op":"set","variable":26028,"value":1},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我的脑海中突然变得一片白。"},{"op":"text","speaker":"","text":"耀眼到几乎无法睁开眼睛的光芒笼罩了我。"},{"op":"image","layer":1795,"image":"i18201"},{"op":"image","layer":0,"image":"i1506"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"但是，光芒之中……"},{"op":"text","speaker":"","text":"我确实能看到。"},{"op":"text","speaker":"","text":"也能确实能听到……"},{"op":"text","speaker":"؟؟؟","text":"‘没关系的。’"},{"op":"text","speaker":"","text":"那是……我的记忆。"},{"op":"image","layer":0,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"؟؟؟","text":"‘妈妈来帮你。’"},{"op":"image","layer":0,"image":"i1412"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"؟؟؟","text":"‘还想一起放纸飞机吗？’"},{"op":"image","layer":0,"image":"i1476"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"؟؟؟","text":"‘嗯，放纸飞机。’"},{"op":"text","speaker":"؟؟؟","text":"‘好，那么爸爸先去做饭啦。’"},{"op":"text","speaker":"؟؟؟","text":"‘炒饭。’"},{"op":"text","speaker":"؟؟؟","text":"‘嗯，因为爸爸只会做炒饭啊。’"},{"op":"text","speaker":"؟؟؟","text":"‘不过，很好吃哦。’"},{"op":"text","speaker":"؟؟؟","text":"‘毕竟是妈妈亲自传授的。’"},{"op":"text","speaker":"؟؟؟","text":"‘想要，吃炒饭。’"},{"op":"text","speaker":"؟؟؟","text":"‘爸爸，真的能做出好吃的炒饭吗？’"},{"op":"text","speaker":"؟؟؟","text":"‘你就瞧好吧。’"},{"op":"image","layer":0,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"؟؟؟","text":"‘妈妈，我可以吃了吗？’"},{"op":"image","layer":257,"image":"i13238"},{"op":"text","speaker":"؟؟؟","text":"‘嗯，快吃吧。’"},{"op":"image","layer":1,"image":"i15593"},{"op":"text","speaker":"؟؟؟","text":"‘我开动啦。’"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"؟؟؟","text":"‘啊呜……嚼嚼……’"},{"op":"text","speaker":"؟؟؟","text":"‘嚼嚼……’"},{"op":"text","speaker":"؟؟؟","text":"‘真……真好吃……这炒饭都可以摆出去卖了。’"},{"op":"image","layer":1,"image":"i15347"},{"op":"text","speaker":"؟؟؟","text":"‘嗯嗯――――！’"},{"op":"image","layer":1,"image":"i15334"},{"op":"text","speaker":"؟؟؟","text":"‘90分！’"},{"op":"text","speaker":"؟؟؟","text":"‘这都不是100分？你还真严格啊。’"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"؟؟؟","text":"‘感觉离100分还差一点。’"},{"op":"text","speaker":"؟؟؟","text":"‘羽未，你喜欢炒饭吗？’"},{"op":"image","layer":1,"image":"i15547"},{"op":"text","speaker":"؟؟؟","text":"‘喜欢。’"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"؟؟؟","text":"‘雪耻炒饭·改！’"},{"op":"image","layer":1,"image":"i15436"},{"op":"text","speaker":"؟؟؟","text":"‘……11分。’"},{"op":"text","speaker":"؟؟؟","text":"‘好耶！上两位数了！’"},{"op":"text","speaker":"؟؟؟","text":"‘等等……仅仅是11分啊……’"},{"op":"image","layer":1,"image":"i15363"},{"op":"text","speaker":"؟؟؟","text":"‘……只是把米饭炒散而已。’"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"؟؟؟","text":"‘……没有，味道。’"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"set","variable":7120,"value":0},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"؟؟؟","text":"‘羽未，乐一个吧。’"},{"op":"text","speaker":"؟؟؟","text":"‘白羽说愿意做你的妈妈。’"},{"op":"image","layer":1,"image":"i15560"},{"op":"text","speaker":"؟؟؟","text":"‘唉……’"},{"op":"image","layer":257,"image":"i13304"},{"op":"text","speaker":"؟؟؟","text":"‘你，你好。’"},{"op":"image","layer":1,"image":"i15563"},{"op":"text","speaker":"؟؟؟","text":"‘………’"},{"op":"image","layer":1,"image":"i15525"},{"op":"text","speaker":"؟؟؟","text":"‘……呜哔。’"},{"op":"text","speaker":"؟؟؟","text":"‘呜哔？那是什么呀？’"},{"op":"text","speaker":"؟؟؟","text":"‘人家向你问好呢，你该怎么回人家呀？’"},{"op":"image","layer":1,"image":"i15573"},{"op":"text","speaker":"؟؟؟","text":"‘……咕哔。’"},{"op":"image","layer":257,"image":"i13387"},{"op":"text","speaker":"؟؟؟","text":"‘……哈哔？’"},{"op":"text","speaker":"؟؟؟","text":"‘羽未，你不是有事想和妈妈一起做吗？’"},{"op":"image","layer":1,"image":"i15560"},{"op":"text","speaker":"؟؟؟","text":"‘……！’"},{"op":"text","speaker":"؟؟؟","text":"‘～～～……’"},{"op":"image","layer":257,"image":"i13354"},{"op":"text","speaker":"؟؟؟","text":"‘我该怎么做……’"},{"op":"text","speaker":"؟؟؟","text":"‘呃，嗯……’"},{"op":"text","speaker":"؟؟؟","text":"‘～～～’"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"؟؟؟","text":"‘好啊，我们一起拍吧。’"},{"op":"text","speaker":"؟؟؟","text":"‘三个人一起。’"},{"op":"text","speaker":"؟؟؟","text":"‘嗯。’"},{"op":"text","speaker":"؟؟؟","text":"‘那么，羽未站正中间。’"},{"op":"image","layer":0,"image":"i1456"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"؟؟؟","text":"‘再靠近点。’"},{"op":"text","speaker":"؟؟؟","text":"‘要开始拍了哦。’"},{"op":"text","speaker":"؟؟؟","text":"‘预备，茄子！’"},{"op":"image","layer":0,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i1470"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"؟؟؟","text":"‘能看到烟花，真是太好了……’"},{"op":"text","speaker":"؟؟؟","text":"‘真的，好美啊。’"},{"op":"text","speaker":"؟؟؟","text":"‘嗯，好美啊。’"},{"op":"text","speaker":"؟؟؟","text":"‘能遵守约定，真是太好了。’"},{"op":"text","speaker":"؟؟؟","text":"‘谢谢你……爸爸……’"},{"op":"text","speaker":"؟؟؟","text":"‘但是，已经不用了……’"},{"op":"text","speaker":"؟؟؟","text":"‘……已经，全都实现了……’"},{"op":"text","speaker":"؟؟؟","text":"‘这个暑假，真的非常开心……’"},{"op":"image","layer":0,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"؟؟؟","text":"‘……羽未，难道你……’"},{"op":"text","speaker":"؟؟؟","text":"‘……是来自未来的吗？’"},{"op":"image","layer":1,"image":"i15436"},{"op":"text","speaker":"؟؟؟","text":"‘……我是……来见妈妈的。’"},{"op":"image","layer":1,"image":"i15442"},{"op":"text","speaker":"؟؟؟","text":"‘因为……妈妈已经不在了。’"},{"op":"image","layer":1,"image":"i15422"},{"op":"text","speaker":"؟؟؟","text":"‘我从来……没有见过妈妈。’"},{"op":"image","layer":1,"image":"i15436"},{"op":"text","speaker":"؟؟؟","text":"‘于是……为了见到她，我来到了这座岛。’"},{"op":"image","layer":1,"image":"i15366"},{"op":"text","speaker":"؟؟؟","text":"‘……――从未来。’"},{"op":"text","speaker":"؟؟؟","text":"‘羽未，能多告诉我一些你的事吗？’"},{"op":"image","layer":1,"image":"i15360"},{"op":"text","speaker":"؟؟؟","text":"‘……嗯。’"},{"op":"image","layer":1,"image":"i15366"},{"op":"text","speaker":"؟؟؟","text":"‘那个……我从小的时候，就有着一种神奇的力量。’"},{"op":"text","speaker":"؟؟؟","text":"‘神奇的力量？’"},{"op":"image","layer":1,"image":"i15445"},{"op":"text","speaker":"؟؟؟","text":"‘是可以只让自己的内心，稍微回到过去的力量……’"},{"op":"text","speaker":"羽依里","text":"‘只让内心，回到过去……？’"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i1487"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"对啊。"},{"op":"text","speaker":"","text":"我是……从非常遥远的地方来到这里的……"},{"op":"text","speaker":"","text":"在那个夏天，我们三个人共同度过了一个快乐的暑假。"},{"op":"text","speaker":"","text":"那之后的未来，也是无比的幸福闪耀。"},{"op":"text","speaker":"","text":"但是那份幸福……突然之间……就轻易化为了泡影……"},{"op":"text","speaker":"","text":"所以，我来到了这里。"},{"op":"text","speaker":"","text":"借助他人的力量来到这里。"},{"op":"text","speaker":"","text":"为了拯救白羽……"},{"op":"text","speaker":"","text":"拯救我无比重要的人……"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1795},{"op":"clear","layer":1539},{"op":"set","variable":7120,"value":1},{"op":"image","layer":0,"image":"i16"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i12305"},{"op":"text","speaker":"白羽","text":"“嗯？”"},{"op":"text","speaker":"","text":"我一直直直盯着白羽的脸。"},{"op":"text","speaker":"七海","text":"“没事的……”"},{"op":"text","speaker":"","text":"我转开脸，低下头去。"},{"op":"text","speaker":"七海","text":"“……”"},{"op":"image","layer":1,"image":"i12293"},{"op":"text","speaker":"白羽","text":"“七海……”"},{"op":"image","layer":1,"image":"i12296"},{"op":"text","speaker":"白羽","text":"“乖啊乖。”"},{"op":"text","speaker":"","text":"白羽的小手，抚摸着我的头。"},{"op":"text","speaker":"七海","text":"“白羽？”"},{"op":"image","layer":1,"image":"i12299"},{"op":"text","speaker":"白羽","text":"“没事的。”"},{"op":"text","speaker":"白羽","text":"“七海的身边……有我在呢。”"},{"op":"text","speaker":"七海","text":"“谢谢你。”"},{"op":"text","speaker":"","text":"虽然样貌已经不同……"},{"op":"text","speaker":"","text":"但我还是再次见到了她……"},{"op":"text","speaker":"","text":"又能像这样……触碰到她……"},{"op":"image","layer":1,"image":"i12296"},{"op":"text","speaker":"白羽","text":"“我想让外公也尝一尝。”"},{"op":"text","speaker":"七海","text":"“哎？”"},{"op":"text","speaker":"白羽","text":"“这个烤饭，外公他以前也非常爱吃的。”"},{"op":"image","layer":1,"image":"i12302"},{"op":"text","speaker":"白羽","text":"“爸爸和妈妈都不在了以后，外公一直都很寂寞。”"},{"op":"text","speaker":"","text":"这样啊。"},{"op":"text","speaker":"","text":"原来，她是为了外公做的啊。"},{"op":"text","speaker":"七海","text":"“那咱们就把它带回家，大家一起吃吧。”"},{"op":"image","layer":1,"image":"i12299"},{"op":"text","speaker":"白羽","text":"“嗯！”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i436"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"","text":"我和白羽手牵着手，走在回家的路上……"},{"op":"text","speaker":"","text":"我全都想起来了。"},{"op":"text","speaker":"","text":"我是从未来来到这里的。"},{"op":"text","speaker":"","text":"白羽曾经在孩提时代，得到了让自己的内心回到过去的力量。"},{"op":"text","speaker":"","text":"为了逃离那难以忍受的孤独。"},{"op":"text","speaker":"","text":"比起未来，她更加憧憬着过去。"},{"op":"text","speaker":"","text":"想必，就是发生在她的父亲去世、母亲失踪的这个夏天里。"},{"op":"text","speaker":"","text":"所以，我才会来到这里。"},{"op":"text","speaker":"","text":"究竟如何才能阻止她得到那种力量，"},{"op":"text","speaker":"","text":"我现在还不清楚……"},{"op":"text","speaker":"","text":"但我已经下定决心，一定要拯救白羽……拯救我心中最为重要的人。"},{"op":"text","speaker":"","text":"为了终结那不断轮回往复的夏天。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i91"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i12298"},{"op":"text","speaker":"白羽","text":"“我回来了～”"},{"op":"text","speaker":"七海","text":"“我回来了。”"},{"op":"image","layer":257,"image":"i12403"},{"op":"text","speaker":"小鸠","text":"“回来了啊。”"},{"op":"text","speaker":"小鸠","text":"“怎么回来这么晚，去哪玩了？”"},{"op":"text","speaker":"七海","text":"“那个……”"},{"op":"text","speaker":"","text":"我带着和之前不一样的心情看着老爷子。"},{"op":"text","speaker":"小鸠","text":"“……怎么了？”"},{"op":"text","speaker":"七海","text":"“没什么。”"},{"op":"text","speaker":"七海","text":"“其实，我们为外公准备了一份礼物。”"},{"op":"image","layer":257,"image":"i12408"},{"op":"text","speaker":"小鸠","text":"“外公？”"},{"op":"text","speaker":"七海","text":"“啊，不对，是为老爷子您准备的。”"},{"op":"image","layer":257,"image":"i12413"},{"op":"text","speaker":"小鸠","text":"“你怎么叫无所谓。”"},{"op":"image","layer":257,"image":"i12403"},{"op":"text","speaker":"小鸠","text":"“不过，居然要送我礼物啊？”"},{"op":"text","speaker":"七海","text":"“快来。”"},{"op":"text","speaker":"","text":"我向白羽使了个眼色。"},{"op":"image","layer":1,"image":"i12292"},{"op":"text","speaker":"白羽","text":"“嗯，这个。”"},{"op":"text","speaker":"小鸠","text":"“这是……？”"},{"op":"text","speaker":"七海","text":"“烤饭。”"},{"op":"image","layer":257,"image":"i12408"},{"op":"text","speaker":"小鸠","text":"“什么？”"},{"op":"image","layer":257,"image":"i12410"},{"op":"text","speaker":"小鸠","text":"“烤饭？”"},{"op":"text","speaker":"七海","text":"“这是白羽做的。”"},{"op":"image","layer":1,"image":"i12295"},{"op":"text","speaker":"白羽","text":"“那、那个。是我和七海一起做的。”"},{"op":"image","layer":257,"image":"i12408"},{"op":"text","speaker":"小鸠","text":"“白羽做的？”"},{"op":"text","speaker":"小鸠","text":"“嗯……烤饭啊……”"},{"op":"text","speaker":"","text":"老爷子拿起勺子，尝了一口烤饭。"},{"op":"image","layer":1,"image":"i12403"},{"op":"text","speaker":"小鸠","text":"“这!؟”"},{"op":"image","layer":1,"image":"i12408"},{"op":"text","speaker":"小鸠","text":"“这个味道……”"},{"op":"image","layer":7,"image":"i12297"},{"op":"text","speaker":"白羽","text":"“那、那个……我……”"},{"op":"image","layer":1,"image":"i12411"},{"op":"text","speaker":"小鸠","text":"“这是怎么回事？”"},{"op":"image","layer":7,"image":"i12303"},{"op":"text","speaker":"白羽","text":"“哎？”"},{"op":"text","speaker":"小鸠","text":"“白羽。”"},{"op":"text","speaker":"小鸠","text":"“我应该说过很多次了，不许靠近食堂！”"},{"op":"image","layer":7,"image":"i12300"},{"op":"text","speaker":"白羽","text":"“可、可是……”"},{"op":"image","layer":1,"image":"i12403"},{"op":"text","speaker":"小鸠","text":"“你们到底在那里做了什么？”"},{"op":"text","speaker":"七海","text":"“白羽想要重现她爸爸做的炒……烤饭。”"},{"op":"image","layer":1,"image":"i12411"},{"op":"text","speaker":"小鸠","text":"“你说什么？”"},{"op":"text","speaker":"小鸠","text":"“愚蠢。”"},{"op":"image","layer":1,"image":"i12403"},{"op":"text","speaker":"小鸠","text":"“为什么要做这种蠢事！”"},{"op":"image","layer":7,"image":"i12300"},{"op":"text","speaker":"白羽","text":"“啊!؟”"},{"op":"image","layer":7,"image":"i12316"},{"op":"text","speaker":"白羽","text":"“我……只是……”"},{"op":"image","layer":7,"image":"i12308"},{"op":"text","speaker":"白羽","text":"“对不起！”"},{"op":"text","speaker":"","text":"白羽冲出了客厅。"},{"op":"image","layer":1,"image":"i12408"},{"op":"text","speaker":"小鸠","text":"“……”"},{"op":"text","speaker":"七海","text":"“为什么要对她说那种话？”"},{"op":"text","speaker":"七海","text":"“白羽希望您也可以吃到这个，这么努力做出来的。”"},{"op":"image","layer":1,"image":"i12403"},{"op":"text","speaker":"小鸠","text":"“什么？”"},{"op":"text","speaker":"七海","text":"“她说，因为觉得您也一直很寂寞。”"},{"op":"text","speaker":"七海","text":"“为什么，您却要对她说那么过分的话呢？”"},{"op":"image","layer":1,"image":"i12408"},{"op":"text","speaker":"小鸠","text":"“……”"},{"op":"image","layer":1,"image":"i12413"},{"op":"text","speaker":"小鸠","text":"“就算她做这些，终究也只是把自己囚禁在过去之中。”"},{"op":"text","speaker":"七海","text":"“这根本算不上是理由。”"},{"op":"text","speaker":"七海","text":"“您在隐瞒着什么。”"},{"op":"image","layer":1,"image":"i12403"},{"op":"text","speaker":"小鸠","text":"“你说什么？”"},{"op":"text","speaker":"七海","text":"“白羽的妈妈，现在到底是在什么地方？”"},{"op":"text","speaker":"七海","text":"“白羽说她是去了很远的地方再也回不来……”"},{"op":"text","speaker":"七海","text":"“但是，在做饭的时候，在那间食堂的时候，白羽都是那么开心。”"},{"op":"image","layer":1,"image":"i12408"},{"op":"text","speaker":"小鸠","text":"“……”"},{"op":"image","layer":1,"image":"i12413"},{"op":"text","speaker":"小鸠","text":"“不能让那孩子接近那家店。”"},{"op":"text","speaker":"七海","text":"“到底是为什么？那里不是满载着白羽和爸爸妈妈的回忆，无比重要的地方吗？”"},{"op":"image","layer":1,"image":"i12403"},{"op":"text","speaker":"小鸠","text":"“回忆，并不是永远都那么美好。”"},{"op":"text","speaker":"七海","text":"“您这是什么意思？”"},{"op":"image","layer":1,"image":"i12413"},{"op":"text","speaker":"小鸠","text":"“……”"},{"op":"text","speaker":"七海","text":"“果然，您知道些什么对吧？”"},{"op":"text","speaker":"七海","text":"“包括白羽妈妈消失的理由。”"},{"op":"text","speaker":"小鸠","text":"“……”"},{"op":"image","layer":1,"image":"i12403"},{"op":"text","speaker":"小鸠","text":"“我的妻子，曾经对我这样说过。”"},{"op":"image","layer":1,"image":"i12413"},{"op":"text","speaker":"小鸠","text":"“‘我们的血脉中，寄宿着神秘的力量。’”"},{"op":"text","speaker":"小鸠","text":"“‘想要使用那种力量，就必须付出代价。’”"},{"op":"text","speaker":"小鸠","text":"“‘所以，必须让自己不去依赖那种力量。’”"},{"op":"image","layer":1,"image":"i12408"},{"op":"text","speaker":"小鸠","text":"“当我问她这是什么意思的时候，她只是笑着对我说。”"},{"op":"image","layer":1,"image":"i12403"},{"op":"text","speaker":"小鸠","text":"“‘只要快乐地享受夏天就可以了哦。’”"},{"op":"image","layer":1,"image":"i12413"},{"op":"text","speaker":"小鸠","text":"“我的女儿，也说过同样的话。”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"set","variable":7120,"value":0},{"op":"image","layer":2,"image":"i740"},{"op":"image","layer":0,"image":"i513"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"瞳","text":"‘爸爸。’"},{"op":"text","speaker":"瞳","text":"‘我有个请求。’"},{"op":"text","speaker":"瞳","text":"‘请您让白羽度过一个快乐的暑假吧。’"},{"op":"text","speaker":"瞳","text":"‘让她不要沉醉于过去的幸福，而是放眼于未来的美好。’"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":2},{"op":"clear","layer":2050},{"op":"set","variable":7120,"value":1},{"op":"image","layer":0,"image":"i91"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i12413"},{"op":"text","speaker":"小鸠","text":"“之后，她就不知去向了。”"},{"op":"text","speaker":"小鸠","text":"“白羽失去了温柔的父母。”"},{"op":"image","layer":1,"image":"i12408"},{"op":"text","speaker":"小鸠","text":"“我一个顽固的老头子，又能些做什么……”"},{"op":"text","speaker":"小鸠","text":"“我只能让她远离那间食堂……不让她迷失在失去父母的伤痛之中。”"},{"op":"image","layer":1,"image":"i12413"},{"op":"text","speaker":"小鸠","text":"“我的做法，对她来说一定很残酷吧。”"},{"op":"image","layer":1,"image":"i12403"},{"op":"text","speaker":"小鸠","text":"“我还是很感谢你的。”"},{"op":"image","layer":1,"image":"i12406"},{"op":"text","speaker":"小鸠","text":"“自从你来了之后，白羽看上去一直都很开心。”"},{"op":"text","speaker":"七海","text":"“……”"},{"op":"text","speaker":"小鸠","text":"“白羽的父亲……也就是我的女婿。”"},{"op":"text","speaker":"小鸠","text":"“他虽然身体不好，但却是一个好男人。”"},{"op":"image","layer":1,"image":"i12413"},{"op":"text","speaker":"小鸠","text":"“是个打心底里重视我那野丫头的人啊。”"},{"op":"text","speaker":"小鸠","text":"“……”"},{"op":"text","speaker":"小鸠","text":"“究竟是为什么啊。”"},{"op":"image","layer":1,"image":"i12408"},{"op":"text","speaker":"小鸠","text":"“为什么，把我一个人丢下。”"},{"op":"text","speaker":"小鸠","text":"“丢下我这么个糟老头子……”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i516"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"我走出家门。"},{"op":"text","speaker":"","text":"后悔着我刚才所说的话。"},{"op":"text","speaker":"","text":"明明老爷子心里也很伤心，我却没有注意到而去责怪他。"},{"op":"text","speaker":"","text":"他不可能不关心白羽。"},{"op":"text","speaker":"","text":"绝对不可能的。"},{"op":"text","speaker":"","text":"我明明应该再清楚不过。"},{"op":"text","speaker":"","text":"他是一个非常温柔的人，只不过是有些不善于表达而已。"},{"op":"text","speaker":"","text":"我明明知道的。"},{"op":"text","speaker":"","text":"这个夏天里……充斥着太多的悲伤。"},{"op":"text","speaker":"","text":"也正因如此，我才会来到这里。"},{"op":"text","speaker":"","text":"为了……由我来结束这一切。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"――这样就可以了吗？"},{"op":"text","speaker":"七海","text":"“哎？”"},{"op":"text","speaker":"","text":"有什么东西掠过我的鼻尖。"},{"op":"image","layer":0,"image":"i286"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"蝴蝶？"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i1495"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"闪着蓝白光芒的蝴蝶，在我头顶飞舞。"},{"op":"text","speaker":"","text":"每当它扇动翅膀，都会有奇妙的声音直接在我脑海里回响。"},{"op":"image","layer":0,"image":"i1493"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"‘你真的明白，自己正打算做什么样的事吗？’"},{"op":"text","speaker":"","text":"我曾经听过这个声音。"},{"op":"text","speaker":"","text":"不知道是在过去，还是在最近。"},{"op":"text","speaker":"","text":"明明我已经恢复了记忆，但却回想不起来。"},{"op":"text","speaker":"","text":"不过神奇的是，我完全不觉得害怕。"},{"op":"text","speaker":"七海","text":"“我明白的。”"},{"op":"text","speaker":"","text":"所以，我的回答没有犹豫。"},{"op":"text","speaker":"","text":"我要做的事，将会引发巨大的变化。"},{"op":"text","speaker":"","text":"大到足以令某些东西变得不复存在。"},{"op":"text","speaker":"","text":"会让白羽因为获得力量而结下的感情渊源，全部消散于无形。"},{"op":"text","speaker":"","text":"也就是说，“那个暑假”将不复存在。"},{"op":"text","speaker":"","text":"无论是重重累积的回忆，还是无可割舍的感情……"},{"op":"text","speaker":"","text":"……全都会彻底消失不见。"},{"op":"text","speaker":"七海","text":"“但是，没关系，我已经下定决心了。”"},{"op":"image","layer":0,"image":"i1495"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"‘不。’"},{"op":"text","speaker":"","text":"‘你根本就不明白。’"},{"op":"text","speaker":"","text":"‘所谓消失。’"},{"op":"text","speaker":"","text":"‘所谓被彻底遗忘。’"},{"op":"text","speaker":"","text":"‘这究竟意味着什么。’"},{"op":"text","speaker":"","text":"‘这究竟会有多么悲伤。’"},{"op":"text","speaker":"","text":"‘这一切，你根本就不明白。’"},{"op":"image","layer":0,"image":"i1493"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"七海","text":"“这种事。”"},{"op":"text","speaker":"七海","text":"“我当然不明白啊。”"},{"op":"text","speaker":"七海","text":"“可是即便如此，我也要去做。”"},{"op":"text","speaker":"七海","text":"“至于说着这些话的你，又究竟是谁呢？”"},{"op":"text","speaker":"","text":"‘……’"},{"op":"text","speaker":"七海","text":"“为什么你要帮助我呢？”"},{"op":"text","speaker":"七海","text":"“为什么你一直和我在一起呢？”"},{"op":"text","speaker":"","text":"没错。"},{"op":"text","speaker":"","text":"现在的我，既是我，又不是我。"},{"op":"text","speaker":"","text":"因为“这个夏天”对我来说实在是太遥远了。"},{"op":"text","speaker":"","text":"我还能记得，在那漫长的旅途中变得千疮百孔的自己。"},{"op":"text","speaker":"","text":"在逐渐消散的意识之中，我听到了无数人的声音。"},{"op":"text","speaker":"","text":"无数人来到我身边，帮助了我。"},{"op":"text","speaker":"","text":"现在，我还能维持这个身体。"},{"op":"text","speaker":"","text":"还能维持“自我”，都是因为有那些人的帮助。"},{"op":"text","speaker":"","text":"我也知道，眼前飞舞的蝴蝶，也是他们之中的一个人。"},{"op":"text","speaker":"","text":"我也知道，她在为我而担心。"},{"op":"text","speaker":"七海","text":"“说真的……”"},{"op":"text","speaker":"七海","text":"“你究竟是谁啊？”"},{"op":"text","speaker":"","text":"‘……’"},{"op":"text","speaker":"","text":"她没有回答我。"},{"op":"image","layer":0,"image":"i1492"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"只是在不知不觉中……"},{"op":"text","speaker":"","text":"蝴蝶已经不知飞去了何处。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]