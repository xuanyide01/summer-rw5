[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i21"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“早。”"},{"op":"text","speaker":"","text":"我来到了秘密基地。"},{"op":"image","layer":1540,"image":"i209"},{"op":"image","layer":1796,"image":"i15101"},{"op":"image","layer":2052,"image":"i25242"},{"op":"text","speaker":"天善","text":"“哼！哈！哼！”"},{"op":"text","speaker":"","text":"天善一如既往地在练习乒乓球。"},{"op":"clear","layer":1540},{"op":"clear","layer":1796},{"op":"clear","layer":2052},{"op":"clear","layer":2047},{"op":"clear","layer":1535},{"op":"image","layer":1,"image":"i12069"},{"op":"text","speaker":"良一","text":"“噢。”"},{"op":"text","speaker":"","text":"然后良一正在看小黄书。"},{"op":"text","speaker":"","text":"当然，他的上半身是光着的。"},{"op":"text","speaker":"","text":"身子光着的家伙，正在看身子光着的书。"},{"op":"text","speaker":"","text":"也许对于良一来说这就是个时尚杂志。"},{"op":"image","layer":1,"image":"i12090"},{"op":"text","speaker":"良一","text":"“别在那盯着我看，说点什么啊……”"},{"op":"text","speaker":"羽依里","text":"“能找到件不错的衣服就好了。”"},{"op":"image","layer":1,"image":"i12094"},{"op":"text","speaker":"良一","text":"“嗯？噢，噢。”"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"image","layer":1,"image":"i12065"},{"op":"text","speaker":"良一","text":"“话说城里人都是怎么买小黄书的啊？”"},{"op":"text","speaker":"羽依里","text":"“嗯，一般是去离家很远的便利店里买。”"},{"op":"image","layer":1,"image":"i12075"},{"op":"text","speaker":"良一","text":"“好无聊啊。城里人跟我们也没什么区别啊。”"},{"op":"text","speaker":"羽依里","text":"“就是这样吧。”"},{"op":"text","speaker":"羽依里","text":"“咦？这岛上，不是没有便利店的吗？”"},{"op":"text","speaker":"羽依里","text":"“你们到底从哪里搞到的？”"},{"op":"image","layer":1,"image":"i12069"},{"op":"text","speaker":"良一","text":"“想知道吗？在意的话我就告诉你好了。”"},{"op":"text","speaker":"","text":"要说不在意那是假的。"},{"op":"text","speaker":"羽依里","text":"“那告诉我吧。”"},{"op":"image","layer":1,"image":"i12083"},{"op":"text","speaker":"良一","text":"“好啊！”"},{"op":"text","speaker":"","text":"城市和岛屿。"},{"op":"text","speaker":"","text":"尽管人们生活环境不同，但是对小黄书的热情确是一样的。"},{"op":"text","speaker":"","text":"天善是怎样的呢？"},{"op":"image","layer":1,"image":"i12069"},{"op":"text","speaker":"羽依里","text":"“天善对这种东西没有兴趣吗？”"},{"op":"image","layer":772,"image":"i209"},{"op":"image","layer":1028,"image":"i15124"},{"op":"image","layer":1284,"image":"i25242"},{"op":"text","speaker":"天善","text":"“不，一般程度的兴趣我也有的。”"},{"op":"text","speaker":"","text":"竟然有啊。"},{"op":"text","speaker":"羽依里","text":"“那我们聊聊吧。”"},{"op":"clear","layer":772},{"op":"clear","layer":1028},{"op":"clear","layer":1284},{"op":"clear","layer":1791},{"op":"clear","layer":1279},{"op":"image","layer":257,"image":"i15088"},{"op":"text","speaker":"天善","text":"“好啊，算我一个。”"},{"op":"image","layer":257,"image":"i15038"},{"op":"text","speaker":"天善","text":"“所以，谁先来？良一开始？还是说鹰原开始？”"},{"op":"text","speaker":"","text":"大家都很亢奋。"},{"op":"image","layer":1,"image":"i12072"},{"op":"text","speaker":"良一","text":"“那就先听听我们的事迹吧。”"},{"op":"image","layer":1,"image":"i12069"},{"op":"text","speaker":"良一","text":"“嘿嘿……又让我想起来了，那暴风肆虐的大海……”"},{"op":"text","speaker":"羽依里","text":"“……不是小黄书的话题吗？”"},{"op":"image","layer":257,"image":"i15014"},{"op":"text","speaker":"天善","text":"“是啊。真亏我们能活下来啊……”"},{"op":"text","speaker":"","text":"这听起来不像是什么正经事。"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":1795,"image":"i18201"},{"op":"image","layer":0,"image":"i151"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":1,"image":"i15020"},{"op":"image","layer":257,"image":"i12087"},{"op":"text","speaker":"良一","text":"“天善，快抓住船！巨浪要来了！”"},{"op":"image","layer":1,"image":"i15035"},{"op":"text","speaker":"天善","text":"“唔噢噢噢噢噢噢噢噢噢噢噢噢噢噢噢噢噢！”"},{"op":"image","layer":1,"image":"i15020"},{"op":"text","speaker":"天善","text":"“……我这边没事，你那边什么状况？”"},{"op":"image","layer":257,"image":"i12075"},{"op":"text","speaker":"良一","text":"“我没事！不过……可恶！有几本掉海里了！”"},{"op":"image","layer":1,"image":"i15023"},{"op":"text","speaker":"天善","text":"“放弃吧！留得青山在,不怕没柴烧！”"},{"op":"image","layer":257,"image":"i12078"},{"op":"text","speaker":"良一","text":"“但是啊！掉下去的偏偏是那几本巨乳的！”"},{"op":"image","layer":1,"image":"i15035"},{"op":"text","speaker":"天善","text":"“什――么!؟”"},{"op":"image","layer":1,"image":"i15017"},{"op":"text","speaker":"天善","text":"“……”"},{"op":"image","layer":1,"image":"i15038"},{"op":"text","speaker":"天善","text":"“……良一”"},{"op":"image","layer":257,"image":"i12065"},{"op":"text","speaker":"良一","text":"“怎么了？”"},{"op":"image","layer":1,"image":"i15017"},{"op":"text","speaker":"天善","text":"“我要是死了的话，你就这么转告水织学姐……”"},{"op":"image","layer":1,"image":"i15020"},{"op":"text","speaker":"天善","text":"“对我来说，学姐你就是乒乓球一样的存在……”"},{"op":"image","layer":257,"image":"i12087"},{"op":"text","speaker":"良一","text":"“喂……你难道要!!”"},{"op":"image","layer":1,"image":"i15232"},{"op":"text","speaker":"天善","text":"“唔噢噢噢噢噢噢噢噢噢噢噢噢噢噢噢噢噢！”"},{"op":"image","layer":3,"image":"i184"},{"op":"image","layer":259,"image":"i184"},{"op":"clear","layer":3},{"op":"clear","layer":259},{"op":"image","layer":257,"image":"i12078"},{"op":"text","speaker":"良一","text":"“天善――――――――――――――――!!!”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":1795},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i21"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15014"},{"op":"image","layer":257,"image":"i12081"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"羽依里","text":"“不是要说便利店吗？”"},{"op":"image","layer":1,"image":"i15008"},{"op":"text","speaker":"天善","text":"“是便利店的事情啊。”"},{"op":"image","layer":257,"image":"i12090"},{"op":"text","speaker":"良一","text":"“因为岛上没有便利店，于是我开船出来跟天善一起去买的。”"},{"op":"image","layer":257,"image":"i12072"},{"op":"text","speaker":"良一","text":"“那天有暴风雨，我们可是差点就一命呜呼了。”"},{"op":"text","speaker":"羽依里","text":"“天善明明一脸没什么兴趣的样子，却甚至为了小黄书跳进了海里吗？”"},{"op":"image","layer":1,"image":"i15032"},{"op":"text","speaker":"天善","text":"“我都说了一般人程度的兴趣我还是有的。”"},{"op":"text","speaker":"羽依里","text":"“一般人才不会往海里跳吧。”"},{"op":"image","layer":257,"image":"i12065"},{"op":"text","speaker":"良一","text":"“那边那些书其实就是那时候捞回来的。”"},{"op":"text","speaker":"","text":"良一和天善俩人望着屋里角落里那些脏兮兮的书，眯起了眼镜。"},{"op":"text","speaker":"","text":"因为海水的浸泡，书都泡烂了没法看了。"},{"op":"text","speaker":"","text":"这捞回来有意义吗？"},{"op":"if","truth":false,"target":154,"value":["||",["==",["v",131],1],["==",["v",424],1]]},{"op":"image","layer":257,"image":"i12069"},{"op":"text","speaker":"良一","text":"“还有就是，有一次冬天在海里的时候船没油了。”"},{"op":"image","layer":1,"image":"i15014"},{"op":"text","speaker":"天善","text":"“啊，真怀念啊……”"},{"op":"text","speaker":"","text":"他们又讲述了起来。"},{"op":"goto","target":161},{"op":"text","speaker":"羽依里","text":"“话说水织学姐是谁啊？”"},{"op":"image","layer":257,"image":"i12069"},{"op":"text","speaker":"良一","text":"“还有就是，有一次冬天在海里的时候船没油了。”"},{"op":"text","speaker":"羽依里","text":"“不是，所以说水织学姐……”"},{"op":"image","layer":1,"image":"i15014"},{"op":"text","speaker":"天善","text":"“啊，真怀念啊……”"},{"op":"text","speaker":"","text":"他们又讲述了起来……"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":1795,"image":"i18201"},{"op":"image","layer":0,"image":"i149"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":1,"image":"i15020"},{"op":"image","layer":257,"image":"i12087"},{"op":"text","speaker":"良一","text":"“啊啊啊啊……可恶，这样下去会冻死的。”"},{"op":"image","layer":1,"image":"i15044"},{"op":"text","speaker":"天善","text":"“把衣服穿上。”"},{"op":"image","layer":257,"image":"i12072"},{"op":"text","speaker":"良一","text":"“看来不烧点什么，弄个火啥的不行啊……好冷啊。”"},{"op":"image","layer":1,"image":"i15038"},{"op":"text","speaker":"天善","text":"“把衣服穿上。”"},{"op":"image","layer":257,"image":"i12075"},{"op":"text","speaker":"良一","text":"“有什么能烧的东西吗？”"},{"op":"image","layer":1,"image":"i15017"},{"op":"text","speaker":"天善","text":"“去找衣服。”"},{"op":"image","layer":257,"image":"i12090"},{"op":"text","speaker":"良一","text":"“看来只能把小黄书烧了。”"},{"op":"image","layer":257,"image":"i12069"},{"op":"text","speaker":"良一","text":"“而且，烧掉的话会升起狼烟，这样就有救了。”"},{"op":"image","layer":1,"image":"i15038"},{"op":"text","speaker":"天善","text":"“别开玩笑了。这回可全是巨乳本啊。”"},{"op":"image","layer":257,"image":"i12065"},{"op":"text","speaker":"良一","text":"“但是啊，再这样下去的话我们可就要在大海上漂流了。”"},{"op":"image","layer":1,"image":"i15017"},{"op":"text","speaker":"天善","text":"“唔……你说得对……”"},{"op":"image","layer":1,"image":"i15044"},{"op":"text","speaker":"天善","text":"“我知道了……这么办吧。你把这个绳索绑我身上。”"},{"op":"image","layer":257,"image":"i12094"},{"op":"text","speaker":"良一","text":"“你要干什么？”"},{"op":"image","layer":1,"image":"i15038"},{"op":"text","speaker":"天善","text":"“我要把这艘船拉回岛上。”"},{"op":"image","layer":257,"image":"i12075"},{"op":"text","speaker":"良一","text":"“啥？”"},{"op":"image","layer":1,"image":"i15017"},{"op":"text","speaker":"天善","text":"“我要是死了的话，你就这么转告水织学姐……”"},{"op":"image","layer":1,"image":"i15020"},{"op":"text","speaker":"天善","text":"“我想成为你的球拍胶皮一样的存在……”"},{"op":"image","layer":257,"image":"i12087"},{"op":"text","speaker":"良一","text":"“喂……天善!!”"},{"op":"image","layer":1,"image":"i15232"},{"op":"text","speaker":"天善","text":"“唔唔噢噢噢噢噢噢噢噢噢噢噢噢噢噢噢噢！”"},{"op":"image","layer":3,"image":"i184"},{"op":"image","layer":259,"image":"i184"},{"op":"clear","layer":3},{"op":"clear","layer":259},{"op":"image","layer":257,"image":"i12078"},{"op":"text","speaker":"良一","text":"“天善――――――――――――――――――!!!”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":1795},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i21"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15011"},{"op":"image","layer":257,"image":"i12072"},{"op":"text","speaker":"","text":"……"},{"op":"if","truth":false,"target":235,"value":["||",["==",["v",131],1],["==",["v",424],1]]},{"op":"text","speaker":"羽依里","text":"“你对巨乳也太执着了吧……”"},{"op":"image","layer":1,"image":"i15041"},{"op":"text","speaker":"天善","text":"“我可是赌上了rubber和lover啊。”"},{"op":"text","speaker":"羽依里","text":"“这种事怎样都好啦。”"},{"op":"goto","target":241},{"op":"text","speaker":"羽依里","text":"“你对巨乳也太执着了吧……”"},{"op":"text","speaker":"羽依里","text":"“话说，水织学姐……”"},{"op":"image","layer":1,"image":"i15041"},{"op":"text","speaker":"天善","text":"“我可是赌上了rubber和lover啊。”"},{"op":"text","speaker":"羽依里","text":"“不是……所以说……”"},{"op":"text","speaker":"","text":"我感到非常在意……"},{"op":"image","layer":1,"image":"i15008"},{"op":"image","layer":257,"image":"i12081"},{"op":"text","speaker":"良一","text":"“结果由于天善当时也快冻死了，最后还是烧了当柴火了。”"},{"op":"image","layer":1,"image":"i15011"},{"op":"text","speaker":"天善","text":"“嗯。然后这个就是当时烧剩的灰。”"},{"op":"text","speaker":"","text":"完全就是垃圾啊。"},{"op":"image","layer":257,"image":"i12065"},{"op":"text","speaker":"羽依里","text":"“我说啊，你们去小卖铺买不就完了吗？”"},{"op":"text","speaker":"羽依里","text":"“多少有一些吧？”"},{"op":"image","layer":1,"image":"i15032"},{"op":"text","speaker":"天善","text":"“鹰原。你好好想想啊，苍可是在那里打工的。”"},{"op":"text","speaker":"","text":"在倒是在。"},{"op":"text","speaker":"羽依里","text":"“把她叫出来，然后趁她不在的时候赶快买了不就完了。”"},{"op":"image","layer":257,"image":"i12087"},{"op":"text","speaker":"良一","text":"“你这家伙脑子不错啊！”"},{"op":"image","layer":1,"image":"i15026"},{"op":"text","speaker":"天善","text":"“还真是！你这么一说我豁然开朗了！”"},{"op":"text","speaker":"羽依里","text":"“你们俩脑子也太笨了吧。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“好……这就干吧！”"},{"op":"text","speaker":"","text":"我们立刻开始实行作战，来到了小卖铺。"},{"op":"text","speaker":"","text":"良一负责把苍引出，我和天善则负责买。"},{"op":"image","layer":1,"image":"i10203"},{"op":"text","speaker":"苍","text":"“欢迎光临……原来是良一啊。”"},{"op":"image","layer":257,"image":"i12174"},{"op":"text","speaker":"良一","text":"“噢，噢。啊……你现在有空吗？”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"苍","text":"“我正在打工……怎么可能有空啊？”"},{"op":"image","layer":257,"image":"i12150"},{"op":"text","speaker":"良一","text":"“这，这样啊……但是！那个……那个！”"},{"op":"image","layer":257,"image":"i12217"},{"op":"text","speaker":"良一","text":"“羽依里那家伙好像有什么重要的事要说，而且表情很认真。”"},{"op":"image","layer":1,"image":"i10246"},{"op":"text","speaker":"苍","text":"“哎？这，这什么情况？”"},{"op":"text","speaker":"","text":"哎？这怎么情况?"},{"op":"image","layer":257,"image":"i12190"},{"op":"text","speaker":"良一","text":"“他好像无论如何都想要和你单独见个面。”"},{"op":"text","speaker":"","text":"良一那家伙，把问题全推给我了。"},{"op":"image","layer":1,"image":"i10162"},{"op":"text","speaker":"苍","text":"“哎……但，但是。这也……太急了……我，我很困扰。”"},{"op":"image","layer":1,"image":"i10254"},{"op":"text","speaker":"苍","text":"“那个，我也……需要做各种准备……”"},{"op":"text","speaker":"","text":"你要准备什么？"},{"op":"image","layer":257,"image":"i12147"},{"op":"text","speaker":"良一","text":"“那家伙看起来非常认真……拜托了。”"},{"op":"text","speaker":"","text":"你快停吧。"},{"op":"image","layer":1,"image":"i10272"},{"op":"text","speaker":"苍","text":"“啊，嗯……这样啊……他认真的啊。”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"苍","text":"“那么……稍微一会儿的话……”"},{"op":"text","speaker":"","text":"良一把一脸紧张的苍带了出去。"},{"op":"image","layer":1,"image":"i15014"},{"op":"text","speaker":"天善","text":"“好的，成功了！”"},{"op":"text","speaker":"羽依里","text":"“一点也不好。”"},{"op":"image","layer":1,"image":"i15011"},{"op":"text","speaker":"天善","text":"“好了，我们也开始吧。”"},{"op":"text","speaker":"","text":"进入小卖铺后，天善迅速地选着想买的小黄书。"},{"op":"text","speaker":"羽依里","text":"“找到什么好的吗？”"},{"op":"image","layer":1,"image":"i15041"},{"op":"text","speaker":"天善","text":"“嗯，已经差不多了。”"},{"op":"text","speaker":"羽依里","text":"“那赶紧结账回去吧。”"},{"op":"if","truth":false,"target":354,"value":["||",["==",["v",131],1],["==",["v",424],1]]},{"op":"image","layer":257,"image":"i13816"},{"op":"text","speaker":"静久","text":"“下午好。”"},{"op":"text","speaker":"羽依里","text":"“哎？”"},{"op":"image","layer":257,"image":"i13740"},{"op":"text","speaker":"静久","text":"“……哎呀？在这里见到你们俩真是奇遇啊♪”"},{"op":"image","layer":1,"image":"i15026"},{"op":"text","speaker":"天善","text":"“水……织……学姐……？”"},{"op":"text","speaker":"","text":"没想到在这种时候竟然遇到了没想到的人。"},{"op":"image","layer":257,"image":"i13743"},{"op":"text","speaker":"静久","text":"“你们在买东西？”"},{"op":"text","speaker":"","text":"学姐一边说着一边看向了天善手里拿着的书。"},{"op":"image","layer":1,"image":"i15023"},{"op":"image","layer":257,"image":"i13807"},{"op":"text","speaker":"静久","text":"“啊……”"},{"op":"image","layer":257,"image":"i13840"},{"op":"text","speaker":"静久","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“不，这是……”"},{"op":"image","layer":257,"image":"i13849"},{"op":"text","speaker":"静久","text":"“嘻嘻♪加纳同学啊。”"},{"op":"image","layer":1,"image":"i15035"},{"op":"text","speaker":"天善","text":"“啊！是！”"},{"op":"image","layer":257,"image":"i13797"},{"op":"text","speaker":"静久","text":"“这可不行噢？”"},{"op":"text","speaker":"","text":"学姐满面笑容地说到。"},{"op":"image","layer":1,"image":"i15026"},{"op":"text","speaker":"天善","text":"“噢，噢……”"},{"op":"image","layer":257,"image":"i13807"},{"op":"text","speaker":"静久","text":"“……哎？”"},{"op":"image","layer":1,"image":"i15023"},{"op":"text","speaker":"天善","text":"“噢噢噢……噢噢噢噢噢噢噢噢噢噢噢噢噢！”"},{"op":"image","layer":257,"image":"i13837"},{"op":"text","speaker":"静久","text":"“加，加纳同学？”"},{"op":"image","layer":1,"image":"i15168"},{"op":"text","speaker":"天善","text":"“噢噢噢噢噢噢噢噢噢噢噢噢噢噢噢噢!!!”"},{"op":"image","layer":1,"image":"i15163"},{"op":"text","speaker":"天善","text":"“唔啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊!!”"},{"op":"image","layer":257,"image":"i13791"},{"op":"text","speaker":"静久","text":"“加纳同学!؟加――纳――同――学――！”"},{"op":"text","speaker":"","text":"天善把好不容易选出来的小黄书随手一扔，不知道跑到什么地方去了。"},{"op":"image","layer":257,"image":"i13788"},{"op":"text","speaker":"静久","text":"“我，我做了什么不好的事吗？”"},{"op":"text","speaker":"羽依里","text":"“算是吧……”"},{"op":"text","speaker":"","text":"太悲惨了。"},{"op":"goto","target":388},{"op":"image","layer":257,"image":"i13816"},{"op":"text","speaker":"吞噬满月之乳房","text":"“下午好。”"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"text","speaker":"","text":"那是……"},{"op":"text","speaker":"","text":"吞噬满月之乳房姐姐。"},{"op":"image","layer":1,"image":"i15035"},{"op":"text","speaker":"","text":"与此同时，天善手里的小黄书立刻掉到了地上。"},{"op":"image","layer":1,"image":"i15026"},{"op":"text","speaker":"天善","text":"“水……织……学姐……？”"},{"op":"text","speaker":"羽依里","text":"“哎？这个人就是？”"},{"op":"text","speaker":"","text":"满月……不对，水织学姐看到了天善掉在地上的书。"},{"op":"image","layer":1,"image":"i15023"},{"op":"image","layer":257,"image":"i13807"},{"op":"text","speaker":"水织学姐","text":"“啊……”"},{"op":"text","speaker":"","text":"难道说，现在这个状况……非常不妙？"},{"op":"image","layer":257,"image":"i13849"},{"op":"text","speaker":"水织学姐","text":"“哈哈♪加纳同学啊。”"},{"op":"image","layer":1,"image":"i15035"},{"op":"text","speaker":"天善","text":"“啊！是！”"},{"op":"image","layer":257,"image":"i13797"},{"op":"text","speaker":"水织学姐","text":"“这可不行噢？”"},{"op":"image","layer":1,"image":"i15026"},{"op":"text","speaker":"天善","text":"“噢，噢……”"},{"op":"image","layer":257,"image":"i13807"},{"op":"text","speaker":"水织学姐","text":"“……哎？”"},{"op":"image","layer":1,"image":"i15035"},{"op":"text","speaker":"天善","text":"“噢噢噢噢噢噢噢噢噢噢噢噢噢噢噢噢!!!”"},{"op":"image","layer":257,"image":"i13791"},{"op":"text","speaker":"水织学姐","text":"“加纳同学!؟加纳同学――！”"},{"op":"text","speaker":"","text":"天善不知道跑到什么地方去了。"},{"op":"image","layer":257,"image":"i13788"},{"op":"text","speaker":"水织学姐","text":"“我，我做了什么不好的事吗？”"},{"op":"text","speaker":"羽依里","text":"“算是吧……”"},{"op":"text","speaker":"","text":"太悲惨了。"},{"op":"if","truth":false,"target":397,"value":["&&",["==",["v",6034],9],["==",["native","エサを過去に手に入れたことがある"],0]]},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"text","speaker":"","text":"我捡起了天善掉下的小黄书踏上了归途。"},{"op":"text","speaker":"","text":"至少还是把这几本书备在秘密基地里吧。"},{"op":"goto","target":397},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"return"},{"op":"end"}]