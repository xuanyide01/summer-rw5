[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"text","speaker":"声音","text":"“喂……”"},{"op":"text","speaker":"声音","text":"“快起床。”"},{"op":"text","speaker":"声音","text":"“听到没。”"},{"op":"text","speaker":"声音","text":"“喂喂。”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"有人在叫我。"},{"op":"text","speaker":"","text":"这声音似乎在哪听过。"},{"op":"text","speaker":"羽依里","text":"“唔。”"},{"op":"image","layer":0,"image":"i1008"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"女孩子","text":"“……”"},{"op":"text","speaker":"","text":"一个女孩，正俯视着我。"},{"op":"text","speaker":"女孩子","text":"“已经8点了。”"},{"op":"text","speaker":"","text":"我花了一点时间把记忆拼凑起来。"},{"op":"text","speaker":"","text":"对了。"},{"op":"text","speaker":"","text":"这不是自己家。"},{"op":"text","speaker":"","text":"趁着放暑假，我来到了外婆家。"},{"op":"image","layer":0,"image":"i1007"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"这女孩是……"},{"op":"text","speaker":"","text":"谁来着。"},{"op":"text","speaker":"女孩子","text":"“……”"},{"op":"text","speaker":"","text":"我记得她应该是。"},{"op":"choice","variable":6001,"items":[{"text":"镜子阿姨","value":0,"condition":1},{"text":"外婆","value":1,"condition":1},{"text":"老妈","value":2,"condition":1},{"text":"青梅竹马","value":3,"condition":1}]},{"op":"if","truth":false,"target":46,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“镜子阿姨？”"},{"op":"image","layer":0,"image":"i1032"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"女孩子","text":"“什么？”"},{"op":"text","speaker":"羽依里","text":"“镜子阿姨，这一晚上你就变小了很多呢……”"},{"op":"image","layer":0,"image":"i1030"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"女孩子","text":"“……哈？”"},{"op":"image","layer":0,"image":"i1031"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"女孩子","text":"“我怎么看都不是镜子阿姨吧。”"},{"op":"text","speaker":"羽依里","text":"“这么说……”"},{"op":"image","layer":0,"image":"i1032"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"女孩子","text":"“那个。”"},{"op":"text","speaker":"女孩子","text":"“羽未。”"},{"op":"text","speaker":"羽依里","text":"“羽未镜子……”"},{"op":"text","speaker":"女孩子","text":"“我不是镜子阿姨。”"},{"op":"goto","target":88},{"op":"if","truth":false,"target":60,"value":["==",["v",6001],1]},{"op":"text","speaker":"羽依里","text":"“外婆……你原来还活着啊。”"},{"op":"image","layer":0,"image":"i1030"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"女孩子","text":"“啊？”"},{"op":"text","speaker":"女孩子","text":"“外婆？在，在哪？”"},{"op":"image","layer":0,"image":"i1032"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"女孩子","text":"“别说这种话吓我。”"},{"op":"text","speaker":"羽依里","text":"“外婆……”"},{"op":"image","layer":0,"image":"i1031"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"女孩子","text":"“睡迷糊了？”"},{"op":"goto","target":88},{"op":"if","truth":false,"target":73,"value":["==",["v",6001],2]},{"op":"text","speaker":"羽依里","text":"“再睡五分钟。”"},{"op":"text","speaker":"女孩子","text":"“可是饭已经做好了。”"},{"op":"text","speaker":"羽依里","text":"“我不吃了。”"},{"op":"text","speaker":"女孩子","text":"“饭要好好吃。”"},{"op":"text","speaker":"羽依里","text":"“那就做成便当……我上课时吃。”"},{"op":"image","layer":0,"image":"i1009"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"女孩子","text":"“真是个废人……”"},{"op":"image","layer":0,"image":"i1010"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"女孩子","text":"“喂，快起来啦。我可不是你妈妈。”"},{"op":"goto","target":88},{"op":"if","truth":false,"target":88,"value":["==",["v",6001],3]},{"op":"text","speaker":"羽依里","text":"“真吵死人了。”"},{"op":"image","layer":0,"image":"i1032"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"女孩子","text":"“什么。”"},{"op":"text","speaker":"羽依里","text":"“天天一大早的……”"},{"op":"text","speaker":"羽依里","text":"“你是我老婆啊？”"},{"op":"image","layer":0,"image":"i1031"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"女孩子","text":"“……”"},{"op":"image","layer":0,"image":"i1010"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"女孩子","text":"“想都别想。”"},{"op":"set","variable":31,"value":1},{"op":"goto","target":88},{"op":"text","speaker":"羽依里","text":"“咦……哎？”"},{"op":"text","speaker":"羽依里","text":"“你是……”"},{"op":"image","layer":0,"image":"i1007"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"女孩子","text":"“初次见面，我是羽未。”"},{"op":"text","speaker":"羽依里","text":"“你好……”"},{"op":"text","speaker":"羽依里","text":"“羽未？”"},{"op":"image","layer":0,"image":"i1032"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽未","text":"“名字。”"},{"op":"text","speaker":"羽依里","text":"“哦。”"},{"op":"text","speaker":"羽依里","text":"“我是鹰原羽依里。”"},{"op":"image","layer":0,"image":"i1007"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽未","text":"“你好，羽依里哥。”"},{"op":"text","speaker":"羽未","text":"“快起床吧。”"},{"op":"text","speaker":"羽依里","text":"“为什么。”"},{"op":"image","layer":0,"image":"i1010"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽未","text":"“因为饭要凉了！”"},{"op":"if","truth":false,"target":126,"value":["==",["v",31],1]},{"op":"image","layer":0,"image":"i69"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我坐起身来。"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“羽依里哥，你有天天早上都来叫你起床的朋友吗？”"},{"op":"text","speaker":"羽依里","text":"“呃……嗯，有吧。”"},{"op":"image","layer":1,"image":"i15496"},{"op":"text","speaker":"羽未","text":"“是吗，还真让人羡慕。”"},{"op":"text","speaker":"羽依里","text":"“羡慕什么啊。”"},{"op":"text","speaker":"羽依里","text":"“是男的。”"},{"op":"image","layer":1,"image":"i15533"},{"op":"text","speaker":"羽未","text":"“是男的吗!؟刚才你不是说是老婆。”"},{"op":"text","speaker":"羽依里","text":"“男生间乱开玩笑罢了。”"},{"op":"text","speaker":"羽依里","text":"“在男校很正常的。”"},{"op":"image","layer":1,"image":"i15563"},{"op":"text","speaker":"羽未","text":"“男校真是太讨厌了！”"},{"op":"goto","target":126},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"客厅中，飘出一股很香的气味。"},{"op":"text","speaker":"羽依里","text":"“噢！”"},{"op":"text","speaker":"","text":"摆放在餐桌上的是炒饭。"},{"op":"text","speaker":"羽依里","text":"“噢……？”"},{"op":"text","speaker":"","text":"大清早的……炒饭？"},{"op":"text","speaker":"羽依里","text":"“镜子阿姨呢？”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“她说早上有个集会。”"},{"op":"text","speaker":"羽依里","text":"“是吗，总觉得给她添麻烦了。”"},{"op":"text","speaker":"羽依里","text":"“昨天还说不会做饭的。”"},{"op":"text","speaker":"羽依里","text":"“不过大清早做炒饭……真亏她想得出来。”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“……”"},{"op":"text","speaker":"","text":"羽未嘟着脸，向我看来。"},{"op":"image","layer":1,"image":"i15387"},{"op":"text","speaker":"羽未","text":"“是我做的。”"},{"op":"text","speaker":"羽依里","text":"“哎!؟”"},{"op":"text","speaker":"羽依里","text":"“这样啊，好厉害。”"},{"op":"image","layer":1,"image":"i15476"},{"op":"text","speaker":"羽未","text":"“……”"},{"op":"image","layer":1,"image":"i15472"},{"op":"text","speaker":"羽未","text":"“过奖了。”"},{"op":"text","speaker":"羽依里","text":"“确实。”"},{"op":"image","layer":1,"image":"i15533"},{"op":"text","speaker":"羽未","text":"“你说什么？”"},{"op":"text","speaker":"羽依里","text":"“啊。不，对不起。”"},{"op":"text","speaker":"羽依里","text":"“好厉害啊。”"},{"op":"image","layer":1,"image":"i15433"},{"op":"text","speaker":"羽未","text":"“过奖了。”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"image","layer":1,"image":"i15417"},{"op":"text","speaker":"羽未","text":"“……”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"感觉有点混乱。"},{"op":"text","speaker":"","text":"大清早被亲戚家的小孩叫醒。"},{"op":"text","speaker":"","text":"然后两个人围坐在餐桌上吃炒饭当早餐。"},{"op":"text","speaker":"","text":"为什么是炒饭……"},{"op":"text","speaker":"","text":"味道……有点微妙，不能断言说是好吃。"},{"op":"text","speaker":"","text":"闻着倒是真的香。"},{"op":"text","speaker":"羽依里","text":"“那什么……羽未。”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“在。”"},{"op":"text","speaker":"羽依里","text":"“你为什么会来这里？”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“来整理仓库，因为收到了信。”"},{"op":"text","speaker":"羽依里","text":"“啊，那跟我一样呀。”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“哦，是吗。”"},{"op":"text","speaker":"羽依里","text":"“你一个人？”"},{"op":"image","layer":1,"image":"i15401"},{"op":"text","speaker":"羽未","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“噢。”"},{"op":"text","speaker":"羽依里","text":"“真亏你家人放心啊。”"},{"op":"image","layer":1,"image":"i15408"},{"op":"text","speaker":"羽未","text":"“毕竟都知道我懂事。”"},{"op":"text","speaker":"羽依里","text":"“哦……”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“所以呢，羽依里哥。”"},{"op":"text","speaker":"羽依里","text":"“什么。”"},{"op":"image","layer":1,"image":"i15406"},{"op":"text","speaker":"羽未","text":"“关于接下来的事情。”"},{"op":"image","layer":1,"image":"i15403"},{"op":"text","speaker":"羽未","text":"“为了不给镜子阿姨多添麻烦，我认为家务该由我们两人承担。”"},{"op":"image","layer":1,"image":"i15406"},{"op":"text","speaker":"羽未","text":"“没意见吧？”"},{"op":"text","speaker":"羽依里","text":"“没有。”"},{"op":"text","speaker":"","text":"完全被掌握住了主动权。"},{"op":"image","layer":1,"image":"i15401"},{"op":"text","speaker":"羽未","text":"“我已经把家务一览写在这上面了，现在来决定各自的分工。”"},{"op":"text","speaker":"","text":"羽未拿出自己写的家务分担表。"},{"op":"text","speaker":"","text":"真懂事啊。"},{"op":"image","layer":1,"image":"i15408"},{"op":"text","speaker":"羽未","text":"“所以呢。”"},{"op":"image","layer":1,"image":"i15552"},{"op":"text","speaker":"羽未","text":"“剪刀石头……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“愣着干什么。”"},{"op":"image","layer":1,"image":"i15387"},{"op":"text","speaker":"羽未","text":"“该猜拳了。”"},{"op":"text","speaker":"羽依里","text":"“为什么。”"},{"op":"image","layer":1,"image":"i15403"},{"op":"text","speaker":"羽未","text":"“赢的一方拥有选择权，可以选择自己想做的家务。”"},{"op":"text","speaker":"羽依里","text":"“原来如此。”"},{"op":"text","speaker":"","text":"清洗浴室，打扫厕所倒垃圾，以及外出购物。"},{"op":"text","speaker":"","text":"差别还挺大的。"},{"op":"image","layer":1,"image":"i15331"},{"op":"text","speaker":"羽未","text":"“我不要洗衣服。”"},{"op":"text","speaker":"羽依里","text":"“那么讨厌洗衣服？”"},{"op":"image","layer":1,"image":"i15460"},{"op":"text","speaker":"羽未","text":"“讨厌。”"},{"op":"image","layer":1,"image":"i15465"},{"op":"text","speaker":"羽未","text":"“我不想洗也不想晾羽依里哥的内裤。”"},{"op":"text","speaker":"羽依里","text":"“这话真够直接的。”"},{"op":"text","speaker":"羽依里","text":"“不过，我并不讨厌给羽未洗内裤哦。”"},{"op":"image","layer":1,"image":"i15563"},{"op":"text","speaker":"羽未","text":"“……真变态……”"},{"op":"text","speaker":"羽依里","text":"“才、才不是！这纯粹是出于好意才说的！”"},{"op":"image","layer":1,"image":"i15569"},{"op":"text","speaker":"羽未","text":"“真的吗……”"},{"op":"text","speaker":"羽依里","text":"“求你相信我吧。”"},{"op":"text","speaker":"","text":"这年纪的女孩子真复杂。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15917"},{"op":"text","speaker":"羽未","text":"“我要出去一下。”"},{"op":"text","speaker":"羽依里","text":"“去哪？”"},{"op":"image","layer":1,"image":"i15896"},{"op":"text","speaker":"羽未","text":"“岛上。”"},{"op":"text","speaker":"","text":"这还用说嘛，难道还能去别的地方。"},{"op":"text","speaker":"羽依里","text":"“小心一点哦。”"},{"op":"image","layer":1,"image":"i15809"},{"op":"text","speaker":"羽未","text":"“……？小心什么？”"},{"op":"text","speaker":"羽依里","text":"“要小心什么呢……？”"},{"op":"choice","variable":6001,"items":[{"text":"车","value":0,"condition":1},{"text":"日晒","value":1,"condition":1},{"text":"仲夏之恋","value":2,"condition":1},{"text":"卓柏卡布拉","value":3,"condition":1}]},{"op":"if","truth":false,"target":266,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“小心车。”"},{"op":"image","layer":1,"image":"i15798"},{"op":"text","speaker":"羽未","text":"“这里几乎见不到车，也没东西可小心哦。”"},{"op":"text","speaker":"羽依里","text":"“也是。”"},{"op":"text","speaker":"羽依里","text":"“不过不怕一万就怕万一。”"},{"op":"text","speaker":"羽依里","text":"“过路口的时候记得看清左右……”"},{"op":"image","layer":1,"image":"i15885"},{"op":"text","speaker":"羽未","text":"“我走啦。”"},{"op":"goto","target":313},{"op":"if","truth":false,"target":278,"value":["==",["v",6001],1]},{"op":"text","speaker":"羽依里","text":"“日晒这么厉害，注意防晒哦。”"},{"op":"image","layer":1,"image":"i15771"},{"op":"text","speaker":"羽未","text":"“为什么羽依里哥要在意我被晒黑。”"},{"op":"text","speaker":"羽依里","text":"“也没什么，只是听说会导致皮肤癌。”"},{"op":"text","speaker":"羽依里","text":"“虽然我个人觉得，晒黑的女孩子也挺不错。”"},{"op":"image","layer":1,"image":"i15809"},{"op":"text","speaker":"羽未","text":"“我已经好好涂过防晒霜了。”"},{"op":"text","speaker":"羽依里","text":"“哦，是吗。真让人意外。”"},{"op":"image","layer":1,"image":"i15885"},{"op":"text","speaker":"羽未","text":"“那么，我就走啦。”"},{"op":"goto","target":313},{"op":"if","truth":false,"target":295,"value":["==",["v",6001],2]},{"op":"text","speaker":"羽依里","text":"“小心仲夏之恋。”"},{"op":"image","layer":1,"image":"i15917"},{"op":"text","speaker":"羽未","text":"“……”"},{"op":"image","layer":1,"image":"i15988"},{"op":"text","speaker":"羽未","text":"“再怎么小心，还是会在不经意间沦陷。”"},{"op":"text","speaker":"羽依里","text":"“的确。”"},{"op":"image","layer":1,"image":"i15912"},{"op":"text","speaker":"羽未","text":"“电视剧里这么说的。”"},{"op":"text","speaker":"羽依里","text":"“现学现卖啊。”"},{"op":"image","layer":1,"image":"i15896"},{"op":"text","speaker":"羽未","text":"“这么说，鹰原哥是有实际经历过咯？”"},{"op":"text","speaker":"羽依里","text":"“没有。”"},{"op":"image","layer":1,"image":"i15888"},{"op":"text","speaker":"羽未","text":"“我走啦。”"},{"op":"text","speaker":"","text":"没有两字一出，她就对我毫无兴趣了。"},{"op":"goto","target":313},{"op":"text","speaker":"羽依里","text":"“卓柏卡布拉。”"},{"op":"image","layer":1,"image":"i15791"},{"op":"text","speaker":"羽未","text":"“真有吗……？”"},{"op":"text","speaker":"","text":"啊，她很害怕的样子。"},{"op":"text","speaker":"羽依里","text":"“我也不知道。”"},{"op":"image","layer":1,"image":"i15771"},{"op":"text","speaker":"羽未","text":"“那就别乱吓人。”"},{"op":"text","speaker":"羽依里","text":"“对，对不起。”"},{"op":"image","layer":1,"image":"i15972"},{"op":"text","speaker":"羽未","text":"“太过分了……”"},{"op":"text","speaker":"羽依里","text":"“对不起。”"},{"op":"image","layer":1,"image":"i15993"},{"op":"text","speaker":"羽未","text":"“真可怕……”"},{"op":"text","speaker":"羽依里","text":"“对不起。”"},{"op":"text","speaker":"","text":"居然这么怕卓柏卡布拉啊。"},{"op":"text","speaker":"","text":"说起来。"},{"op":"text","speaker":"","text":"卓柏卡布拉，是什么来着。"},{"op":"set","variable":130,"value":1},{"op":"return"},{"op":"set","variable":7120,"value":1},{"op":"clear","layer":2},{"op":"image","layer":0,"image":"i59"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"羽依里","text":"“我回来了。”"},{"op":"image","layer":1,"image":"i15536"},{"op":"text","speaker":"羽未","text":"“欢迎回……啊……”"},{"op":"image","layer":1,"image":"i15530"},{"op":"image","layer":1,"image":"i15487"},{"op":"text","speaker":"羽未","text":"“为什么没穿衣服……？”"},{"op":"text","speaker":"羽依里","text":"“人生总是充满了意外。”"},{"op":"image","layer":1,"image":"i15482"},{"op":"text","speaker":"羽未","text":"“我在这岛上见过光着身子到处转的人……”"},{"op":"image","layer":1,"image":"i15487"},{"op":"text","speaker":"羽未","text":"“难道还有这样的习俗？”"},{"op":"text","speaker":"羽依里","text":"“不知道。就算有，那也与我无关。”"},{"op":"image","layer":1,"image":"i15468"},{"op":"text","speaker":"羽未","text":"“哦，对了。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“这东西，是小孩们送过来的。”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“为什么羽依里哥的T恤会在小孩手上？”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“啊，上面还挂着手写的价格牌。”"},{"op":"image","layer":1,"image":"i15355"},{"op":"text","speaker":"羽未","text":"“鉴定结果30日元。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"这找的什么茬。"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“还有，行李送到了。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“送快递的人给搬到房间里了。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i70"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"送过来的行李是从老家寄来的衣服和其他一些东西。"},{"op":"text","speaker":"","text":"开包整理。"},{"op":"image","layer":1,"image":"i15496"},{"op":"text","speaker":"羽未","text":"“整理完了吗？”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“其实也就一些书而已。”"},{"op":"image","layer":1,"image":"i15468"},{"op":"text","speaker":"羽未","text":"“书？”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“这是什么？”"},{"op":"image","layer":1,"image":"i15591"},{"op":"text","speaker":"羽未","text":"“《野莓100％》。”"},{"op":"text","speaker":"羽依里","text":"“噢噢噢！”"},{"op":"text","speaker":"羽依里","text":"“这……不是……”"},{"op":"text","speaker":"羽依里","text":"“是跟朋友借的忘了还……然后……混进来了……”"},{"op":"image","layer":1,"image":"i15560"},{"op":"text","speaker":"羽未","text":"“不是恋爱漫画？”"},{"op":"text","speaker":"羽依里","text":"“当，当当，当然不是。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“咦？这是……”"},{"op":"text","speaker":"","text":"她拿起一张照片。上面是几个在泳池边笑着的学生。"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“羽依里哥，你是游泳部的？”"},{"op":"text","speaker":"羽依里","text":"“不是。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“那是什么部？”"},{"op":"choice","variable":6001,"items":[{"text":"沙滩裤部","value":0,"condition":1},{"text":"水球部","value":1,"condition":1},{"text":"花样游泳部","value":2,"condition":1}]},{"op":"if","truth":false,"target":438,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“沙滩裤部。”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“没这种部。”"},{"op":"text","speaker":"羽依里","text":"“你居然不知道啊。”"},{"op":"image","layer":1,"image":"i15331"},{"op":"text","speaker":"羽未","text":"“不可能有这种部的。”"},{"op":"text","speaker":"羽依里","text":"“呵……”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“哎……难道说……真有？”"},{"op":"text","speaker":"羽依里","text":"“去问镜子阿姨就知道了。”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“……肯定……没有的……”"},{"op":"image","layer":1,"image":"i15360"},{"op":"text","speaker":"羽未","text":"“……”"},{"op":"image","layer":1,"image":"i15518"},{"op":"text","speaker":"","text":"她似乎动摇了，跑到客厅去问镜子阿姨。"},{"op":"text","speaker":"","text":"……"},{"op":"image","layer":1,"image":"i15343"},{"op":"text","speaker":"羽未","text":"“羽依里哥这个大笨蛋――――！”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":1795,"image":"i18201"},{"op":"image","layer":0,"image":"i62"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11578"},{"op":"image","layer":257,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“请问，镜子阿姨你知道沙滩裤部吗？”"},{"op":"image","layer":1,"image":"i11563"},{"op":"text","speaker":"镜子","text":"“呃、呃……那个……”"},{"op":"image","layer":1,"image":"i11571"},{"op":"text","speaker":"镜子","text":"“沙滩裤怎么了？”"},{"op":"image","layer":257,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“听说有这种社团。”"},{"op":"image","layer":1,"image":"i11563"},{"op":"text","speaker":"镜子","text":"“呃、呃……”"},{"op":"image","layer":1,"image":"i11571"},{"op":"text","speaker":"镜子","text":"“那个……我……不太清楚最近的东西……”"},{"op":"image","layer":1,"image":"i11552"},{"op":"image","layer":257,"image":"i15353"},{"op":"text","speaker":"镜子","text":"“没想到……沙滩裤，竟然会在年轻人中，掀起这种热潮……”"},{"op":"image","layer":257,"image":"i15331"},{"op":"text","speaker":"羽未","text":"“对不起！都是那家伙的错！”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":1795},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i70"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15357"},{"op":"goto","target":471},{"op":"if","truth":false,"target":459,"value":["==",["v",6001],1]},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“就是在水里打手球那种？”"},{"op":"text","speaker":"羽依里","text":"“对。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“啊，我听说过这岛上有水球俱乐部哦。”"},{"op":"text","speaker":"羽依里","text":"“是吗。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“据说是渔夫叔叔们建立的，卖点是日本最刺激的水球运动。”"},{"op":"text","speaker":"羽依里","text":"“是、是吗。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“我会给叔叔们介绍羽依里哥的。”"},{"op":"text","speaker":"羽依里","text":"“等等，对不起。”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“是骗我的吗？”"},{"op":"text","speaker":"羽依里","text":"“羽未你说的那些，也是骗人的吧。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“是真的哦。”"},{"op":"text","speaker":"羽依里","text":"“是、是吗……”"},{"op":"image","layer":1,"image":"i15357"},{"op":"goto","target":471},{"op":"if","truth":false,"target":471,"value":["==",["v",6001],2]},{"op":"text","speaker":"羽未","text":"“花样游泳的动作。”"},{"op":"text","speaker":"羽依里","text":"“呃……”"},{"op":"text","speaker":"羽未","text":"“说3个来听听。”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“小谷实可子……”"},{"op":"image","layer":1,"image":"i15331"},{"op":"text","speaker":"羽未","text":"“这不是动作。”"},{"op":"image","layer":1,"image":"i15357"},{"op":"goto","target":471},{"op":"text","speaker":"羽未","text":"“游泳部，暑假没活动吗？”"},{"op":"text","speaker":"羽依里","text":"“我已经放弃了。”"},{"op":"image","layer":1,"image":"i15496"},{"op":"text","speaker":"羽未","text":"“嗯？”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i66"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"能看到羽未在厨房中到处忙活的身影。"},{"op":"text","speaker":"羽依里","text":"“有什么要我帮忙的吗？”"},{"op":"image","layer":1,"image":"i15472"},{"op":"text","speaker":"羽未","text":"“做饭是我负责的事，你不用在意。”"},{"op":"image","layer":1,"image":"i15496"},{"op":"text","speaker":"羽未","text":"“要是有空，不如去打扫卫生。”"},{"op":"text","speaker":"羽依里","text":"“好。”"},{"op":"text","speaker":"","text":"是这么回事。"},{"op":"text","speaker":"","text":"虽然猜拳基本都是我赢，不过由于我不会做饭，选的几乎都是打扫的工作。"},{"op":"image","layer":1,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“对了，能顺便烧好浴缸的热水吗？”"},{"op":"text","speaker":"羽依里","text":"“好。”"},{"op":"text","speaker":"羽依里","text":"“啊……”"},{"op":"image","layer":1,"image":"i15468"},{"op":"text","speaker":"羽依里","text":"“那个，烧水要怎么烧啊？”"},{"op":"image","layer":1,"image":"i15496"},{"op":"text","speaker":"羽未","text":"“昨天你不是泡过澡吗？”"},{"op":"text","speaker":"羽依里","text":"“正好有人刚泡完，我就直接用了。”"},{"op":"image","layer":1,"image":"i15585"},{"op":"text","speaker":"羽未","text":"“那，该、该不会是我泡过后……”"},{"op":"text","speaker":"羽依里","text":"“难怪。”"},{"op":"text","speaker":"羽依里","text":"“哦，原来那股香味，是羽未的啊。”"},{"op":"image","layer":1,"image":"i15533"},{"op":"text","speaker":"羽未","text":"“香味!؟”"},{"op":"image","layer":1,"image":"i15563"},{"op":"text","speaker":"羽未","text":"“……变，变态……”"},{"op":"text","speaker":"羽依里","text":"“气味难道还能不闻啊。”"},{"op":"image","layer":1,"image":"i15573"},{"op":"text","speaker":"羽未","text":"“……”"},{"op":"image","layer":1,"image":"i15579"},{"op":"text","speaker":"羽未","text":"“是什么样的味道……？”"},{"op":"text","speaker":"羽依里","text":"“啊？”"},{"op":"image","layer":1,"image":"i15576"},{"op":"text","speaker":"羽未","text":"“洗澡水……”"},{"op":"text","speaker":"羽依里","text":"“呃……”"},{"op":"if","truth":false,"target":532,"value":["==",["v",29],1]},{"op":"text","speaker":"羽依里","text":"“是像牛油果那样的味道。”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“什么啊，牛油果？那东西有味道的吗？”"},{"op":"text","speaker":"羽依里","text":"“唔，就是有那种味。”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“我……闻着像牛油果吗……？嗅嗅。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“啊，是这样啊……”"},{"op":"text","speaker":"羽依里","text":"“闻到了？”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“嗯。”"},{"op":"image","layer":1,"image":"i15360"},{"op":"text","speaker":"羽未","text":"“可是，我明明没怎么吃牛油果啊？”"},{"op":"text","speaker":"羽依里","text":"“谁知道呢。”"},{"op":"goto","target":558},{"op":"if","truth":false,"target":544,"value":["==",["v",30],1]},{"op":"text","speaker":"羽依里","text":"“是像初恋一般的味道。”"},{"op":"image","layer":1,"image":"i15522"},{"op":"text","speaker":"羽未","text":"“……变态……”"},{"op":"text","speaker":"羽依里","text":"“为什么什么骂人!؟”"},{"op":"image","layer":1,"image":"i15573"},{"op":"text","speaker":"羽未","text":"“你这是想泡我……”"},{"op":"text","speaker":"羽依里","text":"“啊哈哈。”"},{"op":"text","speaker":"","text":"不小心笑出来了。"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“生气了……”"},{"op":"goto","target":558},{"op":"if","truth":false,"target":558,"value":["==",["v",28],1]},{"op":"text","speaker":"羽依里","text":"“是像牛奶那样吧。”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“哎哎？”"},{"op":"text","speaker":"羽依里","text":"“感觉像是婴儿会有的那种味道。”"},{"op":"image","layer":1,"image":"i15387"},{"op":"text","speaker":"羽未","text":"“是想说我小孩子气吗……？”"},{"op":"text","speaker":"羽依里","text":"“不、不是啦。都说是像婴儿那种了。”"},{"op":"image","layer":1,"image":"i15513"},{"op":"text","speaker":"羽未","text":"“这就更过分了！”"},{"op":"text","speaker":"羽依里","text":"“这不算过分吧？有什么不好的啊。”"},{"op":"image","layer":1,"image":"i15518"},{"op":"text","speaker":"羽未","text":"“就不好！”"},{"op":"goto","target":558},{"op":"return"},{"op":"end"}]