[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i68"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"好，走吧。"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11581"},{"op":"text","speaker":"镜子","text":"“啊，羽依里。”"},{"op":"text","speaker":"羽依里","text":"“早上好。”"},{"op":"image","layer":1,"image":"i11599"},{"op":"text","speaker":"镜子","text":"“有件事想麻烦你。”"},{"op":"image","layer":1,"image":"i11622"},{"op":"text","speaker":"镜子","text":"“家里食材快没了，回来的时候能买一些吗？”"},{"op":"text","speaker":"羽依里","text":"“好的。”"},{"op":"text","speaker":"羽依里","text":"“要买些什么？”"},{"op":"image","layer":1,"image":"i11581"},{"op":"text","speaker":"镜子","text":"“等下，我给你写个便条。”"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"image","layer":1,"image":"i11549"},{"op":"text","speaker":"镜子","text":"“要是卖完了，就尽量买些方便做的食材吧。”"},{"op":"text","speaker":"羽依里","text":"“好。”"},{"op":"text","speaker":"","text":"但她给我的便条上，并没有食材。"},{"op":"text","speaker":"","text":"都是些放进热水或者微波炉热热就能吃的东西。"},{"op":"image","layer":1,"image":"i11575"},{"op":"text","speaker":"镜子","text":"“麻烦你了。”"},{"op":"text","speaker":"羽依里","text":"“哪里哪里。”"},{"op":"text","speaker":"","text":"话虽这么说，但我还是不太想削减和紬静久她们一起的时间。"},{"op":"text","speaker":"","text":"……啊，有了。"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i129"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“今天也在这啊。”"},{"op":"image","layer":1,"image":"i14297"},{"op":"text","speaker":"紬","text":"“――！”"},{"op":"image","layer":1,"image":"i14231"},{"op":"text","speaker":"紬","text":"“在，在这。”"},{"op":"image","layer":257,"image":"i13820"},{"op":"text","speaker":"静久","text":"“唉呀，欢迎♪”"},{"op":"text","speaker":"羽依里","text":"“想好今天干什么了吗？”"},{"op":"image","layer":1,"image":"i14225"},{"op":"text","speaker":"紬","text":"“没，没有……还没想好。”"},{"op":"text","speaker":"羽依里","text":"“那我们去购物吧？”"},{"op":"image","layer":1,"image":"i14211"},{"op":"text","speaker":"紬","text":"“购物……吗？”"},{"op":"text","speaker":"羽依里","text":"“对，我有点东西要买。”"},{"op":"text","speaker":"羽依里","text":"“而且这说不定也能找你想干的事情。”"},{"op":"image","layer":1,"image":"i14225"},{"op":"text","speaker":"紬","text":"“说，说的也是。”"},{"op":"text","speaker":"羽依里","text":"“那我们一起去吧。”"},{"op":"image","layer":1,"image":"i14231"},{"op":"text","speaker":"紬","text":"“……好。”"},{"op":"image","layer":257,"image":"i13740"},{"op":"text","speaker":"静久","text":"“一路顺风。”"},{"op":"text","speaker":"羽依里","text":"“唉？静久不一起来？”"},{"op":"image","layer":257,"image":"i13782"},{"op":"text","speaker":"静久","text":"“唉呀，我可以一起？”"},{"op":"text","speaker":"羽依里","text":"“当然了。”"},{"op":"image","layer":257,"image":"i13779"},{"op":"text","speaker":"静久","text":"“你们不是约会吗？”"},{"op":"image","layer":1,"image":"i14211"},{"op":"text","speaker":"紬","text":"“姆啾!؟”"},{"op":"text","speaker":"羽依里","text":"“就算是约会，你也完全可以一起来。”"},{"op":"image","layer":1,"image":"i14231"},{"op":"text","speaker":"紬","text":"“姆啾啾!؟”"},{"op":"text","speaker":"羽依里","text":"“不过我还是希望我们三人能在一起。”"},{"op":"image","layer":257,"image":"i13846"},{"op":"text","speaker":"静久","text":"“嗯，乐意奉陪。”"},{"op":"image","layer":257,"image":"i13816"},{"op":"text","speaker":"静久","text":"“紬也同意吗？”"},{"op":"image","layer":1,"image":"i14350"},{"op":"text","speaker":"紬","text":"“当，当然了。”"},{"op":"image","layer":257,"image":"i13823"},{"op":"text","speaker":"静久","text":"“不用和乳依里两个人独处？”"},{"op":"image","layer":1,"image":"i14311"},{"op":"text","speaker":"紬","text":"“那，那个……！”"},{"op":"image","layer":1,"image":"i14314"},{"op":"text","speaker":"紬","text":"“这种话……会让我很害羞的。”"},{"op":"image","layer":1,"image":"i14231"},{"op":"text","speaker":"紬","text":"“非常难为情……请收敛一些。”"},{"op":"image","layer":257,"image":"i13770"},{"op":"text","speaker":"静久","text":"“好～♪”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i25"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“你最近都挺早的。几点来的？”"},{"op":"image","layer":1,"image":"i13737"},{"op":"text","speaker":"静久","text":"“我是坐首班船来的。”"},{"op":"text","speaker":"羽依里","text":"“太早了。”"},{"op":"image","layer":257,"image":"i14503"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“紬这个点就起来了？”"},{"op":"image","layer":257,"image":"i14396"},{"op":"text","speaker":"紬","text":"“姆啾!؟”"},{"op":"image","layer":257,"image":"i14410"},{"op":"text","speaker":"紬","text":"“啊……呃。”"},{"op":"image","layer":257,"image":"i14414"},{"op":"text","speaker":"紬","text":"“说，说不好。”"},{"op":"text","speaker":"羽依里","text":"“说不好啊。”"},{"op":"image","layer":257,"image":"i14503"},{"op":"text","speaker":"紬","text":"“是的，说不好。”"},{"op":"text","speaker":"","text":"她果然和平时不太一样。"},{"op":"text","speaker":"羽依里","text":"“说起来，紬，你找到自己了吗？”"},{"op":"image","layer":257,"image":"i14477"},{"op":"text","speaker":"紬","text":"“没，没有。毕竟吕客罐的收集情况也不容乐观……”"},{"op":"text","speaker":"羽依里","text":"“那我们今天就帮帮你这个吧。”"},{"op":"image","layer":257,"image":"i14529"},{"op":"text","speaker":"紬","text":"“找吕客罐吗？”"},{"op":"text","speaker":"羽依里","text":"“不是，是找之前说过的那个。”"},{"op":"image","layer":257,"image":"i14396"},{"op":"text","speaker":"紬","text":"“姆啾？”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i10160"},{"op":"text","speaker":"苍","text":"“吕客卖完了。”"},{"op":"text","speaker":"羽依里","text":"“怎么一开口就这个。”"},{"op":"image","layer":257,"image":"i14506"},{"op":"text","speaker":"紬","text":"“你好。”"},{"op":"text","speaker":"羽依里","text":"“然而很遗憾，今天没小卖铺什么事。”"},{"op":"image","layer":257,"image":"i14473"},{"op":"text","speaker":"紬","text":"“今天我们帮羽依里先生购物，所以要去别的店。”"},{"op":"image","layer":1,"image":"i10322"},{"op":"text","speaker":"苍","text":"“啊，这样。”"},{"op":"image","layer":1,"image":"i10319"},{"op":"text","speaker":"苍","text":"“唉？那过来干吗？”"},{"op":"text","speaker":"羽依里","text":"“有点事想问问你。”"},{"op":"image","layer":1,"image":"i10146"},{"op":"text","speaker":"苍","text":"“唉？问我？”"},{"op":"text","speaker":"羽依里","text":"“紬。”"},{"op":"image","layer":257,"image":"i14396"},{"op":"text","speaker":"紬","text":"“姆啾？”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"image","layer":1,"image":"i14473"},{"op":"image","layer":257,"image":"i10267"},{"op":"text","speaker":"紬","text":"“～～～♪”"},{"op":"image","layer":257,"image":"i10270"},{"op":"text","speaker":"苍","text":"“嗯～……”"},{"op":"image","layer":1,"image":"i14489"},{"op":"image","layer":257,"image":"i10339"},{"op":"text","speaker":"苍","text":"“抱歉，听不出来。”"},{"op":"image","layer":1,"image":"i14388"},{"op":"text","speaker":"紬","text":"“这样啊……”"},{"op":"text","speaker":"","text":"我要问的，就是之前说过的寻找紬那支小曲出处的事。"},{"op":"text","speaker":"","text":"难得我们三人一起出门，所以就想试试。"},{"op":"text","speaker":"","text":"要是有人听过，说不定就能知道些什么。"},{"op":"image","layer":513,"image":"i13737"},{"op":"text","speaker":"静久","text":"“你就是为了这个才绕到空门这里来呀。”"},{"op":"text","speaker":"羽依里","text":"“嗯，得在夏天结束前找到出处才行。”"},{"op":"image","layer":1,"image":"i14501"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“话说回来，你这的吕客卖完了啊。”"},{"op":"text","speaker":"羽依里","text":"“是良一天善他们买的？”"},{"op":"image","layer":257,"image":"i10182"},{"op":"text","speaker":"苍","text":"“他们俩有买，另外我不在的时候好像也有人买。”"},{"op":"image","layer":1,"image":"i14401"},{"op":"text","speaker":"紬","text":"“很受欢迎吗？”"},{"op":"text","speaker":"","text":"总之还是回去买东西吧。"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i1"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“这边也有商店吧？”"},{"op":"image","layer":1,"image":"i13816"},{"op":"text","speaker":"静久","text":"“也就比这小卖铺大一点。”"},{"op":"image","layer":257,"image":"i12143"},{"op":"image","layer":513,"image":"i15025"},{"op":"text","speaker":"天善","text":"“水，水织学姐……！”"},{"op":"image","layer":1,"image":"i13770"},{"op":"text","speaker":"静久","text":"“唉呀，加纳同学，三谷同学。”"},{"op":"image","layer":257,"image":"i12161"},{"op":"text","speaker":"良一","text":"“学姐好啊。”"},{"op":"text","speaker":"羽依里","text":"“啊，我找你们俩也有事。”"},{"op":"image","layer":513,"image":"i15034"},{"op":"text","speaker":"天善","text":"“收集吕客罐!؟”"},{"op":"text","speaker":"羽依里","text":"“不是。”"},{"op":"image","layer":513,"image":"i15037"},{"op":"text","speaker":"天善","text":"“你的意思是……已经收集够了؟!”"},{"op":"image","layer":257,"image":"i12173"},{"op":"image","layer":513,"image":"i15030"},{"op":"image","layer":1,"image":"i13767"},{"op":"text","speaker":"天善","text":"“我去帮你造阳台！”"},{"op":"image","layer":257,"image":"i12140"},{"op":"text","speaker":"良一","text":"“你也太拼了吧。”"},{"op":"image","layer":769,"image":"i14388"},{"op":"text","speaker":"紬","text":"“没有，离收集够还早着……”"},{"op":"image","layer":7,"image":"i15037"},{"op":"text","speaker":"天善","text":"“这样……”"},{"op":"text","speaker":"羽依里","text":"“今天不是为了这个，而是想让你们听段曲子。”"},{"op":"text","speaker":"羽依里","text":"“紬，请吧。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"clear","layer":769},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"image","layer":1,"image":"i12140"},{"op":"image","layer":257,"image":"i15007"},{"op":"image","layer":513,"image":"i13737"},{"op":"text","speaker":"天善","text":"“这啥歌？”"},{"op":"text","speaker":"羽依里","text":"“紬心情好的时候就会哼的谜之曲子。”"},{"op":"image","layer":257,"image":"i15037"},{"op":"text","speaker":"天善","text":"“原来如此……”"},{"op":"image","layer":513,"image":"i13767"},{"op":"text","speaker":"静久","text":"“你们听过这支曲子，或者知道曲名吗？”"},{"op":"image","layer":257,"image":"i15019"},{"op":"text","speaker":"天善","text":"“十分抱歉！非常……遗憾。”"},{"op":"image","layer":1,"image":"i12184"},{"op":"text","speaker":"良一","text":"“我也不知道。”"},{"op":"image","layer":1,"image":"i12173"},{"op":"image","layer":257,"image":"i15007"},{"op":"text","speaker":"良一","text":"“所以你们今天就是想打听这支曲子？”"},{"op":"text","speaker":"羽依里","text":"“还有采购食材。”"},{"op":"image","layer":513,"image":"i13737"},{"op":"text","speaker":"静久","text":"“听说是帮他寄住的那家跑腿。”"},{"op":"image","layer":1,"image":"i12161"},{"op":"text","speaker":"良一","text":"“那你去渔港就行了。那新鲜度完全不是一个级别。”"},{"op":"text","speaker":"羽依里","text":"“想要速食食品也该去渔港？”"},{"op":"image","layer":1,"image":"i12143"},{"op":"text","speaker":"良一","text":"“那还用说。”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"image","layer":257,"image":"i15013"},{"op":"text","speaker":"天善","text":"“我劝你不要小看这岛的渔港。”"},{"op":"text","speaker":"","text":"意料之外的回答。"},{"op":"text","speaker":"","text":"这儿的渔港真厉害。"},{"op":"image","layer":513,"image":"i13740"},{"op":"text","speaker":"静久","text":"“那我们就在渔港购物吧？”"},{"op":"text","speaker":"羽依里","text":"“好。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"text","speaker":"羽依里","text":"“全是冷冻食品啊。”"},{"op":"image","layer":1,"image":"i14396"},{"op":"text","speaker":"紬","text":"“这里的饮食习惯真厉害。”"},{"op":"text","speaker":"","text":"紬似乎也开始冷静下来，话也一点点多了起来。"},{"op":"text","speaker":"羽依里","text":"“你这个把棉花糖和小面包当主食的人可没资格说他们。”"},{"op":"image","layer":1,"image":"i14494"},{"op":"text","speaker":"紬","text":"“棉花糖富含营养。”"},{"op":"image","layer":1,"image":"i14547"},{"op":"text","speaker":"紬","text":"“有许多矿物质。”"},{"op":"text","speaker":"","text":"大概并没有。"},{"op":"image","layer":1,"image":"i14506"},{"op":"text","speaker":"紬","text":"“我也吃其他的。”"},{"op":"image","layer":1,"image":"i14470"},{"op":"text","speaker":"紬","text":"“比如章鱼，我能吃很多。”"},{"op":"text","speaker":"","text":"我记得好像有挺多国家不吃章鱼。"},{"op":"text","speaker":"","text":"紬的国家是吃的吗。"},{"op":"text","speaker":"","text":"还是说只有紬吃呢。"},{"op":"text","speaker":"","text":"……总感觉是后者。"},{"op":"image","layer":257,"image":"i13767"},{"op":"text","speaker":"静久","text":"“啊，再磨蹭下去，冷冻食品都要化了哦。”"},{"op":"text","speaker":"羽依里","text":"“啊，我把东西拿回家一趟。”"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"静久","text":"“我去就行。”"},{"op":"text","speaker":"羽依里","text":"“唉？可是……”"},{"op":"image","layer":257,"image":"i13823"},{"op":"text","speaker":"静久","text":"“我知道地点，而且和你家的人我也见过面，没事的。”"},{"op":"text","speaker":"","text":"她难不成。"},{"op":"text","speaker":"","text":"是想让我们俩独处？"},{"op":"image","layer":257,"image":"i13846"},{"op":"text","speaker":"静久","text":"“所以你们俩就放心享受二人世界吧。”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"还真是。"},{"op":"text","speaker":"羽依里","text":"“好吧。”"},{"op":"image","layer":1,"image":"i14494"},{"op":"text","speaker":"紬","text":"“静久，请不要这样！”"},{"op":"image","layer":1,"image":"i14501"},{"op":"text","speaker":"紬","text":"“我很难为情的！”"},{"op":"image","layer":257,"image":"i13740"},{"op":"text","speaker":"静久","text":"“待会儿灯塔见。”"},{"op":"text","speaker":"羽依里","text":"“那我们走吧。”"},{"op":"image","layer":1,"image":"i14410"},{"op":"text","speaker":"紬","text":"“说，说的也是。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i14414"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"怎么办。"},{"op":"text","speaker":"","text":"……完全不知道该说什么。"},{"op":"text","speaker":"羽依里","text":"“原来你还会吃章鱼啊？”"},{"op":"image","layer":1,"image":"i14410"},{"op":"text","speaker":"紬","text":"“是的……会吃。会吃很多。”"},{"op":"image","layer":1,"image":"i14414"},{"op":"text","speaker":"紬","text":"“生吃……煮了吃……我都可以。”"},{"op":"text","speaker":"羽依里","text":"“是吗……我也吃的。”"},{"op":"image","layer":1,"image":"i14396"},{"op":"text","speaker":"紬","text":"“哦……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i14410"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"对话继续不下去。"},{"op":"image","layer":1,"image":"i14503"},{"op":"text","speaker":"紬","text":"“呃，接下来也是去购物吗？”"},{"op":"text","speaker":"羽依里","text":"“是啊，难得出来一趟。想买点东西再回去。”"},{"op":"image","layer":1,"image":"i14500"},{"op":"text","speaker":"紬","text":"“你要买什么呀？”"},{"op":"text","speaker":"羽依里","text":"“啊……”"},{"op":"text","speaker":"","text":"说起来，小卖铺那是卖完了，可不知道这里有没有。"},{"op":"text","speaker":"羽依里","text":"“不知道有没有吕客。”"},{"op":"image","layer":1,"image":"i14401"},{"op":"text","speaker":"紬","text":"“哦～吕客啊……”"},{"op":"image","layer":1,"image":"i14410"},{"op":"text","speaker":"紬","text":"“……很方便哎。”"},{"op":"text","speaker":"羽依里","text":"“是啊……而且还好吃。”"},{"op":"image","layer":1,"image":"i14381"},{"op":"text","speaker":"紬","text":"“就是。”"},{"op":"text","speaker":"羽依里","text":"“……我们先去店里逛逛再回灯塔吧？”"},{"op":"image","layer":1,"image":"i14412"},{"op":"text","speaker":"紬","text":"“可，可以的。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":1},{"op":"image","layer":0,"image":"i29"},{"op":"set","variable":6714,"value":4},{"op":"image","layer":1,"image":"i14410"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“啊……天开始黑了。”"},{"op":"image","layer":1,"image":"i14396"},{"op":"text","speaker":"紬","text":"“是，是啊……不过在这个岛上，傍晚很长。”"},{"op":"image","layer":1,"image":"i14410"},{"op":"text","speaker":"紬","text":"“天黑后就会黑不隆冬的……呃。”"},{"op":"image","layer":1,"image":"i14414"},{"op":"text","speaker":"紬","text":"“……姆，姆啾～……”"},{"op":"text","speaker":"","text":"我和紬都不知道自己想说些什么。"},{"op":"clear","layer":1},{"op":"image","layer":256,"image":"i167"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"","text":"实在不知道该怎么做，只能抬头仰望天空。"},{"op":"text","speaker":"","text":"要是能找到几颗星星，是不是也能用来打开话题呢。"},{"op":"text","speaker":"","text":"然而……"},{"op":"clear","layer":256},{"op":"image","layer":2,"image":"i751"},{"op":"image","layer":0,"image":"i514"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"云朵缓缓飘着。"},{"op":"text","speaker":"","text":"那是有如棉花糖一般巨大的云朵。"},{"op":"text","speaker":"","text":"尽管缓慢……"},{"op":"text","speaker":"","text":"但确实在流动着。"},{"op":"text","speaker":"","text":"……同时，时间也在流动着。"},{"op":"text","speaker":"","text":"能与她在一起的时间，正流逝着。"},{"op":"text","speaker":"","text":"一度以为无穷无尽的时间……正流逝着。"},{"op":"text","speaker":"羽依里","text":"“……嗯。”"},{"op":"text","speaker":"","text":"……好。"},{"op":"clear","layer":2},{"op":"image","layer":0,"image":"i29"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"羽依里","text":"“紬。”"},{"op":"image","layer":1,"image":"i14489"},{"op":"text","speaker":"紬","text":"“嗯？”"},{"op":"text","speaker":"羽依里","text":"“可以换个话题吗？”"},{"op":"image","layer":1,"image":"i14401"},{"op":"text","speaker":"紬","text":"“好。”"},{"op":"text","speaker":"羽依里","text":"“关于昨天说过的那事。”"},{"op":"image","layer":1,"image":"i14414"},{"op":"text","speaker":"紬","text":"“姆啾!؟”"},{"op":"image","layer":1,"image":"i14410"},{"op":"text","speaker":"紬","text":"“昨，昨天说过的事是……呃。”"},{"op":"text","speaker":"羽依里","text":"“就是我喜欢紬的事。”"},{"op":"image","layer":1,"image":"i14396"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"image","layer":1,"image":"i14410"},{"op":"text","speaker":"紬","text":"“虽，虽然我刚才说好……但其实不太好。”"},{"op":"image","layer":1,"image":"i14414"},{"op":"text","speaker":"紬","text":"“我一点心理准备……都还没做好。”"},{"op":"text","speaker":"羽依里","text":"“抱歉。我大概也还没做好说的准备……”"},{"op":"text","speaker":"羽依里","text":"“但我还是要说。”"},{"op":"image","layer":1,"image":"i14404"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"image","layer":0,"image":"i217"},{"op":"set","variable":6714,"value":4},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i14406"},{"op":"text","speaker":"羽依里","text":"“我喜欢你。”"},{"op":"text","speaker":"羽依里","text":"“你可能是把我当成一个朋友喜欢我。但我喜欢你，是把你当女孩子的喜欢。”"},{"op":"image","layer":1,"image":"i14397"},{"op":"text","speaker":"紬","text":"“……！”"},{"op":"image","layer":1,"image":"i14411"},{"op":"text","speaker":"紬","text":"“谢……”"},{"op":"image","layer":1,"image":"i14415"},{"op":"text","speaker":"紬","text":"“谢谢……你。”"},{"op":"image","layer":1,"image":"i14413"},{"op":"text","speaker":"紬","text":"“呃……我……很开心。”"},{"op":"image","layer":1,"image":"i14498"},{"op":"text","speaker":"紬","text":"“可是……那个……”"},{"op":"image","layer":1,"image":"i14504"},{"op":"text","speaker":"紬","text":"“羽依里先生……”"},{"op":"image","layer":1,"image":"i14539"},{"op":"text","speaker":"紬","text":"“那个……我……”"},{"op":"image","layer":1,"image":"i14542"},{"op":"text","speaker":"紬","text":"“……那个……呃……”"},{"op":"image","layer":0,"image":"i29"},{"op":"set","variable":6714,"value":4},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i14541"},{"op":"image","layer":1,"image":"i14501"},{"op":"text","speaker":"紬","text":"“……对不起！”"},{"op":"text","speaker":"羽依里","text":"“啊……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“呃……”"},{"op":"text","speaker":"","text":"我被……拒绝了？"},{"op":"text","speaker":"","text":"……哦。"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"羽依里","text":"“……嗯。”"},{"op":"text","speaker":"","text":"……嗯。"},{"op":"text","speaker":"","text":"……没我预想的那么失落。"},{"op":"text","speaker":"","text":"嗯。"},{"op":"text","speaker":"","text":"不对，应该是一点都不失落。"},{"op":"text","speaker":"","text":"不管是不是被她拒绝了，我都要把这个夏天给她。"},{"op":"text","speaker":"","text":"我和她约好了。"},{"op":"text","speaker":"","text":"所以……"},{"op":"text","speaker":"","text":"……我得去她那。"},{"op":"text","speaker":"羽依里","text":"“好嘞。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":256,"image":"i428"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"羽依里","text":"“――哈啊――哈啊！”"},{"op":"text","speaker":"","text":"我向紬在的地方奔跑着。"},{"op":"text","speaker":"","text":"也许并没有必要奔跑。"},{"op":"text","speaker":"","text":"毕竟不是在追赶她。"},{"op":"clear","layer":256},{"op":"image","layer":2,"image":"i746"},{"op":"image","layer":0,"image":"i514"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"","text":"只要到了那里，就一定能见到她。"},{"op":"text","speaker":"","text":"可当我回过神来。"},{"op":"text","speaker":"","text":"就已经在奔跑了。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":2},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i482"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"羽依里","text":"“……哈啊……哈啊。”"},{"op":"image","layer":0,"image":"i131"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"","text":"灯塔上，金发随风飘荡。"},{"op":"text","speaker":"羽依里","text":"“就是这了吧……”"},{"op":"image","layer":0,"image":"i132"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"就像我们第一次相遇时那样。"},{"op":"text","speaker":"","text":"灯塔上。"},{"op":"text","speaker":"","text":"紬仿佛在等待着什么。"},{"op":"text","speaker":"","text":"一个人伫立在那里。"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"text","speaker":"","text":"我走上露台……站在紬的身边。"},{"op":"set","variable":1,"value":0},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i1311"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i1310"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"但她并没有在哼那支小曲。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"紬","text":"“……羽依里先生。”"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“……紬。”"},{"op":"image","layer":0,"image":"i1312"},{"op":"set","variable":6714,"value":0},{"op":"set","variable":30013,"value":1},{"op":"text","speaker":"紬","text":"“"},{"op":"text","speaker":"紬","text":"啊!؟”"},{"op":"text","speaker":"","text":"紬吓得仿佛要跳起来似的，失去平衡，身子向栏杆一倾。"},{"op":"image","layer":0,"image":"i163"},{"op":"set","variable":6714,"value":4},{"op":"set","variable":30013,"value":1},{"op":"text","speaker":"紬","text":"“"},{"op":"text","speaker":"紬","text":"姆啾～～～～～～!؟”"},{"op":"text","speaker":"羽依里","text":"“噢噢噢噢哦噢！”"},{"op":"text","speaker":"","text":"我赶忙伸出手，紧紧抓住了她的手。"},{"op":"image","layer":0,"image":"i1313"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“谢，谢谢你。”"},{"op":"text","speaker":"羽依里","text":"“抱歉，吓到你了。”"},{"op":"text","speaker":"羽依里","text":"“听到你叫我名字，我还以为你肯定发现我来了。”"},{"op":"text","speaker":"紬","text":"“不是……”"},{"op":"text","speaker":"紬","text":"“我想事情想出神了。”"},{"op":"text","speaker":"羽依里","text":"“想出神了啊……”"},{"op":"text","speaker":"","text":"我能明白她的感受。"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“呃……那，那啥。”"},{"op":"text","speaker":"羽依里","text":"“我……还会来这哦？”"},{"op":"text","speaker":"紬","text":"“……？”"},{"op":"text","speaker":"羽依里","text":"“虽然被你拒绝了……但我已经决定把这个夏天给你了……所以，我还会来。”"},{"op":"text","speaker":"羽依里","text":"“就是身份变成了喜欢你的一个朋友……但也没差。”"},{"op":"text","speaker":"羽依里","text":"“所以你也……”"},{"op":"image","layer":0,"image":"i1314"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“那个……羽依里先生。”"},{"op":"text","speaker":"紬","text":"“请，请等一下。”"},{"op":"text","speaker":"紬","text":"“再一下下。”"},{"op":"text","speaker":"羽依里","text":"“一下下？……什么？”"},{"op":"text","speaker":"紬","text":"“是……”"},{"op":"text","speaker":"紬","text":"“心理准备。”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"text","speaker":"紬","text":"“我刚才……不是说我还没做好心理准备吗？”"},{"op":"text","speaker":"紬","text":"“……嘶…哈―……”"},{"op":"text","speaker":"紬","text":"“做好了。”"},{"op":"text","speaker":"羽依里","text":"“做好了啊。”"},{"op":"text","speaker":"紬","text":"“听……听我说。”"},{"op":"text","speaker":"紬","text":"“我，我也……喜欢哦？”"},{"op":"text","speaker":"紬","text":"“喜欢羽依里先生……”"},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"text","speaker":"羽依里","text":"“……唉？”"},{"op":"text","speaker":"紬","text":"“我以前应该也说过喜欢你了。”"},{"op":"text","speaker":"紬","text":"“和你相处无拘无束，我很喜欢。”"},{"op":"text","speaker":"羽依里","text":"“可那不是作为朋友的喜欢吗？”"},{"op":"text","speaker":"紬","text":"“当时是……这样的。”"},{"op":"text","speaker":"紬","text":"“是有这样的意思。”"},{"op":"text","speaker":"紬","text":"“可是……”"},{"op":"text","speaker":"紬","text":"“……也有另一个意思。”"},{"op":"text","speaker":"羽依里","text":"“……这样啊。”"},{"op":"text","speaker":"紬","text":"“听到我说可能再也见不了面了……你就告诉我要把暑假全部给我……”"},{"op":"text","speaker":"紬","text":"“……于是就有了另一个意思了。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"紬","text":"“听到你说那些话……我就……喜欢上你了。”"},{"op":"text","speaker":"紬","text":"“现在我的喜欢……并不是把你当朋友的喜欢。”"},{"op":"text","speaker":"紬","text":"“而是想每天和你在一起的……那种喜欢。”"},{"op":"text","speaker":"羽依里","text":"“这样……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"紬","text":"“虽然最近每天都和你在一起……但我……还是会想。”"},{"op":"text","speaker":"紬","text":"“想永远和你在一起。”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“我也是。”"},{"op":"image","layer":0,"image":"i1315"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“可，可是……我再过不久，就要回去了。”"},{"op":"text","speaker":"紬","text":"“……就不在这里了。”"},{"op":"text","speaker":"紬","text":"“所以……喜欢也……”"},{"op":"text","speaker":"紬","text":"“没有……意义。”"},{"op":"text","speaker":"羽依里","text":"“……紬。”"},{"op":"text","speaker":"紬","text":"“我非常非常开心……”"},{"op":"text","speaker":"紬","text":"“我也……对你……姆啾……”"},{"op":"text","speaker":"紬","text":"“……但是，对不起。”"},{"op":"text","speaker":"紬","text":"“到了告别的时候……我一定会，哭个不停的……”"},{"op":"text","speaker":"紬","text":"“一定会不想回去的……”"},{"op":"text","speaker":"紬","text":"“我不想要……”"},{"op":"text","speaker":"紬","text":"“……那种告别。”"},{"op":"text","speaker":"紬","text":"“所以……我想要隐藏这份感情……”"},{"op":"text","speaker":"紬","text":"“可为什么……还是说出口了啊。”"},{"op":"image","layer":2,"image":"i746"},{"op":"image","layer":0,"image":"i514"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"","text":"……是这样啊。"},{"op":"text","speaker":"","text":"原来是这样啊。"},{"op":"text","speaker":"","text":"我为什么会喜欢上紬。"},{"op":"text","speaker":"","text":"……如今，终于明白了。"},{"op":"clear","layer":2},{"op":"image","layer":0,"image":"i1315"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“我问你啊……”"},{"op":"text","speaker":"羽依里","text":"“……难道那样，就没有意义了吗？”"},{"op":"image","layer":0,"image":"i1313"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“姆啾？”"},{"op":"text","speaker":"羽依里","text":"“知道总有一天要分别，所以成为恋人就没有意义了吗？”"},{"op":"text","speaker":"羽依里","text":"“没有这回事。也不该有这回事。”"},{"op":"text","speaker":"","text":"没错。"},{"op":"text","speaker":"","text":"紬让我注意到了这一点。"},{"op":"text","speaker":"羽依里","text":"“紬啊。”"},{"op":"text","speaker":"羽依里","text":"“我……似乎还是喜欢游泳。”"},{"op":"text","speaker":"紬","text":"“……？”"},{"op":"text","speaker":"羽依里","text":"“在游泳部落魄，失去了游泳的意义。”"},{"op":"text","speaker":"羽依里","text":"“不能出场比赛，找不到游泳的意义。”"},{"op":"text","speaker":"羽依里","text":"“但我果然……还是喜欢游泳。”"},{"op":"text","speaker":"羽依里","text":"“虽然现在，还没有游泳的念头……”"},{"op":"text","speaker":"羽依里","text":"“但我有预感……总一天，我会重新游泳。”"},{"op":"text","speaker":"羽依里","text":"“哪怕我去告诉过去的自己‘你会在大赛上犯下大错，最后讨厌游泳’……”"},{"op":"text","speaker":"羽依里","text":"“我也一定会继续游。”"},{"op":"text","speaker":"羽依里","text":"“所以……我无法认为……当时在游泳部努力的我，大失败的我……没有意义……”"},{"op":"text","speaker":"羽依里","text":"“不，我从没这么认为过。”"},{"op":"image","layer":0,"image":"i1315"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“……羽依里先生。”"},{"op":"text","speaker":"羽依里","text":"“拼命游泳，拼命努力……”"},{"op":"text","speaker":"羽依里","text":"“所以，无法再走上赛场的时候，我开始讨厌游泳……”"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“哪怕知道总有一天要说再见，相恋也不是没有意义的。”"},{"op":"text","speaker":"羽依里","text":"“哪怕知道紬真的要离开我，我也会对你说。”"},{"op":"text","speaker":"羽依里","text":"“说……我喜欢你。”"},{"op":"image","layer":0,"image":"i1316"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“羽依里……先生。”"},{"op":"text","speaker":"羽依里","text":"“就像和游泳一样，拼命地享受和你的夏天，全力对你告白。”"},{"op":"text","speaker":"羽依里","text":"“最后啊……到了分别的那天，就让我们一起哭得不成个人样吧。”"},{"op":"text","speaker":"羽依里","text":"“这个暑假，就该这么全力去享受。”"},{"op":"text","speaker":"羽依里","text":"“就该这样才对。”"},{"op":"image","layer":0,"image":"i1317"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“可，可是……”"},{"op":"text","speaker":"紬","text":"“我……到那时一定会哭得很厉害。”"},{"op":"text","speaker":"紬","text":"“哪怕是现在……一想到告别的那天……就忍不住想哭。”"},{"op":"text","speaker":"紬","text":"“要是接下来的日子更加快乐的话……肯定会更夸张的。”"},{"op":"text","speaker":"紬","text":"“眼……眼泪会把脸弄得湿漉漉的。”"},{"op":"text","speaker":"羽依里","text":"“到那时，我的脸的惨状肯定也不输给你。”"},{"op":"text","speaker":"紬","text":"“我会哭得很大声哦？”"},{"op":"text","speaker":"羽依里","text":"“我和静久肯定也会大声哭的。”"},{"op":"text","speaker":"紬","text":"“鼻涕还会把脸弄得黏糊糊的。”"},{"op":"text","speaker":"紬","text":"“我说不定还会抱着你，把你的衣服弄脏哦？”"},{"op":"text","speaker":"羽依里","text":"“我的眼泪鼻涕说不定也会把你的衣服弄脏。”"},{"op":"text","speaker":"紬","text":"“哈……”"},{"op":"image","layer":0,"image":"i1318"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“是你的话……一点都没事。”"},{"op":"text","speaker":"羽依里","text":"“哦……”"},{"op":"text","speaker":"羽依里","text":"“那我也一点都没事。”"},{"op":"text","speaker":"紬","text":"“……嗯。”"},{"op":"text","speaker":"紬","text":"“……如，如果这样都没事的话……”"},{"op":"text","speaker":"紬","text":"“我想和……羽依里先生……交往……”"},{"op":"text","speaker":"羽依里","text":"“嗯……”"},{"op":"text","speaker":"紬","text":"“我……”"},{"op":"text","speaker":"紬","text":"“……最喜欢你了。”"},{"op":"text","speaker":"羽依里","text":"“我也是。”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"set","variable":1,"value":0},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i512"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"等到紬不再哭泣，太阳也完全落山，彻底入夜了。"},{"op":"image","layer":0,"image":"i139"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“那我今天就回去了。”"},{"op":"image","layer":1,"image":"i14390"},{"op":"text","speaker":"紬","text":"“嗯……（吸）。”"},{"op":"text","speaker":"","text":"她还在微微啜泣着。"},{"op":"text","speaker":"羽依里","text":"“……我再待会儿吧？”"},{"op":"image","layer":1,"image":"i14480"},{"op":"text","speaker":"紬","text":"“不用……（吸）……只是抑制不住感情而已。”"},{"op":"image","layer":1,"image":"i14390"},{"op":"text","speaker":"紬","text":"“不用担心。”"},{"op":"text","speaker":"羽依里","text":"“……抱歉。”"},{"op":"text","speaker":"羽依里","text":"“表述有点错了。”"},{"op":"image","layer":1,"image":"i14396"},{"op":"text","speaker":"紬","text":"“姆啾……？”"},{"op":"text","speaker":"羽依里","text":"“是我想再多和你一起待一会儿。”"},{"op":"image","layer":1,"image":"i14393"},{"op":"text","speaker":"紬","text":"“羽依里先生……”"},{"op":"image","layer":0,"image":"i323"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i14394"},{"op":"text","speaker":"","text":"我和紬并排坐着。"},{"op":"text","speaker":"羽依里","text":"“～～～～♪”"},{"op":"text","speaker":"","text":"接着哼起了她那支歌。"},{"op":"image","layer":1,"image":"i14487"},{"op":"text","speaker":"紬","text":"“……嘶……”"},{"op":"image","layer":1,"image":"i14513"},{"op":"text","speaker":"紬","text":"“～～～～、～～～～♪”"},{"op":"text","speaker":"","text":"紬也哼了起来。"},{"op":"image","layer":1,"image":"i14509"},{"op":"text","speaker":"","text":"歌声交汇，我的脸上洋溢出微笑。"},{"op":"text","speaker":"","text":"紬似乎也一样。"},{"op":"text","speaker":"","text":"刚才还泪汪汪的脸庞变得有些害羞起来。"},{"op":"text","speaker":"","text":"温暖的微笑与明朗的歌声。"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i512"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"我们俩就这样一直唱着。"},{"op":"text","speaker":"","text":"相互微笑着，唱着。"},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"image","layer":0,"image":"i139"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“那就明天见了。”"},{"op":"image","layer":1,"image":"i14417"},{"op":"text","speaker":"紬","text":"“嗯。”"},{"op":"image","layer":1,"image":"i14420"},{"op":"text","speaker":"紬","text":"“就让我们明日再会吧。”"},{"op":"text","speaker":"羽依里","text":"“嗯，晚安。”"},{"op":"if","truth":false,"target":730,"value":["==",["v",112],1]},{"op":"image","layer":1,"image":"i14412"},{"op":"text","speaker":"紬","text":"“晚，晚安……谢，谢谢惠顾～”"},{"op":"image","layer":1,"image":"i14414"},{"op":"text","speaker":"紬","text":"“姆啾～～～”"},{"op":"text","speaker":"羽依里","text":"“……？”"},{"op":"text","speaker":"","text":"谢谢惠顾？"},{"op":"text","speaker":"","text":"她在说什么？"},{"op":"text","speaker":"","text":"她又在害羞什么？"},{"op":"text","speaker":"","text":"不管了。"},{"op":"text","speaker":"羽依里","text":"“晚安。”"},{"op":"goto","target":732},{"op":"image","layer":1,"image":"i14412"},{"op":"text","speaker":"紬","text":"“晚安。”"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i133"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“……呼。”"},{"op":"text","speaker":"","text":"我和紬成为了恋人。"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"……难以置信。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"我应该没有傻笑吧。"},{"op":"text","speaker":"","text":"不，八成在傻笑。"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":7,"image":"i14511"},{"op":"text","speaker":"紬","text":"“～～～♪”"},{"op":"text","speaker":"","text":"灯塔传来了歌声。"},{"op":"text","speaker":"","text":"看来紬也很开心。"},{"op":"text","speaker":"","text":"我也很开心。"},{"op":"text","speaker":"","text":"不能输给她。"},{"op":"text","speaker":"羽依里","text":"“～～～♪”"},{"op":"if","truth":false,"target":766,"value":["==",["v",112],1]},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i27"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"……啊。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"刚才那谢谢惠顾莫非是！"},{"op":"text","speaker":"","text":"莫非是在叫我达令吗!؟"},{"op":"text","speaker":"","text":"之前静久好像有教过她。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"真后悔刚才没认真听。"},{"op":"goto","target":766},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]