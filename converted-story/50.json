[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"在那的……"},{"op":"text","speaker":"","text":"是白羽。"},{"op":"image","layer":0,"image":"i1069"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“你又来买啊。”"},{"op":"image","layer":0,"image":"i1071"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"白羽","text":"“我刚才看到进货了。”"},{"op":"text","speaker":"羽依里","text":"“你、你一直在这里侦查吗？”"},{"op":"image","layer":0,"image":"i1072"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“因为总是很快就卖完。”"},{"op":"text","speaker":"羽依里","text":"“这样啊。”"},{"op":"text","speaker":"","text":"不赶紧买，就没得买了吗。"},{"op":"text","speaker":"羽依里","text":"“行，这次我一定帮你买到。”"},{"op":"image","layer":0,"image":"i1071"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“……谢谢。”"},{"op":"text","speaker":"","text":"满怀期待的双眼看向我。"},{"op":"text","speaker":"","text":"这我绝不能辜负了她。"},{"op":"text","speaker":"","text":"加油啊我……虽然只是买根冰棍。"},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"走进店里。"},{"op":"text","speaker":"","text":"往冰箱中看去，西瓜棒确实有货了。"},{"op":"text","speaker":"羽依里","text":"“麻烦给我这个。”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“你之前也来过的吧。”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“很喜欢西瓜棒嘛。”"},{"op":"text","speaker":"羽依里","text":"“不是。老奶奶，之前我买的是蜜瓜棒。”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“……”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“都一样。”"},{"op":"text","speaker":"羽依里","text":"“啧啧啧。”"},{"op":"text","speaker":"羽依里","text":"“那可是天差地别。”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“城里人可真够挑的啊。”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“怎样都好，赶紧吃吧。”"},{"op":"text","speaker":"羽依里","text":"“好的。”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“你喜欢西瓜棒吗？”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“是吗是吗。”"},{"op":"text","speaker":"","text":"老奶奶不知为何还没把冰棍给我。"},{"op":"text","speaker":"","text":"更令人惊讶的是，她居然擅自开封了。"},{"op":"text","speaker":"羽依里","text":"“老奶奶？你干什么？”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“给。”"},{"op":"text","speaker":"","text":"她从袋子里拿出冰棍递给我。"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“在这吃吧。”"},{"op":"text","speaker":"羽依里","text":"“呃？”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“麦茶也随便喝。”"},{"op":"text","speaker":"羽依里","text":"“可是我，想到外面去吃……”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“外面那么热。”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“这铺有坐垫。”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“在这慢慢吃吧。”"},{"op":"text","speaker":"羽依里","text":"“不那个……”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“你啊，就是木户婆婆说的那孩子吧。”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“她说过让我们多多照顾你。”"},{"op":"text","speaker":"羽依里","text":"“呃可是。冰棍会融掉的。”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“在这吃吧。”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“你啊，跟我孙子挺像的。”"},{"op":"text","speaker":"","text":"拗不过了。"},{"op":"image","layer":1540,"image":"i196"},{"op":"image","layer":1796,"image":"i13145"},{"op":"image","layer":2052,"image":"i25242"},{"op":"text","speaker":"","text":"外面传来白羽那股强烈的视线。"},{"op":"text","speaker":"","text":"就如看着难以置信的东西一般。"},{"op":"clear","layer":1540},{"op":"clear","layer":1796},{"op":"clear","layer":2052},{"op":"clear","layer":2047},{"op":"clear","layer":1535},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13124"},{"op":"text","speaker":"羽依里","text":"“事情就是这样的。”"},{"op":"image","layer":1,"image":"i13101"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"image","layer":1,"image":"i13143"},{"op":"text","speaker":"白羽","text":"“这样啊。”"},{"op":"image","layer":1,"image":"i13115"},{"op":"text","speaker":"白羽","text":"“那真是无可奈何。”"},{"op":"image","layer":1,"image":"i13174"},{"op":"text","speaker":"白羽","text":"“无可奈何。”"},{"op":"image","layer":1,"image":"i13209"},{"op":"text","speaker":"白羽","text":"“对吧。”"},{"op":"text","speaker":"白羽","text":"“无可奈何吧。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"我无言以对。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"return"},{"op":"end"}]