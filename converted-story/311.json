[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"set","variable":1,"value":0},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"text","speaker":"羽依里","text":"“嗯……”"},{"op":"text","speaker":"","text":"好刺眼。"},{"op":"text","speaker":"","text":"这刺眼的光芒太过晃眼，害得我睁不开眼皮。"},{"op":"image","layer":7,"image":"i15333"},{"op":"text","speaker":"羽未","text":"“羽依里哥！”"},{"op":"text","speaker":"","text":"听到了声音。不是野美希的声音。是羽未吗……？"},{"op":"text","speaker":"羽依里","text":"“唔唔……”"},{"op":"image","layer":0,"image":"i69"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"","text":"这时我终于睁开了眼睛。"},{"op":"text","speaker":"","text":"想要坐起身来，但全身各处都在嘎吱作响般疼痛，根本起不来床。"},{"op":"text","speaker":"羽依里","text":"“羽……未……？”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“羽依里哥，认得我吗？”"},{"op":"text","speaker":"","text":"羽未以一副十分担心的表情盯着我看。"},{"op":"text","speaker":"","text":"我对她点了下头。"},{"op":"image","layer":1,"image":"i15340"},{"op":"text","speaker":"羽未","text":"“太好啦～……”"},{"op":"image","layer":1,"image":"i15378"},{"op":"text","speaker":"羽未","text":"“啊！对了！”"},{"op":"image","layer":1,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“镜子阿姨――――！羽依里哥他醒了――――!!”"},{"op":"text","speaker":"","text":"羽未大声喊道。"},{"op":"text","speaker":"","text":"随后，镜子阿姨便急匆匆地跑了过来。"},{"op":"image","layer":257,"image":"i11617"},{"op":"text","speaker":"镜子","text":"“哎呀哎呀，不得了！”"},{"op":"image","layer":257,"image":"i11563"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"镜子","text":"“羽依里，你醒了吗？没事吧？”"},{"op":"text","speaker":"羽依里","text":"“我没事。”"},{"op":"text","speaker":"","text":"强撑着疼痛的身体，我终于坐了起来。"},{"op":"text","speaker":"羽依里","text":"“说起来，我到底是……”"},{"op":"text","speaker":"","text":"完全没搞懂现在的状况。"},{"op":"text","speaker":"","text":"为什么羽未和镜子阿姨都这么惊慌失措呢？"},{"op":"text","speaker":"","text":"记忆有些模糊。"},{"op":"text","speaker":"","text":"环顾房间。像是晨光的光线透进了室内，房间里很明亮。"},{"op":"text","speaker":"","text":"看来这里是现实。"},{"op":"text","speaker":"","text":"对了，直到刚才我一直都在做梦。"},{"op":"image","layer":257,"image":"i11574"},{"op":"text","speaker":"镜子","text":"“羽依里，你整整睡了一天多啊。”"},{"op":"text","speaker":"羽依里","text":"“啊？整整一天多……？”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“今天是8月19号哦。”"},{"op":"text","speaker":"羽依里","text":"“不会吧，别开玩笑了。”"},{"op":"text","speaker":"羽依里","text":"“你们两个是想跟刚刚睡醒的我整蛊……吧……”"},{"op":"text","speaker":"","text":"我想活跃一下气氛，但看到镜子阿姨和羽未的模样和表情，话说到一半我就闭上了嘴。"},{"op":"text","speaker":"羽依里","text":"“抱歉，好像让你们担心了……”"},{"op":"text","speaker":"羽依里","text":"“可是，为什么我会睡整整一天呢……”"},{"op":"image","layer":1,"image":"i15360"},{"op":"text","speaker":"羽未","text":"“我才想问呢！发生什么事了？”"},{"op":"image","layer":257,"image":"i11614"},{"op":"text","speaker":"镜子","text":"“是不是吃了什么奇怪的东西？”"},{"op":"image","layer":257,"image":"i11626"},{"op":"text","speaker":"镜子","text":"“有没有哪里疼或者不舒服？”"},{"op":"text","speaker":"羽依里","text":"“不，完全没有。啊，就是身体各个关节有点疼。”"},{"op":"image","layer":257,"image":"i11571"},{"op":"text","speaker":"镜子","text":"“那是因为一直睡着没动弹的缘故。”"},{"op":"text","speaker":"羽依里","text":"“看来睡太久对身体也不好啊……”"},{"op":"image","layer":257,"image":"i11546"},{"op":"text","speaker":"镜子","text":"“总之，你醒过来就好。”"},{"op":"image","layer":1,"image":"i15340"},{"op":"text","speaker":"羽未","text":"“晃了你好几次都没醒呢。”"},{"op":"text","speaker":"羽依里","text":"“我居然睡得这么沉啊。”"},{"op":"text","speaker":"","text":"还以为人只有在浅睡眠的时候才会做梦呢。"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“偶尔还会说些梦话。”"},{"op":"image","layer":257,"image":"i11581"},{"op":"text","speaker":"羽依里","text":"“梦话？”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"羽依里","text":"“说、说了些什么梦话？”"},{"op":"text","speaker":"","text":"我战战兢兢地问道。"},{"op":"image","layer":1,"image":"i15369"},{"op":"text","speaker":"羽未","text":"“嗯……”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“唔啾～……之类的？”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"image","layer":257,"image":"i11584"},{"op":"text","speaker":"镜子","text":"“还有，啊嗯～之类的。”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“还说什么快来啊，你是要去哪里啊？”"},{"op":"image","layer":257,"image":"i11549"},{"op":"text","speaker":"镜子","text":"“这对羽未来说还为时尚早。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“嗯哎？”"},{"op":"image","layer":257,"image":"i11629"},{"op":"text","speaker":"镜子","text":"“这就是青春哦。”"},{"op":"image","layer":1,"image":"i15381"},{"op":"text","speaker":"羽未","text":"“哦，青春期啊。”"},{"op":"text","speaker":"羽依里","text":"“啊啊啊啊啊啊啊啊……！”"},{"op":"text","speaker":"","text":"我抱着头在绝望中打滚。"},{"op":"return"},{"op":"end"}]