[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“早……”"},{"op":"text","speaker":"","text":"……空无一人。"},{"op":"text","speaker":"","text":"客厅一片寂静。"},{"op":"if","truth":false,"target":22,"value":["==",["v",6003],2]},{"op":"text","speaker":"","text":"可能是去做广播体操还没回来，也可能是出去玩了。"},{"op":"text","speaker":"","text":"总之，肚子好饿。"},{"op":"text","speaker":"羽依里","text":"“唔……”"},{"op":"text","speaker":"","text":"我径直走向厨房。"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i65"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“我看看……”"},{"op":"text","speaker":"羽依里","text":"“啊，有了。”"},{"op":"text","speaker":"","text":"找到了乌冬杯面。"},{"op":"text","speaker":"羽依里","text":"“本来是游泳那段时间尽可能避开的食物……”"},{"op":"text","speaker":"","text":"但这几天已经完全迷上了。"},{"op":"goto","target":206},{"op":"text","speaker":"","text":"桌子上空空如也。"},{"op":"text","speaker":"","text":"可能是去做广播体操还没回来，也可能是出去玩了。"},{"op":"text","speaker":"","text":"看来也不像是准备了早饭的样子。"},{"op":"text","speaker":"","text":"虽然觉得大清早吃炒饭有点不合适，但等没有了又觉得空荡荡的。"},{"op":"text","speaker":"","text":"感觉我被驯化了。"},{"op":"text","speaker":"","text":"算了。"},{"op":"text","speaker":"","text":"有没有什么剩下的……"},{"op":"text","speaker":"","text":"并没有。"},{"op":"text","speaker":"","text":"算了，今天一天就忍忍吧。"},{"op":"text","speaker":"","text":"怎么办才好啊。"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i80"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“镜子阿姨。”"},{"op":"image","layer":7,"image":"i11646"},{"op":"text","speaker":"镜子","text":"“来了。”"},{"op":"text","speaker":"","text":"她从仓库中走了出来。"},{"op":"image","layer":1,"image":"i11647"},{"op":"text","speaker":"羽依里","text":"“羽未好像不在，没早饭吃了……”"},{"op":"text","speaker":"羽依里","text":"“有什么东西能垫垫肚子吗？”"},{"op":"image","layer":1,"image":"i11667"},{"op":"text","speaker":"镜子","text":"“这样啊，那我就……”"},{"op":"text","speaker":"羽依里","text":"“做给我吃吗？”"},{"op":"image","layer":1,"image":"i11664"},{"op":"text","speaker":"镜子","text":"“给你这个。”"},{"op":"text","speaker":"","text":"乌冬杯面。"},{"op":"text","speaker":"羽依里","text":"“……这是从哪里拿出来的……？”"},{"op":"image","layer":1,"image":"i11670"},{"op":"text","speaker":"镜子","text":"“很好吃的哦。”"},{"op":"text","speaker":"羽依里","text":"“好吃是好吃…”"},{"op":"text","speaker":"","text":"但大早上就吃速食食品……"},{"op":"text","speaker":"","text":"在参加社团活动那段时间基本没怎么吃过。"},{"op":"if","truth":false,"target":202,"value":[">",["v",24006],0]},{"op":"text","speaker":"羽依里","text":"“有没有卖早餐的店？”"},{"op":"image","layer":1,"image":"i11676"},{"op":"text","speaker":"镜子","text":"“唔……”"},{"op":"image","layer":1,"image":"i11674"},{"op":"text","speaker":"镜子","text":"“坡下的那家食堂应该有吧。”"},{"op":"text","speaker":"羽依里","text":"“那里从早上就开始营业了呀。”"},{"op":"image","layer":1,"image":"i11647"},{"op":"text","speaker":"镜子","text":"“嗯，我记得有早餐专用的菜品。”"},{"op":"text","speaker":"羽依里","text":"“早餐专用菜品……”"},{"op":"image","layer":1,"image":"i11670"},{"op":"text","speaker":"镜子","text":"“早间套餐。”"},{"op":"text","speaker":"羽依里","text":"“那位大叔在那间店里做早间套餐……”"},{"op":"text","speaker":"羽依里","text":"“有点难以想象，还有些吓人。”"},{"op":"text","speaker":"羽依里","text":"“也不知道是什么样的套餐。”"},{"op":"text","speaker":"","text":"老实说挺感兴趣。"},{"op":"text","speaker":"","text":"怎么办。"},{"op":"choice","variable":6001,"items":[{"text":"吃乌冬杯面","value":0,"condition":1},{"text":"去吃早间套餐","value":1,"condition":1}]},{"op":"if","truth":false,"target":75,"value":["==",["v",6001],0]},{"op":"goto","target":202},{"op":"if","truth":false,"target":201,"value":["==",["v",6001],1]},{"op":"text","speaker":"","text":"虽然害怕，但也很好奇。"},{"op":"text","speaker":"","text":"还是去看看吧。"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i37"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"食堂确实在营业。"},{"op":"text","speaker":"","text":"外面还摆着个莫名华丽的招牌。"},{"op":"text","speaker":"","text":"‘饮料+面包和沙拉 400日元’"},{"op":"text","speaker":"","text":"还像模像样的。"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i15"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"食堂的大叔","text":"“欢迎光临。”"},{"op":"text","speaker":"","text":"虽然稍有期待，不过店里也没其他客人。"},{"op":"text","speaker":"羽依里","text":"“来一份早间套餐。”"},{"op":"text","speaker":"食堂的大叔","text":"“好嘞。”"},{"op":"text","speaker":"羽依里","text":"“请问。”"},{"op":"text","speaker":"食堂的大叔","text":"“？”"},{"op":"text","speaker":"羽依里","text":"“饮料是什么……”"},{"op":"text","speaker":"羽依里","text":"“能选吗？”"},{"op":"text","speaker":"食堂的大叔","text":"“不。”"},{"op":"text","speaker":"羽依里","text":"“只有咖啡吗？”"},{"op":"text","speaker":"食堂的大叔","text":"“不。”"},{"op":"text","speaker":"","text":"不是咖啡？而且还不能选？"},{"op":"text","speaker":"羽依里","text":"“那是什么……”"},{"op":"text","speaker":"食堂的大叔","text":"“绿茶。”"},{"op":"text","speaker":"羽依里","text":"“绿茶？”"},{"op":"text","speaker":"","text":"早间套餐配绿茶……"},{"op":"text","speaker":"","text":"有够怪的。"},{"op":"text","speaker":"羽依里","text":"“是不是类似绿茶拿铁那样的？”"},{"op":"text","speaker":"食堂的大叔","text":"“就是普通绿茶。”"},{"op":"text","speaker":"羽依里","text":"“好吧。”"},{"op":"text","speaker":"","text":"似乎不是。"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"稍许片刻后。"},{"op":"text","speaker":"","text":"……叮。"},{"op":"text","speaker":"食堂的大叔","text":"“好了。”"},{"op":"text","speaker":"","text":"面包和黄油煎蛋以及沙拉。"},{"op":"text","speaker":"","text":"极其正统。"},{"op":"text","speaker":"","text":"而且面包还是现烤的牛角面包。"},{"op":"text","speaker":"","text":"居然在这里找到了牛角面包。"},{"op":"text","speaker":"","text":"羽未的努力究竟是为了什么。"},{"op":"text","speaker":"","text":"只不过这的饮料……"},{"op":"text","speaker":"","text":"真就只是普通的绿茶。"},{"op":"text","speaker":"","text":"绿茶就不能换成其他东西吗。"},{"op":"text","speaker":"","text":"唯独这个太格格不入了。"},{"op":"text","speaker":"","text":"算了，先尝尝看吧。"},{"op":"text","speaker":"羽依里","text":"“嚼。”"},{"op":"text","speaker":"羽依里","text":"“!؟”"},{"op":"text","speaker":"羽依里","text":"“这……”"},{"op":"text","speaker":"羽依里","text":"“好吃！”"},{"op":"text","speaker":"羽依里","text":"“嚼嚼。”"},{"op":"text","speaker":"羽依里","text":"“太好吃了。”"},{"op":"text","speaker":"羽依里","text":"“这牛角面包美味得出奇！”"},{"op":"text","speaker":"羽依里","text":"“可配着喝的居然是绿茶!!”"},{"op":"text","speaker":"羽依里","text":"“这算什么嘛。”"},{"op":"text","speaker":"羽依里","text":"“莫名地觉得不甘。”"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"text","speaker":"羽依里","text":"“……我吃好了。”"},{"op":"image","layer":0,"image":"i37"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"有那么美味的牛角面包却喝不到咖啡。"},{"op":"text","speaker":"","text":"还偏偏是绿茶。"},{"op":"text","speaker":"","text":"不过连水也没倒一杯，无奈只能向绿茶低头。"},{"op":"text","speaker":"","text":"真是揪心……"},{"op":"text","speaker":"羽依里","text":"“会上瘾的。”"},{"op":"image","layer":7,"image":"i15037"},{"op":"text","speaker":"天善","text":"“鹰原。”"},{"op":"text","speaker":"羽依里","text":"“!؟”"},{"op":"image","layer":1,"image":"i15011"},{"op":"text","speaker":"天善","text":"“你也一样吗？”"},{"op":"text","speaker":"羽依里","text":"“天善。”"},{"op":"image","layer":1,"image":"i15017"},{"op":"text","speaker":"天善","text":"“那种被不合理折磨后的奇妙感觉。”"},{"op":"image","layer":1,"image":"i15011"},{"op":"text","speaker":"天善","text":"“不知为何令人上瘾。”"},{"op":"text","speaker":"羽依里","text":"“我懂的。”"},{"op":"image","layer":1,"image":"i15008"},{"op":"text","speaker":"天善","text":"“你也懂对吧。”"},{"op":"image","layer":1,"image":"i15014"},{"op":"text","speaker":"天善","text":"“呼……”"},{"op":"image","layer":1,"image":"i15011"},{"op":"text","speaker":"天善","text":"“终于在这座岛上找到了心意相通的同志。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i363"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"走在路上回顾种种。"},{"op":"text","speaker":"","text":"冷静一想……"},{"op":"text","speaker":"","text":"大概不会再去了吧。"},{"op":"text","speaker":"羽依里","text":"“天善，你是真的上瘾了吗……”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i15"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15023"},{"op":"text","speaker":"天善","text":"“呃。”"},{"op":"image","layer":1,"image":"i15020"},{"op":"text","speaker":"天善","text":"“揪心。”"},{"op":"image","layer":1,"image":"i15035"},{"op":"text","speaker":"天善","text":"“但这揪心的感觉令人欲罢不能。”"},{"op":"image","layer":1,"image":"i15023"},{"op":"text","speaker":"天善","text":"“呃。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i363"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"好了，还是去别的地方看看吧。"},{"op":"goto","target":201},{"op":"goto","target":227},{"op":"text","speaker":"羽依里","text":"“乌冬杯面。”"},{"op":"text","speaker":"羽依里","text":"“……我开始吃了。”"},{"op":"text","speaker":"","text":"早上不吃点东西体力撑不住。"},{"op":"text","speaker":"","text":"要挺过夏日的炎热，这是最重要的。"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"加入开水后三分钟。"},{"op":"text","speaker":"羽依里","text":"“好了…我开动了。”"},{"op":"text","speaker":"","text":"分秒不差地过了规定好的时间，揭开盖子。"},{"op":"text","speaker":"羽依里","text":"“吸溜……吸溜……”"},{"op":"text","speaker":"羽依里","text":"“…！真、真好吃！”"},{"op":"text","speaker":"羽依里","text":"“明知这里面装着的都是对运动员身体不好的食物。”"},{"op":"text","speaker":"羽依里","text":"“但却故意而为之……”"},{"op":"text","speaker":"羽依里","text":"“就像是故意折磨自己身体的练习…”"},{"op":"text","speaker":"羽依里","text":"“欲罢不能…！”"},{"op":"text","speaker":"羽依里","text":"“这让人…想立马跑起来，消耗掉摄取的卡路里。”"},{"op":"text","speaker":"","text":"结果成了一顿难以形容的早餐。"},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"text","speaker":"羽依里","text":"“我吃饱了。”"},{"op":"text","speaker":"","text":"把汤都喝干净后，喘了口气。"},{"op":"text","speaker":"","text":"好了，今天做什么呢……"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"return"},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11549"},{"op":"text","speaker":"镜子","text":"“羽依里――”"},{"op":"text","speaker":"羽依里","text":"“什么事。”"},{"op":"image","layer":1,"image":"i11584"},{"op":"text","speaker":"镜子","text":"“你的朋友来了哦。”"},{"op":"text","speaker":"羽依里","text":"“……朋友？都这个点了？”"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i60"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"在玄关等待着我的是……"},{"op":"image","layer":1,"image":"i12174"},{"op":"text","speaker":"良一","text":"“哟。”"},{"op":"text","speaker":"羽依里","text":"“怎么了，大晚上的。”"},{"op":"image","layer":1,"image":"i12162"},{"op":"text","speaker":"良一","text":"“去钓鱼不？”"},{"op":"text","speaker":"羽依里","text":"“钓鱼？”"},{"op":"image","layer":1,"image":"i12180"},{"op":"text","speaker":"良一","text":"“夜钓啦。”"},{"op":"text","speaker":"羽依里","text":"“噢？”"},{"op":"text","speaker":"","text":"我没有在晚上钓过鱼。"},{"op":"text","speaker":"","text":"稍微有点兴趣。"},{"op":"text","speaker":"羽依里","text":"“好啊。”"},{"op":"text","speaker":"羽依里","text":"“我出去一会。”"},{"op":"image","layer":7,"image":"i11545"},{"op":"text","speaker":"镜子","text":"“好的。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i39"},{"op":"set","variable":6714,"value":1},{"op":"if","truth":false,"target":274,"value":["==",["v",419],1]},{"op":"text","speaker":"羽依里","text":"“说起来，你有好好穿着衣服啊”"},{"op":"image","layer":1,"image":"i12150"},{"op":"text","speaker":"良一","text":"“因为晚上还是会冷嘛。”"},{"op":"text","speaker":"羽依里","text":"“呃，嗯”"},{"op":"text","speaker":"","text":"也许他对裸体也没有什么特别的矜持或者原则。"},{"op":"goto","target":290},{"op":"text","speaker":"羽依里","text":"“咦，对了。”"},{"op":"image","layer":1,"image":"i12141"},{"op":"text","speaker":"良一","text":"“？”"},{"op":"text","speaker":"","text":"从他来时就觉得哪里不对劲。"},{"op":"text","speaker":"羽依里","text":"“你怎么穿着衣服？”"},{"op":"image","layer":1,"image":"i12156"},{"op":"text","speaker":"良一","text":"“哎呀。”"},{"op":"text","speaker":"","text":"良一难为情地挠了挠头。"},{"op":"image","layer":1,"image":"i12159"},{"op":"text","speaker":"良一","text":"“果然会怪怪的吧。”"},{"op":"text","speaker":"羽依里","text":"“也不是怪，但不知道该如何形容。”"},{"op":"text","speaker":"羽依里","text":"“抱歉，我不该吐这个槽。”"},{"op":"image","layer":1,"image":"i12150"},{"op":"text","speaker":"良一","text":"“因为晚上还是会冷嘛。”"},{"op":"text","speaker":"","text":"相当正经的理由。"},{"op":"text","speaker":"","text":"我还以为他对裸体有什么坚持，现在看来好像也不是那么一回事。"},{"op":"text","speaker":"","text":"夜晚的道路上，确实有些凉意。"},{"op":"text","speaker":"","text":"我或许应该再穿一件外衣的。"},{"op":"image","layer":1,"image":"i12141"},{"op":"text","speaker":"良一","text":"“……那么。”"},{"op":"image","layer":1,"image":"i12083"},{"op":"text","speaker":"良一","text":"“还是脱了吧。”"},{"op":"text","speaker":"羽依里","text":"“为什么啊!؟”"},{"op":"image","layer":1,"image":"i12081"},{"op":"text","speaker":"良一","text":"“因为啊……”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i516"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"良一陶醉地望着天空。"},{"op":"image","layer":7,"image":"i12099"},{"op":"text","speaker":"良一","text":"“感觉……夜空对我有所期待嘛。”"},{"op":"if","truth":false,"target":309,"value":["==",["v",419],1]},{"op":"text","speaker":"羽依里","text":"“……早知道就带水枪来了”"},{"op":"text","speaker":"","text":"作为执行部辅佐，这种情况应该开枪的吧？"},{"op":"goto","target":315},{"op":"text","speaker":"羽依里","text":"“夜空……”"},{"op":"text","speaker":"羽依里","text":"“你脑子有问题。”"},{"op":"image","layer":7,"image":"i12084"},{"op":"text","speaker":"良一","text":"“过奖啦。”"},{"op":"text","speaker":"","text":"怎么办。"},{"op":"text","speaker":"","text":"虽然这家伙感冒了也与我无关，但不想被别人觉得我和他是一路人。"},{"op":"image","layer":7,"image":"i12086"},{"op":"text","speaker":"良一","text":"“好痛！”"},{"op":"image","layer":0,"image":"i39"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“怎么了？”"},{"op":"image","layer":1,"image":"i12081"},{"op":"text","speaker":"良一","text":"“有什么东西打到乳头了。”"},{"op":"text","speaker":"羽依里","text":"“别一口一个乳头的，是不是虫子之类的？”"},{"op":"image","layer":1,"image":"i12065"},{"op":"text","speaker":"良一","text":"“不，这是……小纸团？”"},{"op":"text","speaker":"","text":"上面写着什么。"},{"op":"text","speaker":"","text":"‘夜深了不便用扩音器。’"},{"op":"text","speaker":"","text":"‘不过，我可看得清清楚楚的。’"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i170"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"我们一同抬头望向耸立于夜空的铁塔。"},{"op":"text","speaker":"羽依里","text":"“莫非是野美希？”"},{"op":"text","speaker":"","text":"是从那里把纸团射过来的吗？"},{"op":"text","speaker":"","text":"隐约看到一个人影。"},{"op":"text","speaker":"","text":"这么晚了还在啊。"},{"op":"text","speaker":"羽依里","text":"“大晚上的，她看得见吗？”"},{"op":"image","layer":7,"image":"i12093"},{"op":"text","speaker":"良一","text":"“应该是有夜视仪吧。”"},{"op":"text","speaker":"羽依里","text":"“还夜视仪呢。”"},{"op":"text","speaker":"羽依里","text":"“她的使命感为什么会那么强啊？”"},{"op":"image","layer":7,"image":"i12071"},{"op":"text","speaker":"良一","text":"“不知道。”"},{"op":"image","layer":7,"image":"i12068"},{"op":"text","speaker":"良一","text":"“说不定她其实挺怕孤单的？”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i39"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":1,"image":"i12124"},{"op":"text","speaker":"良一","text":"“呃啊。”"},{"op":"image","layer":1,"image":"i12087"},{"op":"text","speaker":"良一","text":"“好凉。”"},{"op":"text","speaker":"","text":"似乎是被浇了冷水。"},{"op":"text","speaker":"羽依里","text":"“莫非，她能听见我们说话？”"},{"op":"image","layer":1,"image":"i12065"},{"op":"text","speaker":"良一","text":"“什么？”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"羽依里","text":"“应该不会吧。”"},{"op":"image","layer":1,"image":"i12075"},{"op":"text","speaker":"良一","text":"“话说好冷啊，那家伙居然射冰水过来。”"},{"op":"image","layer":1,"image":"i12072"},{"op":"text","speaker":"良一","text":"“我要回家了。”"},{"op":"text","speaker":"","text":"他突然不安地环抱起自己的身体，准备脱逃。"},{"op":"text","speaker":"羽依里","text":"“喂，喂，夜钓呢……”"},{"op":"image","layer":7,"image":"i12077"},{"op":"text","speaker":"良一","text":"“我要回家。”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"羽依里","text":"“走掉了。”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i170"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"……我看向铁塔。"},{"op":"text","speaker":"","text":"隐约看见一个小小的身影。"},{"op":"if","truth":false,"target":382,"value":["&&",["==",["v",434],1],["==",["v",435],1]]},{"op":"callScene","scene":355,"target":2},{"op":"goto","target":496},{"op":"if","truth":false,"target":385,"value":["==",["v",24006],0]},{"op":"text","speaker":"","text":"趁她的水没射过来，我也赶紧回家算了……"},{"op":"goto","target":496},{"op":"text","speaker":"","text":"她是不是真听得见啊。"},{"op":"choice","variable":6001,"items":[{"text":"笨蛋","value":0,"condition":1},{"text":"我爱你","value":1,"condition":1},{"text":"内裤一览无余","value":2,"condition":1},{"text":"一言不发脱掉衣服","value":3,"condition":[">=",["v",24006],3]}]},{"op":"if","truth":false,"target":412,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“笨……”"},{"op":"text","speaker":"羽依里","text":"“呃啊!؟”"},{"op":"text","speaker":"","text":"还没说完，一股水就喷射进了嘴里。"},{"op":"image","layer":0,"image":"i39"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“咳咳咳。”"},{"op":"text","speaker":"","text":"太难受了。"},{"op":"text","speaker":"羽依里","text":"“我…”"},{"op":"text","speaker":"羽依里","text":"“我只不过是想叫一声外婆。”"},{"op":"text","speaker":"羽依里","text":"“太过分了吧。”"},{"op":"text","speaker":"羽依里","text":"“我只是因为想念过世的外婆，对着夜空叫她老人家一声而已！”"},{"op":"text","speaker":"","text":"飞过来一个小纸团。"},{"op":"text","speaker":"","text":"展开一看。"},{"op":"text","speaker":"","text":"‘对不起，没想到有这样的缘由。’"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"我对着铁塔，"},{"op":"text","speaker":"羽依里","text":"“啊，没有。”"},{"op":"text","speaker":"羽依里","text":"“是我骗你的。”"},{"op":"text","speaker":"","text":"哗啦。"},{"op":"text","speaker":"羽依里","text":"“呜哇！”"},{"op":"text","speaker":"","text":"被泼了冰水。"},{"op":"text","speaker":"羽依里","text":"“好冰。”"},{"op":"text","speaker":"","text":"回家吧。"},{"op":"goto","target":496},{"op":"if","truth":false,"target":431,"value":["==",["v",6001],1]},{"op":"text","speaker":"","text":"冷不丁的，她肯定会吓一跳吧。"},{"op":"text","speaker":"羽依里","text":"“我。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"咳咳。"},{"op":"text","speaker":"羽依里","text":"“我，爱……”"},{"op":"text","speaker":"羽依里","text":"“咳咳。”"},{"op":"text","speaker":"","text":"虽说是开玩笑，不过还是有些难为情。"},{"op":"text","speaker":"羽依里","text":"“我……爱…”"},{"op":"text","speaker":"羽依里","text":"“你。”"},{"op":"text","speaker":"羽依里","text":"“～～～～”"},{"op":"text","speaker":"","text":"玩笑而已吧。"},{"op":"text","speaker":"","text":"干吗说得结结巴巴的啊，鹰原羽依里。"},{"op":"text","speaker":"","text":"好痛。"},{"op":"text","speaker":"","text":"飞过来一个纸团。"},{"op":"text","speaker":"","text":"‘别恶心人了，快回去。’"},{"op":"text","speaker":"羽依里","text":"“对不起。”"},{"op":"set","variable":39,"value":1},{"op":"goto","target":496},{"op":"if","truth":false,"target":462,"value":["==",["v",6001],2]},{"op":"text","speaker":"羽依里","text":"“内…”"},{"op":"text","speaker":"羽依里","text":"“内裤一览无余。”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"羽依里","text":"“好痛。”"},{"op":"text","speaker":"","text":"飞过来一个纸团。"},{"op":"text","speaker":"","text":"‘我现在有穿安全裤。’"},{"op":"text","speaker":"羽依里","text":"“怎么这样。”"},{"op":"text","speaker":"","text":"既然如此。"},{"op":"text","speaker":"","text":"看我出绝招。"},{"op":"text","speaker":"羽依里","text":"“胸罩一览无余！”"},{"op":"image","layer":7,"image":"i11717"},{"op":"text","speaker":"美希","text":"“……！”"},{"op":"text","speaker":"","text":"远远地，看见野美希在铁塔上一个踉跄。"},{"op":"text","speaker":"","text":"嘿嘿。"},{"op":"text","speaker":"","text":"再来个致命一击。"},{"op":"text","speaker":"羽依里","text":"“毛孔也一览无余！”"},{"op":"text","speaker":"","text":"我来劲了。"},{"op":"text","speaker":"","text":"人影闪过。"},{"op":"image","layer":0,"image":"i39"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":1,"image":"i10156"},{"op":"text","speaker":"苍","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i10173"},{"op":"text","speaker":"苍","text":"“什么一览无余？”"},{"op":"text","speaker":"羽依里","text":"“……那个……毛孔……”"},{"op":"image","layer":1,"image":"i10156"},{"op":"text","speaker":"苍","text":"“看你如此享受岛上的生活，可真让人欣慰。”"},{"op":"text","speaker":"羽依里","text":"“对不起。”"},{"op":"goto","target":496},{"op":"if","truth":false,"target":496,"value":["==",["v",6001],3]},{"op":"text","speaker":"","text":"野美希对半裸男似乎带有一种类似憎恨的感情。"},{"op":"text","speaker":"","text":"但确切来说似乎又是因为烦良一……"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"现在我偏要激她一激。"},{"op":"text","speaker":"","text":"虽然讨厌被泼冰水……"},{"op":"text","speaker":"","text":"讨厌归讨厌……但还是有点小激动。"},{"op":"text","speaker":"羽依里","text":"“好。”"},{"op":"text","speaker":"","text":"我脱掉了上衣。"},{"op":"text","speaker":"","text":"里面自然是光着的。"},{"op":"text","speaker":"","text":"乳头与漫天星辰相会。"},{"op":"text","speaker":"","text":"我对着铁塔，对着天空张开双臂挺起胸膛。"},{"op":"text","speaker":"羽依里","text":"“来吧！”"},{"op":"text","speaker":"羽依里","text":"“来啊。”"},{"op":"text","speaker":"羽依里","text":"“放马过来。”"},{"op":"text","speaker":"؟؟؟","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“？”"},{"op":"image","layer":0,"image":"i39"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":1,"image":"i13244"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“!؟”"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“……来吧。”"},{"op":"image","layer":1,"image":"i13284"},{"op":"text","speaker":"白羽","text":"“死开。”"},{"op":"text","speaker":"羽依里","text":"“对不起。”"},{"op":"image","layer":1,"image":"i13270"},{"op":"text","speaker":"白羽","text":"“死开。”"},{"op":"text","speaker":"羽依里","text":"“不是的。”"},{"op":"image","layer":1,"image":"i13272"},{"op":"text","speaker":"白羽","text":"“死开。”"},{"op":"text","speaker":"羽依里","text":"“原谅我。”"},{"op":"goto","target":496},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i73"},{"op":"set","variable":6714,"value":0},{"op":"if","truth":false,"target":509,"value":["&&",["==",["v",434],1],["==",["v",435],1]]},{"op":"text","speaker":"羽依里","text":"“……虽然没能去夜钓，不过感觉还蛮不错的”"},{"op":"text","speaker":"","text":"我在星空和海浪声的环绕中，享受了岛上的夜晚。"},{"op":"text","speaker":"","text":"与白天不同，是一次全新的体验。"},{"op":"goto","target":511},{"op":"text","speaker":"羽依里","text":"“……原本我对夜钓还蛮有兴趣的。”"},{"op":"text","speaker":"","text":"以为和白天不同，会有新的发现。"},{"op":"text","speaker":"","text":"不过，夜晚的海感觉也有些可怕。"},{"op":"text","speaker":"","text":"一片深邃黑暗……"},{"op":"text","speaker":"","text":"仿佛会被吸进去一样……"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"","text":"无可避免地回想起了不好的事。"},{"op":"text","speaker":"羽依里","text":"“睡吧…”"},{"op":"image","layer":0,"image":"i75"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“唉…”"},{"op":"text","speaker":"","text":"意志变得消沉。"},{"op":"text","speaker":"","text":"一觉忘干净吧……"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"if","truth":false,"target":536,"value":["==",["v",139],1]},{"op":"text","speaker":"羽依里","text":"“……啊。”"},{"op":"image","layer":0,"image":"i75"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"对了……"},{"op":"text","speaker":"","text":"还要设置岛可梦对决的饵……"},{"op":"text","speaker":"","text":"……怎么办呢。"},{"op":"callScene","scene":278,"target":1592},{"op":"goto","target":536},{"op":"return"},{"op":"end"}]