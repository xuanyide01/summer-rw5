[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":2,"image":"i742"},{"op":"image","layer":0,"image":"i513"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"第二天早上。"},{"op":"text","speaker":"","text":"刚6点我就被带到了港口。"},{"op":"image","layer":7,"image":"i12399"},{"op":"image","layer":6,"image":"i25241"},{"op":"text","speaker":"小鸠","text":"“玄玄！”"},{"op":"text","speaker":"蓄着胡须的老爷爷","text":"“青青！”"},{"op":"text","speaker":"羽依里","text":"“雀雀！”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":2},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i1"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i12373"},{"op":"text","speaker":"小鸠","text":"“哈啊，哈啊……”"},{"op":"text","speaker":"羽依里","text":"“哈啊，哈啊。”"},{"op":"text","speaker":"","text":"我总算知道了，包括小鸠老爷子在内，这其实是打完渔后的老爷子们聚在一起想玩一下而已。"},{"op":"text","speaker":"","text":"可把我拉过来陪他们，也太不讲道理了。"},{"op":"text","speaker":"蓄着胡须的老爷爷","text":"“真亏你到现在还能跟得上我们啊。”"},{"op":"text","speaker":"强壮的老爷爷","text":"“已经没有什么能教你的了。”"},{"op":"image","layer":1,"image":"i12368"},{"op":"text","speaker":"小鸠","text":"“四天王的称号就给你一个好了。”"},{"op":"text","speaker":"蓄着胡须的老爷爷","text":"“喜欢哪个就拿走吧。”"},{"op":"text","speaker":"羽依里","text":"“真的可以吗？”"},{"op":"text","speaker":"羽依里","text":"“那就青龙。”"},{"op":"text","speaker":"","text":"感觉这个比较酷。"},{"op":"text","speaker":"蓄着胡须的老爷爷","text":"“青龙，是我的啊……”"},{"op":"text","speaker":"羽依里","text":"“唉唉？”"},{"op":"text","speaker":"蓄着胡须的老爷爷","text":"“不，既然说了随你挑……那就给你了。”"},{"op":"text","speaker":"羽依里","text":"“不，不用了。”"},{"op":"text","speaker":"羽依里","text":"“那就白虎。”"},{"op":"text","speaker":"强壮的老爷爷","text":"“啊……”"},{"op":"text","speaker":"羽依里","text":"“怎么了？”"},{"op":"text","speaker":"强壮的老爷爷","text":"“没什么。”"},{"op":"text","speaker":"羽依里","text":"“你的语气很悲伤啊。”"},{"op":"text","speaker":"强壮的老爷爷","text":"“才没有。”"},{"op":"text","speaker":"羽依里","text":"“那个，白虎……”"},{"op":"text","speaker":"强壮的老爷爷","text":"“啊……”"},{"op":"text","speaker":"羽依里","text":"“所以说怎么了啊？”"},{"op":"text","speaker":"强壮的老爷爷","text":"“没什么！”"},{"op":"image","layer":1,"image":"i12174"},{"op":"text","speaker":"良一","text":"“羽依里，你在干什么？”"},{"op":"text","speaker":"羽依里","text":"“修行。”"},{"op":"image","layer":1,"image":"i12150"},{"op":"text","speaker":"良一","text":"“怎么连你都在说这种天善一样的话，饶了我吧。”"},{"op":"text","speaker":"羽依里","text":"“我是被强拖过来的。”"},{"op":"image","layer":1,"image":"i12174"},{"op":"text","speaker":"良一","text":"“被谁？”"},{"op":"text","speaker":"羽依里","text":"“还问谁……”"},{"op":"text","speaker":"羽依里","text":"“咦，都不见了。”"},{"op":"text","speaker":"","text":"这几个人好任性啊。"},{"op":"text","speaker":"羽依里","text":"“那我现在到底是四天王的哪一个啊。”"},{"op":"image","layer":1,"image":"i12150"},{"op":"text","speaker":"良一","text":"“你想当四天王的什么吗？”"},{"op":"text","speaker":"羽依里","text":"“并不想。”"},{"op":"image","layer":1,"image":"i12162"},{"op":"text","speaker":"良一","text":"“喂，我们去山里面吧。”"},{"op":"text","speaker":"羽依里","text":"“山里……？为什么啊？”"},{"op":"clear","layer":1},{"op":"image","layer":2,"image":"i741"},{"op":"image","layer":0,"image":"i513"},{"op":"set","variable":6714,"value":0},{"op":"set","variable":7120,"value":2},{"op":"clear","layer":2},{"op":"image","layer":256,"image":"i516"},{"op":"set","variable":6714,"value":1},{"op":"clear","layer":256},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i24"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i12162"},{"op":"text","speaker":"良一","text":"“于是。”"},{"op":"image","layer":1,"image":"i12165"},{"op":"text","speaker":"良一","text":"“今天就让我们男人自己庆祝一下吧。”"},{"op":"text","speaker":"羽依里","text":"“为什么？”"},{"op":"image","layer":1,"image":"i12180"},{"op":"text","speaker":"良一","text":"“外国电影里面不是经常有吗。”"},{"op":"image","layer":1,"image":"i12190"},{"op":"text","speaker":"良一","text":"“结婚前夜的新郎和朋友们，最后疯上一夜。”"},{"op":"image","layer":1,"image":"i12193"},{"op":"text","speaker":"良一","text":"“就是所谓的告别单身派对。”"},{"op":"text","speaker":"羽依里","text":"“哦。”"},{"op":"text","speaker":"羽依里","text":"“我不怎么看电影所以不清楚。”"},{"op":"text","speaker":"羽依里","text":"“具体要干点什么？”"},{"op":"image","layer":257,"image":"i15110"},{"op":"text","speaker":"天善","text":"“深蹲吗？”"},{"op":"text","speaker":"羽依里","text":"“为什么来这种地方还要练深蹲啊。”"},{"op":"image","layer":257,"image":"i15038"},{"op":"text","speaker":"天善","text":"“不是，我以为你其实还挺喜欢练的。”"},{"op":"image","layer":257,"image":"i15044"},{"op":"text","speaker":"天善","text":"“之前我躲在暗处看着你跟白羽的外公他们玩得很开心。”"},{"op":"text","speaker":"羽依里","text":"“一点都不开心，而且你为何要躲在暗处羡慕地看啊。”"},{"op":"image","layer":257,"image":"i15026"},{"op":"text","speaker":"天善","text":"“我，我才没有羡慕地看。”"},{"op":"image","layer":1,"image":"i12180"},{"op":"text","speaker":"良一","text":"“一般都是去看个脱衣舞，或者干点下流的事。”"},{"op":"text","speaker":"羽依里","text":"“这岛上有那种东西!؟”"},{"op":"image","layer":1,"image":"i12159"},{"op":"text","speaker":"良一","text":"“怎么可能有。”"},{"op":"image","layer":1,"image":"i12180"},{"op":"text","speaker":"良一","text":"“不过，有更刺激的。”"},{"op":"image","layer":1,"image":"i12217"},{"op":"text","speaker":"良一","text":"“下流收藏大公开。”"},{"op":"image","layer":257,"image":"i15035"},{"op":"text","speaker":"天善","text":"“……什么！”"},{"op":"image","layer":257,"image":"i15017"},{"op":"text","speaker":"天善","text":"“我走了。”"},{"op":"image","layer":1,"image":"i12147"},{"op":"text","speaker":"良一","text":"“就这点小事也能让你慌神。”"},{"op":"image","layer":1,"image":"i12150"},{"op":"text","speaker":"良一","text":"“不能保持平常心的话，赢不了比赛哦。”"},{"op":"image","layer":257,"image":"i15106"},{"op":"text","speaker":"天善","text":"“这跟比赛有什么关系。”"},{"op":"image","layer":1,"image":"i12171"},{"op":"text","speaker":"良一","text":"“蠢货，那要是对手很性感你怎么办？”"},{"op":"image","layer":257,"image":"i15116"},{"op":"text","speaker":"天善","text":"“什么!؟”"},{"op":"text","speaker":"羽依里","text":"“那是什么对手啊？”"},{"op":"image","layer":257,"image":"i15020"},{"op":"text","speaker":"天善","text":"“你说的……没错。”"},{"op":"text","speaker":"羽依里","text":"“没错吗？”"},{"op":"image","layer":257,"image":"i15014"},{"op":"text","speaker":"天善","text":"“好吧，这也算一种修行。”"},{"op":"text","speaker":"羽依里","text":"“天善你，拿修行当借口其实只是想看而已吧。”"},{"op":"image","layer":257,"image":"i15026"},{"op":"text","speaker":"天善","text":"“!؟”"},{"op":"image","layer":257,"image":"i15149"},{"op":"text","speaker":"天善","text":"“你你你，你别胡说八道！”"},{"op":"text","speaker":"羽依里","text":"“很危险耶，别拿着球拍乱挥。”"},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“喂，差不多该开始了。”"},{"op":"image","layer":7,"image":"i15028"},{"op":"clear","layer":6},{"op":"text","speaker":"羽依里·天善","text":"“好！”"},{"op":"image","layer":1,"image":"i12188"},{"op":"text","speaker":"良一","text":"“入场编号1号。”"},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“‘Sun Eater’。”"},{"op":"image","layer":1,"image":"i12159"},{"op":"text","speaker":"良一","text":"“拥有‘弑日者’之名的它，是以压倒性的射程和精度而闻名的步枪。”"},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“狭长的胴体透露出绝妙的性感，劲爆女孩。”"},{"op":"image","layer":1,"image":"i12193"},{"op":"text","speaker":"良一","text":"“定能一击必杀，射穿男儿们的心。”"},{"op":"text","speaker":"羽依里","text":"“这下流吗……？”"},{"op":"image","layer":1,"image":"i12162"},{"op":"text","speaker":"良一","text":"“入场编号2号‘Blue Impulse’。”"},{"op":"image","layer":1,"image":"i12159"},{"op":"text","speaker":"良一","text":"“射程和连射性能虽然稍差，但贯通力无与伦比。无论对方穿着多么厚实的装甲都能射穿心脏。”"},{"op":"image","layer":1,"image":"i12180"},{"op":"text","speaker":"良一","text":"“它的枪口，就如同雌豹的双眼般闪烁着危险的光芒，紧盯目标。”"},{"op":"image","layer":1,"image":"i12220"},{"op":"text","speaker":"良一","text":"“等等，这列表是怎么回事啊!؟”"},{"op":"text","speaker":"羽依里","text":"“发现得有够晚，而且你不是还兴冲冲地解说起来了。”"},{"op":"text","speaker":"羽依里","text":"“你小子，居然用下流来形容这种东西当成宝收藏啊？”"},{"op":"text","speaker":"羽依里","text":"“真是超乎想象的变态。”"},{"op":"image","layer":1,"image":"i12153"},{"op":"text","speaker":"良一","text":"“才不是！”"},{"op":"image","layer":1,"image":"i12168"},{"op":"text","speaker":"良一","text":"“喂，我那些收藏哪去了？”"},{"op":"image","layer":257,"image":"i11707"},{"op":"text","speaker":"美希","text":"“烧掉了。”"},{"op":"image","layer":1,"image":"i12153"},{"op":"text","speaker":"良一","text":"“为什么要烧！话说你为什么会在！”"},{"op":"image","layer":1,"image":"i12168"},{"op":"text","speaker":"羽依里","text":"“在干什么啊？”"},{"op":"image","layer":513,"image":"i10322"},{"op":"text","speaker":"苍","text":"“我们女孩子打算聚一聚。”"},{"op":"image","layer":513,"image":"i10392"},{"op":"text","speaker":"苍","text":"“就那个，外国电影里，婚礼前夜都会让新娘和她的闺蜜们出来聚会疯玩的吧。”"},{"op":"image","layer":1,"image":"i12147"},{"op":"text","speaker":"良一","text":"“我知道，还会叫个浑身肌肉的脱衣舞男来。”"},{"op":"image","layer":1,"image":"i12168"},{"op":"text","speaker":"良一","text":"“咦!؟”"},{"op":"image","layer":1,"image":"i12193"},{"op":"text","speaker":"良一","text":"“莫非就是为这个来叫我的!؟”"},{"op":"image","layer":257,"image":"i11701"},{"op":"text","speaker":"美希","text":"“谁要叫！”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"苍","text":"“总之就想着开个送行会？之类的然后去找人。”"},{"op":"image","layer":257,"image":"i11780"},{"op":"text","speaker":"美希","text":"“结果没找到白羽。”"},{"op":"text","speaker":"羽依里","text":"“找不到吗？”"},{"op":"image","layer":257,"image":"i11755"},{"op":"text","speaker":"美希","text":"“也不在这的样子。”"},{"op":"image","layer":257,"image":"i11769"},{"op":"text","speaker":"美希","text":"“白羽到处乱逛也不是一天两天的事了。”"},{"op":"image","layer":257,"image":"i11775"},{"op":"text","speaker":"美希","text":"“不过在仪式前夜，还是有点令人在意。”"},{"op":"image","layer":1,"image":"i10319"},{"op":"text","speaker":"苍","text":"“有没有可能是到了前夜突然觉得新郎太恶心？”"},{"op":"text","speaker":"羽依里","text":"“哪怕有也求你不要去想这种可能。”"},{"op":"image","layer":257,"image":"i11780"},{"op":"text","speaker":"美希","text":"“可是大晚上的，一群人去找她感觉也很奇怪。”"},{"op":"image","layer":513,"image":"i15008"},{"op":"text","speaker":"天善","text":"“让男生们去找吗？”"},{"op":"text","speaker":"羽依里","text":"“我一个人去找找看吧。”"},{"op":"image","layer":513,"image":"i15038"},{"op":"image","layer":1,"image":"i12174"},{"op":"text","speaker":"良一","text":"“羽依里……”"},{"op":"text","speaker":"羽依里","text":"“啊，不是。”"},{"op":"text","speaker":"羽依里","text":"“我可能知道她在哪。”"},{"op":"text","speaker":"羽依里","text":"“我去那地方看看。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i39"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"我走向海边。"},{"op":"text","speaker":"","text":"她应该在那地方，我有种莫名的自信。"},{"op":"text","speaker":"","text":"现在一想，还好前些日子到处找，最终找到了她。"},{"op":"text","speaker":"","text":"――全都是连在一起的。"},{"op":"text","speaker":"","text":"我突然，有了这种想法。"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i170"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“喂。”"},{"op":"image","layer":0,"image":"i1090"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“唉？”"},{"op":"text","speaker":"","text":"独自伫立在海边的白羽回过头来。"},{"op":"text","speaker":"白羽","text":"“羽依里。”"},{"op":"text","speaker":"","text":"我叹了口气，向她走去。"},{"op":"text","speaker":"羽依里","text":"“大家都在找你呢。”"},{"op":"text","speaker":"羽依里","text":"“也不是让你别乱跑，不过先跟别人说一声吧。”"},{"op":"image","layer":0,"image":"i1092"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“……对不起。”"},{"op":"text","speaker":"白羽","text":"“都叫我今天晚上不要到外面去。”"},{"op":"text","speaker":"白羽","text":"“可我就是很想来这一趟。”"},{"op":"text","speaker":"白羽","text":"“就偷偷跑来了……”"},{"op":"text","speaker":"羽依里","text":"“是吗。”"},{"op":"text","speaker":"羽依里","text":"“那就没办法了。”"},{"op":"image","layer":0,"image":"i1089"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"白羽","text":"“我看到了。”"},{"op":"text","speaker":"白羽","text":"“它变得越来越鲜明。”"},{"op":"text","speaker":"羽依里","text":"“溺水时的情景吗？”"},{"op":"text","speaker":"白羽","text":"“嗯，我想应该是说明那一刻快要到了。”"},{"op":"text","speaker":"白羽","text":"“果然，羽依里也在那。”"},{"op":"text","speaker":"白羽","text":"“这次我看的很清楚。”"},{"op":"text","speaker":"羽依里","text":"“是吗。”"},{"op":"text","speaker":"白羽","text":"“而且……那是……”"},{"op":"text","speaker":"羽依里","text":"“什么？”"},{"op":"text","speaker":"白羽","text":"“没什么。”"},{"op":"text","speaker":"羽依里","text":"“？”"},{"op":"text","speaker":"羽依里","text":"“不过，看清了就好。”"},{"op":"image","layer":0,"image":"i1090"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“唉？”"},{"op":"text","speaker":"羽依里","text":"“虽然还是不知道发生了什么。”"},{"op":"text","speaker":"羽依里","text":"“不过我好像是帮上了忙。”"},{"op":"image","layer":0,"image":"i1089"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“……也不知道有没有帮上忙。”"},{"op":"text","speaker":"白羽","text":"“可能就只是一起溺水了而已。”"},{"op":"text","speaker":"羽依里","text":"“哪怕是这样，也比不在你身边好。”"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“你，你怎么了？”"},{"op":"text","speaker":"白羽","text":"“你……”"},{"op":"text","speaker":"白羽","text":"“为什么。”"},{"op":"text","speaker":"白羽","text":"“为什么要找上我？”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"text","speaker":"白羽","text":"“还带我去了那么多地方……”"},{"op":"text","speaker":"白羽","text":"“我一个人本来无所谓的。”"},{"op":"text","speaker":"白羽","text":"“早就想要消失了。”"},{"op":"text","speaker":"白羽","text":"“反正我这种人活着也没什么意义――”"},{"op":"text","speaker":"羽依里","text":"“你说什么？”"},{"op":"text","speaker":"白羽","text":"“我消失了也无所谓。可是……”"},{"op":"text","speaker":"白羽","text":"“可是……！”"},{"op":"text","speaker":"白羽","text":"“我无法承受再有谁，再有我重视的人消失了。”"},{"op":"text","speaker":"白羽","text":"“我不要。”"},{"op":"text","speaker":"白羽","text":"“不要再失去了。”"},{"op":"text","speaker":"羽依里","text":"“再……”"},{"op":"text","speaker":"","text":"应该是指她的父母吧。"},{"op":"text","speaker":"","text":"同时失去了双亲。"},{"op":"text","speaker":"","text":"从那时开始，白羽的心似乎就被她扔在了某个地方。"},{"op":"text","speaker":"","text":"扔在了过去的愉快夏日里。"},{"op":"text","speaker":"羽依里","text":"“当时是个备受期待1年级生。”"},{"op":"image","layer":0,"image":"i1090"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“？”"},{"op":"text","speaker":"羽依里","text":"“是说去年的，夏天时的我。”"},{"op":"text","speaker":"羽依里","text":"“我说过我以前是游泳部的对吧。”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"text","speaker":"羽依里","text":"“许多人对我寄予了厚望。”"},{"op":"text","speaker":"羽依里","text":"“力压3年级生当选接力赛的压轴。”"},{"op":"text","speaker":"羽依里","text":"“同级生里面，也有好几个天赋很好的人。”"},{"op":"text","speaker":"羽依里","text":"“我跟他们联手，对学长和顾问提了很多建议。”"},{"op":"text","speaker":"羽依里","text":"“在那成绩一般的公立校发起改革。”"},{"op":"text","speaker":"羽依里","text":"“为了把社团打造成一支强队，我们用尽办法。”"},{"op":"text","speaker":"羽依里","text":"“觉得就算因此有学长被挤出去，也是无可奈何的事。”"},{"op":"text","speaker":"羽依里","text":"“觉得胜负就是这么回事。”"},{"op":"text","speaker":"羽依里","text":"“学长们都是好人。”"},{"op":"text","speaker":"羽依里","text":"“非但不怪我们，还甘愿全力辅助。”"},{"op":"text","speaker":"羽依里","text":"“以我们一年级生为中心的队伍，出战了夏天的大赛。”"},{"op":"text","speaker":"羽依里","text":"“我负责压轴。”"},{"op":"text","speaker":"羽依里","text":"“第一天的400米自由接力预选赛。”"},{"op":"text","speaker":"羽依里","text":"“轮到我的时候，我们是第一名，而且成绩足以冲击县记录。”"},{"op":"text","speaker":"羽依里","text":"“然而。”"},{"op":"text","speaker":"羽依里","text":"“在我旁边那泳道，有个没见过的家伙。”"},{"op":"text","speaker":"羽依里","text":"“初中时所有的大赛都没见过他。”"},{"op":"text","speaker":"羽依里","text":"“跟我一样，一年级的压轴。”"},{"op":"text","speaker":"羽依里","text":"“比我们队，晚了几秒才跃入水中的那家伙……”"},{"op":"text","speaker":"羽依里","text":"“还没游完赛程的一半就反超了我。”"},{"op":"text","speaker":"羽依里","text":"“头上传来的欢呼，变成了惊讶。”"},{"op":"text","speaker":"队友","text":"“鹰原――”"},{"op":"text","speaker":"羽依里","text":"“喊我名字的声音，听起来带着莫名的焦急。”"},{"op":"text","speaker":"羽依里","text":"“我拼尽全力在游着。”"},{"op":"set","variable":1,"value":0},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"羽依里","text":"“就在那时……身体变得四分五裂。”"},{"op":"image","layer":1795,"image":"i18141"},{"op":"image","layer":0,"image":"i496"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"第一次有那种感觉。"},{"op":"text","speaker":"","text":"身体在水中变得四分五裂。"},{"op":"text","speaker":"羽依里","text":"“即便是第2名，也能进决赛的。”"},{"op":"text","speaker":"羽依里","text":"“而我却……”"},{"op":"text","speaker":"羽依里","text":"“连终点都没能游到。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1795},{"op":"clear","layer":1539},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"羽依里","text":"“3年级生们最后的夏天就那么结束了。”"},{"op":"text","speaker":"羽依里","text":"“没有一个人责怪我。”"},{"op":"text","speaker":"羽依里","text":"“简直让人感激得痛哭流泪。”"},{"op":"text","speaker":"羽依里","text":"“我想为偿还这份不甘和歉意去努力。”"},{"op":"text","speaker":"羽依里","text":"“我努力了。”"},{"op":"text","speaker":"羽依里","text":"“但还是不行。”"},{"op":"text","speaker":"羽依里","text":"“从那以后……我就无法好好游泳了。”"},{"op":"text","speaker":"羽依里","text":"“练习时都没有问题。”"},{"op":"text","speaker":"羽依里","text":"“可一到比赛听到欢呼声时，我的泳姿就会变得一塌糊涂……我，已经没救了。”"},{"op":"text","speaker":"羽依里","text":"“一开始，大家还会鼓励我。”"},{"op":"text","speaker":"羽依里","text":"“还愿意等我。”"},{"op":"text","speaker":"羽依里","text":"“然而，状况却变得越来越糟。”"},{"op":"text","speaker":"羽依里","text":"“渐渐地，大家似乎都……不知道该怎么对待我了。”"},{"op":"text","speaker":"羽依里","text":"“我也一样。”"},{"op":"text","speaker":"羽依里","text":"“气氛变得无比压抑。”"},{"op":"text","speaker":"羽依里","text":"“让人透不过气来。”"},{"op":"text","speaker":"羽依里","text":"“就这样……”"},{"op":"text","speaker":"羽依里","text":"“我退出了社团。”"},{"op":"text","speaker":"羽依里","text":"“然后，过上了游手好闲的日子。”"},{"op":"image","layer":0,"image":"i507"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"对家里装作每天都认真上学的样子。"},{"op":"text","speaker":"","text":"装成还继续在社团活动。"},{"op":"text","speaker":"","text":"习惯了谎言。"},{"op":"text","speaker":"","text":"严格的父亲。"},{"op":"text","speaker":"","text":"相信儿子的母亲。"},{"op":"text","speaker":"","text":"身为运动员的，正直的儿子。"},{"op":"text","speaker":"","text":"实际上却是假装上学，溜到城里去……"},{"op":"text","speaker":"","text":"闲逛。"},{"op":"text","speaker":"","text":"跟同样在城里闲逛的家伙们混在一起。"},{"op":"text","speaker":"","text":"本以为会很快露馅，谁知就那么持续了一整年。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"有一天。"},{"op":"text","speaker":"男人","text":"“你在这啊。”"},{"op":"text","speaker":"男人","text":"“那边吵起来了。”"},{"op":"text","speaker":"男人","text":"“你也一起来吧。”"},{"op":"text","speaker":"","text":"我大概猜得到过去后会有什么等着我。"},{"op":"text","speaker":"","text":"隐隐之中似乎听到有人跟我说，不能过去。"},{"op":"text","speaker":"警察","text":"“你们在干什么！”"},{"op":"text","speaker":"","text":"警察向这边冲过来。"},{"op":"text","speaker":"男人","text":"“该跑了。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"男人","text":"“鹰原!!”"},{"op":"text","speaker":"","text":"我就那么停留在原地。"},{"op":"text","speaker":"","text":"不想再逃了。"},{"op":"text","speaker":"","text":"干脆全都砸碎吧――"},{"op":"text","speaker":"","text":"全砸碎掉――"},{"op":"text","speaker":"","text":"当时感觉十分舒爽。"},{"op":"text","speaker":"","text":"这样一来，起码就能砸开这死胡同般的现状。"},{"op":"text","speaker":"","text":"我是这么想的。"},{"op":"image","layer":1795,"image":"i18141"},{"op":"image","layer":0,"image":"i163"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"羽依里","text":"“于是我就挨了停学。”"},{"op":"text","speaker":"羽依里","text":"“自然，家长那边也通知了。”"},{"op":"text","speaker":"羽依里","text":"“本以为我的父母应该也多多少少察觉到了的。”"},{"op":"text","speaker":"羽依里","text":"“毕竟是亲人。”"},{"op":"text","speaker":"羽依里","text":"“然而并非如此。”"},{"op":"text","speaker":"羽依里","text":"“对他们来说，这就像是晴天霹雳。”"},{"op":"text","speaker":"羽依里","text":"“似乎受到的打击比我想象中要大得多。”"},{"op":"text","speaker":"羽依里","text":"“父亲责怪母亲，母亲责怪父亲。”"},{"op":"text","speaker":"羽依里","text":"“家人的关系变得一塌糊涂。”"},{"op":"text","speaker":"羽依里","text":"“而处于中心的我，却什么都做不了。”"},{"op":"text","speaker":"羽依里","text":"“在我愣愣地坐视这一切时……”"},{"op":"text","speaker":"羽依里","text":"“学校开始放暑假，我就把自己关在了家中。”"},{"op":"text","speaker":"羽依里","text":"“有一天……我从二楼房间走下去，看到父亲一个人在在客厅看报纸。”"},{"op":"text","speaker":"羽依里","text":"“就在我想把放在冰箱里的早餐拿出来时。”"},{"op":"text","speaker":"羽依里","text":"“他放下了报纸，向我看来。”"},{"op":"text","speaker":"羽依里","text":"“然后……说了一句话。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1795},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"set","variable":30020,"value":90},{"op":"text","speaker":"","text":"‘这一切，都是你的错。’"},{"op":"text","speaker":"","text":"队伍被淘汰。"},{"op":"text","speaker":"","text":"去不了学校。"},{"op":"text","speaker":"","text":"害人受伤。"},{"op":"text","speaker":"","text":"家庭破裂。"},{"op":"text","speaker":"","text":"全都是我的错？"},{"op":"text","speaker":"","text":"我想，他说得没错。"},{"op":"text","speaker":"","text":"简直无懈可击，所以我才不敢面对。"},{"op":"text","speaker":"","text":"不敢正视这些惨状，选择了逃避。"},{"op":"text","speaker":"","text":"哪怕就是我的错，哪怕正确得无懈可击，也不是谁都坚强到能轻易接受现实。"},{"op":"image","layer":0,"image":"i170"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“总之，我只想逃离那里。”"},{"op":"text","speaker":"羽依里","text":"“尽管我也知道，不是离开了就能改变什么。”"},{"op":"text","speaker":"羽依里","text":"“所以接到镜子阿姨的信后，我就来到了这里。”"},{"op":"text","speaker":"羽依里","text":"“结果在这过得出乎意料的开心。”"},{"op":"text","speaker":"羽依里","text":"“变得回不去了。”"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“不过我会回去的。”"},{"op":"text","speaker":"羽依里","text":"“只要明天能平安度过。”"},{"op":"text","speaker":"羽依里","text":"“我就回家。”"},{"op":"text","speaker":"羽依里","text":"“我还有很多事要去解决。”"},{"op":"text","speaker":"羽依里","text":"“有很多逃避的事要去面对。”"},{"op":"text","speaker":"羽依里","text":"“你就真的没有吗？”"},{"op":"text","speaker":"羽依里","text":"“在这座岛上……没完成的事。”"},{"op":"text","speaker":"羽依里","text":"“今后想要做的事。”"},{"op":"text","speaker":"羽依里","text":"“别说你一个人消失也无所谓这种话。”"},{"op":"text","speaker":"羽依里","text":"“至少我。”"},{"op":"text","speaker":"羽依里","text":"“是因为有你在这里才得救的。”"},{"op":"text","speaker":"羽依里","text":"“有你在这真的太好了。”"},{"op":"image","layer":0,"image":"i50"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":1,"image":"i13322"},{"op":"text","speaker":"白羽","text":"“……羽依里。”"},{"op":"text","speaker":"羽依里","text":"“之前，我就是想跟你说这些。”"},{"op":"text","speaker":"羽依里","text":"“感谢你的理由。”"},{"op":"text","speaker":"羽依里","text":"“你做的饭很好吃。”"},{"op":"text","speaker":"羽依里","text":"“你给其他人做做看。”"},{"op":"text","speaker":"羽依里","text":"“尝到你的手艺肯定都会笑出花。”"},{"op":"text","speaker":"羽依里","text":"“肯定都会很高兴。”"},{"op":"text","speaker":"羽依里","text":"“就像我一样……”"},{"op":"text","speaker":"羽依里","text":"“让这种未来消失，也太浪费了吧。”"},{"op":"image","layer":1,"image":"i13304"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“所以回去吧，回到家里。”"},{"op":"text","speaker":"羽依里","text":"“回到……”"},{"op":"text","speaker":"羽依里","text":"“……大家在等着你的地方。”"},{"op":"image","layer":1,"image":"i13314"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i13304"},{"op":"text","speaker":"白羽","text":"“你在哭？”"},{"op":"text","speaker":"羽依里","text":"“……我没哭。”"},{"op":"image","layer":1,"image":"i13384"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"image","layer":1,"image":"i13426"},{"op":"text","speaker":"白羽","text":"“对不起。”"},{"op":"text","speaker":"羽依里","text":"“什么对不起？”"},{"op":"image","layer":1,"image":"i13384"},{"op":"text","speaker":"白羽","text":"“不知道。”"},{"op":"text","speaker":"白羽","text":"“不过对不起。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“差不多该走了吧。”"},{"op":"image","layer":1,"image":"i13274"},{"op":"text","speaker":"白羽","text":"“等等。”"},{"op":"text","speaker":"羽依里","text":"“？”"},{"op":"image","layer":1,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“马上就能见到了。”"},{"op":"image","layer":1,"image":"i13277"},{"op":"text","speaker":"白羽","text":"“我想让你看看。”"},{"op":"text","speaker":"羽依里","text":"“盯―……”"},{"op":"image","layer":1,"image":"i13294"},{"op":"text","speaker":"白羽","text":"“不是看我。”"},{"op":"text","speaker":"羽依里","text":"“看什么？”"},{"op":"image","layer":1,"image":"i13376"},{"op":"text","speaker":"白羽","text":"“我周围。”"},{"op":"text","speaker":"羽依里","text":"“你周围？”"},{"op":"text","speaker":"","text":"只是普通的沙滩……"},{"op":"text","speaker":"","text":"……"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"咦。"},{"op":"text","speaker":"羽依里","text":"“啊……”"},{"op":"image","layer":0,"image":"i1110"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“这是……”"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i1108"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“萤火虫。”"},{"op":"text","speaker":"羽依里","text":"“唉唉？”"},{"op":"text","speaker":"羽依里","text":"“萤火虫不是在山里的吗？”"},{"op":"text","speaker":"白羽","text":"“海萤。”"},{"op":"text","speaker":"","text":"我好像，在哪听说过。"},{"op":"text","speaker":"","text":"海里的萤火虫……"},{"op":"text","speaker":"羽依里","text":"“会在海滩上发光啊。”"},{"op":"image","layer":0,"image":"i1112"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“嗯。”"},{"op":"text","speaker":"","text":"……"},{"op":"image","layer":0,"image":"i1108"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“……这个地方。”"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"白羽","text":"“是以前爸爸告诉我的。”"},{"op":"text","speaker":"白羽","text":"“秘密场所。”"},{"op":"text","speaker":"白羽","text":"“已经不发光很久了。”"},{"op":"text","speaker":"白羽","text":"“可是，今年夏天……又发光了。”"},{"op":"text","speaker":"白羽","text":"“隔了10年。”"},{"op":"text","speaker":"羽依里","text":"“10年!؟”"},{"op":"text","speaker":"羽依里","text":"“这么说，我运气还挺好的啊。”"},{"op":"text","speaker":"白羽","text":"“……嗯。”"},{"op":"image","layer":0,"image":"i1113"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"白羽","text":"“那个。”"},{"op":"text","speaker":"白羽","text":"“以前，我有过前往未来的想法。”"},{"op":"text","speaker":"羽依里","text":"“前往未来？为什么？”"},{"op":"text","speaker":"白羽","text":"“多半是因为等得厌倦了。”"},{"op":"text","speaker":"白羽","text":"“因为我怎么等都等不来。”"},{"op":"text","speaker":"白羽","text":"“所以我想跳过时间，去见我等的人。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":0,"image":"i1109"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“也许……”"},{"op":"text","speaker":"白羽","text":"“就是因为我有想去未来的想法，才会看到未来。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“现在也想去？”"},{"op":"image","layer":0,"image":"i1108"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“不。”"},{"op":"text","speaker":"白羽","text":"“反正也不知道要等到什么时候才好。”"},{"op":"text","speaker":"白羽","text":"“所以，不用了。”"},{"op":"text","speaker":"白羽","text":"“不用再看什么未来了。”"},{"op":"text","speaker":"羽依里","text":"“……我说。”"},{"op":"text","speaker":"羽依里","text":"“将来有机会，我们一起去看看各种地方吧。”"},{"op":"image","layer":0,"image":"i1109"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“羽依里……”"},{"op":"text","speaker":"白羽","text":"“去哪？”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"text","speaker":"白羽","text":"“各种地方是哪？”"},{"op":"text","speaker":"羽依里","text":"“那什么。”"},{"op":"text","speaker":"羽依里","text":"“我只是随口说说而已……具体还……”"},{"op":"image","layer":0,"image":"i1113"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“你说得这么笼统……我可不好答复。”"},{"op":"text","speaker":"羽依里","text":"“这随便回个话不就行了嘛。”"},{"op":"image","layer":0,"image":"i1109"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“怎么能随便回。”"},{"op":"text","speaker":"白羽","text":"“你要想带我去什么奇怪的地方，我可不去。”"},{"op":"text","speaker":"羽依里","text":"“谁要带啊，你把我当什么了？”"},{"op":"text","speaker":"白羽","text":"“怪人。”"},{"op":"text","speaker":"羽依里","text":"“喂喂。”"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":0,"image":"i1112"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“噗。”"},{"op":"text","speaker":"羽依里","text":"“哼……”"},{"op":"text","speaker":"羽依里","text":"“回去吧。”"},{"op":"text","speaker":"白羽","text":"“嗯。”"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i86"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":1,"image":"i13322"},{"op":"text","speaker":"白羽","text":"“……那个。”"},{"op":"image","layer":1,"image":"i13304"},{"op":"text","speaker":"白羽","text":"“我……对不起……”"},{"op":"image","layer":257,"image":"i15083"},{"op":"image","layer":513,"image":"i11688"},{"op":"image","layer":769,"image":"i10111"},{"op":"image","layer":1025,"image":"i12143"},{"op":"text","speaker":"美希","text":"“欢迎回来。”"},{"op":"text","speaker":"苍","text":"“欢迎回来。”"},{"op":"text","speaker":"良一","text":"“欢迎回来。”"},{"op":"text","speaker":"天善","text":"“欢迎回来。”"},{"op":"image","layer":1,"image":"i13277"},{"op":"text","speaker":"白羽","text":"“……啊。”"},{"op":"image","layer":0,"image":"i274"},{"op":"set","variable":6714,"value":1},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"clear","layer":769},{"op":"clear","layer":1025},{"op":"image","layer":1,"image":"i13249"},{"op":"text","speaker":"白羽","text":"“我回来了。”"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]