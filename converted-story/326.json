[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i516"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"后来……"},{"op":"text","speaker":"","text":"我们就像初次相遇时那样，望着月亮……"},{"op":"image","layer":256,"image":"i513"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"看着它缓缓沉落。"},{"op":"text","speaker":"","text":"我们两个一直聊啊聊的，直到传来了船只到达的声音。"},{"op":"clear","layer":256},{"op":"image","layer":0,"image":"i366"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13852"},{"op":"text","speaker":"静久","text":"“我差不多该回去了。”"},{"op":"text","speaker":"羽依里","text":"“嗯，你父母肯定也担心了。”"},{"op":"image","layer":1,"image":"i13858"},{"op":"text","speaker":"静久","text":"“没关系的，我就告诉他们，男朋友陪了我一整晚。”"},{"op":"text","speaker":"羽依里","text":"“这么说反而会更让人担心吧。”"},{"op":"image","layer":1,"image":"i13933"},{"op":"text","speaker":"静久","text":"“肯定没事的啦。”"},{"op":"text","speaker":"羽依里","text":"“那我送你去坐船。”"},{"op":"text","speaker":"","text":"说着，我伸出了手。"},{"op":"image","layer":1,"image":"i13927"},{"op":"text","speaker":"静久","text":"“嗯♪”"},{"op":"image","layer":1,"image":"i13928"},{"op":"text","speaker":"","text":"她点点头，握住了我的手。"},{"op":"text","speaker":"","text":"两人手牵手走在清晨的海滩上。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i1"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13877"},{"op":"text","speaker":"静久","text":"“啊～船开走了……”"},{"op":"text","speaker":"羽依里","text":"“抱歉，可能是我走得太慢了。”"},{"op":"image","layer":1,"image":"i13856"},{"op":"text","speaker":"静久","text":"“呵呵♪　其实是不是想多牵一会儿手呀？”"},{"op":"text","speaker":"羽依里","text":"“嗯……算是吧。”"},{"op":"image","layer":1,"image":"i13960"},{"op":"text","speaker":"静久","text":"“我也是哦，所以我们两个人都有错。”"},{"op":"text","speaker":"羽依里","text":"“这样啊。”"},{"op":"image","layer":1,"image":"i13865"},{"op":"text","speaker":"静久","text":"“啊……！我想去找一下紬。”"},{"op":"image","layer":1,"image":"i13741"},{"op":"text","speaker":"静久","text":"“今天我应该不会再来岛上了……所以得去跟她说一声。”"},{"op":"text","speaker":"羽依里","text":"“对哦，毕竟跟她说过要去的来着。”"},{"op":"image","layer":1,"image":"i13744"},{"op":"text","speaker":"静久","text":"“嗯♪　我去跟她说声抱歉。”"},{"op":"image","layer":1,"image":"i13835"},{"op":"text","speaker":"静久","text":"“还有，关于我们的事也要说一下……”"},{"op":"text","speaker":"羽依里","text":"“嗯，好的。”"},{"op":"image","layer":1,"image":"i13889"},{"op":"text","speaker":"静久","text":"“那明天见啦。”"},{"op":"text","speaker":"羽依里","text":"“明天见。”"},{"op":"text","speaker":"","text":"说完，静久就朝灯塔的方向走去了。"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i508"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"感觉有点不可思议。"},{"op":"text","speaker":"","text":"虽然成为了恋人，但却没什么切身体会。"},{"op":"text","speaker":"","text":"本来和静久关系就很好。"},{"op":"text","speaker":"","text":"只是这种关系换了一个叫法而已。"},{"op":"text","speaker":"","text":"尽管如此。"},{"op":"text","speaker":"羽依里","text":"“原来如此……我们是恋人啊……”"},{"op":"text","speaker":"","text":"我还是不禁嘴角上扬。"},{"op":"text","speaker":"","text":"这场盛夏的恋情。"},{"op":"text","speaker":"","text":"便正式开始了。"},{"op":"text","speaker":"","text":"不，当然这并不会随着夏天结束而结束。"},{"op":"text","speaker":"羽依里","text":"“不过，这样的话……”"},{"op":"text","speaker":"","text":"我也有一个必须要去的地方。"},{"op":"text","speaker":"","text":"那就是……"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i21"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15014"},{"op":"image","layer":257,"image":"i12144"},{"op":"text","speaker":"良一","text":"“嘿，羽依里！”"},{"op":"image","layer":1,"image":"i15008"},{"op":"text","speaker":"天善","text":"“怎么了，鹰原？”"},{"op":"text","speaker":"","text":"秘密基地。"},{"op":"text","speaker":"","text":"有一个人，我要跟他把话说清楚。"},{"op":"text","speaker":"","text":"那当然就是。"},{"op":"image","layer":1,"image":"i15038"},{"op":"text","speaker":"羽依里","text":"“天善，我跟你有话要说。”"},{"op":"text","speaker":"","text":"我先前就知道了天善对静久的心意。"},{"op":"text","speaker":"","text":"所以，必须把我们的情况跟他好好说明一下。"},{"op":"image","layer":1,"image":"i15014"},{"op":"text","speaker":"天善","text":"“……原来如此，你是来看我的新式发球法的啊。”"},{"op":"text","speaker":"羽依里","text":"“不是。”"},{"op":"image","layer":1,"image":"i15038"},{"op":"text","speaker":"天善","text":"“别客气。”"},{"op":"text","speaker":"羽依里","text":"“不是客气不客气的问题，是别的事。”"},{"op":"image","layer":1,"image":"i15032"},{"op":"text","speaker":"天善","text":"“那是什么？”"},{"op":"text","speaker":"羽依里","text":"“我是来跟你摊牌的。”"},{"op":"image","layer":1,"image":"i15038"},{"op":"text","speaker":"天善","text":"“摊牌？”"},{"op":"text","speaker":"羽依里","text":"“天善，你喜欢静久对吧？”"},{"op":"image","layer":1,"image":"i15026"},{"op":"text","speaker":"天善","text":"“什……!؟你在说什么……！”"},{"op":"image","layer":1,"image":"i15017"},{"op":"text","speaker":"天善","text":"“怎么会呢……这当然是不可能的。”"},{"op":"image","layer":7,"image":"i12158"},{"op":"text","speaker":"良一","text":"“……你这不是明摆着的吗。”"},{"op":"image","layer":1,"image":"i15026"},{"op":"text","speaker":"天善","text":"“什么!؟”"},{"op":"image","layer":1,"image":"i15023"},{"op":"text","speaker":"天善","text":"“不、不是这样的……不要说这么失礼的话。”"},{"op":"image","layer":1,"image":"i15135"},{"op":"text","speaker":"天善","text":"“我可是把灵魂出卖给了乒乓球的男人……”"},{"op":"image","layer":1,"image":"i15096"},{"op":"text","speaker":"天善","text":"“我的恋人只有这把球拍。”"},{"op":"image","layer":1,"image":"i15008"},{"op":"text","speaker":"天善","text":"“从未有过被儿女情长之事牵动心神的时候。”"},{"op":"text","speaker":"羽依里","text":"“这样啊，那我就放心了。那么我就不用太顾虑……”"},{"op":"image","layer":1,"image":"i15017"},{"op":"text","speaker":"天善","text":"“我喜欢她……！”"},{"op":"text","speaker":"羽依里","text":"“哎哎哎……”"},{"op":"image","layer":7,"image":"i12167"},{"op":"text","speaker":"良一","text":"“为什么现在又改口了啊……？”"},{"op":"image","layer":1,"image":"i15023"},{"op":"text","speaker":"天善","text":"“果然我无法压抑住自己的感情。”"},{"op":"image","layer":7,"image":"i12149"},{"op":"text","speaker":"良一","text":"“不过这也太快了吧……不对，应该说太晚了？”"},{"op":"text","speaker":"羽依里","text":"“果然是这样吗。”"},{"op":"image","layer":1,"image":"i15014"},{"op":"text","speaker":"天善","text":"“是的，没错。我喜欢上她了。”"},{"op":"text","speaker":"羽依里","text":"“那么，我们就终有一战了。”"},{"op":"image","layer":1,"image":"i15038"},{"op":"text","speaker":"天善","text":"“你想说什么？”"},{"op":"text","speaker":"羽依里","text":"“就是说，我也跟你喜欢上了同一个人……”"},{"op":"image","layer":1,"image":"i15026"},{"op":"text","speaker":"天善","text":"“什么!؟”"},{"op":"image","layer":7,"image":"i12167"},{"op":"text","speaker":"良一","text":"“哎哎哎哎哎!؟真的假的！”"},{"op":"image","layer":7,"image":"i12161"},{"op":"text","speaker":"良一","text":"“你原来喜欢水织学姐吗！”"},{"op":"text","speaker":"羽依里","text":"“天善，我把你看作是自己的朋友。”"},{"op":"text","speaker":"羽依里","text":"“所以……如果我用乒乓球打赢了你，你会认可吗？”"},{"op":"text","speaker":"羽依里","text":"“认可我和静久的关系……！”"},{"op":"image","layer":1,"image":"i15032"},{"op":"text","speaker":"天善","text":"“……这、这样啊。鹰原也……喜欢上那个人了啊。”"},{"op":"image","layer":1,"image":"i15017"},{"op":"text","speaker":"天善","text":"“抱歉。我一时有些慌乱……”"},{"op":"image","layer":1,"image":"i15038"},{"op":"text","speaker":"天善","text":"“但意外的是，我并没有感到震惊。”"},{"op":"image","layer":1,"image":"i15011"},{"op":"text","speaker":"天善","text":"“她本来就很有魅力，会产生这种感情也是理所当然的……”"},{"op":"image","layer":1,"image":"i15122"},{"op":"text","speaker":"天善","text":"“而且……你和我一样都是热爱乒乓球的挚友，这让我有点高兴。”"},{"op":"text","speaker":"羽依里","text":"“倒是没有热爱乒乓球就是了。”"},{"op":"text","speaker":"羽依里","text":"“抱歉啊……突然说这种话。”"},{"op":"image","layer":1,"image":"i15014"},{"op":"text","speaker":"天善","text":"“不，我很高兴你能坦白告诉我。”"},{"op":"image","layer":1,"image":"i15029"},{"op":"text","speaker":"天善","text":"“这是非常伟大的运动员精神。”"},{"op":"image","layer":7,"image":"i12173"},{"op":"text","speaker":"良一","text":"“但是羽依里，这样好吗？”"},{"op":"image","layer":7,"image":"i12170"},{"op":"text","speaker":"良一","text":"“特意跟他比乒乓球，这对你来说相当不利吧。”"},{"op":"text","speaker":"羽依里","text":"“是吧。不过啊……”"},{"op":"text","speaker":"羽依里","text":"“我想要得到天善的认可。”"},{"op":"text","speaker":"羽依里","text":"“所以，必须在他最擅长的事情上决一胜负，这样才有意义。”"},{"op":"image","layer":7,"image":"i12167"},{"op":"text","speaker":"良一","text":"“哦哦哦哦！”"},{"op":"image","layer":7,"image":"i12161"},{"op":"text","speaker":"良一","text":"“羽依里，你可太帅了！我支持你！”"},{"op":"image","layer":1,"image":"i15093"},{"op":"text","speaker":"天善","text":"“好啊，鹰原！”"},{"op":"text","speaker":"羽依里","text":"“你愿意接受挑战吗……天善！”"},{"op":"image","layer":1,"image":"i15041"},{"op":"text","speaker":"天善","text":"“当然！”"},{"op":"image","layer":1,"image":"i15044"},{"op":"text","speaker":"天善","text":"“我先说好……无论我有多大优势，我都不会手下留情。”"},{"op":"image","layer":1,"image":"i15120"},{"op":"text","speaker":"天善","text":"“这是对你的尊重！”"},{"op":"text","speaker":"羽依里","text":"“没问题！”"},{"op":"image","layer":257,"image":"i12162"},{"op":"text","speaker":"良一","text":"“我来给你们当裁判。”"},{"op":"image","layer":257,"image":"i12171"},{"op":"text","speaker":"良一","text":"“你们两个的战斗……就让我来见证吧！”"},{"op":"text","speaker":"","text":"我和天善隔着乒乓球台相视而立。"},{"op":"image","layer":257,"image":"i12174"},{"op":"text","speaker":"良一","text":"“那么，发球权呢？”"},{"op":"text","speaker":"羽依里","text":"“给天善吧。”"},{"op":"image","layer":1,"image":"i15133"},{"op":"text","speaker":"天善","text":"“呵……好的。那么我就收下了！”"},{"op":"image","layer":1,"image":"i15120"},{"op":"text","speaker":"天善","text":"“啊，不……但是……可是。”"},{"op":"image","layer":7,"image":"i12143"},{"op":"text","speaker":"良一","text":"“怎么了？是觉得自己优势太大，有点过意不去吗？”"},{"op":"image","layer":1,"image":"i15088"},{"op":"text","speaker":"天善","text":"“不是……我在想，如果我输掉这场比赛的话……会怎样。”"},{"op":"text","speaker":"羽依里","text":"“……？”"},{"op":"image","layer":1,"image":"i15017"},{"op":"text","speaker":"天善","text":"“如果输了……”"},{"op":"image","layer":1,"image":"i15023"},{"op":"text","speaker":"天善","text":"“我就会失去水织学姐。”"},{"op":"text","speaker":"羽依里","text":"“她本来就不是你的。”"},{"op":"image","layer":1,"image":"i15020"},{"op":"text","speaker":"天善","text":"“甚至还会失去乒乓球之王的称号。”"},{"op":"text","speaker":"","text":"这个称号也很值得怀疑。"},{"op":"text","speaker":"羽依里","text":"“是啊……”"},{"op":"image","layer":1,"image":"i15017"},{"op":"text","speaker":"天善","text":"“这二者，就是我的一切。”"},{"op":"image","layer":1,"image":"i15020"},{"op":"text","speaker":"天善","text":"“万一输掉的话……我会不会有点太过凄惨了？”"},{"op":"text","speaker":"羽依里","text":"“嗯，确实……有可能啊。”"},{"op":"image","layer":1,"image":"i15026"},{"op":"text","speaker":"天善","text":"“赢了的话，对我来说有什么好处吗？”"},{"op":"text","speaker":"羽依里","text":"“嗯……这个嘛？”"},{"op":"image","layer":1,"image":"i15014"},{"op":"text","speaker":"天善","text":"“能和鹰原进行一场认真的比赛很开心……”"},{"op":"image","layer":1,"image":"i15029"},{"op":"text","speaker":"天善","text":"“这是好事没错。”"},{"op":"text","speaker":"羽依里","text":"“是啊。”"},{"op":"image","layer":1,"image":"i15008"},{"op":"text","speaker":"天善","text":"“但是就算赢了，也不意味着我就能和水织学姐在一起。”"},{"op":"text","speaker":"羽依里","text":"“是吧。”"},{"op":"image","layer":1,"image":"i15017"},{"op":"text","speaker":"天善","text":"“就算获得称号，也不会有什么变化。”"},{"op":"text","speaker":"羽依里","text":"“确实。”"},{"op":"image","layer":1,"image":"i15023"},{"op":"text","speaker":"天善","text":"“不会有……任何进展。”"},{"op":"text","speaker":"羽依里","text":"“……嗯。”"},{"op":"image","layer":1,"image":"i15020"},{"op":"text","speaker":"天善","text":"“对我来说坏处太多了……”"},{"op":"image","layer":1,"image":"i15026"},{"op":"text","speaker":"天善","text":"“呃……不要……事到如今我开始难过起来了！”"},{"op":"image","layer":1,"image":"i15023"},{"op":"text","speaker":"天善","text":"“我不想打……这种比赛……”"},{"op":"image","layer":1,"image":"i15017"},{"op":"text","speaker":"天善","text":"“无论如何都不想打……！”"},{"op":"image","layer":1,"image":"i15020"},{"op":"text","speaker":"天善","text":"“虽然想打乒乓球……但什么都不想失去！”"},{"op":"image","layer":1,"image":"i15035"},{"op":"text","speaker":"天善","text":"“我只想在没有任何风险的安全区内，打着让人血脉偾张的乒乓球！”"},{"op":"text","speaker":"羽依里","text":"“……是吗。”"},{"op":"image","layer":1,"image":"i15044"},{"op":"text","speaker":"天善","text":"“我可以……拒绝吗……”"},{"op":"image","layer":7,"image":"i12149"},{"op":"text","speaker":"良一","text":"“在这种情况下还能拒绝得了，你也是不简单啊。”"},{"op":"text","speaker":"羽依里","text":"“好吧……反正我只是来把话说清楚的，如果天善能接受的话，我也没什么意见。”"},{"op":"image","layer":1,"image":"i15029"},{"op":"text","speaker":"天善","text":"“嗯，我接受。恋爱是自由的……”"},{"op":"image","layer":7,"image":"i12149"},{"op":"text","speaker":"良一","text":"“居然真接受啊。”"},{"op":"text","speaker":"","text":"我放下球拍。"},{"op":"image","layer":1,"image":"i15014"},{"op":"image","layer":257,"image":"i12144"},{"op":"text","speaker":"良一","text":"“那么，羽依里你打算什么时候表白？”"},{"op":"image","layer":257,"image":"i12193"},{"op":"text","speaker":"良一","text":"“毕竟只能趁着暑假这段时间，肯定是越早行动越好吧？”"},{"op":"image","layer":1,"image":"i15038"},{"op":"text","speaker":"天善","text":"“不，请等到春假之后。”"},{"op":"image","layer":257,"image":"i12174"},{"op":"text","speaker":"良一","text":"“为什么啊？”"},{"op":"image","layer":1,"image":"i15014"},{"op":"text","speaker":"天善","text":"“因为我打算在毕业典礼那天表白。”"},{"op":"image","layer":1,"image":"i15011"},{"op":"text","speaker":"天善","text":"“这样的话就算被拒绝……第二天也不会很尴尬。”"},{"op":"image","layer":257,"image":"i12150"},{"op":"text","speaker":"良一","text":"“你还真是怂得光明正大啊……”"},{"op":"image","layer":257,"image":"i12147"},{"op":"text","speaker":"良一","text":"“难道没有所谓的运动员精神吗？”"},{"op":"image","layer":1,"image":"i15116"},{"op":"text","speaker":"天善","text":"“有的。”"},{"op":"image","layer":1,"image":"i15014"},{"op":"text","speaker":"天善","text":"“鹰原。春假之后，如果我和水织学姐在一起了……希望你能祝福我们。”"},{"op":"image","layer":1,"image":"i15011"},{"op":"text","speaker":"天善","text":"“正面接受这个事实。”"},{"op":"image","layer":1,"image":"i15008"},{"op":"text","speaker":"天善","text":"“作为朋友……作为劲敌……我希望能得到你的祝福。”"},{"op":"image","layer":257,"image":"i12159"},{"op":"text","speaker":"良一","text":"“你一个劲只对别人提要求啊。”"},{"op":"image","layer":1,"image":"i15041"},{"op":"text","speaker":"天善","text":"“当然，如果情况反过来，我也会祝福你。”"},{"op":"text","speaker":"羽依里","text":"“那个……其实。”"},{"op":"image","layer":1,"image":"i15008"},{"op":"text","speaker":"天善","text":"“怎么了？”"},{"op":"text","speaker":"羽依里","text":"“我们已经在一起了。”"},{"op":"image","layer":1,"image":"i15038"},{"op":"image","layer":257,"image":"i12171"},{"op":"text","speaker":"天善","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“昨天我们刚刚成为恋人。”"},{"op":"image","layer":1,"image":"i15026"},{"op":"text","speaker":"天善","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“是她跟我表白的。”"},{"op":"set","variable":26027,"value":1},{"op":"text","speaker":"天善","text":"“……”"},{"op":"image","layer":257,"image":"i12168"},{"op":"text","speaker":"良一","text":"“哦哦哦哦哦哦？真的假的!؟”"},{"op":"text","speaker":"羽依里","text":"“嗯，是真的。”"},{"op":"image","layer":257,"image":"i12217"},{"op":"text","speaker":"良一","text":"“恭喜你啊羽依里――！太好了！”"},{"op":"text","speaker":"羽依里","text":"“别、别这样，我会害羞的。”"},{"op":"image","layer":257,"image":"i12180"},{"op":"text","speaker":"良一","text":"“别不好意思啊，老实接受祝福吧。来来来！”"},{"op":"image","layer":257,"image":"i12217"},{"op":"text","speaker":"良一","text":"“喂，天善也来给他祝福一下啊！”"},{"op":"set","variable":26027,"value":1},{"op":"text","speaker":"天善","text":"“啊……！好！”"},{"op":"image","layer":1,"image":"i15017"},{"op":"text","speaker":"天善","text":"“……那么。”"},{"op":"image","layer":768,"image":"i736"},{"op":"image","layer":1024,"image":"i736"},{"op":"image","layer":0,"image":"i209"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":1,"image":"i15104"},{"op":"text","speaker":"天善","text":"“比、比赛结束――”"},{"op":"clear","layer":768},{"op":"clear","layer":1024},{"op":"clear","layer":515},{"op":"image","layer":515,"image":"i18121"},{"op":"image","layer":1,"image":"i15150"},{"op":"text","speaker":"天善","text":"“――胜者，鹰原！羽依里!!”"},{"op":"text","speaker":"羽依里","text":"“谢、谢谢！”"},{"op":"clear","layer":1},{"op":"clear","layer":515},{"op":"clear","layer":768},{"op":"clear","layer":1024},{"op":"image","layer":0,"image":"i508"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":7,"image":"i15034"},{"op":"text","speaker":"天善","text":"“啊啊啊啊啊啊啊啊！乒乓球乒乓球乒乓球！”"},{"op":"text","speaker":"羽依里","text":"“天、天善？”"},{"op":"text","speaker":"","text":"这么一来，姑且算是把话说开了吧？"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]