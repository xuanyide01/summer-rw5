[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“早上好……”"},{"op":"text","speaker":"羽依里","text":"“……噢，餐桌上的这些是？”"},{"op":"text","speaker":"羽依里","text":"“蔬菜切沫……？”"},{"op":"image","layer":1,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“因为得到了好多蔬菜。”"},{"op":"image","layer":1,"image":"i15381"},{"op":"text","speaker":"羽未","text":"“所以尝试了一下蔬菜炒饭。”"},{"op":"text","speaker":"羽依里","text":"“慢着……”"},{"op":"text","speaker":"羽依里","text":"“这个……”"},{"op":"text","speaker":"羽依里","text":"“唔……炒饭里……”"},{"op":"text","speaker":"羽依里","text":"“少了‘饭’。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“我用蔬菜代替了米。”"},{"op":"text","speaker":"羽依里","text":"“那一般来说这应该叫炒蔬菜。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“因为是当做炒饭来做的，所以就是炒饭啦。”"},{"op":"text","speaker":"羽依里","text":"“在羽未脑中，炒饭已经变成了一个抽象的概念吧？”"},{"op":"text","speaker":"羽依里","text":"“不过嘛……我开动了。”"},{"op":"text","speaker":"羽依里","text":"“看起来也挺健康的。”"},{"op":"image","layer":1,"image":"i15576"},{"op":"text","speaker":"羽未","text":"“……对心理也是。”"},{"op":"text","speaker":"羽依里","text":"“哎，什么？”"},{"op":"image","layer":1,"image":"i15566"},{"op":"text","speaker":"羽未","text":"“要是心理也健康了就好了。”"},{"op":"text","speaker":"羽依里","text":"“什么意思？怎么了吗？”"},{"op":"image","layer":1,"image":"i15420"},{"op":"text","speaker":"羽未","text":"“羽依里哥……我听说了。”"},{"op":"image","layer":1,"image":"i15428"},{"op":"text","speaker":"羽未","text":"“很难过的吧。”"},{"op":"text","speaker":"羽依里","text":"“你在说什么？”"},{"op":"image","layer":1,"image":"i15436"},{"op":"text","speaker":"羽未","text":"“吉娃娃，很可爱的吧？”"},{"op":"text","speaker":"羽依里","text":"“吉娃娃؟؟”"},{"op":"image","layer":1,"image":"i15579"},{"op":"text","speaker":"羽未","text":"“港口渔夫们告诉我的。”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":1795,"image":"i18201"},{"op":"image","layer":0,"image":"i1"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"渔夫A","text":"“小妹妹家里那个小哥。”"},{"op":"text","speaker":"渔夫A","text":"“对他温柔一些吧。”"},{"op":"text","speaker":"渔夫A","text":"“听说他疼爱的吉娃娃死掉了。”"},{"op":"clear","layer":1795},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"失恋、落榜、吉娃娃……我虽然说过随便了……"},{"op":"text","speaker":"","text":"结果还是定论于吉娃娃了啊。"},{"op":"text","speaker":"羽依里","text":"“你看我像养吉娃娃的人吗？”"},{"op":"image","layer":1,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“比起养猫派更像养狗派。”"},{"op":"image","layer":1,"image":"i15401"},{"op":"text","speaker":"羽未","text":"“在大城市养的狗，肯定是吉娃娃啦。”"},{"op":"text","speaker":"羽依里","text":"“哎哎？”"},{"op":"image","layer":1,"image":"i15579"},{"op":"text","speaker":"羽未","text":"“吉娃娃……”"},{"op":"image","layer":1,"image":"i15576"},{"op":"text","speaker":"羽未","text":"“佩奇……”"},{"op":"image","layer":1,"image":"i15582"},{"op":"text","speaker":"羽未","text":"“呜呜。”"},{"op":"text","speaker":"","text":"擅自取了名字不说，还凭借自己的想象哭了起来。"},{"op":"text","speaker":"羽依里","text":"“……呃……”"},{"op":"text","speaker":"羽依里","text":"“谢谢你为佩奇流泪。”"},{"op":"text","speaker":"","text":"配合一下她也算是一种温柔吧。"},{"op":"return"},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“羽依里哥。”"},{"op":"text","speaker":"羽依里","text":"“怎么了？”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“九点开始大决战哦。”"},{"op":"text","speaker":"","text":"羽未说完这句话，就去洗澡了。"},{"op":"text","speaker":"羽依里","text":"“什么？”"},{"op":"text","speaker":"","text":"九点开始大决战؟؟"},{"op":"text","speaker":"","text":"是指我和羽未吗？"},{"op":"text","speaker":"","text":"她可能是想玩游戏吧。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"时间到了九点。"},{"op":"text","speaker":"","text":"羽未心不在焉地看着漫画。"},{"op":"text","speaker":"","text":"或许是忘了刚才的事吧。"},{"op":"text","speaker":"羽依里","text":"“羽未。”"},{"op":"image","layer":1,"image":"i15468"},{"op":"text","speaker":"羽未","text":"“？”"},{"op":"text","speaker":"羽依里","text":"“嘿！”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“嘿…嘿！”"},{"op":"text","speaker":"羽依里","text":"“放马过来！”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“嘿！”"},{"op":"text","speaker":"羽依里","text":"“……嘿！”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“……别看着我……”"},{"op":"text","speaker":"羽依里","text":"“嘿嘿！”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“……终究还是疯掉了啊……”"},{"op":"text","speaker":"","text":"咦？不是要决斗吗？"},{"op":"image","layer":1,"image":"i15363"},{"op":"text","speaker":"羽未","text":"“我要睡了。”"},{"op":"text","speaker":"","text":"她拿着漫画回了自己的房间。"},{"op":"text","speaker":"","text":"究竟是怎么一回事。"},{"op":"return"},{"op":"end"}]