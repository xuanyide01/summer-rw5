[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"if","truth":false,"target":5,"value":["==",["v",6003],1]},{"op":"callScene","scene":40,"target":2},{"op":"goto","target":56},{"op":"if","truth":false,"target":8,"value":["==",["v",6003],2]},{"op":"callScene","scene":39,"target":2},{"op":"goto","target":56},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“早上好……”"},{"op":"image","layer":1,"image":"i15457"},{"op":"text","speaker":"羽未","text":"“鹰原哥鹰原哥。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"","text":"羽未一路小跑过来。"},{"op":"text","speaker":"羽依里","text":"“怎，怎么了？”"},{"op":"image","layer":1,"image":"i15381"},{"op":"text","speaker":"羽未","text":"“快看，攒了好多积分呢。”"},{"op":"text","speaker":"","text":"眉飞色舞地给我看了盖着印章的卡片。"},{"op":"text","speaker":"羽依里","text":"“附近超市的积分卡？”"},{"op":"image","layer":1,"image":"i15401"},{"op":"text","speaker":"羽未","text":"“不是啦♪”"},{"op":"text","speaker":"","text":"看上去心情超好。"},{"op":"image","layer":1,"image":"i15552"},{"op":"text","speaker":"羽未","text":"“是广播体操的积分。”"},{"op":"text","speaker":"羽依里","text":"“哦。”"},{"op":"text","speaker":"","text":"说来，广播体操好像是有这种模式？"},{"op":"text","speaker":"","text":"把挂在脖子上的卡片拿给现场负责人盖章。"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“鹰原哥也一起去嘛。”"},{"op":"text","speaker":"羽依里","text":"“唔……”"},{"op":"text","speaker":"羽依里","text":"“我有我自己的锻炼规划。”"},{"op":"text","speaker":"羽依里","text":"“也不想被广播体操所束缚。”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“啊……”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“有个像你一样的人。”"},{"op":"image","layer":1,"image":"i15363"},{"op":"text","speaker":"羽未","text":"“半裸着……自顾自地在那里做体操。”"},{"op":"text","speaker":"羽依里","text":"“是良一吧。”"},{"op":"text","speaker":"","text":"太显而易见了。"},{"op":"image","layer":1,"image":"i15408"},{"op":"text","speaker":"羽未","text":"“他说‘我有我的方式方法’。”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“做广播体操时，只要有一个人在做其他的事，就会非常地显眼。”"},{"op":"image","layer":1,"image":"i15363"},{"op":"text","speaker":"羽未","text":"“还有孩子会跟着学。”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“让大家都挺为难的。”"},{"op":"text","speaker":"羽依里","text":"“不过良一倒也没说错。”"},{"op":"text","speaker":"羽依里","text":"“每个人锻炼身体的方式都不一样。”"},{"op":"text","speaker":"羽依里","text":"“适合自己的锻炼规划才是最好的。”"},{"op":"text","speaker":"羽依里","text":"“广播体操的优点可能只有人数多而已。”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“听着好烦啊。”"},{"op":"text","speaker":"","text":"好刻薄的一句话。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“好了……今天做什么呢。”"},{"op":"text","speaker":"","text":"羽未去外面玩了，镜子阿姨在整理仓库。"},{"op":"text","speaker":"","text":"那我……"},{"op":"text","speaker":"","text":"还是去岛上溜达吧。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"return"},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"饭后――……"},{"op":"text","speaker":"","text":"我躺在客厅，稍微调大了电视的音量。"},{"op":"text","speaker":"","text":"不知为何，今天没有从外面传来虫鸣声。"},{"op":"text","speaker":"","text":"也许正因如此吧，一旦安静下来就会隐约地听见。"},{"op":"text","speaker":"","text":"从浴室传来的……"},{"op":"text","speaker":"","text":"声响。"},{"op":"text","speaker":"羽依里","text":"“呼……”"},{"op":"text","speaker":"","text":"现在羽未和镜子阿姨在一起洗澡。"},{"op":"text","speaker":"","text":"将注意力集中在电视上。"},{"op":"text","speaker":"","text":"别无他意。"},{"op":"text","speaker":"","text":"只是。"},{"op":"text","speaker":"","text":"有些在意。"},{"op":"text","speaker":"","text":"突然电视的声音消失了。"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"","text":"正在观看的节目进入了寂静场景。"},{"op":"text","speaker":"","text":"然而就在这个节骨眼上，透过几面墙，传来了……哗啦啦的水声。"},{"op":"text","speaker":"","text":"应该是两人进入浴缸，热水溢出来的声音。"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"","text":"我是健康的男高中生。"},{"op":"text","speaker":"","text":"自然会激动。"},{"op":"text","speaker":"","text":"虽然不知道镜子阿姨的具体年龄……"},{"op":"text","speaker":"","text":"她身为妈妈的妹妹……"},{"op":"text","speaker":"","text":"看起来却很年轻。"},{"op":"goto","target":333},{"op":"if","truth":false,"target":146,"value":["==",["v",38],1]},{"op":"text","speaker":"","text":"羽未虽然是亲戚……"},{"op":"text","speaker":"","text":"但又觉得她挺可爱的……"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"","text":"走吧……"},{"op":"choice","variable":6001,"items":[{"text":"前往浴室","value":0,"condition":1},{"text":"去化作清风","value":1,"condition":1}]},{"op":"if","truth":false,"target":140,"value":["==",["v",6001],0]},{"op":"text","speaker":"","text":"关掉电视站起身来。"},{"op":"text","speaker":"","text":"这并不是错误的选择。"},{"op":"text","speaker":"","text":"有何不可呢！"},{"op":"text","speaker":"","text":"毕竟我是男生嘛！"},{"op":"text","speaker":"","text":"是健康的男高中生啊！"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"我走向了浴室。"},{"op":"text","speaker":"","text":"要将这份仲夏的回忆……"},{"op":"text","speaker":"","text":"烙印在脑海之中！"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“呼……”"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i516"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"我，鹰原羽依里……"},{"op":"text","speaker":"","text":"在这个夏天里，又有了一段新的经历。"},{"op":"text","speaker":"","text":"作为代价，我正被深深的罪恶感所束缚。"},{"op":"text","speaker":"","text":"心存着感谢……"},{"op":"text","speaker":"","text":"以及足以掩盖这份谢意的愧疚感。"},{"op":"text","speaker":"","text":"不过……"},{"op":"text","speaker":"","text":"还是应该说一声吧。"},{"op":"text","speaker":"羽依里","text":"“谢谢……”"},{"op":"text","speaker":"","text":"谢谢谁？"},{"op":"text","speaker":"","text":"啊，一定是……谢谢这个世界吧。"},{"op":"set","variable":48,"value":1},{"op":"goto","target":145},{"op":"if","truth":false,"target":145,"value":["==",["v",6001],1]},{"op":"text","speaker":"","text":"我要驱逐邪念。"},{"op":"text","speaker":"","text":"我有支撑着我的伙伴。"},{"op":"text","speaker":"","text":"和它……一同奔跑吧！"},{"op":"goto","target":150},{"op":"goto","target":172},{"op":"text","speaker":"羽依里","text":"“冷静下来！鹰原羽依里！”"},{"op":"text","speaker":"","text":"就是因为待在这里才会想那些多余的事！"},{"op":"text","speaker":"","text":"不要归咎于年轻冲动！"},{"op":"text","speaker":"","text":"有时一个夏天的错误，就会导致失去一切！"},{"op":"text","speaker":"","text":"我紧紧握着摩托车钥匙，飞奔而出。"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i516"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“呜!!!!呀呼!!!”"},{"op":"text","speaker":"","text":"驰骋在夜晚的岛上。"},{"op":"text","speaker":"","text":"迎风冲刺，为了掩盖一切虫鸣声。"},{"op":"text","speaker":"","text":"为了抛下一切杂念。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"然后――……"},{"op":"image","layer":0,"image":"i39"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"直到汽油耗尽，推着摩托车走着……"},{"op":"text","speaker":"羽依里","text":"“哈……呼……好远啊……”"},{"op":"text","speaker":"","text":"不过……"},{"op":"text","speaker":"","text":"也多亏过量的运动，烦恼已散。"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"if","truth":false,"target":178,"value":["==",["v",6003],1]},{"op":"callScene","scene":40,"target":65},{"op":"goto","target":295},{"op":"if","truth":false,"target":181,"value":["==",["v",6003],2]},{"op":"callScene","scene":39,"target":35},{"op":"goto","target":295},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“鹰原哥。”"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"image","layer":1,"image":"i15340"},{"op":"text","speaker":"羽未","text":"“你怎么像只鼻涕虫一样瘫在地上呀？”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“差不多该去洗澡了，我还想收拾呢。”"},{"op":"text","speaker":"羽依里","text":"“抱歉，我好困……”"},{"op":"text","speaker":"","text":"我依旧趴在地上，站不起来。"},{"op":"text","speaker":"","text":"已经没有去洗澡的体力了。"},{"op":"text","speaker":"羽依里","text":"“我就这样在这里睡了……”"},{"op":"image","layer":1,"image":"i15331"},{"op":"text","speaker":"羽未","text":"“不可以啦，会臭的。”"},{"op":"text","speaker":"羽依里","text":"“不会的不会的。”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“真是的。”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“你有那么累吗？”"},{"op":"text","speaker":"羽依里","text":"“……嗯，很累。”"},{"op":"image","layer":1,"image":"i15363"},{"op":"text","speaker":"羽未","text":"“真拿你没辙。”"},{"op":"image","layer":1,"image":"i15323"},{"op":"text","speaker":"羽依里","text":"“你…你要做什么。”"},{"op":"image","layer":1,"image":"i15469"},{"op":"text","speaker":"羽未","text":"“你怕什么嘛。”"},{"op":"text","speaker":"羽依里","text":"“我也不知道，感觉会被你除掉。”"},{"op":"image","layer":1,"image":"i15364"},{"op":"text","speaker":"羽未","text":"“你要我怎么除掉你嘛。”"},{"op":"image","layer":1,"image":"i15376"},{"op":"text","speaker":"羽未","text":"“只是帮你排解疲劳。”"},{"op":"text","speaker":"羽依里","text":"“排解疲劳？”"},{"op":"text","speaker":"","text":"揉捏。"},{"op":"text","speaker":"羽依里","text":"“噢！”"},{"op":"text","speaker":"羽依里","text":"“这是！”"},{"op":"image","layer":1,"image":"i15326"},{"op":"text","speaker":"羽未","text":"“是按摩啦。”"},{"op":"image","layer":1,"image":"i15323"},{"op":"text","speaker":"羽未","text":"“放轻松一些。”"},{"op":"text","speaker":"","text":"揉捏。"},{"op":"text","speaker":"羽依里","text":"“啊哼！”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“哇，发出怪声了。”"},{"op":"text","speaker":"羽依里","text":"“好熟练呀，羽未。”"},{"op":"image","layer":1,"image":"i15455"},{"op":"text","speaker":"羽未","text":"“只会一点点啦。”"},{"op":"text","speaker":"羽依里","text":"“还能再给我按吗？”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“唉？”"},{"op":"text","speaker":"羽依里","text":"“真的好舒服嘛。”"},{"op":"image","layer":1,"image":"i15465"},{"op":"text","speaker":"羽未","text":"“可以倒是可以啦……不过鹰原哥有洗干净身子吗？”"},{"op":"text","speaker":"羽依里","text":"“为什么这么问!؟当然有啊。”"},{"op":"image","layer":1,"image":"i15366"},{"op":"text","speaker":"羽未","text":"“因为你洗澡总是很快啊。”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“所以我总是怀疑，你到底有没有洗干净。”"},{"op":"text","speaker":"羽依里","text":"“你居然是这样看我的……”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“如果没洗干净的话，我想尽可能地……少碰你。”"},{"op":"text","speaker":"羽依里","text":"“有洗干净啦，就算没洗干净也隔着衣服呢，怕什么嘛。”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“感觉会透过衣服渗出来。”"},{"op":"text","speaker":"羽依里","text":"“我到底是有多脏？”"},{"op":"image","layer":1,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“倒也不臭啦，应该没问题吧。”"},{"op":"image","layer":1,"image":"i15455"},{"op":"text","speaker":"羽未","text":"“那你趴在那里。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“嗯…嗯。”"},{"op":"text","speaker":"","text":"面朝下趴着。"},{"op":"text","speaker":"","text":"羽未细嫩的手指陷入我的后腰……"},{"op":"text","speaker":"","text":"按压。"},{"op":"text","speaker":"羽依里","text":"“!؟”"},{"op":"text","speaker":"","text":"这……"},{"op":"text","speaker":"","text":"按压。"},{"op":"text","speaker":"","text":"何等……舒适……"},{"op":"text","speaker":"羽依里","text":"“呼嘛！”"},{"op":"image","layer":7,"image":"i15464"},{"op":"text","speaker":"羽未","text":"“都叫你不要发出怪声啦。”"},{"op":"text","speaker":"羽依里","text":"“因为舒服嘛。”"},{"op":"text","speaker":"","text":"按压。"},{"op":"text","speaker":"羽依里","text":"“呼嘛！”"},{"op":"image","layer":7,"image":"i15475"},{"op":"text","speaker":"羽未","text":"“……真受不了你。”"},{"op":"text","speaker":"","text":"……"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i64"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“嗯……？”"},{"op":"text","speaker":"","text":"这里是……"},{"op":"text","speaker":"","text":"想起来了。"},{"op":"text","speaker":"","text":"羽未在客厅给我按摩来着。"},{"op":"text","speaker":"","text":"太过舒适结果就这样睡着了。"},{"op":"text","speaker":"","text":"灯已经关了，我的身上还盖着毛毯。"},{"op":"text","speaker":"羽未","text":"“呼…呼…”"},{"op":"text","speaker":"","text":"羽未就睡在一旁。"},{"op":"text","speaker":"","text":"我将盖在我身上的毯子盖在了她身上。"},{"op":"text","speaker":"","text":"然后就地躺下，听着羽未的呼吸声渐渐陷入沉睡。"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"if","truth":false,"target":316,"value":["==",["v",6003],2]},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i75"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"在被子里想着。"},{"op":"text","speaker":"","text":"镜子阿姨……"},{"op":"text","speaker":"","text":"她现在会不会相当怀疑我呢？"},{"op":"text","speaker":"","text":"明明很多都是误会。"},{"op":"text","speaker":"","text":"明明绝对是误会。"},{"op":"text","speaker":"","text":"算了，还是注意点吧。"},{"op":"text","speaker":"羽依里","text":"“睡吧……”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"goto","target":316},{"op":"if","truth":false,"target":332,"value":["==",["v",139],1]},{"op":"if","truth":false,"target":325,"value":["==",["v",6003],2]},{"op":"text","speaker":"羽依里","text":"“……啊。”"},{"op":"image","layer":0,"image":"i75"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"对了，还要设置岛可梦对战的饵。"},{"op":"text","speaker":"","text":"……怎么办好呢。"},{"op":"callScene","scene":278,"target":1592},{"op":"goto","target":331},{"op":"text","speaker":"羽依里","text":"“……啊。”"},{"op":"image","layer":0,"image":"i64"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"对了，还要设置岛可梦对战的饵。"},{"op":"text","speaker":"","text":"……怎么办好呢。"},{"op":"callScene","scene":278,"target":1592},{"op":"goto","target":332},{"op":"return"},{"op":"if","truth":false,"target":0,"value":["==",["v",38],1]},{"op":"text","speaker":"","text":"羽未虽然是亲戚……"},{"op":"text","speaker":"","text":"但又觉得她挺可爱的……"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"","text":"走吧……"},{"op":"callScene","scene":417,"target":12},{"op":"if","truth":false,"target":376,"value":["==",["v",6001],0]},{"op":"text","speaker":"","text":"关掉电视站起身来。"},{"op":"text","speaker":"","text":"这并不是错误的选择。"},{"op":"text","speaker":"","text":"有何不可呢！"},{"op":"text","speaker":"","text":"毕竟我是男生嘛！"},{"op":"text","speaker":"","text":"是健康的男高中生啊！"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"我走向了浴室。"},{"op":"text","speaker":"","text":"要将这份仲夏的回忆……"},{"op":"text","speaker":"","text":"烙印在脑海之中！"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“呼……”"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i516"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"我，鹰原羽依里……"},{"op":"text","speaker":"","text":"在这个夏天里，又有了一段新的经历。"},{"op":"text","speaker":"","text":"作为代价，我正被深深的罪恶感所束缚。"},{"op":"text","speaker":"","text":"心存着感谢……"},{"op":"text","speaker":"","text":"以及足以掩盖这份谢意的愧疚感。"},{"op":"text","speaker":"","text":"不过……"},{"op":"text","speaker":"","text":"还是应该说一声吧。"},{"op":"text","speaker":"羽依里","text":"“谢谢……”"},{"op":"text","speaker":"","text":"谢谢谁？"},{"op":"text","speaker":"","text":"啊，一定是……谢谢这个世界吧。"},{"op":"set","variable":48,"value":1},{"op":"goto","target":381},{"op":"if","truth":false,"target":381,"value":["==",["v",6001],1]},{"op":"text","speaker":"","text":"我要驱逐邪念。"},{"op":"text","speaker":"","text":"我有支撑着我的伙伴。"},{"op":"text","speaker":"","text":"和它……一同奔跑吧！"},{"op":"goto","target":150},{"op":"goto","target":172},{"op":"end"}]