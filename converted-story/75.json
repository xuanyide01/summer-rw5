[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i76"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“就这样……”"},{"op":"text","speaker":"羽依里","text":"“我当起了游泳教练，然而还不太懂该怎么教才好。”"},{"op":"text","speaker":"羽依里","text":"“所以我就来这里看看，有没有什么能用得上的东西。”"},{"op":"image","layer":1,"image":"i11680"},{"op":"text","speaker":"镜子","text":"“在仓库里找？会有这样的东西吗……”"},{"op":"text","speaker":"羽依里","text":"“因为我有种这仓库什么都有的印象。”"},{"op":"text","speaker":"羽依里","text":"“就像那奇怪的四次元口袋一样。”"},{"op":"image","layer":1,"image":"i11670"},{"op":"text","speaker":"镜子","text":"“那要是找到什么能用的，你就拿去吧。”"},{"op":"text","speaker":"羽依里","text":"“谢谢。”"},{"op":"image","layer":1,"image":"i11667"},{"op":"text","speaker":"镜子","text":"“呵呵。”"},{"op":"text","speaker":"羽依里","text":"“笑什么？”"},{"op":"image","layer":1,"image":"i11647"},{"op":"text","speaker":"镜子","text":"“没什么。”"},{"op":"text","speaker":"","text":"镜子阿姨看着到处翻找的我，面露微笑。"},{"op":"text","speaker":"","text":"所以说……"},{"op":"text","speaker":"","text":"希望能在仓库找到什么能派上用场的东西吧。"},{"op":"text","speaker":"","text":"然而什么能派上用场，其实我也不知道。"},{"op":"text","speaker":"","text":"看似能用的东西，倒是翻出了几件。"},{"op":"text","speaker":"","text":"总之，就先随便挑个吧。"},{"op":"text","speaker":"","text":"要带什么过去？"},{"op":"choice","variable":6001,"items":[{"text":"哨子","value":0,"condition":1},{"text":"吉祥物泳圈","value":1,"condition":1},{"text":"爱心泳镜","value":2,"condition":1}]},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"if","truth":false,"target":185,"value":["==",["v",6001],0]},{"op":"image","layer":0,"image":"i18"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“哔――――――”"},{"op":"image","layer":1,"image":"i13386"},{"op":"text","speaker":"白羽","text":"“!!؟”"},{"op":"text","speaker":"羽依里","text":"“集合!!”"},{"op":"image","layer":1,"image":"i13313"},{"op":"text","speaker":"白羽","text":"“唉？”"},{"op":"text","speaker":"羽依里","text":"“哔――――――”"},{"op":"text","speaker":"羽依里","text":"“集合。”"},{"op":"image","layer":257,"image":"i11711"},{"op":"image","layer":1,"image":"i13234"},{"op":"text","speaker":"美希","text":"“好的好的。”"},{"op":"image","layer":257,"image":"i11709"},{"op":"image","layer":1,"image":"i13274"},{"op":"text","speaker":"白羽","text":"“今天是……”"},{"op":"text","speaker":"羽依里","text":"“热身运动！”"},{"op":"image","layer":257,"image":"i11718"},{"op":"image","layer":1,"image":"i13319"},{"op":"text","speaker":"白羽","text":"“!؟”"},{"op":"text","speaker":"羽依里","text":"“前屈。”"},{"op":"text","speaker":"羽依里","text":"“哔，哔，哔。”"},{"op":"image","layer":1,"image":"i13244"},{"op":"text","speaker":"白羽","text":"“怎么回事？”"},{"op":"image","layer":1,"image":"i13241"},{"op":"text","speaker":"白羽","text":"“忽然就兴致十足的了？”"},{"op":"text","speaker":"羽依里","text":"“屈伸。”"},{"op":"text","speaker":"羽依里","text":"“哔，哔，哔。”"},{"op":"image","layer":257,"image":"i11712"},{"op":"text","speaker":"美希","text":"“这要做多久啊。”"},{"op":"text","speaker":"羽依里","text":"“还有20分钟。”"},{"op":"image","layer":257,"image":"i11718"},{"op":"image","layer":1,"image":"i13257"},{"op":"text","speaker":"白羽","text":"“20!؟”"},{"op":"text","speaker":"羽依里","text":"“必须做足20分钟。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"image","layer":1,"image":"i11721"},{"op":"image","layer":257,"image":"i13253"},{"op":"text","speaker":"白羽","text":"“哈啊，哈啊……”"},{"op":"image","layer":1,"image":"i11699"},{"op":"text","speaker":"美希","text":"“哈啊，哈啊。”"},{"op":"image","layer":257,"image":"i13426"},{"op":"text","speaker":"白羽","text":"“做拉伸都做累了。”"},{"op":"text","speaker":"羽依里","text":"“去换成运动服。”"},{"op":"image","layer":1,"image":"i11718"},{"op":"image","layer":257,"image":"i13387"},{"op":"text","speaker":"白羽","text":"“为什么!؟”"},{"op":"text","speaker":"羽依里","text":"“要先锻炼体力。”"},{"op":"image","layer":1,"image":"i11758"},{"op":"text","speaker":"美希","text":"“我们想学的是游泳。”"},{"op":"text","speaker":"羽依里","text":"“哔――――!!”"},{"op":"image","layer":1,"image":"i11712"},{"op":"image","layer":257,"image":"i13244"},{"op":"text","speaker":"白羽","text":"“吵死了。”"},{"op":"text","speaker":"羽依里","text":"“给我从基础体力开始练。”"},{"op":"image","layer":257,"image":"i13274"},{"op":"text","speaker":"白羽","text":"“我可没带运动服来。”"},{"op":"text","speaker":"羽依里","text":"“哔――――!!”"},{"op":"text","speaker":"羽依里","text":"“那便服和校服里挑一件想穿的就行。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i37"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13426"},{"op":"text","speaker":"白羽","text":"“哈啊，哈啊……呼。”"},{"op":"image","layer":257,"image":"i10290"},{"op":"text","speaker":"苍","text":"“这么大热天，我们为什么，非得出来跑步啊。”"},{"op":"text","speaker":"羽依里","text":"“哔――――!!”"},{"op":"image","layer":257,"image":"i10218"},{"op":"image","layer":1,"image":"i13387"},{"op":"text","speaker":"苍","text":"“吵死了。”"},{"op":"text","speaker":"羽依里","text":"“不准窃窃私语。”"},{"op":"image","layer":513,"image":"i11699"},{"op":"text","speaker":"美希","text":"“他到底是怎么回事？”"},{"op":"image","layer":513,"image":"i11712"},{"op":"text","speaker":"美希","text":"“那个原本说得上是温厚的鹰原，怎么就变成这副模样了？”"},{"op":"image","layer":1,"image":"i10205"},{"op":"text","speaker":"苍","text":"“得意忘形地哨子吹个不停。”"},{"op":"image","layer":257,"image":"i13370"},{"op":"text","speaker":"白羽","text":"“我觉得。”"},{"op":"image","layer":257,"image":"i13390"},{"op":"text","speaker":"白羽","text":"“他是不是被那个哨子附身了？”"},{"op":"image","layer":1,"image":"i10285"},{"op":"text","speaker":"苍","text":"“不会吧……”"},{"op":"text","speaker":"羽依里","text":"“哔――――――”"},{"op":"text","speaker":"羽依里","text":"“脚怎么停下了。”"},{"op":"text","speaker":"羽依里","text":"“哔，哔！”"},{"op":"image","layer":1,"image":"i10319"},{"op":"text","speaker":"苍","text":"“还真有可能。”"},{"op":"image","layer":257,"image":"i11701"},{"op":"text","speaker":"美希","text":"“试试把那哨子抢过来吧。”"},{"op":"image","layer":513,"image":"i13418"},{"op":"text","speaker":"白羽","text":"“怎么抢？”"},{"op":"image","layer":1,"image":"i10267"},{"op":"text","speaker":"苍","text":"“白羽你去引开他的注意力，我们趁机去抢。”"},{"op":"image","layer":513,"image":"i13314"},{"op":"text","speaker":"白羽","text":"“怎么引？”"},{"op":"image","layer":257,"image":"i11728"},{"op":"image","layer":1,"image":"i10235"},{"op":"text","speaker":"苍","text":"“这就看你了。”"},{"op":"image","layer":513,"image":"i13328"},{"op":"text","speaker":"白羽","text":"“我试试。”"},{"op":"text","speaker":"","text":"……"},{"op":"image","layer":1,"image":"i13304"},{"op":"text","speaker":"白羽","text":"“那个。”"},{"op":"text","speaker":"羽依里","text":"“说。”"},{"op":"image","layer":1,"image":"i13294"},{"op":"text","speaker":"白羽","text":"“被子被抬了。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“你想说的只有这些？”"},{"op":"image","layer":1,"image":"i13346"},{"op":"text","speaker":"白羽","text":"“那个。”"},{"op":"image","layer":1,"image":"i13331"},{"op":"text","speaker":"白羽","text":"“扑通噗通了。”"},{"op":"text","speaker":"羽依里","text":"“什么？”"},{"op":"image","layer":1,"image":"i13319"},{"op":"text","speaker":"白羽","text":"“扑通……噗通……”"},{"op":"image","layer":1,"image":"i13304"},{"op":"text","speaker":"羽依里","text":"“……唔。”"},{"op":"text","speaker":"","text":"莫名其妙。"},{"op":"image","layer":257,"image":"i10209"},{"op":"text","speaker":"苍","text":"“得手了！”"},{"op":"text","speaker":"羽依里","text":"“!؟”"},{"op":"text","speaker":"羽依里","text":"“什……”"},{"op":"text","speaker":"羽依里","text":"“……咦？”"},{"op":"text","speaker":"羽依里","text":"“我在干什么来着？”"},{"op":"text","speaker":"羽依里","text":"“感觉头晕沉沉的。”"},{"op":"image","layer":1,"image":"i11712"},{"op":"image","layer":257,"image":"i13250"},{"op":"image","layer":513,"image":"i10290"},{"op":"text","speaker":"苍","text":"“还真是被哨子附身了啊。”"},{"op":"text","speaker":"羽依里","text":"“不……好像是……”"},{"op":"text","speaker":"羽依里","text":"“吹哨子吹得脑子缺氧了。”"},{"op":"image","layer":1,"image":"i11718"},{"op":"image","layer":257,"image":"i13274"},{"op":"image","layer":513,"image":"i10227"},{"op":"text","speaker":"一同","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“那玩意，吹着吹着就会上瘾。”"},{"op":"text","speaker":"羽依里","text":"“然后莫名其妙就缺氧了……飘忽忽的。”"},{"op":"text","speaker":"羽依里","text":"“反而让我情绪越来越激动。”"},{"op":"image","layer":1,"image":"i11755"},{"op":"image","layer":257,"image":"i13244"},{"op":"image","layer":513,"image":"i10319"},{"op":"text","speaker":"美希","text":"“真会给人添麻烦。”"},{"op":"text","speaker":"羽依里","text":"“对不起。”"},{"op":"text","speaker":"羽依里","text":"“那哨子就封印起来吧。”"},{"op":"goto","target":327},{"op":"if","truth":false,"target":251,"value":["==",["v",6001],1]},{"op":"image","layer":0,"image":"i18"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“目标是让你能在海里游泳。”"},{"op":"text","speaker":"羽依里","text":"“不过，一开始还是先熟悉水性比较重要。”"},{"op":"text","speaker":"羽依里","text":"“所以就用这个吧。”"},{"op":"image","layer":1,"image":"i13471"},{"op":"text","speaker":"白羽","text":"“……泳圈？”"},{"op":"text","speaker":"羽依里","text":"“没错。”"},{"op":"image","layer":1,"image":"i13493"},{"op":"text","speaker":"白羽","text":"“不要。”"},{"op":"image","layer":1,"image":"i13502"},{"op":"text","speaker":"白羽","text":"“这种东西是小孩才用的。”"},{"op":"image","layer":1,"image":"i13518"},{"op":"text","speaker":"白羽","text":"“多羞人。”"},{"op":"text","speaker":"羽依里","text":"“现在哪是害羞的时候？”"},{"op":"text","speaker":"羽依里","text":"“不是想学会游泳吗？”"},{"op":"image","layer":1,"image":"i13472"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"于是……她就试着套上泳圈。"},{"op":"text","speaker":"羽依里","text":"“噗。”"},{"op":"text","speaker":"","text":"想不到还意外地合身。"},{"op":"image","layer":1,"image":"i13521"},{"op":"text","speaker":"白羽","text":"“!؟”"},{"op":"image","layer":1,"image":"i13570"},{"op":"text","speaker":"白羽","text":"“我还是不用了。”"},{"op":"text","speaker":"羽依里","text":"“对不起！”"},{"op":"text","speaker":"羽依里","text":"“我没有笑你的意思。”"},{"op":"image","layer":1,"image":"i13466"},{"op":"text","speaker":"白羽","text":"“……好可疑。”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i13570"},{"op":"text","speaker":"白羽","text":"“还是不用了。”"},{"op":"text","speaker":"羽依里","text":"“我这不是没笑吗。”"},{"op":"image","layer":1,"image":"i13557"},{"op":"text","speaker":"白羽","text":"“感觉你的眼睛在笑。”"},{"op":"text","speaker":"","text":"……"},{"op":"image","layer":257,"image":"i11914"},{"op":"text","speaker":"美希","text":"“泳圈？”"},{"op":"text","speaker":"羽依里","text":"“野美希你要不要也用？”"},{"op":"image","layer":257,"image":"i11902"},{"op":"text","speaker":"美希","text":"“这种东西谁要用啊。”"},{"op":"text","speaker":"羽依里","text":"“不，一开始还是用它熟悉水性好。”"},{"op":"image","layer":257,"image":"i11907"},{"op":"text","speaker":"美希","text":"“唔。”"},{"op":"image","layer":257,"image":"i11910"},{"op":"text","speaker":"美希","text":"“好吧，你说得对。可泳圈我小学毕业后就没用过了。”"},{"op":"image","layer":257,"image":"i11902"},{"op":"text","speaker":"美希","text":"“而且还是这种吉祥物泳圈……”"},{"op":"image","layer":257,"image":"i11908"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"简直就是天生一对。"},{"op":"text","speaker":"羽依里","text":"“噗。”"},{"op":"text","speaker":"","text":"我忍不住笑了出来。"},{"op":"image","layer":257,"image":"i11906"},{"op":"text","speaker":"美希","text":"“唔。”"},{"op":"image","layer":7,"image":"i13566"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"image","layer":257,"image":"i11901"},{"op":"text","speaker":"美希","text":"“连白羽也！刚刚笑了是吧！”"},{"op":"image","layer":7,"image":"i13550"},{"op":"text","speaker":"白羽","text":"“没，没笑。”"},{"op":"text","speaker":"美希","text":"“你笑了。我看到的！”"},{"op":"goto","target":327},{"op":"if","truth":false,"target":327,"value":["==",["v",6001],2]},{"op":"image","layer":0,"image":"i18"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“我在想。”"},{"op":"text","speaker":"羽依里","text":"“你们游泳时，为什么都不戴泳镜啊？”"},{"op":"image","layer":1,"image":"i13576"},{"op":"text","speaker":"白羽","text":"“唉？”"},{"op":"text","speaker":"羽依里","text":"“白羽，你在水里一直闭着眼睛对吧？”"},{"op":"text","speaker":"羽依里","text":"“我觉得要是戴副泳镜，应该能改善很多。”"},{"op":"image","layer":1,"image":"i13545"},{"op":"text","speaker":"白羽","text":"“可就算戴着泳镜，水一样能渗进来。”"},{"op":"image","layer":1,"image":"i13552"},{"op":"text","speaker":"白羽","text":"“而且被勒得紧紧的，很痛。”"},{"op":"text","speaker":"羽依里","text":"“那是因为你没戴好，或者在水里乱动的缘故。”"},{"op":"text","speaker":"羽依里","text":"“这个，也许能派上用场。”"},{"op":"image","layer":1,"image":"i13478"},{"op":"text","speaker":"白羽","text":"“什么？”"},{"op":"text","speaker":"羽依里","text":"“这是我从仓库带过来的。”"},{"op":"text","speaker":"羽依里","text":"“没开封的包装盒上，写着‘爱心泳镜’。”"},{"op":"image","layer":1,"image":"i13464"},{"op":"text","speaker":"白羽","text":"“爱、爱心泳镜……什么东西啊？”"},{"op":"text","speaker":"羽依里","text":"“商品说明上写着，‘温柔而又有力，呵护您的双眼免受水的侵犯’。”"},{"op":"image","layer":1,"image":"i13465"},{"op":"text","speaker":"白羽","text":"“为什么是粉红色的，而且形状这么奇怪。”"},{"op":"text","speaker":"羽依里","text":"“大概是为了表现温柔？”"},{"op":"image","layer":1,"image":"i13516"},{"op":"text","speaker":"白羽","text":"“……姑且戴戴看。”"},{"op":"image","layer":1,"image":"i13488"},{"op":"text","speaker":"白羽","text":"“戴起来确实舒适。”"},{"op":"text","speaker":"羽依里","text":"“!؟”"},{"op":"text","speaker":"","text":"这是……"},{"op":"image","layer":7,"image":"i12023"},{"op":"text","speaker":"良一","text":"“白，白羽……你出大事了。”"},{"op":"image","layer":1,"image":"i13538"},{"op":"text","speaker":"白羽","text":"“唉？”"},{"op":"image","layer":7,"image":"i12010"},{"op":"text","speaker":"良一","text":"“像是处于超级发情期似的。”"},{"op":"image","layer":7,"image":"i15228"},{"op":"text","speaker":"天善","text":"“简直就不像是白羽。”"},{"op":"image","layer":7,"image":"i12016"},{"op":"text","speaker":"良一","text":"“不过也无所谓。”"},{"op":"text","speaker":"","text":"戴着泳镜，白羽试着去潜了一下水，然后回来。"},{"op":"image","layer":1,"image":"i13490"},{"op":"text","speaker":"白羽","text":"“谢谢，我能稍微睁开眼睛了。”"},{"op":"image","layer":1,"image":"i13489"},{"op":"text","speaker":"白羽","text":"“戴着非常舒适。”"},{"op":"image","layer":257,"image":"i12011"},{"op":"text","speaker":"良一","text":"“真亏白羽愿意乖乖戴上那玩意啊。”"},{"op":"text","speaker":"羽依里","text":"“我想，她大概不知道自己看上去是什么样的。”"},{"op":"image","layer":257,"image":"i12042"},{"op":"text","speaker":"良一","text":"“不过要是真那么舒适的话。”"},{"op":"image","layer":1,"image":"i13491"},{"op":"image","layer":257,"image":"i12009"},{"op":"text","speaker":"良一","text":"“能不能给我戴戴看？”"},{"op":"image","layer":1,"image":"i13459"},{"op":"text","speaker":"白羽","text":"“请。”"},{"op":"image","layer":257,"image":"i12044"},{"op":"text","speaker":"良一","text":"“……”"},{"op":"image","layer":1,"image":"i13512"},{"op":"image","layer":257,"image":"i12042"},{"op":"text","speaker":"羽依里","text":"“还我。”"},{"op":"image","layer":257,"image":"i12013"},{"op":"text","speaker":"良一","text":"“怎么刚戴上你就抢回去了。”"},{"op":"text","speaker":"羽依里","text":"“因为恶心。”"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"白羽愣住了。"},{"op":"image","layer":1,"image":"i13481"},{"op":"text","speaker":"白羽","text":"“我居然戴着那种东西……”"},{"op":"image","layer":1,"image":"i13474"},{"op":"text","speaker":"","text":"然后怒瞪着我。"},{"op":"image","layer":1,"image":"i13475"},{"op":"text","speaker":"白羽","text":"“你算计我。”"},{"op":"text","speaker":"羽依里","text":"“对不起。”"},{"op":"image","layer":1,"image":"i13476"},{"op":"text","speaker":"白羽","text":"“别戴着那怪泳镜道歉。”"},{"op":"goto","target":327},{"op":"clear","layer":65281},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i513"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":256,"image":"i514"},{"op":"set","variable":6714,"value":4},{"op":"set","variable":7120,"value":1},{"op":"clear","layer":256},{"op":"image","layer":0,"image":"i19"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"羽依里","text":"“好了，今天就到此为止吧。”"},{"op":"text","speaker":"","text":"练习过后，换好衣服聚集到泳池边的大家都面露着疲惫。"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“辛苦了。”"},{"op":"image","layer":257,"image":"i13421"},{"op":"text","speaker":"白羽","text":"“辛苦……”"},{"op":"image","layer":513,"image":"i10210"},{"op":"text","speaker":"苍","text":"“哎，累死了。回家咯回家咯。”"},{"op":"text","speaker":"羽依里","text":"“喂喂，别忘了最后做一组拉伸。”"},{"op":"image","layer":513,"image":"i10213"},{"op":"text","speaker":"苍","text":"“哎哎，不用了吧。”"},{"op":"text","speaker":"羽依里","text":"“别说傻话。”"},{"op":"image","layer":513,"image":"i10210"},{"op":"text","speaker":"苍","text":"“好。”"},{"op":"image","layer":1,"image":"i11696"},{"op":"text","speaker":"美希","text":"“对了，今晚我有事想拜托你们。”"},{"op":"image","layer":1,"image":"i11689"},{"op":"text","speaker":"美希","text":"“晚上7点能聚集到食堂来吗？”"},{"op":"text","speaker":"羽依里","text":"“？哦。”"},{"op":"text","speaker":"","text":"晚上集合？"},{"op":"text","speaker":"","text":"会是什么事呢。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i17"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11777"},{"op":"text","speaker":"美希","text":"“大家都来了吗？”"},{"op":"image","layer":257,"image":"i15008"},{"op":"image","layer":513,"image":"i10154"},{"op":"image","layer":769,"image":"i12144"},{"op":"text","speaker":"良一","text":"“都来了。”"},{"op":"text","speaker":"","text":"食堂里聚集着平时那几个人。"},{"op":"text","speaker":"羽依里","text":"“咦，白羽呢？”"},{"op":"image","layer":1,"image":"i11731"},{"op":"text","speaker":"美希","text":"“她说不知道能不能来，我们先开始吧。”"},{"op":"text","speaker":"羽依里","text":"“这样啊。”"},{"op":"text","speaker":"","text":"话说，还真是理所当然地就聚到了这食堂来了啊。"},{"op":"text","speaker":"","text":"看样子，这食堂算是所谓少年团集会的地方了。"},{"op":"text","speaker":"","text":"虽说没有其他客人，可这样不打扰生意吗？"},{"op":"text","speaker":"","text":"而且我难道已经给算进那所谓的少年团里了？"},{"op":"image","layer":1,"image":"i11777"},{"op":"text","speaker":"美希","text":"“今晚之所以召集鸟白岛少年团成员，不为其他。”"},{"op":"image","layer":1,"image":"i11753"},{"op":"text","speaker":"美希","text":"“就是为试胆活动的事。”"},{"op":"text","speaker":"羽依里","text":"“试胆活动？”"},{"op":"text","speaker":"羽依里","text":"“是说晚上到山里探险之类的，那种活动？”"},{"op":"image","layer":1,"image":"i11771"},{"op":"text","speaker":"美希","text":"“差不多吧。”"},{"op":"image","layer":1,"image":"i11777"},{"op":"text","speaker":"美希","text":"“具体地说，就是把放在神社的赛钱箱旁边的零食带回来而已。”"},{"op":"text","speaker":"羽依里","text":"“零食……真够温馨的。”"},{"op":"image","layer":1,"image":"i11753"},{"op":"text","speaker":"美希","text":"“本来就是为中小学生而设的活动。”"},{"op":"image","layer":7,"image":"i15037"},{"op":"text","speaker":"天善","text":"“那么，为什么要叫我们来啊？”"},{"op":"image","layer":1,"image":"i11777"},{"op":"text","speaker":"美希","text":"“试胆活动明天才正式举办。所以说，先由我们来确认活动当天所用的路线是否安全。”"},{"op":"text","speaker":"羽依里","text":"“确认安全？”"},{"op":"image","layer":1,"image":"i11766"},{"op":"text","speaker":"美希","text":"“虽说选好的路线已经考虑过安全问题，但不去实际摸黑走走看，还是不能让人放心。”"},{"op":"image","layer":1,"image":"i11780"},{"op":"text","speaker":"美希","text":"“而且既然是试胆，那肯定无法保持平常心。”"},{"op":"text","speaker":"美希","text":"“在这种状态下是否存在让孩子们受伤的可能，我们必须严格确认过才行。”"},{"op":"text","speaker":"羽依里","text":"“有道理，你说得对。”"},{"op":"text","speaker":"羽依里","text":"“举办一次活动，原来这么费神费力啊。”"},{"op":"image","layer":1,"image":"i11771"},{"op":"text","speaker":"美希","text":"“是啊。”"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“话说回来，鹰原你试胆玩得好吗？”"},{"op":"text","speaker":"羽依里","text":"“试胆？还算喜欢吧。”"},{"op":"image","layer":1,"image":"i11696"},{"op":"text","speaker":"美希","text":"“是那种嘴上喊着害怕，心里却能感受到乐趣的类型吗？”"},{"op":"text","speaker":"羽依里","text":"“唉？怕是不会怕的。”"},{"op":"image","layer":1,"image":"i11731"},{"op":"text","speaker":"羽依里","text":"“我反而会觉得兴奋。”"},{"op":"text","speaker":"羽依里","text":"“期待着会有什么猎奇的东西在等着我。”"},{"op":"image","layer":1,"image":"i11699"},{"op":"text","speaker":"美希","text":"“怎么可能会有那种东西出现。”"},{"op":"image","layer":1,"image":"i11712"},{"op":"text","speaker":"美希","text":"“看来鹰原不行。”"},{"op":"text","speaker":"羽依里","text":"“为什么啊？”"},{"op":"image","layer":1,"image":"i11701"},{"op":"text","speaker":"美希","text":"“我想确认的是孩子害怕时的安全状况。”"},{"op":"image","layer":1,"image":"i11709"},{"op":"text","speaker":"美希","text":"“所以最好就是会害怕的人去试胆。”"},{"op":"text","speaker":"羽依里","text":"“原来如此。”"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“天善你呢？”"},{"op":"image","layer":257,"image":"i15011"},{"op":"text","speaker":"天善","text":"“黑暗啊，反倒是我最爱。”"},{"op":"image","layer":1,"image":"i11712"},{"op":"text","speaker":"美希","text":"“最、最爱？”"},{"op":"image","layer":257,"image":"i15133"},{"op":"text","speaker":"天善","text":"“黑暗有助于集中精神，检视自身。”"},{"op":"image","layer":1,"image":"i11721"},{"op":"text","speaker":"美希","text":"“那你也不行。”"},{"op":"image","layer":1,"image":"i11712"},{"op":"text","speaker":"美希","text":"“仔细想想你整夜整夜都在那破屋特训，肯定不会怕试胆。”"},{"op":"image","layer":513,"image":"i12141"},{"op":"image","layer":1,"image":"i11731"},{"op":"text","speaker":"美希","text":"“良一你……”"},{"op":"image","layer":513,"image":"i12159"},{"op":"text","speaker":"良一","text":"“抱歉我也属于喜欢黑暗的。”"},{"op":"image","layer":513,"image":"i12190"},{"op":"text","speaker":"良一","text":"“因为黑暗中就不需要在意别人的眼光了。”"},{"op":"text","speaker":"羽依里","text":"“我觉得你平时也没在意过。”"},{"op":"image","layer":513,"image":"i12193"},{"op":"text","speaker":"良一","text":"“哈哈。”"},{"op":"image","layer":1,"image":"i11712"},{"op":"text","speaker":"美希","text":"“没救了这家伙。”"},{"op":"image","layer":1,"image":"i11731"},{"op":"image","layer":257,"image":"i10226"},{"op":"text","speaker":"美希","text":"“苍呢？”"},{"op":"image","layer":257,"image":"i10303"},{"op":"text","speaker":"苍","text":"“我也……嗯，习惯了，黑夜并不会让我害怕。”"},{"op":"image","layer":1,"image":"i11699"},{"op":"text","speaker":"美希","text":"“看来这里就找不到个怕黑的。”"},{"op":"image","layer":513,"image":"i13418"},{"op":"text","speaker":"白羽","text":"“对不起……我来晚了……”"},{"op":"image","layer":513,"image":"i13370"},{"op":"text","speaker":"白羽","text":"“那么，要说的事是……”"},{"op":"image","layer":1,"image":"i11696"},{"op":"text","speaker":"美希","text":"“白羽！”"},{"op":"image","layer":513,"image":"i13387"},{"op":"text","speaker":"白羽","text":"“什、什么……”"},{"op":"image","layer":1,"image":"i11689"},{"op":"text","speaker":"美希","text":"“你喜欢试胆吗？”"},{"op":"image","layer":513,"image":"i13390"},{"op":"text","speaker":"白羽","text":"“我讨厌。”"},{"op":"image","layer":1,"image":"i11715"},{"op":"text","speaker":"美希","text":"“很好！”"},{"op":"image","layer":513,"image":"i13405"},{"op":"text","speaker":"白羽","text":"“؟؟؟”"},{"op":"image","layer":1,"image":"i11696"},{"op":"text","speaker":"美希","text":"“只能拜托白羽了。”"},{"op":"image","layer":513,"image":"i13304"},{"op":"text","speaker":"白羽","text":"“؟؟؟”"},{"op":"image","layer":7,"image":"i12187"},{"op":"text","speaker":"良一","text":"“嗯，一看就是怕的。”"},{"op":"text","speaker":"","text":"呃，会吗。"},{"op":"text","speaker":"","text":"她毕竟都敢夜里一个人去泳池游泳，我想应该不会怕才对。"},{"op":"image","layer":513,"image":"i13294"},{"op":"text","speaker":"白羽","text":"“在说什么呢？”"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“我想让你等会去试一下胆。”"},{"op":"image","layer":513,"image":"i13319"},{"op":"text","speaker":"白羽","text":"“唉，不去。”"},{"op":"image","layer":1,"image":"i11771"},{"op":"text","speaker":"美希","text":"“我知道，你怕是吧，很害怕是吧。”"},{"op":"image","layer":1,"image":"i11696"},{"op":"text","speaker":"美希","text":"“那么就更加非你不可了。”"},{"op":"image","layer":513,"image":"i13304"},{"op":"text","speaker":"白羽","text":"“为什么要用充满期待的眼神看着我？”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"clear","layer":769},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i17"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"……"},{"op":"image","layer":1,"image":"i13334"},{"op":"text","speaker":"白羽","text":"“为了孩子们的安全……”"},{"op":"image","layer":1,"image":"i13287"},{"op":"text","speaker":"白羽","text":"“既然是这样……那好吧。”"},{"op":"image","layer":1,"image":"i13291"},{"op":"text","speaker":"白羽","text":"“按照这条路线去神社就行了？”"},{"op":"text","speaker":"白羽","text":"“然后确认安全就行了对吧。”"},{"op":"image","layer":257,"image":"i11753"},{"op":"text","speaker":"美希","text":"“没错。”"},{"op":"image","layer":1,"image":"i13277"},{"op":"text","speaker":"白羽","text":"“那我去了。”"},{"op":"image","layer":257,"image":"i11728"},{"op":"text","speaker":"美希","text":"“等等，带个搭档去吧。”"},{"op":"image","layer":1,"image":"i13274"},{"op":"text","speaker":"白羽","text":"“搭档？”"},{"op":"image","layer":1,"image":"i13235"},{"op":"text","speaker":"白羽","text":"“不需要。”"},{"op":"image","layer":1,"image":"i13280"},{"op":"text","speaker":"白羽","text":"“我自己就行。”"},{"op":"image","layer":257,"image":"i11712"},{"op":"text","speaker":"美希","text":"“……唉？”"},{"op":"text","speaker":"","text":"野美希很惊讶地看着她。"},{"op":"text","speaker":"","text":"估计是在想，莫非连白羽也不怕这种东西？"},{"op":"image","layer":257,"image":"i11704"},{"op":"text","speaker":"美希","text":"“不管你要不要。”"},{"op":"image","layer":257,"image":"i11701"},{"op":"text","speaker":"美希","text":"“总之，我可不能让女孩一个人摸黑上路。”"},{"op":"image","layer":1,"image":"i13304"},{"op":"text","speaker":"白羽","text":"“唉唉？”"},{"op":"image","layer":1,"image":"i13296"},{"op":"text","speaker":"白羽","text":"“那搭档……要找谁？”"},{"op":"image","layer":257,"image":"i11715"},{"op":"text","speaker":"美希","text":"“这个，就由白羽你来选了。”"},{"op":"image","layer":1,"image":"i13322"},{"op":"text","speaker":"白羽","text":"“我选？”"},{"op":"image","layer":257,"image":"i11731"},{"op":"text","speaker":"美希","text":"“苍可不行哦，我想要男女搭配的样本。”"},{"op":"image","layer":1,"image":"i13294"},{"op":"text","speaker":"白羽","text":"“唉唉？”"},{"op":"text","speaker":"","text":"就是说……"},{"op":"text","speaker":"","text":"这么一来就得从3个男性里选了。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":513,"image":"i12147"},{"op":"text","speaker":"良一","text":"“……”"},{"op":"image","layer":1,"image":"i15044"},{"op":"text","speaker":"天善","text":"“……”"},{"op":"text","speaker":"","text":"不知是不是错觉，我们3个男人间，蹦出了一丝紧张。"},{"op":"image","layer":7,"image":"i13321"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"白羽哆哆嗦嗦地举起手，伸出手指。而指尖正对的人是……"},{"op":"text","speaker":"羽依里","text":"“唉。”"},{"op":"text","speaker":"羽依里","text":"“我？”"},{"op":"image","layer":1,"image":"i13322"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"她轻轻地点了点头。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i516"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":0,"image":"i42"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“不过还真好啊。”"},{"op":"image","layer":1,"image":"i13274"},{"op":"text","speaker":"白羽","text":"“什么好？”"},{"op":"text","speaker":"羽依里","text":"“会为小孩举办这种试胆活动。”"},{"op":"text","speaker":"羽依里","text":"“这份心意，真令人羡慕。”"},{"op":"text","speaker":"羽依里","text":"“我家那里可没有这种东西。”"},{"op":"text","speaker":"羽依里","text":"“白羽你小时候也有这种活动吗？”"},{"op":"image","layer":1,"image":"i13280"},{"op":"text","speaker":"白羽","text":"“我想应该有，不过我没参加过。”"},{"op":"text","speaker":"羽依里","text":"“……是吗。”"},{"op":"text","speaker":"羽依里","text":"“那这次虽是确认安全，不过也算是补回一次参与了，不是挺好的吗。”"},{"op":"image","layer":1,"image":"i13259"},{"op":"text","speaker":"白羽","text":"“……唔。”"},{"op":"image","layer":1,"image":"i13253"},{"op":"text","speaker":"白羽","text":"“我也没那么想参与……”"},{"op":"text","speaker":"羽依里","text":"“是，是吗。”"},{"op":"text","speaker":"","text":"登登。"},{"op":"text","speaker":"羽依里","text":"“!؟”"},{"op":"text","speaker":"","text":"从树上掉下一个怪异的木乃伊。"},{"op":"text","speaker":"","text":"还搞了这种机关啊……"},{"op":"text","speaker":"","text":"虽然只是用绷带包着个人偶，不过突然出现的话，确实会吓一跳。"},{"op":"text","speaker":"","text":"看看白羽……"},{"op":"image","layer":1,"image":"i13373"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"image","layer":1,"image":"i13418"},{"op":"text","speaker":"白羽","text":"“……走吧。”"},{"op":"text","speaker":"","text":"很冷静地无视了。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i13"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":1,"image":"i13235"},{"op":"text","speaker":"白羽","text":"“到神社了。”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"image","layer":1,"image":"i13274"},{"op":"text","speaker":"羽依里","text":"“啊，零食在那。”"},{"op":"text","speaker":"羽依里","text":"“虽说是事前测试，也好好准备了啊。”"},{"op":"text","speaker":"羽依里","text":"“路线上应该没发现什么危险吧。”"},{"op":"image","layer":1,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“嗯。”"},{"op":"text","speaker":"","text":"阶梯有灯笼照明光亮充足，山路也基本都是宽阔平缓的。"},{"op":"text","speaker":"","text":"照这情况，应该不会有什么万一。"},{"op":"text","speaker":"","text":"不过，还是有些担心孩子被吓到哭着乱跑时的情况。"},{"op":"text","speaker":"","text":"白羽太过冷静，在这方面上完全无法参考。"},{"op":"text","speaker":"羽依里","text":"“你不怕黑的吧。”"},{"op":"image","layer":1,"image":"i13314"},{"op":"text","speaker":"白羽","text":"“唉？为什么这么说？”"},{"op":"text","speaker":"羽依里","text":"“毕竟你都敢夜里一个人到泳池游泳。”"},{"op":"image","layer":1,"image":"i13418"},{"op":"text","speaker":"白羽","text":"“因为我家那……本就没什么人烟。”"},{"op":"text","speaker":"","text":"以前去打扰时，的确是个离住宅区有些偏远的地方。"},{"op":"image","layer":1,"image":"i13370"},{"op":"text","speaker":"白羽","text":"“厕所也离得远。”"},{"op":"image","layer":1,"image":"i13373"},{"op":"text","speaker":"白羽","text":"“要是怕黑，根本就无法生活。”"},{"op":"text","speaker":"","text":"登登。"},{"op":"text","speaker":"","text":"又来了。"},{"op":"image","layer":1,"image":"i13373"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“你不怕吗？”"},{"op":"image","layer":1,"image":"i13418"},{"op":"text","speaker":"白羽","text":"“因为早有准备，既然是来试胆。”"},{"op":"text","speaker":"羽依里","text":"“是、是吗？”"},{"op":"text","speaker":"","text":"太冷静了。"},{"op":"text","speaker":"","text":"这很没劲吧，对准备机关的人来说。"},{"op":"text","speaker":"羽依里","text":"“我倒也不怕试胆活动。”"},{"op":"text","speaker":"羽依里","text":"“只不过山本身就让我有些怕。”"},{"op":"image","layer":1,"image":"i13274"},{"op":"text","speaker":"白羽","text":"“是吗？”"},{"op":"text","speaker":"羽依里","text":"“毕竟在山里出什么意外都不奇怪。”"},{"op":"image","layer":1,"image":"i13259"},{"op":"text","speaker":"白羽","text":"“？”"},{"op":"text","speaker":"羽依里","text":"“我一个朋友，跟我说过这么一件事。”"},{"op":"text","speaker":"羽依里","text":"“一支登山队遇到的，可怕的狸猫的事……”"},{"op":"image","layer":1,"image":"i13304"},{"op":"text","speaker":"白羽","text":"“狸，狸猫？”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i440"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"那是个世间罕见，狡猾而又残忍的狸猫的故事。"},{"op":"text","speaker":"","text":"在夜晚的山中悄悄混进登山队里，假扮队员摸其他人屁股，偷东西。"},{"op":"image","layer":0,"image":"i443"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"甚至，还会骗人爱情。"},{"op":"text","speaker":"","text":"心神疲惫的队员们变得疑神疑鬼，待下山时人际关系已被它推入谷底，真是可怕的狸猫。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i42"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"故事到此结束……"},{"op":"text","speaker":"","text":"而在我旁边的白羽，面色铁青。"},{"op":"text","speaker":"","text":"身体一晃，便倒向了我这边来。"},{"op":"text","speaker":"羽依里","text":"“!؟”"},{"op":"image","layer":0,"image":"i1086"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“白，白羽……？”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"白羽","text":"“狸……”"},{"op":"image","layer":0,"image":"i1088"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“狸猫太可怕了。”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"text","speaker":"白羽","text":"“简直阴险至极。”"},{"op":"text","speaker":"白羽","text":"“狸猫，太阴险了。”"},{"op":"text","speaker":"白羽","text":"“啊呜呜。”"},{"op":"text","speaker":"","text":"瑟瑟发抖中。"},{"op":"text","speaker":"","text":"完全被故事感染了。"},{"op":"text","speaker":"羽依里","text":"“那个。”"},{"op":"image","layer":0,"image":"i1087"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“都怪你说这种故事。”"},{"op":"text","speaker":"羽依里","text":"“黑暗你都不怕，却怕这种故事吗？”"},{"op":"text","speaker":"白羽","text":"“妖怪我不怕，但我怕野兽。”"},{"op":"text","speaker":"白羽","text":"“因为真的存在。”"},{"op":"text","speaker":"羽依里","text":"“这，这样啊。”"},{"op":"image","layer":0,"image":"i1088"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“呜呜呜呜。”"},{"op":"text","speaker":"白羽","text":"“好怕……”"},{"op":"image","layer":0,"image":"i1086"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“!؟”"},{"op":"text","speaker":"白羽","text":"“呜呜。”"},{"op":"text","speaker":"羽依里","text":"“你没事吧？”"},{"op":"image","layer":0,"image":"i1087"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"白羽","text":"“走……走不动路了……”"},{"op":"text","speaker":"羽依里","text":"“唉，唉唉？”"},{"op":"image","layer":0,"image":"i1088"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“腰吓软了。”"},{"op":"text","speaker":"白羽","text":"“呜呜。”"},{"op":"text","speaker":"白羽","text":"“好不甘心。”"},{"op":"image","layer":0,"image":"i1086"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“你算计我。”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"白羽","text":"“你算计我。”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"白羽","text":"“你算计我。”"},{"op":"text","speaker":"","text":"她虽生气，但似乎因为恐惧而不敢离开我。"},{"op":"text","speaker":"","text":"情况相当复杂。"},{"op":"text","speaker":"","text":"而这种状况下，我究竟该不该高兴呢……"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i86"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"历尽艰辛总算回到大家聚集的地方。"},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“哟。”"},{"op":"image","layer":257,"image":"i15038"},{"op":"image","layer":1,"image":"i12174"},{"op":"text","speaker":"天善","text":"“回来了啊……咦？”"},{"op":"text","speaker":"","text":"看到贴在我身上的白羽，其他人都瞪大了眼。"},{"op":"image","layer":1,"image":"i12159"},{"op":"text","speaker":"良一","text":"“噢噢。”"},{"op":"image","layer":513,"image":"i11718"},{"op":"text","speaker":"美希","text":"“想不到。”"},{"op":"text","speaker":"","text":"咚。"},{"op":"text","speaker":"","text":"白羽使劲将我推开。"},{"op":"image","layer":7,"image":"i13383"},{"op":"text","speaker":"白羽","text":"“呜。”"},{"op":"text","speaker":"","text":"然后就哭着，瘫坐在了地上。"},{"op":"image","layer":1,"image":"i11704"},{"op":"text","speaker":"美希","text":"“出了什么事？”"},{"op":"image","layer":7,"image":"i13383"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"白羽一言不发地指着我。"},{"op":"image","layer":7,"image":"i13380"},{"op":"text","speaker":"白羽","text":"“……野兽。”"},{"op":"image","layer":1,"image":"i11718"},{"op":"image","layer":257,"image":"i10218"},{"op":"text","speaker":"苍·美希","text":"“………”"},{"op":"image","layer":1,"image":"i11787"},{"op":"image","layer":257,"image":"i10386"},{"op":"text","speaker":"美希","text":"“送审问室。”"},{"op":"text","speaker":"苍","text":"“过来。”"},{"op":"text","speaker":"羽依里","text":"“误会啊。”"},{"op":"text","speaker":"","text":"可惜的就是好像也不算误会。"},{"op":"text","speaker":"羽依里","text":"“而且审问室是什么鬼地方啊؟؟”"},{"op":"image","layer":1,"image":"i11790"},{"op":"text","speaker":"美希","text":"“在小学那有这么一间房间。”"},{"op":"text","speaker":"羽依里","text":"“这岛上的小学太可怕了！”"},{"op":"text","speaker":"羽依里","text":"“不过，我有点想见识见识……”"},{"op":"image","layer":1,"image":"i11787"},{"op":"image","layer":257,"image":"i10367"},{"op":"text","speaker":"苍","text":"“!؟”"},{"op":"image","layer":1,"image":"i11793"},{"op":"text","speaker":"美希","text":"“把这变态抓起来。”"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]