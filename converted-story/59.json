[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"set","variable":7120,"value":1},{"op":"image","layer":0,"image":"i62"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15353"},{"op":"text","speaker":"羽未","text":"“怎么了？”"},{"op":"text","speaker":"","text":"看到遍体鳞伤的我，羽未也不禁瞪大了双眼。"},{"op":"text","speaker":"羽依里","text":"“我被抢了。”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“唔。”"},{"op":"text","speaker":"羽依里","text":"“你就不担心我一下？”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“大概是被野狗缠上了吧。”"},{"op":"text","speaker":"羽依里","text":"“哪怕真是这样，也很严重了啊。”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“对了，今天的晚饭。”"},{"op":"text","speaker":"羽依里","text":"“嗯。炒饭……？”"},{"op":"image","layer":1,"image":"i15579"},{"op":"text","speaker":"羽未","text":"“……算是吧。”"},{"op":"text","speaker":"羽依里","text":"“算是？”"},{"op":"image","layer":1,"image":"i15582"},{"op":"text","speaker":"羽未","text":"“这就是今天的晚饭。”"},{"op":"text","speaker":"羽依里","text":"“这是……”"},{"op":"text","speaker":"","text":"我又看了看餐桌上的炒饭。"},{"op":"text","speaker":"羽依里","text":"“这红色的炒饭是什么啊，鸡肉炒饭吗？”"},{"op":"image","layer":1,"image":"i15366"},{"op":"text","speaker":"羽未","text":"“辣椒炒饭。”"},{"op":"text","speaker":"羽依里","text":"“什么叫辣椒炒饭，不是泡菜炒饭吗？”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“泡菜里也放有辣椒。”"},{"op":"image","layer":1,"image":"i15360"},{"op":"text","speaker":"羽未","text":"“嘛，感觉应该差不多。”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"羽依里","text":"“把饭染得这么红你是用了多少辣椒啊？”"},{"op":"image","layer":1,"image":"i15582"},{"op":"text","speaker":"羽未","text":"“……就一点点。”"},{"op":"text","speaker":"羽依里","text":"“眼睛看着我说。”"},{"op":"image","layer":1,"image":"i15579"},{"op":"text","speaker":"羽未","text":"“只不过，是这岛的特产辣椒……”"},{"op":"image","layer":1,"image":"i15585"},{"op":"text","speaker":"羽未","text":"“据说还有个外号叫‘要命椒’。”"},{"op":"text","speaker":"羽依里","text":"“要命椒……”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“只放了一点就让饭红成这样吓死我了。”"},{"op":"text","speaker":"羽依里","text":"“的确吓人。”"},{"op":"image","layer":1,"image":"i15450"},{"op":"text","speaker":"羽未","text":"“请用吧。”"},{"op":"text","speaker":"羽依里","text":"“尝过了吗？”"},{"op":"image","layer":1,"image":"i15436"},{"op":"text","speaker":"羽未","text":"“请。”"},{"op":"text","speaker":"羽依里","text":"“哦，意思是让我来尝啊。”"},{"op":"image","layer":1,"image":"i15408"},{"op":"text","speaker":"羽未","text":"“别怕。”"},{"op":"text","speaker":"羽未","text":"“虽然看起来有点那个。”"},{"op":"image","layer":1,"image":"i15384"},{"op":"text","speaker":"羽未","text":"“但也是炒饭。”"},{"op":"image","layer":1,"image":"i15401"},{"op":"text","speaker":"羽未","text":"“炒饭是万能的。”"},{"op":"text","speaker":"羽依里","text":"“太危险了……”"},{"op":"text","speaker":"羽依里","text":"“不过。”"},{"op":"text","speaker":"羽依里","text":"“老实说我挺感兴趣的……”"},{"op":"text","speaker":"羽依里","text":"“而且我也不讨厌吃辣。”"},{"op":"image","layer":1,"image":"i15403"},{"op":"text","speaker":"羽未","text":"“我会帮你收尸的。”"},{"op":"text","speaker":"羽依里","text":"“那么。”"},{"op":"image","layer":1,"image":"i15579"},{"op":"text","speaker":"羽未","text":"“期待期待。”"},{"op":"text","speaker":"","text":"我战战兢兢地，吃进口中。"},{"op":"text","speaker":"羽依里","text":"“……唔。”"},{"op":"text","speaker":"","text":"辣倒是真的辣……"},{"op":"text","speaker":"","text":"不过，就是普通的辣而已。"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“怎么样……？”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“想不到，"},{"op":"text","speaker":"羽依里","text":"也就普通的"},{"op":"text","speaker":"羽依里","text":"嗷嗷嗷嗷嗷嗷嗷嗷嗷嗷嗷嗷嗷嗷！”"},{"op":"image","layer":1,"image":"i15353"},{"op":"text","speaker":"羽未","text":"“!؟”"},{"op":"image","layer":1,"image":"i15378"},{"op":"text","speaker":"羽未","text":"“的嗷嗷嗷嗷嗷嗷嗷嗷嗷？”"},{"op":"text","speaker":"羽依里","text":"“嗷嗷嗷嗷嗷嗷嗷嗷嗷嗷嗷嗷！”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“羽、羽依里哥？”"},{"op":"text","speaker":"羽依里","text":"“嗷，嗷嗷嗷。”"},{"op":"text","speaker":"羽依里","text":"“嗷嗷。”"},{"op":"image","layer":1,"image":"i15585"},{"op":"text","speaker":"羽未","text":"“不好了。羽依里哥只会说嗷了。”"},{"op":"text","speaker":"羽依里","text":"“嗷。”"},{"op":"text","speaker":"羽依里","text":"“嗷嗷嗷嗷……咳咳……哈啊哈啊。”"},{"op":"text","speaker":"羽依里","text":" “还以为要死了！” "},{"op":"image","layer":1,"image":"i15544"},{"op":"text","speaker":"羽未","text":"“嗷，结束了！”"},{"op":"text","speaker":"羽依里","text":"“一开始还觉得挺普通的。想不到打个时间差，突然就来火了。”"},{"op":"text","speaker":"羽依里","text":"“一点不夸张，眼前真的冒出了火花。”"},{"op":"text","speaker":"羽依里","text":"“该怎么说呢……仿佛被地狱业火烧着一般。”"},{"op":"text","speaker":"羽依里","text":"“……咦。”"},{"op":"text","speaker":"","text":"这不就是……"},{"op":"image","layer":1,"image":"i15468"},{"op":"text","speaker":"羽未","text":"“有什么问题吗？”"},{"op":"text","speaker":"羽依里","text":"“不，"},{"op":"text","speaker":"羽依里","text":"没什"},{"op":"text","speaker":"羽依里","text":"哞哞哞哞哞哞哞哞哞哞哞哞哞！”"},{"op":"image","layer":1,"image":"i15533"},{"op":"text","speaker":"羽未","text":"“!؟”"},{"op":"text","speaker":"羽依里","text":"“哞哞哞哞哞哞哞哞。”"},{"op":"image","layer":1,"image":"i15378"},{"op":"text","speaker":"羽未","text":"“变成哞哞哞哞哞了。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“虽然不太懂但好厉害。”"},{"op":"text","speaker":"羽依里","text":"“哞哞……哞。”"},{"op":"text","speaker":"羽依里","text":"“哞哞。”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“没事吧……？”"},{"op":"text","speaker":"羽依里","text":" “还以为要死了！” "},{"op":"image","layer":1,"image":"i15378"},{"op":"text","speaker":"羽未","text":"“结束了！”"},{"op":"text","speaker":"羽依里","text":"“又打时间差了！”"},{"op":"text","speaker":"羽依里","text":"“这辣椒到底是怎么回事啊。还带定时炸弹那样的辣劲。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“好厉害啊。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“真期待下次会是什么样的。”"},{"op":"text","speaker":"羽依里","text":"“饶了我吧。”"},{"op":"text","speaker":"羽依里","text":"“总之，先喝杯水噢噢噢噢噢噢噢噢噢噢噢噢。”"},{"op":"image","layer":1,"image":"i15511"},{"op":"text","speaker":"羽未","text":"“噢噢噢噢噢噢噢。”"},{"op":"return"},{"op":"end"}]