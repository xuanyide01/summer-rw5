[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i21"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“有人吗。”"},{"op":"image","layer":7,"image":"i15136"},{"op":"text","speaker":"天善","text":"“嘿！嘿！嘿！嘿！”"},{"op":"text","speaker":"","text":"跟往常一样，天善正在特训（？）中。"},{"op":"image","layer":7,"image":"i15136"},{"op":"text","speaker":"天善","text":"“嘿！嘿！嘿！嘿！”"},{"op":"text","speaker":"","text":"看到他只是在做普通的锻炼，就有种莫名的安心感。"},{"op":"text","speaker":"","text":"说来……"},{"op":"text","speaker":"羽依里","text":"“话说四天王深蹲是什么啊？”"},{"op":"text","speaker":"","text":"之前好像听到过这个奇异的词。"},{"op":"image","layer":1,"image":"i15038"},{"op":"text","speaker":"天善","text":"“想知道吗？”"},{"op":"text","speaker":"羽依里","text":"“……有点想又有点无所谓。”"},{"op":"image","layer":1,"image":"i15166"},{"op":"text","speaker":"天善","text":"“那，我们就开始吧。”"},{"op":"text","speaker":"羽依里","text":"“为什么要脱衣服!؟”"},{"op":"image","layer":257,"image":"i12054"},{"op":"text","speaker":"良一","text":"“四神相应！”"},{"op":"text","speaker":"羽依里","text":"“!؟你从哪冒出来的!؟”"},{"op":"text","speaker":"羽依里","text":"“什，什么意思？四相？”"},{"op":"image","layer":257,"image":"i12009"},{"op":"text","speaker":"良一","text":"“先别纠结这种小事了，来围成圈。”"},{"op":"text","speaker":"羽依里","text":"“哦，哦。”"},{"op":"image","layer":1,"image":"i15178"},{"op":"text","speaker":"天善","text":"“玄武！”"},{"op":"image","layer":257,"image":"i12058"},{"op":"text","speaker":"良一","text":"“玄玄！”"},{"op":"image","layer":257,"image":"i12060"},{"op":"text","speaker":"良一","text":"“青龙！”"},{"op":"image","layer":1,"image":"i15181"},{"op":"text","speaker":"天善","text":"“青青！”"},{"op":"image","layer":1,"image":"i15185"},{"op":"text","speaker":"天善","text":"“朱雀！”"},{"op":"text","speaker":"德田","text":"“雀雀！”"},{"op":"text","speaker":"德田","text":"“白虎！”"},{"op":"text","speaker":"羽依里","text":"“……唉？”"},{"op":"image","layer":1,"image":"i15178"},{"op":"image","layer":257,"image":"i12046"},{"op":"text","speaker":"德田","text":"“白虎！”"},{"op":"text","speaker":"羽依里","text":"“白白……？”"},{"op":"image","layer":1,"image":"i15172"},{"op":"image","layer":257,"image":"i12009"},{"op":"text","speaker":"天善","text":"“对！”"},{"op":"text","speaker":"","text":"对了!؟"},{"op":"text","speaker":"羽依里","text":"“什，什么啊？”"},{"op":"image","layer":1,"image":"i15173"},{"op":"text","speaker":"天善","text":"“4个人围着站好喊出四神相应中的某个位置，然后指向某人。”"},{"op":"text","speaker":"天善","text":"“被指的人，要喊出与神名对应的口号同时做深蹲。”"},{"op":"image","layer":1,"image":"i15179"},{"op":"text","speaker":"天善","text":"“就是这种特训！”"},{"op":"text","speaker":"羽依里","text":"“是，是吗？”"},{"op":"image","layer":257,"image":"i12036"},{"op":"text","speaker":"良一","text":"“在这座岛上可出名了。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i158"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":7,"image":"i15187"},{"op":"text","speaker":"天善","text":"“玄武！”"},{"op":"image","layer":7,"image":"i12057"},{"op":"image","layer":6,"image":"i25241"},{"op":"text","speaker":"良一","text":"“玄玄！”"},{"op":"image","layer":7,"image":"i12048"},{"op":"image","layer":6,"image":"i25241"},{"op":"text","speaker":"良一","text":"“青龙！”"},{"op":"image","layer":7,"image":"i15180"},{"op":"clear","layer":6},{"op":"text","speaker":"天善","text":"“青青！”"},{"op":"image","layer":7,"image":"i15184"},{"op":"text","speaker":"天善","text":"“朱雀！”"},{"op":"text","speaker":"德田","text":"“雀雀！”"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i21"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“哈啊……哈啊……”"},{"op":"image","layer":1,"image":"i15159"},{"op":"text","speaker":"天善","text":"“挺累的吧。”"},{"op":"text","speaker":"羽依里","text":"“虽然身体也累，但真累得受不了的是脑子。”"},{"op":"image","layer":1,"image":"i15160"},{"op":"text","speaker":"天善","text":"“这就是四天王深蹲的精髓。”"},{"op":"text","speaker":"羽依里","text":"“我说做这深蹲时，是不是多了个人？”"},{"op":"image","layer":1,"image":"i15157"},{"op":"text","speaker":"天善","text":"“是德田。”"},{"op":"text","speaker":"羽依里","text":"“他怎么就若无其事地掺进来了？”"},{"op":"image","layer":257,"image":"i12006"},{"op":"text","speaker":"良一","text":"“说起来搬乒乓球台的时候，他也自然而然地帮了我们一把。”"},{"op":"text","speaker":"羽依里","text":"“然后一言不发地离去了。”"},{"op":"image","layer":1,"image":"i15159"},{"op":"text","speaker":"天善","text":"“德田他虽然自尊心强，但也很容易害羞。”"},{"op":"image","layer":257,"image":"i12009"},{"op":"text","speaker":"良一","text":"“偶尔会到这里来，若无其事地逛一圈又回去。”"},{"op":"image","layer":257,"image":"i12036"},{"op":"text","speaker":"良一","text":"“从小就是个连‘一起玩’都说不出口的家伙。”"},{"op":"text","speaker":"羽依里","text":"“这么容易害羞啊。”"},{"op":"image","layer":1,"image":"i15160"},{"op":"text","speaker":"天善","text":"“嗯，很容易害羞。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"倒是你是不是该有点廉耻……"},{"op":"set","variable":7120,"value":1},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":2,"image":"i747"},{"op":"image","layer":0,"image":"i514"},{"op":"set","variable":6714,"value":4},{"op":"set","variable":7120,"value":2},{"op":"clear","layer":2},{"op":"image","layer":256,"image":"i516"},{"op":"set","variable":6714,"value":1},{"op":"clear","layer":256},{"op":"image","layer":0,"image":"i75"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“累死了……”"},{"op":"text","speaker":"","text":"最后，我陪他们一直练到了太阳下山。"},{"op":"text","speaker":"","text":"练到一半时，不知脑内分泌出什么奇怪的物质就停不下来了。"},{"op":"text","speaker":"","text":"真是可怕，四天王深蹲。"},{"op":"text","speaker":"羽依里","text":"“……呼。”"},{"op":"text","speaker":"","text":"……睡吧。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"……"},{"op":"image","layer":0,"image":"i75"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"就在即将陷入梦乡时……我忽然，睁开了双眼。"},{"op":"text","speaker":"","text":"不知道是从什么时候开始。"},{"op":"text","speaker":"","text":"我已经不会在睡前胡思乱想了。"},{"op":"text","speaker":"","text":"总会怀着一天积累下来的疲惫，自然而然地进入梦乡。"},{"op":"text","speaker":"","text":"这样的每一天既让我感到安心，又有一丝挥之不去的不适感。"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"这一晚，我做了个梦。"},{"op":"text","speaker":"","text":"在老家的梦。"},{"op":"text","speaker":"","text":"在那熟悉，却又莫名生分的景色中，我不停地走着。"},{"op":"text","speaker":"","text":"在举目无人的城市中……我就像是要逃离什么一般，从城市一角向着另一角，不停地走着。"},{"op":"text","speaker":"","text":"最终来到广阔的大海前。"},{"op":"text","speaker":"","text":"然后就再也无法前进。"},{"op":"text","speaker":"","text":"我呆呆地眺望着大海。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]