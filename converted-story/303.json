[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i431"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"今天夜里格外漆黑。"},{"op":"text","speaker":"","text":"我一个人站在家门前。"},{"op":"text","speaker":"","text":"四周没有人影。"},{"op":"text","speaker":"","text":"正这么想着的时候……"},{"op":"image","layer":0,"image":"i30"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"text","speaker":"","text":"听到有人朝我这里跑来的脚步声。"},{"op":"text","speaker":"","text":"我看向那个方向。"},{"op":"text","speaker":"","text":"是野美希。"},{"op":"text","speaker":"","text":"她满脸笑容地朝我跑来。"},{"op":"text","speaker":"羽依里","text":"“野美希――”"},{"op":"image","layer":1,"image":"i11696"},{"op":"text","speaker":"美希","text":"“鹰原！”"},{"op":"image","layer":1,"image":"i11691"},{"op":"text","speaker":"","text":"野美希转眼间就跑到了我身边，并向我扑了过来。"},{"op":"text","speaker":"羽依里","text":"“哇啊!؟”"},{"op":"text","speaker":"","text":"顺势紧紧地抱住了我的脖子。"},{"op":"text","speaker":"","text":"然后……"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i1545"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"美希","text":"“唔啾～！”"},{"op":"text","speaker":"","text":"她就直接带着刚才的势头，热烈地吻了上来。"},{"op":"text","speaker":"羽依里","text":"“唔呼啊!؟野、野美希？”"},{"op":"text","speaker":"美希","text":"“鹰原，今天也要多多亲亲哦。”"},{"op":"text","speaker":"美希","text":"“唔啾～！”"},{"op":"text","speaker":"羽依里","text":"“唔唔唔唔!؟”"},{"op":"text","speaker":"","text":"野美希接连不断地亲吻着我，甚至多说几句话都像是浪费时间。"},{"op":"set","variable":7120,"value":2},{"op":"set","variable":6714,"value":1},{"op":"image","layer":7,"image":"i11565"},{"op":"text","speaker":"镜子","text":"“哎呀哎呀。”"},{"op":"image","layer":0,"image":"i30"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":257,"image":"i11566"},{"op":"text","speaker":"羽依里","text":"“呼啊！镜、镜子阿姨！”"},{"op":"image","layer":257,"image":"i11574"},{"op":"text","speaker":"镜子","text":"“这里明明是家门口……”"},{"op":"text","speaker":"羽依里","text":"“求你不要给家长打电话！”"},{"op":"image","layer":257,"image":"i11584"},{"op":"text","speaker":"镜子","text":"“你们两个还真是激情呢～”"},{"op":"image","layer":1,"image":"i11689"},{"op":"text","speaker":"美希","text":"“谢谢夸奖。”"},{"op":"text","speaker":"羽依里","text":"“……你说什么？”"},{"op":"text","speaker":"","text":"镜子阿姨说了奇怪的话。"},{"op":"text","speaker":"","text":"这、这到底是……？"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i35"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"因为被镜子阿姨的反应吓到了，我像逃跑一样离开了家门前。"},{"op":"text","speaker":"","text":"然后就这样，直接出发去巡逻了。"},{"op":"image","layer":1,"image":"i11831"},{"op":"text","speaker":"美希","text":"“对了，鹰原。”"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i1546"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"美希","text":"“唔啾～”"},{"op":"text","speaker":"羽依里","text":"“!!؟”"},{"op":"text","speaker":"","text":"一回头就被亲了。"},{"op":"text","speaker":"羽依里","text":"“唔唔唔？唔唔～؟؟”"},{"op":"text","speaker":"","text":"而且还是在这种人来人往的地方！"},{"op":"set","variable":7120,"value":2},{"op":"set","variable":6714,"value":1},{"op":"image","layer":7,"image":"i12161"},{"op":"text","speaker":"良一","text":"“哦，今天也很亲热啊～”"},{"op":"image","layer":7,"image":"i15028"},{"op":"text","speaker":"天善","text":"“情深意浓可真是美好啊，哈哈哈。”"},{"op":"image","layer":0,"image":"i35"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":1,"image":"i15011"},{"op":"image","layer":257,"image":"i12162"},{"op":"text","speaker":"羽依里","text":"“呼啊！良、良……！天天天天！”"},{"op":"text","speaker":"","text":"被看到了不得了的场面！"},{"op":"text","speaker":"","text":"但是，他们两个都颇为欣慰地看着我们。"},{"op":"image","layer":257,"image":"i12144"},{"op":"text","speaker":"良一","text":"“羽依里。”"},{"op":"text","speaker":"羽依里","text":"“是、是。”"},{"op":"image","layer":257,"image":"i12193"},{"op":"text","speaker":"良一","text":"“Nice Kiss！”"},{"op":"image","layer":1,"image":"i15143"},{"op":"text","speaker":"天善","text":"“Nice Kiss！”"},{"op":"text","speaker":"","text":"两个人冲我们竖了下大拇指，然后就离开了。"},{"op":"image","layer":1,"image":"i11689"},{"op":"text","speaker":"美希","text":"“呵呵，被夸奖了呢。”"},{"op":"text","speaker":"羽依里","text":"“等、等一下，野美希！”"},{"op":"image","layer":1,"image":"i11731"},{"op":"text","speaker":"美希","text":"“怎么了？”"},{"op":"text","speaker":"羽依里","text":"“为什么要亲……亲我这么多次啊？”"},{"op":"image","layer":1,"image":"i11709"},{"op":"text","speaker":"美希","text":"“嗯？我的吻今天有什么问题吗？”"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“我感觉跟平时一模一样啊。”"},{"op":"text","speaker":"羽依里","text":"“平时？”"},{"op":"image","layer":1,"image":"i11696"},{"op":"text","speaker":"美希","text":"“我们不是每天都会亲亲的吗？”"},{"op":"text","speaker":"羽依里","text":"“啊!؟每天!؟”"},{"op":"image","layer":1,"image":"i11689"},{"op":"text","speaker":"美希","text":"“以我们的关系，亲亲是理所当然的事吧。”"},{"op":"text","speaker":"羽依里","text":"“啊……也、也就是说我们是情侣？”"},{"op":"image","layer":1,"image":"i11724"},{"op":"text","speaker":"美希","text":"“才、才、才不是那种不知廉耻的关系！”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"","text":"不是情侣却把亲吻当做理所当然的是什么关系啊？"},{"op":"image","layer":1,"image":"i11731"},{"op":"text","speaker":"美希","text":"“鹰原，你今天不想亲亲吗？”"},{"op":"text","speaker":"羽依里","text":"“不，也不是那个意思……”"},{"op":"text","speaker":"","text":"我当然不可能嫌弃野美希的吻。"},{"op":"text","speaker":"","text":"不如说是求之不得。"},{"op":"image","layer":1,"image":"i11696"},{"op":"text","speaker":"美希","text":"“好，那就来确认一下吧。”"},{"op":"text","speaker":"羽依里","text":"“啊？确认――……”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i1546"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"美希","text":"“唔啾～！”"},{"op":"text","speaker":"羽依里","text":"“嗯噗……!؟”"},{"op":"text","speaker":"","text":"她又一次堵住了我的嘴唇。"},{"op":"text","speaker":"","text":"像是在压迫，又像是在啄食。"},{"op":"text","speaker":"","text":"总之就是一阵热烈的亲吻狂潮。"},{"op":"text","speaker":"","text":"简直是到了泛滥的地步。"},{"op":"text","speaker":"","text":"难道这里是接吻的天堂吗？"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i10"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"野美希的亲亲是字面意义上的不分场合。"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“鹰原。”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i1547"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"美希","text":"“唔啾～！”"},{"op":"text","speaker":"羽依里","text":"“嗯～～～～!؟”"},{"op":"set","variable":7120,"value":2},{"op":"set","variable":6714,"value":1},{"op":"image","layer":7,"image":"i10117"},{"op":"text","speaker":"苍","text":"“嗯？”"},{"op":"image","layer":7,"image":"i10114"},{"op":"text","speaker":"苍","text":"“你们两个今天也很亲热呢～”"},{"op":"text","speaker":"","text":"看到我们接吻，苍只是温和地笑着。"},{"op":"text","speaker":"","text":"她并没有被带入粉红色的思维，而是很自然地接受了。"},{"op":"image","layer":0,"image":"i10"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":1,"image":"i10154"},{"op":"text","speaker":"苍","text":"“野美希也是，每天都很厉害呢。”"},{"op":"image","layer":1,"image":"i10394"},{"op":"text","speaker":"苍","text":"“Nice Kiss。”"},{"op":"image","layer":257,"image":"i11696"},{"op":"text","speaker":"美希","text":"“嗯，因为想亲亲的时候就不应该忍耐。”"},{"op":"image","layer":1,"image":"i10276"},{"op":"text","speaker":"苍","text":"“嗯嗯，野美希真的很厉害哦。”"},{"op":"image","layer":257,"image":"i11689"},{"op":"text","speaker":"美希","text":"“呵呵，鹰原，我被夸了哦。”"},{"op":"text","speaker":"羽依里","text":"“啊，嗯，那太好了。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i5"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"在港口也是如此。"},{"op":"image","layer":1,"image":"i11696"},{"op":"text","speaker":"美希","text":"“鹰原，来亲亲。”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i1548"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"美希","text":"“唔啾～！”"},{"op":"text","speaker":"羽依里","text":"“嗯――――!؟”"},{"op":"text","speaker":"渔夫A","text":"“哦，今天也在亲热啊。”"},{"op":"text","speaker":"渔夫B","text":"“照这么看今天肯定能大丰收，干脆再出一次船吧。”"},{"op":"text","speaker":"","text":"我们的接吻难道是什么幸运物品吗？"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i50"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"在海滩上也是。"},{"op":"image","layer":1,"image":"i11831"},{"op":"text","speaker":"美希","text":"“鹰原。”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i1549"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"美希","text":"“唔啾～！”"},{"op":"text","speaker":"羽依里","text":"“嗯――――!؟”"},{"op":"set","variable":7120,"value":2},{"op":"set","variable":6714,"value":1},{"op":"image","layer":7,"image":"i13086"},{"op":"text","speaker":"白羽","text":"“…………”"},{"op":"text","speaker":"","text":"白、白羽!؟"},{"op":"text","speaker":"","text":"在白羽面前这样是不是真的不太好……"},{"op":"image","layer":7,"image":"i13132"},{"op":"text","speaker":"白羽","text":"“Nice Kiss。”"},{"op":"text","speaker":"羽依里","text":"“!!؟”"},{"op":"text","speaker":"","text":"连白羽都竖起大拇指为我们加油。"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i1550"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"美希","text":"“唔啾～！”"},{"op":"text","speaker":"羽依里","text":"“嗯～～～～～～～!؟”"},{"op":"text","speaker":"食堂的大叔","text":"“你们的接吻看上去比我家套餐还要美味呢，真是了不起。”"},{"op":"text","speaker":"","text":"这是在夸我们吗!؟"},{"op":"image","layer":0,"image":"i170"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"就是这样，我整整一天都在被野美希亲亲。"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i39"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“哈啊，这下真的是亲累了。”"},{"op":"text","speaker":"","text":"我做梦也没想到，人生中居然会有接吻接到累的一天。"},{"op":"text","speaker":"","text":"接吻都已经像呼吸一样自然了。"},{"op":"image","layer":1,"image":"i11831"},{"op":"text","speaker":"美希","text":"“呵呵，好开心啊，鹰原。”"},{"op":"image","layer":1,"image":"i11829"},{"op":"text","speaker":"美希","text":"“想亲的时候随时都可以亲到。”"},{"op":"image","layer":1,"image":"i11826"},{"op":"text","speaker":"美希","text":"“没有比这更美好的事情了。”"},{"op":"text","speaker":"","text":"野美希开心地露出了微笑。"},{"op":"text","speaker":"","text":"虽然不知道为什么会变成这样，但能看到她这样的笑容也不是坏事。"},{"op":"text","speaker":"羽依里","text":"“野美希。”"},{"op":"image","layer":1,"image":"i11731"},{"op":"text","speaker":"美希","text":"“怎么了？”"},{"op":"image","layer":1,"image":"i11732"},{"op":"text","speaker":"","text":"我向前迈了一步，想要亲吻野美希。"},{"op":"text","speaker":"","text":"仔细想想我一直都在被亲，还从来没有主动亲过她呢。"},{"op":"image","layer":1,"image":"i11701"},{"op":"text","speaker":"美希","text":"“你要干什么!؟”"},{"op":"text","speaker":"","text":"被拒绝了。"},{"op":"text","speaker":"羽依里","text":"“啊？为什么？”"},{"op":"image","layer":1,"image":"i11755"},{"op":"text","speaker":"美希","text":"“唉……鹰原真是没有节操啊。”"},{"op":"text","speaker":"羽依里","text":"“你有资格说这话吗？”"},{"op":"text","speaker":"","text":"主动亲我可以，被我亲就不行，这是什么道理？"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“好了，天马上就要黑了。”"},{"op":"text","speaker":"羽依里","text":"“哎？天黑……”"},{"op":"text","speaker":"","text":"明明从一开始就是黑的……"},{"op":"image","layer":1,"image":"i11693"},{"op":"text","speaker":"美希","text":"“今天就到此为止吧。”"},{"op":"text","speaker":"羽依里","text":"“啊……等等，野美希？”"},{"op":"image","layer":1,"image":"i11829"},{"op":"text","speaker":"美希","text":"“我要回家了。”"},{"op":"image","layer":1,"image":"i11831"},{"op":"text","speaker":"美希","text":"“也想告诉一下――”"},{"op":"text","speaker":"","text":"每次都是这样，没听清她最后说了什么――"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":1539},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"视野逐渐变得明亮耀眼起来。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]