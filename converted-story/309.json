[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"if","truth":false,"target":5,"value":["==",["v",6003],1]},{"op":"callScene","scene":311,"target":2},{"op":"goto","target":105},{"op":"if","truth":false,"target":8,"value":["==",["v",6003],2]},{"op":"callScene","scene":310,"target":2},{"op":"goto","target":105},{"op":"set","variable":1,"value":0},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"text","speaker":"羽依里","text":"“嗯……”"},{"op":"text","speaker":"","text":"好刺眼。"},{"op":"text","speaker":"","text":"这刺眼的光芒太过晃眼，害得我睁不开眼皮。"},{"op":"image","layer":7,"image":"i15377"},{"op":"text","speaker":"羽未","text":"“鹰原哥！”"},{"op":"text","speaker":"","text":"听到了声音。不是野美希的声音。是羽未吗……？"},{"op":"text","speaker":"羽依里","text":"“唔唔……”"},{"op":"image","layer":0,"image":"i69"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15378"},{"op":"text","speaker":"","text":"这时我终于睁开了眼睛。"},{"op":"text","speaker":"","text":"想要坐起身来，但全身各处都在嘎吱作响般疼痛，根本起不来床。"},{"op":"text","speaker":"羽依里","text":"“羽……未……？”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“鹰原哥，能认出我吗？”"},{"op":"text","speaker":"","text":"羽未以一副十分担心的表情盯着我看。"},{"op":"text","speaker":"","text":"我对她点了下头。"},{"op":"image","layer":1,"image":"i15340"},{"op":"text","speaker":"羽未","text":"“太好了……”"},{"op":"image","layer":1,"image":"i15378"},{"op":"text","speaker":"羽未","text":"“啊！对了！”"},{"op":"image","layer":1,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“镜子阿姨――――！鹰原哥他醒了――――!!”"},{"op":"text","speaker":"","text":"羽未大声喊道。"},{"op":"text","speaker":"","text":"随后，镜子阿姨便急匆匆地跑了过来。"},{"op":"image","layer":257,"image":"i11617"},{"op":"text","speaker":"镜子","text":"“哎呀哎呀，不得了！”"},{"op":"image","layer":257,"image":"i11563"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"镜子","text":"“羽依里，你醒了吗？没事吧？”"},{"op":"text","speaker":"羽依里","text":"“我没事。”"},{"op":"text","speaker":"","text":"强撑着疼痛的身体，我终于坐了起来。"},{"op":"text","speaker":"羽依里","text":"“说起来，我到底是……”"},{"op":"text","speaker":"","text":"完全没搞懂现在的状况。"},{"op":"text","speaker":"","text":"为什么羽未和镜子阿姨都这么惊慌失措呢？"},{"op":"text","speaker":"","text":"记忆有些模糊。"},{"op":"text","speaker":"","text":"环顾房间。像是晨光的光线透进了室内，房间里很明亮。"},{"op":"text","speaker":"","text":"看来这里是现实。"},{"op":"text","speaker":"","text":"对了，直到刚才我一直都在做梦。"},{"op":"image","layer":257,"image":"i11574"},{"op":"text","speaker":"镜子","text":"“羽依里，你整整睡了一天多啊。”"},{"op":"text","speaker":"羽依里","text":"“啊？整整一天多……？”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“今天是8月19号。”"},{"op":"text","speaker":"羽依里","text":"“不会吧，别开玩笑了。”"},{"op":"text","speaker":"羽依里","text":"“你们两个是想跟刚刚睡醒的我整蛊……吧……”"},{"op":"text","speaker":"","text":"我想活跃一下气氛，但看到镜子阿姨和羽未的模样和表情，话说到一半我就闭上了嘴。"},{"op":"text","speaker":"羽依里","text":"“抱歉，好像让你们担心了……”"},{"op":"text","speaker":"羽依里","text":"“可是，为什么我会睡整整一天呢……”"},{"op":"image","layer":1,"image":"i15360"},{"op":"text","speaker":"羽未","text":"“这个问题我才想问呢。到底发生什么事了？”"},{"op":"image","layer":257,"image":"i11614"},{"op":"text","speaker":"镜子","text":"“是不是吃了什么奇怪的东西？”"},{"op":"image","layer":257,"image":"i11626"},{"op":"text","speaker":"镜子","text":"“有没有哪里疼或者不舒服？”"},{"op":"text","speaker":"羽依里","text":"“不，完全没有。啊，就是身体各个关节有点疼。”"},{"op":"image","layer":257,"image":"i11571"},{"op":"text","speaker":"镜子","text":"“那是因为一直睡着没动弹的缘故。”"},{"op":"text","speaker":"羽依里","text":"“看来睡太久对身体也不好啊……”"},{"op":"image","layer":257,"image":"i11546"},{"op":"text","speaker":"镜子","text":"“总之，你醒过来就好。”"},{"op":"image","layer":1,"image":"i15340"},{"op":"text","speaker":"羽未","text":"“晃了你好几次，结果都没醒过来。”"},{"op":"text","speaker":"羽依里","text":"“我居然睡得这么沉啊。”"},{"op":"text","speaker":"","text":"还以为人只有在浅睡眠的时候才会做梦呢。"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“偶尔还会说些梦话呢。”"},{"op":"image","layer":257,"image":"i11581"},{"op":"text","speaker":"羽依里","text":"“梦话？”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"羽依里","text":"“说、说了些什么梦话？”"},{"op":"text","speaker":"","text":"我战战兢兢地问道。"},{"op":"image","layer":1,"image":"i15369"},{"op":"text","speaker":"羽未","text":"“嗯……”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“唔啾～……之类的？”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"image","layer":257,"image":"i11584"},{"op":"text","speaker":"镜子","text":"“还有，啊嗯～之类的。”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“还说什么快来啊，你是要去哪里呢？”"},{"op":"image","layer":257,"image":"i11549"},{"op":"text","speaker":"镜子","text":"“这对羽未来说还为时尚早。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“嗯哎？”"},{"op":"image","layer":257,"image":"i11629"},{"op":"text","speaker":"镜子","text":"“这就是青春哦。”"},{"op":"image","layer":1,"image":"i15381"},{"op":"text","speaker":"羽未","text":"“哦，原来是青春期啊。”"},{"op":"text","speaker":"羽依里","text":"“啊啊啊啊啊啊啊啊……！”"},{"op":"text","speaker":"","text":"我抱着头在绝望中打滚。"},{"op":"image","layer":1,"image":"i11566"},{"op":"text","speaker":"镜子","text":"“啊，不可以哦。不能这样突然乱动。”"},{"op":"text","speaker":"羽依里","text":"“可是……可是！”"},{"op":"text","speaker":"羽依里","text":"“呜呜，说了那么羞耻的梦话……”"},{"op":"image","layer":1,"image":"i11581"},{"op":"text","speaker":"镜子","text":"“总之今天一整天都要静养，观察一下情况。”"},{"op":"text","speaker":"羽依里","text":"“我不想待在家里……想去遥远的地方……”"},{"op":"image","layer":1,"image":"i11574"},{"op":"text","speaker":"镜子","text":"“不行，今天必须静养。”"},{"op":"text","speaker":"羽依里","text":"“好吧……”"},{"op":"text","speaker":"","text":"没办法，就当是一种修行吧。"},{"op":"text","speaker":"","text":"这样想着，打算反思一下不知廉耻的自己。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i69"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i12165"},{"op":"text","speaker":"良一","text":"“哈喽～我们来探望咯～”"},{"op":"image","layer":257,"image":"i15011"},{"op":"text","speaker":"天善","text":"“听说你整整一天都起不来床，没事吧？”"},{"op":"text","speaker":"","text":"到了下午，良一和天善来探望我了。"},{"op":"text","speaker":"羽依里","text":"“该说是起不来，还是一直在睡呢。”"},{"op":"text","speaker":"羽依里","text":"“连我自己也搞不太清楚。”"},{"op":"image","layer":1,"image":"i12159"},{"op":"text","speaker":"良一","text":"“哎呀，那说明肯定做了个美梦对吧？”"},{"op":"text","speaker":"羽依里","text":"“啊？”"},{"op":"image","layer":257,"image":"i15014"},{"op":"text","speaker":"天善","text":"“听说你做了个相当不要脸的梦啊。”"},{"op":"text","speaker":"羽依里","text":"“!!!!؟”"},{"op":"text","speaker":"羽依里","text":"“什……”"},{"op":"text","speaker":"羽依里","text":"“你们在说……什么啊……？”"},{"op":"text","speaker":"","text":"我把视线移向地板，身体止不住地颤抖。"},{"op":"image","layer":257,"image":"i15011"},{"op":"text","speaker":"天善","text":"“毕竟这里是座小岛。”"},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“可别小看岛上的情报网啊。”"},{"op":"text","speaker":"羽依里","text":"“镜子阿姨啊啊啊――――！”"},{"op":"image","layer":257,"image":"i15014"},{"op":"text","speaker":"天善","text":"“不，是羽未说的。”"},{"op":"text","speaker":"羽依里","text":" “羽未啊啊啊――――!!” "},{"op":"text","speaker":"羽依里","text":"“啊……我再也见不到外面的太阳了……”"},{"op":"text","speaker":"","text":"就该一直躲在梦里不出来的。"},{"op":"image","layer":257,"image":"i15008"},{"op":"text","speaker":"天善","text":"“不过，连着24小时以上没睡醒可不是什么正常现象。”"},{"op":"image","layer":1,"image":"i12171"},{"op":"text","speaker":"良一","text":"“是啊。就算是我，最多也就睡过18小时。”"},{"op":"text","speaker":"羽依里","text":"“那也够厉害的了。”"},{"op":"image","layer":513,"image":"i10203"},{"op":"text","speaker":"苍","text":"“咦，你们也来了啊？”"},{"op":"text","speaker":"","text":"苍也来看我了。"},{"op":"image","layer":1,"image":"i11712"},{"op":"text","speaker":"美希","text":"“鹰……鹰原，你没事吧？”"},{"op":"text","speaker":"","text":"然后，野美希也――……"},{"op":"text","speaker":"","text":"我感觉脸上一阵发烫。"},{"op":"text","speaker":"羽依里","text":"“啊，嗯，没事……的，多谢关心。”"},{"op":"image","layer":1,"image":"i11731"},{"op":"text","speaker":"美希","text":"“怎么突然这么客气？”"},{"op":"text","speaker":"","text":"野美希的脸上带着几分歉意。"},{"op":"text","speaker":"羽依里","text":"“不，请不要在意……”"},{"op":"image","layer":1,"image":"i11709"},{"op":"text","speaker":"美希","text":"“是吗？”"},{"op":"image","layer":1,"image":"i11712"},{"op":"text","speaker":"美希","text":"“不过，听说你睡了整整一天都没醒……”"},{"op":"image","layer":1,"image":"i11721"},{"op":"text","speaker":"美希","text":"“那个……”"},{"op":"image","layer":1,"image":"i11701"},{"op":"text","speaker":"美希","text":"“对不起。”"},{"op":"text","speaker":"羽依里","text":"“啊？为什么你要道歉？”"},{"op":"image","layer":1,"image":"i11712"},{"op":"text","speaker":"美希","text":"“本来你作为客人，应该让你好好享受一下岛上生活的……”"},{"op":"image","layer":1,"image":"i11721"},{"op":"text","speaker":"美希","text":"“却因为我的原因，让你帮忙少年团的工作。”"},{"op":"text","speaker":"美希","text":"“让你太过勉强自己了……”"},{"op":"image","layer":1,"image":"i11712"},{"op":"text","speaker":"美希","text":"“真的非常抱歉……”"},{"op":"text","speaker":"羽依里","text":"“等等，我并没有觉得勉强。”"},{"op":"text","speaker":"羽依里","text":"“而且，我也很享受少年团的工作。”"},{"op":"image","layer":1,"image":"i11740"},{"op":"text","speaker":"美希","text":"“是、是吗？”"},{"op":"image","layer":1,"image":"i11689"},{"op":"text","speaker":"美希","text":"“那样的话，我也放心了一些。”"},{"op":"text","speaker":"","text":"野美希这才露出了笑容。"},{"op":"text","speaker":"","text":"看到她的笑容，我也松了一口气。"},{"op":"text","speaker":"","text":"但与此同时，我想到了一件令人毛骨悚然的事。"},{"op":"text","speaker":"","text":"我……我那些羞耻的梦话……不会也传到野美希耳朵里了吧？"},{"op":"clear","layer":0},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"image","layer":0,"image":"i257"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i10277"},{"op":"text","speaker":"苍","text":"“放心吧。”"},{"op":"text","speaker":"","text":"苍注意到了我的焦虑。"},{"op":"text","speaker":"","text":"她轻声对我耳语道。"},{"op":"image","layer":1,"image":"i10395"},{"op":"text","speaker":"苍","text":"“你那些羞人的梦话，我都帮你糊弄过去了哦。”"},{"op":"text","speaker":"羽依里","text":"“苍……你是天使吗？”"},{"op":"image","layer":1,"image":"i10390"},{"op":"text","speaker":"苍","text":"“哼哼，以后记得感谢我啊。”"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i69"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“不过，鹰原居然连做梦都会梦到天善和良一啊。”"},{"op":"text","speaker":"羽依里","text":"“哎？啊，哦，毕竟是在岛上交到的好朋友嘛。”"},{"op":"image","layer":7,"image":"i12143"},{"op":"text","speaker":"良一","text":"“嘿嘿……”"},{"op":"image","layer":7,"image":"i15013"},{"op":"text","speaker":"天善","text":"“呵……”"},{"op":"image","layer":1,"image":"i11709"},{"op":"text","speaker":"美希","text":"“这么一来，我也不好批评你梦里做的那些事了。”"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"image","layer":1,"image":"i11712"},{"op":"text","speaker":"美希","text":"“居然做什么把小孩子叫到村公所前搞裸体乒乓球大会这种有伤风化的梦。”"},{"op":"image","layer":1,"image":"i11721"},{"op":"text","speaker":"美希","text":"“我很担心是不是执行部的工作给你带来了太多压力。”"},{"op":"image","layer":1,"image":"i11731"},{"op":"text","speaker":"美希","text":"“其实你很想做这种事吗？”"},{"op":"text","speaker":"羽依里","text":" “绝对没有！” "},{"op":"text","speaker":"","text":"我一边拼命否认，一边看向苍。"},{"op":"image","layer":257,"image":"i10346"},{"op":"text","speaker":"苍","text":"“嗯！”"},{"op":"text","speaker":"","text":"不知为何她露出了灿烂的笑容，还竖起了大拇指。"},{"op":"text","speaker":"","text":"真希望她帮忙糊弄的时候能找个别的理由。"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“好了，在这里待太久也会打扰到鹰原。”"},{"op":"text","speaker":"羽依里","text":"“我倒是很闲，无所谓的。”"},{"op":"image","layer":1,"image":"i11701"},{"op":"text","speaker":"美希","text":"“不行，今天你要好好休息。”"},{"op":"image","layer":1,"image":"i11689"},{"op":"text","speaker":"美希","text":"“然后，明天再让我们看到你精神的样子。”"},{"op":"image","layer":257,"image":"i12144"},{"op":"text","speaker":"良一","text":"“对对，没有你在的话，脱衣服都没意思了。”"},{"op":"image","layer":1,"image":"i15011"},{"op":"text","speaker":"天善","text":"“我可是很期待裸体乒乓球大会的啊。”"},{"op":"text","speaker":"羽依里","text":"“不……不会有的。”"},{"op":"image","layer":1,"image":"i15026"},{"op":"image","layer":257,"image":"i12168"},{"op":"text","speaker":"天善","text":"“什么……苍，这说话不算话啊！”"},{"op":"image","layer":257,"image":"i12153"},{"op":"text","speaker":"良一","text":"“你竟然骗我们؟!”"},{"op":"image","layer":7,"image":"i10318"},{"op":"text","speaker":"苍","text":"“哎……你们居然信以为真了吗……”"},{"op":"image","layer":1,"image":"i15023"},{"op":"text","speaker":"天善","text":"“呜哦哦哦哦！”"},{"op":"image","layer":257,"image":"i12147"},{"op":"text","speaker":"良一","text":"“我明明那么相信你的――！”"},{"op":"text","speaker":"羽依里","text":"“你们这些家伙也太纯真了……”"},{"op":"text","speaker":"","text":"好在纯真，也坏在纯真。"},{"op":"image","layer":513,"image":"i11728"},{"op":"text","speaker":"美希","text":"“那鹰原，我们先回去了。你真的别太勉强自己哦？”"},{"op":"text","speaker":"羽依里","text":"“嗯，好的。谢谢你们来看我。”"},{"op":"image","layer":1,"image":"i12188"},{"op":"text","speaker":"良一","text":"“明天我会脱光衣服等你来哦。”"},{"op":"text","speaker":"羽依里","text":"“我会好好给Hydro加满水去找你的。”"},{"op":"image","layer":257,"image":"i15093"},{"op":"text","speaker":"天善","text":"“等你完全康复，明天我们再打乒――……”"},{"op":"text","speaker":"羽依里","text":"“明天见，今天真的谢谢你们了。”"},{"op":"text","speaker":"","text":"我果断打断了天善的话，笑着挥了挥手。"},{"op":"text","speaker":"","text":"大家都走后，我歇了口气。"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"","text":"野美希在现实中来到了我的房间。"},{"op":"text","speaker":"","text":"虽然我是借住在这里的，也不能完全说是我的房间。"},{"op":"text","speaker":"羽依里","text":"“看她表情是真的很担心我啊……”"},{"op":"text","speaker":"羽依里","text":"“但知道我没事的时候，又笑得那么开心……”"},{"op":"text","speaker":"羽依里","text":"“啊――……可恶，她怎么会那么可爱啊。”"},{"op":"text","speaker":"","text":"我在被褥上滚来滚去。"},{"op":"text","speaker":"","text":"然后双手一把抓住枕头举了起来。"},{"op":"text","speaker":"羽依里","text":"“……梦里的野美希也好可爱啊……”"},{"op":"text","speaker":"羽依里","text":"“在梦里她那么坦率，自然而然地就亲过来……然后还一脸害羞……”"},{"op":"text","speaker":"","text":"我把野美希的身影投射到枕头上，眯起眼睛。"},{"op":"text","speaker":"","text":"然后稍稍撅起嘴唇――"},{"op":"image","layer":1,"image":"i10285"},{"op":"text","speaker":"苍","text":"“啊――抱歉，能不能不要继续了？”"},{"op":"text","speaker":"羽依里","text":" “呀啊啊啊啊啊啊！” "},{"op":"text","speaker":"羽依里","text":"“你、你、你怎么还在房间里啊！偷窥狂!؟变态!؟”"},{"op":"image","layer":1,"image":"i10319"},{"op":"text","speaker":"苍","text":"“不是……我一直都没走，只是你太沉浸在自己的世界里没注意到而已。”"},{"op":"text","speaker":"羽依里","text":"“请忘掉刚才的事！拜托了！”"},{"op":"text","speaker":"羽依里","text":"“请忘掉您刚才看到的一切!!”"},{"op":"image","layer":1,"image":"i10325"},{"op":"text","speaker":"苍","text":"“嗯，我尽量，不过应该是忘不掉了。”"},{"op":"text","speaker":"羽依里","text":"“啊啊啊啊啊……”"},{"op":"image","layer":1,"image":"i10235"},{"op":"text","speaker":"苍","text":"“先不说这个。”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"苍","text":"“你好像真的很喜欢野美希呢。”"},{"op":"text","speaker":"羽依里","text":"“看起来有吗？”"},{"op":"image","layer":1,"image":"i10210"},{"op":"text","speaker":"苍","text":"“刚才都那样了，说不喜欢那脑子一定有问题吧？”"},{"op":"text","speaker":"羽依里","text":"“……你说得对。”"},{"op":"image","layer":1,"image":"i10203"},{"op":"text","speaker":"苍","text":"“不过，其实我想问的不是这个。”"},{"op":"text","speaker":"羽依里","text":"“哎？”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"苍","text":"“…………”"},{"op":"text","speaker":"","text":"苍换上了一副严肃的表情。"},{"op":"image","layer":1,"image":"i10224"},{"op":"text","speaker":"苍","text":"“你是不是碰到蝴蝶了？”"},{"op":"text","speaker":"羽依里","text":"“啊？蝴蝶？”"},{"op":"text","speaker":"","text":"这问题把我问了个措手不及，完全不知道她在说什么。"},{"op":"text","speaker":"羽依里","text":"“蝴蝶，是说那种会飞的蝴蝶吗？”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"苍","text":"“对，一种淡淡发光的蝴蝶。”"},{"op":"text","speaker":"羽依里","text":"“发光的，蝴蝶……”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":1795,"image":"i18201"},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i351"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1795},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"set","variable":7120,"value":0},{"op":"image","layer":0,"image":"i69"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“啊……”"},{"op":"text","speaker":"","text":"我想起来了。之前确实看到过发光的蝴蝶。"},{"op":"text","speaker":"","text":"在广播塔上，仿佛从野美希身中飞出来的那个东西……"},{"op":"image","layer":1,"image":"i10210"},{"op":"text","speaker":"苍","text":"“看你的样子，应该是说中了呢。”"},{"op":"text","speaker":"羽依里","text":"“没，我倒是没碰到它。”"},{"op":"text","speaker":"羽依里","text":"“原来不是看错了啊……因为发光的蝴蝶什么的……”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"苍","text":"“在这座岛上，是存在的哦。”"},{"op":"text","speaker":"羽依里","text":"“真的吗？”"},{"op":"image","layer":1,"image":"i10231"},{"op":"text","speaker":"苍","text":"“不过，也不是谁都能看得见就是了。”"},{"op":"text","speaker":"羽依里","text":"“真的吗!؟”"},{"op":"image","layer":1,"image":"i10246"},{"op":"text","speaker":"苍","text":"“你怎么一副高兴的样子……”"},{"op":"text","speaker":"羽依里","text":"“超自然现象什么的，肯定会让人兴奋啊。”"},{"op":"text","speaker":"羽依里","text":"“但是那只蝴蝶……嗯，我看着好像是从野美希身上飞出来的？”"},{"op":"text","speaker":"羽依里","text":"“那只蝴蝶，和野美希有什么关系吗？”"},{"op":"image","layer":1,"image":"i10272"},{"op":"text","speaker":"苍","text":"“…………”"},{"op":"image","layer":1,"image":"i10254"},{"op":"text","speaker":"苍","text":"“羽依里。你和野美希走得太近了。”"},{"op":"text","speaker":"羽依里","text":"“啊？这是什么意思？”"},{"op":"image","layer":1,"image":"i10290"},{"op":"text","speaker":"苍","text":"“啊――……那个……先不说七影蝶的事。”"},{"op":"text","speaker":"羽依里","text":"“七影……蝴蝶？”"},{"op":"image","layer":1,"image":"i10308"},{"op":"text","speaker":"苍","text":"“总之呢，她会干涉他人的意识。”"},{"op":"text","speaker":"羽依里","text":"“干涉他人的意识……野美希吗？”"},{"op":"image","layer":1,"image":"i10285"},{"op":"text","speaker":"苍","text":"“反过来说，这也许说明她足够信任你。”"},{"op":"image","layer":1,"image":"i10311"},{"op":"text","speaker":"苍","text":"“但是，这并不是什么好事。”"},{"op":"text","speaker":"羽依里","text":"“这和我睡了整整一天有关系吗？”"},{"op":"image","layer":1,"image":"i10308"},{"op":"text","speaker":"苍","text":"“应该有。”"},{"op":"text","speaker":"羽依里","text":"“不会吧……”"},{"op":"image","layer":1,"image":"i10224"},{"op":"text","speaker":"苍","text":"“你看到了吧？”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"苍","text":"“那个发光的蝴蝶。”"},{"op":"text","speaker":"羽依里","text":"“……啊，嗯。”"},{"op":"image","layer":1,"image":"i10231"},{"op":"text","speaker":"苍","text":"“你绝对不可以碰它。”"},{"op":"image","layer":1,"image":"i10210"},{"op":"text","speaker":"苍","text":"“但是……在睡着的时候它自己凑过来的话，也没有办法避开。”"},{"op":"image","layer":1,"image":"i10213"},{"op":"text","speaker":"苍","text":"“这只是我的推测，不过野美希的蝴蝶应该是趁你睡觉的时候来找你了。”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"苍","text":"“我认为这就是你陷入沉睡的原因。”"},{"op":"text","speaker":"羽依里","text":"“突然说这种事情，我也听不太懂啊。”"},{"op":"image","layer":1,"image":"i10210"},{"op":"text","speaker":"苍","text":"“我也没觉得你会一下子相信。”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"苍","text":"“不过，最近你是不是一直在做些身临其境的梦？”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"image","layer":1,"image":"i10231"},{"op":"text","speaker":"苍","text":"“看来说中了。”"},{"op":"image","layer":1,"image":"i10233"},{"op":"text","speaker":"苍","text":"“考虑到这次发生的事情……”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"苍","text":"“我觉得你最好尽快离开这座岛。”"},{"op":"text","speaker":"羽依里","text":"“什么……我不要。”"},{"op":"text","speaker":"","text":"一瞬间有些困惑，但我立刻就表示拒绝。"},{"op":"image","layer":1,"image":"i10210"},{"op":"text","speaker":"苍","text":"“唉……我就知道你会这么说。”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"苍","text":"“反正你暑假结束之后不是要回去的吗？”"},{"op":"text","speaker":"羽依里","text":"“是这样没错……”"},{"op":"image","layer":1,"image":"i10233"},{"op":"text","speaker":"苍","text":"“那就只是提前一点而已。”"},{"op":"text","speaker":"羽依里","text":"“可是……”"},{"op":"image","layer":1,"image":"i10231"},{"op":"text","speaker":"苍","text":"“我说这些也不是想。”"},{"op":"image","layer":1,"image":"i10213"},{"op":"text","speaker":"苍","text":"“说实话，自从你来了以后我们每天都玩得很开心，少年团也变得很有活力……”"},{"op":"image","layer":1,"image":"i10171"},{"op":"text","speaker":"苍","text":"“野美希也更有精神了，还有……我也……”"},{"op":"image","layer":1,"image":"i10176"},{"op":"text","speaker":"苍","text":"“啊！别、别误会哦!؟我不是说我对你有什么意思！”"},{"op":"text","speaker":"羽依里","text":"“不，这你不需要解释。”"},{"op":"text","speaker":"羽依里","text":"“我只喜欢野美希一个人。”"},{"op":"image","layer":1,"image":"i10208"},{"op":"text","speaker":"苍","text":"“你也稍微意识一下啊！”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"image","layer":1,"image":"i10218"},{"op":"text","speaker":"苍","text":"“我说……别用那种悲伤的眼神看着我。”"},{"op":"image","layer":1,"image":"i10208"},{"op":"text","speaker":"苍","text":"“搞得我好像是个可怜人一样！”"},{"op":"text","speaker":"羽依里","text":"“抱歉啊，苍。”"},{"op":"text","speaker":"羽依里","text":"“如果我再轻浮一点的话，或许还能回应你的感情。”"},{"op":"text","speaker":"羽依里","text":"“但我只喜欢野美希一个人。”"},{"op":"image","layer":1,"image":"i10221"},{"op":"text","speaker":"苍","text":"“啊啊啊！为什么感觉像是我被甩了一样啊――！”"},{"op":"text","speaker":"羽依里","text":"“总而言之。”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"羽依里","text":"“我现在还不能回去。”"},{"op":"text","speaker":"羽依里","text":"“如果就这样不明不白地走掉的话，我觉得自己可能就再也回不来了。”"},{"op":"image","layer":1,"image":"i10213"},{"op":"text","speaker":"苍","text":"“作为岛上的居民，虽然很高兴你能这么想……”"},{"op":"text","speaker":"","text":"苍露出了复杂的表情。"},{"op":"image","layer":1,"image":"i10231"},{"op":"text","speaker":"苍","text":"“但就算这次没事，下次可说不准会发生什么啊？”"},{"op":"text","speaker":"","text":"即便如此她还是关心着我，如此劝说道。我很感激这份心意。"},{"op":"text","speaker":"","text":"但是……"},{"op":"text","speaker":"羽依里","text":"“就这样离开这座岛，不就意味着再也见不到野美希了吗？”"},{"op":"text","speaker":"","text":"即使原因出在野美希身上，在什么都没解决的情况下离开这里，实际上就等于是下定决心再也不见野美希了。"},{"op":"text","speaker":"羽依里","text":"“我绝对不要那样。”"},{"op":"text","speaker":"","text":"这一点我毫不犹豫。"},{"op":"image","layer":1,"image":"i10168"},{"op":"text","speaker":"苍","text":"“唉～真羡慕野美希啊。”"},{"op":"text","speaker":"羽依里","text":"“哎？苍，你果然对我……”"},{"op":"image","layer":1,"image":"i10165"},{"op":"text","speaker":"苍","text":"“才不是啊！”"},{"op":"image","layer":1,"image":"i10235"},{"op":"text","speaker":"苍","text":"“只是羡慕有人能这么堂堂正正地说喜欢自己而已。”"},{"op":"text","speaker":"羽依里","text":"“不过，我还没有跟她本人说过喜欢就是了。”"},{"op":"image","layer":1,"image":"i10290"},{"op":"text","speaker":"苍","text":"“…………”"},{"op":"text","speaker":"羽依里","text":"“干、干嘛啊？”"},{"op":"image","layer":1,"image":"i10319"},{"op":"text","speaker":"苍","text":"“怂包一个。”"},{"op":"text","speaker":"羽依里","text":"“才、才不是怂包！”"},{"op":"text","speaker":"羽依里","text":"“我这叫纯好吗！”"},{"op":"image","layer":1,"image":"i10389"},{"op":"text","speaker":"苍","text":"“纯怂包。”"},{"op":"text","speaker":"羽依里","text":"“意思完全变了吧！感觉比之前更怂包了啊！”"},{"op":"image","layer":1,"image":"i10290"},{"op":"text","speaker":"苍","text":"“明明是个怂包，却不愿意离开岛。”"},{"op":"image","layer":1,"image":"i10330"},{"op":"text","speaker":"苍","text":"“也不知道你是有胆量还是没胆量。”"},{"op":"image","layer":1,"image":"i10345"},{"op":"text","speaker":"苍","text":"“都说到这份上了，我也不好意思赶你走了呢。”"},{"op":"text","speaker":"","text":"苍耸了耸肩，夹杂着叹息笑了笑。"},{"op":"text","speaker":"羽依里","text":"“谢谢你为我担心。”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"苍","text":"“不过，我也不能就这样装作毫不知情。”"},{"op":"image","layer":1,"image":"i10254"},{"op":"text","speaker":"苍","text":"“得想点办法才行。”"},{"op":"text","speaker":"羽依里","text":"“真的有那么危险吗？”"},{"op":"image","layer":1,"image":"i10270"},{"op":"text","speaker":"苍","text":"“刚才我也说过了，搞不好会永远都醒不过来哦。”"},{"op":"text","speaker":"羽依里","text":"“真的假的？”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"苍","text":"“真的。”"},{"op":"text","speaker":"羽依里","text":"“那还挺麻烦的。”"},{"op":"image","layer":1,"image":"i10210"},{"op":"text","speaker":"苍","text":"“这不是废话嘛。”"},{"op":"text","speaker":"羽依里","text":"“可是，该怎么办呢？”"},{"op":"text","speaker":"羽依里","text":"“我不知道怎样靠自己的意志从梦中醒来。”"},{"op":"image","layer":1,"image":"i10235"},{"op":"text","speaker":"苍","text":"“有诀窍的哦。”"},{"op":"text","speaker":"羽依里","text":"“咦，真的吗？快教教我！”"},{"op":"image","layer":1,"image":"i10224"},{"op":"text","speaker":"苍","text":"“做梦的时候，你能意识到自己是在梦里的吧？”"},{"op":"text","speaker":"羽依里","text":"“可以，梦到过几次之后就差不多能分辨出来了。”"},{"op":"text","speaker":"羽依里","text":"“虽然也有好几次被梦中的情节带着跑，不知不觉就忘记了。”"},{"op":"image","layer":1,"image":"i10203"},{"op":"text","speaker":"苍","text":"“这种时候，你就看看自己的手心。”"},{"op":"text","speaker":"羽依里","text":"“手心？”"},{"op":"image","layer":1,"image":"i10235"},{"op":"text","speaker":"苍","text":"“对，仔细观察你自己的手心。”"},{"op":"text","speaker":"羽依里","text":"“观察手心啊。这样就能意识到是在做梦吗？”"},{"op":"image","layer":1,"image":"i10200"},{"op":"text","speaker":"苍","text":"“应该会更容易意识到。因为在梦中，观察是非常关键的动作。”"},{"op":"text","speaker":"羽依里","text":"“观察……”"},{"op":"image","layer":1,"image":"i10416"},{"op":"text","speaker":"苍","text":"“等手心看清楚了，就继续观察周围的景色。”"},{"op":"text","speaker":"羽依里","text":"“看手心，再观察周围……”"},{"op":"image","layer":1,"image":"i10394"},{"op":"text","speaker":"苍","text":"“这样的话，你应该就能意识到自己正在做梦了。”"},{"op":"text","speaker":"羽依里","text":"“好的，我试试看。”"},{"op":"text","speaker":"羽依里","text":"“不过首先还得记住要这么做才行。”"},{"op":"image","layer":1,"image":"i10322"},{"op":"text","speaker":"苍","text":"“然后一旦意识到是在做梦，就试试从梦中醒来的方法。”"},{"op":"text","speaker":"羽依里","text":"“怎么做？”"},{"op":"image","layer":1,"image":"i10279"},{"op":"text","speaker":"苍","text":"“首先要找到梦境与现实的接点。”"},{"op":"image","layer":1,"image":"i10322"},{"op":"text","speaker":"苍","text":"“看自己的手就是其中一个方法，然后还有地点或者物品之类的。”"},{"op":"text","speaker":"羽依里","text":"“地点或者物品……吗。”"},{"op":"image","layer":1,"image":"i10276"},{"op":"text","speaker":"苍","text":"“你可以把它们想象成是梦的边界，或者是门。”"},{"op":"text","speaker":"羽依里","text":"“也就是说当做是一种连接梦境和现实的地方吗？”"},{"op":"image","layer":1,"image":"i10322"},{"op":"text","speaker":"苍","text":"“嗯，差不多就是这样。”"},{"op":"image","layer":1,"image":"i10200"},{"op":"text","speaker":"苍","text":"“还有一个非常简单的醒来方法，就是从高处坠落。”"},{"op":"text","speaker":"羽依里","text":"“……坠落？”"},{"op":"image","layer":1,"image":"i10224"},{"op":"text","speaker":"苍","text":"“你有没有过从哪里掉下去后醒来的情况？”"},{"op":"image","layer":1,"image":"i10235"},{"op":"text","speaker":"苍","text":"“就是感觉身体突然飘了起来，然后猛地惊醒的那种。”"},{"op":"text","speaker":"羽依里","text":"“啊，有有有。”"},{"op":"text","speaker":"羽依里","text":"“原来如此，就是要有意识地制造出那种状况啊。”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"苍","text":"“但是，这样也不能保证一定能醒来。”"},{"op":"image","layer":1,"image":"i10213"},{"op":"text","speaker":"苍","text":"“所以说……”"},{"op":"image","layer":1,"image":"i10231"},{"op":"text","speaker":"苍","text":"“虽然现在立刻离开岛是最好的选择……”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"苍","text":"“但你不会这么做对吧？”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"image","layer":1,"image":"i10235"},{"op":"text","speaker":"苍","text":"“我明白了。”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"苍","text":"“但是无论如何都不要勉强自己。”"},{"op":"text","speaker":"羽依里","text":"“嗯，我知道。谢谢你告诉我这么多。”"},{"op":"image","layer":1,"image":"i10196"},{"op":"text","speaker":"苍","text":"“不用谢。”"},{"op":"image","layer":1,"image":"i10235"},{"op":"text","speaker":"苍","text":"“反倒是我，要拜托你多多照顾野美希了。”"},{"op":"image","layer":1,"image":"i10215"},{"op":"text","speaker":"苍","text":"“一定要保护好她哦。”"},{"op":"text","speaker":"羽依里","text":"“……当然。”"},{"op":"text","speaker":"","text":"虽然不知道自己能做些什么。"},{"op":"text","speaker":"","text":"但是，也绝不可能在此时此刻选择退缩。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]