[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“早。”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“吸吸，早。”"},{"op":"text","speaker":"","text":"小羽未正悠闲地喝着茶。"},{"op":"text","speaker":"","text":"平时早上好像都忙得焦头烂额的，有点稀奇。"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“来了哦。”"},{"op":"text","speaker":"羽依里","text":"“谁来了。”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“你的朋友。”"},{"op":"text","speaker":"羽依里","text":"“？”"},{"op":"image","layer":7,"image":"i11385"},{"op":"text","speaker":"鸥","text":"“啊，早。”"},{"op":"text","speaker":"羽依里","text":"“唉。”"},{"op":"text","speaker":"","text":"厨房间传来的，是鸥的声音。"},{"op":"text","speaker":"","text":"说起来，她确实说过要来照顾受伤的我之类的话。"},{"op":"text","speaker":"羽依里","text":"“你真的来了啊。”"},{"op":"image","layer":7,"image":"i11388"},{"op":"text","speaker":"鸥","text":"“当然了。”"},{"op":"text","speaker":"羽依里","text":"“呃……”"},{"op":"text","speaker":"","text":"我不禁后退。"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i1241"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i1240"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"大清早，鸥穿着女仆装直挺挺地站着。"},{"op":"text","speaker":"羽依里","text":"“我说你啊……为什么穿成那样。”"},{"op":"text","speaker":"鸥","text":"“我对镜子小姐说了，暂时让我来帮忙一段时间。”"},{"op":"text","speaker":"鸥","text":"“她就说，那这件给你。”"},{"op":"image","layer":7,"image":"i11583"},{"op":"text","speaker":"镜子","text":"“很合身吧。”"},{"op":"text","speaker":"羽依里","text":"“嗯，挺……合身吧。”"},{"op":"image","layer":0,"image":"i1242"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“好耶。”"},{"op":"text","speaker":"鸥","text":"“那么，今天开始加油了。”"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“那个人真能干啊。”"},{"op":"text","speaker":"","text":"羽未由衷地赞叹着。"},{"op":"text","speaker":"羽依里","text":"“在外面的时候也异常活跃呢。”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i1240"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“全部都做好了哦。还有没有什么别的活要做。”"},{"op":"text","speaker":"鸥","text":"“尽管开口。”"},{"op":"text","speaker":"羽依里","text":"“一时还想不到该做什么了……”"},{"op":"text","speaker":"","text":"要拜托她做什么？"},{"op":"choice","variable":6001,"items":[{"text":"帮忙做饭","value":0,"condition":1},{"text":"帮忙打扫","value":1,"condition":1},{"text":"帮忙换衣服","value":2,"condition":1}]},{"op":"if","truth":false,"target":110,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“做饭吧。”"},{"op":"text","speaker":"鸥","text":"“交给我吧。”"},{"op":"text","speaker":"鸥","text":"“今天的晚饭交给我可以吗。”"},{"op":"text","speaker":"羽未","text":"“嗯，可以哦。”"},{"op":"text","speaker":"羽未","text":"“冰箱里有的东西就行吗。”"},{"op":"text","speaker":"鸥","text":"“嗯，我想够了。”"},{"op":"text","speaker":"鸥","text":"“鸡肉，番茄，还有……”"},{"op":"text","speaker":"鸥","text":"“番茄炖鸡肉怎么样。”"},{"op":"text","speaker":"羽依里","text":"“你吃鸡肉的吗。”"},{"op":"text","speaker":"鸥","text":"“……为什么这么问。”"},{"op":"image","layer":0,"image":"i1243"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“我说啊，虽然我名字里有鸟，但并不代表着我对禽类有同类意识。”"},{"op":"text","speaker":"鸥","text":"“要这么说的话羽依里不也一样，不就不能吃带有羽字的鸡翅了吗。”"},{"op":"image","layer":0,"image":"i1244"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽未","text":"“羽依里……鸡翅……”"},{"op":"text","speaker":"羽未","text":"“噗噗。”"},{"op":"text","speaker":"羽依里","text":"“别笑啊，羽未。”"},{"op":"text","speaker":"羽依里","text":"“一点都不像好吧。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i65"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11384"},{"op":"text","speaker":"鸥","text":"“那我这就开始做。”"},{"op":"image","layer":1,"image":"i11405"},{"op":"text","speaker":"鸥","text":"“用菜刀很难切鸡肉呢。”"},{"op":"image","layer":1,"image":"i11384"},{"op":"text","speaker":"鸥","text":"“嘿咻。”"},{"op":"text","speaker":"羽依里","text":"“哇啊啊啊。”"},{"op":"image","layer":1,"image":"i11390"},{"op":"text","speaker":"鸥","text":"“……嘿咻。”"},{"op":"text","speaker":"羽依里","text":"“鸥你这个叛徒。对同为禽类的鸡竟然下此狠手。”"},{"op":"text","speaker":"羽依里","text":"“呀啊啊啊。”"},{"op":"image","layer":1,"image":"i11396"},{"op":"text","speaker":"鸥","text":"“能不闹了吗。”"},{"op":"text","speaker":"羽依里","text":"“因为很闲啊。”"},{"op":"image","layer":1,"image":"i11398"},{"op":"text","speaker":"鸥","text":"“这个人一直这样的吗。”"},{"op":"image","layer":7,"image":"i15498"},{"op":"text","speaker":"羽未","text":"“今天因为高兴而得意忘形了。”"},{"op":"image","layer":1,"image":"i11392"},{"op":"text","speaker":"羽依里","text":"“我、我没有。”"},{"op":"image","layer":1,"image":"i11386"},{"op":"text","speaker":"鸥","text":"“算了。”"},{"op":"text","speaker":"羽依里","text":"“什么就算了啊。”"},{"op":"goto","target":268},{"op":"if","truth":false,"target":178,"value":["==",["v",6001],1]},{"op":"text","speaker":"羽依里","text":"“那麻烦你打扫了。”"},{"op":"text","speaker":"鸥","text":"“就知道是这个。”"},{"op":"text","speaker":"鸥","text":"“因为男生不会收拾呢。”"},{"op":"text","speaker":"鸥","text":"“打扫，打扫咯……”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"……"},{"op":"image","layer":0,"image":"i1240"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“这不挺干净的吗。”"},{"op":"text","speaker":"羽依里","text":"“因为羽未平时就打扫得很仔细。”"},{"op":"text","speaker":"鸥","text":"“我现在该打扫哪里呢。”"},{"op":"text","speaker":"羽未","text":"“羽依里哥的房间，没怎么打扫哦。”"},{"op":"text","speaker":"鸥","text":"“那我去看看吧。”"},{"op":"text","speaker":"羽依里","text":"“哎……”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i457"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":7,"image":"i11383"},{"op":"text","speaker":"鸥","text":"“接下来，从哪里着手呢。”"},{"op":"image","layer":7,"image":"i11399"},{"op":"text","speaker":"鸥","text":"“嗯。”"},{"op":"text","speaker":"","text":"稀奇地环顾我的房间。"},{"op":"image","layer":7,"image":"i11389"},{"op":"text","speaker":"鸥","text":"“据说男生的书架上都藏着秘密。”"},{"op":"text","speaker":"羽依里","text":"“你好奇哪儿呢。”"},{"op":"image","layer":0,"image":"i68"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11384"},{"op":"text","speaker":"鸥","text":"“……我看看。”"},{"op":"image","layer":1,"image":"i11400"},{"op":"text","speaker":"鸥","text":"“《世界怪奇事件集》《暗黑神的末裔》。”"},{"op":"image","layer":1,"image":"i11394"},{"op":"text","speaker":"鸥","text":"“呜哇。”"},{"op":"image","layer":1,"image":"i11396"},{"op":"text","speaker":"鸥","text":"“品种好恐怖。”"},{"op":"text","speaker":"羽依里","text":"“你自己不也喜欢探险小说。”"},{"op":"image","layer":1,"image":"i11400"},{"op":"text","speaker":"鸥","text":"“喜欢的呀？”"},{"op":"text","speaker":"羽依里","text":"“对未知事物充满好奇心这一点，我们还挺像的。”"},{"op":"image","layer":1,"image":"i11390"},{"op":"text","speaker":"鸥","text":"“我觉得不是一回事。”"},{"op":"text","speaker":"羽依里","text":"“我也期待着你的行李箱里面，会是些非常猎奇的东西。”"},{"op":"image","layer":1,"image":"i11406"},{"op":"text","speaker":"鸥","text":"“好过分！”"},{"op":"text","speaker":"鸥","text":"“怎么可能是猎奇的东西呢。”"},{"op":"text","speaker":"羽依里","text":"“是吗。因为完全不给我看里面，所以我就想会不会是猎奇物品。”"},{"op":"image","layer":1,"image":"i11394"},{"op":"text","speaker":"鸥","text":"“不给看就是猎奇!؟什么逻辑؟؟”"},{"op":"image","layer":1,"image":"i11390"},{"op":"text","speaker":"鸥","text":"“那现在就给你看看吧。”"},{"op":"text","speaker":"羽依里","text":"“真的吗。”"},{"op":"image","layer":1,"image":"i11392"},{"op":"text","speaker":"鸥","text":"“……唉。”"},{"op":"image","layer":1,"image":"i11396"},{"op":"text","speaker":"鸥","text":"“好险好险。差点就上了你的套了。”"},{"op":"text","speaker":"羽依里","text":"“果然是猎奇的呢。”"},{"op":"image","layer":1,"image":"i11406"},{"op":"text","speaker":"鸥","text":"“才不猎奇。”"},{"op":"goto","target":268},{"op":"image","layer":0,"image":"i1245"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“……换衣服。”"},{"op":"text","speaker":"鸥","text":"“羽依里，你是没法自己穿袜子的人吗。”"},{"op":"text","speaker":"鸥","text":"“有很多小孩子就是这样。”"},{"op":"text","speaker":"羽依里","text":"“……算是吧。”"},{"op":"text","speaker":"羽依里","text":"“现在很费劲的。”"},{"op":"text","speaker":"鸥","text":"“真没办法啊。”"},{"op":"image","layer":0,"image":"i1246"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“那么。”"},{"op":"text","speaker":"鸥","text":"“请准备一双好好洗干净的袜子。”"},{"op":"text","speaker":"羽依里","text":"“给。”"},{"op":"text","speaker":"鸥","text":"“请伸出好好洗干净的双脚。”"},{"op":"text","speaker":"羽依里","text":"“喏。”"},{"op":"image","layer":0,"image":"i1243"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“……”"},{"op":"text","speaker":"鸥","text":"“有好好洗干净的吧？”"},{"op":"text","speaker":"羽依里","text":"“有哦。”"},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11402"},{"op":"text","speaker":"鸥","text":"“那么，失礼了。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i11400"},{"op":"text","speaker":"鸥","text":"“……”"},{"op":"image","layer":1,"image":"i11390"},{"op":"text","speaker":"鸥","text":"“有好好洗干净？”"},{"op":"text","speaker":"羽依里","text":"“有哦。”"},{"op":"image","layer":1,"image":"i11400"},{"op":"text","speaker":"鸥","text":"“嘿咻。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i11390"},{"op":"text","speaker":"鸥","text":"“别乱动啊。”"},{"op":"text","speaker":"羽依里","text":"“因为很痒啊。”"},{"op":"image","layer":1,"image":"i11396"},{"op":"text","speaker":"鸥","text":"“为什么只是穿个袜子也会痒啊。”"},{"op":"text","speaker":"羽依里","text":"“你试试就知道了。”"},{"op":"image","layer":1,"image":"i11400"},{"op":"text","speaker":"鸥","text":"“真的吗。”"},{"op":"image","layer":1,"image":"i11402"},{"op":"text","speaker":"鸥","text":"“那你也帮我穿。”"},{"op":"text","speaker":"羽依里","text":"“唉。”"},{"op":"image","layer":1,"image":"i11394"},{"op":"text","speaker":"鸥","text":"“……啊。这、这才是你的目的吧。”"},{"op":"text","speaker":"羽依里","text":"“才不是。”"},{"op":"text","speaker":"羽依里","text":"“而且我的手伤了也没办法帮你。”"},{"op":"text","speaker":"羽依里","text":"“羽未，帮她穿。”"},{"op":"image","layer":257,"image":"i15504"},{"op":"text","speaker":"羽未","text":"“为，为什么我要做那种事啊。”"},{"op":"image","layer":257,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“但是稍微有点兴趣。”"},{"op":"image","layer":257,"image":"i15473"},{"op":"image","layer":1,"image":"i11384"},{"op":"text","speaker":"羽未","text":"“我来咯。”"},{"op":"text","speaker":"","text":"……"},{"op":"image","layer":1,"image":"i11394"},{"op":"text","speaker":"鸥","text":"“呀。”"},{"op":"image","layer":1,"image":"i11398"},{"op":"text","speaker":"鸥","text":"“好痒啊。”"},{"op":"image","layer":257,"image":"i15379"},{"op":"text","speaker":"羽未","text":"“哎～为什么啊。”"},{"op":"image","layer":257,"image":"i15326"},{"op":"text","speaker":"羽未","text":"“也让我试试。”"},{"op":"image","layer":1,"image":"i11384"},{"op":"text","speaker":"鸥","text":"“嗯。”"},{"op":"image","layer":257,"image":"i15373"},{"op":"text","speaker":"","text":"……"},{"op":"image","layer":257,"image":"i15565"},{"op":"text","speaker":"羽未","text":"“哎呀，好痒呀。”"},{"op":"image","layer":257,"image":"i15553"},{"op":"text","speaker":"羽未","text":"“明明小的时候别人帮我穿就没事。”"},{"op":"text","speaker":"羽未","text":"“为什么会这么痒呢。”"},{"op":"image","layer":513,"image":"i11617"},{"op":"text","speaker":"镜子","text":"“……”"},{"op":"image","layer":513,"image":"i11632"},{"op":"text","speaker":"镜子","text":"“你们做什么呢。”"},{"op":"text","speaker":"羽依里","text":"“调查让别人帮忙穿袜子会很痒的这种说法。”"},{"op":"image","layer":513,"image":"i11566"},{"op":"text","speaker":"镜子","text":"“哎哎？”"},{"op":"image","layer":513,"image":"i11547"},{"op":"text","speaker":"镜子","text":"“也帮我穿一下。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"image","layer":0,"image":"i158"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":7,"image":"i11583"},{"op":"text","speaker":"镜子","text":"“呀，好痒啊。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i1240"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“那么接下来帮忙浴室的事吧。”"},{"op":"text","speaker":"","text":"虽然打扫浴室和烧洗澡水是我的任务，但是现在手受伤了不太方便。"},{"op":"image","layer":0,"image":"i1247"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“唉。”"},{"op":"text","speaker":"鸥","text":"“真的吗。”"},{"op":"text","speaker":"羽依里","text":"“真的啊。”"},{"op":"image","layer":0,"image":"i1245"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“好、好吧。”"},{"op":"text","speaker":"鸥","text":"“鸥言既出驷马难追。”"},{"op":"text","speaker":"鸥","text":"“我帮你。”"},{"op":"text","speaker":"羽依里","text":"“嗯，麻烦你了。”"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i72"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":7,"image":"i15457"},{"op":"text","speaker":"羽未","text":"“羽依里哥，去洗澡吧。”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"text","speaker":"","text":"我吃了晚饭正躺在房间里的时候，传来羽未叫我的声音。"},{"op":"text","speaker":"","text":"……说起来，鸥是不是已经回去了。"},{"op":"text","speaker":"","text":"时间也不早了。"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":256,"image":"i708"},{"op":"image","layer":2307,"image":"i708"},{"op":"image","layer":0,"image":"i179"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“呼……”"},{"op":"text","speaker":"","text":"鸥有帮我打扫浴室吧。"},{"op":"text","speaker":"","text":"我泡着别人家的女生清洗的浴池……"},{"op":"text","speaker":"","text":"这感觉。"},{"op":"text","speaker":"羽依里","text":"“鹰原羽依里！”"},{"op":"text","speaker":"","text":"所以说别人家的女生清洗的浴池又怎么了啊。"},{"op":"clear","layer":256},{"op":"clear","layer":2307},{"op":"image","layer":0,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我刚泡一会，门忽然被嘎啦嘎啦地打开了。"},{"op":"text","speaker":"羽依里","text":"“唉。”"},{"op":"text","speaker":"羽依里","text":"“谁啊。”"},{"op":"image","layer":7,"image":"i11401"},{"op":"text","speaker":"鸥","text":"“我帮你擦背。”"},{"op":"text","speaker":"羽依里","text":"“呜哇。”"},{"op":"text","speaker":"","text":"是鸥。"},{"op":"text","speaker":"羽依里","text":"“你怎么在！”"},{"op":"image","layer":7,"image":"i11391"},{"op":"text","speaker":"鸥","text":"“还能是怎么，来帮你洗啊。”"},{"op":"text","speaker":"羽依里","text":"“哎。”"},{"op":"text","speaker":"羽依里","text":"“可、可你。”"},{"op":"image","layer":7,"image":"i11387"},{"op":"text","speaker":"鸥","text":"“不要这么不好意思。”"},{"op":"image","layer":7,"image":"i11383"},{"op":"text","speaker":"鸥","text":"“不是围着毛巾的吗。”"},{"op":"text","speaker":"羽依里","text":"“没围啊。”"},{"op":"image","layer":7,"image":"i11393"},{"op":"text","speaker":"鸥","text":"“唉～～”"},{"op":"image","layer":7,"image":"i11389"},{"op":"text","speaker":"鸥","text":"“叫人家来帮忙，你自己在搞什么啊。”"},{"op":"image","layer":7,"image":"i11397"},{"op":"text","speaker":"鸥","text":"“好歹围条毛巾啊。”"},{"op":"text","speaker":"羽依里","text":"“慢着。我说的帮忙，是帮忙打扫之类的。”"},{"op":"text","speaker":"羽依里","text":"“没人叫你来擦背啊。”"},{"op":"image","layer":7,"image":"i11399"},{"op":"text","speaker":"鸥","text":"“但是，洗澡水一开始就烧好了哦？”"},{"op":"text","speaker":"羽依里","text":"“什么。”"},{"op":"image","layer":7,"image":"i11383"},{"op":"text","speaker":"鸥","text":"“是不是羽未帮忙烧的呢。”"},{"op":"text","speaker":"羽依里","text":"“这样啊。”"},{"op":"text","speaker":"","text":"顾虑到我的手，特地替我烧好了啊。"},{"op":"text","speaker":"","text":"明明告诉我一下就好了。"},{"op":"image","layer":7,"image":"i11404"},{"op":"text","speaker":"鸥","text":"“所以彻底以为你说的帮忙浴室，是叫我帮你洗澡呢。”"},{"op":"text","speaker":"羽依里","text":"“谁会这么拜托啊。”"},{"op":"text","speaker":"羽依里","text":"“说到底，你还没回去吗。”"},{"op":"image","layer":7,"image":"i11383"},{"op":"text","speaker":"鸥","text":"“因为我想着帮你洗完之前不能回去。”"},{"op":"image","layer":7,"image":"i11387"},{"op":"text","speaker":"鸥","text":"“就在仓库和镜子小姐聊天。”"},{"op":"text","speaker":"羽依里","text":"“那真是抱歉。”"},{"op":"image","layer":7,"image":"i11403"},{"op":"text","speaker":"鸥","text":"“好了，机会难得就帮你擦个背吧？”"},{"op":"image","layer":7,"image":"i11401"},{"op":"text","speaker":"鸥","text":"“毛巾围围好哦。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"到底该怎样啊。"},{"op":"text","speaker":"","text":"其实根本不用这么在意吗。"},{"op":"text","speaker":"","text":"不由想起了小学时候，妈妈帮我洗澡的情景。"},{"op":"text","speaker":"羽依里","text":"“……那么。”"},{"op":"text","speaker":"","text":"我把毛巾围在腰上，从浴缸中起身。"},{"op":"image","layer":7,"image":"i11393"},{"op":"text","speaker":"鸥","text":"“……”"},{"op":"text","speaker":"","text":"面对着站起来的我半裸的身体，鸥眨着眼。"},{"op":"image","layer":7,"image":"i11397"},{"op":"text","speaker":"鸥","text":"“抱歉，果然还是不行。”"},{"op":"image","layer":7,"image":"i11395"},{"op":"text","speaker":"鸥","text":"“我做不到。”"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i60"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":1,"image":"i11261"},{"op":"text","speaker":"鸥","text":"“那么再见。打扰了。”"},{"op":"image","layer":257,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“今天非常谢谢你。”"},{"op":"image","layer":1,"image":"i11245"},{"op":"text","speaker":"鸥","text":"“不客气。”"},{"op":"text","speaker":"羽依里","text":"“我送你一程。”"},{"op":"image","layer":1,"image":"i11261"},{"op":"text","speaker":"鸥","text":"“谢谢。”"},{"op":"return"},{"op":"end"}]