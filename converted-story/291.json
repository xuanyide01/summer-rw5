[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i75"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“嗯……”"},{"op":"text","speaker":"羽依里","text":"“……嗯？”"},{"op":"image","layer":0,"image":"i459"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"睁开眼睛，一时间不知道自己身在何处。"},{"op":"text","speaker":"","text":"可能是房间里异常昏暗的缘故。"},{"op":"text","speaker":"羽依里","text":"“………还是夜里啊……？”"},{"op":"text","speaker":"","text":"我还没等天亮就睡醒了吗？"},{"op":"image","layer":0,"image":"i75"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"正当我想去看表的时候――"},{"op":"text","speaker":"羽依里","text":"“……啊。”"},{"op":"text","speaker":"","text":"吓了一跳。"},{"op":"text","speaker":"","text":"感觉……有人的气息。"},{"op":"text","speaker":"","text":"而且离得很近。"},{"op":"text","speaker":"","text":"就在枕边。"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"","text":"冷静……冷静啊鹰原羽依里！"},{"op":"text","speaker":"","text":"对了，说不定是羽未或者镜子阿姨呢！"},{"op":"text","speaker":"","text":"可能就是过来看看我睡得好不好……"},{"op":"text","speaker":"","text":"不对，那她们也用不着站在枕边，更不用一直盯着我看啊！"},{"op":"text","speaker":"","text":"想来这里也是一栋颇为古老的房子，出现什么都不奇怪。"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"","text":"那股气息一直静静地停在枕边，一动不动。"},{"op":"text","speaker":"","text":"我在想要不要就当做什么都没发生，直接钻进被窝继续睡大觉。"},{"op":"text","speaker":"","text":"但那样的话，从明天开始就得一直活在这种恐惧中了。"},{"op":"text","speaker":"","text":"那还不如赌一把……"},{"op":"text","speaker":"羽依里","text":"“……是谁!؟”"},{"op":"text","speaker":"","text":"我猛地转身看向枕边。"},{"op":"image","layer":259,"image":"i25639"},{"op":"image","layer":0,"image":"i263"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":1,"image":"i11710"},{"op":"text","speaker":"美希","text":"“…………”"},{"op":"text","speaker":"","text":"站在那里的，是一个像是座敷童子的小女孩……"},{"op":"text","speaker":"羽依里","text":"“―――――――!!”"},{"op":"text","speaker":"羽依里","text":"“……咦，啊？”"},{"op":"clear","layer":1539},{"op":"clear","layer":259},{"op":"image","layer":0,"image":"i263"},{"op":"set","variable":6714,"value":1},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i11710"},{"op":"text","speaker":"羽依里","text":"“野美希……？”"},{"op":"text","speaker":"","text":"还以为是座敷童子，原来只不过是野美希而已。"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"","text":"不对不对，等下等下。"},{"op":"text","speaker":"","text":"什么叫只不过是野美希。"},{"op":"text","speaker":"","text":"为什么她会出现在这里啊？"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i75"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":1,"image":"i11709"},{"op":"text","speaker":"美希","text":"“…………”"},{"op":"text","speaker":"","text":"野美希一言不发地俯视着我。"},{"op":"text","speaker":"","text":"这是什么情况啊？"},{"op":"text","speaker":"羽依里","text":"“呃，这该不会是……”"},{"op":"text","speaker":"","text":"传说中的夜袭!!"},{"op":"text","speaker":"羽依里","text":"“……乡下还真是大胆啊。”"},{"op":"image","layer":1,"image":"i11769"},{"op":"text","speaker":"美希","text":"“唉……”"},{"op":"text","speaker":"","text":"她叹了口气。"},{"op":"text","speaker":"","text":"看来并不是夜袭呢。"},{"op":"image","layer":1,"image":"i11755"},{"op":"text","speaker":"美希","text":"“你要睡到什么时候？该出发去巡逻了。”"},{"op":"text","speaker":"羽依里","text":"“……啊？”"},{"op":"text","speaker":"","text":"我惊讶地看了看表，时针确实指在了10点的位置。"},{"op":"text","speaker":"羽依里","text":"“10点？”"},{"op":"text","speaker":"","text":"我歪着头看向窗外。"},{"op":"text","speaker":"","text":"还是一片漆黑。"},{"op":"text","speaker":"","text":"理所当然，毕竟连房间里都这么暗。"},{"op":"text","speaker":"","text":"不过，睡觉前我还看了下表，记得当时已经过了12点。"},{"op":"text","speaker":"","text":"如果现在是晚上10点的话，那就意味着我睡了将近一整天。"},{"op":"text","speaker":"","text":"我从来没一觉睡过这么久。"},{"op":"text","speaker":"羽依里","text":"“唔嗯……？”"},{"op":"image","layer":1,"image":"i11758"},{"op":"text","speaker":"美希","text":"“还没睡醒吗？快点，赶紧出发了。”"},{"op":"text","speaker":"羽依里","text":"“哦，喔。”"},{"op":"image","layer":1,"image":"i11750"},{"op":"text","speaker":"美希","text":"“真是的，我不在的话，你也太不中用了啊。”"},{"op":"text","speaker":"","text":"虽然还是一头雾水，但我还是钻出了被窝。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"来到客厅，看到了镜子阿姨。"},{"op":"image","layer":1,"image":"i11546"},{"op":"text","speaker":"镜子","text":"“哎呀，羽依里，早上好呀。”"},{"op":"text","speaker":"羽依里","text":"“镜子阿姨，早上好。”"},{"op":"image","layer":1,"image":"i11581"},{"op":"text","speaker":"镜子","text":"“热水已经烧好了，早饭吃速食乌冬可以吗？”"},{"op":"if","truth":false,"target":103,"value":["==",["v",6003],2]},{"op":"text","speaker":"羽依里","text":"“好的，和平时一样就行。”"},{"op":"text","speaker":"","text":"反正也没有其他选择。"},{"op":"text","speaker":"羽依里","text":"“说起来，羽未呢？”"},{"op":"goto","target":107},{"op":"text","speaker":"羽依里","text":"“咦？哦，今天不是炒饭啊。”"},{"op":"image","layer":1,"image":"i11549"},{"op":"text","speaker":"镜子","text":"“咦？平常不都是泡面吗？”"},{"op":"text","speaker":"羽依里","text":"“……？羽未呢？”"},{"op":"image","layer":1,"image":"i11546"},{"op":"text","speaker":"镜子","text":"“美希也来一起吃吧。”"},{"op":"image","layer":257,"image":"i11689"},{"op":"text","speaker":"美希","text":"“好的，谢谢。”"},{"op":"text","speaker":"","text":"镜子阿姨似乎并没有听到我的疑问，就这样径直走出了房间。"},{"op":"text","speaker":"","text":"既然都十点了，那羽未可能已经出去玩了吧？"},{"op":"text","speaker":"","text":"不对……外面这么黑――……不如说，简直就是夜里。"},{"op":"text","speaker":"羽依里","text":"“唔嗯……”"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“鹰原，我要往泡面里倒开水了，你帮我计下时。”"},{"op":"text","speaker":"羽依里","text":"“啊，好。”"},{"op":"text","speaker":"","text":"说真的，这到底是怎么回事啊？"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i431"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"来到外面，果不其然还是一片漆黑。"},{"op":"text","speaker":"羽依里","text":"“果然是夜里啊……”"},{"op":"image","layer":0,"image":"i30"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":1,"image":"i11837"},{"op":"text","speaker":"美希","text":"“你从刚才开始就在那嘀咕个什么呢？”"},{"op":"text","speaker":"","text":"野美希似乎完全没觉得目前的状况有什么奇怪。"},{"op":"text","speaker":"","text":"而且……"},{"op":"text","speaker":"岛上的男孩A","text":"“今天我们去山里找土龙吧！”"},{"op":"text","speaker":"岛上的男孩B","text":"“听说土龙能卖上一亿日元呢！”"},{"op":"text","speaker":"","text":"小朋友们兴高采烈地跑了过去。"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"","text":"这么黑还去山里，真的没问题吗？"},{"op":"text","speaker":"","text":"总之，小朋友们似乎也没觉得情况不对劲，就只是正常地玩耍着。"},{"op":"image","layer":1,"image":"i11826"},{"op":"text","speaker":"美希","text":"“今天也很和平啊。”"},{"op":"text","speaker":"","text":"野美希满意地小声说道。"},{"op":"text","speaker":"","text":"不不不，怎么看都很奇怪吧。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i39"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":1,"image":"i12286"},{"op":"text","speaker":"良一","text":"“嘿，羽依里，早上好！”"},{"op":"text","speaker":"","text":"一位看起来像是三好青年的男子向我打招呼。"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"羽依里","text":"“……你谁啊？”"},{"op":"image","layer":1,"image":"i12289"},{"op":"text","speaker":"良一","text":"“哎？”"},{"op":"image","layer":257,"image":"i11731"},{"op":"text","speaker":"美希","text":"“鹰原，你在说什么啊？这不是良一吗。”"},{"op":"text","speaker":"羽依里","text":"“不，嗯，虽然长得像良一，但不管是说话方式还是气场都……”"},{"op":"text","speaker":"","text":"说着，我握紧了手上的Hydro Caliber零式。"},{"op":"text","speaker":"","text":"以便随时应对他的脱衣行为。"},{"op":"image","layer":257,"image":"i11689"},{"op":"text","speaker":"美希","text":"“良一一直都有好好穿衣服，真了不起啊。”"},{"op":"text","speaker":"羽依里","text":"“什么!؟”"},{"op":"text","speaker":"","text":"野美希说出了让人难以置信的话。"},{"op":"image","layer":1,"image":"i12285"},{"op":"text","speaker":"良一","text":"“这不是应该的嘛。毕竟除了海水浴场以外的地方，都是禁止脱衣服的。”"},{"op":"text","speaker":"羽依里","text":" “什么!؟” "},{"op":"text","speaker":"","text":"良一他疯了！"},{"op":"image","layer":257,"image":"i11731"},{"op":"image","layer":1,"image":"i12289"},{"op":"text","speaker":"良一","text":"“怎么了，羽依里？”"},{"op":"text","speaker":"羽依里","text":"“……你真的是良一吗？”"},{"op":"image","layer":1,"image":"i12285"},{"op":"text","speaker":"良一","text":"“当然了，我就是三谷良一。你这话说得可真怪呢。”"},{"op":"image","layer":257,"image":"i11728"},{"op":"text","speaker":"美希","text":"“良一可是个遵守公序良俗的模范岛民哦。”"},{"op":"text","speaker":"羽依里","text":"“等等！等一下等一下！”"},{"op":"text","speaker":"","text":"野美希在说什么啊؟!"},{"op":"text","speaker":"","text":"是不是被人抓住了什么把柄？"},{"op":"text","speaker":"","text":"不对，如果是那样的话，良一反而会趁机脱掉衣服吧。"},{"op":"image","layer":257,"image":"i11731"},{"op":"image","layer":1,"image":"i12289"},{"op":"text","speaker":"良一","text":"“羽依里，你到底怎么了？”"},{"op":"image","layer":1,"image":"i12290"},{"op":"text","speaker":"羽依里","text":"“唔……良一你快醒醒！真正的你应该是半裸的吧！”"},{"op":"image","layer":1,"image":"i12282"},{"op":"text","speaker":"良一","text":"“哎？你在说什么啊？”"},{"op":"text","speaker":"羽依里","text":"“快找回你自己啊！别再装下去了！这种碍事的东西，我来帮你脱掉！”"},{"op":"image","layer":1,"image":"i12288"},{"op":"text","speaker":"良一","text":"“等、等一下羽依里！不、不要这样！”"},{"op":"image","layer":1,"image":"i12282"},{"op":"text","speaker":"良一","text":"“这样做会破坏岛上风气的，我可不能……啊，不要脱我衣服！”"},{"op":"text","speaker":"羽依里","text":"“别跟我客气了，像平时那样豪爽地脱掉吧，来！”"},{"op":"image","layer":1,"image":"i12283"},{"op":"text","speaker":"良一","text":"“啊啊啊……怎么能这么强迫人，不要，住手……”"},{"op":"text","speaker":"羽依里","text":"“别、别发出这种恶心的声音！”"},{"op":"text","speaker":"","text":"砰砰！"},{"op":"text","speaker":"羽依里","text":"“呀!!”"},{"op":"text","speaker":"","text":"野美希给我来了一枪。"},{"op":"image","layer":1,"image":"i11789"},{"op":"text","speaker":"美希","text":"“少年团执行部成员怎么能带头破坏风气呢。”"},{"op":"text","speaker":"羽依里","text":"“不是……可是，啊啊啊……”"},{"op":"image","layer":1,"image":"i11792"},{"op":"text","speaker":"美希","text":"“真是的，明明都有我了……”"},{"op":"text","speaker":"","text":"不对劲的人是我吗？"},{"op":"text","speaker":"","text":"可是，但是……"},{"op":"image","layer":257,"image":"i15029"},{"op":"text","speaker":"天善","text":"“足球是我的挚爱！我才不怕呢！”"},{"op":"text","speaker":"羽依里","text":"“嗯？天善……”"},{"op":"image","layer":257,"image":"i15014"},{"op":"text","speaker":"天善","text":"“哈，呼，嘿！”"},{"op":"text","speaker":"","text":"天善……他居然在颠球？"},{"op":"text","speaker":"","text":"不是乒乓球，而是足球？"},{"op":"image","layer":257,"image":"i15029"},{"op":"text","speaker":"天善","text":"“鹰原，传给你了！”"},{"op":"text","speaker":"","text":"砰！他朝我传来一记犀利的球。"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"","text":"我一挥手，把球给打飞了。"},{"op":"image","layer":257,"image":"i15026"},{"op":"text","speaker":"天善","text":"“我的挚爱啊啊啊啊!!!!”"},{"op":"text","speaker":"","text":"他双膝跪地，朝着飞去远方的足球伸长了手。"},{"op":"text","speaker":"羽依里","text":"“天善，你在干什么啊。”"},{"op":"text","speaker":"羽依里","text":"“你的乒乓球呢？”"},{"op":"image","layer":257,"image":"i15017"},{"op":"text","speaker":"天善","text":"“你说……乒乓球？”"},{"op":"image","layer":257,"image":"i15032"},{"op":"text","speaker":"天善","text":"“为什么我要玩那种用木板拍打小球的弱小运动啊。”"},{"op":"text","speaker":"羽依里","text":"“……等等！这话问题大了！话说你真的是天善吗？”"},{"op":"image","layer":1,"image":"i11731"},{"op":"text","speaker":"美希","text":"“你在说什么啊，鹰原。”"},{"op":"image","layer":257,"image":"i12285"},{"op":"text","speaker":"良一","text":"“天善可是岛上数一数二的足球选手啊。”"},{"op":"text","speaker":"羽依里","text":" “哈啊啊啊啊؟!” "},{"op":"image","layer":1,"image":"i11715"},{"op":"text","speaker":"美希","text":"“虽然从来都凑不齐十一个人，所以只能自己一个人特训就是了。”"},{"op":"image","layer":513,"image":"i15014"},{"op":"text","speaker":"天善","text":"“我并不是一个人。”"},{"op":"image","layer":513,"image":"i15035"},{"op":"text","speaker":"天善","text":"“足球便是我的挚爱！我和她在进行两个人的秘密特训！”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"","text":"连天善都变得不对劲了。"},{"op":"text","speaker":"","text":"不脱衣服的良一，踢足球还贬低乒乓球的天善，他们都很奇怪。"},{"op":"text","speaker":"","text":"而且说到底……"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"image","layer":0,"image":"i170"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"大家都没有对这种宛如黑夜的白天感到疑惑，还在过着普通的生活，这本身就很奇怪。"},{"op":"image","layer":7,"image":"i11711"},{"op":"text","speaker":"美希","text":"“鹰原，你今天真的很怪哦？”"},{"op":"image","layer":0,"image":"i39"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":1,"image":"i11712"},{"op":"text","speaker":"美希","text":"“如果你身体不舒服的话，今天我一个人去巡逻也行。”"},{"op":"text","speaker":"","text":"野美希十分担心地看着我的脸。"},{"op":"image","layer":257,"image":"i12281"},{"op":"text","speaker":"良一","text":"“是这样吗，羽依里。要我送你回家吗？”"},{"op":"image","layer":513,"image":"i15041"},{"op":"text","speaker":"天善","text":"“等你恢复精神了，我们再来一起踢球吧。”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"","text":"好、好恶心……"},{"op":"text","speaker":"","text":"虽说我认识这些家伙还没多久，但他们绝对不是这样的。"},{"op":"text","speaker":"","text":"虽然不应该是这样，但他们的本质并没有改变。"},{"op":"text","speaker":"","text":"他们还是非常善良，还是会为某些事物着迷……"},{"op":"text","speaker":"羽依里","text":"“……真的感觉是我不对劲了。”"},{"op":"image","layer":513,"image":"i15038"},{"op":"image","layer":257,"image":"i12289"},{"op":"text","speaker":"良一","text":"“你在说什么啊？我没听懂。”"},{"op":"image","layer":1,"image":"i11709"},{"op":"text","speaker":"美希","text":"“果然很奇怪。怎么办，要回去吗？”"},{"op":"text","speaker":"羽依里","text":"“不，没事的。”"},{"op":"text","speaker":"","text":"没事……吗？"},{"op":"image","layer":1,"image":"i11712"},{"op":"text","speaker":"美希","text":"“嗯……那就好……”"},{"op":"text","speaker":"","text":"还需要再收集点信息。"},{"op":"text","speaker":"羽依里","text":"“我们继续巡逻吧。”"},{"op":"text","speaker":"","text":"得在岛上多转转，把情况弄清楚才行。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i10"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"来到小卖铺，苍和平时一样正在看店。"},{"op":"image","layer":1,"image":"i10112"},{"op":"text","speaker":"苍","text":"“啊，早上好，今天天气真好呢。”"},{"op":"text","speaker":"羽依里","text":"“啊……嗯……”"},{"op":"text","speaker":"","text":"才见面一秒就觉得违和感爆棚。"},{"op":"text","speaker":"","text":"这个温文尔雅的女孩子是什么情况啊……"},{"op":"text","speaker":"羽依里","text":"“……你是……空门苍吗？”"},{"op":"image","layer":1,"image":"i10115"},{"op":"text","speaker":"苍","text":"“是的。请问有什么事吗？”"},{"op":"text","speaker":"羽依里","text":"“那个……我、我要一份刨冰。蓝色夏威夷口味的。”"},{"op":"image","layer":1,"image":"i10112"},{"op":"text","speaker":"苍","text":"“好的，请稍等片刻。”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"image","layer":1,"image":"i11777"},{"op":"text","speaker":"美希","text":"“嗯，苍还是老样子，是鸟白岛上最出色的招牌姑娘啊。”"},{"op":"image","layer":1,"image":"i11771"},{"op":"text","speaker":"美希","text":"“不管嫁到哪家都不会丢脸。”"},{"op":"image","layer":7,"image":"i10284"},{"op":"text","speaker":"苍","text":"“野美希你真是的，老是爱开这些玩笑。”"},{"op":"text","speaker":"","text":"她笑得好甜美。"},{"op":"text","speaker":"","text":"……有点可怕。"},{"op":"image","layer":257,"image":"i10276"},{"op":"text","speaker":"苍","text":"“好了，羽依里，刨冰做好了哦。”"},{"op":"text","speaker":"羽依里","text":"“要一百万日元对吧？”"},{"op":"image","layer":257,"image":"i10118"},{"op":"text","speaker":"苍","text":"“是一百日元哦？”"},{"op":"text","speaker":"羽依里","text":"“还有，糖浆的味道是……”"},{"op":"image","layer":257,"image":"i10112"},{"op":"text","speaker":"苍","text":"“草莓、蜜瓜和柠檬都是用水果榨汁制成的，所以无论哪种都很美味哦。”"},{"op":"text","speaker":"羽依里","text":"“蓝色夏威夷是……”"},{"op":"image","layer":257,"image":"i10115"},{"op":"text","speaker":"苍","text":"“是以波子汽水为基底，加入了菠萝和柠檬果汁，模拟出的一种接近夏威夷鸡尾酒的口味哦。”"},{"op":"text","speaker":"羽依里","text":"“所以岛上的传统呢！”"},{"op":"text","speaker":"","text":"我双手撑在地上大喊道。"},{"op":"image","layer":7,"image":"i11695"},{"op":"text","speaker":"美希","text":"“这家小卖铺的刨冰可是岛上的名产。”"},{"op":"image","layer":257,"image":"i10112"},{"op":"text","speaker":"苍","text":"“请趁融化前享用哦。”"},{"op":"text","speaker":"羽依里","text":"“好的……”"},{"op":"text","speaker":"","text":"接过刨冰……"},{"op":"text","speaker":"","text":"这时我灵光一闪！"},{"op":"text","speaker":"羽依里","text":"“啊，我手滑了――――！”"},{"op":"text","speaker":"","text":"我带着容器一起，把刨冰朝苍扔了过去。"},{"op":"image","layer":515,"image":"i18121"},{"op":"image","layer":0,"image":"i198"},{"op":"set","variable":6714,"value":1},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":1,"image":"i10119"},{"op":"text","speaker":"苍","text":"“哎？”"},{"op":"text","speaker":"","text":"刨冰划出一道抛物线，朝着苍飞去。"},{"op":"image","layer":7,"image":"i11796"},{"op":"text","speaker":"美希","text":"“你在做什么。”"},{"op":"clear","layer":1},{"op":"clear","layer":515},{"op":"clear","layer":768},{"op":"clear","layer":1024},{"op":"image","layer":0,"image":"i10"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"砰！砰！野美希用Hydro Gladiator改击碎了空中的刨冰。"},{"op":"text","speaker":"","text":"但是，还是有一部分刨冰溅到了苍的脖子上。"},{"op":"image","layer":0,"image":"i10"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":1,"image":"i10379"},{"op":"text","speaker":"苍","text":"“嗯嗯……好冷……”"},{"op":"text","speaker":"","text":"她轻轻颤抖着身子，发出了略带妩媚的声音。"},{"op":"text","speaker":"羽依里","text":"“唔唔唔唔……”"},{"op":"text","speaker":"","text":"看到这意想不到的新鲜反应，反倒让我的脸变得通红起来。"},{"op":"image","layer":257,"image":"i11699"},{"op":"text","speaker":"美希","text":"“鹰原你……都对苍干了些什么啊。”"},{"op":"text","speaker":"羽依里","text":"“对、对不起。”"},{"op":"image","layer":257,"image":"i11701"},{"op":"text","speaker":"美希","text":"“你该道歉的对象不是我吧。”"},{"op":"text","speaker":"羽依里","text":"“说得对。对不起，苍。”"},{"op":"image","layer":1,"image":"i10133"},{"op":"text","speaker":"苍","text":"“不，没关系的。”"},{"op":"image","layer":1,"image":"i10130"},{"op":"text","speaker":"苍","text":"“反倒是我……没能好好把刨冰递给你，对不起。”"},{"op":"text","speaker":"","text":"呜啊啊啊啊，罪恶感要爆炸了啊！"},{"op":"text","speaker":"","text":"不对，这个温文尔雅的苍很奇怪啊！还又让人有点心动！"},{"op":"image","layer":257,"image":"i11755"},{"op":"text","speaker":"美希","text":"“唔……鹰原，你这家伙心动了吧。”"},{"op":"text","speaker":"羽依里","text":"“啊？不，没有的事。”"},{"op":"image","layer":257,"image":"i11775"},{"op":"text","speaker":"美希","text":"“竟敢在我面前……”"},{"op":"image","layer":513,"image":"i13167"},{"op":"text","speaker":"白羽","text":"“野美希，不要碍事。”"},{"op":"text","speaker":"","text":"这时，又出现了一个认识的女孩子。"},{"op":"text","speaker":"","text":"然而，她才刚来就已经很奇怪了。"},{"op":"text","speaker":"羽依里","text":"“白羽……？”"},{"op":"text","speaker":"","text":"她刚才对野美希说了什么？"},{"op":"image","layer":513,"image":"i13164"},{"op":"text","speaker":"白羽","text":"“嗯？啊，原来死开也在啊？”"},{"op":"text","speaker":"羽依里","text":"“等下，怎么上来就叫我死开!؟”"},{"op":"image","layer":513,"image":"i13069"},{"op":"text","speaker":"白羽","text":"“哈啊～今天你的脸还是那么的死开呢。”"},{"op":"text","speaker":"羽依里","text":"“等下等下，为什么你现在张口闭口都是死开啊？”"},{"op":"image","layer":513,"image":"i13065"},{"op":"text","speaker":"白羽","text":"“因为，你的存在本身就很死开啊。”"},{"op":"text","speaker":"羽依里","text":"“哦……哦哦……”"},{"op":"text","speaker":"","text":"怎么回事，这个浑身带刺走到哪扎到哪的白羽又是什么情况？"},{"op":"image","layer":513,"image":"i13167"},{"op":"text","speaker":"白羽","text":"“说起来苍，西瓜棒给我备好了吗？”"},{"op":"image","layer":1,"image":"i10285"},{"op":"text","speaker":"苍","text":"“是，是的，白羽小姐，这是今天份的西瓜棒。”"},{"op":"image","layer":513,"image":"i13217"},{"op":"text","speaker":"白羽","text":"“嗯嗯，苍一直都这么乖呢。”"},{"op":"image","layer":1,"image":"i10112"},{"op":"text","speaker":"苍","text":"“是的，只要白羽小姐满意，我也会高兴的。”"},{"op":"text","speaker":"羽依里","text":"“这座岛的阶级制度怎么回事啊؟!”"},{"op":"image","layer":513,"image":"i13216"},{"op":"text","speaker":"白羽","text":"“死开。”"},{"op":"text","speaker":"羽依里","text":"“呃啊……”"},{"op":"text","speaker":"","text":"她的死开说得像呼吸一样轻松……"},{"op":"image","layer":257,"image":"i11826"},{"op":"text","speaker":"美希","text":"“白羽是这座岛上唯一有资格使用死开的人。”"},{"op":"text","speaker":"羽依里","text":"“那是什么疯狂的资格啊……”"},{"op":"image","layer":257,"image":"i11877"},{"op":"text","speaker":"美希","text":"“不过，说得确实有点过分了。”"},{"op":"text","speaker":"羽依里","text":"“哦，不愧是岛上的风纪委员！再多说两句！”"},{"op":"image","layer":257,"image":"i11879"},{"op":"text","speaker":"美希","text":"“鹰原的脸并没有很死开。”"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"image","layer":257,"image":"i11872"},{"op":"text","speaker":"美希","text":"“不如说很帅气不是吗。”"},{"op":"text","speaker":"羽依里","text":"“你怎么也突然说起了怪话؟!”"},{"op":"image","layer":257,"image":"i11869"},{"op":"text","speaker":"美希","text":"“不高不低刚刚好的鼻子。”"},{"op":"image","layer":257,"image":"i11875"},{"op":"text","speaker":"美希","text":"“带着几分慵懒的迷糊眼睛。”"},{"op":"image","layer":257,"image":"i11872"},{"op":"text","speaker":"美希","text":"“永远笑么嘻嘻合不拢的松弛嘴角。”"},{"op":"text","speaker":"羽依里","text":"“这不是一点优点都没有吗？”"},{"op":"image","layer":257,"image":"i11874"},{"op":"text","speaker":"美希","text":"“无论从哪个角度看，都是百分百的帅哥。”"},{"op":"text","speaker":"羽依里","text":"“过程和结论完全对不上啊！”"},{"op":"image","layer":1,"image":"i13214"},{"op":"text","speaker":"白羽","text":"“不愧是野美希。你那坚定不移的内心非常值得敬佩呢。”"},{"op":"image","layer":257,"image":"i11826"},{"op":"text","speaker":"美希","text":"“嗯，我也觉得白羽你那种不论待谁都表里如一的性格很了不起。”"},{"op":"image","layer":1,"image":"i13217"},{"op":"text","speaker":"","text":"两人满意地点头握手。"},{"op":"text","speaker":"","text":"这是什么啊？"},{"op":"text","speaker":"","text":"话说回来……野美希，在别人面前都说了些什么啊？"},{"op":"text","speaker":"","text":"居然这么毫无保留地夸我。"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"","text":"……她是在夸我吧？"},{"op":"set","variable":26027,"value":1},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"image","layer":0,"image":"i516"},{"op":"set","variable":6714,"value":1},{"op":"set","variable":26027,"value":0},{"op":"text","speaker":"","text":"天空依然暗得像夜里一样。"},{"op":"text","speaker":"","text":"但是，生活在岛上的众人，行动却和白天没什么区别。"},{"op":"text","speaker":"","text":"只是，很多地方都很怪而已。"},{"op":"text","speaker":"","text":"难道大家串通成一起，想要整我？"},{"op":"image","layer":7,"image":"i11730"},{"op":"text","speaker":"美希","text":"“好了，我们去下个地方吧，鹰原。”"},{"op":"text","speaker":"羽依里","text":"“哎？啊，好……”"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i35"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"和苍还有白羽分开后，我们继续岛上的巡逻。"},{"op":"text","speaker":"","text":"遇到少年团以外的岛民，也都像平常一样随和地互相打了招呼。"},{"op":"image","layer":1,"image":"i11831"},{"op":"text","speaker":"美希","text":"“呵呵呵。”"},{"op":"text","speaker":"羽依里","text":"“怎么了？”"},{"op":"image","layer":1,"image":"i11829"},{"op":"text","speaker":"美希","text":"“嗯，我在想今天岛上也很和平呢。”"},{"op":"text","speaker":"羽依里","text":"“嗯，是啊，很和平。”"},{"op":"text","speaker":"","text":"手里拿着水枪，却一次都没有开火，巡逻就这样结束了。"},{"op":"text","speaker":"","text":"虽然感觉少了点什么，不过大概这才是该有的样子吧。"},{"op":"image","layer":1,"image":"i11834"},{"op":"text","speaker":"美希","text":"“好了，时间差不多了。”"},{"op":"text","speaker":"","text":"野美希看着天空说道。"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“今天就到此为止吧。”"},{"op":"text","speaker":"羽依里","text":"“是吗？”"},{"op":"image","layer":1,"image":"i11696"},{"op":"text","speaker":"美希","text":"“嗯，也差不多该回家了。”"},{"op":"image","layer":1,"image":"i11689"},{"op":"text","speaker":"美希","text":"“……在等着。”"},{"op":"text","speaker":"","text":"开头的那个词我有点没听清楚。"},{"op":"text","speaker":"","text":"――但是……"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":1539},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"就在那一瞬间，视野突然变得明亮起来。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]