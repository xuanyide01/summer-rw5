[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i158"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"第二天。"},{"op":"text","speaker":"","text":"我们一起把食材和器材搬到了港口来。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i1"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"摆摊的大叔","text":"“喂，你们这是准备干什么？”"},{"op":"image","layer":1,"image":"i10112"},{"op":"text","speaker":"苍","text":"“我们想摆摊。”"},{"op":"text","speaker":"摆摊的大叔","text":"“什么？”"},{"op":"text","speaker":"摆摊的大叔","text":"“摆是可以，但你们有公所的许可吗？”"},{"op":"image","layer":1,"image":"i10146"},{"op":"image","layer":257,"image":"i13259"},{"op":"text","speaker":"白羽","text":"“啊，没有。”"},{"op":"text","speaker":"摆摊的大叔","text":"“喂喂。”"},{"op":"text","speaker":"摆摊的大叔","text":"“算了。既然没有，那就算作是我的帮工吧。”"},{"op":"image","layer":1,"image":"i10115"},{"op":"image","layer":257,"image":"i13238"},{"op":"text","speaker":"苍","text":"“可以吗？”"},{"op":"image","layer":513,"image":"i15038"},{"op":"text","speaker":"天善","text":"“有你这么帮竞争对手的吗。”"},{"op":"text","speaker":"摆摊的大叔","text":"“什么竞争对手。”"},{"op":"text","speaker":"摆摊的大叔","text":"“你们又不是想一直干下去吧？”"},{"op":"image","layer":1,"image":"i13291"},{"op":"text","speaker":"白羽","text":"“对。”"},{"op":"text","speaker":"摆摊的大叔","text":"“我看看，是卖这个吗？”"},{"op":"text","speaker":"摆摊的大叔","text":"“加油干吧。”"},{"op":"image","layer":1,"image":"i13337"},{"op":"text","speaker":"","text":"好人啊。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i412"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"1小时后。"},{"op":"text","speaker":"","text":"准备妥善，开始烹制。"},{"op":"text","speaker":"","text":"充满港口的香气和新摊子的招牌，自然而然地就将人们的目光吸引了过来。"},{"op":"text","speaker":"家庭主妇A","text":"“那是什么？”"},{"op":"text","speaker":"家庭主妇B","text":"“新摊子？”"},{"op":"text","speaker":"家庭主妇C","text":"“好香的味道。”"},{"op":"image","layer":0,"image":"i1"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"情报似乎转眼间就传遍了这小小的岛。"},{"op":"text","speaker":"","text":"中午刚过，就络绎不绝地有客人上门来了。"},{"op":"text","speaker":"","text":"多到让我不禁心想，这岛上居然有这么多人啊。"},{"op":"text","speaker":"","text":"是不是几乎所有岛民都来了？"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"if","truth":false,"target":79,"value":["||",["==",["v",61],1],["==",["v",66],1],["==",["v",69],1]]},{"op":"image","layer":0,"image":"i1"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13238"},{"op":"set","variable":30013,"value":15},{"op":"text","speaker":"白羽","text":"“好了。”"},{"op":"image","layer":1,"image":"i13299"},{"op":"text","speaker":"白羽","text":"“这是最后一份。”"},{"op":"image","layer":1,"image":"i13291"},{"op":"text","speaker":"白羽","text":"“材料，也都用完了。”"},{"op":"image","layer":257,"image":"i15029"},{"op":"text","speaker":"天善","text":"“噢噢噢！”"},{"op":"if","truth":false,"target":75,"value":["||",["==",["v",61],1],["==",["v",66],1],["==",["v",69],1]]},{"op":"image","layer":257,"image":"i15038"},{"op":"image","layer":513,"image":"i11753"},{"op":"goto","target":78},{"op":"image","layer":257,"image":"i15038"},{"op":"image","layer":1,"image":"i13235"},{"op":"image","layer":513,"image":"i11780"},{"op":"goto","target":93},{"op":"image","layer":0,"image":"i1"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“唔。”"},{"op":"text","speaker":"羽依里","text":"“也就这样了吧。”"},{"op":"text","speaker":"","text":"由于好奇而聚集过来的人群也基本散完了。"},{"op":"text","speaker":"","text":"虽然材料还有剩，但也是时候收摊了。"},{"op":"if","truth":false,"target":90,"value":["||",["==",["v",61],1],["==",["v",66],1],["==",["v",69],1]]},{"op":"image","layer":1,"image":"i15038"},{"op":"image","layer":257,"image":"i13291"},{"op":"image","layer":513,"image":"i11753"},{"op":"goto","target":93},{"op":"image","layer":1,"image":"i15038"},{"op":"image","layer":257,"image":"i13235"},{"op":"image","layer":513,"image":"i11780"},{"op":"text","speaker":"美希","text":"“那最终，卖了多少钱？”"},{"op":"if","truth":false,"target":115,"value":["||",["==",["v",67],1],["==",["v",65],1],["==",["v",70],1]]},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"image","layer":0,"image":"i1"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15038"},{"op":"image","layer":257,"image":"i13241"},{"op":"image","layer":513,"image":"i11780"},{"op":"text","speaker":"白羽","text":"“5千日元。”"},{"op":"image","layer":1,"image":"i15017"},{"op":"image","layer":513,"image":"i11769"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"真是悲伤的结果。"},{"op":"text","speaker":"","text":"虽然来看热闹的人很多，但都只是看看并没有多少人买。"},{"op":"image","layer":769,"image":"i10396"},{"op":"text","speaker":"苍","text":"“好了，这也算是努力的成果吧。”"},{"op":"image","layer":1,"image":"i15014"},{"op":"text","speaker":"天善","text":"“德田他应该也会认同我们的努力吧。”"},{"op":"text","speaker":"羽依里","text":"“希望吧。”"},{"op":"goto","target":181},{"op":"if","truth":false,"target":132,"value":["||",["==",["v",62],1],["==",["v",63],1],["==",["v",64],1],["==",["v",68],1]]},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"image","layer":0,"image":"i1"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15038"},{"op":"image","layer":257,"image":"i13238"},{"op":"image","layer":513,"image":"i11780"},{"op":"text","speaker":"白羽","text":"“2万日元。”"},{"op":"image","layer":1,"image":"i15032"},{"op":"text","speaker":"天善","text":"“虽说没达到计划数额……”"},{"op":"image","layer":769,"image":"i12180"},{"op":"text","speaker":"良一","text":"“也做得够好了吧。”"},{"op":"image","layer":1,"image":"i10267"},{"op":"text","speaker":"苍","text":"“接下来，就看交涉了。”"},{"op":"goto","target":181},{"op":"if","truth":false,"target":181,"value":["||",["==",["v",61],1],["==",["v",66],1],["==",["v",69],1]]},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"image","layer":0,"image":"i1"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15038"},{"op":"image","layer":257,"image":"i13294"},{"op":"image","layer":513,"image":"i11753"},{"op":"text","speaker":"白羽","text":"“5万日元多一点……”"},{"op":"image","layer":769,"image":"i12168"},{"op":"image","layer":513,"image":"i11773"},{"op":"text","speaker":"美希·良一","text":"“噢噢噢！”"},{"op":"image","layer":513,"image":"i11750"},{"op":"text","speaker":"美希","text":"“达成目标了啊。”"},{"op":"text","speaker":"羽依里","text":"“想不到仅一天就能达成目标。”"},{"op":"text","speaker":"","text":"白羽手上拿着放有收入的信封。"},{"op":"image","layer":1,"image":"i15008"},{"op":"image","layer":257,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“请拿去。”"},{"op":"image","layer":1,"image":"i15017"},{"op":"text","speaker":"天善","text":"“……唔唔。”"},{"op":"image","layer":257,"image":"i13322"},{"op":"text","speaker":"白羽","text":"“？”"},{"op":"image","layer":1,"image":"i15023"},{"op":"text","speaker":"天善","text":"“这钱我不能收。”"},{"op":"image","layer":1,"image":"i15044"},{"op":"text","speaker":"天善","text":"“到头来我自己根本什么都没做。”"},{"op":"image","layer":1,"image":"i15032"},{"op":"text","speaker":"天善","text":"“这几乎全是靠白羽赚到的。”"},{"op":"image","layer":1,"image":"i15011"},{"op":"text","speaker":"天善","text":"“这钱应该由白羽收下。”"},{"op":"image","layer":257,"image":"i13307"},{"op":"text","speaker":"白羽","text":"“咦？”"},{"op":"image","layer":1,"image":"i15014"},{"op":"text","speaker":"天善","text":"“就用这钱去把你在意的卷毛拉直吧。”"},{"op":"image","layer":257,"image":"i13343"},{"op":"text","speaker":"白羽","text":"“!؟”"},{"op":"image","layer":257,"image":"i13319"},{"op":"text","speaker":"白羽","text":"“我什么时候说过我在意卷毛了？”"},{"op":"image","layer":1,"image":"i15017"},{"op":"text","speaker":"天善","text":"“没说过吗？是我记错了吗……在意卷毛的，可能是我表妹吧……”"},{"op":"text","speaker":"羽依里","text":"“别婆婆妈妈了快去买吧。”"},{"op":"text","speaker":"羽依里","text":"“都赚回来了，你说不要，只会难为白羽。”"},{"op":"image","layer":257,"image":"i13235"},{"op":"text","speaker":"白羽","text":"“嗯。”"},{"op":"image","layer":1,"image":"i15026"},{"op":"text","speaker":"天善","text":"“好，好吧。”"},{"op":"goto","target":181},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"clear","layer":769},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i31"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i12162"},{"op":"text","speaker":"良一","text":"“有客到。”"},{"op":"image","layer":1,"image":"i12180"},{"op":"text","speaker":"良一","text":"“说好的钱我们带来了。”"},{"op":"text","speaker":"德田","text":"“什么!؟”"},{"op":"text","speaker":"德田","text":"“你们哪里凑来的？”"},{"op":"text","speaker":"德田","text":"“我们店可不收脏钱。”"},{"op":"image","layer":1,"image":"i12153"},{"op":"text","speaker":"良一","text":"“说什么傻话。”"},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“是我们合力赚来的。”"},{"op":"image","layer":257,"image":"i15143"},{"op":"text","speaker":"天善","text":"“跟伙伴们一起！”"},{"op":"text","speaker":"德田","text":"“哼，可疑的家伙。”"},{"op":"image","layer":257,"image":"i15065"},{"op":"image","layer":1,"image":"i12147"},{"op":"text","speaker":"良一","text":"“确切地说基本是靠白羽赚来的。”"},{"op":"text","speaker":"德田","text":"“什么？”"},{"op":"text","speaker":"德田","text":"“鸣濑白羽赚的？”"},{"op":"image","layer":257,"image":"i15068"},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“主要是她，努力帮了很多忙赚到的。”"},{"op":"text","speaker":"德田","text":"“……”"},{"op":"text","speaker":"德田","text":"“嘁。”"},{"op":"text","speaker":"德田","text":"“那这钱我可不能收。”"},{"op":"image","layer":257,"image":"i15017"},{"op":"image","layer":1,"image":"i12150"},{"op":"text","speaker":"天善","text":"“喂，这跟说好的不一样啊。”"},{"op":"text","speaker":"德田","text":"“少废话快把球台带走吧。”"},{"op":"image","layer":257,"image":"i15026"},{"op":"image","layer":1,"image":"i12174"},{"op":"text","speaker":"天善","text":"“你说什么？”"},{"op":"text","speaker":"德田","text":"“钱不要了，球台送你们。”"},{"op":"image","layer":257,"image":"i15017"},{"op":"text","speaker":"天善","text":"“为什么？”"},{"op":"image","layer":1,"image":"i12141"},{"op":"text","speaker":"良一","text":"“你看上白羽了？”"},{"op":"text","speaker":"德田","text":"“不是。”"},{"op":"image","layer":257,"image":"i15140"},{"op":"text","speaker":"天善","text":"“那是看上我了？”"},{"op":"text","speaker":"德田","text":"“有病啊！”"},{"op":"image","layer":1,"image":"i12150"},{"op":"text","speaker":"良一","text":"“那你是看上谁了？”"},{"op":"text","speaker":"羽依里","text":"“――呃。”"},{"op":"text","speaker":"羽依里","text":"“莫非是我……”"},{"op":"text","speaker":"德田","text":"“所以说你们有病吧!؟”"},{"op":"text","speaker":"德田","text":"“才不是因为这种理由！”"},{"op":"text","speaker":"德田","text":"“我们家之所以能在这座岛上做生意，都是托鸣濑家的福。”"},{"op":"text","speaker":"羽依里","text":"“什么意思？”"},{"op":"text","speaker":"德田","text":"“不知道。但是，总之这就是事实。”"},{"op":"text","speaker":"德田","text":"“要是被我爹知道我收了鸣濑的钱，他会打我的。”"},{"op":"text","speaker":"德田","text":"“乒乓球台就在那，你们带走吧。”"},{"op":"if","truth":false,"target":252,"value":["||",["==",["v",67],1],["==",["v",65],1],["==",["v",70],1]]},{"op":"text","speaker":"德田","text":"“不过真没想到，你们居然凑到了4万日元。”"},{"op":"text","speaker":"德田","text":"“挺厉害的啊。我对你们改观了。”"},{"op":"text","speaker":"羽依里","text":"“不，这钱……”"},{"op":"text","speaker":"德田","text":"“嗯？”"},{"op":"text","speaker":"","text":"由于愧疚，我将信封交给他看。"},{"op":"text","speaker":"德田","text":"“这是……5千日元……”"},{"op":"text","speaker":"德田","text":" “你当我们德田傻吗！” "},{"op":"text","speaker":"羽依里","text":"“对不起。”"},{"op":"goto","target":252},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":1},{"op":"image","layer":0,"image":"i34"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"羽依里","text":"“那么……”"},{"op":"text","speaker":"","text":"看着这个被半强塞过来的乒乓球台。"},{"op":"text","speaker":"羽依里","text":"“我们得把它运到山上那破屋去吗？”"},{"op":"image","layer":1,"image":"i13418"},{"op":"text","speaker":"白羽","text":"“怎么运？”"},{"op":"image","layer":257,"image":"i15017"},{"op":"text","speaker":"天善","text":"“要是有辆推车就好了。”"},{"op":"image","layer":1,"image":"i12147"},{"op":"text","speaker":"良一","text":"“可这块头，放得上去吗？”"},{"op":"text","speaker":"羽依里","text":"“能不能找人开辆小货车过来，既然有仓库那应该有路通车的吧。”"},{"op":"image","layer":257,"image":"i15008"},{"op":"image","layer":1,"image":"i12174"},{"op":"text","speaker":"良一","text":"“以前是有，但在遇上滑坡后，就一直没人管了。”"},{"op":"text","speaker":"羽依里","text":"“原来那张乒乓球台是怎么运上去的？”"},{"op":"image","layer":257,"image":"i15014"},{"op":"text","speaker":"天善","text":"“那是本来就放在那里的。”"},{"op":"image","layer":1,"image":"i12150"},{"op":"text","speaker":"良一","text":"“看来只能由我们抬上去了？”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i163"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"羽依里","text":"“嘿咻。”"},{"op":"image","layer":7,"image":"i13318"},{"op":"text","speaker":"白羽","text":"“嘿咻。”"},{"op":"image","layer":7,"image":"i10145"},{"op":"text","speaker":"苍","text":"“……呃？”"},{"op":"image","layer":7,"image":"i10134"},{"op":"text","speaker":"苍","text":"“喂喂，怎么能让女孩子干这种活。”"},{"op":"image","layer":7,"image":"i12161"},{"op":"text","speaker":"良一","text":"“苍，你也过来帮忙。”"},{"op":"image","layer":7,"image":"i10297"},{"op":"text","speaker":"苍","text":"“不是吧。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i41"},{"op":"set","variable":6714,"value":4},{"op":"image","layer":1,"image":"i13400"},{"op":"text","speaker":"白羽","text":"“嘿咻。”"},{"op":"image","layer":257,"image":"i10334"},{"op":"text","speaker":"苍","text":"“咻……”"},{"op":"image","layer":513,"image":"i11721"},{"op":"text","speaker":"美希","text":"“为什么连我……都要帮干这种活。”"},{"op":"image","layer":7,"image":"i15013"},{"op":"text","speaker":"天善","text":"“当作特训的话，不是正好吗？”"},{"op":"image","layer":257,"image":"i10331"},{"op":"text","speaker":"苍","text":"“只有你会觉得正好。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i23"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13253"},{"op":"text","speaker":"白羽","text":"“哈啊，哈啊。”"},{"op":"image","layer":257,"image":"i10205"},{"op":"text","speaker":"苍","text":"“到了～”"},{"op":"text","speaker":"","text":"总算，顺利把这张高档厚实的乒乓球台搬到了棚屋里。"},{"op":"text","speaker":"","text":"还挺壮观的。"},{"op":"image","layer":513,"image":"i15023"},{"op":"text","speaker":"天善","text":"“各位……”"},{"op":"text","speaker":"天善","text":"“谢谢你们。”"},{"op":"text","speaker":"","text":"天善站在乒乓球台前，一副无限感慨的样子。"},{"op":"image","layer":513,"image":"i15135"},{"op":"text","speaker":"天善","text":"“为我付出这么多。”"},{"op":"text","speaker":"羽依里","text":"“别哭啊。”"},{"op":"image","layer":1,"image":"i10168"},{"op":"text","speaker":"苍","text":"“不过还真累死了。”"},{"op":"image","layer":257,"image":"i12159"},{"op":"text","speaker":"良一","text":"“我就在这住了。”"},{"op":"image","layer":1,"image":"i11758"},{"op":"text","speaker":"美希","text":"“喂，那可不行。”"},{"op":"image","layer":257,"image":"i12150"},{"op":"text","speaker":"良一","text":"“为什么啊，我经常住这的。”"},{"op":"image","layer":1,"image":"i11763"},{"op":"text","speaker":"美希","text":"“你说什么!؟”"},{"op":"image","layer":257,"image":"i12168"},{"op":"text","speaker":"良一","text":"“说漏嘴了。”"},{"op":"image","layer":513,"image":"i10168"},{"op":"text","speaker":"苍","text":"“不过我也是，根本没力气现在下山。累死了。”"},{"op":"image","layer":1,"image":"i13426"},{"op":"text","speaker":"白羽","text":"“嗯。”"},{"op":"image","layer":257,"image":"i11769"},{"op":"text","speaker":"美希","text":"“真是的，服了你们了。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i171"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"我们边休息边闲聊，不知不觉外面就变得一片黑暗。"},{"op":"text","speaker":"","text":"谁也没有回去，大家一起在仓库里，发着呆。"},{"op":"text","speaker":"","text":"……星星出来了。"},{"op":"text","speaker":"","text":"也许是由于在山上看的缘故，感觉异常接近。"},{"op":"image","layer":7,"image":"i12161"},{"op":"text","speaker":"良一","text":"“我以前一直都没在意过……可这么一看，好漂亮啊。”"},{"op":"text","speaker":"羽依里","text":"“用这星空招揽人来观光的话，能赚到钱了。”"},{"op":"image","layer":7,"image":"i12187"},{"op":"text","speaker":"良一","text":"“那就能买很多乒乓球台了。”"},{"op":"if","truth":false,"target":377,"value":["||",["==",["v",61],1],["==",["v",66],1],["==",["v",69],1]]},{"op":"image","layer":7,"image":"i15040"},{"op":"text","speaker":"天善","text":"“白羽的卷毛也能拉直。”"},{"op":"image","layer":7,"image":"i13256"},{"op":"text","speaker":"白羽","text":"“我才没在意。”"},{"op":"goto","target":377},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i24"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“说起来，赚到的那些钱。”"},{"op":"text","speaker":"","text":"因为乒乓球台是送的，所以钱全留在手上了。"},{"op":"text","speaker":"羽依里","text":"“我觉得应该给白羽，你们呢？”"},{"op":"text","speaker":"","text":"实际上就是白羽赚的，而且乒乓球台好像也是靠白羽的关系才免费送的。"},{"op":"image","layer":1,"image":"i13343"},{"op":"text","speaker":"白羽","text":"“……唉唉？”"},{"op":"image","layer":1,"image":"i13304"},{"op":"text","speaker":"白羽","text":"“我不要。”"},{"op":"image","layer":7,"image":"i15037"},{"op":"text","speaker":"天善","text":"“不，还请你收下吧。”"},{"op":"image","layer":7,"image":"i12143"},{"op":"text","speaker":"良一","text":"“嗯。”"},{"op":"image","layer":1,"image":"i13373"},{"op":"text","speaker":"白羽","text":"“……可是。”"},{"op":"image","layer":1,"image":"i13418"},{"op":"text","speaker":"白羽","text":"“可我，用不到这么多钱。”"},{"op":"text","speaker":"羽依里","text":"“你想怎么花都可以。”"},{"op":"image","layer":1,"image":"i13411"},{"op":"text","speaker":"白羽","text":"“买股票？”"},{"op":"text","speaker":"羽依里","text":"“你，你想买就买吧。”"},{"op":"image","layer":1,"image":"i13304"},{"op":"text","speaker":"白羽","text":"“果然……还是用不到。”"},{"op":"if","truth":false,"target":415,"value":["||",["==",["v",61],1],["==",["v",66],1],["==",["v",69],1]]},{"op":"text","speaker":"羽依里","text":"“我记得白羽你很在意卷毛吧？”"},{"op":"image","layer":1,"image":"i13296"},{"op":"text","speaker":"白羽","text":"“……没在意。”"},{"op":"text","speaker":"羽依里","text":"“咦，是谁说的来着了？”"},{"op":"image","layer":1,"image":"i13408"},{"op":"text","speaker":"白羽","text":"“天善说的，但我已经否认了。请你不要记得那么模糊。”"},{"op":"text","speaker":"羽依里","text":"“抱歉，那、那就。”"},{"op":"goto","target":416},{"op":"text","speaker":"羽依里","text":"“就用它。”"},{"op":"text","speaker":"羽依里","text":"“买一大堆西瓜棒吃吧。”"},{"op":"image","layer":1,"image":"i13274"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"image","layer":1,"image":"i13280"},{"op":"text","speaker":"白羽","text":"“那太没礼貌了。”"},{"op":"text","speaker":"","text":"没礼貌？"},{"op":"text","speaker":"","text":"对西瓜棒？"},{"op":"image","layer":1,"image":"i13265"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"image","layer":1,"image":"i13259"},{"op":"text","speaker":"白羽","text":"“那，我就要一点点。”"},{"op":"image","layer":1,"image":"i13274"},{"op":"text","speaker":"白羽","text":"“全部我不收。”"},{"op":"image","layer":257,"image":"i11753"},{"op":"text","speaker":"美希","text":"“行吧。那剩下的，就算进少年团的会费里好了。”"},{"op":"image","layer":1,"image":"i12150"},{"op":"text","speaker":"良一","text":"“这么用也太无聊了。”"},{"op":"image","layer":257,"image":"i11789"},{"op":"text","speaker":"美希","text":"“你说什么？”"},{"op":"image","layer":1,"image":"i12220"},{"op":"text","speaker":"良一","text":"“没，没说。”"},{"op":"image","layer":513,"image":"i13322"},{"op":"text","speaker":"白羽","text":"“可，要怎么花才好啊？”"},{"op":"image","layer":1,"image":"i10290"},{"op":"text","speaker":"苍","text":"“这岛上确实也没有让人花钱的地方。”"},{"op":"image","layer":1,"image":"i10392"},{"op":"text","speaker":"苍","text":"“要不，你搭船到本土那边看看？”"},{"op":"image","layer":1,"image":"i10394"},{"op":"text","speaker":"苍","text":"“到那边也许可以找到什么想买的。”"},{"op":"image","layer":513,"image":"i13294"},{"op":"text","speaker":"白羽","text":"“唉唉。”"},{"op":"image","layer":513,"image":"i13304"},{"op":"text","speaker":"白羽","text":"“可我几乎没一个人去过。”"},{"op":"image","layer":257,"image":"i11715"},{"op":"text","speaker":"美希","text":"“鹰原你陪她去怎样？”"},{"op":"text","speaker":"羽依里","text":"“我？”"},{"op":"image","layer":1,"image":"i13334"},{"op":"text","speaker":"白羽","text":"“唉……”"},{"op":"image","layer":1,"image":"i13322"},{"op":"text","speaker":"白羽","text":"“可、可以吗。”"},{"op":"text","speaker":"羽依里","text":"“我可以啊。”"},{"op":"image","layer":1,"image":"i13411"},{"op":"text","speaker":"白羽","text":"“……是，是吗？”"},{"op":"image","layer":1,"image":"i13376"},{"op":"text","speaker":"白羽","text":"“那就好。”"},{"op":"image","layer":257,"image":"i12180"},{"op":"text","speaker":"良一","text":"“哼。约会啊。”"},{"op":"image","layer":1,"image":"i13356"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"image","layer":1,"image":"i13359"},{"op":"text","speaker":"白羽","text":"“请恕我拒绝。”"},{"op":"text","speaker":"羽依里","text":"“啊，嗯。”"},{"op":"image","layer":257,"image":"i12197"},{"op":"text","speaker":"","text":"她有些慌张地跑着离去了。"},{"op":"image","layer":257,"image":"i12147"},{"op":"text","speaker":"良一","text":"“是我多嘴了吗？”"},{"op":"text","speaker":"羽依里","text":"“天，天知道。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"text","speaker":"","text":"回到家――。"},{"op":"image","layer":0,"image":"i79"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“这就是今天发生的事。”"},{"op":"image","layer":1,"image":"i11660"},{"op":"text","speaker":"镜子","text":"“唉――”"},{"op":"image","layer":1,"image":"i11679"},{"op":"text","speaker":"镜子","text":"“乒乓球台的话，明明仓库里就有。”"},{"op":"text","speaker":"羽依里","text":"“唉――”"},{"op":"text","speaker":"羽依里","text":"“外婆的遗物，到底都有些什么？”"},{"op":"text","speaker":"羽依里","text":"“她生前是不是干废品回收的啊。”"},{"op":"image","layer":1,"image":"i11670"},{"op":"text","speaker":"镜子","text":"“啊哈哈，她这人就是什么都喜欢。”"},{"op":"text","speaker":"羽依里","text":"“是这样的吗……”"},{"op":"if","truth":false,"target":496,"value":["==",["v",6003],1]},{"op":"callScene","scene":71,"target":2},{"op":"goto","target":515},{"op":"if","truth":false,"target":499,"value":["==",["v",6003],2]},{"op":"callScene","scene":70,"target":2},{"op":"goto","target":515},{"op":"image","layer":7,"image":"i15324"},{"op":"text","speaker":"羽未","text":"“鹰原哥。”"},{"op":"image","layer":1,"image":"i11666"},{"op":"text","speaker":"","text":"啊，羽未在叫我。"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15406"},{"op":"text","speaker":"羽未","text":"“有电话找你。”"},{"op":"text","speaker":"羽依里","text":"“电话？谁打的……”"},{"op":"text","speaker":"","text":"羽未只是轻轻怂了怂肩。"},{"op":"image","layer":1,"image":"i15496"},{"op":"text","speaker":"羽未","text":"“天知道。”"},{"op":"text","speaker":"羽依里","text":"“？”"},{"op":"text","speaker":"羽依里","text":"“你好，我是鹰原。”"},{"op":"text","speaker":"؟؟؟","text":"‘……’"},{"op":"text","speaker":"","text":"片刻的沉默。"},{"op":"text","speaker":"؟؟؟","text":"‘您好，我的名字叫鸣濑白羽。’"},{"op":"text","speaker":"羽依里","text":"“啊……谁？”"},{"op":"text","speaker":"","text":"那陌生的语气使我困惑。名字叫鸣濑白羽。"},{"op":"image","layer":7,"image":"i13234"},{"op":"text","speaker":"白羽","text":"‘我名字叫鸣濑白羽。’"},{"op":"text","speaker":"羽依里","text":"“哦。”"},{"op":"text","speaker":"羽依里","text":"“这不是白羽吗。”"},{"op":"image","layer":7,"image":"i13273"},{"op":"text","speaker":"白羽","text":"‘都这么说了的。’"},{"op":"text","speaker":"羽依里","text":"“怎么了？”"},{"op":"image","layer":7,"image":"i13252"},{"op":"text","speaker":"白羽","text":"‘……请问。’"},{"op":"image","layer":7,"image":"i13252"},{"op":"text","speaker":"白羽","text":"‘您还好吗？’"},{"op":"image","layer":7,"image":"i13279"},{"op":"text","speaker":"白羽","text":"‘我一切安好。’"},{"op":"text","speaker":"羽依里","text":"“……为什么要用这么僵硬的语气。”"},{"op":"text","speaker":"","text":"大概是不习惯打电话紧张了。"},{"op":"image","layer":7,"image":"i13404"},{"op":"text","speaker":"白羽","text":"‘对，对不……起。’"},{"op":"image","layer":7,"image":"i13369"},{"op":"text","speaker":"白羽","text":"‘话说。’"},{"op":"image","layer":7,"image":"i13417"},{"op":"text","speaker":"白羽","text":"‘您明天有空吗？’"},{"op":"text","speaker":"羽依里","text":"“我每天都是除了闲逛就没事干了。”"},{"op":"image","layer":7,"image":"i13372"},{"op":"text","speaker":"白羽","text":"‘那么。’"},{"op":"image","layer":7,"image":"i13410"},{"op":"text","speaker":"白羽","text":"‘明天。’"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"image","layer":7,"image":"i13372"},{"op":"text","speaker":"白羽","text":"‘请允许我招待您用餐。’"},{"op":"text","speaker":"","text":"招待我？"},{"op":"text","speaker":"羽依里","text":"“哦。”"},{"op":"text","speaker":"羽依里","text":"“那我去钓鱼。”"},{"op":"text","speaker":"羽依里","text":"“白羽你来烹制。”"},{"op":"image","layer":7,"image":"i13417"},{"op":"text","speaker":"白羽","text":"‘嗯。’"},{"op":"image","layer":7,"image":"i13404"},{"op":"text","speaker":"白羽","text":"‘不是。’"},{"op":"image","layer":7,"image":"i13369"},{"op":"text","speaker":"白羽","text":"‘我不做。’"},{"op":"text","speaker":"羽依里","text":"“那我做？”"},{"op":"image","layer":7,"image":"i13407"},{"op":"text","speaker":"白羽","text":"‘不用做。’"},{"op":"image","layer":7,"image":"i13417"},{"op":"text","speaker":"白羽","text":"‘由我请您。’"},{"op":"text","speaker":"","text":"请客？"},{"op":"text","speaker":"羽依里","text":"“原来是这意思啊。”"},{"op":"text","speaker":"羽依里","text":"“那在食堂会合？”"},{"op":"image","layer":7,"image":"i13417"},{"op":"text","speaker":"白羽","text":"‘会合地点设于港口。’"},{"op":"text","speaker":"羽依里","text":"“港口？”"},{"op":"image","layer":7,"image":"i13417"},{"op":"text","speaker":"白羽","text":"‘恭候大驾，就此拜辞。’"},{"op":"text","speaker":"","text":"电话挂断了。"},{"op":"text","speaker":"","text":"……最后敬语变得越来越奇怪，搞得我也紧张起来了。"},{"op":"if","truth":false,"target":578,"value":["==",["v",6003],1]},{"op":"callScene","scene":71,"target":19},{"op":"goto","target":586},{"op":"if","truth":false,"target":581,"value":["==",["v",6003],2]},{"op":"callScene","scene":70,"target":19},{"op":"goto","target":586},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“有什么事吗？”"},{"op":"text","speaker":"羽依里","text":"“我将前往港口赴宴。”"},{"op":"image","layer":1,"image":"i15353"},{"op":"text","speaker":"羽未","text":"“为什么要用敬语？”"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]