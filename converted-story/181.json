[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"set","variable":131,"value":1},{"op":"set","variable":12600,"value":1},{"op":"image","layer":0,"image":"i25"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“～～～♪”"},{"op":"text","speaker":"","text":"……嗯？"},{"op":"text","speaker":"","text":"不知不觉间，我也哼起了小曲。"},{"op":"text","speaker":"","text":"这是紬哼的那支。"},{"op":"text","speaker":"","text":"看来是太经常去那里，都让我记住这支小曲了。"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i129"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“嗯，今天也矗立着啊。”"},{"op":"image","layer":1,"image":"i14211"},{"op":"text","speaker":"紬","text":"“姆啾，鹰原先生啊。”"},{"op":"text","speaker":"羽依里","text":"“嗯，鹰原来了。”"},{"op":"image","layer":1,"image":"i14281"},{"op":"text","speaker":"紬","text":"“你为什么看着灯塔呀？”"},{"op":"text","speaker":"羽依里","text":"“想着灯塔今天也矗立在这里。”"},{"op":"image","layer":1,"image":"i14287"},{"op":"text","speaker":"紬","text":"“是啊。”"},{"op":"image","layer":1,"image":"i14322"},{"op":"text","speaker":"紬","text":"“明天肯定也矗立在这。”"},{"op":"text","speaker":"","text":"这对话充满了哲学。"},{"op":"text","speaker":"؟؟؟","text":"“唉呀，紬，你的朋友来了？”"},{"op":"image","layer":7,"image":"i14233"},{"op":"text","speaker":"紬","text":"“是的，这是我的朋友。”"},{"op":"text","speaker":"؟؟؟","text":"“哈哈，原来除了我和布偶，你还有其他朋友啊。”"},{"op":"text","speaker":"羽依里","text":"“啊。”"},{"op":"image","layer":1,"image":"i13829"},{"op":"text","speaker":"؟؟؟","text":"“唉？……啊！乳依里？”"},{"op":"text","speaker":"羽依里","text":"“奶子小姐！”"},{"op":"image","layer":1,"image":"i13837"},{"op":"text","speaker":"奶子小姐","text":"“奶子……小姐!؟”"},{"op":"image","layer":1,"image":"i13807"},{"op":"text","speaker":"奶子小姐","text":"“………”"},{"op":"image","layer":1,"image":"i13813"},{"op":"text","speaker":"奶子小姐","text":"“――扑通。”"},{"op":"text","speaker":"羽依里","text":"“唉!؟”"},{"op":"text","speaker":"","text":"她的反应出乎我的意料。"},{"op":"image","layer":257,"image":"i14281"},{"op":"text","speaker":"紬","text":"“你们认识吗？”"},{"op":"text","speaker":"羽依里","text":"“嗯，认识，就是不知道她名字。”"},{"op":"image","layer":1,"image":"i13767"},{"op":"text","speaker":"奶子小姐","text":"“哎呀，是吗？”"},{"op":"image","layer":1,"image":"i13743"},{"op":"text","speaker":"奶子小姐","text":"“对不起，怪我把你当成我的老相识了。”"},{"op":"image","layer":1,"image":"i13740"},{"op":"text","speaker":"奶子小姐","text":"“于是当时忘记介绍自己就告别了。”"},{"op":"text","speaker":"羽依里","text":"“老相识还弄错我名字。”"},{"op":"image","layer":257,"image":"i14202"},{"op":"text","speaker":"紬","text":"“那我正式介绍一下。”"},{"op":"if","truth":false,"target":60,"value":["==",["v",24],1]},{"op":"image","layer":257,"image":"i14200"},{"op":"text","speaker":"紬","text":"“这位是翅膀受伤的鹰原先生。”"},{"op":"goto","target":69},{"op":"if","truth":false,"target":63,"value":["==",["v",25],1]},{"op":"text","speaker":"紬","text":"“这位是失去歌声的金丝雀鹰原先生。”"},{"op":"goto","target":69},{"op":"if","truth":false,"target":66,"value":["==",["v",26],1]},{"op":"text","speaker":"紬","text":"“这位是伤了拳头的拳击手鹰原先生。”"},{"op":"goto","target":69},{"op":"if","truth":false,"target":69,"value":["==",["v",27],1]},{"op":"text","speaker":"紬","text":"“这位是忘却如何哄人的牛郎鹰原先生。”"},{"op":"goto","target":69},{"op":"text","speaker":"羽依里","text":"“这传闻都传到这里了啊。”"},{"op":"text","speaker":"","text":"人们的传言真可怕。"},{"op":"image","layer":257,"image":"i14234"},{"op":"text","speaker":"紬","text":"“我的名字是……”"},{"op":"choice","variable":6001,"items":[{"text":"羽依里","value":0,"condition":1},{"text":"乳依里","value":1,"condition":1},{"text":"奶子","value":2,"condition":1}]},{"op":"if","truth":false,"target":82,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“羽依里。”"},{"op":"image","layer":1,"image":"i13782"},{"op":"text","speaker":"奶子小姐","text":"“我早就知道啦，乳依里♪”"},{"op":"text","speaker":"","text":"我又复述了一遍我的名字。"},{"op":"text","speaker":"","text":"……结果证明是无用功。"},{"op":"image","layer":1,"image":"i13740"},{"op":"goto","target":111},{"op":"if","truth":false,"target":97,"value":["==",["v",6001],1]},{"op":"text","speaker":"羽依里","text":"“乳依里。”"},{"op":"image","layer":1,"image":"i13813"},{"op":"text","speaker":"奶子小姐","text":"“真是个好名字。”"},{"op":"image","layer":257,"image":"i14211"},{"op":"text","speaker":"紬","text":"“鹰原先生……对不起。”"},{"op":"image","layer":257,"image":"i14219"},{"op":"text","speaker":"紬","text":"“我一直以为你叫羽依里。”"},{"op":"image","layer":257,"image":"i14231"},{"op":"text","speaker":"紬","text":"“我表示深切反省……”"},{"op":"text","speaker":"乳依里","text":"“唉？啊，不是，羽依里就行。”"},{"op":"image","layer":257,"image":"i14196"},{"op":"text","speaker":"紬","text":"“姆啾？”"},{"op":"image","layer":1,"image":"i13740"},{"op":"goto","target":111},{"op":"text","speaker":"羽依里","text":"“奶子。”"},{"op":"image","layer":257,"image":"i14211"},{"op":"text","speaker":"紬","text":"“姆啾!؟你叫这名字吗？”"},{"op":"image","layer":1,"image":"i13767"},{"op":"text","speaker":"奶子小姐","text":"“你……不叫乳依里这个优秀的名字？”"},{"op":"text","speaker":"奶子","text":"“这……”"},{"op":"text","speaker":"奶子","text":"“类似中间名。”"},{"op":"image","layer":1,"image":"i13761"},{"op":"text","speaker":"奶子小姐","text":"“那你叫鹰原·乳依里·奶子……？”"},{"op":"text","speaker":"鹰原·乳依里·奶子","text":"“对。”"},{"op":"image","layer":1,"image":"i13785"},{"op":"text","speaker":"奶子小姐","text":"“好过分的名字……”"},{"op":"text","speaker":"","text":"唉唉唉唉唉？"},{"op":"image","layer":1,"image":"i13740"},{"op":"text","speaker":"奶子小姐","text":"“呵呵♪开玩笑的。”"},{"op":"image","layer":1,"image":"i13737"},{"op":"text","speaker":"奶子小姐","text":"“毕竟是父母取的宝贵的名字，我就好好叫吧。”"},{"op":"image","layer":1,"image":"i13846"},{"op":"text","speaker":"奶子小姐","text":"“请多指教，羽依里。”"},{"op":"text","speaker":"羽依里","text":"“请多指教。”"},{"op":"image","layer":257,"image":"i14284"},{"op":"text","speaker":"紬","text":"“这位则是奶子静久。”"},{"op":"image","layer":1,"image":"i13779"},{"op":"text","speaker":"奶子小姐","text":"“我是奶子。”"},{"op":"text","speaker":"","text":"奶子吗。"},{"op":"image","layer":1,"image":"i13737"},{"op":"text","speaker":"静久","text":"“叫我奶子或者静久都可以哦。”"},{"op":"text","speaker":"羽依里","text":"“那就叫你静久。”"},{"op":"image","layer":1,"image":"i13779"},{"op":"text","speaker":"静久","text":"“奶子或者静久，都可以哦。”"},{"op":"text","speaker":"羽依里","text":"“就静久。”"},{"op":"image","layer":1,"image":"i13811"},{"op":"text","speaker":"静久","text":"“奶子也可以哦。”"},{"op":"text","speaker":"羽依里","text":"“静久。”"},{"op":"image","layer":1,"image":"i13764"},{"op":"text","speaker":"静久","text":"“是吗……”"},{"op":"image","layer":257,"image":"i14196"},{"op":"text","speaker":"紬","text":"“既然直接叫静久的名字的话，你也可以直接叫我名字哦？”"},{"op":"text","speaker":"羽依里","text":"“那就……紬。”"},{"op":"image","layer":257,"image":"i14231"},{"op":"text","speaker":"紬","text":"“姆啾……”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"image","layer":257,"image":"i14311"},{"op":"text","speaker":"紬","text":"“总、总觉得好难为情。”"},{"op":"text","speaker":"","text":"听她这么一说，我也不自在起来了。"},{"op":"text","speaker":"羽依里","text":"“……我先问一句，胸…奶子是你的姓？”"},{"op":"image","layer":257,"image":"i14196"},{"op":"text","speaker":"紬","text":"“是姓哦。”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"image","layer":1,"image":"i13810"},{"op":"text","speaker":"静久","text":"“哈哈♪真是这样的话就好了，然而很遗憾，我姓水织。”"},{"op":"image","layer":257,"image":"i14297"},{"op":"text","speaker":"紬","text":"“唉？”"},{"op":"text","speaker":"","text":"看来紬也是第一次听说。"},{"op":"image","layer":1,"image":"i13813"},{"op":"text","speaker":"静久","text":"“至于奶子嘛，就像是我的头衔。”"},{"op":"text","speaker":"羽依里","text":"“……头衔。”"},{"op":"image","layer":1,"image":"i13782"},{"op":"text","speaker":"静久","text":"“就和你的‘乳依里’一样。”"},{"op":"text","speaker":"羽依里","text":"“我可没这种头衔……”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"image","layer":1,"image":"i14196"},{"op":"text","speaker":"紬","text":"“鹰原先生，静久。”"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"静久","text":"“嗯？怎么啦？”"},{"op":"image","layer":1,"image":"i14291"},{"op":"text","speaker":"紬","text":"“两位难得造访这里，可我却不得不出门一趟了。”"},{"op":"text","speaker":"羽依里","text":"“嗯？去找自己想干的事情？”"},{"op":"image","layer":1,"image":"i14299"},{"op":"text","speaker":"紬","text":"“不是的，今天我得出门采购，不然家里的锅就见底了。”"},{"op":"image","layer":257,"image":"i13767"},{"op":"text","speaker":"静久","text":"“确实很紧迫啊。”"},{"op":"text","speaker":"羽依里","text":"“方便的话，我可以帮你拿拿东西哦？”"},{"op":"image","layer":257,"image":"i13820"},{"op":"text","speaker":"静久","text":"“我也去。”"},{"op":"image","layer":1,"image":"i14196"},{"op":"text","speaker":"紬","text":"“姆啾，大家一起去吗……”"},{"op":"image","layer":1,"image":"i14202"},{"op":"text","speaker":"紬","text":"“真让人期待。”"},{"op":"image","layer":1,"image":"i14284"},{"op":"text","speaker":"紬","text":"“那我去准备一下。”"},{"op":"text","speaker":"","text":"紬开心地转身跑向灯塔。"},{"op":"image","layer":7,"image":"i14283"},{"op":"text","speaker":"紬","text":"“～～～♪”"},{"op":"text","speaker":"羽依里","text":"“又在哼那支小曲了。”"},{"op":"image","layer":1,"image":"i13767"},{"op":"text","speaker":"静久","text":"“又？”"},{"op":"text","speaker":"羽依里","text":"“嗯，每次见面都会听到她哼。”"},{"op":"image","layer":1,"image":"i13740"},{"op":"text","speaker":"静久","text":"“哈哈♪”"},{"op":"text","speaker":"羽依里","text":"“怎么了？”"},{"op":"image","layer":1,"image":"i13737"},{"op":"text","speaker":"静久","text":"“那支小曲是紬开心的时候才会哼的哦。”"},{"op":"text","speaker":"羽依里","text":"“是吗～”"},{"op":"image","layer":1,"image":"i13849"},{"op":"text","speaker":"静久","text":"“就跟猫咪满足的时候喉咙发出的咕噜声一样。”"},{"op":"text","speaker":"羽依里","text":"“原来如此，简单易懂。”"},{"op":"image","layer":1,"image":"i13823"},{"op":"text","speaker":"静久","text":"“她很亲近你哦。”"},{"op":"text","speaker":"羽依里","text":"“这确实让人开心。”"},{"op":"image","layer":1,"image":"i13832"},{"op":"text","speaker":"静久","text":"“说不定她喜欢上你了哦。”"},{"op":"text","speaker":"羽依里","text":"“……慢着。”"},{"op":"text","speaker":"羽依里","text":"“你这样……会让我不知道怎么面对她的。”"},{"op":"text","speaker":"羽依里","text":"“我是男校的，对女孩子这种别有深意的发言很没抵抗力的。”"},{"op":"image","layer":1,"image":"i13816"},{"op":"text","speaker":"静久","text":"“哈哈，你好像经常来这座灯塔。”"},{"op":"text","speaker":"羽依里","text":"“还是挺常来的。”"},{"op":"image","layer":1,"image":"i13794"},{"op":"text","speaker":"静久","text":"“看来你也被紬的魅力迷得团团转了？”"},{"op":"text","speaker":"羽依里","text":"“这……”"},{"op":"choice","variable":6001,"items":[{"text":"我就是想帮她找找她想做的事","value":0,"condition":1},{"text":"是紬被我迷得团团转","value":1,"condition":1},{"text":"我都无法自拔了","value":2,"condition":1}]},{"op":"if","truth":false,"target":219,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“我就是想帮她找找她想做的事。”"},{"op":"text","speaker":"羽依里","text":"“不过她也没拜托我，是我自己要帮她的。”"},{"op":"image","layer":1,"image":"i13740"},{"op":"text","speaker":"静久","text":"“哈哈♪可是，我看她好像挺依赖你的哦？”"},{"op":"text","speaker":"","text":"这样啊……"},{"op":"goto","target":242},{"op":"if","truth":false,"target":228,"value":["==",["v",6001],1]},{"op":"text","speaker":"羽依里","text":"“是紬被我迷得团团转。”"},{"op":"image","layer":1,"image":"i13740"},{"op":"text","speaker":"静久","text":"“我就觉得是这样。”"},{"op":"image","layer":1,"image":"i13782"},{"op":"text","speaker":"静久","text":"“因为我也被你迷得团团转了嘛。”"},{"op":"text","speaker":"羽依里","text":"“……慢着。”"},{"op":"text","speaker":"羽依里","text":"“都说了你这样子……会让我很不自在的……”"},{"op":"goto","target":242},{"op":"text","speaker":"羽依里","text":"“我都无法自拔了。”"},{"op":"text","speaker":"羽依里","text":"“每天不听一声‘姆啾’的话我简直会疯的。”"},{"op":"text","speaker":"羽依里","text":"“见不到她的日子，我都想让我寄宿那家的妹妹对我说一声‘姆啾’了。”"},{"op":"image","layer":1,"image":"i13782"},{"op":"text","speaker":"静久","text":"“我理解你。”"},{"op":"image","layer":1,"image":"i13813"},{"op":"text","speaker":"静久","text":"“我爸爸也对我说过姆啾。”"},{"op":"text","speaker":"羽依里","text":"“真是个豁达的爸爸。”"},{"op":"image","layer":1,"image":"i13737"},{"op":"text","speaker":"静久","text":"“回本土的时候，来我家做客吧。”"},{"op":"image","layer":1,"image":"i13770"},{"op":"text","speaker":"静久","text":"“我也要让你听听我爸爸的‘姆啾’。”"},{"op":"text","speaker":"","text":"陌生大叔的“姆啾”吗……"},{"op":"text","speaker":"羽依里","text":"“那我先期待着。”"},{"op":"text","speaker":"羽依里","text":"“或许我是中意上了紬和这个地方。”"},{"op":"text","speaker":"羽依里","text":"“于是回过神来，来这的次数都能让我自然地哼出这支小曲了。”"},{"op":"image","layer":1,"image":"i13737"},{"op":"text","speaker":"静久","text":"“那你和我一样呢。”"},{"op":"text","speaker":"羽依里","text":"“总觉得，和紬在一起，就像和老朋友在一起似的。”"},{"op":"text","speaker":"羽依里","text":"“捡垃圾、上街回收空罐、用空罐做手工活。”"},{"op":"text","speaker":"羽依里","text":"“聚集在废弃的灯塔，沉浸在毫无意义的事情上。”"},{"op":"text","speaker":"羽依里","text":"“就跟小时候觉得时间无穷无尽的暑假有几分相似。”"},{"op":"image","layer":1,"image":"i13823"},{"op":"text","speaker":"静久","text":"“时间无穷无尽吗……”"},{"op":"image","layer":1,"image":"i13849"},{"op":"text","speaker":"静久","text":"“和紬在一起，确实会有这种感觉。”"},{"op":"text","speaker":"羽依里","text":"“跟她就像是认识多年了一样。”"},{"op":"image","layer":1,"image":"i13823"},{"op":"text","speaker":"静久","text":"“嗯……我能理解。”"},{"op":"image","layer":257,"image":"i14384"},{"op":"text","speaker":"紬","text":"“久等啦。”"},{"op":"text","speaker":"","text":"她换上可爱的衣服走了出来。"},{"op":"text","speaker":"","text":"这灯塔里连衣服都备着吗。"},{"op":"text","speaker":"","text":"出门的时候，紬似乎也不穿校服了。"},{"op":"text","speaker":"","text":"话说回来，她为啥总是穿着校服？"},{"op":"text","speaker":"","text":"莫非，她是在遵守学校发的暑假计划书里常见的…"},{"op":"text","speaker":"","text":"‘在暑假也不能忘记学生这个身份’"},{"op":"text","speaker":"","text":"之类的要求？"},{"op":"text","speaker":"","text":"……不会吧。"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":1795,"image":"i18201"},{"op":"image","layer":0,"image":"i129"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i14262"},{"op":"text","speaker":"紬","text":"“不，因为学生不能天黑了还在外游荡。”"},{"op":"text","speaker":"羽依里","text":"“你可真是个认真的人啊。”"},{"op":"image","layer":1,"image":"i14279"},{"op":"text","speaker":"紬","text":"“我一直认真处世！”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":1795},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i129"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"感觉她确实有可能说这种话。"},{"op":"image","layer":1,"image":"i13740"},{"op":"text","speaker":"静久","text":"“那我们出发吧？”"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i14508"},{"op":"text","speaker":"紬","text":"“到啦。”"},{"op":"image","layer":257,"image":"i10279"},{"op":"text","speaker":"苍","text":"“啊，欢迎。”"},{"op":"text","speaker":"羽依里","text":"“我们是来买食物的吧？”"},{"op":"text","speaker":"羽依里","text":"“为什么会来小卖铺？”"},{"op":"image","layer":257,"image":"i10319"},{"op":"text","speaker":"苍","text":"“小卖铺就是卖食物的。”"},{"op":"text","speaker":"羽依里","text":"“不是，这里卖的只有零食吧？”"},{"op":"image","layer":513,"image":"i13740"},{"op":"text","speaker":"静久","text":"“好啦好啦。”"},{"op":"image","layer":257,"image":"i10135"},{"op":"text","speaker":"苍","text":"“咦，水织学姐？”"},{"op":"image","layer":513,"image":"i13737"},{"op":"text","speaker":"静久","text":"“你好，空门同学。”"},{"op":"text","speaker":"羽依里","text":"“咦？你们认识？”"},{"op":"image","layer":257,"image":"i10235"},{"op":"text","speaker":"苍","text":"“那肯定，水织学姐是我们学校的学生会长。”"},{"op":"text","speaker":"羽依里","text":"“唉唉唉唉？”"},{"op":"image","layer":513,"image":"i13743"},{"op":"text","speaker":"静久","text":"“别那么惊讶嘛。”"},{"op":"image","layer":513,"image":"i13773"},{"op":"text","speaker":"静久","text":"“在学生会会长这个身份之上，我不过是一丛奶子而已。”"},{"op":"image","layer":257,"image":"i10156"},{"op":"text","speaker":"苍","text":"“真厉害。”"},{"op":"text","speaker":"羽依里","text":"“你就接受了!؟”"},{"op":"image","layer":257,"image":"i10186"},{"op":"text","speaker":"苍","text":"“唉？”"},{"op":"text","speaker":"羽依里","text":"“她刚才说了自己是一丛奶子吧？”"},{"op":"image","layer":513,"image":"i13737"},{"op":"image","layer":257,"image":"i10290"},{"op":"text","speaker":"苍","text":"“啊？”"},{"op":"image","layer":257,"image":"i10288"},{"op":"text","speaker":"苍","text":"“水织学姐怎么可能说这种话？”"},{"op":"image","layer":257,"image":"i10319"},{"op":"text","speaker":"苍","text":"“话说一丛又是什么？奶子的单位？”"},{"op":"text","speaker":"羽依里","text":"“静久她刚才说了奶子这个词吧？”"},{"op":"image","layer":7,"image":"i14395"},{"op":"text","speaker":"紬","text":"“她是说了。”"},{"op":"image","layer":257,"image":"i10231"},{"op":"text","speaker":"苍","text":"“你们脑子没事吧……”"},{"op":"text","speaker":"","text":"咦？除了我和紬，其他人都听不到静久嘴里奶子这个词？"},{"op":"image","layer":1,"image":"i14467"},{"op":"image","layer":257,"image":"i10154"},{"op":"text","speaker":"紬","text":"“苍同学，还是麻烦你给我老东西了。”"},{"op":"image","layer":1,"image":"i14470"},{"op":"text","speaker":"紬","text":"“今天我要5个。”"},{"op":"image","layer":257,"image":"i10112"},{"op":"text","speaker":"苍","text":"“好，5个一共400万。”"},{"op":"image","layer":1,"image":"i14486"},{"op":"text","speaker":"紬","text":"“给你400日元，不够的部分我用劳动支付。”"},{"op":"image","layer":257,"image":"i10282"},{"op":"text","speaker":"苍","text":"“嗯，陪稻荷玩玩吧。”"},{"op":"image","layer":1,"image":"i14377"},{"op":"text","speaker":"紬","text":"“好的。”"},{"op":"image","layer":1,"image":"i14384"},{"op":"text","speaker":"紬","text":"“稻荷！”"},{"op":"image","layer":513,"image":"i10670"},{"op":"text","speaker":"稻荷","text":"“嘭！”"},{"op":"image","layer":1,"image":"i14508"},{"op":"text","speaker":"紬","text":"“和布偶们一起玩吧？”"},{"op":"image","layer":513,"image":"i10680"},{"op":"text","speaker":"稻荷","text":"“嘭!؟”"},{"op":"text","speaker":"","text":"紬提出了个难度颇高的玩法。"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"image","layer":1,"image":"i13743"},{"op":"text","speaker":"静久","text":"“说起来，我还是第一次和紬出门啊。”"},{"op":"image","layer":257,"image":"i14467"},{"op":"text","speaker":"紬","text":"“听你这么一说，好像还真是。”"},{"op":"image","layer":1,"image":"i13737"},{"op":"text","speaker":"静久","text":"“毕竟我们只在灯塔见过面。”"},{"op":"image","layer":1,"image":"i13810"},{"op":"text","speaker":"静久","text":"“我都快把紬当成灯塔女神了。”"},{"op":"image","layer":257,"image":"i14529"},{"op":"text","speaker":"紬","text":"“我不是哦？”"},{"op":"image","layer":257,"image":"i14515"},{"op":"text","speaker":"紬","text":"“我会去岛上的各种地方。”"},{"op":"text","speaker":"羽依里","text":"“不否认自己是个女神啊。”"},{"op":"text","speaker":"羽依里","text":"“女神大人。”"},{"op":"image","layer":257,"image":"i14446"},{"op":"text","speaker":"紬","text":"“何事呀？”"},{"op":"text","speaker":"","text":"她以一副女神范回复了我。"},{"op":"text","speaker":"羽依里","text":"“既然你去了这么多地方，我想请你带我们游览这座岛。”"},{"op":"text","speaker":"羽依里","text":"“毕竟我初来乍到，还有很多地方没去过。”"},{"op":"image","layer":257,"image":"i14417"},{"op":"text","speaker":"紬","text":"“可以哦。”"},{"op":"image","layer":257,"image":"i14473"},{"op":"text","speaker":"紬","text":"“不过，也请你们俩带带我。只有我一个人带你们也太不公平了。”"},{"op":"image","layer":1,"image":"i13823"},{"op":"text","speaker":"静久","text":"“可以啊♪我也带你去一个我秘藏的好地方。”"},{"op":"text","speaker":"羽依里","text":"“唉……”"},{"op":"text","speaker":"","text":"我有没有可以带她们去游览的地方呢。"},{"op":"image","layer":257,"image":"i14417"},{"op":"text","speaker":"紬","text":"“大家想要我带着去哪里转转呢？”"},{"op":"image","layer":257,"image":"i14381"},{"op":"text","speaker":"紬","text":"“我的话，想带你们去海边。”"},{"op":"text","speaker":"羽依里","text":"“这个嘛…海边的话，让她带我们去哪呢？”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"set","variable":6045,"value":1},{"op":"return"},{"op":"image","layer":0,"image":"i1"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i14554"},{"op":"image","layer":257,"image":"i13823"},{"op":"text","speaker":"紬","text":"“这里是轮渡码头。”"},{"op":"image","layer":257,"image":"i13816"},{"op":"text","speaker":"静久","text":"“我每天都是从这里来的。”"},{"op":"image","layer":1,"image":"i14460"},{"op":"text","speaker":"紬","text":"“有时我会来这里接静久。”"},{"op":"image","layer":257,"image":"i13843"},{"op":"text","speaker":"静久","text":"“唉？可我一次都没见过你啊？”"},{"op":"image","layer":1,"image":"i14404"},{"op":"text","speaker":"紬","text":"“因为基本上都累得不行，所以就没能叫你。”"},{"op":"image","layer":1,"image":"i14377"},{"op":"text","speaker":"紬","text":"“在灯塔看到船来了，我就会跑过去。”"},{"op":"image","layer":1,"image":"i14497"},{"op":"text","speaker":"紬","text":"“弄得上气不接下气。”"},{"op":"text","speaker":"羽依里","text":"“备张时刻表怎么样？”"},{"op":"image","layer":1,"image":"i14554"},{"op":"text","speaker":"紬","text":"“……原来还有这招！”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"set","variable":106,"value":1},{"op":"return"},{"op":"image","layer":0,"image":"i55"},{"op":"set","variable":6714,"value":0},{"op":"if","truth":false,"target":445,"value":["&&",["==",["v",106],0],["==",["v",107],0]]},{"op":"image","layer":1,"image":"i14524"},{"op":"image","layer":257,"image":"i13823"},{"op":"goto","target":447},{"op":"image","layer":1,"image":"i14524"},{"op":"image","layer":257,"image":"i13843"},{"op":"text","speaker":"紬","text":"“姆啾……今天好像不在。”"},{"op":"text","speaker":"羽依里","text":"“平时都有人在的吗？”"},{"op":"image","layer":1,"image":"i14384"},{"op":"text","speaker":"紬","text":"“是的，有我朋友在。”"},{"op":"text","speaker":"羽依里","text":"“那下次有机会介绍给我吧。”"},{"op":"image","layer":1,"image":"i14381"},{"op":"text","speaker":"紬","text":"“好的。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"set","variable":107,"value":1},{"op":"return"},{"op":"if","truth":false,"target":472,"value":["&&",["==",["v",106],0],["==",["v",107],0]]},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i14460"},{"op":"image","layer":257,"image":"i13823"},{"op":"text","speaker":"紬","text":"“这里是小卖铺。”"},{"op":"text","speaker":"羽依里","text":"“呃，嗯，我知道。”"},{"op":"text","speaker":"","text":"还没换地方，她就开始当导游了。"},{"op":"goto","target":488},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"if","truth":false,"target":478,"value":["&&",["==",["v",106],0],["==",["v",107],1]]},{"op":"image","layer":1,"image":"i14460"},{"op":"image","layer":257,"image":"i13823"},{"op":"goto","target":486},{"op":"if","truth":false,"target":482,"value":["&&",["==",["v",106],1],["==",["v",107],0]]},{"op":"image","layer":1,"image":"i14460"},{"op":"image","layer":257,"image":"i13843"},{"op":"goto","target":486},{"op":"if","truth":false,"target":486,"value":["&&",["==",["v",106],1],["==",["v",107],1]]},{"op":"image","layer":1,"image":"i14460"},{"op":"image","layer":257,"image":"i13843"},{"op":"goto","target":486},{"op":"text","speaker":"紬","text":"“这里是小卖铺。”"},{"op":"text","speaker":"羽依里","text":"“回来了啊。”"},{"op":"image","layer":1,"image":"i14425"},{"op":"text","speaker":"紬","text":"“苍经常打着盹看店。”"},{"op":"text","speaker":"羽依里","text":"“这哪算看店。”"},{"op":"image","layer":513,"image":"i10285"},{"op":"text","speaker":"苍","text":"“这么久都没人来偷过，我看得很到位的。”"},{"op":"image","layer":1,"image":"i14377"},{"op":"text","speaker":"紬","text":"“我要买吃的的时候，就会很头疼。”"},{"op":"image","layer":1,"image":"i14388"},{"op":"text","speaker":"紬","text":"“她总是叫不起来。”"},{"op":"image","layer":513,"image":"i10311"},{"op":"text","speaker":"苍","text":"“对不起。”"},{"op":"text","speaker":"羽依里","text":"“下次碰到这情况，拿棉花糖或者大福砸她就行。”"},{"op":"image","layer":1,"image":"i14529"},{"op":"text","speaker":"紬","text":"“为什么？”"},{"op":"text","speaker":"羽依里","text":"“因为很软，砸到也不会受伤。”"},{"op":"text","speaker":"羽依里","text":"“便利店里，大福都放在收银台前，就是这个用处。”"},{"op":"image","layer":1,"image":"i14518"},{"op":"text","speaker":"紬","text":"“原来如此，城里人真的设计很合理呀。”"},{"op":"image","layer":513,"image":"i10162"},{"op":"text","speaker":"苍","text":"“别告诉她这种莫名其妙的假知识。”"},{"op":"text","speaker":"羽依里","text":"“不是，我没想到她真信了。”"},{"op":"image","layer":1,"image":"i14401"},{"op":"text","speaker":"紬","text":"“假的吗？”"},{"op":"text","speaker":"羽依里","text":"“对不起。”"},{"op":"image","layer":1,"image":"i14388"},{"op":"text","speaker":"紬","text":"“原来便利店的收银台旁……没有大福啊。”"},{"op":"text","speaker":"羽依里","text":"“那是有的。”"},{"op":"image","layer":257,"image":"i13743"},{"op":"text","speaker":"静久","text":"“听我说，如果要扔的话，把奶子扔出去怎么样？”"},{"op":"text","speaker":"","text":"她提出了个不得了的建议。"},{"op":"text","speaker":"羽依里","text":"“行是行，可扔得出去吗？”"},{"op":"image","layer":1,"image":"i14473"},{"op":"text","speaker":"紬","text":"“静久的话，把奶子抓起一块扔过去易如反掌哦？”"},{"op":"image","layer":257,"image":"i13755"},{"op":"text","speaker":"静久","text":"“易如反掌♪”"},{"op":"text","speaker":"","text":"可以申请发现新物种了。"},{"op":"set","variable":108,"value":1},{"op":"image","layer":257,"image":"i13846"},{"op":"text","speaker":"静久","text":"“轮到我了。”"},{"op":"image","layer":257,"image":"i13816"},{"op":"text","speaker":"静久","text":"“我带你们去山里和住宅街那转转吧？”"},{"op":"image","layer":1,"image":"i14506"},{"op":"text","speaker":"紬","text":"“那现在就出发吧。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"return"},{"op":"image","layer":0,"image":"i28"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13820"},{"op":"text","speaker":"静久","text":"“哈哈♪想让我带你逛这里吧？”"},{"op":"image","layer":1,"image":"i13737"},{"op":"text","speaker":"静久","text":"“那户家里的一块石头。”"},{"op":"image","layer":1,"image":"i13743"},{"op":"text","speaker":"静久","text":"“俗称乳岩哦。”"},{"op":"text","speaker":"羽依里","text":"“这块庭前的石头被人起了个很过分的名字啊。”"},{"op":"image","layer":1,"image":"i13770"},{"op":"text","speaker":"静久","text":"“是我起的。”"},{"op":"text","speaker":"羽依里","text":"“请停止你的行径。”"},{"op":"image","layer":257,"image":"i14515"},{"op":"text","speaker":"紬","text":"“静久，我有个问题。”"},{"op":"image","layer":257,"image":"i14529"},{"op":"text","speaker":"紬","text":"“那边石头有三块。可奶子正常来讲不是一对吗？”"},{"op":"text","speaker":"羽依里","text":"“确实。”"},{"op":"image","layer":1,"image":"i13794"},{"op":"text","speaker":"静久","text":"“紬，羽依里。”"},{"op":"image","layer":1,"image":"i13782"},{"op":"text","speaker":"静久","text":"“奶子有三个会让谁为难吗？”"},{"op":"image","layer":257,"image":"i14396"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"image","layer":257,"image":"i14425"},{"op":"text","speaker":"紬","text":"“……赚到了才对。”"},{"op":"text","speaker":"","text":"她竟然接受了。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"set","variable":109,"value":1},{"op":"return"},{"op":"image","layer":0,"image":"i21"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13740"},{"op":"text","speaker":"静久","text":"“哈哈，这儿有点好玩。”"},{"op":"text","speaker":"","text":"这里是。"},{"op":"text","speaker":"羽依里","text":"“良一和天善的秘密基地吗。”"},{"op":"image","layer":1,"image":"i13767"},{"op":"text","speaker":"静久","text":"“唉呀，原来你认识他们俩。”"},{"op":"text","speaker":"羽依里","text":"“嗯，毕竟还给我开了个欢迎会。”"},{"op":"image","layer":257,"image":"i14515"},{"op":"text","speaker":"紬","text":"“他们两位住在这里吗？”"},{"op":"text","speaker":"羽依里","text":"“有一个几乎就住在这。”"},{"op":"image","layer":1,"image":"i15011"},{"op":"text","speaker":"天善","text":"“嗯？鹰原……还有紬也来了――吗!؟”"},{"op":"image","layer":1,"image":"i15035"},{"op":"image","layer":1,"image":"i15026"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"天善","text":"“水、水织学姐！为何大驾光临！”"},{"op":"image","layer":257,"image":"i13846"},{"op":"text","speaker":"静久","text":"“唉呀，加纳同学。你好。”"},{"op":"image","layer":1,"image":"i15017"},{"op":"text","speaker":"天善","text":"“您、您贵安。”"},{"op":"text","speaker":"羽依里","text":"“喂，天善你怎么了？”"},{"op":"image","layer":1,"image":"i15008"},{"op":"text","speaker":"天善","text":"“请、请问今日莅临寒舍有何贵干？”"},{"op":"image","layer":257,"image":"i13779"},{"op":"text","speaker":"静久","text":"“我在带他们逛逛这座岛呢，就想把羽依里介绍给你们。”"},{"op":"image","layer":1,"image":"i15026"},{"op":"text","speaker":"天善","text":"“竟、竟然直呼其名!؟”"},{"op":"text","speaker":"羽依里","text":"“静久，我和他认识，不用介绍了。”"},{"op":"image","layer":1,"image":"i15035"},{"op":"text","speaker":"天善","text":"“你竟然也直呼其名!؟”"},{"op":"image","layer":1,"image":"i15033"},{"op":"text","speaker":"天善","text":"“不、不是，冷静……冷静点天善。”"},{"op":"image","layer":1,"image":"i15018"},{"op":"text","speaker":"天善","text":"“冷静，你要冷静下来天善……”"},{"op":"image","layer":1,"image":"i15024"},{"op":"text","speaker":"天善","text":"“天善快冷静下来。你应该冷静下来天善。”"},{"op":"image","layer":1,"image":"i15027"},{"op":"text","speaker":"天善","text":"“天善，天善，天善，天善！给我冷静！”"},{"op":"image","layer":1,"image":"i15036"},{"op":"text","speaker":"天善","text":"“天善，你可是个冷静的男人啊！”"},{"op":"text","speaker":"","text":"好恐怖。"},{"op":"image","layer":1,"image":"i12075"},{"op":"text","speaker":"良一","text":"“怎么吵吵嚷嚷的？”"},{"op":"text","speaker":"羽依里","text":"“哟。”"},{"op":"image","layer":257,"image":"i14417"},{"op":"text","speaker":"紬","text":"“三谷同学，你好。”"},{"op":"image","layer":1,"image":"i12069"},{"op":"text","speaker":"良一","text":"“喔，你们俩都来了？”"},{"op":"image","layer":513,"image":"i15036"},{"op":"text","speaker":"天善","text":"“混蛋！在水织学姐面前，这副样子成何体统！”"},{"op":"image","layer":1,"image":"i12088"},{"op":"text","speaker":"良一","text":"“呜噢!؟”"},{"op":"text","speaker":"","text":"天善打出的乒乓球击中了良一的裸露部分。"},{"op":"image","layer":1,"image":"i15149"},{"op":"text","speaker":"天善","text":"“对不起，我马上把这裸男收拾掉！”"},{"op":"image","layer":1,"image":"i12075"},{"op":"text","speaker":"良一","text":"“好疼！”"},{"op":"image","layer":257,"image":"i13782"},{"op":"text","speaker":"静久","text":"“没事啦。毕竟是男孩子，精神点不是挺好的嘛。”"},{"op":"image","layer":1,"image":"i12094"},{"op":"text","speaker":"良一","text":"“噢，水织学姐也在啊。”"},{"op":"image","layer":1,"image":"i12085"},{"op":"text","speaker":"良一","text":"“学姐好。”"},{"op":"image","layer":257,"image":"i13820"},{"op":"text","speaker":"静久","text":"“哈哈，你好♪”"},{"op":"image","layer":513,"image":"i15149"},{"op":"text","speaker":"天善","text":"“混蛋！竟然让水织学姐这么打招呼！”"},{"op":"image","layer":1,"image":"i12087"},{"op":"text","speaker":"良一","text":"“呜嘎!؟”"},{"op":"text","speaker":"","text":"天善又给乒乓球加上了飞速旋转。"},{"op":"text","speaker":"","text":"看样子很痛。"},{"op":"image","layer":257,"image":"i14529"},{"op":"text","speaker":"紬","text":"“加纳和平时不太一样啊。”"},{"op":"text","speaker":"羽依里","text":"“是啊。”"},{"op":"image","layer":257,"image":"i14530"},{"op":"text","speaker":"紬","text":"“他和三谷之间发生了什么吗？”"},{"op":"text","speaker":"羽依里","text":"“大概是……在遮掩害羞吧。”"},{"op":"image","layer":257,"image":"i14396"},{"op":"text","speaker":"紬","text":"“姆啾？”"},{"op":"set","variable":110,"value":1},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"return"},{"op":"image","layer":0,"image":"i37"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13737"},{"op":"text","speaker":"静久","text":"“到啦。”"},{"op":"text","speaker":"羽依里","text":"“好像看到了一间破破烂烂的屋子。”"},{"op":"text","speaker":"羽依里","text":"“你要带我们进去吗？”"},{"op":"image","layer":1,"image":"i13740"},{"op":"text","speaker":"静久","text":"“不是的，因为我也没来过这里，所以想让你们给我介绍介绍。”"},{"op":"text","speaker":"羽依里","text":"“不是带我们逛这座岛啊。”"},{"op":"image","layer":1,"image":"i13737"},{"op":"text","speaker":"静久","text":"“紬知道那家吗？”"},{"op":"image","layer":257,"image":"i14543"},{"op":"text","speaker":"紬","text":"“知道，那里住着有权势的人家。”"},{"op":"text","speaker":"羽依里","text":"“权势……”"},{"op":"image","layer":1,"image":"i13807"},{"op":"text","speaker":"静久","text":"“可那屋子都长满了杂草哦。”"},{"op":"text","speaker":"羽依里","text":"“屋顶也破了洞。”"},{"op":"image","layer":257,"image":"i14467"},{"op":"text","speaker":"紬","text":"“这户人家在几十年前就没落了。”"},{"op":"text","speaker":"","text":"……没落。"},{"op":"image","layer":257,"image":"i14486"},{"op":"text","speaker":"紬","text":"“如今已经没有人住这里了。”"},{"op":"text","speaker":"羽依里","text":"“我们该以什么心境游览这里呢？”"},{"op":"set","variable":111,"value":1},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"return"},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"于是，我们又回到了小卖铺。"},{"op":"text","speaker":"羽依里","text":"“按顺序，下一个轮到我带你们游览了。”"},{"op":"text","speaker":"羽依里","text":"“可我才刚来这座岛没多久……”"},{"op":"image","layer":1,"image":"i14381"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"静久","text":"“哪里都可以哦。”"},{"op":"text","speaker":"","text":"可就算这么说，我也不知道该带去哪啊……"},{"op":"text","speaker":"羽依里","text":"“啊……”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i196"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11332"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i14489"},{"op":"image","layer":257,"image":"i13767"},{"op":"text","speaker":"紬","text":"“你怎么了？”"},{"op":"text","speaker":"羽依里","text":"“嗯，我想到了个好主意。问问鸥吧。”"},{"op":"image","layer":1,"image":"i14548"},{"op":"text","speaker":"紬","text":"“问问海鸥……真有童话的味道。”"},{"op":"image","layer":257,"image":"i13740"},{"op":"text","speaker":"静久","text":"“哈哈，乳依里可真浪漫。”"},{"op":"text","speaker":"羽依里","text":"“喂～鸥！有空吗～？”"},{"op":"image","layer":1,"image":"i14396"},{"op":"image","layer":257,"image":"i13761"},{"op":"text","speaker":"紬·静久","text":"“……”"},{"op":"image","layer":1,"image":"i14404"},{"op":"text","speaker":"紬","text":"“……他好像是认真的。”"},{"op":"image","layer":257,"image":"i13807"},{"op":"text","speaker":"静久","text":"“不能放着他不管啊。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11243"},{"op":"text","speaker":"鸥","text":"“啊，羽依里～！”"},{"op":"text","speaker":"羽依里","text":"“哟，我有点事想问问你。”"},{"op":"image","layer":1,"image":"i11240"},{"op":"text","speaker":"鸥","text":"“嗯，随便问。”"},{"op":"image","layer":1,"image":"i11279"},{"op":"text","speaker":"鸥","text":"“啊，不过我也有事想先问问你。”"},{"op":"image","layer":1,"image":"i11333"},{"op":"text","speaker":"鸥","text":"“你背后那两个哆哆嗦嗦的女生没事吧？”"},{"op":"text","speaker":"","text":"哆哆嗦嗦？"},{"op":"text","speaker":"","text":"我回头看去。"},{"op":"image","layer":1,"image":"i14491"},{"op":"image","layer":257,"image":"i13766"},{"op":"text","speaker":"紬","text":"“那是……人吧。”"},{"op":"image","layer":257,"image":"i13763"},{"op":"text","speaker":"静久","text":"“是人吧？”"},{"op":"image","layer":1,"image":"i14533"},{"op":"text","speaker":"紬","text":"“在你眼里，她是只海鸥吗？”"},{"op":"image","layer":257,"image":"i13806"},{"op":"text","speaker":"静久","text":"“好可怕。”"},{"op":"text","speaker":"","text":"她们好像产生了奇怪的误解。"},{"op":"text","speaker":"羽依里","text":"“你们误会了，是她的名字叫鸥。”"},{"op":"image","layer":1,"image":"i13843"},{"op":"image","layer":257,"image":"i14522"},{"op":"image","layer":513,"image":"i11307"},{"op":"text","speaker":"羽依里","text":"“来，你介绍下自己吧。”"},{"op":"image","layer":1,"image":"i13837"},{"op":"image","layer":257,"image":"i14489"},{"op":"image","layer":513,"image":"i11266"},{"op":"text","speaker":"鸥","text":"“呼嘎～！呼嘎～！”"},{"op":"text","speaker":"羽依里","text":"“别给我模仿海鸥。”"},{"op":"image","layer":257,"image":"i14408"},{"op":"text","speaker":"紬","text":"“姆叽～！姆叽～！”"},{"op":"text","speaker":"羽依里","text":"“哎？那是什么？”"},{"op":"image","layer":1,"image":"i13737"},{"op":"text","speaker":"静久","text":"“威吓吧。”"},{"op":"image","layer":513,"image":"i11345"},{"op":"text","speaker":"鸥","text":"“不对，刚才她大概是在求爱。”"},{"op":"image","layer":257,"image":"i14470"},{"op":"text","speaker":"紬","text":"“是的。”"},{"op":"image","layer":1,"image":"i13761"},{"op":"text","speaker":"静久","text":"“……”"},{"op":"image","layer":513,"image":"i11339"},{"op":"text","speaker":"鸥","text":"“感觉我们能成为好朋友啊。”"},{"op":"text","speaker":"","text":"她们俩好像达成了某种默契。"},{"op":"image","layer":1,"image":"i13737"},{"op":"image","layer":257,"image":"i14473"},{"op":"image","layer":513,"image":"i11307"},{"op":"text","speaker":"鸥","text":"“我叫久岛鸥，请多指教。”"},{"op":"image","layer":257,"image":"i14470"},{"op":"image","layer":513,"image":"i11311"},{"op":"text","speaker":"紬","text":"“我叫紬文德斯，请多指教。”"},{"op":"image","layer":1,"image":"i13770"},{"op":"text","speaker":"静久","text":"“我是水织静久。”"},{"op":"image","layer":513,"image":"i11307"},{"op":"text","speaker":"鸥","text":"“紬紬你们在和羽依里做什么呢？”"},{"op":"text","speaker":"羽依里","text":"“你们这朋友交得也太快了吧？”"},{"op":"image","layer":1,"image":"i13816"},{"op":"image","layer":257,"image":"i14506"},{"op":"text","speaker":"紬","text":"“我们在带对方游览这座岛。”"},{"op":"image","layer":513,"image":"i11336"},{"op":"text","speaker":"鸥","text":"“好像很好玩啊。我知道很多这岛上人烟罕至的地方。”"},{"op":"image","layer":513,"image":"i11307"},{"op":"text","speaker":"鸥","text":"“要不要带你们去玩玩？”"},{"op":"image","layer":257,"image":"i14489"},{"op":"text","speaker":"紬","text":"“可以吗？”"},{"op":"image","layer":513,"image":"i11339"},{"op":"text","speaker":"鸥","text":"“嗯！”"},{"op":"text","speaker":"","text":"就这样毫无征兆地，鸥开始带我们游览这座岛了。"},{"op":"text","speaker":"羽依里","text":"“……嗯？”"},{"op":"image","layer":1,"image":"i13840"},{"op":"text","speaker":"静久","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“静久？走啦。”"},{"op":"image","layer":1,"image":"i13825"},{"op":"text","speaker":"静久","text":"“呜～”"},{"op":"text","speaker":"","text":"她是在嫉妒鸥抢走了紬……吗？"},{"op":"text","speaker":"羽依里","text":"“看她这高兴劲，说不定会每天都找鸥玩。”"},{"op":"image","layer":1,"image":"i13837"},{"op":"text","speaker":"静久","text":"“……”"},{"op":"image","layer":1,"image":"i13788"},{"op":"text","speaker":"静久","text":"“……呜。”"},{"op":"text","speaker":"","text":"咦!؟哭了？"},{"op":"text","speaker":"羽依里","text":"“抱、抱歉！”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i158"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"鸥带着我们去了山上、能看到大海洞窟的位置等各种地点。"},{"op":"image","layer":7,"image":"i14488"},{"op":"text","speaker":"紬","text":"“你为什么知道这么稀奇的地方呀？”"},{"op":"image","layer":7,"image":"i11239"},{"op":"text","speaker":"鸥","text":"“嗯，因为我在找东西。”"},{"op":"image","layer":7,"image":"i14514"},{"op":"text","speaker":"紬","text":"“找东西……！”"},{"op":"image","layer":7,"image":"i13736"},{"op":"text","speaker":"静久","text":"“和你一样呢。”"},{"op":"image","layer":7,"image":"i14416"},{"op":"text","speaker":"紬","text":"“是的，我也在找东西。”"},{"op":"image","layer":7,"image":"i11310"},{"op":"text","speaker":"鸥","text":"“那我们就是伙伴了呢。”"},{"op":"image","layer":7,"image":"i11335"},{"op":"text","speaker":"鸥","text":"“紬紬在找什么呀？”"},{"op":"image","layer":7,"image":"i14376"},{"op":"text","speaker":"紬","text":"“自我。”"},{"op":"image","layer":7,"image":"i11306"},{"op":"text","speaker":"鸥","text":"“迷茫的年轻人啊。”"},{"op":"image","layer":7,"image":"i14398"},{"op":"text","speaker":"紬","text":"“然后，还有想做的事。”"},{"op":"image","layer":7,"image":"i11242"},{"op":"text","speaker":"鸥","text":"“青春真好。”"},{"op":"image","layer":7,"image":"i11239"},{"op":"text","speaker":"鸥","text":"“静静又在找什么呀？”"},{"op":"image","layer":7,"image":"i13760"},{"op":"text","speaker":"静久","text":"“静静!؟”"},{"op":"image","layer":7,"image":"i13766"},{"op":"text","speaker":"静久","text":"“很遗憾，我没什么要找的。”"},{"op":"image","layer":7,"image":"i11239"},{"op":"text","speaker":"鸥","text":"“这样啊。”"},{"op":"image","layer":7,"image":"i14466"},{"op":"text","speaker":"紬","text":"“那你在找什么呀？”"},{"op":"text","speaker":"羽依里","text":"“她在找行李箱。”"},{"op":"image","layer":7,"image":"i11306"},{"op":"text","speaker":"鸥","text":"“提着呢。”"},{"op":"image","layer":7,"image":"i11313"},{"op":"text","speaker":"鸥","text":"“呃，我在找的是……”"},{"op":"image","layer":7,"image":"i11325"},{"op":"text","speaker":"鸥","text":"“才不告诉你呢。”"},{"op":"image","layer":7,"image":"i14387"},{"op":"text","speaker":"紬","text":"“姆啾。”"},{"op":"image","layer":7,"image":"i11239"},{"op":"text","speaker":"鸥","text":"“找到就告诉你。”"},{"op":"image","layer":7,"image":"i14416"},{"op":"text","speaker":"紬","text":"“那请你务必光临灯塔。”"},{"op":"image","layer":7,"image":"i14380"},{"op":"text","speaker":"紬","text":"“登上灯塔，一定能找到你要找的东西。”"},{"op":"image","layer":7,"image":"i11242"},{"op":"text","speaker":"鸥","text":"“嗯，那我有空就去看看。”"},{"op":"image","layer":7,"image":"i14488"},{"op":"text","speaker":"紬","text":"“对了，夏天过去后我就要回去了。”"},{"op":"image","layer":7,"image":"i14505"},{"op":"text","speaker":"紬","text":"“希望你能在这个夏天光临。”"},{"op":"image","layer":7,"image":"i11239"},{"op":"text","speaker":"鸥","text":"“嗯，就这么定了。”"},{"op":"text","speaker":"","text":"接着，我们又去了学校、港口、食堂。"},{"op":"text","speaker":"","text":"没什么特别有意思的地方。"},{"op":"text","speaker":"","text":"但和大家一起度过这段时间，非常愉快。"},{"op":"text","speaker":"","text":"非常有暑假的味道。"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i11"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11240"},{"op":"text","speaker":"鸥","text":"“想必你们都知道，这里就是神社。”"},{"op":"image","layer":257,"image":"i14529"},{"op":"text","speaker":"紬","text":"“是举办祭典的地方吧。”"},{"op":"image","layer":257,"image":"i14543"},{"op":"text","speaker":"紬","text":"“节日里，这里就会有卖现做棉花糖的店。”"},{"op":"image","layer":257,"image":"i14547"},{"op":"text","speaker":"紬","text":"“新鲜的棉花糖只能保存一天，所以只有在那时候才能吃到。”"},{"op":"image","layer":257,"image":"i14545"},{"op":"text","speaker":"紬","text":"“非常好吃。”"},{"op":"text","speaker":"羽依里","text":"“你喜欢棉花糖吗？”"},{"op":"image","layer":257,"image":"i14460"},{"op":"text","speaker":"紬","text":"“最喜欢了。”"},{"op":"image","layer":257,"image":"i14445"},{"op":"text","speaker":"紬","text":"“我的主食就是棉花糖。”"},{"op":"text","speaker":"羽依里","text":"“当饭吃可真厉害。”"},{"op":"image","layer":1,"image":"i13807"},{"op":"text","speaker":"静久","text":"“小心别吃坏身子哦。”"},{"op":"image","layer":257,"image":"i14489"},{"op":"text","speaker":"紬","text":"“吃棉花糖吃坏身子……”"},{"op":"image","layer":257,"image":"i14494"},{"op":"text","speaker":"紬","text":"“我也毫无怨言！”"},{"op":"image","layer":513,"image":"i11245"},{"op":"text","speaker":"鸥","text":"“够朋克。”"},{"op":"image","layer":1,"image":"i14396"},{"op":"text","speaker":"紬","text":"“――姆啾!؟”"},{"op":"text","speaker":"羽依里","text":"“怎么了？”"},{"op":"image","layer":1,"image":"i14529"},{"op":"text","speaker":"紬","text":"“说到棉花糖，我想起一件事。”"},{"op":"image","layer":1,"image":"i14530"},{"op":"text","speaker":"紬","text":"“看我这记性，刚才忘记在小卖铺买吃的了。”"},{"op":"image","layer":1,"image":"i14534"},{"op":"text","speaker":"紬","text":"“必须回去一趟。”"},{"op":"text","speaker":"羽依里","text":"“是要去买你那棉花糖吧。”"},{"op":"image","layer":1,"image":"i14529"},{"op":"text","speaker":"紬","text":"“不，是买法国小面包。”"},{"op":"text","speaker":"羽依里","text":"“你刚才可不是这么说的。”"},{"op":"image","layer":1,"image":"i14377"},{"op":"text","speaker":"紬","text":"“光靠棉花糖可填不饱肚子。”"},{"op":"text","speaker":"羽依里","text":"“那我们解散吧？”"},{"op":"image","layer":257,"image":"i13737"},{"op":"image","layer":513,"image":"i11307"},{"op":"text","speaker":"静久","text":"“真可惜，我还有些地方想让你们带我去转转呢。”"},{"op":"image","layer":1,"image":"i14404"},{"op":"text","speaker":"紬","text":"“对不起大家，他日必当偿还。”"},{"op":"text","speaker":"羽依里","text":"“不用放在心上，我玩得也挺开心的。”"},{"op":"image","layer":1,"image":"i14417"},{"op":"text","speaker":"紬","text":"“这样啊。”"},{"op":"image","layer":1,"image":"i14381"},{"op":"text","speaker":"紬","text":"“告辞了。”"},{"op":"image","layer":257,"image":"i13770"},{"op":"text","speaker":"静久","text":"“嗯，再见。”"},{"op":"image","layer":513,"image":"i11326"},{"op":"text","speaker":"鸥","text":"“拜拜。”"},{"op":"text","speaker":"羽依里","text":"“下次再见。”"},{"op":"text","speaker":"","text":"就像有股默契似的，我们三人在与紬告别后也就此分别，回到了各自在岛上的住所。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]