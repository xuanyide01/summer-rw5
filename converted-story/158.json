[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"吃过早饭后，我们开始做出发的准备。"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“好多行李啊。”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“今天要出门吗？”"},{"op":"text","speaker":"羽依里","text":"“去一下山里。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“去个山里，为什么会有这么大的行李啊？”"},{"op":"image","layer":257,"image":"i10972"},{"op":"text","speaker":"鸥","text":"“说不定会露宿一宿。”"},{"op":"image","layer":257,"image":"i10975"},{"op":"text","speaker":"鸥","text":"“里面装了帐篷。”"},{"op":"image","layer":1,"image":"i15378"},{"op":"text","speaker":"羽未","text":"“什么!؟”"},{"op":"image","layer":1,"image":"i15579"},{"op":"text","speaker":"羽未","text":"“两个人露营？”"},{"op":"text","speaker":"","text":"羽未看着我们的行李，陷入了沉思。"},{"op":"text","speaker":"羽依里","text":"“羽未也要一起去吗？”"},{"op":"image","layer":257,"image":"i11064"},{"op":"text","speaker":"鸥","text":"“来吧。”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“不，我不去了。”"},{"op":"image","layer":513,"image":"i11488"},{"op":"text","speaker":"镜子","text":"“手臂没事了？”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"image","layer":513,"image":"i11490"},{"op":"text","speaker":"镜子","text":"“不要再做危险的事情了哦。”"},{"op":"text","speaker":"羽依里","text":"“没关系的。”"},{"op":"image","layer":513,"image":"i11486"},{"op":"text","speaker":"镜子","text":"“还有，采石场旧址是不允许进入的哦。”"},{"op":"text","speaker":"羽依里","text":"“唉。”"},{"op":"text","speaker":"羽依里","text":"“知，知道的啦。之前也说过了。”"},{"op":"image","layer":513,"image":"i11464"},{"op":"text","speaker":"镜子","text":"“我和美希打过招呼了。”"},{"op":"text","speaker":"羽依里","text":"“看来是这样了。”"},{"op":"image","layer":513,"image":"i11490"},{"op":"text","speaker":"镜子","text":"“因为你看起来很感兴趣的样子。”"},{"op":"image","layer":513,"image":"i11493"},{"op":"text","speaker":"镜子","text":"“我告诉她，如果你要进入禁止进入的地方，不要客气。”"},{"op":"return"},{"op":"end"}]