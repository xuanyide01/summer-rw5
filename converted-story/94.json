[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i363"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"从鸟白岛归来，已经过去了一周。"},{"op":"text","speaker":"","text":"暑假结束。"},{"op":"text","speaker":"","text":"我回到了学校。"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"……一天早上。"},{"op":"text","speaker":"","text":"我收到了一封信。"},{"op":"text","speaker":"","text":"寄信人写的是‘鸟白岛少年团’。"},{"op":"text","speaker":"","text":"里面是简短的信和照片。"},{"op":"text","speaker":"","text":"信上只是简单地写着这一句话。"},{"op":"text","speaker":"","text":"‘随时都可以回来！’"},{"op":"image","layer":0,"image":"i1137"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":2050},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"随时都能回去。"},{"op":"text","speaker":"","text":"回到那个地方。"},{"op":"text","speaker":"","text":"那个夏天。"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i169"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"头上有鸟儿飞过。"},{"op":"text","speaker":"","text":"那只鸟一定是要飞往很远的地方。"},{"op":"text","speaker":"","text":"时不时停下翅膀歇歇。"},{"op":"text","speaker":"","text":"然后继续它的旅途。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]