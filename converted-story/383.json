[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“早上好～哥哥。”"},{"op":"text","speaker":"羽依里","text":"“嗯……呼啊……啊呼……”"},{"op":"text","speaker":"羽依里","text":"“……咦，羽未？”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"","text":"好久都没有被羽未叫醒了。"},{"op":"text","speaker":"","text":"自从识借住在家里以来，我就一直在起居室睡觉。"},{"op":"text","speaker":"","text":"早上起得比较早的镜子阿姨和羽未为了不把我弄醒，都很体贴地没有叫我起床。"},{"op":"text","speaker":"羽依里","text":"“嗯……？”"},{"op":"text","speaker":"","text":"从厨房那边传来一股香味。"},{"op":"text","speaker":"羽依里","text":"“哦，已经到饭点了啊。”"},{"op":"text","speaker":"","text":"昨天拿到的海螺，光是一顿晚饭并不足以全部消耗掉。"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“姐姐做的饭好好吃哦。”"},{"op":"text","speaker":"羽依里","text":"“嗯，确实。”"},{"op":"image","layer":257,"image":"i13029"},{"op":"text","speaker":"识","text":"“呀，羽依里你醒了啊。”"},{"op":"text","speaker":"羽依里","text":"“早上好。”"},{"op":"image","layer":257,"image":"i12978"},{"op":"text","speaker":"识","text":"“早饭马上就做好了，你先去洗把脸吧。”"},{"op":"text","speaker":"","text":"说完，识就回到了厨房。"},{"op":"text","speaker":"","text":"诱人的香气变得更为浓郁了。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11549"},{"op":"image","layer":257,"image":"i13000"},{"op":"image","layer":513,"image":"i15375"},{"op":"text","speaker":"镜子","text":"“那我开始吃了哦，小识。”"},{"op":"image","layer":513,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“我开始吃了。”"},{"op":"text","speaker":"羽依里","text":"“我开始吃了。”"},{"op":"image","layer":257,"image":"i12978"},{"op":"text","speaker":"识","text":"“请慢用！”"},{"op":"text","speaker":"","text":"餐桌上摆着的菜品，让人久违地感受到了‘和风’。"},{"op":"text","speaker":"","text":"有凉拌山菜、浅渍菜、青菜味噌汤。"},{"op":"text","speaker":"","text":"主食材自然是海螺，有海螺串烧、甜辣炖煮，甚至还有壶烧。"},{"op":"text","speaker":"","text":"最后压轴的是海螺蒸饭。"},{"op":"text","speaker":"","text":"简直是海螺盛宴。"},{"op":"image","layer":1,"image":"i15355"},{"op":"text","speaker":"羽未","text":"“啊呜……嚼嚼……”"},{"op":"image","layer":257,"image":"i13000"},{"op":"text","speaker":"识","text":"“怎么样？”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“好吃――！特别好吃――！”"},{"op":"image","layer":257,"image":"i12984"},{"op":"text","speaker":"识","text":"“嗯嘿嘿。”"},{"op":"image","layer":513,"image":"i11584"},{"op":"text","speaker":"镜子","text":"“嗯，真的很好吃呢，小识。”"},{"op":"image","layer":257,"image":"i12993"},{"op":"text","speaker":"识","text":"“你们喜欢就太好了。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“镜子阿姨，这个又甜又辣的好好吃啊！”"},{"op":"text","speaker":"","text":"难得见到羽未会因为吃的东西这么兴奋。"},{"op":"image","layer":513,"image":"i11549"},{"op":"text","speaker":"镜子","text":"“让我尝尝……啊呜……嗯，真的呢。”"},{"op":"image","layer":513,"image":"i11546"},{"op":"text","speaker":"镜子","text":"“生姜的味道恰到好处，很美味呢。”"},{"op":"image","layer":257,"image":"i12984"},{"op":"text","speaker":"识","text":"“嗯嘿嘿嘿嘿。”"},{"op":"image","layer":257,"image":"i13000"},{"op":"text","speaker":"识","text":"“羽依里呢，觉得怎么――”"},{"op":"text","speaker":"羽依里","text":"“嚼嚼……咕咚。再来一碗。”"},{"op":"image","layer":513,"image":"i11566"},{"op":"image","layer":257,"image":"i13001"},{"op":"image","layer":1,"image":"i15353"},{"op":"text","speaker":"","text":"我把空碗递给了识。"},{"op":"image","layer":1,"image":"i15378"},{"op":"text","speaker":"羽未","text":"“好快呀！”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“哥哥是个贪吃鬼！”"},{"op":"text","speaker":"羽依里","text":"“因为太好吃了嘛。”"},{"op":"image","layer":513,"image":"i11581"},{"op":"text","speaker":"","text":"海螺蒸饭的味道实在是太棒了。"},{"op":"image","layer":257,"image":"i13000"},{"op":"text","speaker":"识","text":"“你爱吃吗？”"},{"op":"text","speaker":"羽依里","text":"“嗯。光是这个我就能吃上好几碗。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“能吃好几碗！”"},{"op":"image","layer":257,"image":"i12984"},{"op":"text","speaker":"识","text":"“听你这么说我很开心哦。嗯嘿嘿。”"},{"op":"text","speaker":"","text":"识开心地接过我的碗，盛了满当当一大碗饭之后还给了我。"},{"op":"image","layer":257,"image":"i12982"},{"op":"text","speaker":"识","text":"“还有很多呢，想吃多少碗都可以哦。”"},{"op":"text","speaker":"羽依里","text":"“好！”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“我也要再来一碗～”"},{"op":"image","layer":513,"image":"i11546"},{"op":"text","speaker":"镜子","text":"“那我也再来一碗好了。”"},{"op":"text","speaker":"识","text":"“还有很多呢，请尽管吃。”"},{"op":"image","layer":513,"image":"i11581"},{"op":"text","speaker":"镜子","text":"“不过海螺饭真是好怀念呀。”"},{"op":"image","layer":513,"image":"i11549"},{"op":"text","speaker":"镜子","text":"“以前你外婆偶尔会做这个的。”"},{"op":"text","speaker":"识","text":"“这可是岛上的传统料理哦。”"},{"op":"image","layer":513,"image":"i11566"},{"op":"text","speaker":"镜子","text":"“咦，是这样吗？”"},{"op":"text","speaker":"羽依里","text":"“镜子阿姨也不知道吗？”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“传统料理？炒饭吗？”"},{"op":"text","speaker":"羽依里","text":"“那只是羽未你自己爱吃而已吧。”"},{"op":"image","layer":513,"image":"i11571"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“呜咪～……”"},{"op":"image","layer":257,"image":"i13000"},{"op":"text","speaker":"识","text":"“如果觉得这道海螺饭好吃的话，希望你们能记住一件事。”"},{"op":"image","layer":257,"image":"i12993"},{"op":"text","speaker":"识","text":"“那就是，这座岛上有很多事物已经被遗忘了。”"},{"op":"image","layer":513,"image":"i11578"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽依里","text":"“识？”"},{"op":"image","layer":257,"image":"i12984"},{"op":"text","speaker":"识","text":"“嗯嘿嘿。”"},{"op":"return"},{"op":"end"}]