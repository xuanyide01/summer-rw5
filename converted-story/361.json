[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":7,"image":"i15520"},{"op":"text","speaker":"羽未","text":"“…………”"},{"op":"text","speaker":"羽依里","text":"“再来一次。”"},{"op":"image","layer":1,"image":"i12978"},{"op":"text","speaker":"识","text":"“前辈。”"},{"op":"text","speaker":"羽依里","text":"“啊啊……”"},{"op":"image","layer":7,"image":"i15520"},{"op":"text","speaker":"羽未","text":"“…………”"},{"op":"text","speaker":"羽依里","text":"“再来一次！”"},{"op":"image","layer":1,"image":"i12985"},{"op":"text","speaker":"识","text":"“那个……羽依里？”"},{"op":"text","speaker":"羽依里","text":"“不要叫这个，叫前辈！”"},{"op":"image","layer":1,"image":"i13003"},{"op":"text","speaker":"识","text":"“不是……有人回来了。”"},{"op":"image","layer":257,"image":"i15521"},{"op":"text","speaker":"羽依里","text":"“哎？……啊，羽未……”"},{"op":"image","layer":257,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“……前辈……？”"},{"op":"text","speaker":"羽依里","text":"“那个……欢迎回来？”"},{"op":"image","layer":257,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“学长，我回来啦――”"},{"op":"text","speaker":"羽依里","text":"“哇……！这真是……”"},{"op":"text","speaker":"","text":"小孩子居然叫我前辈……这杀伤力也太大了！"},{"op":"image","layer":1,"image":"i13001"},{"op":"text","speaker":"识","text":"“羽依里，这位是？”"},{"op":"text","speaker":"羽依里","text":"“……是我的亲戚羽未。”"},{"op":"image","layer":257,"image":"i15499"},{"op":"text","speaker":"羽未","text":"“初次见面，我是羽未。”"},{"op":"image","layer":1,"image":"i13026"},{"op":"text","speaker":"识","text":"“我是神山识。”"},{"op":"text","speaker":"羽依里","text":"“识从今天起要在我们家里借住了。”"},{"op":"image","layer":257,"image":"i15372"},{"op":"image","layer":1,"image":"i12985"},{"op":"text","speaker":"识","text":"“咦，是这样吗？”"},{"op":"image","layer":257,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“哇――是这样啊――”"},{"op":"text","speaker":"羽依里","text":"“刚才我和镜子阿姨商量之后决定的。”"},{"op":"text","speaker":"羽依里","text":"“说是不能就这样把她丢在外面，所以在她达成目的之前就让她住在这里。”"},{"op":"image","layer":257,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“目的？”"},{"op":"text","speaker":"羽依里","text":"“识是来岛上寻找过去存在过的鬼的。”"},{"op":"image","layer":1,"image":"i13011"},{"op":"text","speaker":"识","text":"“而我实际上就是鬼哦。”"},{"op":"text","speaker":"","text":"她得意洋洋地挺起胸膛说道。"},{"op":"image","layer":257,"image":"i15378"},{"op":"text","speaker":"羽未","text":"“鬼！好厉害！”"},{"op":"text","speaker":"羽依里","text":"“嗯嗯，真是新鲜的反应啊。”"},{"op":"image","layer":257,"image":"i15372"},{"op":"image","layer":1,"image":"i12999"},{"op":"text","speaker":"识","text":"“不过，既然要承蒙各位照顾，那就得付住宿费才行呢。”"},{"op":"image","layer":1,"image":"i13000"},{"op":"text","speaker":"识","text":"“说到食宿之恩，那可是要以人生相报的大恩情啊。”"},{"op":"text","speaker":"羽依里","text":"“你还是多珍惜下自己的人生吧。”"},{"op":"image","layer":1,"image":"i12993"},{"op":"text","speaker":"识","text":"“别太在意字面意思，主要领会一下我的心意。”"},{"op":"image","layer":1,"image":"i13011"},{"op":"text","speaker":"识","text":"“所以呢，我可以帮你们实现一个愿望。”"},{"op":"text","speaker":"羽依里","text":"“来了。”"},{"op":"image","layer":257,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“什么都可以？”"},{"op":"image","layer":1,"image":"i12978"},{"op":"text","speaker":"识","text":"“什么都行哦。”"},{"op":"image","layer":257,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“那让我看看角。”"},{"op":"image","layer":1,"image":"i13001"},{"op":"text","speaker":"识","text":"“啊……”"},{"op":"image","layer":257,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“你是鬼对吧？让我看看角。”"},{"op":"image","layer":1,"image":"i12987"},{"op":"text","speaker":"识","text":"“角、角啊……角的话……”"},{"op":"text","speaker":"","text":"她的眼神飘忽不定。"},{"op":"text","speaker":"羽依里","text":"“羽未，识是世上罕见的没有长角的鬼哦。”"},{"op":"image","layer":257,"image":"i15378"},{"op":"text","speaker":"羽未","text":"“好厉害――！”"},{"op":"text","speaker":"","text":"啊，多么单纯的好孩子啊。"},{"op":"image","layer":7,"image":"i12992"},{"op":"text","speaker":"识","text":"“呜呜……她真是个好孩子。”"},{"op":"text","speaker":"","text":"识也很感动。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"然后，到了晚饭时间。"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“晚――饭――”"},{"op":"image","layer":257,"image":"i11584"},{"op":"text","speaker":"镜子","text":"“小识，你要多吃一点哦。”"},{"op":"image","layer":513,"image":"i13001"},{"op":"text","speaker":"识","text":"“这是……”"},{"op":"text","speaker":"","text":"她正坐着，镜子阿姨御用的杯面们就摆在她的面前。"},{"op":"text","speaker":"羽未","text":"“很好吃的哦。”"},{"op":"image","layer":513,"image":"i12985"},{"op":"text","speaker":"识","text":"“这种东西，我还是第一次吃呢。”"},{"op":"text","speaker":"","text":"说着，她双手合十。"},{"op":"image","layer":513,"image":"i12978"},{"op":"text","speaker":"识","text":"“我开始吃了。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"image","layer":257,"image":"i11549"},{"op":"text","speaker":"镜子","text":"“哎呀，真讲礼仪呢。”"},{"op":"image","layer":513,"image":"i12984"},{"op":"text","speaker":"识","text":"“对面前的食物表示感谢是理所当然的。”"},{"op":"image","layer":513,"image":"i13000"},{"op":"text","speaker":"识","text":"“对做了这份食物的人，以及对这份恩赐本身表示感谢。”"},{"op":"text","speaker":"羽依里","text":"“……虽然是速食面就是了……”"},{"op":"text","speaker":"","text":"我也学着她双手合十。"},{"op":"text","speaker":"羽依里","text":"“我开始吃了。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"image","layer":257,"image":"i12978"},{"op":"text","speaker":"识","text":"“啊呜！滋溜滋溜……嗯嗯……咕咚。”"},{"op":"image","layer":257,"image":"i12982"},{"op":"text","speaker":"识","text":"“好吃！太好吃了！”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“嗯，很好吃哦――”"},{"op":"image","layer":257,"image":"i13000"},{"op":"text","speaker":"识","text":"“羽依里，你平时都吃这样的美食吗？”"},{"op":"text","speaker":"羽依里","text":"“……我不想把这个叫做美食。”"},{"op":"image","layer":257,"image":"i13001"},{"op":"text","speaker":"识","text":"“是这样吗？”"},{"op":"image","layer":257,"image":"i12985"},{"op":"text","speaker":"识","text":"“我倒是觉得很好吃就是了。”"},{"op":"image","layer":257,"image":"i12993"},{"op":"text","speaker":"识","text":"“主要是这个味道……”"},{"op":"image","layer":257,"image":"i12978"},{"op":"text","speaker":"识","text":"“感觉跟御结饭团很搭呢！”"},{"op":"image","layer":1,"image":"i11578"},{"op":"text","speaker":"镜子","text":"“饭团……？”"},{"op":"text","speaker":"","text":"镜子阿姨看向了我。"},{"op":"text","speaker":"羽依里","text":"“她是个对饭团有些执着的怪孩子。”"},{"op":"image","layer":1,"image":"i11581"},{"op":"text","speaker":"镜子","text":"“那我去捏几个饭团来？”"},{"op":"image","layer":257,"image":"i12982"},{"op":"text","speaker":"识","text":"“真的吗!؟”"},{"op":"image","layer":257,"image":"i12985"},{"op":"image","layer":1,"image":"i11578"},{"op":"text","speaker":"羽依里","text":"“No!!”"},{"op":"image","layer":7,"image":"i15581"},{"op":"text","speaker":"羽未","text":"“……瑟瑟发抖。”"},{"op":"image","layer":257,"image":"i13001"},{"op":"text","speaker":"识","text":"“咦？为什么啊？”"},{"op":"text","speaker":"羽依里","text":"“呃……因为还没煮米饭。”"},{"op":"text","speaker":"羽依里","text":"“现在去煮的话，杯面就要坨了。”"},{"op":"image","layer":7,"image":"i15568"},{"op":"text","speaker":"羽未","text":"“……点头。”"},{"op":"image","layer":257,"image":"i12999"},{"op":"text","speaker":"识","text":"“这样啊，真可惜。”"},{"op":"image","layer":1,"image":"i11546"},{"op":"text","speaker":"镜子","text":"“那就下次吧。”"},{"op":"image","layer":257,"image":"i13000"},{"op":"text","speaker":"识","text":"“嗯，我很期待哦。”"},{"op":"text","speaker":"","text":"该说她无知者无畏呢，还是该让她吃一次体会一下呢……"},{"op":"text","speaker":"","text":"算了，只要住在这个家里，肯定迟早会领教到的吧。"},{"op":"text","speaker":"","text":"不过话说回来……"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"image","layer":0,"image":"i455"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"从今晚开始，屋里就会有一个男人跟三个女人啊。"},{"op":"text","speaker":"","text":"虽然很热闹……但可能会有点不自在……"},{"op":"text","speaker":"","text":"比如洗澡的顺序啊，上厕所啊之类的……"},{"op":"text","speaker":"","text":"看来得稍微注意一下生活细节了。"},{"op":"return"},{"op":"end"}]