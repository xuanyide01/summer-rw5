[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我来到了小卖铺。"},{"op":"text","speaker":"","text":"但是，一个人都没有。"},{"op":"text","speaker":"","text":"我在店里来回看了一圈。"},{"op":"text","speaker":"","text":"果然一个人都没有。"},{"op":"text","speaker":"","text":"这……或许是个好机会啊。"},{"op":"text","speaker":"","text":"正好有件很久前就想做的事。"},{"op":"text","speaker":"","text":"我要在这里……"},{"op":"text","speaker":"","text":"练习表白！"},{"op":"text","speaker":"","text":"在这空无一人的地方或许我能做到。"},{"op":"text","speaker":"","text":"表白的日子，总有一天会到来的吧。"},{"op":"text","speaker":"","text":"现在，我要为了那个时刻而练习！"},{"op":"text","speaker":"","text":"在男校里练习的日子令人怀念……"},{"op":"text","speaker":"","text":"首先，先做一个深呼吸……"},{"op":"if","truth":false,"target":86,"value":["==",["v",39],1]},{"op":"image","layer":1,"image":"i11709"},{"op":"text","speaker":"美希","text":"“鹰原，你在这里做什么呢？”"},{"op":"text","speaker":"羽依里","text":"“唔噢！好悬啊！”"},{"op":"image","layer":1,"image":"i11699"},{"op":"text","speaker":"美希","text":"“什么好悬？”"},{"op":"text","speaker":"羽依里","text":"“我差点就向你表白了。”"},{"op":"image","layer":1,"image":"i11758"},{"op":"text","speaker":"美希","text":"“嚯……”"},{"op":"image","layer":1,"image":"i11789"},{"op":"text","speaker":"美希","text":"“这真是个有意思的玩笑。”"},{"op":"text","speaker":"羽依里","text":"“啊，等下，不要把Hydro掏出来。”"},{"op":"image","layer":1,"image":"i11704"},{"op":"text","speaker":"美希","text":"“唔……好像有人过来了。”"},{"op":"text","speaker":"羽依里","text":"“快藏起来！”"},{"op":"text","speaker":"","text":"我拉着野美希的手，藏进了店里。"},{"op":"image","layer":7,"image":"i11700"},{"op":"text","speaker":"美希","text":"（为什么非要藏起来不可啊。）"},{"op":"text","speaker":"羽依里","text":"（啊，那个……不知不觉就……）"},{"op":"text","speaker":"","text":"我窥视着外面的情况。"},{"op":"text","speaker":"岛上的男孩A","text":"“那……那个，谢谢你能过来……”"},{"op":"text","speaker":"岛上的女孩A","text":"“嗯……你说有事是什么事……”"},{"op":"text","speaker":"岛上的男孩A","text":"“那个……”"},{"op":"text","speaker":"岛上的男孩A","text":"“如！如果可以的话！下次要不要一起去玩！”"},{"op":"text","speaker":"岛上的女孩A","text":"“你说的……应该不是大家一起去……吧？”"},{"op":"text","speaker":"岛上的男孩A","text":"“啊，嗯！就我们两个……”"},{"op":"text","speaker":"岛上的女孩A","text":"“…………”"},{"op":"text","speaker":"岛上的女孩A","text":"“……可以，的……”"},{"op":"text","speaker":"岛上的男孩A","text":"“太好啦～……我还在担心，要是被你拒绝了怎么办。”"},{"op":"text","speaker":"岛上的女孩A","text":"“那个，在那之前，可以先答应我一件事么……？”"},{"op":"text","speaker":"岛上的男孩A","text":"“咦……什，什么事啊。”"},{"op":"text","speaker":"岛上的女孩A","text":"“我们两个人独处的时候，如果你能叫我的名字的话，我会很开心的。”"},{"op":"text","speaker":"岛上的男孩A","text":"“啊，嗯……朱……朱里绘都。”"},{"op":"text","speaker":"岛上的女孩A","text":"“哎嘿嘿，走吧，絽壬绪。”"},{"op":"text","speaker":"","text":"岛上的男孩和女孩，就这样手牵着手，从小卖铺门口离去了。"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"image","layer":1,"image":"i11724"},{"op":"text","speaker":"美希","text":"“…………”"},{"op":"text","speaker":"羽依里","text":"“……我说，野美希……”"},{"op":"text","speaker":"羽依里","text":"“最近的小学生……有点厉害啊……”"},{"op":"image","layer":1,"image":"i11718"},{"op":"text","speaker":"美希","text":"“不，不要靠近我！”"},{"op":"text","speaker":"羽依里","text":"“哎？为什么？”"},{"op":"image","layer":1,"image":"i11721"},{"op":"text","speaker":"美希","text":"“这，这种心跳的感觉是所谓的吊桥效应！”"},{"op":"image","layer":1,"image":"i11712"},{"op":"text","speaker":"美希","text":"“要是你不小心在这种时候向我表白了的话……”"},{"op":"image","layer":1,"image":"i11724"},{"op":"text","speaker":"美希","text":"“不是会……让我误会么……”"},{"op":"text","speaker":"羽依里","text":"“我说……你等一下啊……”"},{"op":"text","speaker":"羽依里","text":"“突然听你说出这么可爱的话……”"},{"op":"text","speaker":"羽依里","text":"“我会心动的……”"},{"op":"text","speaker":"羽依里","text":"“我上的是男校……”"},{"op":"text","speaker":"羽依里","text":"“对这种反差没什么免疫力的。”"},{"op":"text","speaker":"羽依里","text":"“会产生误会的。”"},{"op":"image","layer":1,"image":"i11712"},{"op":"text","speaker":"美希","text":"“…………”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"image","layer":1,"image":"i11795"},{"op":"text","speaker":"美希","text":"“Hydro Gladiator改！自爆模式！”"},{"op":"text","speaker":"","text":"啪沙――！"},{"op":"text","speaker":"羽依里","text":"“哇啊！你为什么要朝自己滋水啊！”"},{"op":"image","layer":1,"image":"i11789"},{"op":"text","speaker":"美希","text":"“我，我只是让自己的大脑冷静下！”"},{"op":"image","layer":1,"image":"i11776"},{"op":"text","speaker":"美希","text":"“我要走了！”"},{"op":"text","speaker":"","text":"说完，野美希就一身落汤鸡地从我面前走掉了。"},{"op":"text","speaker":"","text":"……我的心怦怦地跳。"},{"op":"goto","target":105},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"羽依里","text":"“感觉有点羞耻，我做不到啊――――――！”"},{"op":"text","speaker":"","text":"在小卖铺前表白，我到底在想什么啊？"},{"op":"text","speaker":"","text":"是夏日的热浪把我的脑子给烧坏了吗？"},{"op":"text","speaker":"","text":"得稍微让脑子冷静一下。"},{"op":"text","speaker":"羽依里","text":"“呼……”"},{"op":"text","speaker":"羽依里","text":"“良一，我要借用下你的技能了。”"},{"op":"text","speaker":"羽依里","text":"“喝啊!!”"},{"op":"text","speaker":"","text":"我一把脱掉了自己的衣服。"},{"op":"text","speaker":"","text":"一瞬间。"},{"op":"text","speaker":"","text":"啪咻！"},{"op":"text","speaker":"羽依里","text":"“啊！”"},{"op":"text","speaker":"","text":"水柱如我预想的一样射了过来。"},{"op":"text","speaker":"美希","text":"‘严禁在海水浴场以外的地方脱衣。’"},{"op":"text","speaker":"美希","text":"‘给我立刻穿上衣服。’"},{"op":"text","speaker":"","text":"然后是惯例的台词。"},{"op":"text","speaker":"","text":"但是，这次正好。"},{"op":"text","speaker":"","text":"我飒爽地穿上了衣服，朝着铁塔深深地鞠了一躬。"},{"op":"text","speaker":"","text":"在远处的野美希，歪着脑袋一脸迷茫。"},{"op":"add","variable":6030,"value":1},{"op":"set","variable":21,"value":1},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"return"},{"op":"end"}]