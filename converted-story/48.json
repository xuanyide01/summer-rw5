[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"咦？"},{"op":"image","layer":0,"image":"i1070"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i1069"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"是白羽。"},{"op":"text","speaker":"","text":"她在商店入口附近的树旁边，观察着四周。"},{"op":"text","speaker":"","text":"在搞什么呢。"},{"op":"text","speaker":"羽依里","text":"“哇。”"},{"op":"image","layer":0,"image":"i1071"},{"op":"set","variable":6714,"value":0},{"op":"set","variable":30013,"value":1},{"op":"text","speaker":"白羽","text":" “"},{"op":"text","speaker":"白羽","text":"呀啊啊啊啊啊啊!!” "},{"op":"text","speaker":"羽依里","text":"“哇啊啊啊啊！”"},{"op":"text","speaker":"白羽","text":"“你想，干，什么。”"},{"op":"text","speaker":"羽依里","text":"“对不起，因为你的反应超我想象十倍，把我也吓到了。”"},{"op":"text","speaker":"白羽","text":"“拜托你不要在这种时候突然跟我搭话。”"},{"op":"text","speaker":"羽依里","text":"“什么这种时候……你不就只是来小卖铺而已嘛。”"},{"op":"text","speaker":"白羽","text":"“是没错。”"},{"op":"text","speaker":"羽依里","text":"“干什么要鬼鬼祟祟的啊？”"},{"op":"image","layer":0,"image":"i1069"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“没什么……”"},{"op":"text","speaker":"","text":"白羽说着，眼睛不停地往店中瞅。"},{"op":"text","speaker":"羽依里","text":"“哦。”"},{"op":"text","speaker":"羽依里","text":"“想顺走东西啊。”"},{"op":"image","layer":0,"image":"i1071"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“才不是！”"},{"op":"image","layer":0,"image":"i1072"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“我是想买点东西。”"},{"op":"text","speaker":"","text":"然而她却在犹豫进不进去。"},{"op":"text","speaker":"","text":"为什么呢？"},{"op":"text","speaker":"","text":"好像是想买什么，又买不了似的。"},{"op":"text","speaker":"羽依里","text":"“有什么想要的话我帮你买怎样？”"},{"op":"text","speaker":"","text":"当我还以为会被她婉拒时――"},{"op":"image","layer":0,"image":"i1071"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“……可以吗？”"},{"op":"text","speaker":"","text":"白羽像是得救一般松了口气，两眼放光。"},{"op":"text","speaker":"羽依里","text":"“可以，要我买什么？”"},{"op":"image","layer":0,"image":"i1072"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"白羽","text":"“西瓜……”"},{"op":"text","speaker":"羽依里","text":"“西瓜是吧。”"},{"op":"text","speaker":"羽依里","text":"“虽然感觉附近的田地里也能找到。”"},{"op":"image","layer":0,"image":"i1071"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“棒！”"},{"op":"text","speaker":"羽依里","text":"“怎、怎么了？”"},{"op":"text","speaker":"","text":"突如其来的叫声，吓得我缩了起来。"},{"op":"text","speaker":"","text":"棒……棒؟؟"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"什么意思啊。"},{"op":"text","speaker":"羽依里","text":"“棒棒哦～”"},{"op":"text","speaker":"羽依里","text":"“像这样的？”"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"她干嘛没头没尾地开这种玩笑啊。"},{"op":"text","speaker":"羽依里","text":"“不过，可爱倒是挺可爱……的吧。”"},{"op":"text","speaker":"","text":"我鼓起勇气夸奖。"},{"op":"image","layer":0,"image":"i1072"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“不是。”"},{"op":"text","speaker":"","text":"她很严肃地反驳到。"},{"op":"text","speaker":"白羽","text":"“西瓜，棒。”"},{"op":"text","speaker":"羽依里","text":"“呃。”"},{"op":"text","speaker":"羽依里","text":"“西瓜棒棒哦？”"},{"op":"text","speaker":"","text":"什么玩意，听着真怪。"},{"op":"text","speaker":"羽依里","text":"“可爱倒是挺可爱的吧……”"},{"op":"text","speaker":"","text":"我鼓起勇气夸奖。"},{"op":"image","layer":0,"image":"i1073"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“不是。”"},{"op":"text","speaker":"","text":"她很严肃地反驳道。不，还带点怒气。"},{"op":"text","speaker":"白羽","text":"“西瓜棒。”"},{"op":"text","speaker":"白羽","text":"“冰淇淋。”"},{"op":"text","speaker":"羽依里","text":"“啊，哦，是说这个啊。”"},{"op":"text","speaker":"","text":"原来是那种冰淇淋。"},{"op":"text","speaker":"羽依里","text":"“准确来说那应该是冰棍，跟冰淇淋是不一样的。”"},{"op":"text","speaker":"羽依里","text":"“其他还有奶冰和乳糖冰什么的。”"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“好吧说偏了。”"},{"op":"text","speaker":"","text":"可是为什么她不自己去买呢。"},{"op":"text","speaker":"羽依里","text":"“买西瓜棒有什么见不得人的吗？”"},{"op":"text","speaker":"羽依里","text":"“又不是买小黄本。”"},{"op":"image","layer":0,"image":"i1071"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“!!!!”"},{"op":"text","speaker":"羽依里","text":"“啊，对不起。不应该拿这个比较的。”"},{"op":"image","layer":0,"image":"i1072"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“因为会被骂。”"},{"op":"text","speaker":"羽依里","text":"“买西瓜棒就会被骂？”"},{"op":"text","speaker":"","text":"她点了点头。"},{"op":"text","speaker":"","text":"唔。"},{"op":"text","speaker":"","text":"家里太严格吗。"},{"op":"text","speaker":"","text":"规定不准随便买零食吃之类的。"},{"op":"text","speaker":"","text":"嗯，这岛上干什么都会口口相传，最后传到自己家人那里。"},{"op":"text","speaker":"羽依里","text":"“总之我去帮你买就是了。”"},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"走进店中。"},{"op":"text","speaker":"","text":"打开冰柜，拿出西瓜棒。"},{"op":"text","speaker":"","text":"交到收银台。"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“多谢惠顾。”"},{"op":"text","speaker":"","text":"顺利地买到了。"},{"op":"text","speaker":"","text":"……"},{"op":"image","layer":1,"image":"i13141"},{"op":"text","speaker":"羽依里","text":"“好了请吧。”"},{"op":"image","layer":1,"image":"i13111"},{"op":"text","speaker":"白羽","text":"“谢谢……”"},{"op":"text","speaker":"","text":"白羽的表情缓和了下来。"},{"op":"text","speaker":"","text":"是自我遇到她后最灿烂的笑脸。"},{"op":"text","speaker":"","text":"凭一根西瓜棒。"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i1074"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"然而，从我手上接过东西后，白羽的表情明显地沉了下去。"},{"op":"text","speaker":"白羽","text":"“不对。”"},{"op":"text","speaker":"白羽","text":"“这是蜜瓜棒。”"},{"op":"text","speaker":"羽依里","text":"“咦？”"},{"op":"text","speaker":"","text":"蜜、蜜瓜棒？"},{"op":"text","speaker":"羽依里","text":"“还真是。”"},{"op":"text","speaker":"羽依里","text":"“看起来挺像的让我搞错了。”"},{"op":"text","speaker":"羽依里","text":"“算了吧，都差不多。”"},{"op":"image","layer":0,"image":"i1075"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“差远了。”"},{"op":"text","speaker":"白羽","text":"“天地之差。”"},{"op":"text","speaker":"羽依里","text":"“差这么远吗？”"},{"op":"text","speaker":"羽依里","text":"“好吧，你等等，我再去买。”"},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"这时……"},{"op":"text","speaker":"","text":"一个裸着上身的男人走进店中。"},{"op":"image","layer":1,"image":"i12087"},{"op":"text","speaker":"良一","text":"“咦!؟”"},{"op":"image","layer":1,"image":"i12072"},{"op":"text","speaker":"良一","text":"“婆婆，怎么就剩西瓜棒了啊？”"},{"op":"image","layer":1,"image":"i12100"},{"op":"text","speaker":"良一","text":"“蜜瓜棒呢؟؟”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“我怎么知道啊。”"},{"op":"image","layer":1,"image":"i12075"},{"op":"text","speaker":"良一","text":"“内行都吃蜜瓜棒啊。”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“谁知道啊。”"},{"op":"image","layer":1,"image":"i12072"},{"op":"text","speaker":"良一","text":"“唉算了，就这个吧。”"},{"op":"image","layer":1,"image":"i12094"},{"op":"text","speaker":"良一","text":"“嚼。”"},{"op":"image","layer":1,"image":"i12075"},{"op":"text","speaker":"良一","text":"“唉……”"},{"op":"image","layer":1,"image":"i12106"},{"op":"text","speaker":"良一","text":"“果然还是蜜瓜棒比较好。”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i1075"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"一股要杀人的视线瞪着他。"},{"op":"text","speaker":"","text":"吓到的是我。"},{"op":"text","speaker":"羽依里","text":"“那、那我，这就去买了。”"},{"op":"image","layer":0,"image":"i1074"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“谢谢……”"},{"op":"image","layer":0,"image":"i158"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"……然后。"},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13076"},{"op":"text","speaker":"羽依里","text":"“卖完了。”"},{"op":"text","speaker":"羽依里","text":"“刚才那是最后一根。”"},{"op":"image","layer":1,"image":"i13071"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“请。”"},{"op":"text","speaker":"","text":"我递出蜜瓜棒。"},{"op":"image","layer":1,"image":"i13069"},{"op":"text","speaker":"白羽","text":"“你请。”"},{"op":"text","speaker":"","text":"她推了回来。"},{"op":"text","speaker":"羽依里","text":"“可是钱……”"},{"op":"image","layer":1,"image":"i13059"},{"op":"text","speaker":"白羽","text":"“请你了。”"},{"op":"text","speaker":"羽依里","text":"“是、是吗。”"},{"op":"text","speaker":"","text":"再不吃也只会化掉。"},{"op":"text","speaker":"羽依里","text":"“不客气了。”"},{"op":"text","speaker":"","text":"我为什么会在吃着冰棍呢。"},{"op":"image","layer":1,"image":"i13115"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"在满脸写满悲伤的白羽面前。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"return"},{"op":"end"}]