[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……唔。”"},{"op":"text","speaker":"","text":"清晨，我在镜前做着各种尝试。"},{"op":"image","layer":1,"image":"i15406"},{"op":"text","speaker":"羽未","text":"“你在干什么？”"},{"op":"text","speaker":"羽依里","text":"“做准备。”"},{"op":"image","layer":1,"image":"i15394"},{"op":"text","speaker":"羽未","text":"“都占着镜子30分钟了哦。”"},{"op":"text","speaker":"羽依里","text":"“你觉得我刘海梳这边和这边，哪边更好？”"},{"op":"image","layer":1,"image":"i15403"},{"op":"text","speaker":"羽未","text":"“随便哪边都行。”"},{"op":"text","speaker":"羽依里","text":"“不，这很重要。”"},{"op":"image","layer":1,"image":"i15408"},{"op":"text","speaker":"羽未","text":"“我觉得重要的是内在。”"},{"op":"text","speaker":"羽依里","text":"“原来如此，你说的确实没错。”"},{"op":"image","layer":1,"image":"i15403"},{"op":"text","speaker":"羽未","text":"“光有外表的男人，看多就腻了。”"},{"op":"text","speaker":"羽依里","text":"“……老师。”"},{"op":"image","layer":1,"image":"i15353"},{"op":"text","speaker":"羽未","text":"“什么？”"},{"op":"text","speaker":"羽依里","text":"“没什么，只是感觉你的话让我醍醐灌顶。”"},{"op":"text","speaker":"羽依里","text":"“所以，感觉羽未太值得尊敬一下了。”"},{"op":"image","layer":1,"image":"i15445"},{"op":"text","speaker":"羽未","text":"“哪里～，也没什么大不了的啦～”"},{"op":"image","layer":1,"image":"i15426"},{"op":"text","speaker":"羽未","text":"“像我们这年纪的女孩，都会这么说的。”"},{"op":"text","speaker":"羽依里","text":"“看来女孩确实是比男孩更早熟些。”"},{"op":"text","speaker":"羽依里","text":"“那么在成熟的羽未看来，现在的我，如何？”"},{"op":"image","layer":1,"image":"i15394"},{"op":"text","speaker":"羽未","text":"“我就觉得你在白费功夫。”"},{"op":"text","speaker":"羽依里","text":"“原来如此。”"},{"op":"text","speaker":"羽依里","text":"“内在已经那么好了，所以摆弄外表根本就是在浪费时间。”"},{"op":"image","layer":1,"image":"i15563"},{"op":"text","speaker":"羽未","text":"“呜哇……真是乐观得令人畏惧……”"},{"op":"return"},{"op":"end"}]