[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"if","truth":false,"target":5,"value":["==",["v",6003],1]},{"op":"callScene","scene":108,"target":2},{"op":"goto","target":49},{"op":"if","truth":false,"target":8,"value":["==",["v",6003],2]},{"op":"callScene","scene":107,"target":2},{"op":"goto","target":49},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11584"},{"op":"image","layer":257,"image":"i15375"},{"op":"text","speaker":"镜子","text":"“我吃饱了。”"},{"op":"text","speaker":"羽依里","text":"“我饱了，羽未。”"},{"op":"text","speaker":"羽依里","text":"“今天早上的炒饭也很好吃。”"},{"op":"image","layer":257,"image":"i15401"},{"op":"text","speaker":"羽未","text":"“多有怠慢。”"},{"op":"text","speaker":"羽依里","text":"“镜子阿姨，仓库那边需要帮忙整理吗？”"},{"op":"image","layer":1,"image":"i11599"},{"op":"text","speaker":"镜子","text":"“今天还不用帮忙吧。”"},{"op":"text","speaker":"羽依里","text":"“知道了。”"},{"op":"text","speaker":"羽依里","text":"“那我稍微出去一下。”"},{"op":"image","layer":1,"image":"i11581"},{"op":"image","layer":257,"image":"i15353"},{"op":"text","speaker":"羽未","text":"“现在就要出去吗？”"},{"op":"text","speaker":"羽依里","text":"“嗯，要去小卖铺一趟。”"},{"op":"image","layer":1,"image":"i11578"},{"op":"image","layer":257,"image":"i15378"},{"op":"text","speaker":"羽未","text":"“小卖铺……！”"},{"op":"image","layer":257,"image":"i15420"},{"op":"text","speaker":"羽未","text":"“是因为……早饭的量不太够吗？”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"image","layer":257,"image":"i15436"},{"op":"text","speaker":"羽未","text":"“还是说，是不太好吃吗……？”"},{"op":"text","speaker":"羽依里","text":"“啊，不是这样的。”"},{"op":"image","layer":1,"image":"i11614"},{"op":"image","layer":257,"image":"i15418"},{"op":"text","speaker":"羽未","text":"“已经厌倦了我的炒饭对吧！”"},{"op":"text","speaker":"羽依里","text":"“呃……偶尔是会想吃点吐司什么的。”"},{"op":"image","layer":257,"image":"i15389"},{"op":"text","speaker":"羽未","text":"“鹰原哥你去屎吧――！”"},{"op":"image","layer":1,"image":"i11622"},{"op":"text","speaker":"羽依里","text":"“喂，女孩子可不能说这种话。”"},{"op":"image","layer":257,"image":"i15573"},{"op":"text","speaker":"羽未","text":"“因为你……刚吃完早饭就要跑去小卖铺吃吃吃……”"},{"op":"image","layer":257,"image":"i15554"},{"op":"text","speaker":"羽未","text":"“这是对炒饭的亵渎。”"},{"op":"text","speaker":"羽依里","text":"“啊，误会误会，我不是去吃零食。”"},{"op":"text","speaker":"羽依里","text":"“是去和朋友谈点事情。”"},{"op":"image","layer":1,"image":"i11566"},{"op":"text","speaker":"镜子","text":"“朋友，是指小卖铺的婆婆吗？”"},{"op":"image","layer":1,"image":"i11622"},{"op":"text","speaker":"镜子","text":"“羽依里竟然意外地……”"},{"op":"text","speaker":"羽依里","text":"“等等，什么意外了……？别乱想啊。”"},{"op":"text","speaker":"羽依里","text":"“是岛上认识的朋友，现在在那里打工。”"},{"op":"image","layer":1,"image":"i11632"},{"op":"text","speaker":"镜子","text":"“打工……？”"},{"op":"image","layer":1,"image":"i11581"},{"op":"image","layer":257,"image":"i15366"},{"op":"text","speaker":"镜子","text":"“是空门家的小苍对吧。”"},{"op":"image","layer":1,"image":"i11574"},{"op":"text","speaker":"镜子","text":"“明明到这座岛才差不多两周……”"},{"op":"image","layer":1,"image":"i11559"},{"op":"text","speaker":"镜子","text":"“意外地有一手啊。”"},{"op":"text","speaker":"羽依里","text":"“请不要一脸坏笑。”"},{"op":"image","layer":257,"image":"i15417"},{"op":"text","speaker":"羽依里","text":"“这样对羽未的教育不好……”"},{"op":"text","speaker":"羽依里","text":"“她……只不过是朋友而已。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"到了小卖铺后，发现苍正在店门口打扫。"},{"op":"image","layer":1,"image":"i10252"},{"op":"text","speaker":"苍","text":"“呼哇啊啊啊啊啊……哈呼。”"},{"op":"text","speaker":"","text":"一边打着大大的哈欠，一边用扫帚清扫地面。"},{"op":"text","speaker":"羽依里","text":"“还不至于这个时间就要睡觉吧。”"},{"op":"image","layer":1,"image":"i10243"},{"op":"text","speaker":"苍","text":"“嗯……？”"},{"op":"text","speaker":"","text":"上前搭话后，她毫无戒备地转了过来。"},{"op":"image","layer":1,"image":"i10135"},{"op":"text","speaker":"苍","text":"“啊……嗯嘎咕……”"},{"op":"image","layer":1,"image":"i10305"},{"op":"text","speaker":"苍","text":"“早，早桑好！”"},{"op":"text","speaker":"羽依里","text":"“……早。”"},{"op":"text","speaker":"","text":"虽然她急忙装出一切正常的样子，但可惜还是没能蒙混过去。"},{"op":"text","speaker":"羽依里","text":"“呃……”"},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"text","speaker":"羽依里","text":"“……昨天晚上，我看到了……”"},{"op":"image","layer":1,"image":"i10298"},{"op":"text","speaker":"苍","text":"“啊～……晚上？看到什么了？”"},{"op":"text","speaker":"羽依里","text":"“你提着个提灯一样的东西，在山里到处跑。”"},{"op":"image","layer":1,"image":"i10290"},{"op":"text","speaker":"苍","text":"“山里……？”"},{"op":"text","speaker":"羽依里","text":"“穿着一身像是巫女的衣服。”"},{"op":"text","speaker":"羽依里","text":"“莫非就是你之前说的那种，在山里提着灯漫步来着？”"},{"op":"text","speaker":"羽依里","text":"“那就是所谓的山祭吗？”"},{"op":"image","layer":1,"image":"i10186"},{"op":"text","speaker":"苍","text":"“你在说什么？”"},{"op":"text","speaker":"羽依里","text":"“……你不知道我在说什么吗……”"},{"op":"image","layer":1,"image":"i10160"},{"op":"text","speaker":"苍","text":"“我今天一大早就要打工，所以昨晚很早就睡了的。”"},{"op":"text","speaker":"羽依里","text":"“不，但是……”"},{"op":"image","layer":1,"image":"i10267"},{"op":"text","speaker":"苍","text":"“你不会是在做梦吧？”"},{"op":"text","speaker":"羽依里","text":"“做梦？”"},{"op":"text","speaker":"","text":"明明看的那么清楚……？"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":1795,"image":"i18201"},{"op":"image","layer":0,"image":"i1143"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"轻飘飘发着光的蝴蝶――……"},{"op":"text","speaker":"","text":"的确，那副光景非常梦幻……"},{"op":"text","speaker":"","text":"这么说，那莫非……真的是一场梦…？"},{"op":"clear","layer":1795},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i10267"},{"op":"text","speaker":"羽依里","text":"“是吗……那可能，真的是梦吧……”"},{"op":"text","speaker":"羽依里","text":"“毕竟，我看到的苍……”"},{"op":"image","layer":1,"image":"i10203"},{"op":"text","speaker":"苍","text":"“嗯？我怎么了……？”"},{"op":"choice","variable":6001,"items":[{"text":"是那么的漂亮","value":0,"condition":1},{"text":"是那么的可怕","value":1,"condition":1}]},{"op":"if","truth":false,"target":154,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“是那么的漂亮。”"},{"op":"image","layer":1,"image":"i10227"},{"op":"text","speaker":"苍","text":"“……唉。”"},{"op":"text","speaker":"羽依里","text":"“怎么说呢……有种非常神圣的感觉。”"},{"op":"image","layer":1,"image":"i10258"},{"op":"text","speaker":"苍","text":"“神圣……！”"},{"op":"text","speaker":"羽依里","text":"“就像是一位女神。”"},{"op":"image","layer":1,"image":"i10261"},{"op":"text","speaker":"苍","text":"“女神!!”"},{"op":"image","layer":1,"image":"i10162"},{"op":"text","speaker":"苍","text":"“就……就算你这么说，我，我也一点都不开心……”"},{"op":"text","speaker":"羽依里","text":"“果然是苍嘛。”"},{"op":"image","layer":1,"image":"i10316"},{"op":"text","speaker":"苍","text":"“……我大概会这么说吧。”"},{"op":"image","layer":1,"image":"i10336"},{"op":"text","speaker":"苍","text":"“如果真是我的话。”"},{"op":"goto","target":172},{"op":"text","speaker":"羽依里","text":"“是那么的可怕……”"},{"op":"image","layer":1,"image":"i10218"},{"op":"text","speaker":"苍","text":"“嗯啊!؟”"},{"op":"text","speaker":"羽依里","text":"“三更半夜在山里提着提灯，跟恐怖片似的。”"},{"op":"text","speaker":"羽依里","text":"“那种事要是真的就太吓人了。”"},{"op":"image","layer":1,"image":"i10163"},{"op":"text","speaker":"苍","text":"“喂…这么说我太没礼貌了吧!؟”"},{"op":"image","layer":1,"image":"i10166"},{"op":"text","speaker":"苍","text":"“我也是因为自己的职责才那么努力的！”"},{"op":"image","layer":1,"image":"i10122"},{"op":"text","speaker":"苍","text":"“恐怖片什么的，对女生说这种话也太没礼貌了吧――！”"},{"op":"image","layer":1,"image":"i10125"},{"op":"text","speaker":"苍","text":"“而且，那不是叫提灯而是灯笼！笨蛋笨蛋！”"},{"op":"text","speaker":"羽依里","text":"“果然是你嘛。”"},{"op":"image","layer":1,"image":"i10316"},{"op":"text","speaker":"苍","text":"“……我大概会这么说。”"},{"op":"image","layer":1,"image":"i10336"},{"op":"text","speaker":"苍","text":"“如果真是我的话。”"},{"op":"text","speaker":"羽依里","text":"“苍……你啊……”"},{"op":"image","layer":1,"image":"i10162"},{"op":"text","speaker":"苍","text":"“怎，怎么？”"},{"op":"text","speaker":"羽依里","text":"“说谎的时候就不能装得再像一点吗？”"},{"op":"text","speaker":"羽依里","text":"“就算想装作给你骗到也难啊。”"},{"op":"image","layer":1,"image":"i10208"},{"op":"text","speaker":"苍","text":"“才，才不是骗你的呢！真的！千真万确是真的！”"},{"op":"text","speaker":"羽依里","text":"“找的借口也很蹩脚，真是的……”"},{"op":"image","layer":1,"image":"i10305"},{"op":"text","speaker":"苍","text":"“总之，我才没有在深夜里提着灯笼在山里漫步收集蝴蝶什么的呢。”"},{"op":"text","speaker":"羽依里","text":"“……那什么，我都还没提到蝴蝶……”"},{"op":"image","layer":1,"image":"i10298"},{"op":"text","speaker":"苍","text":"“啊，啊啊，你的脸在这么说！”"},{"op":"text","speaker":"羽依里","text":"“我的脸还真厉害……”"},{"op":"image","layer":1,"image":"i10370"},{"op":"text","speaker":"苍","text":"“呜～～……呼哇……”"},{"op":"text","speaker":"羽依里","text":"“你的哈欠还真是会挑时间……”"},{"op":"text","speaker":"羽依里","text":"“虽然不算晚上出去玩，不过这下睡眠不足的理由就很清楚了。”"},{"op":"image","layer":1,"image":"i10252"},{"op":"text","speaker":"苍","text":"“那是…呼啊…，是你看…错……了呼哇啊啊啊啊……啊呼。”"},{"op":"text","speaker":"羽依里","text":"“你看上去很困啊。”"},{"op":"image","layer":1,"image":"i10254"},{"op":"text","speaker":"苍","text":"“……超级困的……要没电了……”"},{"op":"text","speaker":"羽依里","text":"“唔，真那么困的话……”"},{"op":"choice","variable":6001,"items":[{"text":"要不要躺到我的腿上？","value":0,"condition":1},{"text":"要不要靠在我的肩上？","value":1,"condition":1}]},{"op":"if","truth":false,"target":220,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“要不，在我腿上睡一会儿？”"},{"op":"image","layer":1,"image":"i10308"},{"op":"text","speaker":"苍","text":"“嗯……那……就稍微拜托你一下了。”"},{"op":"text","speaker":"羽依里","text":"“……哎？”"},{"op":"image","layer":0,"image":"i196"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i10309"},{"op":"text","speaker":"","text":"苍当即丢下扫帚，摇摇晃晃向我走来。"},{"op":"text","speaker":"羽依里","text":"“喂、喂……来真的啊？”"},{"op":"text","speaker":"","text":"我还以为她错听成什么奇怪的东西，开始妄想然后慌乱不已。"},{"op":"text","speaker":"","text":"随着苍逐步靠近，我不禁地开始后退，直到膝盖内侧撞到了身后的长椅。"},{"op":"text","speaker":"羽依里","text":"“呃……!؟”"},{"op":"text","speaker":"","text":"仿佛被人从身后踢了膝盖一脚，一下子就坐到了椅子上。"},{"op":"image","layer":1,"image":"i10312"},{"op":"text","speaker":"","text":"马上就要没电的苍没有放过这个机会，立刻将身体靠了过来。"},{"op":"text","speaker":"羽依里","text":"“要，要被侵犯了!؟”"},{"op":"text","speaker":"","text":"没什么特别的反应，苍一声不吭的横躺在了长椅上……"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"goto","target":257},{"op":"text","speaker":"羽依里","text":"“要不，靠我肩上睡一会儿？”"},{"op":"image","layer":1,"image":"i10308"},{"op":"text","speaker":"苍","text":"“嗯……那……就稍微拜托你一下了。”"},{"op":"text","speaker":"羽依里","text":"“……哎？”"},{"op":"image","layer":0,"image":"i196"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i10309"},{"op":"text","speaker":"","text":"苍当即丢下扫帚，摇摇晃晃向我走来。"},{"op":"text","speaker":"羽依里","text":"“喂、喂……来真的啊？”"},{"op":"image","layer":515,"image":"i18121"},{"op":"image","layer":1,"image":"i10139"},{"op":"text","speaker":"苍","text":" “怎么可能啊――――！” "},{"op":"clear","layer":515},{"op":"clear","layer":768},{"op":"clear","layer":1024},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i10165"},{"op":"text","speaker":"苍","text":"“一下子就靠在你肩头上是什么意思！一下子就快进到事后吗！”"},{"op":"image","layer":1,"image":"i10205"},{"op":"text","speaker":"苍","text":"“稍微按照点顺序，一步一步来啊――――！”"},{"op":"text","speaker":"羽依里","text":"“唉？一步一步来的话靠我肩膀上就OK吗？”"},{"op":"image","layer":1,"image":"i10267"},{"op":"text","speaker":"苍","text":"“要是好好按步骤来的话……嗯，也不是不行？”"},{"op":"text","speaker":"羽依里","text":"“是……是这样的吗……”"},{"op":"text","speaker":"","text":"她能这么说，看来在某种程度上还是信任我的。"},{"op":"image","layer":1,"image":"i10168"},{"op":"text","speaker":"苍","text":"“呼哇……呼哇啊～～～……”"},{"op":"image","layer":1,"image":"i10379"},{"op":"text","speaker":"苍","text":"“不好……这次是……真要睡着了……”"},{"op":"text","speaker":"羽依里","text":"“那，要睡腿上吗？”"},{"op":"text","speaker":"","text":"我坐到长椅上，砰砰拍了两下自己的大腿。"},{"op":"image","layer":1,"image":"i10376"},{"op":"text","speaker":"苍","text":"“现在……就用这个将就一下好了……”"},{"op":"text","speaker":"","text":"苍也没什么特别的反应，躺倒在了长椅上……"},{"op":"text","speaker":"","text":"就这么枕着我的腿，立刻就睡着了。"},{"op":"image","layer":7,"image":"i10150"},{"op":"text","speaker":"苍","text":"“……嘶……嘶……”"},{"op":"text","speaker":"羽依里","text":"“……真的假的。”"},{"op":"image","layer":1,"image":"i10670"},{"op":"text","speaker":"稻荷","text":"“嘭。”"},{"op":"text","speaker":"羽依里","text":"“啊，稻荷。”"},{"op":"text","speaker":"","text":"稻荷不知从哪儿冒了出来。"},{"op":"text","speaker":"","text":"只见稻荷一路小跑过来，在我的脚边团起身子开始睡觉。"},{"op":"text","speaker":"稻荷","text":"“……咕……咕……”"},{"op":"text","speaker":"羽依里","text":"“……这算什么……”"},{"op":"text","speaker":"","text":"没想到真会睡在我腿上。"},{"op":"text","speaker":"","text":"而且，还是在店门口。"},{"op":"image","layer":7,"image":"i10150"},{"op":"text","speaker":"苍","text":"“……嘶……嘶……”"},{"op":"text","speaker":"","text":"虽然也想过把她叫醒，可看她睡得那么香，却又于心不忍。"},{"op":"text","speaker":"羽依里","text":"“……你这也太赖皮了。”"},{"op":"text","speaker":"羽依里","text":"“醒来时总是那么急躁，就只有睡着了才那么乖……”"},{"op":"text","speaker":"","text":"看来在苍醒来前，都只能维持这个状态了。"},{"op":"text","speaker":"羽依里","text":"“不过，这样子要是被别人看到的话……”"},{"op":"image","layer":1,"image":"i12165"},{"op":"text","speaker":"良一","text":"“打～扰～了。”"},{"op":"image","layer":257,"image":"i15197"},{"op":"text","speaker":"天善","text":"“唔……”"},{"op":"text","speaker":"羽依里","text":"“啊……”"},{"op":"image","layer":257,"image":"i15199"},{"op":"image","layer":1,"image":"i12171"},{"op":"text","speaker":"良一","text":"“………”"},{"op":"text","speaker":"天善","text":"“………”"},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"text","speaker":"羽依里","text":"“不……不是……这不是你们想的那样。”"},{"op":"text","speaker":"羽依里","text":"“至少……至少让我说明下情况。”"},{"op":"image","layer":1,"image":"i12147"},{"op":"text","speaker":"良一","text":"“……走了，天善。”"},{"op":"image","layer":257,"image":"i15196"},{"op":"text","speaker":"天善","text":"“不买美味棒了吗？”"},{"op":"image","layer":1,"image":"i12171"},{"op":"text","speaker":"良一","text":"“这种时候，视而不见才是男人间的友情啊。”"},{"op":"text","speaker":"羽依里","text":"“不需要。不用当作没看见，听我解释――”"},{"op":"image","layer":1,"image":"i12153"},{"op":"text","speaker":"良一","text":"“勿视，勿闻，勿问！”"},{"op":"image","layer":257,"image":"i15194"},{"op":"text","speaker":"天善","text":"“……！”"},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“……拜了，兄弟。祝你幸福。”"},{"op":"text","speaker":"羽依里","text":"“喂，等等……!؟”"},{"op":"image","layer":1,"image":"i12153"},{"op":"text","speaker":"良一","text":"“快跑！”"},{"op":"image","layer":257,"image":"i15195"},{"op":"text","speaker":"天善","text":"“看球――――！”"},{"op":"text","speaker":"","text":"真的闭上眼睛捂住耳朵跑掉了。"},{"op":"text","speaker":"羽依里","text":"“喂，站住，你们两个！”"},{"op":"text","speaker":"羽依里","text":"“至少睁开眼睛不然很危险――”"},{"op":"image","layer":7,"image":"i12167"},{"op":"text","speaker":"良一","text":" “哇啊啊咕啊！” "},{"op":"text","speaker":"羽依里","text":"“啊，良一摔了！”"},{"op":"image","layer":7,"image":"i12167"},{"op":"text","speaker":"良一","text":" “唔哦啪！” "},{"op":"text","speaker":"羽依里","text":"“呜哇，被天善直接踩上了！”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i513"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"……时间缓缓流逝。"},{"op":"text","speaker":"","text":"略带潮湿的海风，此时也显得异常舒适。"},{"op":"text","speaker":"","text":"被城市里无法感受到的绿意环抱，聆听树木的细语。"},{"op":"text","speaker":"","text":"五感在尽情享受岛上自然的同时，我的意识也集中到了一点。"},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……好想去厕所。”"},{"op":"image","layer":7,"image":"i10150"},{"op":"text","speaker":"苍","text":"“……嘶……嘶……”"},{"op":"text","speaker":"","text":"但在我腿上睡得正香的苍，完全没有要醒过来的迹象。"},{"op":"text","speaker":"羽依里","text":"“……怎么办呢。”"},{"op":"image","layer":7,"image":"i10300"},{"op":"text","speaker":"苍","text":"“嗯……嗯嗯……”"},{"op":"text","speaker":"","text":"终于要醒了吗？"},{"op":"image","layer":7,"image":"i10310"},{"op":"text","speaker":"苍","text":"“嗯……羽依里……”"},{"op":"text","speaker":"羽依里","text":"“唉？我？”"},{"op":"image","layer":7,"image":"i10300"},{"op":"text","speaker":"苍","text":"“……变大了……”"},{"op":"text","speaker":"","text":"什么？是梦到我了吗……？什么变大了……？"},{"op":"text","speaker":"","text":"开始有点心跳了！"},{"op":"image","layer":7,"image":"i10126"},{"op":"text","speaker":"苍","text":"“羽依里…羽依里…加油……”"},{"op":"text","speaker":"","text":"应援……？"},{"op":"image","layer":7,"image":"i10300"},{"op":"text","speaker":"苍","text":"“羽依……雨衣……”"},{"op":"text","speaker":"","text":"羽依？雨衣？干嘛？"},{"op":"image","layer":7,"image":"i10294"},{"op":"text","speaker":"苍","text":"“呵呵～……”"},{"op":"text","speaker":"","text":"感慨؟!"},{"op":"image","layer":7,"image":"i10150"},{"op":"text","speaker":"苍","text":"“快点……变大～……”"},{"op":"text","speaker":"羽依里","text":"“什么啊!؟”"},{"op":"image","layer":1,"image":"i10176"},{"op":"text","speaker":"苍","text":"“哈……!؟”"},{"op":"text","speaker":"","text":"苍醒了过来。"},{"op":"image","layer":1,"image":"i10270"},{"op":"text","speaker":"苍","text":"“我，我刚才……说了什么……？”"},{"op":"text","speaker":"羽依里","text":"“好像是在唱歌。”"},{"op":"text","speaker":"羽依里","text":"“你做的什么梦？”"},{"op":"image","layer":1,"image":"i10171"},{"op":"text","speaker":"苍","text":"“与其说是做梦……不如说是和奇怪的记忆混线了。”"},{"op":"text","speaker":"羽依里","text":"“记忆……？”"},{"op":"image","layer":1,"image":"i10158"},{"op":"text","speaker":"苍","text":"“啊，不，没什么！”"},{"op":"text","speaker":"羽依里","text":"“话说，既然醒了就快起来吧？”"},{"op":"text","speaker":"羽依里","text":"“再这样下去，我的大坝就会决堤，强行跟你玩很硬核的游戏……”"},{"op":"image","layer":1,"image":"i10213"},{"op":"text","speaker":"苍","text":"“……？说话别那么绕，就不能说的简单直白一点吗？”"},{"op":"text","speaker":"羽依里","text":" “我快尿出来了――――！” "},{"op":"image","layer":1,"image":"i10138"},{"op":"text","speaker":"苍","text":"“这玩法还太早了！”"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"text","speaker":"","text":"上完厕所后，我回到了长椅边上。"},{"op":"image","layer":1,"image":"i10252"},{"op":"text","speaker":"苍","text":"“呼哇啊啊啊……啊呼。”"},{"op":"text","speaker":"","text":"苍还有点没睡够的样子。"},{"op":"text","speaker":"羽依里","text":"“再睡一会儿？”"},{"op":"image","layer":1,"image":"i10184"},{"op":"text","speaker":"苍","text":"“嗯……没事了。”"},{"op":"image","layer":1,"image":"i10182"},{"op":"text","speaker":"苍","text":"“已经轻松不少了。”"},{"op":"text","speaker":"羽依里","text":"“……因为整晚都在外面走，才会变成这样的。”"},{"op":"image","layer":1,"image":"i10160"},{"op":"text","speaker":"苍","text":"“才不是整晚。我已经在尽量不搞到那么晚了。”"},{"op":"text","speaker":"羽依里","text":"“不过，在山里那样走来走去是会累的吧？”"},{"op":"image","layer":1,"image":"i10235"},{"op":"text","speaker":"苍","text":"“早习惯了没关系的。”"},{"op":"text","speaker":"羽依里","text":"“昨天晚上山里的果然是你嘛。”"},{"op":"image","layer":1,"image":"i10407"},{"op":"text","speaker":"苍","text":"“……以上说的是我做的梦。”"},{"op":"text","speaker":"羽依里","text":"“那什么，你说谎的时候多动一下脑子行吗……”"},{"op":"image","layer":1,"image":"i10301"},{"op":"text","speaker":"苍","text":"“唔，呜呜～……”"},{"op":"image","layer":1,"image":"i10290"},{"op":"text","speaker":"苍","text":"“哈啊……唉，算了。”"},{"op":"image","layer":1,"image":"i10210"},{"op":"text","speaker":"苍","text":"“反正就算要糊弄你，也只会让你更感兴趣。”"},{"op":"text","speaker":"羽依里","text":"“说到底就没糊弄过去。”"},{"op":"image","layer":1,"image":"i10208"},{"op":"text","speaker":"苍","text":"“烦死了！”"},{"op":"image","layer":1,"image":"i10184"},{"op":"text","speaker":"苍","text":"“……之前也和你说过，山祭并不是什么祭典。”"},{"op":"image","layer":1,"image":"i10182"},{"op":"text","speaker":"苍","text":"“那只是这座岛上的一种风俗。”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"苍","text":"“和岛外的人没有半点关系。”"},{"op":"text","speaker":"苍","text":"“所以……你也别太好奇了。”"},{"op":"image","layer":1,"image":"i10162"},{"op":"text","speaker":"苍","text":"“不如说，不可以好奇。”"},{"op":"text","speaker":"羽依里","text":"“就算你这么说……”"},{"op":"image","layer":1,"image":"i10249"},{"op":"text","speaker":"苍","text":"“怎么，都说到这份上了还不能接受吗？”"},{"op":"text","speaker":"羽依里","text":"“怎么说呢，我也知道这是岛上的风俗与我无关。”"},{"op":"text","speaker":"羽依里","text":"“但是，女孩子晚上独自在山里徘徊果然还是会让人担心的啊。”"},{"op":"image","layer":1,"image":"i10258"},{"op":"text","speaker":"苍","text":"“～～～……”"},{"op":"image","layer":1,"image":"i10171"},{"op":"text","speaker":"苍","text":"“但，但我不会有事的啦。”"},{"op":"image","layer":1,"image":"i10158"},{"op":"text","speaker":"苍","text":"“即便真遇到什么，也有稻荷在。”"},{"op":"image","layer":1,"image":"i10322"},{"op":"text","speaker":"苍","text":"“对吧，稻荷？”"},{"op":"image","layer":257,"image":"i10669"},{"op":"text","speaker":"稻荷","text":"“嘭！”"},{"op":"text","speaker":"羽依里","text":"“我担心苍是有道理的吧，稻荷？”"},{"op":"image","layer":257,"image":"i10672"},{"op":"text","speaker":"稻荷","text":"“嘭！”"},{"op":"image","layer":1,"image":"i10218"},{"op":"text","speaker":"苍","text":"“叛徒！”"},{"op":"text","speaker":"羽依里","text":"“唔。那，你看这样如何？”"},{"op":"choice","variable":6001,"items":[{"text":"悄悄跟你后面","value":0,"condition":1},{"text":"一起山中漫步","value":1,"condition":1}]},{"op":"if","truth":false,"target":468,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“下次，我悄悄跟你后面好了。”"},{"op":"image","layer":1,"image":"i10162"},{"op":"text","speaker":"苍","text":"“悄悄……现在都说明了还怎么悄悄。”"},{"op":"text","speaker":"羽依里","text":"“现在告诉你了的话，你也会时常注意自己身后了吧？”"},{"op":"text","speaker":"羽依里","text":"“现在在身后？还是不在身后？”"},{"op":"text","speaker":"羽依里","text":"“感觉好讨厌，可怕，好可怕啊。”"},{"op":"image","layer":1,"image":"i10316"},{"op":"text","speaker":"苍","text":"“感觉成了鬼故事的主角……”"},{"op":"text","speaker":"羽依里","text":"“当你在山里走着的时候，就会一直在意着我的存在。”"},{"op":"text","speaker":"羽依里","text":"“然后，开始对每一个声响都变得敏感，渐渐变得疑神疑鬼……”"},{"op":"text","speaker":"羽依里","text":"“终于，你因恐惧而瘫倒在了地上。”"},{"op":"image","layer":1,"image":"i10298"},{"op":"text","speaker":"苍","text":"“你，你想对无法动弹的我……做什么!؟”"},{"op":"text","speaker":"羽依里","text":"“观察。”"},{"op":"image","layer":1,"image":"i10301"},{"op":"text","speaker":"苍","text":"“……唉？”"},{"op":"image","layer":1,"image":"i10290"},{"op":"text","speaker":"羽依里","text":"“潜伏在你周围，一直观察你。”"},{"op":"text","speaker":"羽依里","text":"“既不现身也不搭话，只是在暗中一直观察着你。”"},{"op":"image","layer":1,"image":"i10171"},{"op":"text","speaker":"苍","text":"“你这做法也太阴险了……”"},{"op":"image","layer":1,"image":"i10249"},{"op":"text","speaker":"苍","text":"“这就是那个吧，城市里流行的跟踪狂！”"},{"op":"text","speaker":"羽依里","text":"“并没有流行就是了。”"},{"op":"set","variable":94,"value":1},{"op":"image","layer":1,"image":"i10184"},{"op":"goto","target":490},{"op":"set","variable":26027,"value":1},{"op":"text","speaker":"羽依里","text":"“下次开始，我和你一起上山。”"},{"op":"image","layer":1,"image":"i10246"},{"op":"text","speaker":"苍","text":"“哈啊!؟”"},{"op":"text","speaker":"羽依里","text":"“那样就不用担心了。”"},{"op":"text","speaker":"羽依里","text":"“稻荷也觉得这是个好主意吧？”"},{"op":"image","layer":257,"image":"i10669"},{"op":"text","speaker":"稻荷","text":"“嘭！”"},{"op":"image","layer":1,"image":"i10124"},{"op":"text","speaker":"苍","text":"“你对着狐狸说什么呢！”"},{"op":"image","layer":1,"image":"i10205"},{"op":"text","speaker":"苍","text":"“给我听好了？山祭是我家的职责。”"},{"op":"image","layer":1,"image":"i10288"},{"op":"text","speaker":"苍","text":"“你不要这样纯粹出于兴趣就掺合进来！”"},{"op":"text","speaker":"羽依里","text":"“与其说是出于兴趣，不如说只是单纯担心你而已。”"},{"op":"image","layer":1,"image":"i10308"},{"op":"text","speaker":"苍","text":"“呜呜～……你这么说的话，我反而不知道该怎么反应了……”"},{"op":"image","layer":1,"image":"i10205"},{"op":"text","speaker":"苍","text":"“不过，我没事的啦！”"},{"op":"image","layer":1,"image":"i10235"},{"op":"text","speaker":"苍","text":"“你的好意我心领了。”"},{"op":"image","layer":1,"image":"i10184"},{"op":"text","speaker":"苍","text":"“总之，你晚上别接近那座山。”"},{"op":"text","speaker":"羽依里","text":"“为什么啊？只是接近没什么问题吧？”"},{"op":"image","layer":1,"image":"i10165"},{"op":"text","speaker":"苍","text":"“跟你说了不行的！”"},{"op":"image","layer":1,"image":"i10210"},{"op":"text","speaker":"苍","text":"“这座岛的……那个，就是那什么……巨贵！”"},{"op":"text","speaker":"羽依里","text":"“还卖东西的？”"},{"op":"image","layer":1,"image":"i10258"},{"op":"text","speaker":"苍","text":"“说错了，是规矩！对，就是规矩！”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"苍","text":"“在祭祀期间，岛上的人晚上是不允许接近山的。”"},{"op":"image","layer":1,"image":"i10182"},{"op":"text","speaker":"苍","text":"“所以你也得好好遵守。知道了吗？”"},{"op":"text","speaker":"羽依里","text":"“我又不是岛上的人。”"},{"op":"image","layer":1,"image":"i10320"},{"op":"text","speaker":"苍","text":" “给·我·好·好·遵·守。” "},{"op":"text","speaker":"羽依里","text":"“……好。”"},{"op":"text","speaker":"","text":"再扯下去的话估计真要生气了，还是就此打住吧。"},{"op":"text","speaker":"岛上的男孩A","text":"“打～扰～了！”"},{"op":"image","layer":1,"image":"i10115"},{"op":"text","speaker":"苍","text":"“哎呀……你们来了。”"},{"op":"text","speaker":"岛上的男孩A","text":"“师父！再来帮忙鉴定下吧！”"},{"op":"text","speaker":"岛上的男孩B","text":"“我们发现了超厉害的宝贝！”"},{"op":"text","speaker":"岛上的男孩C","text":"“今天的绝对会很值钱！”"},{"op":"image","layer":1,"image":"i10112"},{"op":"text","speaker":"苍","text":"“好啊。拿给我看看吧。”"},{"op":"text","speaker":"","text":"开始和跑来的小鬼们玩鉴定游戏了。"},{"op":"text","speaker":"岛上的男孩A","text":"“怎么样师父！这个值不少钱吧？”"},{"op":"image","layer":1,"image":"i10272"},{"op":"text","speaker":"苍","text":"“嗯……30日元吧。”"},{"op":"text","speaker":"岛上的男孩A","text":"“呜哇！还是不行啊！”"},{"op":"image","layer":1,"image":"i10182"},{"op":"text","speaker":"苍","text":"“还不够哦，这种程度的还远远算不上是宝贝。”"},{"op":"image","layer":1,"image":"i10194"},{"op":"text","speaker":"苍","text":"“继续加油吧。”"},{"op":"text","speaker":"孩子们","text":"“好的！”"},{"op":"image","layer":1,"image":"i10238"},{"op":"text","speaker":"苍","text":"“呵呵……”"},{"op":"image","layer":0,"image":"i196"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":1,"image":"i10240"},{"op":"text","speaker":"","text":"面对着小鬼们，苍看起来笑得很开心。"},{"op":"text","speaker":"","text":"看着这样的她，感觉她刚才的那份寂寞渐渐被换成了别的感情。"},{"op":"text","speaker":"","text":"看着苍那表里如一的笑容，不知何时自己脸上也挂起了笑容。"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"（我也真够单纯的……）"},{"op":"text","speaker":"岛上的男孩A","text":"“我说，大哥哥。”"},{"op":"text","speaker":"羽依里","text":"“嗯？怎么了？”"},{"op":"text","speaker":"岛上的男孩A","text":"“再来玩鉴宝比赛吧！”"},{"op":"text","speaker":"羽依里","text":"“哦……”"},{"op":"text","speaker":"岛上的男孩B","text":"“输了的人请吃冰淇淋！”"},{"op":"text","speaker":"羽依里","text":"“……嗯，好啊。这挑战我接下了！”"},{"op":"text","speaker":"岛上的男孩C","text":"“耶――！”"},{"op":"text","speaker":"羽依里","text":"“一会儿别后悔挑战我，你们这些小毛头！”"},{"op":"text","speaker":"羽依里","text":"“看我怎么反杀你们！”"},{"op":"text","speaker":"羽依里","text":"“哇哈哈哈哈！”"},{"op":"text","speaker":"岛上的男孩A","text":"“小毛头是什么意思？”"},{"op":"text","speaker":"岛上的男孩B","text":"“大哥哥，都说了别说那么难懂的话。”"},{"op":"text","speaker":"岛上的男孩C","text":"“我们可还是小孩啊。”"},{"op":"text","speaker":"羽依里","text":"“……抱歉。”"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]