[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我来到了小卖铺。"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“来了啊，有什么想要的？”"},{"op":"text","speaker":"羽依里","text":"“这个嘛……”"},{"op":"choice","variable":6001,"items":[{"text":"想玩扭蛋","value":0,"condition":1},{"text":"传授秘技","value":1,"condition":1}]},{"op":"if","truth":false,"target":40,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“我想玩那边的扭蛋。”"},{"op":"text","speaker":"","text":"我做了个帅气的动作，掏出个100日元硬币。"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“能抽到好东西就好了。”"},{"op":"text","speaker":"羽依里","text":"“请为我祈祷吧。”"},{"op":"text","speaker":"","text":"我用手指将硬币弹到空中，让其翻转。"},{"op":"text","speaker":"羽依里","text":"“啊……”"},{"op":"text","speaker":"","text":"没接到。"},{"op":"text","speaker":"","text":"100日元硬币就这样滚到了自动售货机下面不见了。"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“不去捡吗？”"},{"op":"text","speaker":"羽依里","text":"“要去捡。”"},{"op":"text","speaker":"","text":"我趴在地上，把手伸进自动售货机下面。"},{"op":"text","speaker":"羽依里","text":"“是这边吗……不对，是那边……咦？这个有点像……嗯？”"},{"op":"text","speaker":"","text":"我把手伸出来，发现硬币多了一枚。"},{"op":"text","speaker":"","text":"真是走运。"},{"op":"text","speaker":"羽依里","text":"“那么，我开始了……”"},{"op":"text","speaker":"","text":"将100日元投入扭蛋机，然后转动拉杆。"},{"op":"text","speaker":"","text":"咔擦咔擦……"},{"op":"text","speaker":"羽依里","text":"“这是……！”"},{"op":"text","speaker":"羽依里","text":"“……迷你水桶……？”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“这是史莱米啊。”"},{"op":"text","speaker":"羽依里","text":"“史莱米？”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“打开，放手上试试。”"},{"op":"text","speaker":"羽依里","text":"“呜哇！这黏糊糊冷冰冰的粘液是什么玩意啊！”"},{"op":"text","speaker":"羽依里","text":"“咦？但是不会粘到手上!؟这到底是什么啊؟؟”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“就是史莱米啊。”"},{"op":"text","speaker":"羽依里","text":"“好恶心啊，不过感觉会上瘾！”"},{"op":"text","speaker":"","text":"我把它放手掌上一会儿拉一会儿按。"},{"op":"text","speaker":"","text":"充分享受了这不可思议的触感。"},{"op":"add","variable":6035,"value":1},{"op":"goto","target":64},{"op":"if","truth":false,"target":64,"value":["==",["v",6001],1]},{"op":"text","speaker":"羽依里","text":"“传授给我秘技……”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“唔……你的这个眼神……”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“好吧。”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“我就传授你一招用慢动作看世界的秘技吧。”"},{"op":"text","speaker":"羽依里","text":"“唉!؟能做到这么厉害的事吗؟!”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“试试高速眨眼。”"},{"op":"text","speaker":"羽依里","text":"“这样吗？”"},{"op":"text","speaker":"","text":"我眨我眨……我眨我眨……"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“再快一点。”"},{"op":"text","speaker":"","text":"我眨我眨我眨……我眨我眨我眨……"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“还不够。”"},{"op":"text","speaker":"","text":"我眨眨眨眨……我眨眨眨眨……"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“HurryU――p！”"},{"op":"text","speaker":"","text":"话说，这快的意思是不是不太对！"},{"op":"text","speaker":"","text":"我眨眨眨眨眨眨眨眨眨眨眨眨眨眨眨眨。"},{"op":"text","speaker":"羽依里","text":"“哦……？”"},{"op":"text","speaker":"羽依里","text":"“噢噢噢!؟整，整个世界仿佛……变成了幻灯片一样！”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“那就是与常人所在世界不同的另一个世界的入口。”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“那个世界被称为……瞬界。”"},{"op":"text","speaker":"羽依里","text":"“瞬界……！”"},{"op":"set","variable":365,"value":1},{"op":"set","variable":464,"value":1},{"op":"goto","target":64},{"op":"add","variable":6030,"value":1},{"op":"set","variable":21,"value":1},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"return"},{"op":"end"}]