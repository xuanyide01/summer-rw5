[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"set","variable":7120,"value":1},{"op":"image","layer":0,"image":"i62"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“我们回来了。”"},{"op":"image","layer":1,"image":"i12815"},{"op":"text","speaker":"识","text":"“回来咯。”"},{"op":"image","layer":257,"image":"i15499"},{"op":"text","speaker":"羽未","text":"“欢迎回来～”"},{"op":"image","layer":257,"image":"i15597"},{"op":"text","speaker":"羽未","text":"“哇！好多海螺――！”"},{"op":"image","layer":257,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“怎么回事啊――？”"},{"op":"text","speaker":"","text":"羽未看到我手上的网兜里装满了海螺，一下愣住了。"},{"op":"image","layer":257,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“……偷捕来的？”"},{"op":"text","speaker":"羽依里","text":"“这次不是。”"},{"op":"image","layer":257,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“这次？”"},{"op":"text","speaker":"羽依里","text":"“不，我可从没干过偷捕这种事啊。”"},{"op":"image","layer":257,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“我？”"},{"op":"text","speaker":"羽依里","text":"“不，没什么。”"},{"op":"text","speaker":"","text":"为了维护识的名誉，我还是不说了。"},{"op":"image","layer":1,"image":"i12789"},{"op":"text","speaker":"识","text":"“嗯嘿嘿，是帮忙捕鱼后人家分给我们的。”"},{"op":"image","layer":257,"image":"i15372"},{"op":"text","speaker":"羽依里","text":"“对，是劳动的报酬。”"},{"op":"image","layer":1,"image":"i12743"},{"op":"text","speaker":"识","text":"“我们把海螺的壳擦得干干净净，苔藓也都清理掉了。”"},{"op":"image","layer":1,"image":"i12740"},{"op":"text","speaker":"识","text":"“处理这个还蛮有意思的。”"},{"op":"text","speaker":"羽依里","text":"“还帮忙搬了打捞上来的海螺。”"},{"op":"text","speaker":"羽依里","text":"“不过，海螺实在是太沉了。”"},{"op":"image","layer":257,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“要怎么吃呢？”"},{"op":"image","layer":1,"image":"i12799"},{"op":"text","speaker":"识","text":"“我来美味地调理一下它们。”"},{"op":"image","layer":257,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“太好了，最喜欢姐姐了――”"},{"op":"image","layer":1,"image":"i12794"},{"op":"text","speaker":"识","text":"“嗯嘿嘿。”"},{"op":"image","layer":257,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“那么，这个送给你们――”"},{"op":"text","speaker":"羽依里","text":"“……烟花套装？”"},{"op":"text","speaker":"","text":"她递过来一个装有各种烟花的套装。"},{"op":"text","speaker":"羽依里","text":"“这是哪里来的？”"},{"op":"image","layer":257,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“做广播体操的时候拿到的。”"},{"op":"text","speaker":"羽依里","text":"“这岛上广播体操的奖品都是些什么啊……”"},{"op":"text","speaker":"","text":"也好，算是夏日回忆套装吧。"},{"op":"text","speaker":"羽依里","text":"“那，干脆今晚就去放烟花吧？”"},{"op":"image","layer":257,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“玩得开心――”"},{"op":"text","speaker":"羽依里","text":"“咦？但是我们是想和羽未一起玩的啊？”"},{"op":"image","layer":257,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“我要早点睡觉。”"},{"op":"image","layer":257,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“这是你送给我海螺的回礼――”"},{"op":"text","speaker":"羽依里","text":"“是吗？”"},{"op":"image","layer":1,"image":"i12740"},{"op":"text","speaker":"识","text":"“谢谢你啊，羽未。”"},{"op":"image","layer":257,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“不用谢――”"},{"op":"return"},{"op":"end"}]