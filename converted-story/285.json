[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i84"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11837"},{"op":"text","speaker":"美希","text":"“嗯？”"},{"op":"text","speaker":"羽依里","text":"“哟。”"},{"op":"image","layer":1,"image":"i11755"},{"op":"text","speaker":"美希","text":"“又是你啊。”"},{"op":"image","layer":1,"image":"i11780"},{"op":"text","speaker":"美希","text":"“看你总是在闲逛，很闲吗？”"},{"op":"text","speaker":"羽依里","text":"“好像是呢。”"},{"op":"image","layer":1,"image":"i11758"},{"op":"text","speaker":"美希","text":"“怎么好像事不关己似的。”"},{"op":"text","speaker":"羽依里","text":"“不是，其实我也很想帮镜子阿姨干活。”"},{"op":"text","speaker":"羽依里","text":"“但是好像暂时还轮不到我出场。”"},{"op":"image","layer":1,"image":"i11755"},{"op":"text","speaker":"美希","text":"“所以你才整天无所事事四处闲逛啊。”"},{"op":"image","layer":1,"image":"i11769"},{"op":"text","speaker":"美希","text":"“年轻人的大好时光就这么被浪费了。”"},{"op":"text","speaker":"羽依里","text":"“说得好像事不关己似的，你不是也很年轻吗？”"},{"op":"image","layer":1,"image":"i11750"},{"op":"text","speaker":"美希","text":"“我可是有好好把精力放在正事上。”"},{"op":"text","speaker":"","text":"少年团啊。"},{"op":"text","speaker":"","text":"确实野美希每天都在尽心尽力地维护岛上的治安。"},{"op":"image","layer":1,"image":"i11766"},{"op":"text","speaker":"美希","text":"“唔……”"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"text","speaker":"","text":"野美希直勾勾地盯着我。"},{"op":"text","speaker":"羽依里","text":"“怎、怎么了？”"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“如果你很闲的话，要不要来当我的助手？”"},{"op":"text","speaker":"羽依里","text":"“你的……助手？”"},{"op":"image","layer":1,"image":"i11693"},{"op":"text","speaker":"美希","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“具体要做什么啊？”"},{"op":"image","layer":1,"image":"i11696"},{"op":"text","speaker":"美希","text":"“给你这个射击许可证。”"},{"op":"text","speaker":"羽依里","text":"“啊？”"},{"op":"text","speaker":"","text":"野美希不知从哪里掏出一把手枪大小的水枪，扔给了我。"},{"op":"text","speaker":"羽依里","text":"“Hydro……的小型版？”"},{"op":"image","layer":1,"image":"i11693"},{"op":"text","speaker":"美希","text":"“Hydro Caliber零式。”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"image","layer":1,"image":"i11696"},{"op":"text","speaker":"美希","text":"“被这帅气的名字迷住了吗？”"},{"op":"text","speaker":"羽依里","text":"“啊，嗯……确实挺帅气的。”"},{"op":"image","layer":1,"image":"i11750"},{"op":"text","speaker":"美希","text":"“哼哼，也还好啦。”"},{"op":"text","speaker":"","text":"她看起来很高兴。"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“还有，把这个戴在胳膊上。”"},{"op":"text","speaker":"","text":"接着，她递给我一个袖章。"},{"op":"text","speaker":"","text":"‘少年团治安维持执行部’"},{"op":"text","speaker":"","text":"上面手写着这么几个字。"},{"op":"text","speaker":"羽依里","text":"“这是你亲手做的吗？”"},{"op":"image","layer":1,"image":"i11689"},{"op":"text","speaker":"美希","text":"“嗯，是的。”"},{"op":"text","speaker":"","text":"有点可爱。"},{"op":"text","speaker":"","text":"让我想起了小时候沉迷过家家酒的时光。"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“戴上这个，和我一起来维护岛上的治安吧。”"},{"op":"text","speaker":"羽依里","text":"“不过这上面写着少年团啊？”"},{"op":"text","speaker":"羽依里","text":"“我不是岛民，也可以加入少年团吗？”"},{"op":"image","layer":1,"image":"i11693"},{"op":"text","speaker":"美希","text":"“总比整天漫无目的地闲逛要好吧。”"},{"op":"image","layer":1,"image":"i11712"},{"op":"text","speaker":"美希","text":"“年轻人精力太过旺盛的话可是会惹出麻烦的。”"},{"op":"text","speaker":"","text":"脑海中立刻冒出了两个精力过剩，总是惹是生非的男生。"},{"op":"text","speaker":"羽依里","text":"“原来如此。”"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“怎么样？”"},{"op":"choice","variable":6001,"items":[{"text":"给野美希帮忙","value":0,"condition":1},{"text":"拒绝","value":1,"condition":1}]},{"op":"if","truth":false,"target":89,"value":["==",["v",6001],0]},{"op":"text","speaker":"","text":"确实比起毫无目的地在岛上闲逛，还是给自己找点事干比较好。"},{"op":"text","speaker":"羽依里","text":"“好吧，我来帮忙。”"},{"op":"image","layer":1,"image":"i11689"},{"op":"text","speaker":"美希","text":"“我就知道你会这么说。”"},{"op":"text","speaker":"","text":"野美希向我伸出了手。"},{"op":"text","speaker":"","text":"我紧紧地握住了那只手。"},{"op":"text","speaker":"","text":"小小的，却又很温暖。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i11731"},{"op":"text","speaker":"美希","text":"“怎么了？”"},{"op":"text","speaker":"羽依里","text":"“没什么……因为我上的是男校，不太习惯这样和女生握手……”"},{"op":"image","layer":1,"image":"i11724"},{"op":"text","speaker":"美希","text":"“……”"},{"op":"text","speaker":"","text":"气氛突然变得有些尴尬。"},{"op":"goto","target":104},{"op":"text","speaker":"羽依里","text":"“虽然很感谢你的邀请，但我随时都可能会被叫去整理仓库。”"},{"op":"image","layer":1,"image":"i11712"},{"op":"text","speaker":"美希","text":"“这样啊，确实也不应该耽误原本的正事。”"},{"op":"text","speaker":"羽依里","text":"“抱歉。”"},{"op":"text","speaker":"","text":"我把Hydro Caliber零式和手工袖章还给了野美希。"},{"op":"image","layer":1,"image":"i11721"},{"op":"text","speaker":"美希","text":"“不，我没考虑到你的情况就擅自做主了。”"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“不过，如果你改变想法了，随时都可以告诉我。”"},{"op":"text","speaker":"羽依里","text":"“嗯，到时候就拜托你了。”"},{"op":"image","layer":1,"image":"i11829"},{"op":"text","speaker":"","text":"野美希重新背好Hydro，挥了挥手走掉了。"},{"op":"text","speaker":"","text":"她的心意真的让我很高兴。"},{"op":"set","variable":418,"value":1},{"op":"goto","target":323},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i31"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我把Hydro Caliber零式拿在手上，和野美希一起在岛上巡逻。"},{"op":"image","layer":1,"image":"i11837"},{"op":"text","speaker":"美希","text":"“你走路的动作怎么那么怪啊？”"},{"op":"text","speaker":"羽依里","text":"“我现在有种刚看完间谍电影时的那种心情。”"},{"op":"text","speaker":"羽依里","text":"“而且手上拿着枪，就感觉自己无所不能。”"},{"op":"text","speaker":"","text":"明明只是把水枪，还真是奇妙。"},{"op":"image","layer":1,"image":"i11879"},{"op":"text","speaker":"美希","text":"“可不要乱开枪哦？”"},{"op":"image","layer":1,"image":"i11869"},{"op":"text","speaker":"美希","text":"“只有在维护岛上治安万不得已的时候才可以开枪。”"},{"op":"text","speaker":"羽依里","text":"“话是这么说，但我感觉你平时开枪的频率还蛮高的啊。”"},{"op":"text","speaker":"","text":"虽然每次挨打的都是某人就是了。"},{"op":"text","speaker":"","text":"在巡逻的时候，自然会遇到几位岛民。"},{"op":"text","speaker":"","text":"当然，其中也包括那个扰乱岛上治安、总是挨枪子的家伙。"},{"op":"image","layer":1,"image":"i12167"},{"op":"text","speaker":"良一","text":"“这……这是……怎么回事……？”"},{"op":"text","speaker":"","text":"良一看到我，瞪大眼睛露出一脸震惊的样子。"},{"op":"text","speaker":"羽依里","text":"“怎么了？”"},{"op":"image","layer":1,"image":"i12149"},{"op":"text","speaker":"良一","text":"“呜……”"},{"op":"image","layer":1,"image":"i12152"},{"op":"text","speaker":"良一","text":"“叛徒――――！”"},{"op":"text","speaker":"","text":"他突然就哭着跑开了。"},{"op":"text","speaker":"羽依里","text":"“说我是叛徒也太过分了。”"},{"op":"text","speaker":"羽依里","text":"“可以追上去射他吗？”"},{"op":"image","layer":1,"image":"i11709"},{"op":"text","speaker":"美希","text":"“穿着衣服的时候不行。”"},{"op":"text","speaker":"羽依里","text":"“那我给他脱掉呢？”"},{"op":"image","layer":1,"image":"i11755"},{"op":"text","speaker":"美希","text":"“你怎么可以带头破坏公序良俗呢。”"},{"op":"text","speaker":"羽依里","text":"“也是啊。”"},{"op":"text","speaker":"","text":"话说回来，我才不想脱男人的衣服呢。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i10224"},{"op":"text","speaker":"苍","text":"“野美希和……咦，羽依里？”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"苍","text":"“你们两个在做什么呢？”"},{"op":"text","speaker":"羽依里","text":"“在岛上巡逻。”"},{"op":"image","layer":1,"image":"i10227"},{"op":"text","speaker":"苍","text":"“巡逻？”"},{"op":"text","speaker":"羽依里","text":"“看这个看这个。”"},{"op":"text","speaker":"","text":"给她秀了秀水枪和袖章。"},{"op":"text","speaker":"羽依里","text":"“这些是野美希给我的。”"},{"op":"image","layer":257,"image":"i11701"},{"op":"text","speaker":"美希","text":"“没有给你，只是暂时借你的。”"},{"op":"text","speaker":"羽依里","text":"“……对，是借的。”"},{"op":"image","layer":1,"image":"i10243"},{"op":"image","layer":257,"image":"i11709"},{"op":"text","speaker":"苍","text":"“也就是说，你该不会是加入少年团了吧？”"},{"op":"text","speaker":"羽依里","text":"“算是吧，不过名义上是来给野美希打下手。”"},{"op":"image","layer":1,"image":"i10276"},{"op":"text","speaker":"苍","text":"“哎～～”"},{"op":"text","speaker":"羽依里","text":"“你干嘛一脸高兴的样子啊？”"},{"op":"image","layer":1,"image":"i10282"},{"op":"text","speaker":"苍","text":"“没什么。”"},{"op":"image","layer":1,"image":"i10330"},{"op":"text","speaker":"苍","text":"“只是觉得，干这些总比在岛上的小孩子们面前耍威风要好。”"},{"op":"text","speaker":"羽依里","text":"“太过分了吧，我可没干过这种事。”"},{"op":"image","layer":1,"image":"i10285"},{"op":"text","speaker":"苍","text":"“而且对野美希来说，两个人一起肯定比自己单干更有意思吧。”"},{"op":"image","layer":257,"image":"i11699"},{"op":"text","speaker":"美希","text":"“你在说什么呢？”"},{"op":"image","layer":257,"image":"i11701"},{"op":"text","speaker":"美希","text":"“我没觉得有什么意思，只是有人帮忙会比较轻松而已。”"},{"op":"image","layer":1,"image":"i10282"},{"op":"text","speaker":"苍","text":"“好吧，我就当是这样吧。”"},{"op":"image","layer":257,"image":"i11712"},{"op":"text","speaker":"美希","text":"“别说得这么话里有话啊。”"},{"op":"image","layer":257,"image":"i11728"},{"op":"text","speaker":"美希","text":"“这里没什么问题，鹰原，我们去下一个地方。”"},{"op":"text","speaker":"羽依里","text":"“好的好的。”"},{"op":"image","layer":1,"image":"i10112"},{"op":"text","speaker":"苍","text":"“要加油巡逻哦～”"},{"op":"text","speaker":"","text":"怎么回事，感觉莫名其妙就被加油打气了。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i51"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13177"},{"op":"text","speaker":"白羽","text":"“啊……”"},{"op":"text","speaker":"羽依里","text":"“哟。”"},{"op":"image","layer":1,"image":"i13115"},{"op":"text","speaker":"白羽","text":"“为……为、为什么你们两个会在一起？”"},{"op":"text","speaker":"","text":"白羽向野美希问道。"},{"op":"image","layer":257,"image":"i11728"},{"op":"text","speaker":"美希","text":"“我看鹰原很闲，就拜托他来帮忙了。”"},{"op":"image","layer":1,"image":"i13124"},{"op":"text","speaker":"白羽","text":"“帮忙……”"},{"op":"text","speaker":"羽依里","text":"“就是这样，从今天起我也是岛上少年团的一员了，请多关照。”"},{"op":"image","layer":1,"image":"i13161"},{"op":"text","speaker":"白羽","text":"“哎……”"},{"op":"image","layer":1,"image":"i13154"},{"op":"text","speaker":"白羽","text":"“你该不会。”"},{"op":"image","layer":1,"image":"i13152"},{"op":"text","speaker":"白羽","text":"“打算赖在岛上不走了吧……？”"},{"op":"text","speaker":"羽依里","text":"“拜托你不要用这种嫌麻烦的表情说话啊。”"},{"op":"image","layer":1,"image":"i13115"},{"op":"text","speaker":"白羽","text":"“那个……”"},{"op":"image","layer":1,"image":"i13108"},{"op":"text","speaker":"白羽","text":"“希望不会……带来太多麻烦。”"},{"op":"text","speaker":"","text":"她如此希望道。"},{"op":"image","layer":257,"image":"i11715"},{"op":"text","speaker":"美希","text":"“别这么说，他其实帮了我不少忙的。”"},{"op":"image","layer":257,"image":"i11696"},{"op":"text","speaker":"美希","text":"“白羽你也对他温柔一点吧。”"},{"op":"image","layer":1,"image":"i13115"},{"op":"text","speaker":"白羽","text":"“我也不是没有温柔对待啊……”"},{"op":"text","speaker":"","text":"野美希是在帮我说话吗？"},{"op":"text","speaker":"","text":"这种被人认可的感觉，真的是好久都没有体会到了。"},{"op":"text","speaker":"","text":"真心感觉有些高兴。"},{"op":"text","speaker":"羽依里","text":"“野美希，我会努力做好少年团的工作的。”"},{"op":"image","layer":257,"image":"i11731"},{"op":"text","speaker":"美希","text":"“怎么突然就这么有干劲了？”"},{"op":"text","speaker":"羽依里","text":"“那么，去下一个巡逻点吧！”"},{"op":"image","layer":257,"image":"i11712"},{"op":"text","speaker":"美希","text":"“真是个奇怪的家伙。”"},{"op":"text","speaker":"羽依里","text":"“岛上的风气就由我们来守护吧。”"},{"op":"image","layer":257,"image":"i11701"},{"op":"text","speaker":"美希","text":"“太过激动很快就会累垮的哦。”"},{"op":"image","layer":1,"image":"i13140"},{"op":"text","speaker":"白羽","text":"“…………”"},{"op":"if","truth":false,"target":322,"value":["==",["s",106],["string","８月１日"]]},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i158"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"然后――事件便发生了。"},{"op":"image","layer":0,"image":"i31"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11797"},{"op":"text","speaker":"美希","text":"“――!؟”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"","text":"虽然野美希的手指搭在了Hydro的扳机上，但她看上去非常犹豫该作何判断。"},{"op":"text","speaker":"","text":"老实说，我也有点犹豫。"},{"op":"image","layer":257,"image":"i12248"},{"op":"text","speaker":"良一","text":"“嘿嘿……今天也是热到让人想把衣服脱掉呢。”"},{"op":"image","layer":1,"image":"i11789"},{"op":"text","speaker":"美希","text":"“啊，啊啊……怎么说呢，这身衣服还真是很……贴身呢。”"},{"op":"text","speaker":"","text":"她把视线移到了别处。"},{"op":"image","layer":257,"image":"i12243"},{"op":"text","speaker":"良一","text":"“是吧，这衣服够漂亮吧。”"},{"op":"image","layer":1,"image":"i11795"},{"op":"text","speaker":"美希","text":"“呜……呜呜～……”"},{"op":"text","speaker":"","text":"不，也可能她只是提高了警惕，在保持距离而已……"},{"op":"image","layer":257,"image":"i12242"},{"op":"text","speaker":"良一","text":"“啊～果然衣服是好东西啊～”"},{"op":"image","layer":257,"image":"i12239"},{"op":"text","speaker":"良一","text":"“穿上不同的衣服，不管是身心还是看到的景色，也都会一并发生变化哦。”"},{"op":"image","layer":257,"image":"i12244"},{"op":"text","speaker":"良一","text":"“对吧，野美希♪”"},{"op":"text","speaker":"","text":"虽然他讲得头头是道，但那绝对不是衣服。"},{"op":"text","speaker":"","text":"野美希时不时用手指轻拨几下扳机，却始终没有摁下去。"},{"op":"text","speaker":"","text":"她认定这玩意是“衣服”了吗？"},{"op":"image","layer":257,"image":"i12239"},{"op":"text","speaker":"良一","text":"“羽依里也是，刚才叫你叛徒什么的，真是抱歉啊。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"我慢慢地把Hydro Caliber零式对准良一。"},{"op":"text","speaker":"","text":"砰!!!"},{"op":"text","speaker":"羽依里","text":"“哇哦！”"},{"op":"text","speaker":"","text":"它的威力和后坐力远超我的想象，手腕差点都要脱臼了。"},{"op":"text","speaker":"","text":"这小小的水枪里到底藏了什么黑科技啊؟؟"},{"op":"image","layer":1,"image":"i12062"},{"op":"text","speaker":"良一","text":"“乳头好痛！”"},{"op":"image","layer":1,"image":"i12015"},{"op":"text","speaker":"良一","text":"“羽依里！你对穿着衣服的人干什么啊！”"},{"op":"image","layer":257,"image":"i11786"},{"op":"text","speaker":"美希","text":"“不，你已经没在穿了。”"},{"op":"image","layer":1,"image":"i12013"},{"op":"text","speaker":"良一","text":"“哎？”"},{"op":"image","layer":257,"image":"i11789"},{"op":"text","speaker":"美希","text":"“现在的你，是裸体。”"},{"op":"text","speaker":"","text":"说着，野美希重新举起了Hydro Gladiator改。"},{"op":"text","speaker":"","text":"良一身上的人体彩绘，已经被我的那一枪冲洗掉了。"},{"op":"image","layer":1,"image":"i12062"},{"op":"text","speaker":"良一","text":"“呜哇啊啊啊！我的衣服啊啊啊――！”"},{"op":"image","layer":257,"image":"i11800"},{"op":"text","speaker":"美希","text":"“去死吧。”"},{"op":"image","layer":1,"image":"i12054"},{"op":"text","speaker":"","text":"砰！"},{"op":"text","speaker":"","text":"砰！"},{"op":"text","speaker":"","text":"砰！"},{"op":"image","layer":1,"image":"i12062"},{"op":"text","speaker":"良一","text":"“呀啊啊啊啊啊啊啊啊！”"},{"op":"text","speaker":"","text":"趁其不备，自近距离几发射击。"},{"op":"text","speaker":"","text":"良一当场倒下了。"},{"op":"image","layer":257,"image":"i11696"},{"op":"text","speaker":"美希","text":"“呼，鹰原，多谢了。”"},{"op":"text","speaker":"羽依里","text":"“没什么，倒不如说为什么之前没开枪呢？”"},{"op":"image","layer":257,"image":"i11776"},{"op":"text","speaker":"美希","text":"“唔……唔，虽然很薄，但皮肤上姑且有东西盖着……”"},{"op":"text","speaker":"羽依里","text":"“已经相当违反公序良俗了。”"},{"op":"text","speaker":"","text":"反倒是裸体还更健全些。"},{"op":"image","layer":257,"image":"i11775"},{"op":"text","speaker":"美希","text":"“是、是吗……确实是这样，唔……”"},{"op":"text","speaker":"羽依里","text":"“你也太认真了吧。”"},{"op":"text","speaker":"","text":"不过，这股认真劲儿也确实是野美希的优点。"},{"op":"text","speaker":"羽依里","text":"“我成功帮到忙了。”"},{"op":"image","layer":257,"image":"i11689"},{"op":"text","speaker":"美希","text":"“嗯，你帮我脱掉了良一的衣服，真是帮大忙了。”"},{"op":"text","speaker":"羽依里","text":"“好怪的说法……”"},{"op":"goto","target":322},{"op":"set","variable":419,"value":1},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]