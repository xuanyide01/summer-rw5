[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我来到了小卖铺。"},{"op":"text","speaker":"","text":"老奶奶……正在睡觉。"},{"op":"text","speaker":"","text":"还是不要吵到她了。"},{"op":"text","speaker":"","text":"这么一来，我现在能干的事……"},{"op":"text","speaker":"羽依里","text":"“也就只有去玩扭蛋了吧。”"},{"op":"text","speaker":"","text":"怎么办好呢。"},{"op":"choice","variable":6001,"items":[{"text":"玩扭蛋","value":0,"condition":1},{"text":"不玩扭蛋","value":1,"condition":1}]},{"op":"if","truth":false,"target":58,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“总之，去玩玩吧。”"},{"op":"text","speaker":"","text":"我从钱包里掏出了100日元硬币。"},{"op":"text","speaker":"","text":"咔嚓嚓……"},{"op":"text","speaker":"羽依里","text":"“这，这是……！”"},{"op":"text","speaker":"羽依里","text":"“飞女悠悠球!!”"},{"op":"text","speaker":"羽依里","text":"“沉甸甸的！哇啊，好棒――！感觉跟真的一样。”"},{"op":"text","speaker":"羽依里","text":"“线绳部分也确实做成了锁链！”"},{"op":"text","speaker":"羽依里","text":"“也就是说，只要按这里的话……”"},{"op":"text","speaker":"","text":"啪嗒。"},{"op":"text","speaker":"羽依里","text":"“出现了――――！樱花的纹章――――！”"},{"op":"text","speaker":"羽依里","text":"“不可原谅――――！”"},{"op":"text","speaker":"岛上的女孩A","text":"“…………”"},{"op":"text","speaker":"岛上的女孩B","text":"“…………”"},{"op":"text","speaker":"岛上的女孩C","text":"“…………”"},{"op":"text","speaker":"羽依里","text":"“……Oh……”"},{"op":"if","truth":false,"target":30,"value":["==",["v",24],1]},{"op":"text","speaker":"岛上的女孩A","text":"“本以为你是路西法，没想到却是飞女啊。”"},{"op":"goto","target":39},{"op":"if","truth":false,"target":33,"value":["==",["v",25],1]},{"op":"text","speaker":"岛上的女孩A","text":"“本以为你是摇滚金丝雀，没想到却是飞女啊。”"},{"op":"goto","target":39},{"op":"if","truth":false,"target":36,"value":["==",["v",26],1]},{"op":"text","speaker":"岛上的女孩A","text":"“本以为你是王者，没想到却是飞女啊。”"},{"op":"goto","target":39},{"op":"if","truth":false,"target":39,"value":["==",["v",27],1]},{"op":"text","speaker":"岛上的女孩A","text":"“本以为你是殇鹰，没想到却是飞女啊。”"},{"op":"goto","target":39},{"op":"text","speaker":"岛上的女孩B","text":"“明明是男人却是飞女。”"},{"op":"text","speaker":"岛上的女孩C","text":"“而且还是第二代。”"},{"op":"if","truth":false,"target":45,"value":["native","称号を獲得したことがある"]},{"op":"text","speaker":"岛上的女孩A","text":"“是见过被飞女诅咒的阿秀的路西法。”"},{"op":"text","speaker":"羽依里","text":"“等等，阿秀变得无比糟糕了。”"},{"op":"goto","target":45},{"op":"text","speaker":"岛上的女孩C","text":"“但是飞女会来这里，难不成是这岛上发生了案件？”"},{"op":"text","speaker":"岛上的女孩B","text":"“得赶快通知大家！”"},{"op":"text","speaker":"羽依里","text":"“啊，等一下！”"},{"op":"text","speaker":"羽依里","text":"“走掉了……”"},{"op":"text","speaker":"羽依里","text":"“有种不详的预感……”"},{"op":"if","truth":false,"target":54,"value":["native","称号を獲得したことがある"]},{"op":"set","variable":6001,"value":35},{"op":"callScene","scene":4,"target":2},{"op":"goto","target":56},{"op":"set","variable":6001,"value":34},{"op":"callScene","scene":4,"target":2},{"op":"add","variable":6035,"value":1},{"op":"goto","target":107},{"op":"if","truth":false,"target":77,"value":[">=",["v",6035],3]},{"op":"text","speaker":"羽依里","text":"“不行，今天的风向不太对。”"},{"op":"text","speaker":"","text":"在这种时候，还是不玩为好。"},{"op":"text","speaker":"","text":"放弃也是一种勇气。"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“不玩吗？”"},{"op":"text","speaker":"羽依里","text":"“哇啊！老奶奶！您醒了？”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“这也是一种勇气。”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“这样的话，我把这个给你。”"},{"op":"text","speaker":"羽依里","text":"“唉？这是？”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“这是我精制的麦芽糖。”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“是只用米做出来的特别品。”"},{"op":"text","speaker":"羽依里","text":"“啊，好，那我就不客气了。”"},{"op":"text","speaker":"","text":"立刻舔了一口。"},{"op":"text","speaker":"","text":"一股柔和的甜味在口中回荡。"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“喉咙很舒服吧。”"},{"op":"text","speaker":"","text":"我使劲竖起了大拇指。"},{"op":"if","truth":false,"target":76,"value":["==",["native","エサを過去に手に入れたことがある"],0]},{"op":"goto","target":76},{"op":"goto","target":107},{"op":"text","speaker":"","text":"我对扭蛋也没有那么执着。"},{"op":"text","speaker":"","text":"而且基本上也抽不出什么值100日元的东西。"},{"op":"text","speaker":"","text":"倒不如用这100日元买老奶奶的刨冰。"},{"op":"text","speaker":"羽依里","text":"“老奶奶，来一份蓝色夏威夷。”"},{"op":"text","speaker":"","text":"我闭上眼睛，打了一个响指。"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"没有回应。"},{"op":"text","speaker":"","text":"对了，老奶奶正在睡觉。"},{"op":"text","speaker":"岛上的女孩A","text":"“…………”"},{"op":"text","speaker":"岛上的女孩B","text":"“…………”"},{"op":"text","speaker":"岛上的女孩C","text":"“…………”"},{"op":"text","speaker":"","text":"我睁开眼睛，发现岛上的女孩们正死死地盯着我。"},{"op":"text","speaker":"","text":"就在其中一个女孩要开口的瞬间。"},{"op":"text","speaker":"羽依里","text":"“Just! a! moment!”"},{"op":"text","speaker":"","text":"我伸手制止了女孩们。"},{"op":"text","speaker":"羽依里","text":"“不是我自夸，我的内心并不强大。”"},{"op":"if","truth":false,"target":96,"value":["==",["v",24],1]},{"op":"text","speaker":"羽依里","text":"“路西法什么的。”"},{"op":"goto","target":105},{"op":"if","truth":false,"target":99,"value":["==",["v",25],1]},{"op":"text","speaker":"羽依里","text":"“摇滚金丝雀什么的。”"},{"op":"goto","target":105},{"op":"if","truth":false,"target":102,"value":["==",["v",26],1]},{"op":"text","speaker":"羽依里","text":"“王者什么的。”"},{"op":"goto","target":105},{"op":"if","truth":false,"target":105,"value":["==",["v",27],1]},{"op":"text","speaker":"羽依里","text":"“殇鹰什么的。”"},{"op":"goto","target":105},{"op":"text","speaker":"羽依里","text":"“真的让我很难为情啊――――！”"},{"op":"text","speaker":"","text":"我大叫着，全力逃了出去。"},{"op":"add","variable":6030,"value":1},{"op":"set","variable":21,"value":1},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"return"},{"op":"end"}]