[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i129"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":7,"image":"i14280"},{"op":"text","speaker":"紬","text":"“这个……分到这边。”"},{"op":"image","layer":7,"image":"i13736"},{"op":"text","speaker":"静久","text":"“是吕客罐呢。”"},{"op":"image","layer":7,"image":"i14296"},{"op":"text","speaker":"紬","text":"“这个……分到预备朋友里。”"},{"op":"image","layer":7,"image":"i13769"},{"op":"text","speaker":"静久","text":"“哈哈，又有布偶来了♪”"},{"op":"image","layer":7,"image":"i13836"},{"op":"text","speaker":"静久","text":"“啊，有罐还没喝的咖啡。应该把里面的倒掉再分到不可燃垃圾吧？”"},{"op":"image","layer":7,"image":"i14280"},{"op":"text","speaker":"紬","text":"“保质期到什么时候？”"},{"op":"image","layer":7,"image":"i13842"},{"op":"text","speaker":"静久","text":"“还没过。”"},{"op":"image","layer":7,"image":"i14316"},{"op":"text","speaker":"紬","text":"“羽依里先生会喜欢的。”"},{"op":"text","speaker":"","text":"我来到灯塔，只见紬和静久在进行垃圾分类。"},{"op":"text","speaker":"","text":"原来那咖啡真的是漂流物啊。"},{"op":"text","speaker":"羽依里","text":"“早。”"},{"op":"image","layer":1,"image":"i14234"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"紬","text":"“早上好，羽依里先生。”"},{"op":"image","layer":257,"image":"i13770"},{"op":"text","speaker":"静久","text":"“早上好，乳依里。”"},{"op":"text","speaker":"羽依里","text":"“这大清早的就开始捡垃圾？”"},{"op":"image","layer":1,"image":"i14281"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"紬","text":"“不，今天是寻宝。”"},{"op":"image","layer":1,"image":"i14287"},{"op":"text","speaker":"紬","text":"“我们要从漂流物里找出看上去有意思的东西。”"},{"op":"text","speaker":"","text":"这样形容捡垃圾，感觉好玩了一些。"},{"op":"image","layer":257,"image":"i13804"},{"op":"text","speaker":"静久","text":"“紬为什么把吕客罐分到宝贝里呢？”"},{"op":"image","layer":1,"image":"i14331"},{"op":"text","speaker":"紬","text":"“不是宝贝。”"},{"op":"image","layer":1,"image":"i14329"},{"op":"text","speaker":"紬","text":"“而是素材。”"},{"op":"text","speaker":"羽依里","text":"“好像是造阳台的材料。”"},{"op":"image","layer":257,"image":"i13794"},{"op":"text","speaker":"静久","text":"“这日子过得真前卫。”"},{"op":"text","speaker":"","text":"难道她打算今天一天都干这个？"},{"op":"text","speaker":"羽依里","text":"“话说你们俩啊。”"},{"op":"image","layer":1,"image":"i14196"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"紬","text":"“……？”"},{"op":"text","speaker":"羽依里","text":"“你们一大早就开始捡垃圾，就没有什么要干或想干的事吗？”"},{"op":"image","layer":257,"image":"i13770"},{"op":"text","speaker":"静久","text":"“我。”"},{"op":"text","speaker":"","text":"静久迅速举起了手。"},{"op":"image","layer":257,"image":"i13823"},{"op":"text","speaker":"静久","text":"“能和紬和乳依里在一起我就满足了。”"},{"op":"text","speaker":"羽依里","text":"“这样啊。”"},{"op":"image","layer":1,"image":"i14200"},{"op":"text","speaker":"紬","text":"“我。”"},{"op":"text","speaker":"","text":"紬也举起了手。"},{"op":"image","layer":1,"image":"i14202"},{"op":"text","speaker":"紬","text":"“那请你和我们一起找吧。”"},{"op":"text","speaker":"羽依里","text":"“找宝贝？”"},{"op":"image","layer":1,"image":"i14287"},{"op":"text","speaker":"紬","text":"“不，是找自己想干的事。”"},{"op":"text","speaker":"羽依里","text":"“……啊。”"},{"op":"image","layer":257,"image":"i13767"},{"op":"text","speaker":"静久","text":"“怎么了？”"},{"op":"image","layer":1,"image":"i14196"},{"op":"text","speaker":"紬","text":"“我和羽依里先生初次见面的时候，就和他说过了。”"},{"op":"text","speaker":"紬","text":"“说我在找自己想干的事。”"},{"op":"image","layer":1,"image":"i14242"},{"op":"text","speaker":"紬","text":"“找自己想干的事，就是我想干的事。”"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"静久","text":"“真有哲学味道。”"},{"op":"text","speaker":"羽依里","text":"“说起来，捡垃圾这活好像也不是你想做所以做的吧？”"},{"op":"image","layer":1,"image":"i14196"},{"op":"text","speaker":"紬","text":"“嗯。这活其实很麻烦。”"},{"op":"image","layer":257,"image":"i13752"},{"op":"text","speaker":"静久","text":"“我被这个真相震惊了。”"},{"op":"image","layer":1,"image":"i14281"},{"op":"text","speaker":"紬","text":"“我想找到自己真正想做的事。”"},{"op":"image","layer":1,"image":"i14284"},{"op":"text","speaker":"紬","text":"“所以希望两位能帮我一起找。”"},{"op":"image","layer":1,"image":"i14202"},{"op":"text","speaker":"紬","text":"“感觉和你们两位一起，我就能找到。”"},{"op":"image","layer":1,"image":"i14237"},{"op":"text","speaker":"紬","text":"“拜托你们了。”"},{"op":"text","speaker":"","text":"紬低下头。"},{"op":"image","layer":257,"image":"i13816"},{"op":"text","speaker":"静久","text":"“原来你做了这么多，都是为了这个啊。”"},{"op":"image","layer":257,"image":"i13846"},{"op":"text","speaker":"静久","text":"“嗯，我很乐意帮忙。”"},{"op":"image","layer":1,"image":"i14287"},{"op":"text","speaker":"紬","text":"“静久……谢谢你。”"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"静久","text":"“乳依里你呢？”"},{"op":"text","speaker":"羽依里","text":"“呃……”"},{"op":"text","speaker":"","text":"寻找想做的事吗。"},{"op":"text","speaker":"羽依里","text":"“紬，我能问一个问题吗？”"},{"op":"image","layer":1,"image":"i14196"},{"op":"text","speaker":"紬","text":"“嗯，请问吧。”"},{"op":"text","speaker":"羽依里","text":"“你为什么想寻找自己想做的事？”"},{"op":"image","layer":1,"image":"i14326"},{"op":"text","speaker":"紬","text":"“……这个啊。”"},{"op":"image","layer":1,"image":"i14338"},{"op":"text","speaker":"紬","text":"“我想找到自己……”"},{"op":"image","layer":1,"image":"i14326"},{"op":"text","speaker":"紬","text":"“在这里的意义。”"},{"op":"image","layer":1,"image":"i14289"},{"op":"text","speaker":"紬","text":"“我有预感，这意义就在我想做的事情里……”"},{"op":"text","speaker":"羽依里","text":"“在这里的意义……”"},{"op":"text","speaker":"","text":"对紬而言，"},{"op":"text","speaker":"","text":"这种意义……"},{"op":"text","speaker":"","text":"真的存在吗……？"},{"op":"text","speaker":"","text":"不仅是对她，对我"},{"op":"text","speaker":"","text":"……对大家而言也一样。"},{"op":"text","speaker":"","text":"…………"},{"op":"choice","variable":6001,"items":[{"text":"和她一起寻找想做的事","value":0,"condition":1},{"text":"看我兴致吧","value":1,"condition":1}]},{"op":"if","truth":false,"target":137,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“……一起找吧？”"},{"op":"text","speaker":"","text":"虽然不知道能不能找到。"},{"op":"text","speaker":"","text":"甚至不知道存不存在。"},{"op":"text","speaker":"羽依里","text":"“嗯，一起找吧。”"},{"op":"image","layer":1,"image":"i14200"},{"op":"text","speaker":"紬","text":"“谢谢你。”"},{"op":"image","layer":257,"image":"i13740"},{"op":"text","speaker":"静久","text":"“哈哈♪不愧是乳依里。”"},{"op":"text","speaker":"羽依里","text":"“我可没说什么值得表扬的话。”"},{"op":"text","speaker":"","text":"紬的话，让我的心中有了点想法。"},{"op":"text","speaker":"","text":"于是就自然而然地答应她了。"},{"op":"image","layer":1,"image":"i14202"},{"op":"text","speaker":"紬","text":"“我现在就有一个请求，可以吗？”"},{"op":"text","speaker":"羽依里","text":"“嗯，随时都可以。”"},{"op":"image","layer":257,"image":"i13743"},{"op":"text","speaker":"静久","text":"“使劲拜托他吧。”"},{"op":"set","variable":113,"value":1},{"op":"goto","target":155},{"op":"text","speaker":"羽依里","text":"“等我有兴致了吧。”"},{"op":"text","speaker":"","text":"我好歹也帮过她的忙了，总不可能整天都和她们在一起玩。"},{"op":"image","layer":1,"image":"i14200"},{"op":"text","speaker":"紬","text":"“那也没事。谢谢你。”"},{"op":"image","layer":257,"image":"i13740"},{"op":"text","speaker":"静久","text":"“那等你有兴致的时候，就麻烦你咯。”"},{"op":"text","speaker":"羽依里","text":"“好。”"},{"op":"image","layer":1,"image":"i14196"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"紬","text":"“话说你现在有兴致吗？”"},{"op":"text","speaker":"","text":"嗯―。"},{"op":"text","speaker":"羽依里","text":"“有吧。”"},{"op":"image","layer":1,"image":"i14234"},{"op":"text","speaker":"紬","text":"“是吗。真是太好了。”"},{"op":"image","layer":1,"image":"i14284"},{"op":"text","speaker":"紬","text":"“我现在就有一件事。”"},{"op":"text","speaker":"羽依里","text":"“嗯，什么事？”"},{"op":"text","speaker":"静久","text":"“我会帮你的。”"},{"op":"image","layer":1,"image":"i14326"},{"op":"text","speaker":"紬","text":"“请问我想做的事情是什么？”"},{"op":"text","speaker":"羽依里","text":"“一上来就这么尖锐。”"},{"op":"image","layer":257,"image":"i13804"},{"op":"text","speaker":"静久","text":"“有没有提示，或者自己心里有没有什么头绪？”"},{"op":"image","layer":1,"image":"i14281"},{"op":"text","speaker":"紬","text":"“没有。”"},{"op":"text","speaker":"","text":"没有吗。"},{"op":"text","speaker":"羽依里","text":"“你最想做的是什么？”"},{"op":"image","layer":1,"image":"i14196"},{"op":"text","speaker":"紬","text":"“找我想做的事情。”"},{"op":"text","speaker":"","text":"瞬间就进入了死循环。"},{"op":"text","speaker":"","text":"这循环上还只有两个点。"},{"op":"image","layer":1,"image":"i14204"},{"op":"text","speaker":"紬","text":"“但我的目标是收集吕客罐。”"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"静久","text":"“紬为什么想造阳台？”"},{"op":"image","layer":1,"image":"i14287"},{"op":"text","speaker":"紬","text":"“我想要一个阳台。”"},{"op":"image","layer":1,"image":"i14294"},{"op":"text","speaker":"紬","text":"“感觉这个目标完成后，我就能找到自己。”"},{"op":"image","layer":257,"image":"i13743"},{"op":"text","speaker":"静久","text":"“是嘛。”"},{"op":"image","layer":257,"image":"i13770"},{"op":"text","speaker":"静久","text":"“既然这样，那我们就去收集罐子吧？”"},{"op":"image","layer":1,"image":"i14196"},{"op":"text","speaker":"紬","text":"“第一站去小卖铺吗？”"},{"op":"text","speaker":"羽依里","text":"“嗯～……离上次也没过多久，他们应该还没攒起来。”"},{"op":"text","speaker":"羽依里","text":"“紬还有其他能给你吕客罐的熟人吗？”"},{"op":"image","layer":1,"image":"i14338"},{"op":"text","speaker":"紬","text":"“也不是没有。”"},{"op":"image","layer":257,"image":"i13816"},{"op":"text","speaker":"静久","text":"“那我们就去那儿问问？”"},{"op":"image","layer":1,"image":"i14284"},{"op":"text","speaker":"紬","text":"“可以呀。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i14489"},{"op":"text","speaker":"紬","text":"“有人吗？”"},{"op":"text","speaker":"羽依里","text":"“慢着，紬。小卖铺前不久刚给了我们空罐来着。”"},{"op":"image","layer":1,"image":"i14417"},{"op":"text","speaker":"紬","text":"“我经过这里的目的不是吕客罐。”"},{"op":"image","layer":1,"image":"i14381"},{"op":"text","speaker":"紬","text":"“是我有些东西要买。”"},{"op":"text","speaker":"羽依里","text":"“……？”"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i51"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"她把我们带到了一个实在是出乎意料的地方。"},{"op":"text","speaker":"","text":"因为……"},{"op":"image","layer":0,"image":"i239"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13457"},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i13457"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"白羽在这里。"},{"op":"text","speaker":"","text":"紬和白羽……到底有什么交集？"},{"op":"image","layer":7,"image":"i14416"},{"op":"text","speaker":"紬","text":"“我们走吧。”"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i51"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i14381"},{"op":"image","layer":257,"image":"i13238"},{"op":"text","speaker":"紬","text":"“你好呀，西瓜棒小姐。”"},{"op":"image","layer":257,"image":"i13277"},{"op":"text","speaker":"白羽","text":"“嗯，棉花糖妹――”"},{"op":"image","layer":257,"image":"i13319"},{"op":"text","speaker":"白羽","text":"“――!؟”"},{"op":"text","speaker":"羽依里","text":"“嗨。”"},{"op":"image","layer":257,"image":"i13381"},{"op":"text","speaker":"白羽","text":"“来了个自说自话的人！”"},{"op":"text","speaker":"","text":"这话真伤人。"},{"op":"image","layer":7,"image":"i13845"},{"op":"text","speaker":"静久","text":"“哈哈，你好啊，鸣濑同学♪”"},{"op":"image","layer":257,"image":"i13387"},{"op":"text","speaker":"白羽","text":"“而且还有两个！”"},{"op":"image","layer":7,"image":"i13839"},{"op":"text","speaker":"静久","text":"“这话真过分。”"},{"op":"image","layer":1,"image":"i14473"},{"op":"text","speaker":"紬","text":"“西瓜棒小姐，可以和你说些事吗？”"},{"op":"image","layer":257,"image":"i13384"},{"op":"text","speaker":"白羽","text":"“有，有什么事……棉花糖妹妹。”"},{"op":"image","layer":1,"image":"i14547"},{"op":"text","speaker":"紬","text":"“我有个请求想拜托西瓜棒小姐。”"},{"op":"image","layer":257,"image":"i13415"},{"op":"text","speaker":"白羽","text":"“请等一下。”"},{"op":"image","layer":257,"image":"i13381"},{"op":"text","speaker":"白羽","text":"“拜托我之前，请别叫我西瓜棒小姐。”"},{"op":"image","layer":257,"image":"i13408"},{"op":"text","speaker":"白羽","text":"“听上去就跟卖很棒的西瓜的人似的。”"},{"op":"image","layer":1,"image":"i14473"},{"op":"text","speaker":"紬","text":"“那，西瓜姐姐。”"},{"op":"image","layer":257,"image":"i13370"},{"op":"text","speaker":"白羽","text":"“好。”"},{"op":"text","speaker":"","text":"这称呼和西瓜棒就没关系了，可以吗？"},{"op":"image","layer":1,"image":"i14417"},{"op":"text","speaker":"紬","text":"“我想要空吕客罐。”"},{"op":"image","layer":257,"image":"i13373"},{"op":"text","speaker":"白羽","text":"“我家没有这种东西。”"},{"op":"image","layer":1,"image":"i14396"},{"op":"text","speaker":"紬","text":"“这样啊。”"},{"op":"image","layer":1,"image":"i14417"},{"op":"text","speaker":"紬","text":"“对不起，占用你的时间了。”"},{"op":"image","layer":257,"image":"i13379"},{"op":"text","speaker":"白羽","text":"“没什么。别介意。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":257,"image":"i13390"},{"op":"text","speaker":"白羽","text":"“……你，你干嘛？”"},{"op":"image","layer":1,"image":"i14388"},{"op":"text","speaker":"紬","text":"“什么？”"},{"op":"text","speaker":"羽依里","text":"“就觉得你们俩在一起真让人意外。”"},{"op":"text","speaker":"羽依里","text":"“而且还交流起来了，老实说，我很震惊。”"},{"op":"image","layer":7,"image":"i13806"},{"op":"text","speaker":"静久","text":"“我也是……”"},{"op":"image","layer":257,"image":"i13235"},{"op":"text","speaker":"白羽","text":"“是你们和人的距离太近了。”"},{"op":"image","layer":257,"image":"i13301"},{"op":"text","speaker":"白羽","text":"“但棉花糖妹妹跟我的距离正好。”"},{"op":"image","layer":1,"image":"i14463"},{"op":"text","speaker":"紬","text":"“没错。”"},{"op":"text","speaker":"","text":"这确实……挺有说服力的。"},{"op":"text","speaker":"羽依里","text":"“你们是在哪，又是怎么相遇的？”"},{"op":"image","layer":1,"image":"i14384"},{"op":"text","speaker":"紬","text":"“就是这儿吧。”"},{"op":"image","layer":257,"image":"i13376"},{"op":"text","speaker":"白羽","text":"“那天我也是像现在这样钓着鱼时，她来了。”"},{"op":"text","speaker":"羽依里","text":"“完全无法想象。”"},{"op":"image","layer":1,"image":"i14417"},{"op":"text","speaker":"紬","text":"“那我们俩一起重演一番那天相遇的情形吧？”"},{"op":"image","layer":257,"image":"i13387"},{"op":"text","speaker":"白羽","text":"“唉？”"},{"op":"text","speaker":"羽依里","text":"“真想看。”"},{"op":"image","layer":1,"image":"i14461"},{"op":"text","speaker":"紬","text":"“那就拜托你了。西瓜姐姐。”"},{"op":"image","layer":257,"image":"i13384"},{"op":"text","speaker":"白羽","text":"“……既然棉花糖妹妹这么说……”"},{"op":"image","layer":1,"image":"i13373"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"image","layer":257,"image":"i14377"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"image","layer":257,"image":"i14401"},{"op":"image","layer":1,"image":"i13373"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"image","layer":257,"image":"i14417"},{"op":"text","speaker":"紬","text":"“钓得上来吗？”"},{"op":"image","layer":1,"image":"i13418"},{"op":"text","speaker":"白羽","text":"“一般般。”"},{"op":"image","layer":257,"image":"i14396"},{"op":"text","speaker":"紬","text":"“这是鱼的名字吗？”"},{"op":"image","layer":1,"image":"i13373"},{"op":"text","speaker":"白羽","text":"“不是的，意思是还行。”"},{"op":"image","layer":257,"image":"i14417"},{"op":"text","speaker":"紬","text":"“这样啊。”"},{"op":"image","layer":257,"image":"i14381"},{"op":"text","speaker":"紬","text":"“请你加油。”"},{"op":"image","layer":1,"image":"i13418"},{"op":"text","speaker":"白羽","text":"“嗯，我会加油。”"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"image","layer":1,"image":"i14548"},{"op":"image","layer":257,"image":"i13373"},{"op":"text","speaker":"紬","text":"“这就是我们的相遇。”"},{"op":"image","layer":257,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“大概就这样。”"},{"op":"image","layer":7,"image":"i13806"},{"op":"text","speaker":"静久","text":"“这对话就像是英语课本上的一样啊。”"},{"op":"text","speaker":"羽依里","text":"“完全看不出感情变好的征兆。”"},{"op":"text","speaker":"白羽","text":"“第一次见面一般都这样。”"},{"op":"image","layer":1,"image":"i14384"},{"op":"text","speaker":"紬","text":"“接下来关系会变好哦？”"},{"op":"text","speaker":"羽依里","text":"“可我看你们的情况，完全不这么觉得。”"},{"op":"image","layer":1,"image":"i14463"},{"op":"text","speaker":"紬","text":"“就是变好了。”"},{"op":"image","layer":1,"image":"i14431"},{"op":"text","speaker":"紬","text":"“我们现在是挚友了。”"},{"op":"image","layer":257,"image":"i13255"},{"op":"text","speaker":"白羽","text":"“唉？”"},{"op":"image","layer":257,"image":"i13424"},{"op":"text","speaker":"白羽","text":"“算，算不上挚友……”"},{"op":"image","layer":1,"image":"i14461"},{"op":"text","speaker":"紬","text":"“就给他们看看我们的友谊加深的日子吧。”"},{"op":"image","layer":257,"image":"i13384"},{"op":"text","speaker":"白羽","text":"“……一听棉花糖妹妹这么说，就拒绝不了……”"},{"op":"text","speaker":"","text":"她们到底是什么关系啊……"},{"op":"image","layer":1,"image":"i14417"},{"op":"image","layer":257,"image":"i13238"},{"op":"text","speaker":"紬","text":"“我们又见面了呢。”"},{"op":"image","layer":257,"image":"i13405"},{"op":"text","speaker":"白羽","text":"“……你好。”"},{"op":"image","layer":1,"image":"i14381"},{"op":"text","speaker":"紬","text":"“一般般吗？”"},{"op":"image","layer":257,"image":"i13376"},{"op":"text","speaker":"白羽","text":"“一般般。”"},{"op":"image","layer":1,"image":"i14506"},{"op":"text","speaker":"紬","text":"“今天的目标是什么呀？”"},{"op":"image","layer":257,"image":"i13370"},{"op":"text","speaker":"白羽","text":"“大家伙。”"},{"op":"image","layer":1,"image":"i14467"},{"op":"text","speaker":"紬","text":"“钓上来吃吗？”"},{"op":"image","layer":257,"image":"i13418"},{"op":"text","speaker":"白羽","text":"“吃。”"},{"op":"image","layer":1,"image":"i14473"},{"op":"text","speaker":"紬","text":"“你觉得最好吃的是什么呀？”"},{"op":"image","layer":257,"image":"i13376"},{"op":"text","speaker":"白羽","text":"“西瓜棒。”"},{"op":"image","layer":1,"image":"i14529"},{"op":"text","speaker":"紬","text":"“!؟”"},{"op":"image","layer":1,"image":"i14530"},{"op":"text","speaker":"紬","text":"“这个能……钓上来吗？”"},{"op":"image","layer":257,"image":"i13370"},{"op":"text","speaker":"白羽","text":"“钓不上来。”"},{"op":"image","layer":1,"image":"i14377"},{"op":"text","speaker":"紬","text":"“这样啊。”"},{"op":"image","layer":257,"image":"i13415"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"image","layer":257,"image":"i13384"},{"op":"text","speaker":"白羽","text":"“……想吃西瓜棒了。”"},{"op":"image","layer":257,"image":"i13426"},{"op":"text","speaker":"白羽","text":"“要不……我去买西瓜棒吧。”"},{"op":"image","layer":1,"image":"i14396"},{"op":"text","speaker":"紬","text":"“啊……”"},{"op":"image","layer":1,"image":"i14417"},{"op":"text","speaker":"紬","text":"“我正好想去小卖铺买棉花糖吃。”"},{"op":"image","layer":1,"image":"i14384"},{"op":"text","speaker":"紬","text":"“但我也想看大家伙。”"},{"op":"image","layer":1,"image":"i14381"},{"op":"text","speaker":"紬","text":"“所以……请你继续钓吧。”"},{"op":"image","layer":257,"image":"i13405"},{"op":"text","speaker":"白羽","text":"“这……”"},{"op":"image","layer":257,"image":"i13426"},{"op":"text","speaker":"白羽","text":"“可以吗？”"},{"op":"image","layer":1,"image":"i14445"},{"op":"text","speaker":"紬","text":"“可以的。”"},{"op":"image","layer":257,"image":"i13405"},{"op":"text","speaker":"白羽","text":"“那……买棒冰找的零钱……你用来买棉花糖吧。”"},{"op":"image","layer":1,"image":"i14396"},{"op":"text","speaker":"紬","text":"“姆啾！”"},{"op":"image","layer":1,"image":"i14401"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"image","layer":1,"image":"i14396"},{"op":"text","speaker":"紬","text":"“可以吗？”"},{"op":"image","layer":257,"image":"i13403"},{"op":"text","speaker":"白羽","text":"“可以的。”"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"image","layer":1,"image":"i14508"},{"op":"image","layer":257,"image":"i13238"},{"op":"text","speaker":"紬","text":"“是这样吧？”"},{"op":"image","layer":257,"image":"i13253"},{"op":"text","speaker":"白羽","text":"“……嗯。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"看起来关系确实变好了一点。"},{"op":"image","layer":1,"image":"i14417"},{"op":"text","speaker":"紬","text":"“自那以来，要是我觉得天气热，就会事先买好西瓜棒带过来。”"},{"op":"image","layer":257,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“很感激她。”"},{"op":"image","layer":257,"image":"i13259"},{"op":"text","speaker":"白羽","text":"“我都希望今后有空的时候也拜托她。”"},{"op":"image","layer":1,"image":"i14396"},{"op":"text","speaker":"紬","text":"“啊……”"},{"op":"image","layer":257,"image":"i13235"},{"op":"text","speaker":"白羽","text":"“……？”"},{"op":"image","layer":1,"image":"i14388"},{"op":"text","speaker":"紬","text":"“其实，这个夏天结束后，我就要回去了。”"},{"op":"image","layer":257,"image":"i13253"},{"op":"text","speaker":"白羽","text":"“是……吗？”"},{"op":"image","layer":1,"image":"i14404"},{"op":"text","speaker":"紬","text":"“是的。所以，暑假结束后，就不能再给你带西瓜棒了。”"},{"op":"image","layer":257,"image":"i13426"},{"op":"text","speaker":"白羽","text":"“真……遗憾。”"},{"op":"image","layer":1,"image":"i14417"},{"op":"text","speaker":"紬","text":"“谢谢你。”"},{"op":"image","layer":257,"image":"i13370"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"image","layer":257,"image":"i13373"},{"op":"text","speaker":"白羽","text":"“我要是吃了吕客……就把罐子给你带过去。”"},{"op":"image","layer":1,"image":"i14381"},{"op":"text","speaker":"紬","text":"“姆啾，谢谢你。”"},{"op":"image","layer":1,"image":"i14384"},{"op":"text","speaker":"紬","text":"“我随时都在灯塔。”"},{"op":"image","layer":257,"image":"i13376"},{"op":"text","speaker":"白羽","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“我也在。”"},{"op":"image","layer":257,"image":"i13390"},{"op":"text","speaker":"白羽","text":"“……不想去了。”"},{"op":"image","layer":7,"image":"i13809"},{"op":"text","speaker":"静久","text":"“我也在哦？”"},{"op":"image","layer":257,"image":"i13384"},{"op":"text","speaker":"白羽","text":"“……不想去了。”"},{"op":"text","speaker":"","text":"她还重复了一遍。"},{"op":"image","layer":1,"image":"i14417"},{"op":"text","speaker":"紬","text":"“下次再见。”"},{"op":"image","layer":257,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“嗯，再见。”"},{"op":"text","speaker":"","text":"她们互相点头致意。"},{"op":"text","speaker":"羽依里","text":"“……多么神奇的关系啊。”"},{"op":"image","layer":1,"image":"i13807"},{"op":"text","speaker":"静久","text":"“不过，关系居然还能那么好，这才神奇啊。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i1"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i14417"},{"op":"text","speaker":"紬","text":"“看来西瓜姐姐会给我们带吕客罐来，所以我想回去接着寻找想做的事。”"},{"op":"text","speaker":"羽依里","text":"“想到了什么新点子？”"},{"op":"image","layer":1,"image":"i14388"},{"op":"text","speaker":"紬","text":"“不……完全没有。”"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"静久","text":"“那要不要参考一下别人想做的事情？”"},{"op":"image","layer":1,"image":"i14489"},{"op":"text","speaker":"紬","text":"“哦～这个主意不错。”"},{"op":"image","layer":1,"image":"i14506"},{"op":"text","speaker":"紬","text":"“静久想做什么呀？”"},{"op":"image","layer":257,"image":"i13804"},{"op":"text","speaker":"静久","text":"“这个嘛。”"},{"op":"image","layer":257,"image":"i13770"},{"op":"text","speaker":"静久","text":"“就是和你们俩在一起。”"},{"op":"image","layer":1,"image":"i14489"},{"op":"text","speaker":"紬","text":"“哦～我也觉得这个主意很不错。”"},{"op":"image","layer":1,"image":"i14467"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"image","layer":1,"image":"i14377"},{"op":"text","speaker":"紬","text":"“可是我们已经在一起了。”"},{"op":"image","layer":1,"image":"i14396"},{"op":"text","speaker":"紬","text":"“驳回。”"},{"op":"image","layer":257,"image":"i13767"},{"op":"text","speaker":"静久","text":"“呜……”"},{"op":"text","speaker":"羽依里","text":"“这不明摆着的吗……”"},{"op":"image","layer":1,"image":"i14377"},{"op":"text","speaker":"紬","text":"“羽依里先生想做什么呀？”"},{"op":"text","speaker":"羽依里","text":"“我……”"},{"op":"text","speaker":"","text":"有很多想做的事情……"},{"op":"text","speaker":"","text":"不。"},{"op":"text","speaker":"","text":"曾经有过很多。"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"不过，都过去了。"},{"op":"text","speaker":"","text":"如今。"},{"op":"text","speaker":"羽依里","text":"“想吃炒饭。”"},{"op":"image","layer":1,"image":"i14396"},{"op":"image","layer":257,"image":"i13764"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"text","speaker":"静久","text":"“……”"},{"op":"text","speaker":"","text":"我的肚子非常饿。"},{"op":"text","speaker":"","text":"舌头和胃在渴求着松软的炒饭。"},{"op":"image","layer":1,"image":"i14417"},{"op":"text","speaker":"紬","text":"“我也想吃。”"},{"op":"image","layer":257,"image":"i13758"},{"op":"text","speaker":"静久","text":"“我也是。”"},{"op":"text","speaker":"羽依里","text":"“全票通过。”"},{"op":"text","speaker":"","text":"嗯，也快中午了。"},{"op":"text","speaker":"羽依里","text":"“我想先回去吃炒饭。”"},{"op":"image","layer":257,"image":"i13816"},{"op":"text","speaker":"静久","text":"“嗯。”"},{"op":"image","layer":257,"image":"i13823"},{"op":"text","speaker":"静久","text":"“毕竟快中午了，回去一趟比较好。”"},{"op":"image","layer":257,"image":"i13849"},{"op":"text","speaker":"静久","text":"“要是肚子空空的，脑子也转不快。”"},{"op":"text","speaker":"羽依里","text":"“是啊。”"},{"op":"text","speaker":"羽依里","text":"“那我过会儿再来。”"},{"op":"image","layer":257,"image":"i13816"},{"op":"text","speaker":"静久","text":"“就这么办。”"},{"op":"if","truth":false,"target":643,"value":["==",["v",113],1]},{"op":"text","speaker":"","text":"吃完饭后再来吧。"},{"op":"text","speaker":"","text":"嗯？"},{"op":"image","layer":7,"image":"i14376"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"text","speaker":"","text":"紬拉着我的袖子。"},{"op":"text","speaker":"羽依里","text":"“怎么了？”"},{"op":"image","layer":1,"image":"i14468"},{"op":"text","speaker":"紬","text":"“静久想做的，是我们三个在一起。”"},{"op":"image","layer":1,"image":"i14490"},{"op":"text","speaker":"紬","text":"“所以要在一起才行。”"},{"op":"text","speaker":"羽依里","text":"“我们在一起够久了吧。”"},{"op":"image","layer":1,"image":"i14468"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"image","layer":1,"image":"i14478"},{"op":"text","speaker":"紬","text":"“确实是这样。”"},{"op":"image","layer":1,"image":"i14527"},{"op":"text","speaker":"紬","text":"“呃……那就……”"},{"op":"image","layer":1,"image":"i14498"},{"op":"text","speaker":"紬","text":"“要是你回去了，我很孤单。”"},{"op":"text","speaker":"羽依里","text":"“是，是吗。”"},{"op":"text","speaker":"","text":"被她这么直直地盯着……什么话都说不出口了。"},{"op":"image","layer":1,"image":"i14490"},{"op":"text","speaker":"紬","text":"“你愿意帮忙，我觉得很开心……”"},{"op":"image","layer":1,"image":"i14498"},{"op":"text","speaker":"紬","text":"“可你要是走了，我会很失落。”"},{"op":"image","layer":1,"image":"i14504"},{"op":"text","speaker":"紬","text":"“我会姆啾啾～……的。”"},{"op":"image","layer":1,"image":"i14502"},{"op":"text","speaker":"紬","text":"“非常孤单。”"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"静久","text":"“她这么说哦。”"},{"op":"image","layer":257,"image":"i13740"},{"op":"text","speaker":"静久","text":"“你怎么打算，乳依里♪”"},{"op":"text","speaker":"羽依里","text":"“呃……”"},{"op":"text","speaker":"羽依里","text":"“这么直接跟我说，我拒绝不了的……”"},{"op":"text","speaker":"羽依里","text":"“好吧，再陪你一会儿。”"},{"op":"image","layer":1,"image":"i14397"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"紬","text":"“真的吗？”"},{"op":"text","speaker":"羽依里","text":"“真的。”"},{"op":"text","speaker":"羽依里","text":"“不过，我要是真的忍不住想吃炒饭了，还是会回去的。”"},{"op":"image","layer":1,"image":"i14490"},{"op":"text","speaker":"紬","text":"“姆啾！静久。”"},{"op":"image","layer":257,"image":"i13782"},{"op":"text","speaker":"静久","text":"“怎么啦？”"},{"op":"image","layer":1,"image":"i14493"},{"op":"text","speaker":"紬","text":"“请静久抓住那边。”"},{"op":"clear","layer":257},{"op":"image","layer":257,"image":"i13847"},{"op":"text","speaker":"静久","text":"“好。”"},{"op":"text","speaker":"羽依里","text":"“为什么？”"},{"op":"image","layer":1,"image":"i14498"},{"op":"text","speaker":"紬","text":"“只有我一个人的力量，可能敌不过炒饭。”"},{"op":"image","layer":1,"image":"i14495"},{"op":"text","speaker":"紬","text":"“所以还需要静久的力量。”"},{"op":"image","layer":1,"image":"i14498"},{"op":"text","speaker":"紬","text":"“要是家里有棉花糖在等着我，我也会不知如何是好。”"},{"op":"image","layer":1,"image":"i14487"},{"op":"text","speaker":"紬","text":"“可能会抛下羽依里先生，投向棉花糖的怀抱。”"},{"op":"text","speaker":"羽依里","text":"“希望你能优先选择我。”"},{"op":"image","layer":257,"image":"i13738"},{"op":"text","speaker":"静久","text":"“话说回来，她竟然把你和棉花糖来比。”"},{"op":"image","layer":257,"image":"i13744"},{"op":"text","speaker":"静久","text":"“看来你在她的心中，地位还挺高的嘛。”"},{"op":"image","layer":1,"image":"i14504"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“不用了，你们放开也没事的。”"},{"op":"text","speaker":"羽依里","text":"“至少你们俩在我的心中比炒饭地位高。”"},{"op":"text","speaker":"羽依里","text":"“紬和静久都比炒饭更重要，当然，要是快饿死的话就另当别论了。”"},{"op":"image","layer":1,"image":"i14410"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"紬","text":"“羽依里先生说我重要。”"},{"op":"image","layer":257,"image":"i13779"},{"op":"text","speaker":"静久","text":"“是啊，说我们俩都重要。”"},{"op":"image","layer":1,"image":"i14404"},{"op":"text","speaker":"紬","text":"“真是毫无节操的发言。”"},{"op":"text","speaker":"","text":"唉？"},{"op":"image","layer":257,"image":"i13825"},{"op":"text","speaker":"静久","text":"“他肯定跟班上同学都说过这种话。”"},{"op":"text","speaker":"","text":"慢着。"},{"op":"text","speaker":"","text":"我的班里只有男的。"},{"op":"image","layer":1,"image":"i14506"},{"op":"text","speaker":"紬","text":"“～～♪”"},{"op":"text","speaker":"羽依里","text":"“这不是你心情好的时候哼的吗？”"},{"op":"text","speaker":"紬","text":"“嗯～……是的。”"},{"op":"image","layer":1,"image":"i14473"},{"op":"text","speaker":"紬","text":"“虽然觉得你刚才的话很没节操，但我听了还是很开心。”"},{"op":"text","speaker":"羽依里","text":"“是吗。”"},{"op":"image","layer":257,"image":"i13740"},{"op":"text","speaker":"静久","text":"“～～♪”"},{"op":"text","speaker":"羽依里","text":"“你也是吗。”"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"静久","text":"“我也是哦。很开心♪”"},{"op":"image","layer":257,"image":"i13773"},{"op":"text","speaker":"静久","text":"“～～♪”"},{"op":"image","layer":1,"image":"i14489"},{"op":"text","speaker":"紬","text":"“哦～……真好听。”"},{"op":"image","layer":1,"image":"i14506"},{"op":"image","layer":257,"image":"i13770"},{"op":"text","speaker":"紬·静久","text":"“～～♪”"},{"op":"text","speaker":"羽依里","text":"“……～～♪”"},{"op":"image","layer":1,"image":"i14396"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"紬","text":"“姆啾？你也会唱呀。”"},{"op":"text","speaker":"羽依里","text":"“嗯，听了这么久，都记住了。”"},{"op":"image","layer":1,"image":"i14512"},{"op":"image","layer":257,"image":"i13773"},{"op":"text","speaker":"一同","text":"“～～♪”"},{"op":"text","speaker":"","text":"我们三人一起哼着小曲。"},{"op":"text","speaker":"","text":"虽然并没有找到想做的事。"},{"op":"text","speaker":"","text":"但我还是不禁觉得，这样子真不错。"},{"op":"text","speaker":"","text":"就是这么一段闲适的时光。"},{"op":"set","variable":10,"value":1},{"op":"goto","target":654},{"op":"image","layer":1,"image":"i14384"},{"op":"text","speaker":"紬","text":"“是啊。我也完全被炒饭占据大脑了。”"},{"op":"image","layer":1,"image":"i14381"},{"op":"text","speaker":"紬","text":"“现在脑子里只有吃炒饭一个念头。”"},{"op":"text","speaker":"羽依里","text":"“那再见。”"},{"op":"image","layer":257,"image":"i13740"},{"op":"text","speaker":"静久","text":"“嗯，再见。”"},{"op":"image","layer":1,"image":"i14473"},{"op":"text","speaker":"紬","text":"“炒饭见～”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"看来她的大脑真的被炒饭占据了。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"return"},{"op":"end"}]