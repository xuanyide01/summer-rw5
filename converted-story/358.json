[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i37"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“好热啊……”"},{"op":"text","speaker":"","text":"今天岛上的阳光也很是毒辣。"},{"op":"text","speaker":"","text":"然后……"},{"op":"image","layer":7,"image":"i12561"},{"op":"text","speaker":"识","text":"“嗯嘿嘿嘿――！”"},{"op":"text","speaker":"","text":"看到识好像笑嘻嘻地跑了过来。"},{"op":"text","speaker":"","text":"速度依旧十分惊人。"},{"op":"text","speaker":"羽依里","text":"“识――”"},{"op":"image","layer":1,"image":"i12559"},{"op":"text","speaker":"识","text":"“哎呀！羽依里！”"},{"op":"text","speaker":"","text":"她跑到我面前，精准地刹住了车。"},{"op":"text","speaker":"羽依里","text":"“你这家伙，大热天的还这么有精神啊。”"},{"op":"image","layer":1,"image":"i12449"},{"op":"text","speaker":"识","text":"“还行吧。”"},{"op":"text","speaker":"羽依里","text":"“在干什么呢？”"},{"op":"image","layer":1,"image":"i12453"},{"op":"text","speaker":"识","text":"“在逃命呢。”"},{"op":"text","speaker":"羽依里","text":"“逃命？”"},{"op":"if","truth":false,"target":25,"value":["==",["v",436],1]},{"op":"text","speaker":"","text":"该不会又偷捕了吧？"},{"op":"goto","target":25},{"op":"text","speaker":"","text":"识回头看了看。"},{"op":"image","layer":1,"image":"i12490"},{"op":"text","speaker":"识","text":"“看来他们追过来了。”"},{"op":"text","speaker":"","text":"只见几个经常在岛上见到的小朋友气喘吁吁地跑了过来。"},{"op":"text","speaker":"岛上的男孩A","text":"“终、终于……追上了……哈啊……”"},{"op":"text","speaker":"岛上的男孩B","text":"“姐姐你跑得……也太快了吧……”"},{"op":"text","speaker":"岛上的男孩C","text":"“居然动真格……哈啊……太狡猾了……”"},{"op":"text","speaker":"羽依里","text":"“你们在干什么呢？”"},{"op":"image","layer":1,"image":"i12453"},{"op":"text","speaker":"识","text":"“玩捉鬼游戏呢。”"},{"op":"text","speaker":"羽依里","text":"“捉鬼游戏？”"},{"op":"image","layer":1,"image":"i12620"},{"op":"text","speaker":"","text":"识转身面向孩子们。"},{"op":"image","layer":1,"image":"i12602"},{"op":"text","speaker":"识","text":"“怎么样？现在明白了吧？”"},{"op":"image","layer":1,"image":"i12605"},{"op":"text","speaker":"识","text":"“想跟我玩捉鬼游戏还早一百年呢！”"},{"op":"text","speaker":"岛上的男孩A","text":"“可恶――难道姐姐真的是鬼吗。”"},{"op":"text","speaker":"岛上的男孩B","text":"“还以为是骗人的呢……”"},{"op":"text","speaker":"岛上的男孩C","text":"“鬼姐姐，好厉害呀。”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"羽依里","text":"“……识……你还对小孩子说那种话……”"},{"op":"image","layer":1,"image":"i12466"},{"op":"text","speaker":"识","text":"“羽、羽依里!؟你的眼神是怎么回事……!؟”"},{"op":"image","layer":1,"image":"i12472"},{"op":"text","speaker":"识","text":"“不要……快停下来……！”"},{"op":"image","layer":1,"image":"i12469"},{"op":"text","speaker":"识","text":"“又用那种温柔的眼神看着我……呜哎……呜哎哎哎哎哎哎――――――！”"},{"op":"text","speaker":"岛上的男孩A","text":"“喂，大哥哥，可别欺负女孩子啊。”"},{"op":"text","speaker":"岛上的男孩B","text":"“太差劲了，大哥哥。”"},{"op":"text","speaker":"岛上的男孩C","text":"“大哥哥，你肯定没人喜欢吧。”"},{"op":"text","speaker":"羽依里","text":"“喂，你们几个……说话给我注意点。”"},{"op":"text","speaker":"羽依里","text":"“不然我可要哭了。”"},{"op":"text","speaker":"","text":"孩子们毫不客气地挥舞着言语的大刀。"},{"op":"text","speaker":"","text":"突然，我感觉有点不对劲。"},{"op":"text","speaker":"羽依里","text":"“你们说是玩捉鬼游戏，但难道有三个鬼吗？”"},{"op":"text","speaker":"","text":"仔细想想，刚才只有识一个人在逃跑。"},{"op":"image","layer":1,"image":"i12511"},{"op":"text","speaker":"识","text":"“喂喂，鬼可是我哦？”"},{"op":"text","speaker":"羽依里","text":"“我也感觉得是这样……？”"},{"op":"image","layer":1,"image":"i12535"},{"op":"text","speaker":"岛上的男孩B","text":"“我们的设定是人类想要制裁鬼，于是就追着鬼把它赶走。”"},{"op":"text","speaker":"羽依里","text":"“这是什么黑暗系捉鬼游戏啊。”"},{"op":"text","speaker":"岛上的男孩C","text":"“反向捉鬼游戏。是这个姐姐想出来的哦。”"},{"op":"text","speaker":"羽依里","text":"“识想出来的？”"},{"op":"image","layer":1,"image":"i12514"},{"op":"text","speaker":"识","text":"“哼哼，是从桃太郎的故事得到的灵感哦。”"},{"op":"text","speaker":"羽依里","text":"“……啊～”"},{"op":"text","speaker":"","text":"就是倒转过来视角，鬼岛上的鬼被桃太郎一行人追着跑这种感觉的桃太郎嘛。"},{"op":"text","speaker":"岛上的男孩A","text":"“不过姐姐，你跑得好快啊！”"},{"op":"text","speaker":"岛上的男孩B","text":"“嗯！完全追不上！”"},{"op":"text","speaker":"岛上的男孩C","text":"“果然，姐姐可能真的是鬼！”"},{"op":"image","layer":1,"image":"i12449"},{"op":"text","speaker":"识","text":"“哼，看来你们终于明白了呢！”"},{"op":"image","layer":1,"image":"i12456"},{"op":"text","speaker":"识","text":"“我可是如假包换的鬼哦！”"},{"op":"text","speaker":"","text":"孩子们“哦――！”地欢呼叫喊着，还给识一通鼓掌。"},{"op":"text","speaker":"","text":"她绝对是被耍着玩的那方吧。"},{"op":"text","speaker":"","text":"尽管如此，识还是一脸得意，看起来十分开心。"},{"op":"text","speaker":"羽依里","text":"“识……太好了呢。”"},{"op":"image","layer":1,"image":"i12478"},{"op":"text","speaker":"识","text":"“又、又是那种温柔的眼神!!”"},{"op":"text","speaker":"岛上的男孩A","text":"“不要吵架啊。”"},{"op":"text","speaker":"岛上的男孩B","text":"“大哥哥要不要来一起玩捉鬼？”"},{"op":"text","speaker":"羽依里","text":"“喂喂，跟小孩子玩捉鬼什么的……”"},{"op":"text","speaker":"岛上的男孩C","text":"“这可是和女孩子一起玩的好机会哦？”"},{"op":"text","speaker":"羽依里","text":"“女孩子？”"},{"op":"image","layer":1,"image":"i12463"},{"op":"text","speaker":"","text":"我看了看识。"},{"op":"text","speaker":"羽依里","text":"“嗯……不过那可是识啊。”"},{"op":"image","layer":1,"image":"i12482"},{"op":"text","speaker":"识","text":"“你这是什么意思啊？”"},{"op":"text","speaker":"羽依里","text":"“跟小朋友也没什么两样。”"},{"op":"image","layer":1,"image":"i12519"},{"op":"text","speaker":"识","text":"“太失礼了，我可是大人了哦。”"},{"op":"text","speaker":"羽依里","text":"“好好好，十四岁十四岁。”"},{"op":"image","layer":1,"image":"i12517"},{"op":"text","speaker":"识","text":"“……十分不解……”"},{"op":"text","speaker":"岛上的男孩A","text":"“来嘛，一起玩吧大哥哥。”"},{"op":"text","speaker":"岛上的男孩B","text":"“反正你也很闲吧？”"},{"op":"text","speaker":"岛上的男孩C","text":"“我们陪你玩，就加入我们吧。”"},{"op":"text","speaker":"","text":"这些小孩子们倒是装得挺老成的啊喂。"},{"op":"text","speaker":"羽依里","text":"“行吧，那我就陪你们玩一会儿。”"},{"op":"text","speaker":"羽依里","text":"“规则就按普通的捉鬼来可以吗？”"},{"op":"text","speaker":"","text":"四个男生追着一个女孩子跑的画面，看起来可不太健全。"},{"op":"text","speaker":"岛上的男孩A","text":"“可以，不过大哥哥是中途加入的，所以你来当鬼。”"},{"op":"text","speaker":"岛上的男孩B","text":"“等我们跑走以后，数到十就可以来追了。”"},{"op":"text","speaker":"岛上的男孩C","text":"“变成鬼的人要在原地数到十才能追人。”"},{"op":"text","speaker":"羽依里","text":"“OK。”"},{"op":"image","layer":1,"image":"i12453"},{"op":"text","speaker":"识","text":"“我不会输的，羽依里！”"},{"op":"text","speaker":"羽依里","text":"“你怎么这么来劲啊……”"},{"op":"text","speaker":"羽依里","text":"“那我说开始就开始了啊，开始！”"},{"op":"text","speaker":"羽依里","text":"“一、二、三、四、五。”"},{"op":"text","speaker":"岛上的男孩A","text":"“哇，耍赖！”"},{"op":"text","speaker":"岛上的男孩B","text":"“这大哥哥太狡猾了！”"},{"op":"text","speaker":"岛上的男孩C","text":"“糟了！快逃！”"},{"op":"text","speaker":"","text":"孩子们边喊边四散逃去。"},{"op":"text","speaker":"羽依里","text":"“六、七、八、九、十！”"},{"op":"text","speaker":"羽依里","text":"“比赛哪有什么狡不狡猾的！”"},{"op":"text","speaker":"羽依里","text":"“来吧，小孩子们！让你们见识见识社会的残酷！”"},{"op":"text","speaker":"","text":"说是这么说，但也不会做出一上来就抓小孩子这种不成熟的事。"},{"op":"text","speaker":"","text":"我的目标是识。"},{"op":"text","speaker":"","text":"但是――……"},{"op":"image","layer":1,"image":"i12558"},{"op":"text","speaker":"识","text":"“噗哈哈哈哈！想抓到我的话就尽管试试看吧！”"},{"op":"text","speaker":"","text":"自称是大人的十四岁鬼以惊人的速度逃跑了。"},{"op":"text","speaker":"羽依里","text":"“好快……”"},{"op":"text","speaker":"","text":"五十米六秒级的速度，根本就追不上啊……"},{"op":"text","speaker":"羽依里","text":"“……没办法。”"},{"op":"text","speaker":"","text":"要是盯着识不放，这鬼我就要永远当下去了。"},{"op":"text","speaker":"","text":"于是转而瞄上了小孩。"},{"op":"text","speaker":"岛上的男孩A","text":"“哇，他朝这边来了！”"},{"op":"text","speaker":"羽依里","text":"“哈哈哈！碰到你了！”"},{"op":"text","speaker":"岛上的男孩A","text":"“啊――！被抓到了――！”"},{"op":"text","speaker":"羽依里","text":"“好，换人当鬼了！”"},{"op":"text","speaker":"岛上的男孩A","text":"“专挑小孩子下手也太卑鄙了，大哥哥。”"},{"op":"text","speaker":"羽依里","text":"“玩捉鬼可不分大人还是小孩。”"},{"op":"text","speaker":"羽依里","text":"“只分是鬼和不是鬼的存在――”"},{"op":"text","speaker":"岛上的男孩A","text":"“一二三四五六七八九十！”"},{"op":"text","speaker":"羽依里","text":"“啊，耍赖！”"},{"op":"text","speaker":"","text":"慌忙开始逃跑。"},{"op":"text","speaker":"岛上的男孩A","text":"“好――这次一定要抓到姐姐！”"},{"op":"image","layer":1,"image":"i12562"},{"op":"text","speaker":"识","text":"“哈哈哈哈！想抓到我这个鬼的话就尽管试试看吧！”"},{"op":"text","speaker":"岛上的男孩A","text":"“鬼是我啊姐姐！”"},{"op":"text","speaker":"","text":"小孩子全力追赶着识。"},{"op":"text","speaker":"","text":"但是，两人之间的距离不仅没有缩短，反而越拉越大。"},{"op":"text","speaker":"羽依里","text":"“她居然对小孩子认真起来了……”"},{"op":"text","speaker":"","text":"最后连她的身影都消失不见了。"},{"op":"text","speaker":"羽依里","text":"“她到底要跑到哪里去啊？”"},{"op":"text","speaker":"岛上的男孩A","text":"“哈啊，哈啊……可恶！果然太快了！”"},{"op":"text","speaker":"岛上的男孩A","text":"“这样的话就不追姐姐了，改追大哥哥吧……！”"},{"op":"text","speaker":"羽依里","text":"“喂喂，也太小看人了吧。”"},{"op":"text","speaker":"","text":"为了甩开追来的小孩子，我也全力奔跑起来。"},{"op":"text","speaker":"岛上的男孩A","text":"“哇，大哥哥也跑得挺快的嘛！”"},{"op":"text","speaker":"羽依里","text":"“哈哈哈！你以为小孩子能跟大人抗衡吗！”"},{"op":"text","speaker":"岛上的男孩A","text":"“大哥哥你不也还是个孩子吗！”"},{"op":"text","speaker":"岛上的男孩B","text":"“好！那我们三个一起包围他吧！”"},{"op":"text","speaker":"岛上的男孩C","text":"“抄近路把大哥哥抓住！”"},{"op":"text","speaker":"羽依里","text":"“哦，这招不错啊。”"},{"op":"text","speaker":"","text":"突然改变规则这种事，在小孩子的游戏中很常见。"},{"op":"text","speaker":"岛上的男孩B","text":"“他往那边去了！”"},{"op":"text","speaker":"岛上的男孩C","text":"“此路可不通哦，大哥哥！”"},{"op":"text","speaker":"羽依里","text":"“那我就反其道而行之――”"},{"op":"text","speaker":"岛上的男孩A","text":"“碰到了！成功了！”"},{"op":"text","speaker":"羽依里","text":"“哇――被抓到了――”"},{"op":"text","speaker":"","text":"我得让着点小孩子们。"},{"op":"text","speaker":"","text":"这也是身为大人的一种从容。"},{"op":"text","speaker":"岛上的男孩A","text":"“这就是智慧的胜利啊，大哥哥！”"},{"op":"text","speaker":"岛上的男孩B","text":"“太好骗了，大哥哥！”"},{"op":"text","speaker":"岛上的男孩C","text":"“大哥哥肯定没人喜欢！”"},{"op":"text","speaker":"羽依里","text":"“喂，最后那句！你只是在骂我而已吧！”"},{"op":"text","speaker":"岛上的男孩A","text":"“这下又轮到哥哥当鬼了！”"},{"op":"text","speaker":"岛上的男孩B","text":"“快点逃吧！这个大哥哥是会耍赖的！”"},{"op":"text","speaker":"羽依里","text":"“我才不会用同样的招数呢。”"},{"op":"text","speaker":"","text":"孩子们四散逃开了。"},{"op":"text","speaker":"","text":"与此同时，识也回来了。"},{"op":"image","layer":1,"image":"i12463"},{"op":"text","speaker":"识","text":"“咦？羽依里你还在当鬼啊？”"},{"op":"text","speaker":"羽依里","text":"“你别跑到连状况都搞不清的地方去啊……”"},{"op":"image","layer":1,"image":"i12501"},{"op":"text","speaker":"识","text":"“一不小心就认真起来了呢。”"},{"op":"image","layer":1,"image":"i12463"},{"op":"text","speaker":"识","text":"“那，你就这么当鬼下去真的好吗？”"},{"op":"text","speaker":"","text":"我突然想到了个坏主意。"},{"op":"text","speaker":"羽依里","text":"“不，不是我当鬼。”"},{"op":"image","layer":1,"image":"i12496"},{"op":"text","speaker":"识","text":"“是吗？那是谁在――”"},{"op":"text","speaker":"羽依里","text":"“一、二、三、四、五、六。”"},{"op":"image","layer":1,"image":"i12463"},{"op":"text","speaker":"识","text":"“嗯？”"},{"op":"text","speaker":"羽依里","text":"“七、八、九、十。我碰。”"},{"op":"image","layer":1,"image":"i12466"},{"op":"text","speaker":"识","text":"“呜哎？”"},{"op":"text","speaker":"羽依里","text":"“抱歉啊，其实我才是鬼。”"},{"op":"text","speaker":"","text":"我朝着逃跑的孩子们喊道。"},{"op":"text","speaker":"羽依里","text":"“喂――下一个轮到识当鬼哦――！”"},{"op":"image","layer":1,"image":"i12496"},{"op":"text","speaker":"识","text":"“……我要……当鬼？”"},{"op":"text","speaker":"羽依里","text":"“对啊，因为你被我碰到了。下一个鬼就是你了。”"},{"op":"text","speaker":"岛上的男孩A","text":"“真是坏啊，大哥哥……”"},{"op":"text","speaker":"岛上的男孩B","text":"“碰女孩子算性骚扰的哦，大哥哥……”"},{"op":"text","speaker":"岛上的男孩C","text":"“绝对没人会喜欢的，大哥哥……”"},{"op":"text","speaker":"羽依里","text":"“所以说最后那句！你只是在骂我而已吧！”"},{"op":"image","layer":1,"image":"i12484"},{"op":"text","speaker":"识","text":"“…………”"},{"op":"text","speaker":"羽依里","text":"“那个……咦？识？”"},{"op":"text","speaker":"羽依里","text":"“刚才那样是不是有点耍赖了……？”"},{"op":"text","speaker":"识","text":"“…………”"},{"op":"image","layer":1,"image":"i12463"},{"op":"text","speaker":"识","text":"“……羽依里。”"},{"op":"image","layer":1,"image":"i12496"},{"op":"text","speaker":"识","text":"“我……真的当上鬼了吗？”"},{"op":"text","speaker":"羽依里","text":"“咦？”"},{"op":"text","speaker":"岛上的男孩A","text":"“我理解你的心情，姐姐。”"},{"op":"text","speaker":"岛上的男孩B","text":"“虽然大哥哥很卑鄙，但规则就是规则。”"},{"op":"text","speaker":"岛上的男孩C","text":"“姐姐就是鬼了哦。”"},{"op":"image","layer":1,"image":"i12484"},{"op":"text","speaker":"识","text":"“我是，鬼……”"},{"op":"image","layer":1,"image":"i12582"},{"op":"text","speaker":"识","text":"“原来如此……我是鬼啊……嗯嘿嘿。”"},{"op":"image","layer":1,"image":"i12580"},{"op":"text","speaker":"识","text":"“羽依里……他们叫我鬼了呢。”"},{"op":"text","speaker":"羽依里","text":"“啊，喔……？”"},{"op":"image","layer":1,"image":"i12583"},{"op":"text","speaker":"识","text":"“我是鬼……鬼……鬼！”"},{"op":"text","speaker":"","text":"识浑身颤抖着，仿佛心中的喜悦要爆发出来一般，举起了双拳。"},{"op":"image","layer":1,"image":"i12453"},{"op":"text","speaker":"识","text":"“好――！我就是鬼！”"},{"op":"image","layer":1,"image":"i12456"},{"op":"text","speaker":"识","text":"“这次轮到我来抓大家了――！”"},{"op":"text","speaker":"","text":"她突然间就打起了精神。"},{"op":"text","speaker":"","text":"而且，看起来超级开心。"},{"op":"image","layer":1,"image":"i12453"},{"op":"text","speaker":"识","text":"“二四六八十！”"},{"op":"text","speaker":"岛上的男孩A","text":"“那是什么数法啊!؟”"},{"op":"text","speaker":"岛上的男孩B","text":"“这姐姐也很狡猾！”"},{"op":"image","layer":1,"image":"i12456"},{"op":"text","speaker":"识","text":"“快跑啊，不然鬼要抓到你们了！”"},{"op":"text","speaker":"岛上的男孩A","text":"“鬼姐姐来了！”"},{"op":"text","speaker":"岛上的男孩B","text":"“大家快逃！”"},{"op":"text","speaker":"岛上的男孩C","text":"“鬼在这边――！”"},{"op":"image","layer":1,"image":"i12558"},{"op":"text","speaker":"识","text":"“噗――哈――哈――哈――！”"},{"op":"text","speaker":"","text":"那笑容灿烂极了。"},{"op":"text","speaker":"","text":"而且跑得特别快。"},{"op":"text","speaker":"","text":"某种意义上……很可怕。"},{"op":"text","speaker":"岛上的男孩A","text":"“哇，果然好快啊!؟”"},{"op":"text","speaker":"岛上的男孩B","text":"“鬼姐姐，太厉害了！”"},{"op":"text","speaker":"岛上的男孩C","text":"“我想到个好主意！拿大哥哥当诱饵，我们趁机逃跑！”"},{"op":"text","speaker":"羽依里","text":"“你们给我差不多一点！”"},{"op":"text","speaker":"","text":"说着这些的时候，满脸笑容的识正以惊人的速度逼近了过来。"},{"op":"image","layer":1,"image":"i12511"},{"op":"text","speaker":"识","text":"“看招！碰到你了！”"},{"op":"text","speaker":"岛上的男孩B","text":"“啊――可恶――！”"},{"op":"text","speaker":"","text":"一个小孩子被抓到了。"},{"op":"text","speaker":"","text":"这样，接下来就是那个孩子当鬼――"},{"op":"image","layer":1,"image":"i12515"},{"op":"text","speaker":"识","text":"“还没完呢！”"},{"op":"text","speaker":"岛上的男孩B","text":"“哎……”"},{"op":"image","layer":7,"image":"i12558"},{"op":"text","speaker":"识","text":"“快快快！再不跑我就要把你们全部抓住了！”"},{"op":"text","speaker":"岛上的男孩A","text":"“等下，姐姐你已经不是鬼了吧！”"},{"op":"image","layer":7,"image":"i12452"},{"op":"text","speaker":"识","text":"“不！我就是鬼！除非抓住所有人，不然我一直都是鬼！”"},{"op":"text","speaker":"岛上的男孩C","text":"“全、全灭型的鬼!؟”"},{"op":"text","speaker":"羽依里","text":"“好，快逃啊，你们几个！”"},{"op":"clear","layer":65281},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i513"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"又突然改变了规则。"},{"op":"text","speaker":"","text":"不过，立即接受新规则并乐在其中才是跟小孩子们玩游戏的精髓。"},{"op":"text","speaker":"羽依里","text":"“在抓住所有人之前，识都是鬼！”"},{"op":"text","speaker":"岛上的男孩A","text":"“明白了！”"},{"op":"text","speaker":"岛上的男孩C","text":"“那这次真的用大哥哥当诱饵――”"},{"op":"image","layer":7,"image":"i12455"},{"op":"text","speaker":"识","text":"“现在可不是闲聊的时候！”"},{"op":"text","speaker":"","text":"识看准了其中一个孩子。"},{"op":"text","speaker":"岛上的男孩C","text":"“啊！”"},{"op":"image","layer":7,"image":"i12561"},{"op":"text","speaker":"识","text":"“嘿！碰到你了！”"},{"op":"text","speaker":"岛上的男孩C","text":"“可恶――！被碰到了――！”"},{"op":"image","layer":7,"image":"i12558"},{"op":"text","speaker":"识","text":"“还剩两个！”"},{"op":"text","speaker":"","text":"识又盯上了第三个孩子。"},{"op":"image","layer":7,"image":"i12455"},{"op":"text","speaker":"识","text":"“嗯嘿……嗯嘿嘿嘿！”"},{"op":"text","speaker":"","text":"虽然识玩得开心是件好事……"},{"op":"text","speaker":"岛上的男孩A","text":"“姐姐，你的笑声好可怕啊――！”"},{"op":"text","speaker":"","text":"确实……"},{"op":"text","speaker":"","text":"虽然笑容是蛮好的……"},{"op":"image","layer":0,"image":"i37"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":7,"image":"i12448"},{"op":"text","speaker":"识","text":"“好！碰到你了！”"},{"op":"text","speaker":"岛上的男孩A","text":"“被――碰――到――了！”"},{"op":"image","layer":1,"image":"i12453"},{"op":"text","speaker":"识","text":"“现在只剩下羽依里你一个人了！”"},{"op":"image","layer":1,"image":"i12489"},{"op":"text","speaker":"羽依里","text":"“哼，你太天真了，识。”"},{"op":"text","speaker":"羽依里","text":"“至今为止被抓到的三个人，在四天王中也只是最弱的……”"},{"op":"text","speaker":"岛上的男孩A","text":"“大哥哥突然说起帅气的话来了！”"},{"op":"text","speaker":"岛上的男孩B","text":"“我们什么时候变成四天王了？”"},{"op":"text","speaker":"岛上的男孩C","text":"“我、我要当朱雀！”"},{"op":"text","speaker":"岛上的男孩A","text":"“那我是白虎――！”"},{"op":"text","speaker":"羽依里","text":"“那是什么啊？”"},{"op":"text","speaker":"岛上的男孩B","text":"“大哥哥！鬼要过去了！”"},{"op":"text","speaker":"羽依里","text":"“哎？”"},{"op":"image","layer":1,"image":"i12559"},{"op":"text","speaker":"识","text":"“噗哈哈哈！羽依里，你也速速认命向我投降吧！”"},{"op":"text","speaker":"羽依里","text":"“我可不会这么轻易就认输！”"},{"op":"text","speaker":"","text":"识的速度确实很快。"},{"op":"text","speaker":"","text":"但是她的动作过于单纯。"},{"op":"text","speaker":"","text":"就像是一头横冲直撞的野猪。"},{"op":"text","speaker":"","text":"虽然抓不到她，但可以躲开。"},{"op":"image","layer":1,"image":"i12457"},{"op":"text","speaker":"识","text":"“嘿！我要碰你了哦！”"},{"op":"text","speaker":"羽依里","text":"“没门！”"},{"op":"text","speaker":"","text":"就在识即将碰到我的瞬间，我猛地改变了前进方向。"},{"op":"image","layer":1,"image":"i12480"},{"op":"text","speaker":"识","text":"“啊!؟”"},{"op":"text","speaker":"羽依里","text":"“喂喂喂，怎么了？你还没有碰到我哦？”"},{"op":"image","layer":7,"image":"i12492"},{"op":"text","speaker":"识","text":"“唔……你很行嘛，羽依里！”"},{"op":"text","speaker":"","text":"识又追了上来。"},{"op":"image","layer":1,"image":"i12518"},{"op":"text","speaker":"识","text":"“这次一定！”"},{"op":"image","layer":1,"image":"i12519"},{"op":"text","speaker":"羽依里","text":"“你直线冲过来的话，就这样！”"},{"op":"text","speaker":"岛上的男孩A","text":"“又躲开了！”"},{"op":"image","layer":1,"image":"i12592"},{"op":"text","speaker":"识","text":"“这样总能行！”"},{"op":"image","layer":1,"image":"i12593"},{"op":"text","speaker":"羽依里","text":"“那样的话……就这样！”"},{"op":"text","speaker":"岛上的男孩B","text":"“好厉害！大哥哥在疯狂躲避！”"},{"op":"text","speaker":"岛上的男孩C","text":"“不愧是四天王中最强的！”"},{"op":"text","speaker":"","text":"在孩子们的加油声中，我一次又一次地闪躲开识的手。"},{"op":"text","speaker":"","text":"一直到体力耗尽为止……"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":1},{"op":"image","layer":2,"image":"i749"},{"op":"image","layer":0,"image":"i514"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"羽依里","text":"“呼……呼……”"},{"op":"image","layer":7,"image":"i12471"},{"op":"text","speaker":"识","text":"“哈……哈……哈……”"},{"op":"text","speaker":"","text":"累到筋疲力尽的我在路边坐了下来。"},{"op":"text","speaker":"","text":"至于识，她早已躺倒在了地上。"},{"op":"clear","layer":2},{"op":"image","layer":0,"image":"i38"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"岛上的男孩A","text":"“哎呀，玩得真开心！”"},{"op":"text","speaker":"岛上的男孩B","text":"“太好玩了！”"},{"op":"text","speaker":"岛上的男孩C","text":"“差不多到晚饭时间了，我们要回去了。”"},{"op":"text","speaker":"羽依里","text":"“哦，哦……那……回头见……”"},{"op":"image","layer":1,"image":"i12502"},{"op":"text","speaker":"识","text":"“下次……再一起玩……捉鬼……”"},{"op":"text","speaker":"岛上的男孩A","text":"“嗯，一言为定！”"},{"op":"text","speaker":"岛上的男孩B","text":"“再见了，大哥哥！”"},{"op":"text","speaker":"岛上的男孩C","text":"“姐姐也再见！”"},{"op":"text","speaker":"","text":"小孩子们跑着回去了。"},{"op":"text","speaker":"羽依里","text":"“不会吧……明明都跑了那么久……”"},{"op":"image","layer":1,"image":"i12499"},{"op":"text","speaker":"识","text":"“小孩子就是有活力呢……”"},{"op":"text","speaker":"羽依里","text":"“不……我觉得他们应该会在吃着饭的时候突然睡着……”"},{"op":"text","speaker":"","text":"不过今天的我也没资格说别人就是了。"},{"op":"image","layer":1,"image":"i12454"},{"op":"text","speaker":"识","text":"“呼……但是，和小孩子们一起玩果真很开心呢。”"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"image","layer":1,"image":"i12451"},{"op":"text","speaker":"识","text":"“看着他们天真无邪的笑容，连自己也变得有精神了。”"},{"op":"text","speaker":"羽依里","text":"“啊……也是啊。”"},{"op":"image","layer":1,"image":"i12491"},{"op":"text","speaker":"识","text":"“羽依里，我呀……”"},{"op":"image","layer":1,"image":"i12476"},{"op":"text","speaker":"识","text":"“想要把这些孩子们的笑容……一直守护下去。”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"image","layer":1,"image":"i12497"},{"op":"text","speaker":"识","text":"“怎么了？我又说了什么奇怪的话吗？”"},{"op":"text","speaker":"羽依里","text":"“没有……只是想你怎么突然说这么成熟的话。”"},{"op":"image","layer":1,"image":"i12515"},{"op":"text","speaker":"识","text":"“我不是说过吗？我可是个大人哦。”"},{"op":"text","speaker":"羽依里","text":"“不，你是个小孩子吧，14岁。”"},{"op":"image","layer":1,"image":"i12536"},{"op":"text","speaker":"识","text":"“要是放在过去，14岁可已经是正经的大人了哦？”"},{"op":"text","speaker":"羽依里","text":"“那得是什么年代的事啊。”"},{"op":"image","layer":1,"image":"i12454"},{"op":"text","speaker":"识","text":"“这是心态问题。”"},{"op":"image","layer":1,"image":"i12451"},{"op":"text","speaker":"识","text":"“无论什么年代，年纪小的孩子都是应该被保护的。”"},{"op":"image","layer":1,"image":"i12491"},{"op":"text","speaker":"识","text":"“大人的职责就是保护小孩子，对吧？”"},{"op":"image","layer":1,"image":"i12457"},{"op":"text","speaker":"识","text":"“所以我就是大人，不会有错哦。”"},{"op":"text","speaker":"羽依里","text":"“要是你算大人的话，那我岂不是老爷爷了。”"},{"op":"image","layer":1,"image":"i12499"},{"op":"text","speaker":"识","text":"“……那么这位老爷爷，我有一事相求。”"},{"op":"text","speaker":"羽依里","text":"“你说。”"},{"op":"image","layer":1,"image":"i12485"},{"op":"text","speaker":"识","text":"“我饿得动不了了……可否帮我带些吃的来……”"},{"op":"text","speaker":"羽依里","text":"“……陪孩子玩到筋疲力尽的大人啊……”"},{"op":"text","speaker":"","text":"不，要全力以赴陪孩子们玩。"},{"op":"text","speaker":"","text":"确实，这也算是一种大人的职责吧。"},{"op":"set","variable":439,"value":1},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]