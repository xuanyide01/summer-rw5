[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":7,"image":"i15467"},{"op":"text","speaker":"羽未","text":"“…………”"},{"op":"text","speaker":"羽依里","text":" “!؟” "},{"op":"image","layer":1,"image":"i15597"},{"op":"text","speaker":"羽未","text":"“那个……”"},{"op":"text","speaker":"","text":"看到我手上拿着的东西，羽未不禁后退一步。"},{"op":"image","layer":1,"image":"i15331"},{"op":"text","speaker":"羽未","text":"“……镜子阿姨――哥哥他不得了啦！”"},{"op":"text","speaker":"","text":"我都来不及阻止她，她已经跑去叫镜子阿姨了。"},{"op":"text","speaker":"","text":"唉，之后再解释吧。"},{"op":"text","speaker":"","text":"现在关键是行李箱。"},{"op":"return"},{"op":"end"}]