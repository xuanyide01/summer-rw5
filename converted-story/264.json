[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i21"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我来到了秘密基地。"},{"op":"text","speaker":"","text":"然后……"},{"op":"image","layer":772,"image":"i209"},{"op":"image","layer":1028,"image":"i12195"},{"op":"image","layer":1284,"image":"i25242"},{"op":"text","speaker":"良一","text":"“……”"},{"op":"text","speaker":"","text":"良一正拿着弹弓在瞄着什么。"},{"op":"clear","layer":772},{"op":"clear","layer":1028},{"op":"clear","layer":1284},{"op":"clear","layer":1791},{"op":"clear","layer":1279},{"op":"text","speaker":"","text":"我顺着他的视线望去……"},{"op":"image","layer":1540,"image":"i209"},{"op":"image","layer":1796,"image":"i15087"},{"op":"image","layer":2052,"image":"i25242"},{"op":"text","speaker":"天善","text":"“……”"},{"op":"text","speaker":"","text":"天善正拿着球拍摆好了架势。"},{"op":"clear","layer":1540},{"op":"clear","layer":1796},{"op":"clear","layer":2052},{"op":"clear","layer":2047},{"op":"clear","layer":1535},{"op":"image","layer":1,"image":"i12162"},{"op":"text","speaker":"良一","text":"“哟，是你啊。”"},{"op":"text","speaker":"羽依里","text":"“你们在这里干什么呢？”"},{"op":"image","layer":1,"image":"i12174"},{"op":"text","speaker":"良一","text":"“看看就知道了吧？”"},{"op":"text","speaker":"羽依里","text":"“不，完全没搞懂。”"},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“那你继续看就懂了。”"},{"op":"text","speaker":"","text":"说罢，良一就松开了弹弓。"},{"op":"text","speaker":"","text":"将乒乓球以极快的速度射了出去。"},{"op":"image","layer":1,"image":"i15102"},{"op":"text","speaker":"天善","text":"“哼！”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i21"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"然而天善极其简单地就把球打了回去。"},{"op":"image","layer":1,"image":"i12165"},{"op":"text","speaker":"良一","text":"“懂了吧？”"},{"op":"text","speaker":"羽依里","text":"“懂个头啊，这到底是在搞啥？”"},{"op":"image","layer":257,"image":"i15120"},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"天善","text":"“特训啊。”"},{"op":"text","speaker":"羽依里","text":"“特训指的是，乒乓球的？”"},{"op":"image","layer":257,"image":"i15078"},{"op":"text","speaker":"天善","text":"“除此之外还能有什么啊？”"},{"op":"text","speaker":"羽依里","text":"“不是，我从来没见过这么特训的啊？”"},{"op":"image","layer":1,"image":"i12141"},{"op":"text","speaker":"良一","text":"“城市里不做这种练习的吗？”"},{"op":"text","speaker":"羽依里","text":"“不会的啊，你们经常这么训练？”"},{"op":"image","layer":257,"image":"i15065"},{"op":"text","speaker":"天善","text":"“并不是，只有我这么练。”"},{"op":"image","layer":1,"image":"i12168"},{"op":"text","speaker":"良一","text":"“是这样的吗!؟”"},{"op":"text","speaker":"","text":"就连陪练的良一好像都不知道。"},{"op":"image","layer":257,"image":"i15096"},{"op":"text","speaker":"天善","text":"“这是我自创的练习动态视力和反射神经的方法。”"},{"op":"image","layer":1,"image":"i12171"},{"op":"text","speaker":"羽依里","text":"“管用吗？”"},{"op":"image","layer":257,"image":"i15086"},{"op":"text","speaker":"天善","text":"“不。那种程度的球速说实话不太能期待。”"},{"op":"image","layer":1,"image":"i12150"},{"op":"text","speaker":"良一","text":"“我这白帮你了啊……”"},{"op":"image","layer":257,"image":"i15082"},{"op":"text","speaker":"天善","text":"“不能再快点吗？”"},{"op":"image","layer":1,"image":"i12141"},{"op":"text","speaker":"良一","text":"“没办法的。用弹弓射的话那个速度已经是极限了。”"},{"op":"image","layer":257,"image":"i15072"},{"op":"text","speaker":"天善","text":"“是吗。有没有什么更好的训练方法呢……”"},{"op":"text","speaker":"","text":"让乒乓球球速达到刚才那个速度以上从物理上来说就不可能吧。"},{"op":"image","layer":1,"image":"i12174"},{"op":"text","speaker":"良一","text":"“我想到了一招！你们觉得这样的话如何？”"},{"op":"image","layer":1,"image":"i12162"},{"op":"text","speaker":"良一","text":"“天善朝着飞过去的乒乓球，一边用尽全力奔跑一边进行击打。”"},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“这样的话球速就显得更快了。”"},{"op":"image","layer":257,"image":"i15068"},{"op":"text","speaker":"天善","text":"“原来如此，想法倒是不错。”"},{"op":"image","layer":257,"image":"i15065"},{"op":"text","speaker":"天善","text":"“不过只是这样的话差别并不会很大。”"},{"op":"image","layer":1,"image":"i12171"},{"op":"text","speaker":"良一","text":"“那一边骑着自行车下坡一边打怎么样？”"},{"op":"image","layer":257,"image":"i15072"},{"op":"text","speaker":"天善","text":"“听起来是不错，不过哪有那么长的坡啊。”"},{"op":"image","layer":1,"image":"i12141"},{"op":"text","speaker":"良一","text":"“那就骑羽依里的摩托车打。”"},{"op":"text","speaker":"羽依里","text":"“啥!؟”"},{"op":"image","layer":257,"image":"i15084"},{"op":"text","speaker":"天善","text":"“原来如此，这个听起来不错啊。”"},{"op":"text","speaker":"羽依里","text":"“等会，那个摩托车是我借的啊……”"},{"op":"image","layer":257,"image":"i15075"},{"op":"text","speaker":"天善","text":"“拜托了……帮帮忙吧……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"天善竟然这么郑重地低下头来求我……"},{"op":"text","speaker":"羽依里","text":"“算了，行吧……”"},{"op":"image","layer":257,"image":"i15068"},{"op":"text","speaker":"天善","text":"“感激不尽。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"于是我回了趟家，然后骑着摩托车回到了秘密基地。"},{"op":"image","layer":0,"image":"i40"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":772,"image":"i228"},{"op":"image","layer":1028,"image":"i12191"},{"op":"image","layer":1284,"image":"i25242"},{"op":"text","speaker":"良一","text":"“天善，我这里随时都可以开始！”"},{"op":"text","speaker":"","text":"良一把乒乓球装上弹弓，摆好了姿势。"},{"op":"clear","layer":772},{"op":"clear","layer":1028},{"op":"clear","layer":1284},{"op":"clear","layer":1791},{"op":"clear","layer":1279},{"op":"image","layer":1540,"image":"i228"},{"op":"image","layer":1796,"image":"i15007"},{"op":"image","layer":2052,"image":"i25242"},{"op":"text","speaker":"","text":"然后在他前方的天善。"},{"op":"text","speaker":"","text":"正在远处骑上摩托，发动引擎。"},{"op":"clear","layer":1540},{"op":"clear","layer":1796},{"op":"clear","layer":2052},{"op":"clear","layer":2047},{"op":"clear","layer":1535},{"op":"text","speaker":"羽依里","text":"“你可别搞错了把球打到我伙计上。”"},{"op":"image","layer":772,"image":"i228"},{"op":"image","layer":1028,"image":"i12181"},{"op":"image","layer":1284,"image":"i25242"},{"op":"text","speaker":"良一","text":"“我知道啦！”"},{"op":"clear","layer":772},{"op":"clear","layer":1028},{"op":"clear","layer":1284},{"op":"clear","layer":1791},{"op":"clear","layer":1279},{"op":"image","layer":7,"image":"i15034"},{"op":"text","speaker":"天善","text":"“好，我要上了！”"},{"op":"image","layer":515,"image":"i18121"},{"op":"text","speaker":"","text":"引擎声越来越大，摩托车向我们的方向开了过来。"},{"op":"image","layer":1284,"image":"i25243"},{"op":"image","layer":1540,"image":"i25243"},{"op":"image","layer":772,"image":"i228"},{"op":"image","layer":1028,"image":"i15034"},{"op":"text","speaker":"天善","text":"“噢噢噢噢噢噢噢噢噢噢噢！”"},{"op":"text","speaker":"","text":"摩托车以最高速向我们冲了过来。"},{"op":"image","layer":772,"image":"i228"},{"op":"image","layer":1028,"image":"i15035"},{"op":"text","speaker":"天善","text":"“来吧！良一！”"},{"op":"image","layer":7,"image":"i12152"},{"op":"text","speaker":"良一","text":"“我来了！”"},{"op":"text","speaker":"","text":"嗖！"},{"op":"text","speaker":"","text":"乒乓球以极快的速度飞了出去。"},{"op":"image","layer":772,"image":"i228"},{"op":"image","layer":1028,"image":"i15014"},{"op":"text","speaker":"","text":"天善试图用球拍进行反击……然而。"},{"op":"image","layer":772,"image":"i228"},{"op":"image","layer":1028,"image":"i15026"},{"op":"text","speaker":"天善","text":"“我拿不了球拍了!؟”"},{"op":"text","speaker":"","text":"天善的右手正紧握着握把，实在是没法去拿球拍的。"},{"op":"image","layer":772,"image":"i228"},{"op":"image","layer":1028,"image":"i15027"},{"op":"text","speaker":"","text":"结果就是。"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":515},{"op":"clear","layer":1284},{"op":"clear","layer":1540},{"op":"clear","layer":772},{"op":"clear","layer":1028},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"set","variable":26027,"value":1},{"op":"image","layer":0,"image":"i40"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":7,"image":"i15034"},{"op":"text","speaker":"天善","text":"“呃啊!؟”"},{"op":"text","speaker":"","text":"乒乓球击中了天善的脸。"},{"op":"text","speaker":"","text":"然后他跟我的伙计一起，连人带车摔了个大跟头。"},{"op":"image","layer":7,"image":"i12167"},{"op":"text","speaker":"良一","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"……这事搞得有点大了。"},{"op":"text","speaker":"","text":"我们两人走到天善身边。"},{"op":"image","layer":1,"image":"i12150"},{"op":"text","speaker":"良一","text":"“喂，天善，还活着吗？”"},{"op":"image","layer":257,"image":"i15075"},{"op":"text","speaker":"天善","text":"“当，当然还活着……”"},{"op":"text","speaker":"","text":"天善摇摇晃晃地站了起来，然后慢慢地把摩托车扶了起来。"},{"op":"text","speaker":"羽依里","text":"“没受伤吧？”"},{"op":"image","layer":257,"image":"i15073"},{"op":"text","speaker":"天善","text":"“你觉得会吗？”"},{"op":"text","speaker":"羽依里","text":"“我觉得会。”"},{"op":"text","speaker":"","text":"毕竟出了那么大的事故。"},{"op":"image","layer":257,"image":"i15125"},{"op":"text","speaker":"天善","text":"“我没事。好了，继续吧。”"},{"op":"image","layer":1,"image":"i12168"},{"op":"text","speaker":"良一","text":"“你还想来啊!؟”"},{"op":"image","layer":257,"image":"i15120"},{"op":"image","layer":1,"image":"i12150"},{"op":"text","speaker":"天善","text":"“当然了。这种打不回去的球我已经好久没遇到了。”"},{"op":"text","speaker":"羽依里","text":"“不，你打不回去的原因不在这啊。”"},{"op":"text","speaker":"羽依里","text":"“问题是在手握球拍的情况下不能开车。”"},{"op":"image","layer":257,"image":"i15096"},{"op":"text","speaker":"天善","text":"“没问题。下次我为了能手那球拍，我会放开手进行驾驶的。”"},{"op":"text","speaker":"羽依里","text":"“不是，这样你连阀门都转不了怎么骑摩托啊……”"},{"op":"image","layer":257,"image":"i15078"},{"op":"text","speaker":"天善","text":"“唔……好吧……”"},{"op":"text","speaker":"羽依里","text":"“所以放弃吧。”"},{"op":"image","layer":257,"image":"i15065"},{"op":"text","speaker":"天善","text":"“不，这么做好了。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1540,"image":"i228"},{"op":"image","layer":1796,"image":"i15094"},{"op":"image","layer":2052,"image":"i25242"},{"op":"text","speaker":"天善","text":"“好了，来吧。”"},{"op":"text","speaker":"","text":"天善在我的背后说到。"},{"op":"clear","layer":1540},{"op":"clear","layer":1796},{"op":"clear","layer":2052},{"op":"clear","layer":2047},{"op":"clear","layer":1535},{"op":"text","speaker":"","text":"我现在双手握住握把，天善则是坐在我后面。"},{"op":"text","speaker":"","text":"为了能够集中精神打球，开车的事交给我了。"},{"op":"text","speaker":"羽依里","text":"“不论成败与否，这都是最后一次了啊？”"},{"op":"image","layer":1540,"image":"i228"},{"op":"image","layer":1796,"image":"i15121"},{"op":"image","layer":2052,"image":"i25242"},{"op":"text","speaker":"天善","text":"“我知道了。”"},{"op":"text","speaker":"羽依里","text":"“受伤的话我也不管啊？”"},{"op":"image","layer":1540,"image":"i228"},{"op":"image","layer":1796,"image":"i15097"},{"op":"text","speaker":"天善","text":"“呵……正合我意。”"},{"op":"text","speaker":"","text":"这种事可不是该期待的。"},{"op":"clear","layer":1540},{"op":"clear","layer":1796},{"op":"clear","layer":2052},{"op":"clear","layer":2047},{"op":"clear","layer":1535},{"op":"image","layer":772,"image":"i228"},{"op":"image","layer":1028,"image":"i12196"},{"op":"image","layer":1284,"image":"i25242"},{"op":"text","speaker":"","text":"我看到了良一在秘密基地附近正拉着弹弓。"},{"op":"clear","layer":772},{"op":"clear","layer":1028},{"op":"clear","layer":1284},{"op":"clear","layer":1791},{"op":"clear","layer":1279},{"op":"text","speaker":"羽依里","text":"“那我开车了？”"},{"op":"image","layer":1540,"image":"i228"},{"op":"image","layer":1796,"image":"i15090"},{"op":"image","layer":2052,"image":"i25242"},{"op":"text","speaker":"天善","text":"“包在你身上了。”"},{"op":"clear","layer":1540},{"op":"clear","layer":1796},{"op":"clear","layer":2052},{"op":"clear","layer":2047},{"op":"clear","layer":1535},{"op":"text","speaker":"","text":"我轻轻地转动了阀门。"},{"op":"image","layer":515,"image":"i18121"},{"op":"text","speaker":"","text":"我的伙计载着两个人向良一的方向飞奔了出去。"},{"op":"text","speaker":"羽依里","text":"“天善！差不多了！”"},{"op":"image","layer":7,"image":"i15119"},{"op":"text","speaker":"天善","text":"“我知道了！”"},{"op":"image","layer":772,"image":"i228"},{"op":"image","layer":1028,"image":"i12177"},{"op":"image","layer":1284,"image":"i25242"},{"op":"text","speaker":"","text":"良一用弹弓射出了乒乓球。"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":515},{"op":"clear","layer":772},{"op":"clear","layer":1028},{"op":"clear","layer":1284},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"clear","layer":1791},{"op":"clear","layer":1279},{"op":"clear","layer":515},{"op":"clear","layer":768},{"op":"image","layer":768,"image":"i736"},{"op":"clear","layer":1024},{"op":"image","layer":1024,"image":"i736"},{"op":"image","layer":0,"image":"i40"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“――！”"},{"op":"text","speaker":"","text":"然而球路向着横方向大范围歪了出去。"},{"op":"text","speaker":"","text":"正当我想用把手试图向那边转向之前――"},{"op":"clear","layer":515},{"op":"clear","layer":768},{"op":"clear","layer":1024},{"op":"text","speaker":"天善","text":"“――唔噢噢噢噢噢！”"},{"op":"text","speaker":"羽依里","text":"“哈！”"},{"op":"text","speaker":"","text":"天善朝着乒乓球的方向跳了出去。"},{"op":"text","speaker":"","text":"然后……"},{"op":"image","layer":7,"image":"i15079"},{"op":"text","speaker":"天善","text":"“噢噢噢噢噢噢――――……”"},{"op":"text","speaker":"","text":"就这么滑下了山崖。"},{"op":"text","speaker":"羽依里","text":"“天善!؟”"},{"op":"image","layer":1,"image":"i12168"},{"op":"text","speaker":"良一","text":"“喂！这怎么看都很糟吧？”"},{"op":"text","speaker":"","text":"正当我们向山崖下观察的时候。"},{"op":"text","speaker":"","text":"乒乓球飞了上来。"},{"op":"image","layer":1,"image":"i12174"},{"op":"text","speaker":"","text":"然后良一一下子将其收入手中。"},{"op":"image","layer":7,"image":"i15147"},{"op":"text","speaker":"天善","text":"‘……接到了吗？’"},{"op":"text","speaker":"","text":"山崖下面传来了声音。"},{"op":"image","layer":1,"image":"i12150"},{"op":"text","speaker":"良一","text":"“噢，噢。我接到了。”"},{"op":"text","speaker":"羽依里","text":"“他竟然打回来了吗……”"},{"op":"image","layer":7,"image":"i15132"},{"op":"text","speaker":"天善","text":"‘这个距离能打回去的话……看来我也许应该考虑下以削球为主的打法啊。’"},{"op":"text","speaker":"","text":"话说，这家伙为什么一脸没事的样子……"},{"op":"image","layer":1,"image":"i12147"},{"op":"text","speaker":"良一","text":"“虽然这家伙是很厉害……不过我已经感到恐惧了。”"},{"op":"text","speaker":"羽依里","text":"“我也是。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i513"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"这家伙难道真的只是为了乒乓球而生的吗……"},{"op":"text","speaker":"","text":"这种玩笑一般的疑问我却无法对其进行否定……"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"return"},{"op":"end"}]