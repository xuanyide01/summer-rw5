[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i55"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我无所事事，到蓄水池旁呆坐着。"},{"op":"text","speaker":"","text":"然后，有人过来了。"},{"op":"image","layer":1,"image":"i13166"},{"op":"if","truth":false,"target":11,"value":["==",["v",49],1]},{"op":"text","speaker":"","text":"是白羽。"},{"op":"text","speaker":"","text":"穿的还是校服。"},{"op":"goto","target":13},{"op":"text","speaker":"","text":"这不是白羽吗。"},{"op":"text","speaker":"","text":"她穿着校服，难道是去了学校……？"},{"op":"text","speaker":"","text":"她在干什么呢。"},{"op":"text","speaker":"","text":"手上拿着石块，朝水里像飞盘般投掷出去。"},{"op":"text","speaker":"","text":"哦，是打水漂啊。"},{"op":"text","speaker":"","text":"不知道她能跳几下？"},{"op":"image","layer":1,"image":"i13173"},{"op":"text","speaker":"","text":"……1跳。"},{"op":"text","speaker":"","text":"好弱。"},{"op":"image","layer":1,"image":"i13166"},{"op":"text","speaker":"","text":"她直接不玩了。"},{"op":"text","speaker":"","text":"然后又开始无所事事。"},{"op":"text","speaker":"","text":"看着就很闲。"},{"op":"text","speaker":"","text":"是不是跟她打个招呼比较好……"},{"op":"text","speaker":"","text":"接着，她又用手指比出个手枪。"},{"op":"text","speaker":"","text":"那个架势，我好像在哪见过。"},{"op":"image","layer":1,"image":"i13169"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"image","layer":1,"image":"i13181"},{"op":"text","speaker":"白羽","text":"“灵弹。”"},{"op":"text","speaker":"","text":"哇噢。"},{"op":"text","speaker":"","text":"在一边看着的我都不好意思了。"},{"op":"text","speaker":"","text":"一个人的时候，确实是会做这种事的。"},{"op":"text","speaker":"","text":"所以也没什么好害羞的。"},{"op":"text","speaker":"","text":"不过很抱歉，现在有我在这里。"},{"op":"image","layer":1,"image":"i13169"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"糟了。"},{"op":"text","speaker":"","text":"白羽又比出手枪，然后转身换了个方向……"},{"op":"text","speaker":"","text":"不要转到这边来，白羽。"},{"op":"text","speaker":"","text":"我可没信心给你打圆场。"},{"op":"image","layer":1,"image":"i13061"},{"op":"text","speaker":"","text":"可惜事不遂人愿，白羽一副得意的表情，比着手枪向我这边转过来。"},{"op":"image","layer":1,"image":"i13066"},{"op":"text","speaker":"白羽","text":"“灵……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"她总算发现了手指前方站着一个我。"},{"op":"image","layer":1,"image":"i13086"},{"op":"text","speaker":"白羽","text":"“……呃。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"她指向我的手势僵住了。"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"硬直了。"},{"op":"text","speaker":"","text":"我、我得圆一下场。"},{"op":"text","speaker":"羽依里","text":"“呜啊。”"},{"op":"text","speaker":"羽依里","text":"“被干掉了。”"},{"op":"image","layer":1,"image":"i13073"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"image","layer":1,"image":"i13120"},{"op":"text","speaker":"白羽","text":"“啊啊啊啊啊啊啊啊。”"},{"op":"text","speaker":"羽依里","text":"“抱歉。”"},{"op":"text","speaker":"羽依里","text":"“刚才那是我不好。”"},{"op":"image","layer":1,"image":"i13127"},{"op":"text","speaker":"白羽","text":"“灵……”"},{"op":"image","layer":1,"image":"i13146"},{"op":"text","speaker":"白羽","text":"“灵验灼然――”"},{"op":"text","speaker":"羽依里","text":"“呃？”"},{"op":"image","layer":1,"image":"i13137"},{"op":"text","speaker":"白羽","text":"“灵验灼然！”"},{"op":"text","speaker":"羽依里","text":"“什、什么？”"},{"op":"text","speaker":"","text":"她又开始胡言乱语了。"},{"op":"text","speaker":"","text":"是因为害羞过头变奇怪了吗。"},{"op":"image","layer":1,"image":"i13118"},{"op":"text","speaker":"白羽","text":"“就是有这么一种灵咒。”"},{"op":"image","layer":1,"image":"i13121"},{"op":"set","variable":30020,"value":90},{"op":"set","variable":26025,"value":1},{"op":"text","speaker":"白羽","text":"“这个灵咒在我们家或者这座岛上很常见的。我只是用这种灵咒向河川之神祈愿，这种事岛上的人都会做所以完全用不着害羞。你是从外面来的所以可能很稀奇，但在我们家或者这座岛上其实是很常见的。”"},{"op":"image","layer":1,"image":"i13137"},{"op":"text","speaker":"白羽","text":"“灵验灼然！”"},{"op":"text","speaker":"","text":"哇啊。"},{"op":"text","speaker":"","text":"她拼命地扯出毫无说服力的借口。"},{"op":"text","speaker":"","text":"接她的话吧。这才叫善良。"},{"op":"text","speaker":"羽依里","text":"“灵验做样！”"},{"op":"image","layer":1,"image":"i13059"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"image","layer":1,"image":"i13079"},{"op":"text","speaker":"白羽","text":"“不对。”"},{"op":"image","layer":1,"image":"i13094"},{"op":"text","speaker":"白羽","text":"“灵验灼然。”"},{"op":"text","speaker":"羽依里","text":"“灵验灼然。”"},{"op":"image","layer":1,"image":"i13084"},{"op":"text","speaker":"白羽","text":" “灵验灼然！” "},{"op":"text","speaker":"羽依里","text":" “灵验灼然！” "},{"op":"text","speaker":"","text":"……"},{"op":"image","layer":1,"image":"i13094"},{"op":"text","speaker":"白羽","text":"“哈啊，哈啊。”"},{"op":"text","speaker":"羽依里","text":"“哈啊，哈啊。”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"羽依里","text":"“我说。”"},{"op":"text","speaker":"羽依里","text":"“你喜欢看漫画吗？”"},{"op":"image","layer":1,"image":"i13118"},{"op":"text","speaker":"白羽","text":"“!؟”"},{"op":"image","layer":1,"image":"i13121"},{"op":"text","speaker":"白羽","text":"“啊啊啊啊啊啊啊啊啊啊。”"},{"op":"image","layer":1,"image":"i13174"},{"op":"text","speaker":"白羽","text":"“我喜欢看漫画……”"},{"op":"image","layer":1,"image":"i13199"},{"op":"text","speaker":"白羽","text":"“但是讨厌你！”"},{"op":"text","speaker":"","text":"她跑着逃走了。"},{"op":"text","speaker":"","text":"也用不着拿我来比较吧……"},{"op":"set","variable":413,"value":1},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]