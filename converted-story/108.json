[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11546"},{"op":"image","layer":257,"image":"i15450"},{"op":"text","speaker":"镜子","text":"“我吃饱了。”"},{"op":"text","speaker":"羽依里","text":"“我饱了，羽未。”"},{"op":"image","layer":1,"image":"i11581"},{"op":"text","speaker":"羽依里","text":"“今天的炒饭……呃，非常……好吃。”"},{"op":"image","layer":257,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“为什么突然那么礼貌？”"},{"op":"text","speaker":"羽依里","text":"“谨此表达对每天早上有现成饭吃的感谢及敬意。”"},{"op":"image","layer":257,"image":"i15357"},{"op":"text","speaker":"羽依里","text":"“镜子阿姨，仓库那边需要帮忙整理吗？”"},{"op":"image","layer":1,"image":"i11638"},{"op":"text","speaker":"镜子","text":"“今天还不用帮忙吧。”"},{"op":"text","speaker":"羽依里","text":"“知道了。”"},{"op":"text","speaker":"羽依里","text":"“那我稍微出去一下。”"},{"op":"image","layer":257,"image":"i15468"},{"op":"text","speaker":"羽未","text":"“现在就要出去？”"},{"op":"image","layer":1,"image":"i11578"},{"op":"text","speaker":"羽依里","text":"“嗯，要去小卖铺一趟。”"},{"op":"image","layer":257,"image":"i15589"},{"op":"text","speaker":"羽未","text":"“竟然是……小卖铺……！”"},{"op":"image","layer":257,"image":"i15558"},{"op":"text","speaker":"羽未","text":"“明明刚吃完我做的炒饭。”"},{"op":"image","layer":257,"image":"i15542"},{"op":"text","speaker":"羽未","text":"“这是对炒饭的亵渎！”"},{"op":"text","speaker":"羽依里","text":"“啊，误会误会，我不是去吃零食。”"},{"op":"text","speaker":"羽依里","text":"“是去和朋友谈点事情。”"},{"op":"return"},{"op":"end"}]