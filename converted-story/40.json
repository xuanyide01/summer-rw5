[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“早上好……”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“羽依里哥羽依里哥。”"},{"op":"text","speaker":"","text":"羽未一路小跑了过来。"},{"op":"text","speaker":"羽依里","text":"“怎…怎么了？”"},{"op":"image","layer":1,"image":"i15381"},{"op":"text","speaker":"羽未","text":"“快看，攒了好多积分呢。”"},{"op":"text","speaker":"","text":"眉飞色舞地给我看了盖着印章的卡片。"},{"op":"text","speaker":"羽依里","text":"“附近超市的积分卡？”"},{"op":"image","layer":1,"image":"i15401"},{"op":"text","speaker":"羽未","text":"“不是啦♪”"},{"op":"text","speaker":"","text":"心情愉悦呀。"},{"op":"image","layer":1,"image":"i15552"},{"op":"text","speaker":"羽未","text":"“是广播体操的积分。”"},{"op":"text","speaker":"羽依里","text":"“喔喔。”"},{"op":"text","speaker":"","text":"说来，广播体操好像是有这种模式？"},{"op":"text","speaker":"","text":"把挂在脖子上的卡片拿给现场负责人盖章。"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“明明羽依里哥也一起去就好了。”"},{"op":"text","speaker":"羽依里","text":"“唔…”"},{"op":"text","speaker":"羽依里","text":"“我还有我的规划。”"},{"op":"text","speaker":"羽依里","text":"“也不想被广播体操所束缚。”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“啊！”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“有个像你一样的人。”"},{"op":"image","layer":1,"image":"i15363"},{"op":"text","speaker":"羽未","text":"“半裸着…自顾自地在那里做操。”"},{"op":"text","speaker":"羽依里","text":"“是良一吧。”"},{"op":"text","speaker":"","text":"太显而易见了。"},{"op":"image","layer":1,"image":"i15408"},{"op":"text","speaker":"羽未","text":"“他说‘我有我的方式方法’。”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“做广播体操时，只要有一个人在做其他的事，就会非常地显眼。”"},{"op":"image","layer":1,"image":"i15363"},{"op":"text","speaker":"羽未","text":"“还有孩子会跟着学。”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“老实说，真的很烦呢。”"},{"op":"text","speaker":"羽依里","text":"“不过良一倒也没说错。”"},{"op":"text","speaker":"羽依里","text":"“每个人的体质都不一样。”"},{"op":"text","speaker":"羽依里","text":"“每个人都有适合自己的锻炼规划。”"},{"op":"text","speaker":"羽依里","text":"“广播体操的优点可能只有人数多而已。”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“啰嗦……”"},{"op":"text","speaker":"羽依里","text":"“刻薄……”"},{"op":"text","speaker":"羽依里","text":"“对了，攒了积分有什么好处吗？”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“有啊。”"},{"op":"image","layer":1,"image":"i15552"},{"op":"text","speaker":"羽未","text":"“攒齐15个的话，就能换一个大尺寸的特别印章。”"},{"op":"text","speaker":"羽依里","text":"“特别印章？”"},{"op":"image","layer":1,"image":"i15401"},{"op":"text","speaker":"羽未","text":"“只有认真出操的孩子才有资格获得的勋章。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“呵。”"},{"op":"image","layer":1,"image":"i15465"},{"op":"text","speaker":"羽未","text":"“你为什么要笑。”"},{"op":"text","speaker":"羽依里","text":"“没没没，真是值得开心呀。”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“嗯？感觉有点来气呢。”"},{"op":"return"},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“羽依里哥。”"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“差不多该去洗澡了，我还想收拾呢。”"},{"op":"text","speaker":"羽依里","text":"“抱歉，我好困……”"},{"op":"text","speaker":"","text":"我依旧趴在地上，站不起来。"},{"op":"text","speaker":"","text":"已经没有去洗澡的体力了。"},{"op":"text","speaker":"羽依里","text":"“我就这样在这里睡了……”"},{"op":"image","layer":1,"image":"i15331"},{"op":"text","speaker":"羽未","text":"“不行，会臭的。”"},{"op":"text","speaker":"羽依里","text":"“不会的不会的。”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“真是的。”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“你有那么累吗？”"},{"op":"text","speaker":"羽依里","text":"“……嗯，很累。”"},{"op":"image","layer":1,"image":"i15363"},{"op":"text","speaker":"羽未","text":"“真拿你没辙。”"},{"op":"text","speaker":"","text":"羽未绕到我的身后。"},{"op":"text","speaker":"羽依里","text":"“你…你要做什么。”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“慢慢吐气。”"},{"op":"text","speaker":"羽依里","text":"“……？”"},{"op":"text","speaker":"羽依里","text":"“哈……”"},{"op":"text","speaker":"","text":"揉捏。"},{"op":"text","speaker":"羽依里","text":"“噢！”"},{"op":"text","speaker":"羽依里","text":"“这是！”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“是按摩。”"},{"op":"text","speaker":"","text":"揉捏。"},{"op":"text","speaker":"羽依里","text":"“啊哼！”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“哇，好恶心！”"},{"op":"text","speaker":"羽依里","text":"“没办法呀，羽未按得太舒服了。”"},{"op":"image","layer":1,"image":"i15363"},{"op":"text","speaker":"羽未","text":"“那确实是没办法了。”"},{"op":"text","speaker":"","text":"揉捏。"},{"op":"text","speaker":"羽依里","text":"“啊哼！”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“……恶心……”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“你这怪声就不能憋住？”"},{"op":"text","speaker":"羽依里","text":"“因为真的很舒服嘛。”"},{"op":"image","layer":1,"image":"i15363"},{"op":"text","speaker":"羽未","text":"“那确实没办法。”"},{"op":"text","speaker":"羽依里","text":"“可以再用点力哦。”"},{"op":"image","layer":1,"image":"i15468"},{"op":"text","speaker":"羽未","text":"“是吗؟!”"},{"op":"image","layer":1,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“那我稍微踩踩咯。”"},{"op":"text","speaker":"羽依里","text":"“踩？”"},{"op":"text","speaker":"","text":"踩压。"},{"op":"text","speaker":"羽依里","text":"“!؟”"},{"op":"text","speaker":"","text":"这……"},{"op":"text","speaker":"","text":"踩压。"},{"op":"text","speaker":"","text":"何等……舒适……"},{"op":"text","speaker":"羽依里","text":"“呼嘛！”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“呜呃……好恶心……”"},{"op":"text","speaker":"羽依里","text":"“因为真的很舒服。”"},{"op":"text","speaker":"","text":"踩压。"},{"op":"text","speaker":"羽依里","text":"“呼嘛！”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“……恶心死人了……”"},{"op":"text","speaker":"","text":"虽然她发出了嫌弃的声音，但依旧继续为我按摩着。"},{"op":"text","speaker":"","text":"回过神来发现我已经睡着了。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i64"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“嗯……？”"},{"op":"text","speaker":"","text":"这里是……"},{"op":"text","speaker":"","text":"想起来了。"},{"op":"text","speaker":"","text":"羽未在客厅给我按摩来着。"},{"op":"text","speaker":"","text":"太过舒适结果就这样睡着了。"},{"op":"text","speaker":"","text":"灯已经关了，我的身上还盖着毛毯。"},{"op":"text","speaker":"羽未","text":"“呼…呼…”"},{"op":"text","speaker":"","text":"羽未就睡在一旁。"},{"op":"text","speaker":"","text":"我将盖在我身上的毯子盖在了她身上。"},{"op":"text","speaker":"","text":"然后就地躺下，听着羽未的呼吸声渐渐陷入沉睡。"},{"op":"clear","layer":2050},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"return"},{"op":"end"}]