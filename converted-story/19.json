[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“早……”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“早。”"},{"op":"text","speaker":"羽依里","text":"“今天的早饭……”"},{"op":"text","speaker":"","text":"空气中漂浮着令人胃口大开的香气。"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“是蟹肉炒饭。”"},{"op":"text","speaker":"羽依里","text":"“哦哦……”"},{"op":"text","speaker":"羽依里","text":"“我最喜欢螃蟹了”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“那真是太好了。”"},{"op":"text","speaker":"羽依里","text":"“但你从哪弄到的螃蟹……”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“港口那边的人给我的。”"},{"op":"text","speaker":"羽依里","text":"“这附近能抓到螃蟹吗？”"},{"op":"text","speaker":"","text":"而且螃蟹这么好的东西，是随随便便能拿到的吗。"},{"op":"text","speaker":"羽未","text":"“趁热快吃吧。”"},{"op":"text","speaker":"羽依里","text":"“嗯，我开动了。”"},{"op":"text","speaker":"","text":"我把羽未特制的蟹肉炒饭送入口中。"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"","text":"有些油腻。"},{"op":"text","speaker":"","text":"还有就是有一股螃蟹特有的强烈腥味……"},{"op":"text","speaker":"羽未","text":"“味道如何？”"},{"op":"text","speaker":"羽依里","text":"“很……，很好吃呢。”"},{"op":"image","layer":1,"image":"i15401"},{"op":"text","speaker":"羽未","text":"“哼哼。”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“还有很多，别客气尽管吃。”"},{"op":"text","speaker":"羽依里","text":"“嗯……嗯……”"},{"op":"text","speaker":"羽依里","text":"“羽未不吃吗？”"},{"op":"image","layer":1,"image":"i15347"},{"op":"text","speaker":"羽未","text":"“我做的时候就满足了。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“所以你全吃了也可以哦。”"},{"op":"text","speaker":"羽依里","text":"“我……我开动……了……”"},{"op":"text","speaker":"","text":"一言难尽……"},{"op":"text","speaker":"","text":"痛苦的早饭。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"text","speaker":"","text":"饭后，为了向镜子阿姨询问整理仓库的事，我去了仓库。"},{"op":"image","layer":0,"image":"i76"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“那个，镜子阿姨，关于帮忙整理的事情。”"},{"op":"image","layer":0,"image":"i1012"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"镜子","text":"“仓库这边还用不上你。”"},{"op":"return"},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“我回来了。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“你回来啦。”"},{"op":"text","speaker":"羽依里","text":"“嗯？嗅嗅……”"},{"op":"text","speaker":"羽依里","text":"“这味道是……”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“你闻到了啊？”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“又有人给我螃蟹啦。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“羽依里哥似乎很喜欢蟹肉炒饭的样子。”"},{"op":"text","speaker":"羽依里","text":"“哦……哦……”"},{"op":"image","layer":1,"image":"i15355"},{"op":"text","speaker":"羽未","text":"“原来如此，喜欢到我浑身颤抖呢。”"},{"op":"image","layer":1,"image":"i15408"},{"op":"text","speaker":"羽未","text":"“我会做满满一大碗的。”"},{"op":"text","speaker":"羽依里","text":"“哦……哦……”"},{"op":"text","speaker":"","text":"说不出NO是因为体贴，还是因为害怕呢……"},{"op":"text","speaker":"","text":"我只知道，这事一定对不起我自己。"},{"op":"if","truth":false,"target":116,"value":["==",["v",49],1]},{"op":"text","speaker":"羽依里","text":"“啊，对了。”"},{"op":"text","speaker":"羽依里","text":"“羽未。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“怎么了。”"},{"op":"text","speaker":"羽依里","text":"“那什么。”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":1795,"image":"i18201"},{"op":"set","variable":7120,"value":0},{"op":"image","layer":0,"image":"i239"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13210"},{"op":"text","speaker":"白羽","text":"‘最好不要和我扯上关系。’"},{"op":"clear","layer":1795},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“最好不要和我走的太近。”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“嗯，知道了。”"},{"op":"text","speaker":"","text":"毫无犹豫，点了点头。"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“饭做好的时候我会叫你。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“此外不会和你有交流。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"goto","target":116},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i170"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"晚饭是早饭惨剧的重现。"},{"op":"text","speaker":"","text":"而且，镜子阿姨还没吃就开溜了。"},{"op":"if","truth":false,"target":200,"value":["==",["v",6029],1]},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"由于没什么事情可做，我在客厅发呆。"},{"op":"image","layer":1,"image":"i15533"},{"op":"text","speaker":"羽未","text":"“羽依里哥，那个手环是……”"},{"op":"text","speaker":"羽依里","text":"“哎？啊，在小卖铺别人给的。”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“是吗，羽依里哥也打算参加了呀。”"},{"op":"text","speaker":"羽依里","text":"“羽未也戴着一样的手环呢。”"},{"op":"image","layer":1,"image":"i15401"},{"op":"text","speaker":"羽未","text":"“因为我是战士啊。”"},{"op":"text","speaker":"羽依里","text":"“什么战士？”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“难道你什么都不知道就踏上了这片战场吗？”"},{"op":"text","speaker":"羽依里","text":"“因为我想和羽未有更多话题。”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“我不会手下留情的！”"},{"op":"text","speaker":"羽依里","text":"“咦？怎么反而关系变险恶了？”"},{"op":"image","layer":1,"image":"i15355"},{"op":"text","speaker":"羽未","text":"“不过，痛扁一无所知的对手可能也有点过意不去。”"},{"op":"text","speaker":"羽依里","text":"“痛扁!؟”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“那个手环是‘岛可梦对决’的参加者证明。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“岛可梦对战是抓获栖息在这个岛上的岛可梦，驱使其对战的活动。”"},{"op":"text","speaker":"羽依里","text":"“类似于现实版的宝口梦？”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“是的。”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“在晚上事先放好饵，等到早上便能Get岛可梦。”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“要是你不介意，我可以把我的撒饵地图借给你哦？”"},{"op":"text","speaker":"羽依里","text":"“岛可梦对战啊…”"},{"op":"choice","variable":6001,"items":[{"text":"决定参加","value":0,"condition":1},{"text":"还是算了","value":1,"condition":1}]},{"op":"if","truth":false,"target":187,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“好，我也试试吧。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“可别死了哦。”"},{"op":"text","speaker":"羽依里","text":"“哎？会出人命的？”"},{"op":"text","speaker":"","text":"真危险啊。"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“我手里的饵也分给你一些。”"},{"op":"text","speaker":"羽依里","text":"“嗯，谢谢。”"},{"op":"set","variable":139,"value":1},{"op":"callScene","scene":2,"target":1320},{"op":"set","variable":344,"value":1},{"op":"if","truth":false,"target":185,"value":["native","エサを所持している"]},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“咦？刚才我好像给了你一件很不得了的东西……”"},{"op":"goto","target":201},{"op":"text","speaker":"羽依里","text":"“哈哈哈，怎么可能。哪有人用内裤当饵的。”"},{"op":"image","layer":1,"image":"i15552"},{"op":"text","speaker":"羽未","text":"“也是，一定是错觉。”"},{"op":"text","speaker":"羽依里","text":"“哈哈哈哈哈。”"},{"op":"image","layer":1,"image":"i15593"},{"op":"text","speaker":"羽未","text":"“啊哈哈哈哈。”"},{"op":"text","speaker":"羽依里","text":"（收、收到了很糟糕的饵呢……）"},{"op":"goto","target":185},{"op":"callScene","scene":278,"target":2},{"op":"goto","target":199},{"op":"if","truth":false,"target":199,"value":["==",["v",6001],1]},{"op":"text","speaker":"羽依里","text":"“想想还是算了吧。”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“是吗，我知道了。”"},{"op":"text","speaker":"羽依里","text":"“……你也不挽留我一下吗？”"},{"op":"image","layer":1,"image":"i15355"},{"op":"text","speaker":"羽未","text":"“我不希望没有干劲的人和岛可梦对战扯上关系。”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“因为岛可梦对战不是过家家游戏。”"},{"op":"text","speaker":"","text":"是认真的眼神。"},{"op":"set","variable":139,"value":0},{"op":"goto","target":199},{"op":"goto","target":200},{"op":"return"},{"op":"text","speaker":"羽依里","text":"“什么东西？”"},{"op":"image","layer":1,"image":"i15576"},{"op":"text","speaker":"羽未","text":"“……我的内裤……”"},{"op":"text","speaker":"羽依里","text":"“哈哈哈，怎么可能。哪有人用内裤当饵的。”"},{"op":"goto","target":178},{"op":"end"}]