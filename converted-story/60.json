[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":2,"image":"i743"},{"op":"image","layer":0,"image":"i513"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“呼……”"},{"op":"text","speaker":"羽依里","text":"“真是倒大霉了。”"},{"op":"text","speaker":"","text":"在那之后一整晚，辣劲一波又一波地过来，将我虐得体无完肤。"},{"op":"text","speaker":"","text":"都不记得惨叫了多少次。"},{"op":"text","speaker":"","text":"可能是感到很抱歉，羽未一直在走廊外面担心地看着我。"},{"op":"text","speaker":"","text":"反而让我也觉得不好意思了。"},{"op":"clear","layer":2},{"op":"image","layer":0,"image":"i28"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“呼。”"},{"op":"text","speaker":"","text":"一直睡到第二天中午，总算恢复到能出门了。"},{"op":"text","speaker":"羽依里","text":"“呼～～～”"},{"op":"text","speaker":"","text":"空气真是舒爽啊。"},{"op":"image","layer":1,"image":"i13163"},{"op":"text","speaker":"","text":"……啊。"},{"op":"text","speaker":"","text":"我察觉到一股视线，有人在看着我。"},{"op":"text","speaker":"","text":"是羽未在担心我吗。"},{"op":"text","speaker":"","text":"真是的。"},{"op":"text","speaker":"羽依里","text":"“我已经没事啦，羽未。”"},{"op":"text","speaker":"","text":"我用手臂朝着视线过来的方向秀了下肌肉。"},{"op":"text","speaker":"羽依里","text":"“精神十足呢。”"},{"op":"text","speaker":"羽依里","text":"“不过，拉出鲜红的大便时，真的吓了我一大跳。”"},{"op":"image","layer":1,"image":"i13176"},{"op":"text","speaker":"羽依里","text":"“不过仔细想想，那也不是便血而是辣椒的色素而已。”"},{"op":"text","speaker":"羽依里","text":"“连大便都带着辣椒味。啊哈哈。”"},{"op":"image","layer":1,"image":"i13179"},{"op":"text","speaker":"羽依里","text":"“还有，那大便……”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"羽依里","text":"“咦，哇啊!؟”"},{"op":"text","speaker":"","text":"白羽？"},{"op":"text","speaker":"","text":"为什么她会在这。"},{"op":"image","layer":1,"image":"i13163"},{"op":"text","speaker":"羽依里","text":"“等一下。”"},{"op":"image","layer":1,"image":"i13164"},{"op":"text","speaker":"","text":"我追上去。"},{"op":"text","speaker":"羽依里","text":"“你是担心我才来的吗？”"},{"op":"image","layer":1,"image":"i13124"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"image","layer":1,"image":"i13131"},{"op":"text","speaker":"白羽","text":"“出什么事了？”"},{"op":"text","speaker":"羽依里","text":"“啊!؟”"},{"op":"text","speaker":"羽依里","text":"“确实出了点事……”"},{"op":"text","speaker":"羽依里","text":"“呃，不过，也就是件鸡毛蒜皮的事而已。”"},{"op":"image","layer":1,"image":"i13115"},{"op":"text","speaker":"白羽","text":"“果然……”"},{"op":"image","layer":1,"image":"i13128"},{"op":"text","speaker":"白羽","text":"“听，听我说，再这样下去……”"},{"op":"text","speaker":"羽依里","text":"“比起这些。”"},{"op":"text","speaker":"羽依里","text":"“难得你过来一趟，先进屋来吧。”"},{"op":"image","layer":1,"image":"i13087"},{"op":"text","speaker":"白羽","text":"“唉？”"},{"op":"image","layer":1,"image":"i13201"},{"op":"text","speaker":"白羽","text":"“我不要。”"},{"op":"image","layer":1,"image":"i13167"},{"op":"text","speaker":"白羽","text":"“回去了。”"},{"op":"text","speaker":"羽依里","text":"“……唔。”"},{"op":"text","speaker":"羽依里","text":"“我回来了！带朋友来玩了哦！”"},{"op":"image","layer":1,"image":"i13121"},{"op":"text","speaker":"白羽","text":"“哎哎哎哎。等，等一下。”"},{"op":"image","layer":1,"image":"i13071"},{"op":"text","speaker":"白羽","text":"“你这样说，我要是直接走掉不就很失礼了。”"},{"op":"text","speaker":"羽依里","text":"“所以我才这么说的。”"},{"op":"image","layer":1,"image":"i13079"},{"op":"text","speaker":"白羽","text":"“呜呜，你算计我。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"if","truth":false,"target":78,"value":["==",["v",6003],1]},{"op":"callScene","scene":62,"target":2},{"op":"goto","target":327},{"op":"if","truth":false,"target":81,"value":["==",["v",6003],2]},{"op":"callScene","scene":61,"target":2},{"op":"goto","target":327},{"op":"image","layer":1,"image":"i15378"},{"op":"text","speaker":"羽未","text":"“呃!؟”"},{"op":"text","speaker":"羽依里","text":"“怎么了？”"},{"op":"image","layer":1,"image":"i15353"},{"op":"text","speaker":"羽未","text":"“居然带女人回来了。”"},{"op":"image","layer":257,"image":"i13124"},{"op":"text","speaker":"白羽","text":"“你好。”"},{"op":"image","layer":1,"image":"i15445"},{"op":"text","speaker":"羽未","text":"“……你好。”"},{"op":"text","speaker":"羽依里","text":"“害羞什么啊你？”"},{"op":"image","layer":1,"image":"i15560"},{"op":"text","speaker":"羽未","text":"“唉？”"},{"op":"text","speaker":"羽依里","text":"“脸都红透了。”"},{"op":"image","layer":1,"image":"i15573"},{"op":"text","speaker":"羽未","text":"“因为这姐姐好漂亮……”"},{"op":"image","layer":257,"image":"i13191"},{"op":"text","speaker":"白羽","text":"“唉？”"},{"op":"image","layer":257,"image":"i13196"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"这边也害羞了。"},{"op":"image","layer":1,"image":"i15450"},{"op":"text","speaker":"羽未","text":"“正好，我刚要准备午饭。”"},{"op":"image","layer":1,"image":"i15384"},{"op":"text","speaker":"羽未","text":"“那个，就请你在这吃吧。”"},{"op":"image","layer":257,"image":"i13131"},{"op":"text","speaker":"白羽","text":"“唉，可以吗？”"},{"op":"image","layer":1,"image":"i15397"},{"op":"text","speaker":"羽未","text":"“别客气别客气。”"},{"op":"image","layer":257,"image":"i13111"},{"op":"text","speaker":"白羽","text":"“谢谢。”"},{"op":"text","speaker":"羽依里","text":"“等一下。羽未，午饭不用你做。”"},{"op":"image","layer":1,"image":"i15357"},{"op":"image","layer":257,"image":"i13164"},{"op":"text","speaker":"羽未","text":"“为什么？”"},{"op":"text","speaker":"羽依里","text":"“这位姐姐很擅长做饭。难得来一次，就让她做吧。”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“可是哪有这样冷不丁麻烦客人来做饭的，太没有礼貌了。”"},{"op":"text","speaker":"羽依里","text":"“不用在意这些。”"},{"op":"text","speaker":"羽依里","text":"“毕、毕竟我们……是，朋友。”"},{"op":"image","layer":257,"image":"i13201"},{"op":"text","speaker":"白羽","text":"“……唉。”"},{"op":"image","layer":257,"image":"i13196"},{"op":"text","speaker":"白羽","text":"“……那个。”"},{"op":"text","speaker":"白羽","text":"“啊，嗯……算是吧。”"},{"op":"image","layer":1,"image":"i15560"},{"op":"text","speaker":"羽未","text":"“为什么说是朋友，你们要这么害羞啊？”"},{"op":"text","speaker":"羽依里","text":"“呃，不。”"},{"op":"image","layer":257,"image":"i13121"},{"op":"text","speaker":"白羽","text":"“才没有害羞。”"},{"op":"text","speaker":"羽依里","text":"“那么，可以请你做个饭吗？”"},{"op":"text","speaker":"羽依里","text":"“当然，前提是你不介意。”"},{"op":"image","layer":257,"image":"i13196"},{"op":"text","speaker":"白羽","text":"“没问题吗？让我这外人碰厨房。”"},{"op":"image","layer":1,"image":"i15450"},{"op":"text","speaker":"羽未","text":"“请吧。鹰原哥看来是已经吃腻我做的炒饭了。”"},{"op":"image","layer":1,"image":"i15412"},{"op":"text","speaker":"羽未","text":"“就请你给他做不一样的炒饭吧。”"},{"op":"image","layer":257,"image":"i13141"},{"op":"text","speaker":"白羽","text":"“想吃炒饭吗？”"},{"op":"text","speaker":"羽依里","text":"“我诚挚请求做炒饭以外的料理。”"},{"op":"image","layer":1,"image":"i15343"},{"op":"text","speaker":"羽未","text":"“什么!؟”"},{"op":"image","layer":257,"image":"i13170"},{"op":"text","speaker":"白羽","text":"“好的。我能打开冰箱看看吗？”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“请看请看。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i65"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13201"},{"op":"text","speaker":"白羽","text":"“材料有……”"},{"op":"text","speaker":"羽依里","text":"“要是不够的话，我可以去买。”"},{"op":"image","layer":1,"image":"i13068"},{"op":"text","speaker":"白羽","text":"“不用，看起来应该够了。”"},{"op":"image","layer":1,"image":"i13105"},{"op":"text","speaker":"白羽","text":"“我想想……冷面可以吧？”"},{"op":"text","speaker":"羽依里","text":"“没问题。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13141"},{"op":"text","speaker":"白羽","text":"“好了，请用。”"},{"op":"image","layer":257,"image":"i15325"},{"op":"text","speaker":"羽依里·羽未","text":"“那就不客气了！”“那就不客气了！”"},{"op":"image","layer":257,"image":"i15375"},{"op":"image","layer":1,"image":"i13124"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"羽依里","text":"“噢噢。”"},{"op":"image","layer":257,"image":"i15399"},{"op":"text","speaker":"羽未","text":"“这……”"},{"op":"image","layer":257,"image":"i15499"},{"op":"text","speaker":"羽依里·羽未","text":"“好吃！”“好好吃呀！”"},{"op":"image","layer":1,"image":"i13108"},{"op":"text","speaker":"白羽","text":"“谢、谢谢。”"},{"op":"text","speaker":"","text":"……"},{"op":"image","layer":1,"image":"i15415"},{"op":"text","speaker":"羽依里·羽未","text":"“再来一碗！”“再来一碗！”"},{"op":"image","layer":257,"image":"i13204"},{"op":"text","speaker":"白羽","text":"“我再去捞点。”"},{"op":"text","speaker":"羽依里","text":"“慢着慢着。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"image","layer":257,"image":"i13201"},{"op":"text","speaker":"羽依里","text":"“怎么就光我们自己吃了。”"},{"op":"text","speaker":"羽依里","text":"“还厚脸皮要再来。”"},{"op":"image","layer":1,"image":"i15573"},{"op":"text","speaker":"羽未","text":"“啊，对不起……因为太好吃忍不住就……”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“不过，鹰原哥你刚才不也说了要再来一碗！”"},{"op":"text","speaker":"羽依里","text":"“我、我有说吗？”"},{"op":"image","layer":257,"image":"i13183"},{"op":"text","speaker":"白羽","text":"“噗……”"},{"op":"image","layer":1,"image":"i15372"},{"op":"image","layer":257,"image":"i13170"},{"op":"text","speaker":"白羽","text":"“你们俩，是兄妹吗？”"},{"op":"image","layer":1,"image":"i15563"},{"op":"text","speaker":"羽依里·羽未","text":"“唉？”“唉？”"},{"op":"image","layer":1,"image":"i15589"},{"op":"text","speaker":"羽未","text":"“才才、才不是！”"},{"op":"image","layer":1,"image":"i15394"},{"op":"text","speaker":"羽未","text":"“你没听我一直喊他的姓氏吗？”"},{"op":"image","layer":257,"image":"i13151"},{"op":"text","speaker":"白羽","text":"“也、也对。对不起。”"},{"op":"image","layer":257,"image":"i13111"},{"op":"text","speaker":"白羽","text":"“那个，我就是觉得你们有点像。”"},{"op":"image","layer":1,"image":"i15560"},{"op":"text","speaker":"羽未","text":"“唉？”"},{"op":"image","layer":257,"image":"i13108"},{"op":"text","speaker":"白羽","text":"“啊，对不起。”"},{"op":"text","speaker":"羽依里","text":"“你干嘛道歉啊，这不就像说错话似的了。”"},{"op":"image","layer":1,"image":"i15485"},{"op":"text","speaker":"羽未","text":"“说我像鹰原哥……恕我不能苟同。”"},{"op":"image","layer":1,"image":"i15479"},{"op":"image","layer":257,"image":"i13124"},{"op":"text","speaker":"羽未","text":"“我可是一直以长得像妈妈为豪的……”"},{"op":"text","speaker":"羽依里","text":"“那就是说，我可能跟羽未的妈妈长得挺像吧。”"},{"op":"image","layer":1,"image":"i15387"},{"op":"text","speaker":"羽未","text":"“这绝对不可能。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i58"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13062"},{"op":"text","speaker":"白羽","text":"“打扰了。”"},{"op":"text","speaker":"羽依里","text":"“抱歉。突然把你拉到家里。”"},{"op":"text","speaker":"羽依里","text":"“还麻烦你给我们做饭。”"},{"op":"image","layer":1,"image":"i13081"},{"op":"text","speaker":"白羽","text":"“没、没关系。”"},{"op":"image","layer":1,"image":"i13111"},{"op":"text","speaker":"白羽","text":"“我也很开心……所以……”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"image","layer":1,"image":"i13105"},{"op":"text","speaker":"白羽","text":"“那么热闹的饭桌，很久没见到过了。”"},{"op":"text","speaker":"羽依里","text":"“是吗。”"},{"op":"text","speaker":"羽依里","text":"“你不介意的话，改天再来吧。”"},{"op":"image","layer":1,"image":"i13131"},{"op":"text","speaker":"白羽","text":"“…………”"},{"op":"text","speaker":"","text":"她似乎有点为难，缩起双肩。"},{"op":"image","layer":1,"image":"i13170"},{"op":"text","speaker":"白羽","text":"“再见了。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":1},{"op":"image","layer":2,"image":"i751"},{"op":"image","layer":0,"image":"i514"},{"op":"set","variable":6714,"value":4},{"op":"clear","layer":2},{"op":"image","layer":0,"image":"i70"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"……"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“鹰原哥。”"},{"op":"text","speaker":"羽依里","text":"“怎么了？”"},{"op":"image","layer":1,"image":"i15384"},{"op":"text","speaker":"羽未","text":"“给，有你的信。”"},{"op":"text","speaker":"羽依里","text":"“我的？”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"","text":"为什么会有我的信寄到这地方来……"},{"op":"text","speaker":"","text":"寄信人是……"},{"op":"text","speaker":"羽依里","text":"“啊……”"},{"op":"image","layer":1,"image":"i15538"},{"op":"text","speaker":"羽未","text":"“好可爱的信封啊。”"},{"op":"image","layer":1,"image":"i15536"},{"op":"text","speaker":"羽未","text":"“惠……小姐？”"},{"op":"text","speaker":"羽依里","text":"“喂，不准偷看。”"},{"op":"image","layer":1,"image":"i15587"},{"op":"text","speaker":"羽未","text":"“对不起。”"},{"op":"image","layer":1,"image":"i15511"},{"op":"text","speaker":"羽未","text":"“是你妹妹吗？”"},{"op":"text","speaker":"羽依里","text":"“怎么可能。”"},{"op":"text","speaker":"羽依里","text":"“都有羽未了，还要什么其他妹妹。”"},{"op":"text","speaker":"羽依里","text":"“我的妹妹就只有羽未你一个。”"},{"op":"image","layer":1,"image":"i15522"},{"op":"text","speaker":"羽未","text":"“呕。”"},{"op":"text","speaker":"羽依里","text":"“开玩笑啦。”"},{"op":"image","layer":1,"image":"i15558"},{"op":"text","speaker":"羽未","text":"“谁跟你开玩笑。”"},{"op":"image","layer":1,"image":"i15394"},{"op":"text","speaker":"羽未","text":"“请不要说这么恶心的话。”"},{"op":"image","layer":1,"image":"i15408"},{"op":"text","speaker":"羽未","text":"“那是女朋友吗？”"},{"op":"text","speaker":"羽依里","text":"“呃？”"},{"op":"image","layer":1,"image":"i15401"},{"op":"text","speaker":"羽未","text":"“也不可能。”"},{"op":"text","speaker":"羽依里","text":"“不准说不可能。”"},{"op":"image","layer":1,"image":"i15408"},{"op":"text","speaker":"羽未","text":"“鹰原哥，感觉你来这里是另有隐情的对吧？”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"text","speaker":"羽依里","text":"“……嗯。”"},{"op":"text","speaker":"羽依里","text":"“毕竟我是离家出走来这里的。”"},{"op":"image","layer":1,"image":"i15353"},{"op":"text","speaker":"羽未","text":"“……”"},{"op":"text","speaker":"","text":"羽未怔怔看着我。"},{"op":"text","speaker":"","text":"对年纪还小的羽未来说，也许离家出走这种事太过刺激。"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“这样啊。”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“的确，大家总有自己的隐情。”"},{"op":"text","speaker":"","text":"好豁达。"},{"op":"text","speaker":"羽依里","text":"“羽未，你很喜欢说隐情这词啊。”"},{"op":"image","layer":1,"image":"i15560"},{"op":"text","speaker":"羽未","text":"“呃？”"},{"op":"image","layer":1,"image":"i15563"},{"op":"text","speaker":"羽未","text":"“不行吗……要你管。”"},{"op":"text","speaker":"羽依里","text":"“羽未你的隐情是什么呢？”"},{"op":"text","speaker":"羽依里","text":"“不会也是离家出走的吧？”"},{"op":"image","layer":1,"image":"i15589"},{"op":"text","speaker":"羽未","text":"“才才、才不是。”"},{"op":"image","layer":1,"image":"i15573"},{"op":"text","speaker":"羽未","text":"“泥有神马依据得出这种结论的？”"},{"op":"text","speaker":"","text":"啊，这语气……"},{"op":"text","speaker":"","text":"看来说中了七八成。"},{"op":"image","layer":1,"image":"i15403"},{"op":"text","speaker":"羽未","text":"“别把我和你相提并论。”"},{"op":"image","layer":1,"image":"i15387"},{"op":"text","speaker":"羽未","text":"“我才不是鹰原哥你这样的坏人。”"},{"op":"text","speaker":"羽依里","text":"“对不起。”"},{"op":"text","speaker":"","text":"也不用这么生气吧。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i78"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"","text":"回屋的话羽未会毫不客气地跟进来，所以我来到了仓库。"},{"op":"text","speaker":"","text":"镜子阿姨现在似乎不在。"},{"op":"text","speaker":"羽依里","text":"“唔。”"},{"op":"text","speaker":"","text":"我拿着信发愣。"},{"op":"text","speaker":"","text":"真不太想读。"},{"op":"text","speaker":"","text":"干什么要给我寄这信……不过要是打电话过来我也很为难……"},{"op":"image","layer":1,"image":"i11655"},{"op":"text","speaker":"镜子","text":"“嘿咻。”"},{"op":"text","speaker":"羽依里","text":"“哇。”"},{"op":"text","speaker":"","text":"吓死了。"},{"op":"text","speaker":"羽依里","text":"“原来你在的啊。”"},{"op":"image","layer":1,"image":"i11670"},{"op":"text","speaker":"镜子","text":"“抱歉抱歉，我在桌子下面整理东西。”"},{"op":"text","speaker":"","text":"我忙把信藏起。"},{"op":"image","layer":1,"image":"i11686"},{"op":"text","speaker":"镜子","text":"“……”"},{"op":"text","speaker":"","text":"镜子阿姨对此保持沉默。"},{"op":"image","layer":1,"image":"i11674"},{"op":"text","speaker":"镜子","text":"“要是被羽未看到确实不好。”"},{"op":"text","speaker":"","text":"不过像是明白了什么一般，带着温柔的目光说到。"},{"op":"text","speaker":"羽依里","text":"“是、是的。嗯。”"},{"op":"image","layer":1,"image":"i11687"},{"op":"text","speaker":"镜子","text":"“男孩子也很不容易啊。”"},{"op":"text","speaker":"","text":"她嗯嗯地点了点头。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“是，不容易。”"},{"op":"text","speaker":"","text":"感觉她好像有什么误会……"},{"op":"image","layer":1,"image":"i11650"},{"op":"text","speaker":"镜子","text":"“你来这边过得怎么样？”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"text","speaker":"羽依里","text":"“嗯，也没什么特别的变化吧。”"},{"op":"image","layer":1,"image":"i11647"},{"op":"text","speaker":"镜子","text":"“我感觉你跟刚来时的神情不太一样了。”"},{"op":"text","speaker":"羽依里","text":"“只是被晒黑了而已。”"},{"op":"text","speaker":"羽依里","text":"“来这么久，忙没帮上就天天在外面闲逛而已。”"},{"op":"image","layer":1,"image":"i11664"},{"op":"text","speaker":"镜子","text":"“男孩子能在外面玩得尽兴就最好了。”"},{"op":"text","speaker":"羽依里","text":"“我早就不是在外面疯玩的年纪了啦。”"},{"op":"image","layer":1,"image":"i11670"},{"op":"text","speaker":"镜子","text":"“我倒是觉得你是。”"},{"op":"text","speaker":"羽依里","text":"“这……”"},{"op":"text","speaker":"","text":"我把手上的信封呈出来。"},{"op":"image","layer":1,"image":"i11681"},{"op":"text","speaker":"镜子","text":"“呀！”"},{"op":"text","speaker":"","text":"镜子阿姨立刻遮住脸，拉开距离。"},{"op":"text","speaker":"羽依里","text":"“为什么要惊讶啊？”"},{"op":"image","layer":1,"image":"i11678"},{"op":"text","speaker":"镜子","text":"“你自己看可以，但拿出来给我看就不好了。”"},{"op":"text","speaker":"羽依里","text":"“请等一下。”"},{"op":"text","speaker":"羽依里","text":"“你当是什么东西了？”"},{"op":"image","layer":1,"image":"i11681"},{"op":"text","speaker":"镜子","text":"“这还问，当然是男孩子必不可少的……色色的书……”"},{"op":"text","speaker":"羽依里","text":"“这不是书，你好好看看。”"},{"op":"text","speaker":"羽依里","text":"“是信。”"},{"op":"image","layer":1,"image":"i11666"},{"op":"text","speaker":"镜子","text":"“……确实是信。”"},{"op":"image","layer":1,"image":"i11679"},{"op":"text","speaker":"镜子","text":"“色色的信？”"},{"op":"text","speaker":"羽依里","text":"“那是什么信啊!؟”"},{"op":"text","speaker":"羽依里","text":"“你到底……把我当什么了？”"},{"op":"image","layer":1,"image":"i11670"},{"op":"text","speaker":"镜子","text":"“啊哈哈……对不起。因为你偷偷摸摸的跑到仓库里嘛。”"},{"op":"text","speaker":"羽依里","text":"“这点是我不对。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i11667"},{"op":"text","speaker":"镜子","text":"“谁寄来的信？”"},{"op":"text","speaker":"羽依里","text":"“老家的熟人。”"},{"op":"image","layer":1,"image":"i11650"},{"op":"text","speaker":"镜子","text":"“不看看吗？”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“总觉得。”"},{"op":"text","speaker":"羽依里","text":"“要是看了这信，现在这样的日子就要到头了。”"},{"op":"text","speaker":"羽依里","text":"“我还想再继续过一过这种日子。”"},{"op":"image","layer":1,"image":"i11670"},{"op":"text","speaker":"镜子","text":"“这样不也挺好。”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"text","speaker":"","text":"我看了看日历，8月还有大半。"},{"op":"text","speaker":"","text":"像昨天那样日子，还能过很多次。"},{"op":"text","speaker":"","text":"想到这，我就不禁满怀期待。"},{"op":"text","speaker":"","text":"都不记得有多久没有过这种心情了。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i516"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"为什么会来到这座岛上，我自己都说不上理由。"},{"op":"text","speaker":"","text":"只是想远离老家而已。"},{"op":"text","speaker":"","text":"不过，理由也许并非就这一个。"},{"op":"text","speaker":"","text":"可能有什么连我自己都没有明悟的理由。"},{"op":"text","speaker":"","text":"也许在无意识中，渴望着这个地方。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"我打通电话。"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"呼叫声响起。"},{"op":"text","speaker":"","text":"静等片刻后……"},{"op":"text","speaker":"白羽","text":"‘喂。’"},{"op":"text","speaker":"","text":"简短的应答。"},{"op":"text","speaker":"羽依里","text":"“请问是鸣濑家吗？”"},{"op":"text","speaker":"白羽","text":"‘……是的。’"},{"op":"text","speaker":"羽依里","text":"“那个，我是鹰原。”"},{"op":"text","speaker":"白羽","text":"‘嗯。’"},{"op":"text","speaker":"白羽","text":"‘听声音就知道。’"},{"op":"text","speaker":"羽依里","text":"“是吗。不过我经常被朋友说打电话时的声音跟平时差挺远――”"},{"op":"text","speaker":"白羽","text":"‘什么事？’"},{"op":"text","speaker":"","text":"被打断了。"},{"op":"text","speaker":"","text":"感觉比平时还要更冷漠。"},{"op":"text","speaker":"羽依里","text":"“那个。”"},{"op":"text","speaker":"白羽","text":"‘嗯。’"},{"op":"text","speaker":"羽依里","text":"“明天，一起玩吗？”"},{"op":"text","speaker":"白羽","text":"‘……’"},{"op":"image","layer":0,"image":"i170"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"白羽","text":"‘可以。’"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]