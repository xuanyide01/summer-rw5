[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11549"},{"op":"text","speaker":"镜子","text":"“真有你的啊，羽依里。”"},{"op":"text","speaker":"羽依里","text":"“是说昨天那事吗？”"},{"op":"text","speaker":"","text":"我跟小鸠老爷子的大战，似乎转眼就传得家喻户晓了。"},{"op":"text","speaker":"羽依里","text":"“呃，还好吧。”"},{"op":"text","speaker":"","text":"可能在听说后也吓了镜子阿姨一跳吧。"},{"op":"text","speaker":"羽依里","text":"“我藏着的一面，似乎是暴露出来了。”"},{"op":"image","layer":257,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“你干什么了？”"},{"op":"image","layer":1,"image":"i11566"},{"op":"text","speaker":"镜子","text":"“你还不知道吗؟؟”"},{"op":"image","layer":1,"image":"i11546"},{"op":"text","speaker":"镜子","text":"“羽依里君干掉了一个老爷爷。”"},{"op":"image","layer":257,"image":"i15552"},{"op":"text","speaker":"羽未","text":"“好厉害！哥哥好强啊。”"},{"op":"text","speaker":"羽依里","text":"“镜子阿姨，你的说明也太笼统了。”"},{"op":"image","layer":1,"image":"i11581"},{"op":"text","speaker":"镜子","text":"“然后，他因为这件事。”"},{"op":"image","layer":1,"image":"i11575"},{"op":"text","speaker":"镜子","text":"“要准备结婚了。”"},{"op":"image","layer":257,"image":"i15533"},{"op":"text","speaker":"羽未","text":"“跟老爷爷!؟”"},{"op":"text","speaker":"羽依里","text":"“所以说你说明的太笼统了。”"},{"op":"image","layer":1,"image":"i11638"},{"op":"text","speaker":"镜子","text":"“有吗？”"},{"op":"image","layer":1,"image":"i11635"},{"op":"text","speaker":"镜子","text":"“是跟老爷爷的外孙女。”"},{"op":"image","layer":257,"image":"i15372"},{"op":"text","speaker":"羽依里","text":"“原来大家都知道了啊。”"},{"op":"image","layer":1,"image":"i11546"},{"op":"text","speaker":"镜子","text":"“大家都知道了。”"},{"op":"image","layer":257,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“哥哥要结婚了……”"},{"op":"text","speaker":"羽依里","text":"“假装而已。”"},{"op":"text","speaker":"","text":"……我给羽未大致说明了事情经过。"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“果然好厉害！”"},{"op":"text","speaker":"羽依里","text":"“是，是吗？”"},{"op":"return"},{"op":"end"}]