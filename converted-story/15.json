[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i69"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"早晨醒得比平时还要早。"},{"op":"text","speaker":"","text":"忽然，客厅传来了声音。"},{"op":"image","layer":7,"image":"i15898"},{"op":"text","speaker":"羽未","text":"“迟到啦――迟到啦――”"},{"op":"text","speaker":"","text":"……羽未？"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"当我来到客厅。"},{"op":"text","speaker":"","text":"羽未正在做出门的准备。"},{"op":"text","speaker":"羽依里","text":"“这一大早的要出门吗？”"},{"op":"image","layer":1,"image":"i15768"},{"op":"text","speaker":"羽未","text":"“那个是从今天开始，体操哦。”"},{"op":"text","speaker":"羽依里","text":"“什么体操？”"},{"op":"image","layer":1,"image":"i15821"},{"op":"text","speaker":"羽未","text":"“广播体操。”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"text","speaker":"","text":"到哪里都会有呢，体操。"},{"op":"image","layer":1,"image":"i15812"},{"op":"text","speaker":"羽未","text":"“哥哥也一起去吗？”"},{"op":"text","speaker":"羽依里","text":"“不，我不去哦。”"},{"op":"image","layer":1,"image":"i15768"},{"op":"text","speaker":"羽未","text":"“要是全勤，可以拿到奖品哦？”"},{"op":"text","speaker":"羽依里","text":"“什么奖品啊？”"},{"op":"image","layer":1,"image":"i15809"},{"op":"text","speaker":"羽未","text":"“哎……秘泉精华……？”"},{"op":"text","speaker":"羽依里","text":"“秘泉……秘泉……”"},{"op":"text","speaker":"羽依里","text":"“哦，温泉精华啊。”"},{"op":"text","speaker":"","text":"但这大夏天的也不想慢悠悠泡澡啊。"},{"op":"text","speaker":"羽依里","text":"“我就不去了。”"},{"op":"image","layer":1,"image":"i15812"},{"op":"text","speaker":"羽未","text":"“那，我出门啦。”"},{"op":"text","speaker":"羽依里","text":"“慢走，注意安全。”"},{"op":"image","layer":1,"image":"i15885"},{"op":"text","speaker":"羽未","text":"“好的。”"},{"op":"text","speaker":"","text":"我目送精神饱满的羽未出门。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"太阳和蝉鸣都从一大早就火力全开的样子。"},{"op":"text","speaker":"","text":"看来今天也会很热。"},{"op":"return"},{"op":"image","layer":1,"image":"i15895"},{"op":"text","speaker":"羽未","text":"“在做什么呢？”"},{"op":"text","speaker":"羽依里","text":"“噢。”"},{"op":"text","speaker":"羽依里","text":"“回来啦。”"},{"op":"image","layer":1,"image":"i15764"},{"op":"text","speaker":"羽未","text":"“我回来啦――”"},{"op":"text","speaker":"","text":"似乎是做完广播体操回来了。"},{"op":"image","layer":1,"image":"i15809"},{"op":"text","speaker":"羽未","text":"“你可以和……”"},{"op":"text","speaker":"羽未","text":"“摩托车说话的吗？”"},{"op":"text","speaker":"羽依里","text":"“没、没错哦。”"},{"op":"image","layer":1,"image":"i15815"},{"op":"text","speaker":"羽未","text":"“好厉害哦。”"},{"op":"text","speaker":"","text":"呃……居然就信了。"},{"op":"image","layer":1,"image":"i15768"},{"op":"text","speaker":"羽未","text":"“下个命令看看。”"},{"op":"text","speaker":"羽依里","text":"“命……命令……”"},{"op":"image","layer":1,"image":"i15764"},{"op":"text","speaker":"羽未","text":"“期待……期待……”"},{"op":"text","speaker":"羽依里","text":"“嗯……出发啦伙伴！”"},{"op":"image","layer":1,"image":"i15794"},{"op":"text","speaker":"","text":"引擎突然发动了起来。"},{"op":"text","speaker":"羽依里","text":"“不是吧！”"},{"op":"text","speaker":"羽依里","text":"“停、停下来！”"},{"op":"text","speaker":"","text":"熄火了……"},{"op":"image","layer":1,"image":"i15959"},{"op":"text","speaker":"羽未","text":"“哇――！好厉害――！好厉害――！”"},{"op":"image","layer":1,"image":"i15920"},{"op":"text","speaker":"羽未","text":"“哥哥，你真的能和摩托车说话哎。”"},{"op":"text","speaker":"羽依里","text":"“嗯、嗯。”"},{"op":"image","layer":1,"image":"i15764"},{"op":"text","speaker":"羽未","text":"“我要去告诉镜子阿姨。”"},{"op":"image","layer":1,"image":"i15809"},{"op":"text","speaker":"羽依里","text":"“不行哦，这是我和羽未之间的秘密。”"},{"op":"text","speaker":"羽依里","text":"“否则，坏人会把我和摩托车抓到研究所解剖研究的。”"},{"op":"image","layer":1,"image":"i15791"},{"op":"text","speaker":"羽未","text":"“哎……我不想这样……”"},{"op":"text","speaker":"羽依里","text":"“嗯，我也不想啊。”"},{"op":"text","speaker":"羽依里","text":"“所以，要保密哦。”"},{"op":"image","layer":1,"image":"i15764"},{"op":"text","speaker":"羽未","text":"“嗯，保密。”"},{"op":"text","speaker":"","text":"羽未重重地点了点头。"},{"op":"image","layer":1,"image":"i15883"},{"op":"text","speaker":"","text":"然后小跑着回到了屋内。"},{"op":"text","speaker":"","text":"真不知道她平时都在干什么。"},{"op":"text","speaker":"","text":"好吧，我也搞不清楚自己平时在干什么就是了。"},{"op":"return"},{"op":"image","layer":0,"image":"i29"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"羽依里","text":"“呼哧……呼哧……”"},{"op":"text","speaker":"","text":"累死个人了。"},{"op":"text","speaker":"","text":"我呆站在玄关前。"},{"op":"text","speaker":"","text":"光着身子进去也挺奇怪的。"},{"op":"text","speaker":"","text":"手上拿着因湿透而变重的衣服。"},{"op":"text","speaker":"","text":"怎么办？"},{"op":"choice","variable":6001,"items":[{"text":"不穿直接进门","value":0,"condition":1},{"text":"穿上再进门","value":1,"condition":1}]},{"op":"if","truth":false,"target":119,"value":["==",["v",6001],0]},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i62"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15504"},{"op":"text","speaker":"羽未","text":"“喔，光溜溜的……”"},{"op":"text","speaker":"羽依里","text":"“我回来了。”"},{"op":"image","layer":1,"image":"i15468"},{"op":"text","speaker":"羽未","text":"“为什么没穿衣服？”"},{"op":"text","speaker":"羽依里","text":"“人生有太多意外。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“不穿的年纪？”"},{"op":"text","speaker":"羽依里","text":"“嗯，差不多吧。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“还以为，掉到海里去了。”"},{"op":"text","speaker":"羽依里","text":"“嗯，确实是掉进去了。”"},{"op":"goto","target":142},{"op":"if","truth":false,"target":142,"value":["==",["v",6001],1]},{"op":"image","layer":0,"image":"i62"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15378"},{"op":"text","speaker":"羽未","text":"“哇，全湿透了”"},{"op":"text","speaker":"羽依里","text":"“突然下雨了。”"},{"op":"image","layer":1,"image":"i15504"},{"op":"text","speaker":"羽未","text":"“哎――!؟晒的衣服大危机。”"},{"op":"text","speaker":"","text":"……"},{"op":"image","layer":1,"image":"i15343"},{"op":"text","speaker":"羽未","text":"“明明没下！”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“骗子”"},{"op":"text","speaker":"羽依里","text":"“抱歉，我怕我莫名其妙地全身湿透会让你担心。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“是有一点点，担心哦。”"},{"op":"text","speaker":"羽依里","text":"“只有一点点吗。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“掉到，海里去了؟!”"},{"op":"text","speaker":"羽依里","text":"“嗯，还真是这样。”"},{"op":"if","truth":false,"target":141,"value":["==",["v",486],1]},{"op":"goto","target":141},{"op":"goto","target":142},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“为什么？”"},{"op":"text","speaker":"羽依里","text":"“是为什么呢。”"},{"op":"text","speaker":"羽依里","text":"“骑着行李箱就掉下去了。”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“……听不懂你在说什么……”"},{"op":"text","speaker":"羽依里","text":"“我想也是。”"},{"op":"text","speaker":"","text":"连我自己都搞不懂。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i516"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"电视上正在直播棒球比赛。"},{"op":"image","layer":1,"image":"i11578"},{"op":"text","speaker":"","text":"镜子阿姨她心不在焉地看着。"},{"op":"text","speaker":"羽依里","text":"“支持哪边的队呀？”"},{"op":"image","layer":1,"image":"i11581"},{"op":"text","speaker":"镜子","text":"“红色落后的那一队。”"},{"op":"text","speaker":"羽依里","text":"“我也有同感。”"},{"op":"text","speaker":"广播播报员","text":"‘至今一直以压倒性强势独控锦旗的赤红机器，想不到走到这里居然会被垫底的海洋之星拉入苦战。’"},{"op":"image","layer":1,"image":"i11578"},{"op":"text","speaker":"","text":"听到解说员的话后，镜子阿姨点了点头。"},{"op":"image","layer":1,"image":"i11546"},{"op":"text","speaker":"镜子","text":"“还是支持蓝色那边吧。”"},{"op":"text","speaker":"羽依里","text":"“同感。”"},{"op":"image","layer":257,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“哥哥，洗澡水烧好了。”"},{"op":"image","layer":257,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“你先洗吧。”"},{"op":"text","speaker":"羽依里","text":"“嗯？可以吗。”"},{"op":"image","layer":257,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“你都掉到海里去了。”"},{"op":"image","layer":257,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“身上，黏糊糊的吧？”"},{"op":"text","speaker":"羽依里","text":"“这么一说的确是。”"},{"op":"text","speaker":"羽依里","text":"“但是，第一个洗澡啊……”"},{"op":"callScene","scene":417,"target":2},{"op":"if","truth":false,"target":186,"value":["!=",["v",6001],2]},{"op":"goto","target":206},{"op":"text","speaker":"羽依里","text":"“我还是晚点洗吧。”"},{"op":"image","layer":257,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“哎……”"},{"op":"text","speaker":"羽依里","text":"“洗澡水是你烧的。”"},{"op":"text","speaker":"羽依里","text":"“你先去洗好了。”"},{"op":"image","layer":257,"image":"i15360"},{"op":"text","speaker":"羽未","text":"“唔～……”"},{"op":"image","layer":257,"image":"i15363"},{"op":"text","speaker":"羽未","text":"“人家明明是为了哥哥烧的水……”"},{"op":"image","layer":257,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“你不去洗吗？”"},{"op":"text","speaker":"羽依里","text":"“我还想再看一会电视。”"},{"op":"text","speaker":"羽依里","text":"“羽未先去吧。”"},{"op":"image","layer":257,"image":"i15476"},{"op":"text","speaker":"羽未","text":"“唔唔……”"},{"op":"image","layer":257,"image":"i15465"},{"op":"text","speaker":"羽未","text":"“那么，我先去了。”"},{"op":"text","speaker":"","text":"羽未啪嗒啪嗒地走向浴室。"},{"op":"text","speaker":"","text":"我目送她从我视野中消失，然后继续转向电视。"},{"op":"return"},{"op":"if","truth":false,"target":227,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“要不要一起洗？”"},{"op":"image","layer":257,"image":"i15468"},{"op":"text","speaker":"羽未","text":"“洗澡？”"},{"op":"image","layer":257,"image":"i15496"},{"op":"text","speaker":"羽未","text":"“嗯……”"},{"op":"text","speaker":"羽依里","text":"“开玩笑啦～”"},{"op":"image","layer":257,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“好的。”"},{"op":"text","speaker":"羽依里","text":"“什么!؟”"},{"op":"image","layer":257,"image":"i15455"},{"op":"text","speaker":"羽未","text":"“我去准备下。”"},{"op":"text","speaker":"羽依里","text":"“喂，等等啊，我说着玩的。”"},{"op":"text","speaker":"羽依里","text":"“我已经到了想独自洗澡的年纪了！”"},{"op":"image","layer":257,"image":"i15468"},{"op":"text","speaker":"羽未","text":"“是吗？”"},{"op":"text","speaker":"羽依里","text":"“所以，那个……”"},{"op":"text","speaker":"羽依里","text":"“下次吧。”"},{"op":"image","layer":257,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“嗯，好的。”"},{"op":"goto","target":320},{"op":"if","truth":false,"target":320,"value":["==",["v",6001],1]},{"op":"text","speaker":"羽依里","text":"“一起洗吧！”"},{"op":"image","layer":257,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“……哎。”"},{"op":"text","speaker":"羽依里","text":"“我们一起第一个洗。”"},{"op":"image","layer":257,"image":"i15369"},{"op":"text","speaker":"羽未","text":"“怎么办呢……”"},{"op":"callScene","scene":417,"target":4},{"op":"if","truth":false,"target":316,"value":["==",["v",6001],0]},{"op":"if","truth":false,"target":239,"value":["==",["v",6028],0]},{"op":"text","speaker":"羽依里","text":"“一起洗吧！”"},{"op":"goto","target":265},{"op":"if","truth":false,"target":242,"value":["==",["v",6028],1]},{"op":"text","speaker":"羽依里","text":"“第一个洗澡很舒服的哦！”"},{"op":"goto","target":265},{"op":"if","truth":false,"target":245,"value":["==",["v",6028],2]},{"op":"text","speaker":"羽依里","text":"“一起吧！”"},{"op":"goto","target":265},{"op":"if","truth":false,"target":248,"value":["==",["v",6028],3]},{"op":"text","speaker":"羽依里","text":"“因为第一个洗很舒服的！”"},{"op":"goto","target":265},{"op":"if","truth":false,"target":251,"value":["==",["v",6028],4]},{"op":"text","speaker":"羽依里","text":"“一起～……洗吧！”"},{"op":"goto","target":265},{"op":"if","truth":false,"target":254,"value":["==",["v",6028],5]},{"op":"text","speaker":"羽依里","text":"“一·起·洗·吧！”"},{"op":"goto","target":265},{"op":"if","truth":false,"target":257,"value":["==",["v",6028],6]},{"op":"text","speaker":"羽依里","text":"“洗澡很舒服的哦？”"},{"op":"goto","target":265},{"op":"if","truth":false,"target":260,"value":["==",["v",6028],7]},{"