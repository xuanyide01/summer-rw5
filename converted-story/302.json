[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i69"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“么么啾……”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"羽依里","text":"“哈……！”"},{"op":"text","speaker":"","text":"我正在亲吻着枕头。"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"","text":"最近每天早上都这样。我已经能立刻反应过来状况了。"},{"op":"text","speaker":"羽依里","text":"“呵……呵呵……”"},{"op":"text","speaker":"","text":"看来昨天那些事全都变成了心理阴影啊！"},{"op":"text","speaker":"","text":"那诅咒的尖叫声还有亲吻，全部都是！"},{"op":"text","speaker":"羽依里","text":"“啊啊啊啊啊啊……”"},{"op":"text","speaker":"","text":"今天的梦让我好讨厌自己……"},{"op":"text","speaker":"羽依里","text":"“――哈！”"},{"op":"text","speaker":"","text":"我突然意识到了什么，便向推拉门那边看去。"},{"op":"if","truth":false,"target":34,"value":["==",["v",6003],2]},{"op":"clear","layer":0},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i257"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15469"},{"op":"text","speaker":"羽未","text":"“…………”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"clear","layer":0},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i257"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15497"},{"op":"text","speaker":"羽未","text":"“么么啾？”"},{"op":"text","speaker":"羽依里","text":"“不要看！”"},{"op":"goto","target":66},{"op":"if","truth":false,"target":51,"value":["==",["v",6003],1]},{"op":"clear","layer":0},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i257"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15497"},{"op":"text","speaker":"羽未","text":"“…………”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"clear","layer":0},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i257"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15456"},{"op":"text","speaker":"羽未","text":"“青春期？”"},{"op":"text","speaker":"羽依里","text":"“不，这是青春。”"},{"op":"goto","target":66},{"op":"clear","layer":0},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i257"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15497"},{"op":"text","speaker":"羽未","text":"“…………”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"clear","layer":0},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i257"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15456"},{"op":"text","speaker":"羽未","text":"“是青春期吗？”"},{"op":"text","speaker":"羽依里","text":"“不，这是青春。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":2,"image":"i743"},{"op":"image","layer":0,"image":"i513"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"今天也要和野美希继续在岛上巡逻。"},{"op":"text","speaker":"","text":"说是巡逻……"},{"op":"clear","layer":2},{"op":"image","layer":0,"image":"i31"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“呜呜……”"},{"op":"image","layer":1,"image":"i11699"},{"op":"text","speaker":"美希","text":"“鹰原，你为什么一直举着Hydro Caliber零式？”"},{"op":"text","speaker":"羽依里","text":"“啊，这个是……”"},{"op":"text","speaker":"","text":"昨天的噩梦还没有彻底散去，总感觉有点胆战心惊。"},{"op":"text","speaker":"老奶奶","text":"“早上好啊，两位。”"},{"op":"text","speaker":"羽依里","text":"“咿!؟”"},{"op":"text","speaker":"","text":"突然从旁边传来声音，我立刻就举起Hydro Caliber零式指了过去。"},{"op":"text","speaker":"老奶奶","text":"“哇啊!؟不、不许动！”"},{"op":"image","layer":1,"image":"i11701"},{"op":"text","speaker":"美希","text":"“喂！鹰原！你要对老人家做什么！”"},{"op":"image","layer":1,"image":"i11712"},{"op":"text","speaker":"美希","text":"“还有老奶奶，‘不许动’是开枪的人才会说的。”"},{"op":"text","speaker":"","text":"这吐槽还挺冷静的。"},{"op":"text","speaker":"老爷爷","text":"“哎呀，怎么了？”"},{"op":"text","speaker":"羽依里","text":"“呜哇!؟”"},{"op":"text","speaker":"","text":"这次是从后面！"},{"op":"text","speaker":"","text":"我在转身的同时准备扣下Hydro Caliber零式的扳机……"},{"op":"image","layer":1,"image":"i11797"},{"op":"text","speaker":"美希","text":"“住手。”"},{"op":"text","speaker":"羽依里","text":"“呜哇噗!!”"},{"op":"text","speaker":"","text":"脸上挨了一发水枪，我清醒了过来。"},{"op":"image","layer":1,"image":"i11789"},{"op":"text","speaker":"美希","text":"“不是说过不要对岛上的居民举枪吗。”"},{"op":"text","speaker":"羽依里","text":"“对、对不起，身体不自觉就产生反应了。”"},{"op":"image","layer":1,"image":"i11712"},{"op":"text","speaker":"美希","text":"“你今天很奇怪啊，到底在紧张些什么？”"},{"op":"text","speaker":"羽依里","text":"“只是做了个不好的梦。”"},{"op":"text","speaker":"","text":"我似乎得了种见到岛民就会不由自主提高警惕的病。"},{"op":"text","speaker":"","text":"不过，挨了野美希一枪后，我可能终于清醒了。"},{"op":"text","speaker":"老奶奶","text":"“哎呀哎呀，做了噩梦吗？”"},{"op":"text","speaker":"老爷爷","text":"“听说梦只要告诉别人就不会成真哦。”"},{"op":"text","speaker":"羽依里","text":"“是这样吗？”"},{"op":"text","speaker":"","text":"话说，要是那种梦成真可就要命了。"},{"op":"image","layer":1,"image":"i11696"},{"op":"text","speaker":"美希","text":"“那就让我来听听吧。”"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“你梦到了什么？”"},{"op":"text","speaker":"羽依里","text":"“呃，那个……”"},{"op":"text","speaker":"","text":"我下意识地看向野美希的嘴唇，久久无法移开视线。"},{"op":"image","layer":1,"image":"i11731"},{"op":"text","speaker":"美希","text":"“怎么了，有事吗？”"},{"op":"text","speaker":"羽依里","text":"“没、没什么！”"},{"op":"text","speaker":"","text":"我强迫自己把视线从野美希的嘴唇上移走。"},{"op":"text","speaker":"羽依里","text":"“梦的内容我记不太清了。”"},{"op":"text","speaker":"羽依里","text":"“只记得被什么东西追着跑，特别可怕。”"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“这样啊。”"},{"op":"image","layer":1,"image":"i11693"},{"op":"text","speaker":"美希","text":"“确实，做了什么梦在睡醒之后很快就会忘得一干二净。”"},{"op":"text","speaker":"","text":"实际上，每个细节我都记得非常清楚。"},{"op":"text","speaker":"","text":"所以从刚才开始……不，直到现在都很在意野美希的嘴唇。"},{"op":"text","speaker":"","text":"梦中亲吻时的那种触感，清晰地浮现在脑海中……"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"","text":"不对。"},{"op":"text","speaker":"","text":"和野美希接吻并不是梦。"},{"op":"text","speaker":"","text":"昨天晚上，我确确实实亲到了野美希。"},{"op":"text","speaker":"","text":"梦里留下的印象太过强烈，反而覆盖掉了现实的记忆。"},{"op":"text","speaker":"","text":"正是因为昨天的那个吻，才会做那样的梦。"},{"op":"text","speaker":"","text":"所以，这浮现在脑海中的嘴唇触感，是真实的……"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"image","layer":1,"image":"i11731"},{"op":"text","speaker":"美希","text":"“嗯？怎么了？你脸好像很红啊？”"},{"op":"text","speaker":"老爷爷","text":"“是不是发烧了？”"},{"op":"text","speaker":"羽依里","text":"“没、没什么！今天也很热呢～！”"},{"op":"image","layer":1,"image":"i11696"},{"op":"text","speaker":"美希","text":"“是啊，老奶奶你们也要当心中暑啊。”"},{"op":"text","speaker":"","text":"和老奶奶老爷爷告别后，又只剩我们两个人了。"},{"op":"image","layer":1,"image":"i11826"},{"op":"text","speaker":"美希","text":"“今天真的很热啊。”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"","text":"野美希还是平常的老样子。这让我有些难过。"},{"op":"text","speaker":"羽依里","text":"（果然昨天的吻，对她来说是想要忘记的事情吗？）"},{"op":"text","speaker":"羽依里","text":"（……稍微试探一下她好了。）"},{"op":"text","speaker":"羽依里","text":"“那个，野美希。”"},{"op":"image","layer":1,"image":"i11829"},{"op":"text","speaker":"美希","text":"“什么事？”"},{"op":"text","speaker":"羽依里","text":"“接吻……”"},{"op":"image","layer":1,"image":"i11718"},{"op":"text","speaker":"美希","text":"“接、接吻？”"},{"op":"text","speaker":"羽依里","text":"“――鱼的天妇罗很好吃对吧！”"},{"op":"image","layer":1,"image":"i11712"},{"op":"text","speaker":"美希","text":"“啊？天、天妇罗？”"},{"op":"image","layer":1,"image":"i11699"},{"op":"text","speaker":"美希","text":"“你、你在说什么？”"},{"op":"text","speaker":"羽依里","text":"“之前听渔夫说，有个很容易钓到接吻鱼的好地方。”"},{"op":"text","speaker":"羽依里","text":"“我在想要不要去试试看。”"},{"op":"image","layer":1,"image":"i11740"},{"op":"text","speaker":"美希","text":"“啊，哦，原来是在说鱼啊。”"},{"op":"text","speaker":"羽依里","text":"“是在说鱼。”"},{"op":"image","layer":1,"image":"i11724"},{"op":"text","speaker":"美希","text":"“这样啊。”"},{"op":"text","speaker":"","text":"野美希难道是慌了？"},{"op":"text","speaker":"","text":"……好，再确认一次。"},{"op":"text","speaker":"羽依里","text":"“我说，野美希喜欢接吻。”"},{"op":"image","layer":1,"image":"i11734"},{"op":"text","speaker":"美希","text":"“!!”"},{"op":"text","speaker":"羽依里","text":"“――鱼吗？”"},{"op":"image","layer":1,"image":"i11721"},{"op":"text","speaker":"美希","text":"“什、什么接吻喜不喜欢的……”"},{"op":"text","speaker":"羽依里","text":"“要是钓到了，想着要不要分给你几条呢。”"},{"op":"image","layer":1,"image":"i11712"},{"op":"text","speaker":"美希","text":"“说、说的是鱼对吧？”"},{"op":"image","layer":1,"image":"i11724"},{"op":"text","speaker":"美希","text":"“喜、喜欢……如果是说鱼的话……”"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“毕竟人称大海女王，味道确实很高级。”"},{"op":"image","layer":1,"image":"i11689"},{"op":"text","speaker":"美希","text":"“我喜欢炸成天妇罗后蘸盐或者酢橘，吃起来会很清爽。”"},{"op":"text","speaker":"羽依里","text":"“这样啊，野美希也喜欢接吻。”"},{"op":"image","layer":1,"image":"i11718"},{"op":"text","speaker":"美希","text":"“!!”"},{"op":"text","speaker":"羽依里","text":"“――鱼是吗？”"},{"op":"image","layer":1,"image":"i11724"},{"op":"text","speaker":"美希","text":"“啊，嗯……”"},{"op":"image","layer":1,"image":"i11712"},{"op":"text","speaker":"美希","text":"“说的是鱼哦？”"},{"op":"text","speaker":"羽依里","text":"“嗯，是鱼。”"},{"op":"image","layer":1,"image":"i11854"},{"op":"text","speaker":"美希","text":"“…………”"},{"op":"text","speaker":"","text":"野美希满脸通红地陷入了沉默。"},{"op":"text","speaker":"","text":"昨天接吻的事，野美希果然也很在意。"},{"op":"text","speaker":"","text":"她只是在假装不在意而已啊。"},{"op":"text","speaker":"","text":"光是明白了这一点，我就已经很开心了。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]