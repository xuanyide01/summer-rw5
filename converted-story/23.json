[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"if","truth":false,"target":5,"value":["==",["v",6003],1]},{"op":"callScene","scene":25,"target":2},{"op":"goto","target":86},{"op":"if","truth":false,"target":8,"value":["==",["v",6003],2]},{"op":"callScene","scene":24,"target":2},{"op":"goto","target":86},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“我开动了。”"},{"op":"image","layer":1,"image":"i15547"},{"op":"text","speaker":"羽未","text":"“我开动了。”"},{"op":"text","speaker":"羽依里","text":"“今天的炒饭……”"},{"op":"text","speaker":"羽依里","text":"“好吃是好吃，但有种奇特的味道。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“是纳豆。”"},{"op":"text","speaker":"羽依里","text":"“啊，对的，就是这东西的味道。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“别人给了我他们家自制的纳豆哦。”"},{"op":"text","speaker":"羽依里","text":"“这座岛上的人真是什么都做呢。”"},{"op":"image","layer":1,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“似乎是呢。”"},{"op":"image","layer":1,"image":"i15455"},{"op":"text","speaker":"羽未","text":"“有想吃的东西我可以去帮你准备哦。”"},{"op":"text","speaker":"羽依里","text":"“想吃的东西啊。”"},{"op":"text","speaker":"羽依里","text":"“面包…吧。”"},{"op":"image","layer":1,"image":"i15468"},{"op":"text","speaker":"羽未","text":"“面包炒饭？”"},{"op":"text","speaker":"羽依里","text":"“别别，不用带上炒饭。”"},{"op":"text","speaker":"羽依里","text":"“我早餐习惯吃面包。在家时一直是这样的。”"},{"op":"image","layer":1,"image":"i15479"},{"op":"text","speaker":"羽未","text":"“面包啊。”"},{"op":"image","layer":1,"image":"i15485"},{"op":"text","speaker":"羽未","text":"“嗯～但是啊。”"},{"op":"image","layer":1,"image":"i15465"},{"op":"text","speaker":"羽未","text":"“面包能搭味噌汤吗。”"},{"op":"text","speaker":"羽依里","text":"“不搭，也别搭一起。”"},{"op":"image","layer":1,"image":"i15468"},{"op":"text","speaker":"羽未","text":"“那要搭个什么汤呢。”"},{"op":"text","speaker":"羽依里","text":"“汤不好搭啊。”"},{"op":"text","speaker":"羽依里","text":"“换个其他的。”"},{"op":"text","speaker":"羽依里","text":"“玉米浓汤。”"},{"op":"image","layer":1,"image":"i15496"},{"op":"text","speaker":"羽未","text":"“……”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“玉米浓汤哎。”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“玉米浓汤和吐司就可以了吗。”"},{"op":"text","speaker":"羽依里","text":"“虽说都是面包吧……”"},{"op":"text","speaker":"羽依里","text":"“牛角面包。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“牛角面包哎。”"},{"op":"text","speaker":"羽依里","text":"“顺便饮料要……”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“卡布奇诺。”"},{"op":"image","layer":1,"image":"i15353"},{"op":"text","speaker":"羽未","text":"“卡布奇诺哎。”"},{"op":"text","speaker":"羽依里","text":"“最后是……”"},{"op":"text","speaker":"羽依里","text":"“新鲜橙汁。”"},{"op":"image","layer":1,"image":"i15378"},{"op":"text","speaker":"羽未","text":"“新鲜橙汁哎。”"},{"op":"text","speaker":"羽依里","text":"“为什么要复读一遍啊。”"},{"op":"image","layer":1,"image":"i15460"},{"op":"text","speaker":"羽未","text":"“这些单词太不像会从鹰原哥嘴里说出来的了，我很不适应。”"},{"op":"image","layer":1,"image":"i15485"},{"op":"text","speaker":"羽未","text":"“好吧好吧，我会试着努力一下的。”"},{"op":"text","speaker":"羽依里","text":"“什么，你会帮我准备吗。”"},{"op":"image","layer":1,"image":"i15496"},{"op":"text","speaker":"羽未","text":"“你不是想吃吗。”"},{"op":"text","speaker":"羽依里","text":"“话是没错。”"},{"op":"text","speaker":"羽依里","text":"“也不用勉强的。”"},{"op":"image","layer":1,"image":"i15387"},{"op":"text","speaker":"羽未","text":"“真是受不了。”"},{"op":"image","layer":1,"image":"i15389"},{"op":"text","speaker":"羽未","text":"“是想吃，还是不想吃啊。”"},{"op":"text","speaker":"羽依里","text":"“想、想吃。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“那我尽量准备。”"},{"op":"text","speaker":"羽依里","text":"“谢、谢谢。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"text","speaker":"","text":"吃完早饭后，我决定今天也去岛上转转。"},{"op":"image","layer":2,"image":"i742"},{"op":"image","layer":0,"image":"i513"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"今天看到了好多人穿校服。"},{"op":"text","speaker":"","text":"现在是在放暑假，那大概是学校有活动吧。"},{"op":"clear","layer":2},{"op":"image","layer":0,"image":"i2"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"可能岛上所有的学生都在这船上了。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":0,"image":"i190"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13168"},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i13168"},{"op":"text","speaker":"","text":"正当我以为就要出航的时候，有位少女咻的一下蹦了下来。"},{"op":"text","speaker":"","text":"那是……"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i1"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“哟。”"},{"op":"image","layer":1,"image":"i13118"},{"op":"text","speaker":"白羽","text":"“哎!؟”"},{"op":"text","speaker":"","text":"非常吃惊。"},{"op":"text","speaker":"","text":"几乎是字面意义上的吓了一跳。"},{"op":"text","speaker":"","text":"也许是没想到竟然会有人跟自己搭话吧。"},{"op":"image","layer":1,"image":"i13087"},{"op":"text","speaker":"白羽","text":"“那个……”"},{"op":"text","speaker":"羽依里","text":"“为什么？”"},{"op":"image","layer":1,"image":"i13071"},{"op":"text","speaker":"白羽","text":"“……哎？”"},{"op":"text","speaker":"羽依里","text":"“为什么要特意下船？”"},{"op":"image","layer":1,"image":"i13087"},{"op":"text","speaker":"白羽","text":"“没什么……”"},{"op":"text","speaker":"羽依里","text":"“是翘课了啊。”"},{"op":"text","speaker":"羽依里","text":"“那为什么还要上船呢。”"},{"op":"image","layer":1,"image":"i13059"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“其实我大概也猜得到。”"},{"op":"text","speaker":"羽依里","text":"“你想让某人以为你去了学校。”"},{"op":"text","speaker":"羽依里","text":"“应该是家里人之类的吧。”"},{"op":"text","speaker":"羽依里","text":"“所以，只把上了船这件事落实了就……”"},{"op":"image","layer":1,"image":"i13209"},{"op":"text","speaker":"白羽","text":"“为什么……”"},{"op":"text","speaker":"","text":"是想说为什么我会知道吧。"},{"op":"text","speaker":"羽依里","text":"“因为我也做过类似的事情。”"},{"op":"text","speaker":"羽依里","text":"“我跟你一样。”"},{"op":"text","speaker":"羽依里","text":"“大概，谁都有过类似经历吧。”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"羽依里","text":"“不见了。”"},{"op":"text","speaker":"","text":"已经往另一边走开了。"},{"op":"text","speaker":"","text":"刚才在说“为什么……”的时候，身体已经摆好逃跑的架势了。"},{"op":"text","speaker":"","text":"其实还有一个问题想要问她。"},{"op":"text","speaker":"","text":"为什么要那样依依不舍地看着船呢。"},{"op":"text","speaker":"","text":"但是问不出口。"},{"op":"text","speaker":"","text":"而且，我隐约能够体会这份心情。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"我也走人吧。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"return"},{"op":"set","variable":7120,"value":2},{"op":"if","truth":false,"target":155,"value":["==",["v",6003],1]},{"op":"callScene","scene":25,"target":78},{"op":"goto","target":323},{"op":"if","truth":false,"target":158,"value":["==",["v",6003],2]},{"op":"callScene","scene":24,"target":45},{"op":"goto","target":323},{"op":"image","layer":0,"image":"i516"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":7,"image":"i15495"},{"op":"text","speaker":"羽未","text":"“鹰原哥。”"},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“？”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“浴室似乎是坏掉了。”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“好像说明天才能修好。”"},{"op":"text","speaker":"羽依里","text":"“淋浴也不出水了吗？”"},{"op":"image","layer":1,"image":"i15340"},{"op":"text","speaker":"羽未","text":"“是的。”"},{"op":"text","speaker":"羽依里","text":"“那今天只好不洗了。”"},{"op":"image","layer":1,"image":"i15331"},{"op":"text","speaker":"羽未","text":"“一点也不好。”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“夏天怎么能不洗澡，这不能忍。”"},{"op":"text","speaker":"羽依里","text":"“说是这么说，又不能在厨房冲澡。”"},{"op":"text","speaker":"羽依里","text":"“借用一下小学泳池的淋浴房呢。”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“大晚上的，很冷的哦。”"},{"op":"text","speaker":"羽依里","text":"“倒也是。”"},{"op":"text","speaker":"","text":"虽说晚上也有人在。"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“公所附近似乎有公共浴室。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“去那里吧。”"},{"op":"text","speaker":"羽依里","text":"“公共浴室。”"},{"op":"text","speaker":"","text":"好像有点意思。"},{"op":"text","speaker":"羽依里","text":"“虽说是公所附近，但走着去还挺远，天色又黑。”"},{"op":"image","layer":1,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“鹰原哥，我记得你会骑摩托车吧。”"},{"op":"text","speaker":"羽依里","text":"“那辆幼兽啊。”"},{"op":"image","layer":1,"image":"i15455"},{"op":"text","speaker":"羽未","text":"“后面似乎能坐人的吧。”"},{"op":"text","speaker":"羽依里","text":"“那是货架啊。”"},{"op":"text","speaker":"羽依里","text":"“不过，也有装双人用的踏板……”"},{"op":"text","speaker":"羽依里","text":"“所以，大概坐两个人也行？”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“这种小事不用在意的啦。”"},{"op":"goto","target":357},{"op":"text","speaker":"羽依里","text":"“羽未你不怕吗？”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“没问题。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i516"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":7,"image":"i15324"},{"op":"text","speaker":"羽未","text":"“好舒服啊。”"},{"op":"text","speaker":"羽依里","text":"“是吧。”"},{"op":"image","layer":7,"image":"i15320"},{"op":"text","speaker":"羽未","text":"“等我到16岁了要去考驾照。”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"if","truth":false,"target":257,"value":["==",["v",24006],0]},{"op":"image","layer":7,"image":"i15324"},{"op":"text","speaker":"羽未","text":"“鹰原哥鹰原哥。”"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"image","layer":7,"image":"i15320"},{"op":"text","speaker":"羽未","text":"“就这样，开去看海吧。”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“我觉得会是一片漆黑哦。”"},{"op":"image","layer":7,"image":"i15324"},{"op":"text","speaker":"羽未","text":"“没关系。”"},{"op":"image","layer":7,"image":"i15320"},{"op":"text","speaker":"羽未","text":"“去看吧。”"},{"op":"text","speaker":"羽依里","text":"“好好。”"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i50"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"沿着海岸线开一阵子，也下到海边走了走。"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"","text":"羽未应该是满足了吧，脸上笑嘻嘻的。"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“回去吧。”"},{"op":"text","speaker":"羽依里","text":"“不用洗澡了吗。”"},{"op":"text","speaker":"","text":"话虽如此，但可能已经关门了吧。"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“一天不洗也没关系啦。”"},{"op":"text","speaker":"羽依里","text":"“是吗。”"},{"op":"text","speaker":"羽依里","text":"“那就回家吧。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“那个摩托，好像挺简单的呢。”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“我似乎也能开……”"},{"op":"text","speaker":"羽依里","text":"“不可以。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“知道啦。”"},{"op":"goto","target":323},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i86"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"公共浴室前。"},{"op":"text","speaker":"羽依里","text":"“感觉人不少啊。”"},{"op":"image","layer":1,"image":"i15468"},{"op":"text","speaker":"羽未","text":"“是啊。”"},{"op":"text","speaker":"家庭主妇A","text":"“你家也是吗。”"},{"op":"text","speaker":"家庭主妇B","text":"“突然就不出水了。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“似乎不少家的都出毛病了呢。”"},{"op":"text","speaker":"羽依里","text":"“说不定是水源出问题了。”"},{"op":"text","speaker":"","text":"那么，说不定会看到熟人……"},{"op":"text","speaker":"声音","text":"“啊。”"},{"op":"text","speaker":"羽依里","text":"“？”"},{"op":"image","layer":257,"image":"i13274"},{"op":"text","speaker":"","text":"回头一看。"},{"op":"text","speaker":"羽依里","text":"“啊。”"},{"op":"image","layer":257,"image":"i13235"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"的确是熟人。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":257,"image":"i13373"},{"op":"text","speaker":"","text":"白羽轻轻点头致意后，进入了浴室。"},{"op":"text","speaker":"","text":"我也点了点头，尽管慢了一拍。"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“……”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“青春期吗？”"},{"op":"text","speaker":"羽依里","text":"“哪有!؟”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"text","speaker":"羽依里","text":"“呼。”"},{"op":"text","speaker":"","text":"泡澡真是太舒服了。"},{"op":"text","speaker":"","text":"不过果然，似乎不少家的浴室都出了问题，人特别多。"},{"op":"text","speaker":"","text":"虽然习惯了被裸体男人包围，但这感觉并不好。"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"羽依里","text":"“羽未好慢啊。”"},{"op":"text","speaker":"","text":"我又不好先回去。"},{"op":"text","speaker":"؟؟؟","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“啊，怎么这么慢。羽未……”"},{"op":"image","layer":1,"image":"i13235"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"image","layer":1,"image":"i13274"},{"op":"text","speaker":"白羽","text":"“很正常吧……”"},{"op":"image","layer":1,"image":"i13250"},{"op":"text","speaker":"白羽","text":"“我觉得。”"},{"op":"text","speaker":"羽依里","text":"“是啊。”"},{"op":"image","layer":1,"image":"i13235"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"走掉了。"},{"op":"text","speaker":"","text":"为什么会认错人啊。"},{"op":"text","speaker":"","text":"话说回来，刚出浴……吗。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“哇。”"},{"op":"text","speaker":"羽依里","text":"“你出来了啊。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“青春期吗？”"},{"op":"text","speaker":"羽依里","text":"“哪有!؟”"},{"op":"clear","layer":1},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i73"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我躺在被子上发着呆。"},{"op":"text","speaker":"羽依里","text":"“过了今天7月就结束了啊……”"},{"op":"text","speaker":"","text":"感觉来到这座岛之后，什么事都没有干。"},{"op":"text","speaker":"","text":"是不是应该再有计划性一点。"},{"op":"text","speaker":"羽依里","text":"“……做什么呢？”"},{"op":"text","speaker":"","text":"没有人会回答我。"},{"op":"text","speaker":"","text":"而且要是真有人回答也挺恐怖的。"},{"op":"text","speaker":"羽依里","text":"“睡吧。”"},{"op":"image","layer":0,"image":"i75"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"暑假还长着呢。"},{"op":"text","speaker":"","text":"没有必要匆忙决定现在要干什么……"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"if","truth":false,"target":356,"value":["==",["v",139],1]},{"op":"text","speaker":"羽依里","text":"“……啊。”"},{"op":"image","layer":0,"image":"i75"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"对了，岛可梦对战的饵没放……"},{"op":"text","speaker":"","text":"这个还是得趁现在决定好。"},{"op":"callScene","scene":278,"target":1592},{"op":"goto","target":356},{"op":"return"},{"op":"image","layer":1,"image":"i15408"},{"op":"text","speaker":"羽未","text":"“岛上没人管的。”"},{"op":"text","speaker":"羽依里","text":"“……是、是吗。”"},{"op":"text","speaker":"羽依里","text":"“岛上没人管啊。”"},{"op":"goto","target":201},{"op":"end"}]