[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i21"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我来到了秘密基地。"},{"op":"text","speaker":"","text":"天善正在一个人打乒乓球。"},{"op":"text","speaker":"","text":"良一坐在靠椅上晃来晃去。"},{"op":"text","speaker":"","text":"而我……"},{"op":"text","speaker":"","text":"则在物色基地里的各种东西。"},{"op":"text","speaker":"羽依里","text":"“嗯？这是什么玩意？怎么还是全新的？”"},{"op":"text","speaker":"","text":"我拿出了架子里的刨冰机。"},{"op":"text","speaker":"羽依里","text":"“用这玩意的话，不用跑到小卖铺也能随便吃刨冰了吧。”"},{"op":"image","layer":1,"image":"i15017"},{"op":"text","speaker":"天善","text":"“话是这么说……”"},{"op":"image","layer":257,"image":"i12150"},{"op":"text","speaker":"良一","text":"“你这家伙……勇气可嘉。”"},{"op":"text","speaker":"羽依里","text":"“……？”"},{"op":"image","layer":1,"image":"i15032"},{"op":"text","speaker":"天善","text":"“小卖铺夏天的主要收入来源就是刨冰。”"},{"op":"image","layer":1,"image":"i15008"},{"op":"text","speaker":"天善","text":"“大家都在家里自己做的话搞不好那里要倒闭。”"},{"op":"image","layer":257,"image":"i12147"},{"op":"text","speaker":"良一","text":"“岛民们……都心照不宣，不会在那里之外的地方吃刨冰的。”"},{"op":"image","layer":1,"image":"i15044"},{"op":"text","speaker":"天善","text":"“是啊。”"},{"op":"image","layer":1,"image":"i15038"},{"op":"image","layer":257,"image":"i12141"},{"op":"text","speaker":"天善","text":"“要不然岛上的经济链可能会断掉。”"},{"op":"text","speaker":"羽依里","text":"“这也太夸张了吧……”"},{"op":"text","speaker":"","text":"所以全新的刨冰机就这么放在这里啊。"},{"op":"text","speaker":"羽依里","text":"“……不过。”"},{"op":"text","speaker":"羽依里","text":"“你们不想尝尝想吃就能吃到的刨冰吗？”"},{"op":"image","layer":1,"image":"i15026"},{"op":"image","layer":257,"image":"i12168"},{"op":"text","speaker":"良一·天善","text":"“这!؟”"},{"op":"text","speaker":"","text":"我把岛上结识的朋友带入了歧途。"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“那么，做下刨冰试试吧。”"},{"op":"text","speaker":"","text":"他俩意外地很有兴致。"},{"op":"text","speaker":"","text":"总之，为了多少给岛上的经济做点贡献，冰块还是去小卖铺买来的。"},{"op":"text","speaker":"羽依里","text":"“好的，开干吧！”"},{"op":"image","layer":257,"image":"i15014"},{"op":"text","speaker":"天善","text":"“慢着，让我来。”"},{"op":"image","layer":257,"image":"i15032"},{"op":"text","speaker":"","text":"把冰块放好之后，天善握紧了把手。"},{"op":"text","speaker":"","text":"喀嚓喀嚓喀嚓喀嚓……"},{"op":"image","layer":257,"image":"i15026"},{"op":"text","speaker":"天善","text":"“果然！”"},{"op":"text","speaker":"羽依里","text":"“怎么了？”"},{"op":"image","layer":257,"image":"i15020"},{"op":"text","speaker":"天善","text":"“这是个不错的练习！”"},{"op":"text","speaker":"","text":"他正在无谓地用着手腕的力气。"},{"op":"image","layer":515,"image":"i18121"},{"op":"image","layer":257,"image":"i15035"},{"op":"text","speaker":"天善","text":"“再多放点冰块进来！看我把它们全削成刨冰！”"},{"op":"clear","layer":515},{"op":"clear","layer":768},{"op":"image","layer":768,"image":"i736"},{"op":"clear","layer":1024},{"op":"image","layer":1024,"image":"i736"},{"op":"image","layer":257,"image":"i15036"},{"op":"text","speaker":"天善","text":"“哼！哼！哼！唔啊啊啊啊啊啊啊啊啊啊！”"},{"op":"clear","layer":515},{"op":"clear","layer":768},{"op":"clear","layer":1024},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"这刨冰够闷热的。"},{"op":"image","layer":1,"image":"i15014"},{"op":"text","speaker":"天善","text":"“做好了……首先是第一份。”"},{"op":"text","speaker":"","text":"一份纯白的刨冰做好了。"},{"op":"image","layer":1,"image":"i15008"},{"op":"text","speaker":"羽依里","text":"“反正是你做的，你先吃吧。”"},{"op":"image","layer":1,"image":"i15038"},{"op":"text","speaker":"天善","text":"“可以吗？”"},{"op":"text","speaker":"","text":"我把刨冰放到天善的面前。"},{"op":"image","layer":1,"image":"i15011"},{"op":"text","speaker":"天善","text":"“谢了。那我就不客气了。”"},{"op":"image","layer":1,"image":"i15008"},{"op":"text","speaker":"天善","text":"“……”"},{"op":"image","layer":1,"image":"i15017"},{"op":"text","speaker":"天善","text":"“话说没有糖浆吗？”"},{"op":"text","speaker":"羽依里","text":"“啊，说起来没买。”"},{"op":"image","layer":1,"image":"i15044"},{"op":"image","layer":257,"image":"i12174"},{"op":"text","speaker":"良一","text":"“不是吧，那这怎么办啊？”"},{"op":"text","speaker":"羽依里","text":"“用糖水对付一下也行吧？”"},{"op":"image","layer":257,"image":"i12150"},{"op":"text","speaker":"良一","text":"“我们又不是锹形虫。”"},{"op":"text","speaker":"羽依里","text":"“嗯……糖水……糖浆……”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"羽依里","text":"“我想试个东西。”"},{"op":"text","speaker":"羽依里","text":"“刨冰的味道真的全都是一样的吗？”"},{"op":"image","layer":257,"image":"i12141"},{"op":"text","speaker":"良一","text":"“啊？你这说什么呢？”"},{"op":"text","speaker":"羽依里","text":"“那个，小卖铺的老奶奶，还有苍也都这么说过。”"},{"op":"text","speaker":"羽依里","text":"“味道都是一样的。”"},{"op":"text","speaker":"羽依里","text":"“我想。”"},{"op":"text","speaker":"羽依里","text":"“试验一下。”"},{"op":"text","speaker":"","text":"总之我做好了糖水并浇到了刨冰上。"},{"op":"text","speaker":"羽依里","text":"“来尝尝。”"},{"op":"image","layer":1,"image":"i15044"},{"op":"text","speaker":"天善","text":"“……嗯。”"},{"op":"text","speaker":"","text":"――嚼啊嚼。"},{"op":"image","layer":1,"image":"i15038"},{"op":"text","speaker":"天善","text":"“糖水的味道。”"},{"op":"text","speaker":"羽依里","text":"“那么。”"},{"op":"text","speaker":"","text":"我们把天善的眼镜片涂红了。"},{"op":"image","layer":1,"image":"i15046"},{"op":"text","speaker":"天善","text":"“这是干啥。”"},{"op":"text","speaker":"羽依里","text":"“没啥。总之你再吃一口试试。”"},{"op":"image","layer":1,"image":"i15051"},{"op":"text","speaker":"天善","text":"“……”"},{"op":"text","speaker":"","text":"――嚼啊嚼。"},{"op":"image","layer":1,"image":"i15049"},{"op":"text","speaker":"天善","text":"“啊！”"},{"op":"text","speaker":"羽依里","text":"“怎么样？”"},{"op":"image","layer":1,"image":"i15050"},{"op":"text","speaker":"天善","text":"“……是草莓的味道。”"},{"op":"text","speaker":"羽依里","text":"“是吧？”"},{"op":"image","layer":257,"image":"i12174"},{"op":"text","speaker":"良一","text":"“这是怎么回事？”"},{"op":"image","layer":1,"image":"i15047"},{"op":"text","speaker":"天善","text":"“这强烈的草莓味。”"},{"op":"image","layer":1,"image":"i15048"},{"op":"text","speaker":"天善","text":"“感觉完全就跟在吃草莓一样……”"},{"op":"image","layer":1,"image":"i15046"},{"op":"text","speaker":"天善","text":"“这已经完全是魔法了啊！”"},{"op":"image","layer":257,"image":"i12168"},{"op":"text","speaker":"良一","text":"“真的假的！”"},{"op":"text","speaker":"羽依里","text":"“大概是眼前看到的颜色让大脑误认为是草莓味了。”"},{"op":"image","layer":257,"image":"i12153"},{"op":"text","speaker":"良一","text":"“稍微借我一下。”"},{"op":"image","layer":1,"image":"i15214"},{"op":"text","speaker":"天善","text":"“……嗯？又变回普通的糖水味了。”"},{"op":"text","speaker":"","text":"这也太极端了吧。"},{"op":"image","layer":257,"image":"i12144"},{"op":"text","speaker":"良一","text":"“这个，我把下面部分涂成绿色试试？”"},{"op":"text","speaker":"","text":"良一把眼镜下面部分涂成了绿色，并且涂上了黑色的点。"},{"op":"image","layer":1,"image":"i15213"},{"op":"image","layer":257,"image":"i12174"},{"op":"text","speaker":"良一","text":"“天善，还给你。”"},{"op":"image","layer":1,"image":"i15053"},{"op":"text","speaker":"","text":"天善把眼镜重新戴上了。"},{"op":"text","speaker":"","text":"――嚼啊嚼。"},{"op":"image","layer":1,"image":"i15055"},{"op":"text","speaker":"天善","text":"“这!؟变成西瓜味的了！”"},{"op":"image","layer":1,"image":"i15054"},{"op":"text","speaker":"天善","text":"“不，不仅是味道。就连食感都变成西瓜那种清爽的感觉了。”"},{"op":"text","speaker":"羽依里","text":"“刨冰当然吃起来清爽了。”"},{"op":"image","layer":257,"image":"i12144"},{"op":"text","speaker":"良一","text":"“这个真有意思啊。”"},{"op":"image","layer":257,"image":"i12162"},{"op":"text","speaker":"良一","text":"“你去那边找一下的话，大概能找到以前庙会上我们买的有色眼镜。”"},{"op":"text","speaker":"羽依里","text":"“那就找找吧。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i424"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我们在秘密基地里到处搜寻有色眼镜。"},{"op":"text","speaker":"羽依里","text":"“噢，还真有不少啊。”"},{"op":"image","layer":7,"image":"i12155"},{"op":"text","speaker":"良一","text":"“嗯……戴上紫色的那个吃起来应该就是蓝莓味的了吧。”"},{"op":"image","layer":7,"image":"i15010"},{"op":"text","speaker":"天善","text":"“借我下。”"},{"op":"image","layer":7,"image":"i15019"},{"op":"text","speaker":"天善","text":"“这是……！眼睛的疲劳感瞬间就消失了！”"},{"op":"text","speaker":"羽依里","text":"“噢……那么橙色的话，大概就是这种味道了吧。”"},{"op":"image","layer":7,"image":"i12161"},{"op":"text","speaker":"良一","text":"“也借我下。”"},{"op":"image","layer":7,"image":"i12158"},{"op":"text","speaker":"良一","text":"“原来如此，变成橘子一样的味道了。”"},{"op":"text","speaker":"羽依里","text":"“哎？我怎么觉得是芒果味？”"},{"op":"image","layer":7,"image":"i12167"},{"op":"text","speaker":"良一","text":"“真的假的！味道竟然能因人而异吗。”"},{"op":"image","layer":7,"image":"i12140"},{"op":"text","speaker":"良一","text":"“天善呢？”"},{"op":"image","layer":7,"image":"i15013"},{"op":"text","speaker":"天善","text":"“唔……是橙色的味道啊。”"},{"op":"image","layer":7,"image":"i12146"},{"op":"text","speaker":"良一","text":"“那是什么味道？”"},{"op":"image","layer":7,"image":"i15040"},{"op":"text","speaker":"天善","text":"“总之很好吃。”"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i21"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15011"},{"op":"image","layer":257,"image":"i12141"},{"op":"text","speaker":"羽依里","text":"“茶色的话是红茶的味道。”"},{"op":"image","layer":257,"image":"i12144"},{"op":"text","speaker":"良一","text":"“我吃着是中双糖的味道。”"},{"op":"image","layer":1,"image":"i15014"},{"op":"text","speaker":"天善","text":"“是独角仙果冻的味道。”"},{"op":"image","layer":257,"image":"i12150"},{"op":"text","speaker":"良一","text":"“什么，你竟然吃过那玩意吗……”"},{"op":"image","layer":1,"image":"i15032"},{"op":"text","speaker":"天善","text":"“不，并没有。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i513"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"刨冰的盛宴还在继续。"},{"op":"image","layer":7,"image":"i12167"},{"op":"text","speaker":"良一","text":"“噢噢！果然像刚才那样做的话会觉得是西瓜味啊。”"},{"op":"text","speaker":"羽依里","text":"“那我放点盐怎么样？”"},{"op":"image","layer":7,"image":"i12143"},{"op":"text","speaker":"良一","text":"“噢，放吧。”"},{"op":"text","speaker":"","text":"啪……啪……"},{"op":"image","layer":7,"image":"i12173"},{"op":"text","speaker":"良一","text":"“噢……感觉甜度还增加了。”"},{"op":"text","speaker":"羽依里","text":"“那么接下来是这副眼镜。”"},{"op":"image","layer":7,"image":"i12140"},{"op":"text","speaker":"良一","text":"“粉色啊，感觉戴上这个刨冰能变成桃味……”"},{"op":"image","layer":7,"image":"i12152"},{"op":"text","speaker":"良一","text":"“唔唔！怎么感觉这么咸！”"},{"op":"text","speaker":"羽依里","text":"“毕竟撒盐了啊。”"},{"op":"image","layer":7,"image":"i12149"},{"op":"text","speaker":"良一","text":"“话说，天善那副眼镜是咋回事？”"},{"op":"image","layer":0,"image":"i21"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15058"},{"op":"text","speaker":"","text":"感觉有点艺术气息。"},{"op":"image","layer":1,"image":"i15057"},{"op":"text","speaker":"天善","text":"“我试着把味道混合了下。”"},{"op":"image","layer":7,"image":"i12149"},{"op":"text","speaker":"良一","text":"“……好吃吗，那个？”"},{"op":"image","layer":1,"image":"i15058"},{"op":"text","speaker":"天善","text":"“嗯，非常美味……我嚼。”"},{"op":"image","layer":1,"image":"i15063"},{"op":"text","speaker":"天善","text":"“到底是什么味……我嚼……完全搞不懂……我嚼，不过这个好好吃啊……我嚼。”"},{"op":"image","layer":1,"image":"i15061"},{"op":"text","speaker":"天善","text":"“感觉这玩意既能当菜吃，又能当点心吃……我嚼。”"},{"op":"image","layer":1,"image":"i15062"},{"op":"text","speaker":"天善","text":"“这味道到底是怎么回事……我嚼。”"},{"op":"text","speaker":"","text":"只说味道的话，这应该只是个糖水味吧。"},{"op":"image","layer":1,"image":"i15060"},{"op":"text","speaker":"天善","text":"“有点想把这个浇到饭上吃。”"},{"op":"image","layer":1,"image":"i15059"},{"op":"text","speaker":"天善","text":"“……我嚼……我嚼……我嚼……这，这个停不下来啊。”"},{"op":"image","layer":1,"image":"i15062"},{"op":"text","speaker":"天善","text":"“我吃！我吃我吃我吃我吃我吃我吃我吃！”"},{"op":"text","speaker":"羽依里","text":"“让，让我也戴下试试。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"就这样，我们戴着有色眼镜充分享受了刨冰。"},{"op":"text","speaker":"","text":"不过。"},{"op":"image","layer":0,"image":"i21"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……好冷。”"},{"op":"image","layer":1,"image":"i12147"},{"op":"text","speaker":"良一","text":"“肚，肚子好疼……”"},{"op":"image","layer":257,"image":"i15060"},{"op":"text","speaker":"天善","text":"“……虚汗停不下来。”"},{"op":"text","speaker":"","text":"我们把买来的冰全做成刨冰享用了。"},{"op":"text","speaker":"","text":"非常快乐也非常美味……"},{"op":"text","speaker":"","text":"只不过，代价也是十分惨痛。"},{"op":"if","truth":false,"target":281,"value":["==",["native","エサを所持している"],0]},{"op":"goto","target":281},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"return"},{"op":"end"}]