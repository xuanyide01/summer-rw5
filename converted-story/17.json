[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"if","truth":false,"target":5,"value":["==",["v",6003],1]},{"op":"callScene","scene":19,"target":2},{"op":"goto","target":87},{"op":"if","truth":false,"target":8,"value":["==",["v",6003],2]},{"op":"callScene","scene":18,"target":2},{"op":"goto","target":87},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“早……”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“早上好。”"},{"op":"text","speaker":"羽依里","text":"“今天的早饭……”"},{"op":"text","speaker":"","text":"空气中漂浮着令人胃口大开的香气。"},{"op":"text","speaker":"羽依里","text":"“这个香味是……螃蟹！”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“是蟹肉炒饭。”"},{"op":"text","speaker":"羽依里","text":"“哦哦……”"},{"op":"text","speaker":"羽依里","text":"“我最喜欢螃蟹了……嗯。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“太好了。”"},{"op":"text","speaker":"","text":"真希望以炒饭之外的形式吃到啊。"},{"op":"text","speaker":"羽依里","text":"“但你从哪弄到的螃蟹……”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“港口那边的人给我的。”"},{"op":"text","speaker":"羽依里","text":"“这附近能抓到螃蟹吗？”"},{"op":"text","speaker":"","text":"而且螃蟹这么好的东西，是随随便便能拿到的吗؟؟"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“这都摆在你眼前了，说明是能抓到的吧。”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“要是有什么需求，可以加到炒饭配料中哦。”"},{"op":"text","speaker":"羽依里","text":"“以炒饭为前提啊。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“当然了。”"},{"op":"text","speaker":"","text":"我不断把羽未特制的蟹肉炒饭送入口中。"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"","text":"海味和蟹肉的香味很好地渗透进去，松软的鸡蛋沾在米饭上。"},{"op":"text","speaker":"","text":"出色的蟹肉炒饭。"},{"op":"text","speaker":"羽依里","text":"“哦，太好吃了。”"},{"op":"image","layer":1,"image":"i15401"},{"op":"text","speaker":"羽未","text":"“哼哼。”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“鹰原哥，有喜欢的东西吗？”"},{"op":"text","speaker":"羽依里","text":"“唔……”"},{"op":"text","speaker":"羽依里","text":"“……鸡脯肉吧。”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“鸡、鸡脯肉？”"},{"op":"text","speaker":"羽依里","text":"“你不知道吗？”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“知道是知道，就是那个干巴巴的肉吧。”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“因为没怎么听到过喜欢鸡脯肉的，所以有些疑惑。”"},{"op":"image","layer":1,"image":"i15340"},{"op":"text","speaker":"羽未","text":"“一时之间我还以为你说的是生鱼片呢。”"},{"op":"text","speaker":"羽依里","text":"“低脂肪又能摄入蛋白质，很适合塑身哦。”"},{"op":"image","layer":1,"image":"i15353"},{"op":"text","speaker":"羽未","text":"“唔。”"},{"op":"image","layer":1,"image":"i15573"},{"op":"text","speaker":"羽未","text":"“你说很适合塑身……”"},{"op":"image","layer":1,"image":"i15576"},{"op":"text","speaker":"羽未","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“我不知道对胸部有没有效果哦。”"},{"op":"image","layer":1,"image":"i15533"},{"op":"text","speaker":"羽未","text":"“!؟”"},{"op":"image","layer":1,"image":"i15387"},{"op":"text","speaker":"羽未","text":"“没、没人提这个吧。”"},{"op":"text","speaker":"羽依里","text":"“抱歉抱歉。”"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"text","speaker":"","text":"羽未在吃过早饭后，飒爽地出门了。"},{"op":"text","speaker":"","text":"那么，我干什么呢？"},{"op":"text","speaker":"","text":"总之先……"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i76"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“那个，镜子阿姨。”"},{"op":"image","layer":0,"image":"i1012"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"镜子","text":"“仓库这边还用不上你。”"},{"op":"text","speaker":"","text":"好冷淡啊。"},{"op":"image","layer":0,"image":"i1015"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"镜子","text":"“需要的东西和不需要的东西还得理一下。”"},{"op":"text","speaker":"羽依里","text":"“是吗。”"},{"op":"image","layer":0,"image":"i1012"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"镜子","text":"“难得来一次，就尽情去享受鸟白岛吧。”"},{"op":"text","speaker":"镜子","text":"“许多地方和城市大不相同，很有趣的。”"},{"op":"text","speaker":"羽依里","text":"“那我就恭敬不如从命了。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i80"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"想要帮忙的想法被拒绝了。"},{"op":"text","speaker":"羽依里","text":"“是不是在跟我客气呢。”"},{"op":"text","speaker":"","text":"算了，还有些地方没有好好逛过呢。"},{"op":"text","speaker":"","text":"今天也到处去溜达溜达好了。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"return"},{"op":"if","truth":false,"target":114,"value":["==",["v",6003],1]},{"op":"callScene","scene":19,"target":53},{"op":"goto","target":320},{"op":"if","truth":false,"target":117,"value":["==",["v",6003],2]},{"op":"callScene","scene":18,"target":95},{"op":"goto","target":320},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“我回来了。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“你回来啦咕咕！”"},{"op":"text","speaker":"羽依里","text":"“!؟”"},{"op":"text","speaker":"羽依里","text":"“羽、羽未？”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“其实今天，咕咕！”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"羽未，她坏掉了。"},{"op":"image","layer":1,"image":"i15334"},{"op":"text","speaker":"羽未","text":"“咕咕咕咕咕咕！”"},{"op":"text","speaker":"羽依里","text":"“怎么了？”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“真的没怎么啊。”"},{"op":"text","speaker":"鸡","text":"“咕咕！”"},{"op":"text","speaker":"羽依里","text":"“咦。”"},{"op":"text","speaker":"","text":"厨房的角落，好像有什么东西在动来动去。"},{"op":"text","speaker":"","text":"是一只鸡。"},{"op":"text","speaker":"","text":"原来如此。刚才的叫声不是羽未，而是这家伙啊。"},{"op":"text","speaker":"","text":"我还担心是不是羽未坏掉了呢。"},{"op":"text","speaker":"羽依里","text":"“为什么家里会有只鸡。”"},{"op":"text","speaker":"鸡","text":"“咕咕。”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“别人给的。”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“打算做点鸡脯肉。”"},{"op":"text","speaker":"羽依里","text":"“别直接给一整只啊……”"},{"op":"text","speaker":"羽依里","text":"“这要怎么处理？”"},{"op":"image","layer":1,"image":"i15576"},{"op":"text","speaker":"羽未","text":"“……”"},{"op":"image","layer":1,"image":"i15582"},{"op":"text","speaker":"羽未","text":"“怎么处理呢。”"},{"op":"image","layer":1,"image":"i15576"},{"op":"text","speaker":"羽未","text":"“想从它身上取鸡脯肉。”"},{"op":"image","layer":1,"image":"i15585"},{"op":"text","speaker":"羽未","text":"“可该怎么取呢。”"},{"op":"text","speaker":"羽依里","text":"“是啊。”"},{"op":"text","speaker":"","text":"鸡在房间里来回踱步。"},{"op":"text","speaker":"羽依里","text":"“既然要鸡脯肉，那就用剪刀把鸡剖开？”"},{"op":"image","layer":1,"image":"i15522"},{"op":"text","speaker":"羽未","text":"“别、别开这么恐怖的玩笑啊。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“鹰原哥，你喜欢这种猎奇的，就交给你了。”"},{"op":"text","speaker":"羽依里","text":"“等一下，我喜欢的是那种精神上的猎奇。”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“我不听我不听。”"},{"op":"image","layer":257,"image":"i11617"},{"op":"text","speaker":"镜子","text":"“咦，这只鸡是哪来的。”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“别人给的。”"},{"op":"image","layer":257,"image":"i11632"},{"op":"text","speaker":"镜子","text":"“要处理吗？”"},{"op":"image","layer":1,"image":"i15353"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"image","layer":257,"image":"i11581"},{"op":"text","speaker":"镜子","text":"“要处理的吧？”"},{"op":"text","speaker":"羽依里","text":"“是、是的。”"},{"op":"image","layer":257,"image":"i11584"},{"op":"text","speaker":"镜子","text":"“给我。”"},{"op":"image","layer":257,"image":"i11546"},{"op":"text","speaker":"","text":"咔擦。"},{"op":"image","layer":1,"image":"i15533"},{"op":"text","speaker":"羽依里·羽未","text":"“!؟”“!؟”"},{"op":"image","layer":257,"image":"i11581"},{"op":"text","speaker":"镜子","text":"“那我去那边处理一下。”"},{"op":"image","layer":257,"image":"i11549"},{"op":"text","speaker":"镜子","text":"“羽依里也要来吗？”"},{"op":"text","speaker":"羽依里","text":"“还、还是不了。”"},{"op":"image","layer":257,"image":"i11546"},{"op":"text","speaker":"镜子","text":"“那等我一下。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i15589"},{"op":"text","speaker":"羽未","text":"“……”"},{"op":"if","truth":false,"target":238,"value":["==",["v",49],1]},{"op":"text","speaker":"羽依里","text":"“啊，对了。”"},{"op":"text","speaker":"羽依里","text":"“羽未。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“什么事。”"},{"op":"text","speaker":"羽依里","text":"“那什么。”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":1795,"image":"i18201"},{"op":"set","variable":7120,"value":0},{"op":"image","layer":0,"image":"i239"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13210"},{"op":"text","speaker":"白羽","text":"‘最好不要和我扯上关系。’"},{"op":"clear","layer":1795},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“最好不要跟我走的太近。”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“……哎。”"},{"op":"text","speaker":"","text":"这么一来，反而会让人在意。"},{"op":"text","speaker":"","text":"这便是人的逆反心理。"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“好，我会的。”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“我也隐约觉得这样比较好。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“我会尽量和你保持距离。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"goto","target":238},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i170"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"晚饭的鸡胸肉炒饭，好吃到让人不甘心。"},{"op":"text","speaker":"","text":"真的非常美味……"},{"op":"text","speaker":"羽依里","text":"“这便是……摄取食材的生命吗。”"},{"op":"text","speaker":"","text":"让人不由得感伤起来。"},{"op":"if","truth":false,"target":320,"value":["==",["v",6029],1]},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"由于没什么事情可做，我在客厅发呆。"},{"op":"image","layer":1,"image":"i15533"},{"op":"text","speaker":"羽未","text":"“鹰原哥，那个手环是……”"},{"op":"text","speaker":"羽依里","text":"“哎？啊，在小卖铺别人给的。”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“是吗，原来鹰原哥也要参加了呢。”"},{"op":"text","speaker":"羽依里","text":"“羽未也戴着一样的手环啊。”"},{"op":"image","layer":1,"image":"i15401"},{"op":"text","speaker":"羽未","text":"“因为我是战士啊。”"},{"op":"text","speaker":"羽依里","text":"“什么战士？”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“难道你什么都不知道就踏上了这片战场吗？”"},{"op":"text","speaker":"羽依里","text":"“因为我是想和羽未有更多共通话题……”"},{"op":"image","layer":1,"image":"i15331"},{"op":"text","speaker":"羽未","text":"“我不会手下留情的！”"},{"op":"text","speaker":"羽依里","text":"“咦？怎么反而关系变险恶了？”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“话虽如此，痛扁一无所知的对手也蛮过意不去的。”"},{"op":"text","speaker":"羽依里","text":"“痛扁!؟”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“那个手环是‘岛可梦对决’的参加者证明。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“岛可梦对战是抓获栖息在这个岛上的岛可梦，驱使其对战的活动。”"},{"op":"text","speaker":"羽依里","text":"“类似于现实版的宝口梦？”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“是的。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“在晚上事先放好饵，等到早上便能Get岛可梦。”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“要是你不介意，我可以把我的撒饵地图借给你哦？”"},{"op":"text","speaker":"羽依里","text":"“岛可梦对战啊…”"},{"op":"choice","variable":6001,"items":[{"text":"决定参加","value":0,"condition":1},{"text":"还是算了","value":1,"condition":1}]},{"op":"if","truth":false,"target":307,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“好，我也试试吧。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“可别死了哦。”"},{"op":"text","speaker":"羽依里","text":"“哎？会出人命的？”"},{"op":"text","speaker":"","text":"真危险啊。"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“我手里的饵也分给你一些。”"},{"op":"text","speaker":"羽依里","text":"“嗯，谢谢。”"},{"op":"set","variable":139,"value":1},{"op":"callScene","scene":2,"target":1320},{"op":"set","variable":344,"value":1},{"op":"if","truth":false,"target":305,"value":["native","エサを所持している"]},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“咦？刚才我有没有给你很不得了的东西？”"},{"op":"goto","target":350},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"image","layer":1,"image":"i15533"},{"op":"text","speaker":"羽未","text":"“不，什么都没有！一定是错觉！”"},{"op":"goto","target":305},{"op":"callScene","scene":278,"target":2},{"op":"goto","target":319},{"op":"if","truth":false,"target":319,"value":["==",["v",6001],1]},{"op":"text","speaker":"羽依里","text":"“想想还是算了吧。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“是吗，我知道了。”"},{"op":"text","speaker":"羽依里","text":"“……你也不挽留一下我吗？”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“我不希望没有干劲的人和岛可梦对决扯上关系。”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“因为岛可梦对战不是过家家游戏。”"},{"op":"text","speaker":"","text":"是认真的眼神。"},{"op":"set","variable":139,"value":0},{"op":"goto","target":319},{"op":"goto","target":320},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i73"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"感觉今天也去了不少地方。"},{"op":"text","speaker":"","text":"虽然仓库一次都没去整理过……"},{"op":"text","speaker":"","text":"似乎真有在好好享受这个暑假。"},{"op":"text","speaker":"羽依里","text":"“呼哇～……”"},{"op":"text","speaker":"","text":"睡吧。"},{"op":"image","layer":0,"image":"i75"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"虫鸣声让人惬意。"},{"op":"text","speaker":"","text":"临睡时也能感受到小岛之夏的氛围。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"……还可以听到浪涛声……"},{"op":"text","speaker":"","text":"大海，离我这么近的吗？"},{"op":"text","speaker":"","text":"算了，毕竟是小岛……"},{"op":"text","speaker":"","text":"四面环海……"},{"op":"text","speaker":"","text":"但是，这个声音……"},{"op":"text","speaker":"","text":"总觉得，好远……"},{"op":"text","speaker":"","text":"好怀念――……"},{"op":"set","variable":1,"value":0},{"op":"set","variable":6714,"value":0},{"op":"return"},{"op":"text","speaker":"羽依里","text":"“什么东西？”"},{"op":"image","layer":1,"image":"i15445"},{"op":"text","speaker":"羽未","text":"“……内裤……”"},{"op":"goto","target":301},{"op":"end"}]