[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i512"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"到了晚上――"},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“晚饭做好了哦。”"},{"op":"text","speaker":"","text":"桌子上摆着没剥壳的鲜虾炒饭。"},{"op":"image","layer":1,"image":"i15401"},{"op":"text","speaker":"羽未","text":"“备受期待的鲜虾炒饭做好了哦。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“羽依里哥？怎么了？”"},{"op":"image","layer":257,"image":"i11581"},{"op":"text","speaker":"镜子","text":"“不坐吗？”"},{"op":"text","speaker":"羽依里","text":"“……虾。”"},{"op":"text","speaker":"羽未","text":"“嗯？”"},{"op":"text","speaker":"羽依里","text":"“虾的腹部……不觉得很像蝉的吗。”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“……”"},{"op":"image","layer":257,"image":"i11578"},{"op":"text","speaker":"镜子","text":"“……”"},{"op":"text","speaker":"","text":"3个人就这么盯着摆在炒饭上的鲜虾。"},{"op":"text","speaker":"","text":"不久羽未一言不发地站了起来，然后――"},{"op":"image","layer":1,"image":"i15335"},{"op":"text","speaker":"羽未","text":"“～～～～～！”"},{"op":"text","speaker":"","text":"开始在我身上敲来敲去。"},{"op":"image","layer":1,"image":"i15332"},{"op":"text","speaker":"羽未","text":"“为什么要说这种话――!؟”"},{"op":"text","speaker":"","text":"敲敲，敲敲。"},{"op":"text","speaker":"羽依里","text":"“对不起……”"},{"op":"text","speaker":"羽依里","text":"“因为我其实是很怕寂寞的……”"},{"op":"text","speaker":"羽依里","text":"“心理阴影这种东西，我不想一个人承受……”"},{"op":"image","layer":1,"image":"i15335"},{"op":"text","speaker":"羽未","text":"“完全不知道在说什么！”"},{"op":"text","speaker":"","text":"敲敲，敲敲。"},{"op":"image","layer":257,"image":"i11584"},{"op":"text","speaker":"镜子","text":"“哎呀，蝉吃起来和虾味道很像哦？”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i15351"},{"op":"text","speaker":"羽未","text":"“……”"},{"op":"text","speaker":"","text":"3个人再次盯着鲜虾一言不发。"},{"op":"text","speaker":"","text":"之后羽未一言不发地走到了镜子阿姨的边上，然后――"},{"op":"image","layer":1,"image":"i15343"},{"op":"text","speaker":"羽未","text":"“～～～～～！”"},{"op":"text","speaker":"","text":"开始敲打镜子阿姨。"},{"op":"return"},{"op":"end"}]