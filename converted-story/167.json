[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":1,"image":"i15496"},{"op":"text","speaker":"羽未","text":"“打电话回家？”"},{"op":"text","speaker":"羽依里","text":"“呜哦。”"},{"op":"text","speaker":"羽依里","text":"“羽未，偷听可不好哦。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“要回去了？”"},{"op":"text","speaker":"羽依里","text":"“不回去。”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“是吗。”"},{"op":"text","speaker":"","text":"既没有松口气的表情，也不是希望我赶紧回去的样子。"},{"op":"text","speaker":"","text":"硬要说的话，似乎是在担心我。"},{"op":"text","speaker":"羽依里","text":"“我拜托家里寄个东西过来。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“寄东西؟؟”"},{"op":"return"},{"op":"end"}]