[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":2,"image":"i743"},{"op":"image","layer":0,"image":"i513"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"暑假已经所剩无几。"},{"op":"clear","layer":2},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13373"},{"op":"text","speaker":"","text":"今天白羽一大早就来玩了。"},{"op":"text","speaker":"羽依里","text":"“你还真是早啊。”"},{"op":"text","speaker":"羽依里","text":"“就这么想见我吗？”"},{"op":"image","layer":1,"image":"i13390"},{"op":"text","speaker":"白羽","text":"“笨蛋，怎么可能啦。”"},{"op":"text","speaker":"羽依里","text":"“那是为什么？”"},{"op":"image","layer":1,"image":"i13259"},{"op":"text","speaker":"白羽","text":"“哎？是因为……”"},{"op":"text","speaker":"","text":"白羽苦思冥想寻找答案。"},{"op":"image","layer":1,"image":"i13317"},{"op":"text","speaker":"白羽","text":"“这个……”"},{"op":"text","speaker":"羽依里","text":"“你忘了？”"},{"op":"image","layer":1,"image":"i13304"},{"op":"text","speaker":"白羽","text":"“嗯。好奇怪啊。”"},{"op":"image","layer":1,"image":"i13235"},{"op":"text","speaker":"白羽","text":"“我好像是牵挂着什么东西……”"},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i15577"},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i15577"},{"op":"text","speaker":"白羽","text":"“哎……”"},{"op":"text","speaker":"","text":"我们吃了一惊。"},{"op":"text","speaker":"","text":"因为家里有一个不认识的女孩子。"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15576"},{"op":"text","speaker":"羽依里","text":"“……啊。”"},{"op":"text","speaker":"","text":"然后，我们为自己吃惊的事实，感到了更大的惊愕。"},{"op":"text","speaker":"","text":"她不是不认识的女孩子。"},{"op":"text","speaker":"","text":"而是我们很熟悉的女孩子。"},{"op":"text","speaker":"","text":"这个夏天，和我一起住在这房子里……"},{"op":"image","layer":257,"image":"i13319"},{"op":"text","speaker":"白羽","text":"“对啊，这个……”"},{"op":"image","layer":257,"image":"i13304"},{"op":"text","speaker":"","text":"然而，白羽的话语说到一半就戛然而止。"},{"op":"text","speaker":"","text":"而我也理解她。"},{"op":"text","speaker":"","text":"我们想不起她的名字。"},{"op":"text","speaker":"","text":"我们本应该非常熟悉她，却都想不起她的名字。"},{"op":"image","layer":257,"image":"i13346"},{"op":"text","speaker":"白羽","text":"“呃，这个……”"},{"op":"text","speaker":"羽依里","text":"“羽、羽……羽……”"},{"op":"text","speaker":"羽依里","text":"“……对了！”"},{"op":"text","speaker":"羽依里","text":"“羽未！”"},{"op":"text","speaker":"","text":"我终于想起来了。"},{"op":"image","layer":257,"image":"i13263"},{"op":"text","speaker":"白羽","text":"“啊，嗯，是羽未，羽未！”"},{"op":"text","speaker":"","text":"白羽好像也想起来了。"},{"op":"image","layer":257,"image":"i13277"},{"op":"text","speaker":"白羽","text":"“我是来看羽未的。”"},{"op":"text","speaker":"羽依里","text":"“嗯，嗯嗯，是啊。”"},{"op":"text","speaker":"羽依里","text":"“你是来看羽未的吧。”"},{"op":"text","speaker":"","text":"我们连续喊着羽未的名字，想让她安下心来。"},{"op":"text","speaker":"","text":"羽未似乎浑然不在意，只是呆呆地看着我们。"},{"op":"text","speaker":"","text":"受到打击的反而是我们。"},{"op":"text","speaker":"","text":"羽未明明就站在我们眼前，我们却想不起她的名字。"},{"op":"text","speaker":"","text":"而且，我感觉只要稍一疏忽，哪怕她就在眼前，我们也会再次忘记她。"},{"op":"text","speaker":"","text":"我必须提起精神，刻意地把羽未刻在心里才行。"},{"op":"text","speaker":"羽依里","text":"“我们约好了，今天要扔昨天折好的纸飞机呢。”"},{"op":"image","layer":257,"image":"i13248"},{"op":"text","speaker":"白羽","text":"“嗯，对对。”"},{"op":"text","speaker":"","text":"用力……"},{"op":"text","speaker":"","text":"羽未紧紧抱住了白羽的腰。"},{"op":"image","layer":1,"image":"i13235"},{"op":"image","layer":7,"image":"i15475"},{"op":"text","speaker":"羽未","text":"“呜呜……”"},{"op":"image","layer":1,"image":"i13387"},{"op":"text","speaker":"白羽","text":"“羽未？”"},{"op":"image","layer":1,"image":"i13411"},{"op":"text","speaker":"白羽","text":"“妈妈就在这里哦。”"},{"op":"image","layer":1,"image":"i13337"},{"op":"text","speaker":"白羽","text":"“没事的，知道吗？”"},{"op":"text","speaker":"","text":"白羽的话，与其说是对着羽未，更像是说给她自己听的。"},{"op":"text","speaker":"","text":"她实在担心到不行。"},{"op":"text","speaker":"","text":"而我也是一样。"},{"op":"text","speaker":"","text":"我感觉羽未的存在越来越稀薄了。"},{"op":"text","speaker":"","text":"仿佛即将就此消失不见……"},{"op":"image","layer":1,"image":"i13246"},{"op":"text","speaker":"白羽","text":"“那么，我们去外面扔纸飞机吧。”"},{"op":"image","layer":257,"image":"i15582"},{"op":"text","speaker":"羽未","text":"“（摇头）”"},{"op":"text","speaker":"","text":"羽未摇着脑袋。"},{"op":"image","layer":1,"image":"i13253"},{"op":"text","speaker":"白羽","text":"“昨天做的纸飞机，不扔了吗？”"},{"op":"image","layer":257,"image":"i15479"},{"op":"text","speaker":"羽未","text":"“（点头）”"},{"op":"text","speaker":"","text":"这回她点头了。"},{"op":"text","speaker":"","text":"完全不说话。"},{"op":"text","speaker":"羽依里","text":"“喂，羽未？”"},{"op":"text","speaker":"羽依里","text":"“你说说自己究竟想怎么做嘛。”"},{"op":"text","speaker":"","text":"我突然感到不安，如此催促道。"},{"op":"image","layer":257,"image":"i15468"},{"op":"text","speaker":"羽未","text":"“………”"},{"op":"image","layer":1,"image":"i13343"},{"op":"text","speaker":"白羽","text":"“羽未？”"},{"op":"image","layer":257,"image":"i15496"},{"op":"text","speaker":"羽未","text":"“呜……”"},{"op":"text","speaker":"","text":"就仿佛忘记了怎么说话一般，羽未一句话都不讲。"},{"op":"text","speaker":"","text":"或许她真的是忘记了怎么说话，这副模样让我们愈发不安起来。"},{"op":"text","speaker":"羽依里","text":"“算、算啦。”"},{"op":"text","speaker":"羽依里","text":"“那我们来玩点其他的吧。”"},{"op":"image","layer":1,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“嗯，是啊。”"},{"op":"image","layer":1,"image":"i13259"},{"op":"text","speaker":"白羽","text":"“我来给你念连环画吧。”"},{"op":"image","layer":257,"image":"i15566"},{"op":"text","speaker":"羽未","text":"“嗯……”"},{"op":"image","layer":1,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“那么，我来念爸爸做的那本连环画吧。”"},{"op":"image","layer":257,"image":"i15347"},{"op":"text","speaker":"羽未","text":"“嗯……”"},{"op":"text","speaker":"","text":"白羽开始给已经不会说一句话的羽未念我做的连环画。"},{"op":"image","layer":1,"image":"i13250"},{"op":"text","speaker":"白羽","text":"“很久很久以前，世界是没有颜色的。”"},{"op":"image","layer":257,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“………”"},{"op":"text","speaker":"","text":"也不知听得懂听不懂，羽未老老实实地听白羽念着。"},{"op":"text","speaker":"","text":"我也很自然地在一边听着。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i453"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"很久很久以前，世界是没有颜色的。"},{"op":"text","speaker":"","text":"在这样的世界里有一只拥有美丽翅膀的蝴蝶。"},{"op":"text","speaker":"","text":"蝴蝶四处旅行着。"},{"op":"text","speaker":"","text":"每到一个地方，蝴蝶就将自己美丽翅膀上的颜色分给遇到的人。"},{"op":"text","speaker":"","text":"等回过神来，原本很美丽的蝴蝶已经变成雪白的了。"},{"op":"text","speaker":"","text":"即便如此蝴蝶依旧继续旅行。"},{"op":"text","speaker":"","text":"哪怕翅膀残破不堪也依旧继续飞行。"},{"op":"text","speaker":"","text":"已经没人能认出，这是曾经那只美丽的蝴蝶。"},{"op":"text","speaker":"","text":"不过世界充满色彩，变得美丽起来了。"},{"op":"text","speaker":"","text":"最终蝴蝶回到了家乡，静静地停到花上。"},{"op":"text","speaker":"","text":"蝴蝶对自己能遇见那么多人感到满足。"},{"op":"text","speaker":"","text":"于是蝴蝶静静地睡去了。"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"text","speaker":"","text":"我一边听，一边想到。"},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15497"},{"op":"text","speaker":"","text":"之前我有时也会有这种感觉，这个故事似乎就是在说羽未。"},{"op":"text","speaker":"","text":"羽未是一只蝴蝶。"},{"op":"text","speaker":"","text":"旅途指的是时间旅行，羽未不断重复着这种旅程，逐渐变得残破不堪。"},{"op":"image","layer":1,"image":"i15561"},{"op":"text","speaker":"羽未","text":"“……嗯……？”"},{"op":"text","speaker":"","text":"变成了现在她这样，完全退化成幼儿的样子。"},{"op":"text","speaker":"","text":"若真是这样……"},{"op":"text","speaker":"","text":"会有连环画里画的那种结局，在等着羽未吗？"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……是我想多了。”"},{"op":"text","speaker":"","text":"我摇摇头甩掉脑中的妄想。"},{"op":"image","layer":1,"image":"i13259"},{"op":"text","speaker":"白羽","text":"“哦，对了。”"},{"op":"image","layer":1,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“这个故事还有后续吧。”"},{"op":"text","speaker":"","text":"白羽又往后翻开一页。"},{"op":"text","speaker":"","text":"就在这时……"},{"op":"image","layer":257,"image":"i15476"},{"op":"text","speaker":"羽未","text":"“……肚子……饿啦。”"},{"op":"text","speaker":"","text":"羽未说话了。"},{"op":"text","speaker":"","text":"我和白羽听到羽未时隔已久再度说出的话语，全都愣住了。"},{"op":"image","layer":1,"image":"i13274"},{"op":"text","speaker":"白羽","text":"“你肚子饿了？”"},{"op":"image","layer":257,"image":"i15479"},{"op":"text","speaker":"羽未","text":"“嗯……”"},{"op":"text","speaker":"羽依里","text":"“这样啊，你饿啦。”"},{"op":"text","speaker":"羽依里","text":"“交给我吧，爸爸来给你做一道美味的炒饭。”"},{"op":"image","layer":257,"image":"i15566"},{"op":"text","speaker":"羽未","text":"“……嗯。”"},{"op":"text","speaker":"","text":"我注意到，光是羽未说了句话，自己就高兴起来了。"},{"op":"text","speaker":"","text":"白羽也开心地笑了。"},{"op":"text","speaker":"","text":"对，欢笑吧。"},{"op":"text","speaker":"","text":"我们不是决定了，这个夏天要和羽未一起做很多快乐的事吗？"},{"op":"text","speaker":"","text":"羽未的绘图日记还没有画完。"},{"op":"text","speaker":"","text":"羽未想做的事，还没有全部做完。"},{"op":"image","layer":1,"image":"i15496"},{"op":"text","speaker":"羽依里","text":"“羽未，今天想做些什么事呀？”"},{"op":"text","speaker":"","text":"我看向她的绘图日记。"},{"op":"text","speaker":"","text":"今天这一页，画着她和妈妈一起睡觉的画面。"},{"op":"text","speaker":"","text":"屋外画着星星，看来不是一起午睡的意思。"},{"op":"text","speaker":"羽依里","text":"“今天晚上，想和妈妈一起睡吗？”"},{"op":"image","layer":1,"image":"i15434"},{"op":"text","speaker":"羽未","text":"“……嗯。”"},{"op":"text","speaker":"","text":"我看向白羽。"},{"op":"text","speaker":"","text":"白羽微笑着点点头。"},{"op":"image","layer":257,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“嗯，和妈妈一起睡吧。”"},{"op":"image","layer":1,"image":"i15472"},{"op":"text","speaker":"羽未","text":"“……嗯……”"},{"op":"text","speaker":"","text":"不过，现在离入夜还早。"},{"op":"text","speaker":"羽依里","text":"“那么，今天这一整天，我们三个一起玩吧。”"},{"op":"image","layer":1,"image":"i15593"},{"op":"text","speaker":"羽未","text":"“……嗯。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":2,"image":"i742"},{"op":"image","layer":0,"image":"i513"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"然后，我们就像回顾这一整个暑假一般玩了许多东西。"},{"op":"text","speaker":"","text":"我们折纸。"},{"op":"text","speaker":"","text":"我们唱紬教的歌。"},{"op":"text","speaker":"","text":"我们玩捉迷藏。"},{"op":"text","speaker":"","text":"不管玩哪个，羽未都带着缥缈的笑容接受了。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":2},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":1},{"op":"image","layer":2,"image":"i746"},{"op":"image","layer":0,"image":"i514"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"","text":"欢乐的一天转瞬即逝……"},{"op":"set","variable":7120,"value":2},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":2},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i431"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"到了晚上。"},{"op":"image","layer":0,"image":"i73"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"白羽打电话征得了老爷子的允许，住在了我们家。"},{"op":"text","speaker":"羽依里","text":"“好，完成啦。”"},{"op":"text","speaker":"","text":"我的房间里铺上了地铺"},{"op":"text","speaker":"","text":"被褥只有一套。"},{"op":"text","speaker":"羽依里","text":"“真的只要这一套被褥？”"},{"op":"text","speaker":"羽依里","text":"“家里被褥还有多的。”"},{"op":"image","layer":1,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“没事，我们两个睡一个被窝就好。”"},{"op":"image","layer":257,"image":"i15455"},{"op":"text","speaker":"羽未","text":"“嗯。”"},{"op":"text","speaker":"","text":"这似乎是羽未的要求。"},{"op":"text","speaker":"羽依里","text":"“那么，你们好好睡哦。”"},{"op":"image","layer":257,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“啊……”"},{"op":"image","layer":0,"image":"i261"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":1,"image":"i15338"},{"op":"text","speaker":"","text":"（抓）……"},{"op":"text","speaker":"","text":"我正准备出去，羽未拉住了我。"},{"op":"image","layer":1,"image":"i15361"},{"op":"text","speaker":"羽未","text":"“爸爸也来……”"},{"op":"text","speaker":"羽依里","text":"“哎？我？”"},{"op":"text","speaker":"羽依里","text":"“你要我也一起睡？”"},{"op":"image","layer":1,"image":"i15443"},{"op":"text","speaker":"羽未","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“呃，这个……”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i73"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我看了看白羽。"},{"op":"image","layer":1,"image":"i13381"},{"op":"text","speaker":"","text":"白羽的脸已经红了。"},{"op":"text","speaker":"","text":"她很为难。"},{"op":"text","speaker":"羽依里","text":"“这个，还是不太好吧。”"},{"op":"image","layer":1,"image":"i15428"},{"op":"text","speaker":"羽未","text":"“不要……”"},{"op":"image","layer":1,"image":"i15360"},{"op":"text","speaker":"羽未","text":"“爸爸也来……”"},{"op":"text","speaker":"","text":"然而，羽未眼睛湿润着又说了一遍。"},{"op":"text","speaker":"","text":"我也为难了。"},{"op":"image","layer":257,"image":"i13370"},{"op":"text","speaker":"白羽","text":"“好啊。”"},{"op":"text","speaker":"羽依里","text":"“哎？”"},{"op":"image","layer":257,"image":"i13340"},{"op":"text","speaker":"白羽","text":"“我没意见的。”"},{"op":"image","layer":257,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“今晚我们三个一起睡吧。”"},{"op":"text","speaker":"羽依里","text":"“呃，可是……”"},{"op":"image","layer":257,"image":"i13274"},{"op":"text","speaker":"白羽","text":"“可以的。”"},{"op":"image","layer":257,"image":"i13248"},{"op":"text","speaker":"白羽","text":"“因为羽未她想要这样嘛。”"},{"op":"image","layer":1,"image":"i15445"},{"op":"image","layer":257,"image":"i13238"},{"op":"text","speaker":"","text":"白羽带着微笑，摸了摸羽未的脑袋。"},{"op":"text","speaker":"","text":"不管是什么事，只要是羽未的心愿，就想帮她实现。白羽的这个想法，我感同身受。"},{"op":"text","speaker":"羽依里","text":"“也对啊。”"},{"op":"text","speaker":"羽依里","text":"“那么，今晚我们三个一起睡吧。”"},{"op":"image","layer":1,"image":"i15476"},{"op":"text","speaker":"羽未","text":"“……嗯。”"},{"op":"text","speaker":"羽依里","text":"“那么，至少让我再搬一床被褥来吧。”"},{"op":"image","layer":1,"image":"i15576"},{"op":"text","speaker":"羽未","text":"“不用。”"},{"op":"text","speaker":"羽依里","text":"“三个人，在一个被窝里睡？”"},{"op":"image","layer":257,"image":"i13259"},{"op":"text","speaker":"白羽","text":"“不会挤吗？”"},{"op":"image","layer":1,"image":"i15566"},{"op":"text","speaker":"羽未","text":"“没问题。”"},{"op":"image","layer":1,"image":"i15499"},{"op":"text","speaker":"羽未","text":"“抱紧一起睡。”"},{"op":"text","speaker":"","text":"她是要我们紧挨在一起睡啊。"},{"op":"text","speaker":"","text":"这好像也会有不少问题……"},{"op":"text","speaker":"","text":"但中间还夹着羽未，应该没关系吧。"},{"op":"text","speaker":"羽依里","text":"“那么，就这样吧。”"},{"op":"image","layer":257,"image":"i13322"},{"op":"text","speaker":"白羽","text":"“嗯……”"},{"op":"image","layer":1,"image":"i15347"},{"op":"text","speaker":"羽未","text":"“嗯，睡觉。”"},{"op":"text","speaker":"","text":"羽未躺到了被窝的正中间。"},{"op":"text","speaker":"羽依里","text":"“现在就睡了吗？”"},{"op":"image","layer":257,"image":"i13280"},{"op":"text","speaker":"白羽","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“是这样啊……”"},{"op":"text","speaker":"","text":"紧张起来了。"},{"op":"text","speaker":"","text":"我们开始做睡前准备。"},{"op":"text","speaker":"","text":"换好衣服……"},{"op":"text","speaker":"","text":"虽然我没有什么邪念，但还是心跳不止。"},{"op":"text","speaker":"羽依里","text":"“那我关灯咯。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i1460"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我们三个睡在一个被窝里。"},{"op":"text","speaker":"","text":"睡成一个川字形。"},{"op":"text","speaker":"","text":"当然，睡在最中间的是羽未。"},{"op":"image","layer":0,"image":"i1459"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“你那边会不会觉得挤？没问题吗？”"},{"op":"text","speaker":"羽依里","text":"“还行吧。”"},{"op":"text","speaker":"","text":"虽然半边胳膊和腿基本是露在外面的。"},{"op":"text","speaker":"羽未","text":"“♪”"},{"op":"text","speaker":"","text":"有我和白羽陪在两边，羽未似乎心情很好。"},{"op":"text","speaker":"","text":"话虽如此，她还是几乎一句话都不说。"},{"op":"text","speaker":"","text":"可即使是这样，依旧能感觉到她的欢快。"},{"op":"text","speaker":"白羽","text":"“我们明天玩什么呢？”"},{"op":"text","speaker":"羽依里","text":"“这对话，真像是小学生的暑假啊。”"},{"op":"text","speaker":"白羽","text":"“嘻嘻，是啊。”"},{"op":"text","speaker":"羽依里","text":"“不过羽未本来就是小学生，也没问题吧。”"},{"op":"text","speaker":"羽未","text":"“……嗯。”"},{"op":"text","speaker":"羽依里","text":"“那么，我们明天做什么呢？”"},{"op":"text","speaker":"","text":"在昏暗的房间里聊着明天的事情，就让我感到非常充实。"},{"op":"text","speaker":"","text":"所谓的幸福，或许就是这样吧。"},{"op":"text","speaker":"","text":"要是时间就这样停住该多好……"},{"op":"text","speaker":"","text":"我突然这样想到。"},{"op":"text","speaker":"","text":"可是，我们聊的又是明天的话题。"},{"op":"text","speaker":"","text":"是未来的话题。"},{"op":"text","speaker":"","text":"要是时间停住了，未来就不会到来了。"},{"op":"text","speaker":"","text":"这种矛盾让我自己都觉得荒诞。"},{"op":"text","speaker":"白羽","text":"“哦，对了。”"},{"op":"text","speaker":"白羽","text":"“明天有烟花看哦。”"},{"op":"text","speaker":"羽依里","text":"“是大的那种烟花吗？”"},{"op":"text","speaker":"白羽","text":"“嗯，向天上发射的烟花。”"},{"op":"text","speaker":"白羽","text":"“这座岛上一年一度的烟花大会。”"},{"op":"text","speaker":"白羽","text":"“以此宣告夏天的结束。”"},{"op":"text","speaker":"羽依里","text":"“这样啊。”"},{"op":"text","speaker":"","text":"夏天的结束，这样听来又有些寂寥。"},{"op":"text","speaker":"","text":"仿佛在预示这段时光就要结束了。"},{"op":"text","speaker":"","text":"最让我感到恐惧的是，仿佛这样和羽未一起度过的时光会消失不见。"},{"op":"text","speaker":"","text":"但是，我不能表现出来。"},{"op":"text","speaker":"羽依里","text":"“那还真是期待啊。”"},{"op":"text","speaker":"","text":"于是我拼命强撑着说道。"},{"op":"text","speaker":"羽依里","text":"“羽未，有烟花看哦。”"},{"op":"text","speaker":"羽依里","text":"“你看过大烟花吗？”"},{"op":"text","speaker":"羽未","text":"“？”"},{"op":"text","speaker":"羽依里","text":"“算啦，反正明天就能看到了。”"},{"op":"text","speaker":"白羽","text":"“我们一起看烟花吧。”"},{"op":"text","speaker":"羽未","text":"“……嗯。”"},{"op":"text","speaker":"羽未","text":"“……很、期待。”"},{"op":"text","speaker":"","text":"羽未磕磕巴巴地说着，面露微笑。"},{"op":"text","speaker":"","text":"她的笑容，已经像是要睡着了。"},{"op":"text","speaker":"白羽","text":"“我们睡吧。”"},{"op":"text","speaker":"白羽","text":"“晚安。”"},{"op":"text","speaker":"羽未","text":"“……嗯。”"},{"op":"text","speaker":"羽未","text":"“晚……安……”"},{"op":"text","speaker":"羽依里","text":"“嗯，晚安。”"},{"op":"image","layer":0,"image":"i1461"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"羽未不一会儿就沉入了梦乡。"},{"op":"text","speaker":"","text":"仿佛能源耗尽了一般。"},{"op":"text","speaker":"","text":"羽未就这样呼呼睡着，而白羽则带着微笑，轻柔地抚摸着她的头。"},{"op":"text","speaker":"","text":"我满怀幸福地看着她们，向无形的力量祈祷着，只愿这样的时光能永远延续下去。"},{"op":"image","layer":0,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i1462"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":512},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]