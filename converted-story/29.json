[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"if","truth":false,"target":5,"value":["==",["v",6003],1]},{"op":"callScene","scene":31,"target":2},{"op":"goto","target":131},{"op":"if","truth":false,"target":8,"value":["==",["v",6003],2]},{"op":"callScene","scene":30,"target":2},{"op":"goto","target":131},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“早。”"},{"op":"image","layer":1,"image":"i15487"},{"op":"text","speaker":"羽未","text":"“早上好。”"},{"op":"text","speaker":"","text":"羽未趴在桌子上。"},{"op":"text","speaker":"羽依里","text":"“怎么了？”"},{"op":"text","speaker":"羽依里","text":"“感冒？”"},{"op":"image","layer":1,"image":"i15482"},{"op":"text","speaker":"羽未","text":"“好像又不是。”"},{"op":"image","layer":1,"image":"i15485"},{"op":"text","speaker":"羽未","text":"“但就是觉得乏力。”"},{"op":"text","speaker":"羽依里","text":"“中暑了吧。”"},{"op":"image","layer":1,"image":"i15479"},{"op":"text","speaker":"羽未","text":"“中暑…应该是吧。”"},{"op":"image","layer":1,"image":"i15487"},{"op":"text","speaker":"羽未","text":"“所以就没有准备早餐，对不起。”"},{"op":"text","speaker":"羽依里","text":"“我倒无所谓。”"},{"op":"text","speaker":"羽依里","text":"“不过羽未还是吃点营养的东西比较好。”"},{"op":"image","layer":1,"image":"i15485"},{"op":"text","speaker":"羽未","text":"“唔，没有食欲。”"},{"op":"text","speaker":"羽依里","text":"“好。”"},{"op":"text","speaker":"羽依里","text":"“我去弄点补充精力的东西。”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“可以吗？”"},{"op":"text","speaker":"羽依里","text":"“羽未好好歇着吧。”"},{"op":"image","layer":1,"image":"i15363"},{"op":"text","speaker":"羽未","text":"“谢谢。”"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i156"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"说得倒是潇洒……"},{"op":"text","speaker":"","text":"不过上哪去弄呢。"},{"op":"text","speaker":"","text":"羽未去参加广播体操的时候会顺道去港口拿些食材。"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i1"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"就是港口了。"},{"op":"text","speaker":"","text":"应该是已经结束捕捞了吧，基本都看不到人影了。"},{"op":"text","speaker":"羽依里","text":"“你好。”"},{"op":"text","speaker":"渔夫A","text":"“……”"},{"op":"text","speaker":"","text":"粗犷的渔夫们纷纷对我投来怀疑的眼神。"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"莫名感觉到了一股杀气。"},{"op":"text","speaker":"","text":"连猫的眼神都显得锐利。"},{"op":"text","speaker":"","text":"因为羽未每天都会带回东西，我还想着气氛会更加祥和一些。"},{"op":"text","speaker":"猫","text":"“吓……”"},{"op":"text","speaker":"羽依里","text":"“我才不抢你的呢。”"},{"op":"text","speaker":"猫","text":"“呀……”"},{"op":"text","speaker":"羽依里","text":"“羽未是怎么要到的……”"},{"op":"text","speaker":"","text":"说一声请给我鱼就行了吗？"},{"op":"text","speaker":"","text":"不过也只能这样了吧。"},{"op":"text","speaker":"羽依里","text":"“请给我鱼。”"},{"op":"text","speaker":"渔夫A","text":"“……”"},{"op":"text","speaker":"渔夫A","text":"“鱼店买去。”"},{"op":"text","speaker":"羽依里","text":"“好的。”"},{"op":"text","speaker":"","text":"去找鱼店吧……"},{"op":"text","speaker":"渔夫A","text":"“你是来加藤婆婆家的那家伙吗？”"},{"op":"text","speaker":"羽依里","text":"“唉，是的。”"},{"op":"text","speaker":"渔夫A","text":"“这样啊。”"},{"op":"text","speaker":"渔夫A","text":"“……”"},{"op":"text","speaker":"","text":"对方盯着我陷入了思考。"},{"op":"text","speaker":"渔夫A","text":"“失恋很痛苦吧。”"},{"op":"text","speaker":"羽依里","text":"“是的……”"},{"op":"text","speaker":"羽依里","text":"“等等，什么？”"},{"op":"text","speaker":"渔夫A","text":"“失恋得伤心欲绝吧。”"},{"op":"text","speaker":"渔夫A","text":"“所以才会来这座岛。”"},{"op":"text","speaker":"渔夫B","text":"“不对不对，是没考上大学所以沮丧着呢，对吧。”"},{"op":"text","speaker":"渔夫C","text":"“我听说是疼爱的吉娃娃死掉了。”"},{"op":"text","speaker":"羽依里","text":"“随便你们了吧。”"},{"op":"text","speaker":"渔夫A","text":"“对了，小哥你家那女娃今天不来吗？”"},{"op":"text","speaker":"羽依里","text":"“羽未身体有些不适。”"},{"op":"text","speaker":"羽依里","text":"“所以我才……”"},{"op":"text","speaker":"渔夫A","text":"“什么!؟”"},{"op":"text","speaker":"渔夫B","text":"“她怎么了؟؟”"},{"op":"text","speaker":"羽依里","text":"“好像是中暑了。”"},{"op":"text","speaker":"渔夫A","text":"“中暑的话就吃这个，拿去。”"},{"op":"text","speaker":"羽依里","text":"“这是……鳗鱼؟؟”"},{"op":"text","speaker":"渔夫A","text":"“没错。”"},{"op":"text","speaker":"羽依里","text":"“鳗鱼在海里也能捕到吗？”"},{"op":"text","speaker":"渔夫A","text":"“那是当然。”"},{"op":"text","speaker":"渔夫B","text":"“和河里的鳗鱼味道可不同哦。”"},{"op":"text","speaker":"羽依里","text":"“喔……”"},{"op":"text","speaker":"羽依里","text":"“这么贵重的东西，真的能收下吗？”"},{"op":"text","speaker":"渔夫A","text":"“小妹妹可帮了我不少忙。”"},{"op":"text","speaker":"渔夫A","text":"“就是她化解了我的夫妻危机。”"},{"op":"text","speaker":"渔夫B","text":"“我是靠她治好了肩周炎。”"},{"op":"text","speaker":"","text":"羽未啊，你到底都在做些什么啊。"},{"op":"text","speaker":"羽依里","text":"“那，我就收下了。”"},{"op":"text","speaker":"渔夫A","text":"“嗯。”"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"渔夫大叔们当场帮我剖好了鱼。"},{"op":"text","speaker":"","text":"用渔夫秘制的酱汁做成了蒲烧。"},{"op":"text","speaker":"","text":"这下一定能补充好精力了。"},{"op":"text","speaker":"羽依里","text":"“我回来了，羽未。”"},{"op":"text","speaker":"羽依里","text":"“咦？羽未？”"},{"op":"text","speaker":"羽依里","text":"“羽未，我带早饭回来了。”"},{"op":"text","speaker":"","text":"没人回应。"},{"op":"text","speaker":"","text":"不在吗？"},{"op":"text","speaker":"","text":"等等，桌上有留字条。"},{"op":"text","speaker":"羽依里","text":"“我看看……”"},{"op":"text","speaker":"羽依里","text":"“‘我已经好了，所以就出去玩了。’”"},{"op":"text","speaker":"羽依里","text":"“……这样啊……”"},{"op":"text","speaker":"","text":"看来羽未身体无碍了。"},{"op":"text","speaker":"羽依里","text":"“太好了。”"},{"op":"text","speaker":"羽依里","text":"“可是。”"},{"op":"text","speaker":"","text":"刚做好的蒲烧，香味四溢。"},{"op":"text","speaker":"羽依里","text":"“我开动了。”"},{"op":"text","speaker":"","text":"于是我吃掉了。"},{"op":"text","speaker":"羽依里","text":"“……真、真好吃。”"},{"op":"text","speaker":"羽依里","text":"“鳗鱼居然是这么柔软热乎的吗？”"},{"op":"text","speaker":"羽依里","text":"“这秘制酱汁……也是让人着迷啊！”"},{"op":"text","speaker":"","text":"好好享用了一番鳗鱼。"},{"op":"text","speaker":"","text":"这下就能挺过夏季了。"},{"op":"text","speaker":"羽依里","text":"“承蒙款待。”"},{"op":"text","speaker":"羽依里","text":"“好了……”"},{"op":"text","speaker":"羽依里","text":"“我也出去溜达下吧。”"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"return"},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“我回来了。”"},{"op":"text","speaker":"羽依里","text":"“……咦？羽未？”"},{"op":"text","speaker":"","text":"平时都会出来迎接我的。"},{"op":"image","layer":1,"image":"i11584"},{"op":"text","speaker":"镜子","text":"“啊，羽依里。”"},{"op":"image","layer":1,"image":"i11549"},{"op":"text","speaker":"镜子","text":"“今天羽未累了，就睡下了。”"},{"op":"if","truth":false,"target":151,"value":["==",["v",6003],0]},{"op":"text","speaker":"羽依里","text":"“咦？她不是说中暑已经好了吗？”"},{"op":"image","layer":1,"image":"i11546"},{"op":"text","speaker":"镜子","text":"“嗯，好像只是玩累了。”"},{"op":"text","speaker":"羽依里","text":"“哦。”"},{"op":"goto","target":152},{"op":"text","speaker":"羽依里","text":"“对了，她中暑了。”"},{"op":"text","speaker":"","text":"那还是安静一些，别吵到她了。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"if","truth":false,"target":297,"value":["||",["&&",[">",["v",24006],0],["==",["v",39],1]],["==",["v",419],1]]},{"op":"text","speaker":"","text":"不过，总不能不吃饭吧。"},{"op":"text","speaker":"","text":"现在没有羽未的炒饭，只能去外面吃了。"},{"op":"set","variable":1,"value":0},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":1,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i35"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"出门准备找个地方吃饭。"},{"op":"text","speaker":"","text":"说是找个地方，不过也只有那家食堂。"},{"op":"text","speaker":"","text":"……那是。"},{"op":"text","speaker":"","text":"铁塔上微微看见一个人影。"},{"op":"text","speaker":"","text":"是野美希吧。"},{"op":"text","speaker":"羽依里","text":"“喂！”"},{"op":"text","speaker":"","text":"远远地隐约地看见她也在向我招手。"},{"op":"text","speaker":"羽依里","text":"“去不去吃饭？”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"过了一会。"},{"op":"text","speaker":"","text":"纸团飞了过来。"},{"op":"text","speaker":"","text":"‘行吧，等着。’"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i35"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"大约过了10分钟，野美希来到了跟前。"},{"op":"image","layer":1,"image":"i11709"},{"op":"text","speaker":"美希","text":"“这么晚了在做什么呢。”"},{"op":"text","speaker":"","text":"她面带不悦地出现。"},{"op":"text","speaker":"羽依里","text":"“这是我的台词。”"},{"op":"image","layer":1,"image":"i11731"},{"op":"text","speaker":"美希","text":"“我只是在监视。”"},{"op":"text","speaker":"羽依里","text":"“监视……”"},{"op":"text","speaker":"羽依里","text":"“你现在应该正值被人监视的年纪吧。”"},{"op":"text","speaker":"","text":"不过我也没资格说别人。"},{"op":"text","speaker":"羽依里","text":"“父母会担心的。”"},{"op":"image","layer":1,"image":"i11693"},{"op":"text","speaker":"美希","text":"“……”"},{"op":"text","speaker":"","text":"野美希微微一笑。"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“没问题的，我一个人住。”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i17"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"和往常一样，食堂里没有其他客人。"},{"op":"text","speaker":"","text":"我和野美希围着桌子吃起了有点迟的晚饭。"},{"op":"image","layer":1,"image":"i11696"},{"op":"text","speaker":"美希","text":"“我的父母没有过世，他们好着呢。”"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“我是从岛外来的，租住在这里。”"},{"op":"image","layer":1,"image":"i11715"},{"op":"text","speaker":"美希","text":"“和你有点相似吧。”"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“现在一个人住在公寓里。”"},{"op":"text","speaker":"羽依里","text":"“这岛上居然还有公寓啊。”"},{"op":"image","layer":1,"image":"i11766"},{"op":"text","speaker":"美希","text":"“只有一栋啦。”"},{"op":"image","layer":1,"image":"i11780"},{"op":"text","speaker":"美希","text":"“原本是作为公所的宿舍建的，不过现在没人住。”"},{"op":"image","layer":1,"image":"i11766"},{"op":"text","speaker":"美希","text":"“顺带一提只有我一个人住在里面。”"},{"op":"text","speaker":"羽依里","text":"“这…这是什么情况啊。”"},{"op":"text","speaker":"羽依里","text":"“不会孤单吗？”"},{"op":"image","layer":1,"image":"i11773"},{"op":"text","speaker":"美希","text":"“……唉。”"},{"op":"image","layer":1,"image":"i11771"},{"op":"text","speaker":"美希","text":"“这个嘛，或多或少吧。”"},{"op":"text","speaker":"","text":"或多或少能克服的意思吗？"},{"op":"text","speaker":"","text":"或多或少有些孤单的意思吗？"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":1,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i39"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"……回程途中。"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“无论几点，岛上都会有些零星的灯光。”"},{"op":"image","layer":1,"image":"i11696"},{"op":"text","speaker":"美希","text":"“我喜欢从铁塔上看着这些灯光。”"},{"op":"text","speaker":"羽依里","text":"“是嘛。”"},{"op":"image","layer":1,"image":"i11693"},{"op":"text","speaker":"美希","text":"“…呼。”"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“说了些莫名其妙的话啊。”"},{"op":"text","speaker":"羽依里","text":"“没有的事。”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"羽依里","text":"“你看。”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i516"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"指向天空。"},{"op":"image","layer":7,"image":"i11711"},{"op":"text","speaker":"美希","text":"“星星？”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“天空的繁星如此闪耀。”"},{"op":"text","speaker":"羽依里","text":"“你却看着村中灯火。”"},{"op":"image","layer":7,"image":"i11730"},{"op":"text","speaker":"美希","text":"“……”"},{"op":"image","layer":7,"image":"i11714"},{"op":"text","speaker":"美希","text":"“嗯。”"},{"op":"image","layer":7,"image":"i11695"},{"op":"text","speaker":"美希","text":"“因为繁星太遥远。”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“不过灯火或许也并没有那么近。”"},{"op":"image","layer":7,"image":"i11727"},{"op":"text","speaker":"美希","text":"“嗯……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":7,"image":"i11727"},{"op":"text","speaker":"美希","text":"“……”"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i35"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“那再见了。”"},{"op":"image","layer":1,"image":"i11696"},{"op":"text","speaker":"美希","text":"“好。”"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i39"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"回想起来是不是有些尬聊了。"},{"op":"text","speaker":"","text":"算了，不管了。"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"goto","target":415},{"op":"text","speaker":"","text":"不过还真是闲啊。"},{"op":"text","speaker":"","text":"说起来，昨天良一不是有提到夜钓……"},{"op":"text","speaker":"","text":"去海边看看吧。"},{"op":"set","variable":1,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i50"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"空无一人。"},{"op":"text","speaker":"","text":"一片漆黑。"},{"op":"text","speaker":"","text":"这种时间应该没人钓鱼吧。"},{"op":"text","speaker":"羽依里","text":"“？”"},{"op":"text","speaker":"","text":"咦……有人坐在岩石上。"},{"op":"text","speaker":"","text":"黑发及肩的高挑女子。"},{"op":"text","speaker":"","text":"好像是一个人在看海。"},{"op":"text","speaker":"","text":"显得有些寂寞，或者说有点怪……"},{"op":"text","speaker":"","text":"心中好奇。"},{"op":"text","speaker":"","text":"小心翼翼地靠近。"},{"op":"text","speaker":"","text":"怎么形容呢，越看越觉得不自然。"},{"op":"text","speaker":"","text":"不知是不是错觉，女子的头看起来湿漉漉的。"},{"op":"text","speaker":"","text":"略带点恐怖气息。"},{"op":"text","speaker":"","text":"虽然有些激动，但心中的恐惧亦是难掩。"},{"op":"text","speaker":"羽依里","text":"“请问…”"},{"op":"text","speaker":"女性？","text":"“!؟”"},{"op":"text","speaker":"","text":"突然被人搭话，女子一个激灵回过头来。"},{"op":"text","speaker":"","text":"脑袋应声而落。"},{"op":"text","speaker":"羽依里","text":"“噫！”"},{"op":"text","speaker":"女性？","text":"“干什么啊。”"},{"op":"text","speaker":"","text":"声音出乎意料的沙哑……"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i50"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“咦？”"},{"op":"text","speaker":"羽依里","text":"“天善؟؟”"},{"op":"image","layer":1,"image":"i15008"},{"op":"text","speaker":"天善","text":"“没错。”"},{"op":"image","layer":1,"image":"i15038"},{"op":"text","speaker":"天善","text":"“你在做什么？”"},{"op":"text","speaker":"羽依里","text":"“我还想问你呢。”"},{"op":"text","speaker":"羽依里","text":"“你的头……不，你的头发整个掉了下来……”"},{"op":"image","layer":1,"image":"i15014"},{"op":"text","speaker":"天善","text":"“哦，这个呀。原来如此……难怪你会惊讶。”"},{"op":"text","speaker":"","text":"说着，天善将落在脚下像是头发一样的物件捡了起来。"},{"op":"image","layer":1,"image":"i15011"},{"op":"text","speaker":"天善","text":"“这是裙带菜。”"},{"op":"text","speaker":"羽依里","text":"“这样啊。”"},{"op":"image","layer":1,"image":"i15038"},{"op":"text","speaker":"天善","text":"“……没错。”"},{"op":"text","speaker":"羽依里","text":"“……嗯”"},{"op":"text","speaker":"","text":"莫名其妙。"},{"op":"image","layer":1,"image":"i15008"},{"op":"text","speaker":"天善","text":"“我在夜间锻炼。”"},{"op":"image","layer":1,"image":"i15038"},{"op":"text","speaker":"天善","text":"“像这样把裙带菜罩在头上，就能冷却有些发热的脑袋。”"},{"op":"image","layer":1,"image":"i15014"},{"op":"text","speaker":"天善","text":"“很适合思考问题。”"},{"op":"text","speaker":"羽依里","text":"“……是、是嘛。”"},{"op":"text","speaker":"","text":"依旧是莫名其妙。"},{"op":"image","layer":1,"image":"i15011"},{"op":"text","speaker":"天善","text":"“你要试试吗？”"},{"op":"text","speaker":"","text":"他向我递出裙带菜。"},{"op":"choice","variable":6001,"items":[{"text":"拒绝","value":0,"condition":1},{"text":"试试看","value":1,"condition":1}]},{"op":"if","truth":false,"target":372,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“我拒绝。”"},{"op":"text","speaker":"","text":"当即回答。"},{"op":"image","layer":1,"image":"i15014"},{"op":"text","speaker":"天善","text":"“嗯，也是。等你有兴趣了随时来找我吧。”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"text","speaker":"","text":"外出游荡，结果遇到了这种怪玩意。"},{"op":"text","speaker":"","text":"还是回去吧。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"goto","target":415},{"op":"text","speaker":"羽依里","text":"“或许有点兴趣。”"},{"op":"image","layer":1,"image":"i15041"},{"op":"text","speaker":"天善","text":"“是吗？”"},{"op":"text","speaker":"","text":"隐约觉得天善露出了笑容。"},{"op":"image","layer":1,"image":"i15011"},{"op":"text","speaker":"天善","text":"“我刚好有备用的裙带菜。”"},{"op":"text","speaker":"羽依里","text":"“备用的裙带菜……”"},{"op":"text","speaker":"","text":"接过他递来的湿漉漉的裙带菜。"},{"op":"text","speaker":"","text":"虽然有一丝犹豫，但还是学着天善罩在了头上。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":1795,"image":"i25676"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":0,"image":"i50"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":1,"image":"i15011"},{"op":"text","speaker":"天善","text":"“……”"},{"op":"text","speaker":"","text":"这……"},{"op":"text","speaker":"羽依里","text":"“确实思维变得清晰了许多。”"},{"op":"text","speaker":"","text":"有够新鲜的。"},{"op":"image","layer":1,"image":"i15014"},{"op":"text","speaker":"天善","text":"“没错吧。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i15008"},{"op":"text","speaker":"天善","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“说来，你在思考什么呢？”"},{"op":"image","layer":1,"image":"i15038"},{"op":"text","speaker":"天善","text":"“我吗？”"},{"op":"image","layer":1,"image":"i15032"},{"op":"text","speaker":"天善","text":"“这个嘛。”"},{"op":"image","layer":1,"image":"i15014"},{"op":"text","speaker":"天善","text":"“我在想明天要进行怎样的特训。”"},{"op":"text","speaker":"羽依里","text":"“这样啊。”"},{"op":"text","speaker":"","text":"无关紧要的事情。"},{"op":"clear","layer":1795},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"text","speaker":"","text":"然后，在当天夜里……"},{"op":"image","layer":0,"image":"i516"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“呼……呼……”"},{"op":"text","speaker":"羽依里","text":"“唔～……炒饭～……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"嗡嗡嗡～～～……"},{"op":"image","layer":0,"image":"i75"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"嗡嗡嗡～～～……"},{"op":"image","layer":0,"image":"i73"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……在哪里？”"},{"op":"text","speaker":"","text":"盯上我血液的那些“家伙”就在这里。"},{"op":"text","speaker":"","text":"虽然还没被叮，但稍有不慎……"},{"op":"text","speaker":"","text":"就会中招。"},{"op":"text","speaker":"羽依里","text":"“没办法了。”"},{"op":"text","speaker":"","text":"我将手臂伸了出去，内侧柔软的部分朝上。"},{"op":"text","speaker":"羽依里","text":"“来吧。”"},{"op":"text","speaker":"羽依里","text":"“当你叮咬这里的时候，就是你的死期。”"},{"op":"text","speaker":"","text":"摆出丰盛大餐，静静等候。"},{"op":"text","speaker":"","text":"不动声色。"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"羽依里","text":"“逃了吗？”"},{"op":"text","speaker":"羽依里","text":"“睡吧。”"},{"op":"image","layer":0,"image":"i75"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“呼……”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"羽依里","text":"“呼……呼……”"},{"op":"text","speaker":"","text":"嗡嗡嗡～～～……"},{"op":"text","speaker":"羽依里","text":"“噢噢噢噢噢！”"},{"op":"image","layer":0,"image":"i73"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“休想叮咬到我！”"},{"op":"text","speaker":"羽依里","text":"“可恶……手段太卑劣了。”"},{"op":"text","speaker":"羽依里","text":"“是让我精神疲惫的战术吗？”"},{"op":"text","speaker":"羽依里","text":"“耳边的扇翅声为什么那么令人心烦。”"},{"op":"text","speaker":"","text":"而且一开灯就没影了。"},{"op":"image","layer":0,"image":"i75"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"if","truth":false,"target":468,"value":["==",["v",139],1]},{"op":"text","speaker":"羽依里","text":"“哎……”"},{"op":"text","speaker":"","text":"还要设置岛可梦对战的饵……"},{"op":"text","speaker":"","text":"与其白费力与蚊子作战，或许外出一趟也是个选择。"},{"op":"callScene","scene":278,"target":1592},{"op":"return"},{"op":"goto","target":488},{"op":"if","truth":false,"target":488,"value":["==",["v",441],1]},{"op":"text","speaker":"羽依里","text":"“啊……”"},{"op":"text","speaker":"","text":"说起来，明天就是岛乒对战的正式比赛了……"},{"op":"text","speaker":"","text":"嗯，尽力而为吧。"},{"op":"image","layer":0,"image":"i73"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"","text":"我握紧了从天善那里借来的球拍。"},{"op":"text","speaker":"","text":"嗡嗡嗡～～～……"},{"op":"text","speaker":"羽依里","text":"“就是这里！”"},{"op":"text","speaker":"","text":"唰……"},{"op":"text","speaker":"羽依里","text":"“原来如此”"},{"op":"text","speaker":"羽依里","text":"“挥拍时的风压太强，反而打不到蚊子……吗”"},{"op":"text","speaker":"羽依里","text":"“看来我的才能是要白白浪费了”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"羽依里","text":"“睡觉吧”"},{"op":"image","layer":0,"image":"i75"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"goto","target":488},{"op":"text","speaker":"","text":"嗡嗡～～～……"},{"op":"image","layer":0,"image":"i516"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“唔噢噢噢噢噢噢！”"},{"op":"text","speaker":"","text":"结果，虽然没被叮咬到，但睡眠时间却少了不少……"},{"op":"return"},{"op":"end"}]