[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“我开动了。”"},{"op":"image","layer":1,"image":"i15547"},{"op":"text","speaker":"羽未","text":"“我开动了。”"},{"op":"text","speaker":"羽依里","text":"“今天是什么炒饭……”"},{"op":"text","speaker":"羽依里","text":"“有种奇特的味道。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“我尝试加了纳豆。”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“不过，这给人的感觉像是纳豆里加了炒饭。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“别人给了我他们家自制的纳豆。”"},{"op":"text","speaker":"羽依里","text":"“不……我想说的不是这个……”"},{"op":"image","layer":1,"image":"i15455"},{"op":"text","speaker":"羽未","text":"“有想吃的东西我可以帮你去拿哦。”"},{"op":"text","speaker":"羽依里","text":"“想吃的东西啊。”"},{"op":"text","speaker":"羽依里","text":"“面包吧。”"},{"op":"image","layer":1,"image":"i15468"},{"op":"text","speaker":"羽未","text":"“面包炒饭？”"},{"op":"text","speaker":"羽依里","text":"“别别。不用炒进去。”"},{"op":"text","speaker":"羽依里","text":"“我早餐习惯吃面包。在家时一直是这样的。”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“哎……面包……”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“面包和味噌汤不搭哦。”"},{"op":"text","speaker":"羽依里","text":"“不搭，也别搭一起。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“那么，搭个什么汤呢。”"},{"op":"text","speaker":"羽依里","text":"“汤不好搭啊。”"},{"op":"text","speaker":"羽依里","text":"“换个其他的。”"},{"op":"text","speaker":"羽依里","text":"“玉米浓汤。”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“……”"},{"op":"image","layer":1,"image":"i15353"},{"op":"text","speaker":"羽未","text":"“浓汤？”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“浓汤和吐司可以吗？”"},{"op":"text","speaker":"羽依里","text":"“虽说都是面包吧……”"},{"op":"text","speaker":"羽依里","text":"“牛角面包。”"},{"op":"image","layer":1,"image":"i15378"},{"op":"text","speaker":"羽未","text":"“牛角面包؟!”"},{"op":"text","speaker":"羽依里","text":"“顺便问一下喝的呢…”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“卡布奇诺。”"},{"op":"image","layer":1,"image":"i15353"},{"op":"text","speaker":"羽未","text":"“卡布奇诺؟!”"},{"op":"text","speaker":"羽依里","text":"“最后是。”"},{"op":"text","speaker":"羽依里","text":"“新鲜橙汁。”"},{"op":"image","layer":1,"image":"i15378"},{"op":"text","speaker":"羽未","text":"“新鲜橙汁؟!”"},{"op":"text","speaker":"羽依里","text":"“为什么你这么吃惊啊。”"},{"op":"image","layer":1,"image":"i15465"},{"op":"text","speaker":"羽未","text":"“这些单词太不像会从羽依里哥嘴里说出来的了，我无法掩饰内心的动摇。”"},{"op":"image","layer":1,"image":"i15460"},{"op":"text","speaker":"羽未","text":"“好吧，我会努力一下的。”"},{"op":"text","speaker":"羽依里","text":"“咦，你会帮我准备吗。”"},{"op":"image","layer":1,"image":"i15465"},{"op":"text","speaker":"羽未","text":"“不是说想吃吗。”"},{"op":"text","speaker":"羽依里","text":"“话是没错。”"},{"op":"text","speaker":"羽依里","text":"“不用勉强的。”"},{"op":"image","layer":1,"image":"i15387"},{"op":"text","speaker":"羽未","text":"“真是受不了。”"},{"op":"image","layer":1,"image":"i15389"},{"op":"text","speaker":"羽未","text":"“想吃？还是不想吃？”"},{"op":"text","speaker":"羽依里","text":"“想、想吃。”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“那我去准备。”"},{"op":"text","speaker":"羽依里","text":"“谢、谢谢。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"text","speaker":"","text":"吃完早饭后，我决定今天也去岛上转转。"},{"op":"return"},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i516"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":7,"image":"i15371"},{"op":"text","speaker":"羽未","text":"“羽依里哥。”"},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“？”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“浴室似乎是坏掉了。”"},{"op":"image","layer":1,"image":"i15363"},{"op":"text","speaker":"羽未","text":"“要到明天才能修好。”"},{"op":"text","speaker":"羽依里","text":"“淋浴也放不出水了吗？”"},{"op":"image","layer":1,"image":"i15366"},{"op":"text","speaker":"羽未","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“那今天只好不洗了。”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“呃……难以置信……这可是夏天哦？”"},{"op":"text","speaker":"羽依里","text":"“说是这么说，又不能在厨房冲澡。”"},{"op":"text","speaker":"羽依里","text":"“借用一下小学泳池的淋浴呢。”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“大晚上的，很冷的哦。”"},{"op":"text","speaker":"羽依里","text":"“倒也是。”"},{"op":"text","speaker":"","text":"虽说晚上某人也会去。"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“公所附近似乎有公共浴室。”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“去那里吧。”"},{"op":"text","speaker":"羽依里","text":"“公共浴室。”"},{"op":"text","speaker":"","text":"好像有点意思。"},{"op":"text","speaker":"羽依里","text":"“但说是说公所附近，但走路还挺远的，天色又黑。”"},{"op":"image","layer":1,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“羽依里哥，我记得你会骑摩托车吧。”"},{"op":"text","speaker":"羽依里","text":"“那辆幼兽啊。”"},{"op":"image","layer":1,"image":"i15455"},{"op":"text","speaker":"羽未","text":"“后面似乎能坐人的吧。”"},{"op":"text","speaker":"羽依里","text":"“硬要说的话那是货架。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“不要在意细节了。”"},{"op":"goto","target":202},{"op":"text","speaker":"羽依里","text":"“羽未你呢，不怕吗？”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“没事的。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i516"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":7,"image":"i15324"},{"op":"text","speaker":"羽未","text":"“好舒服”"},{"op":"text","speaker":"羽依里","text":"“是吧。”"},{"op":"image","layer":7,"image":"i15320"},{"op":"text","speaker":"羽未","text":"“等我16岁了，我要去考驾照。”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i86"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"公共浴室前。"},{"op":"text","speaker":"羽依里","text":"“感觉人不少啊。”"},{"op":"image","layer":1,"image":"i15468"},{"op":"text","speaker":"羽未","text":"“什么情况啊？”"},{"op":"text","speaker":"家庭主妇A","text":"“你家也是吗。”"},{"op":"text","speaker":"家庭主妇B","text":"“突然就不出水了。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“似乎不少家的都出毛病了。”"},{"op":"text","speaker":"羽依里","text":"“说不定是水源出问题了。”"},{"op":"text","speaker":"","text":"那么，说不定会看到熟人……"},{"op":"text","speaker":"声音","text":"“啊。”"},{"op":"text","speaker":"羽依里","text":"“？”"},{"op":"image","layer":257,"image":"i13274"},{"op":"text","speaker":"","text":"回头一看。"},{"op":"text","speaker":"羽依里","text":"“啊。”"},{"op":"image","layer":257,"image":"i13235"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"的确是熟人。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"白羽轻轻点头致意后，进入了浴室。"},{"op":"text","speaker":"","text":"我也点了点头，尽管慢了一拍。"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“……”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“青春期？”"},{"op":"text","speaker":"羽依里","text":"“哪有!؟”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"text","speaker":"羽依里","text":"“呼。”"},{"op":"text","speaker":"","text":"泡澡真是太舒服了。"},{"op":"text","speaker":"","text":"不过果然，似乎各户人家的浴室都发生了故障，人特别多。"},{"op":"text","speaker":"","text":"虽然习惯了被裸体男人包围，但这感觉并不好。"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"羽依里","text":"“羽未好慢啊。”"},{"op":"text","speaker":"","text":"我又不好先回去。"},{"op":"text","speaker":"؟؟؟","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“啊，怎么这么慢。羽未……”"},{"op":"image","layer":1,"image":"i13235"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"image","layer":1,"image":"i13274"},{"op":"text","speaker":"白羽","text":"“很正常吧……”"},{"op":"image","layer":1,"image":"i13250"},{"op":"text","speaker":"白羽","text":"“我觉得。”"},{"op":"text","speaker":"羽依里","text":"“是啊。”"},{"op":"image","layer":1,"image":"i13235"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"走掉了。"},{"op":"text","speaker":"","text":"为什么会认错人啊。"},{"op":"text","speaker":"","text":"话说回来，刚出浴……吗。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“哇。”"},{"op":"text","speaker":"羽依里","text":"“你出来了啊。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“青春期？”"},{"op":"text","speaker":"羽依里","text":"“哪有!؟”"},{"op":"return"},{"op":"image","layer":1,"image":"i15408"},{"op":"text","speaker":"羽未","text":"“岛上没人管的。”"},{"op":"text","speaker":"羽依里","text":"“……是、是吗。”"},{"op":"text","speaker":"羽依里","text":"“岛上没人管啊。”"},{"op":"goto","target":118},{"op":"end"}]