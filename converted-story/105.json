[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i12165"},{"op":"text","speaker":"良一","text":"“嘿，欢迎！”"},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"image","layer":1,"image":"i12150"},{"op":"text","speaker":"良一","text":"“别露出那么失望的表情好不好。”"},{"op":"image","layer":1,"image":"i12147"},{"op":"text","speaker":"良一","text":"“我也会受伤的啊？”"},{"op":"text","speaker":"羽依里","text":"“不，我只是在想你在这干什么呢。”"},{"op":"image","layer":1,"image":"i12174"},{"op":"text","speaker":"良一","text":"“看店。”"},{"op":"text","speaker":"羽依里","text":"“老奶奶呢？”"},{"op":"image","layer":1,"image":"i12171"},{"op":"text","speaker":"良一","text":"“不在。”"},{"op":"text","speaker":"羽依里","text":"“……苍呢？”"},{"op":"image","layer":1,"image":"i12174"},{"op":"text","speaker":"良一","text":"“那边。”"},{"op":"image","layer":7,"image":"i10150"},{"op":"text","speaker":"苍","text":"“……嘶……嘶……”"},{"op":"text","speaker":"","text":"苍正坐在店内的椅子上，睡得十分香甜。"},{"op":"image","layer":1,"image":"i12171"},{"op":"text","speaker":"良一","text":"“我来的时候就已经是这个样子了。”"},{"op":"text","speaker":"羽依里","text":"“这样都能拿工钱的话，这工打得还真舒服。”"},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“重要的是店里有人在。”"},{"op":"if","truth":false,"target":35,"value":["==",["v",92],1]},{"op":"text","speaker":"羽依里","text":"“确实……所以上次让我来看店的吗。”"},{"op":"image","layer":1,"image":"i12162"},{"op":"text","speaker":"良一","text":"“哦，什么啊，你也已经体验过了吗。”"},{"op":"image","layer":1,"image":"i12159"},{"op":"text","speaker":"良一","text":"“婆婆真是不管谁都会拜托看店呢。”"},{"op":"goto","target":42},{"op":"text","speaker":"羽依里","text":"“所以，现在是是你在看店？”"},{"op":"image","layer":1,"image":"i12165"},{"op":"text","speaker":"良一","text":"“接下来就轮到你了。”"},{"op":"text","speaker":"羽依里","text":"“那什么，这样不太好吧。”"},{"op":"image","layer":1,"image":"i12162"},{"op":"text","speaker":"良一","text":"“没事没事，婆婆不在乎是谁在看店的啦。”"},{"op":"text","speaker":"羽依里","text":"“……这也很有问题吧。”"},{"op":"image","layer":1,"image":"i12141"},{"op":"text","speaker":"良一","text":"“不过，再怎么说也不会让观光客这类岛外人来看店。”"},{"op":"text","speaker":"羽依里","text":"“我也是岛外人啊……”"},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“你是加藤婆婆的亲戚啊，和岛上的人没差。”"},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"text","speaker":"","text":"怎么说呢，这种感觉不坏。"},{"op":"text","speaker":"","text":"不，应该说是有些开心。"},{"op":"image","layer":1,"image":"i12162"},{"op":"text","speaker":"良一","text":"“那，接下来就交给你了。”"},{"op":"text","speaker":"","text":"良一离开了后，就换我来看店了。"},{"op":"image","layer":7,"image":"i10150"},{"op":"text","speaker":"苍","text":"“……嘶……嘶……”"},{"op":"text","speaker":"羽依里","text":"“算了，总比睡在外面的要好。”"},{"op":"image","layer":7,"image":"i10126"},{"op":"text","speaker":"苍","text":"“嗯……嗯～……零食要在300万日元以内～……呜……”"},{"op":"text","speaker":"羽依里","text":"“是在做春游的梦吗。”"},{"op":"image","layer":7,"image":"i10150"},{"op":"text","speaker":"苍","text":"“哈姆……姆呢姆呢……”"},{"op":"text","speaker":"","text":"嘴巴在动。"},{"op":"text","speaker":"羽依里","text":"“……唔。”"},{"op":"text","speaker":"","text":"突然想到了个恶作剧。"},{"op":"text","speaker":"","text":"从口袋里拿出钱包后，在篮子里放了300日元。"},{"op":"text","speaker":"","text":"然后开始挑选等价的零食。"},{"op":"text","speaker":"羽依里","text":"“我看看……”"},{"op":"choice","variable":6001,"items":[{"text":"让她吃蒲烧太郎","value":0,"condition":1},{"text":"让她吃烤肉太郎","value":1,"condition":1},{"text":"让她吃芥末太郎","value":2,"condition":1}]},{"op":"if","truth":false,"target":95,"value":["==",["v",6001],0]},{"op":"text","speaker":"","text":"我打开蒲烧太郎的袋子。"},{"op":"text","speaker":"","text":"甜香味扑面而来。"},{"op":"text","speaker":"羽依里","text":"“来，张嘴。”"},{"op":"image","layer":0,"image":"i196"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i10169"},{"op":"text","speaker":"苍","text":"“嗯……啊――……”"},{"op":"image","layer":1,"image":"i10193"},{"op":"text","speaker":"苍","text":"“嗯……吧嗒吧嗒……”"},{"op":"image","layer":1,"image":"i10169"},{"op":"text","speaker":"苍","text":"“这是……蒲烧鳗鱼……”"},{"op":"text","speaker":"羽依里","text":"“虽然原料里并没有鳗鱼。”"},{"op":"image","layer":1,"image":"i10371"},{"op":"text","speaker":"苍","text":"“鳗鱼……鳗鱼的生态充满了神秘……”"},{"op":"text","speaker":"羽依里","text":"“嗯……？”"},{"op":"image","layer":1,"image":"i10380"},{"op":"text","speaker":"苍","text":"“鳗鱼在海里产下的卵……成长为鱼苗后开始太平洋洄游……然后再游到河里……”"},{"op":"image","layer":1,"image":"i10364"},{"op":"text","speaker":"苍","text":"“在湖泊河川长大后……又回到海里产卵……”"},{"op":"text","speaker":"羽依里","text":"“是吗……”"},{"op":"image","layer":1,"image":"i10380"},{"op":"text","speaker":"苍","text":"“迟早会……濒临灭绝……”"},{"op":"text","speaker":"羽依里","text":"“唉？真的假的？”"},{"op":"text","speaker":"","text":"不知为何，苍说起了深奥的鳗鱼梦话。"},{"op":"goto","target":150},{"op":"if","truth":false,"target":123,"value":["==",["v",6001],1]},{"op":"text","speaker":"","text":"我打开烤肉太郎的袋子，拿出内容物。"},{"op":"text","speaker":"","text":"沾满甜味酱汁的烤肉香扑面而来。"},{"op":"text","speaker":"羽依里","text":"“来，张嘴。”"},{"op":"image","layer":0,"image":"i196"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i10169"},{"op":"text","speaker":"苍","text":"“嗯……呼哇……”"},{"op":"image","layer":1,"image":"i10193"},{"op":"text","speaker":"苍","text":"“唔……嗯咕咕……”"},{"op":"image","layer":1,"image":"i10169"},{"op":"text","speaker":"苍","text":"“这是……烤肉……牛肉……”"},{"op":"text","speaker":"羽依里","text":"“虽然原料其实是鳕鱼碎末。”"},{"op":"image","layer":1,"image":"i10380"},{"op":"text","speaker":"苍","text":"“牛……在印度教里是神圣的存在……是不能吃的……”"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"image","layer":1,"image":"i10371"},{"op":"text","speaker":"苍","text":"“即使是在日本，平民百姓也是在明治以后才开始食用……”"},{"op":"image","layer":1,"image":"i10364"},{"op":"text","speaker":"苍","text":"“在那之前……牛更像是家人般的存在……”"},{"op":"text","speaker":"羽依里","text":"“是吗……”"},{"op":"image","layer":1,"image":"i10380"},{"op":"text","speaker":"苍","text":"“吃的时候，还要以药用为借口才能吃……”"},{"op":"text","speaker":"羽依里","text":"“过去的人也是够受的啊……”"},{"op":"text","speaker":"","text":"苍不知为何聊起了牛。"},{"op":"text","speaker":"","text":"而我也因此又聪明了一分。"},{"op":"goto","target":150},{"op":"text","speaker":"","text":"我打开芥末太郎的袋子。"},{"op":"text","speaker":"","text":"芥末那刺激的香味直冲我的鼻腔。"},{"op":"text","speaker":"羽依里","text":"“想吃零食的人举手。”"},{"op":"image","layer":0,"image":"i196"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i10169"},{"op":"text","speaker":"苍","text":"“……我……”"},{"op":"text","speaker":"","text":"我将芥末太郎喂给了做出回应并张开嘴的苍。"},{"op":"image","layer":1,"image":"i10193"},{"op":"text","speaker":"苍","text":"“我吃……姆呢姆呢……”"},{"op":"image","layer":1,"image":"i10169"},{"op":"text","speaker":"苍","text":"“这是……芥，末……”"},{"op":"text","speaker":"羽依里","text":"“呃，果然一下子就尝出来了呢。”"},{"op":"image","layer":1,"image":"i10380"},{"op":"text","speaker":"苍","text":"“芥末……是生长在溪流这类清澈水源……旁……边……的……”"},{"op":"text","speaker":"羽依里","text":"“喂，怎么了？”"},{"op":"text","speaker":"","text":"不知为何，感觉有点痛苦的样子。"},{"op":"image","layer":1,"image":"i10371"},{"op":"text","speaker":"苍","text":"“芥……末的……嗯咕……”"},{"op":"image","layer":1,"image":"i10380"},{"op":"text","speaker":"苍","text":"“疙瘩……间距越短……质量……也就……越好……”"},{"op":"text","speaker":"羽依里","text":"“嗯，然后呢？”"},{"op":"image","layer":1,"image":"i10371"},{"op":"text","speaker":"苍","text":"“姆唔……呜……呜呜……”"},{"op":"text","speaker":"","text":"是被芥末给冲到了吗，苍流着泪露出了痛苦的表情。"},{"op":"text","speaker":"","text":"看来就算是零食，芥末还是不容小觑。"},{"op":"text","speaker":"羽依里","text":"“还要吃吗？”"},{"op":"image","layer":1,"image":"i10128"},{"op":"text","speaker":"苍","text":"“……要，吃……”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"虽然我内心浮现出了这家伙是否真的在睡觉的疑问，但还是决定继续找别的零食喂她。"},{"op":"choice","variable":6001,"items":[{"text":"让她吃美味棒","value":0,"condition":1},{"text":"让她吃阳伞巧克力","value":1,"condition":1},{"text":"让她吃果冻条","value":2,"condition":1}]},{"op":"if","truth":false,"target":179,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“那么，给她吃美味棒好了。”"},{"op":"text","speaker":"","text":"我撕开手上印着神似某猫型机器人角色的包装。"},{"op":"text","speaker":"羽依里","text":"“这次是沙拉味的。”"},{"op":"text","speaker":"羽依里","text":"“来，张嘴。”"},{"op":"image","layer":0,"image":"i196"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i10169"},{"op":"text","speaker":"苍","text":"“啊……嗯。”"},{"op":"image","layer":1,"image":"i10193"},{"op":"text","speaker":"苍","text":"“哈，唔……嗯……嗯嗯……呜呜……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i10380"},{"op":"text","speaker":"苍","text":"“嗯，唔……呜呜……咳咳，咳咳……!؟”"},{"op":"text","speaker":"羽依里","text":"“喂、喂，你没事吧？”"},{"op":"goto","target":663},{"op":"text","speaker":"","text":"一下子成了个大红脸。"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"goto","target":238},{"op":"if","truth":false,"target":204,"value":["==",["v",6001],1]},{"op":"text","speaker":"羽依里","text":"“那，这个如何？阳伞巧克力。”"},{"op":"text","speaker":"","text":"我撕开做成闭合阳伞状巧克力的铝箔纸。"},{"op":"text","speaker":"羽依里","text":"“别因为是巧克力就一下子全咬碎了哦？”"},{"op":"image","layer":0,"image":"i196"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i10169"},{"op":"text","speaker":"苍","text":"“嗯～……知道了……”"},{"op":"image","layer":1,"image":"i10371"},{"op":"text","speaker":"苍","text":"“哈，啊……舔舔……舔舔……啾……”"},{"op":"goto","target":667},{"op":"image","layer":1,"image":"i10380"},{"op":"text","speaker":"苍","text":"“嗯…啊呜……”"},{"op":"text","speaker":"羽依里","text":"“唉……？”"},{"op":"text","speaker":"","text":"忽然苍一口咬住巧克力，阳伞巧克力被咬掉了差不多一半。"},{"op":"text","speaker":"","text":"咔嚓一下……！"},{"op":"text","speaker":"羽依里","text":"“噫……！”"},{"op":"text","speaker":"","text":"不知为何下身一凉。"},{"op":"image","layer":1,"image":"i10348"},{"op":"text","speaker":"苍","text":"“嗯……唔……咬……吧唧吧唧……”"},{"op":"text","speaker":"","text":"阳伞巧克力，在苍的嘴里变得支离破碎……"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"goto","target":238},{"op":"text","speaker":"羽依里","text":"“要吃果冻条吗？”"},{"op":"image","layer":0,"image":"i196"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i10193"},{"op":"text","speaker":"苍","text":"“嗯……要吃……”"},{"op":"text","speaker":"","text":"用剪刀剪开塑胶包装的开口。"},{"op":"text","speaker":"羽依里","text":"“这是酸奶味的呢。”"},{"op":"text","speaker":"羽依里","text":"“来，张开嘴。”"},{"op":"image","layer":1,"image":"i10169"},{"op":"text","speaker":"苍","text":"“啊―……”"},{"op":"image","layer":1,"image":"i10364"},{"op":"text","speaker":"苍","text":"“哈，唔……啊唔……嗯呜……”"},{"op":"text","speaker":"","text":"原本是自己慢慢挤出果冻一点一点吃的零食。"},{"op":"text","speaker":"","text":"不过睡着的苍可没那么大的本事，所以就由我代为挤出来。"},{"op":"text","speaker":"羽依里","text":"“嘿！”"},{"op":"text","speaker":"","text":"扑哧！"},{"op":"image","layer":1,"image":"i10371"},{"op":"text","speaker":"苍","text":"“哈呜!؟”"},{"op":"text","speaker":"羽依里","text":"“啊，抱歉！”"},{"op":"text","speaker":"","text":"一不小心用力过头，将果冻一口气全挤进了苍的嘴里。"},{"op":"image","layer":1,"image":"i10380"},{"op":"text","speaker":"苍","text":"“嗯……呜呜……唔噗……”"},{"op":"goto","target":672},{"op":"text","speaker":"羽依里","text":" “呜哇啊啊啊啊啊啊啊！” "},{"op":"text","speaker":"","text":"慌慌张张地用手擦了擦苍的嘴角。"},{"op":"goto","target":674},{"op":"image","layer":1,"image":"i10364"},{"op":"text","speaker":"苍","text":"“我……还要～……”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“不行！果冻已经一滴不剩了！”"},{"op":"image","layer":7,"image":"i10150"},{"op":"text","speaker":"苍","text":"“……嘶……嘶……”"},{"op":"text","speaker":"羽依里","text":"“这、这次真是够险的……”"},{"op":"goto","target":676},{"op":"text","speaker":"羽依里","text":"“冷静点……我要冷静。”"},{"op":"text","speaker":"","text":"冷静……"},{"op":"text","speaker":"羽依里","text":"“……要吃刨冰吗？”"},{"op":"image","layer":7,"image":"i10111"},{"op":"text","speaker":"苍","text":"“要！”"},{"op":"text","speaker":"","text":"不知为何，她这句梦话就非常有力。"},{"op":"text","speaker":"","text":"我从冰柜里拿出冰块，放进刨冰机里。"},{"op":"text","speaker":"","text":"转动把手，伴随着沙沙沙这种让人愉快的声音，冰沙逐渐堆积在了器皿里。"},{"op":"text","speaker":"羽依里","text":"“哦哦……”"},{"op":"text","speaker":"羽依里","text":"“这可真好玩！”"},{"op":"image","layer":0,"image":"i158"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"兴致一下子来了后，一不小心就做了大量的刨冰。"},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“苍。”"},{"op":"text","speaker":"羽依里","text":"“草莓、蜜瓜、柠檬、蓝色夏威夷。你要哪种？”"},{"op":"image","layer":7,"image":"i10150"},{"op":"text","speaker":"苍","text":"“……蓝色夏威夷。”"},{"op":"text","speaker":"羽依里","text":"“姑且还是会选的啊……”"},{"op":"image","layer":7,"image":"i10167"},{"op":"text","speaker":"苍","text":"“……不过味道全都一样。”"},{"op":"text","speaker":"羽依里","text":"“啊，我刚想这么说……”"},{"op":"image","layer":0,"image":"i196"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i10193"},{"op":"text","speaker":"","text":"带着一丝扫兴，我在刨冰上浇满蓝色的糖浆后回到了苍的身边。"},{"op":"text","speaker":"羽依里","text":"“来，张嘴。”"},{"op":"image","layer":1,"image":"i10169"},{"op":"text","speaker":"苍","text":"“啊～……”"},{"op":"text","speaker":"","text":"用勺子将刨冰喂进苍的嘴里。"},{"op":"image","layer":1,"image":"i10371"},{"op":"text","speaker":"苍","text":"“哈唔……嗯……”"},{"op":"image","layer":1,"image":"i10364"},{"op":"text","speaker":"苍","text":"“哎嘿……”"},{"op":"image","layer":1,"image":"i10348"},{"op":"text","speaker":"","text":"苍露出了幸福的笑容。"},{"op":"image","layer":1,"image":"i10364"},{"op":"text","speaker":"苍","text":"“啊～……”"},{"op":"text","speaker":"","text":"像是在催我一般，又张开了嘴。"},{"op":"text","speaker":"羽依里","text":"“来。”"},{"op":"image","layer":1,"image":"i10371"},{"op":"text","speaker":"苍","text":"“啊唔……嗯……嗯嗯……”"},{"op":"image","layer":1,"image":"i10364"},{"op":"text","speaker":"苍","text":"“哎嘿……”"},{"op":"text","speaker":"","text":"又笑了。"},{"op":"text","speaker":"","text":"我也开始渐渐高兴了起来。"},{"op":"text","speaker":"","text":"该怎么形容这感觉呢……"},{"op":"text","speaker":"","text":"难道说……"},{"op":"choice","variable":6001,"items":[{"text":"这就是恋爱……！","value":0,"condition":1},{"text":"这就是母性……！","value":1,"condition":1},{"text":"这就是喂养……！","value":2,"condition":1}]},{"op":"if","truth":false,"target":298,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“这就是恋爱……！”"},{"op":"text","speaker":"","text":"为了一个女生而做点什么。"},{"op":"text","speaker":"","text":"不，是想要为她而去做些什么的这份心情。"},{"op":"text","speaker":"","text":"原来如此……"},{"op":"text","speaker":"","text":"这就是恋爱吗……"},{"op":"text","speaker":"羽依里","text":"“等等，我可没那么容易动情。”"},{"op":"goto","target":322},{"op":"if","truth":false,"target":306,"value":["==",["v",6001],1]},{"op":"text","speaker":"羽依里","text":"“这就是母性……！”"},{"op":"text","speaker":"","text":"让她吃东西感到的喜悦……"},{"op":"text","speaker":"","text":"就像是给自己孩子喂奶时一般的，不求回报的爱。"},{"op":"text","speaker":"","text":"原来如此……"},{"op":"text","speaker":"","text":"这就是母性吗……"},{"op":"text","speaker":"羽依里","text":"“等等，我是男的啊。”"},{"op":"goto","target":322},{"op":"text","speaker":"羽依里","text":"“这就是喂养……！”"},{"op":"text","speaker":"","text":"那样的话，我现在就像是在调教苍一样。"},{"op":"text","speaker":"","text":"又抄起了一勺刨冰，放在了苍的嘴边。"},{"op":"image","layer":1,"image":"i10152"},{"op":"text","speaker":"苍","text":"“啊～……”"},{"op":"text","speaker":"羽依里","text":"“停。”"},{"op":"image","layer":1,"image":"i10128"},{"op":"text","speaker":"苍","text":"“嗯啊……”"},{"op":"text","speaker":"","text":"苍一下子就定住了。"},{"op":"text","speaker":"","text":"而刨冰就在她眼前……"},{"op":"text","speaker":"","text":"在伸出舌头就能够舔到的距离，默默地忍着。"},{"op":"text","speaker":"羽依里","text":"“吃吧。”"},{"op":"image","layer":1,"image":"i10364"},{"op":"text","speaker":"苍","text":"“啊呜……”"},{"op":"text","speaker":"羽依里","text":"“好好，乖孩子。”"},{"op":"text","speaker":"","text":"给苍的喂食成功了。"},{"op":"image","layer":1,"image":"i10193"},{"op":"text","speaker":"苍","text":"“啊～……”"},{"op":"text","speaker":"","text":"苍不停催我快点给下一勺。"},{"op":"text","speaker":"","text":"而我也来了性子，不停喂她继续吃。"},{"op":"image","layer":1,"image":"i10128"},{"op":"text","speaker":"苍","text":"“呜呜……啊……头……痛……”"},{"op":"text","speaker":"","text":"一口气吃了太多凉的东西后的那种感觉向她袭来。"},{"op":"image","layer":1,"image":"i10371"},{"op":"text","speaker":"苍","text":"“这，这……”"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"image","layer":1,"image":"i10380"},{"op":"text","speaker":"苍","text":"“这头疼的正式名称是……冰淇淋头疼……”"},{"op":"text","speaker":"羽依里","text":"“哦，原来是叫这个名字啊。”"},{"op":"image","layer":1,"image":"i10371"},{"op":"text","speaker":"苍","text":"“治疗方法是……将冰冷的东西……抵在额头……”"},{"op":"text","speaker":"羽依里","text":"“咦？这有治疗方法的吗？”"},{"op":"image","layer":1,"image":"i10380"},{"op":"text","speaker":"苍","text":"“呜呜……头好痛……快……快点……”"},{"op":"text","speaker":"羽依里","text":"“那，好吧……先这样看看。”"},{"op":"text","speaker":"","text":"按她所说，我将盛着刨冰的器皿放在了苍的额头上。"},{"op":"image","layer":1,"image":"i10371"},{"op":"text","speaker":"苍","text":"“哈呜呜……”"},{"op":"text","speaker":"羽依里","text":"“没，没事吧？”"},{"op":"image","layer":1,"image":"i10364"},{"op":"text","speaker":"苍","text":"“不过……开始不疼了……好，舒服……”"},{"op":"text","speaker":"羽依里","text":"“还真的有效啊，这个……”"},{"op":"image","layer":1,"image":"i10172"},{"op":"text","speaker":"苍","text":"“嗯……嗯……”"},{"op":"text","speaker":"","text":"苍慢慢睁开眼睛，看着我。"},{"op":"image","layer":1,"image":"i10187"},{"op":"text","speaker":"苍","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“……早安。”"},{"op":"image","layer":515,"image":"i18121"},{"op":"image","layer":1,"image":"i10139"},{"op":"text","speaker":"苍","text":"“呜哇啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊!؟”"},{"op":"clear","layer":515},{"op":"clear","layer":768},{"op":"clear","layer":1024},{"op":"image","layer":1,"image":"i10177"},{"op":"text","speaker":"苍","text":"“怎，怎么回事!؟入室抢劫!؟夜袭!؟”"},{"op":"text","speaker":"羽依里","text":"“啊，笨蛋，乱动的话――……”"},{"op":"text","speaker":"","text":"抵在苍额头上的刨冰从我手中滑落。"},{"op":"text","speaker":"","text":"结果――"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i508"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":7,"image":"i10178"},{"op":"text","speaker":"苍","text":"“呀啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊!؟”"},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"保持正座的姿势看店，苍用毛巾擦着头发从店内走了出来。"},{"op":"image","layer":1,"image":"i10162"},{"op":"text","speaker":"苍","text":"“你这人……真干不出什么正经事……”"},{"op":"text","speaker":"羽依里","text":"“不怪我啊，谁让你刚才吃得那么香。”"},{"op":"image","layer":1,"image":"i10288"},{"op":"text","speaker":"苍","text":"“而且，你碰熟睡的女孩子的嘴唇是什么意思？”"},{"op":"text","speaker":"羽依里","text":"“让我心跳不已啊。”"},{"op":"image","layer":1,"image":"i10208"},{"op":"text","speaker":"苍","text":"“又不是在问你的感想。”"},{"op":"text","speaker":"羽依里","text":"“……我出发点是好的。”"},{"op":"text","speaker":"羽依里","text":"“你看起来吃得很香……一不留神就……”"},{"op":"image","layer":1,"image":"i10290"},{"op":"text","speaker":"苍","text":"“城市里流行这么玩吗？”"},{"op":"text","speaker":"羽依里","text":"“不，完全没有。”"},{"op":"image","layer":1,"image":"i10319"},{"op":"text","speaker":"苍","text":"“那么，就是你的特殊嗜好了。”"},{"op":"text","speaker":"羽依里","text":"“看来我在乡下觉醒了奇怪的爱好。”"},{"op":"text","speaker":"羽依里","text":"“这就是夏天给人带来的成长吗。”"},{"op":"image","layer":1,"image":"i10208"},{"op":"text","speaker":"苍","text":"“你的成长方向就不能正常一点吗！”"},{"op":"text","speaker":"羽依里","text":"“抱歉……”"},{"op":"text","speaker":"羽依里","text":"“作为赔礼，我来帮忙看店。”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"苍","text":"“这不是理所当然的吗。”"},{"op":"text","speaker":"羽依里","text":"“我去外面扫地。”"},{"op":"image","layer":1,"image":"i10210"},{"op":"text","speaker":"苍","text":"“真是的……”"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"text","speaker":"","text":"打扫完外面后，我回到了店里。"},{"op":"text","speaker":"羽依里","text":"“一下子就扫完了。”"},{"op":"text","speaker":"苍","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“苍？喂……”"},{"op":"image","layer":7,"image":"i10150"},{"op":"text","speaker":"苍","text":"“……嘶……嘶……”"},{"op":"text","speaker":"羽依里","text":"“这睡得也太快了吧……”"},{"op":"text","speaker":"羽依里","text":"“话说，她这是打算睡多久啊……”"},{"op":"text","speaker":"","text":"我在苍的身边坐了下来，等待顾客的到来。"},{"op":"text","speaker":"羽依里","text":"“不过话说回来……”"},{"op":"text","speaker":"羽依里","text":"“真就是没个客人呢……”"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":1},{"op":"image","layer":0,"image":"i9"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"小卖铺的老奶奶","text":"“……我回来了，小苍。”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“……”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“哎呀哎呀……这还真是。”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“感情这么好，真不错。”"},{"op":"image","layer":7,"image":"i10150"},{"op":"text","speaker":"苍","text":"“……嘶……嘶……”"},{"op":"text","speaker":"羽依里","text":"“……呼……呼……”"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i512"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"text","speaker":"羽依里","text":"“……睡不着。”"},{"op":"image","layer":0,"image":"i72"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"或许是白天在小卖铺睡过了，到了晚上也依然精神十足。"},{"op":"text","speaker":"","text":"反正明天也没有什么事，所以就算熬夜也没问题。"},{"op":"text","speaker":"","text":"不过，和在自己家时候不一样，这里没有能打发时间的方法在。"},{"op":"text","speaker":"","text":"跑到客厅里看电视的话，又会吵到羽未和镜子阿姨睡觉。"},{"op":"text","speaker":"羽依里","text":"“没办法……”"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i39"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"只好出门，独自一人在深夜的鸟白岛散步。"},{"op":"text","speaker":"","text":"外面除了我以外，一个人都没有。"},{"op":"text","speaker":"","text":"在灯火稀少的这座岛，一抬头便能看见满天的繁星。"},{"op":"image","layer":0,"image":"i170"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“这下，可是起到反作用了。”"},{"op":"text","speaker":"","text":"在城市里绝对看不到的景色让我兴奋不已，完全没有了睡意。"},{"op":"text","speaker":"","text":"不过，这样的感觉也不错。"},{"op":"text","speaker":"","text":"反正明天也没什么事。"},{"op":"text","speaker":"羽依里","text":"“……嗯？”"},{"op":"image","layer":0,"image":"i39"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"忽然，我注意到在视野的角落，似乎出现了一点亮光。"},{"op":"text","speaker":"羽依里","text":"“什么？”"},{"op":"text","speaker":"","text":"我转向那边定睛细看。"},{"op":"image","layer":0,"image":"i227"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"是山那边。"},{"op":"text","speaker":"","text":"那小小的光芒，忽明忽暗地闪烁着。"},{"op":"text","speaker":"","text":"既不是灯光，也不是星光。"},{"op":"text","speaker":"","text":"那是……"},{"op":"text","speaker":"羽依里","text":"“火光……？”"},{"op":"text","speaker":"","text":"那略带着点红的微弱光芒。"},{"op":"text","speaker":"","text":"闪烁着在风中摇曳。"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"image","layer":0,"image":"i39"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“应该不是……山里失火了吧。”"},{"op":"text","speaker":"","text":"灯火看上去是在慢慢移动的样子。"},{"op":"text","speaker":"羽依里","text":"“令人在意啊……”"},{"op":"choice","variable":6001,"items":[{"text":"去看看","value":0,"condition":1},{"text":"不去","value":1,"condition":1}]},{"op":"if","truth":false,"target":640,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“……去看看吧。”"},{"op":"text","speaker":"羽依里","text":"“而且稍微爬爬山累了的话，也会更加容易入睡。”"},{"op":"text","speaker":"","text":"被完全吊起了好奇心后，我为了揭开灯火的本来面目而开始向山里前进。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i442"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"单手拿着在家里找到的手电筒，走在漆黑的山道上。"},{"op":"text","speaker":"","text":"夜晚的山比我想象的要更暗一些。"},{"op":"text","speaker":"","text":"星光被树木遮挡，几乎派不上什么用场。"},{"op":"text","speaker":"","text":"如果手电筒没电了的话，那可真就什么都看不见了。"},{"op":"image","layer":0,"image":"i46"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“呃……我记得，最开始看到那灯火，就是在这一带才对……”"},{"op":"if","truth":false,"target":556,"value":["==",["*",["*",["v",88],["v",90]],["v",92]],0]},{"op":"text","speaker":"","text":"我用手电筒照了照周围。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"移动手上的光源时，有那么一瞬间，感觉好像有一双反射了光芒的瞳孔出现在其中。"},{"op":"text","speaker":"羽依里","text":"“唉……”"},{"op":"text","speaker":"","text":"急忙将手电筒照了回来。"},{"op":"text","speaker":"稻荷","text":" “嘭――――！” "},{"op":"text","speaker":"羽依里","text":" “哇啊啊啊啊啊啊啊啊!؟” "},{"op":"text","speaker":"","text":"面对突然出现的凶兽，我不由得发出了惨叫。"},{"op":"text","speaker":"羽依里","text":"“啊啊啊啊啊……啊？”"},{"op":"text","speaker":"羽依里","text":"“唉……稻荷？”"},{"op":"image","layer":1,"image":"i10699"},{"op":"text","speaker":"稻荷","text":"“嘭。”"},{"op":"text","speaker":"羽依里","text":"“别，别吓我啊……”"},{"op":"image","layer":1,"image":"i10694"},{"op":"text","speaker":"稻荷","text":"“啾……”"},{"op":"text","speaker":"羽依里","text":"“嗯？既然你在这里，难道苍也在？”"},{"op":"text","speaker":"","text":"将手电筒四处照了照。"},{"op":"text","speaker":"","text":"并没有发现苍的身影。"},{"op":"text","speaker":"羽依里","text":"“也是，怎么说也不会有人这种时候跑到山里来。”"},{"op":"text","speaker":"羽依里","text":"“不过，这么说起来的话，你这家伙是野生的？”"},{"op":"image","layer":1,"image":"i10670"},{"op":"text","speaker":"稻荷","text":"“嘭。”"},{"op":"text","speaker":"","text":"叫了一声后，稻荷转身向山的深处跑去。"},{"op":"text","speaker":"羽依里","text":"“啊……”"},{"op":"text","speaker":"羽依里","text":"“……跑掉了。”"},{"op":"text","speaker":"","text":"稻荷刚消失，一种被抛弃在这里的寂寞感忽然就涌上心头。"},{"op":"text","speaker":"","text":"仔细想想的话，半夜三更跑到这种深山老林里是很危险的。"},{"op":"text","speaker":"","text":"狐狸倒是还好，刚才的要是野猪这类危险野生动物的话……"},{"op":"text","speaker":"羽依里","text":"“回家吧……”"},{"op":"text","speaker":"","text":"我折回头，加快脚步下山。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i39"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“呼……有路灯就让人放心了。”"},{"op":"text","speaker":"","text":"回头看了看刚才的山。"},{"op":"text","speaker":"","text":"话说，刚才看到的像是火光的光芒到底是怎么回事。"},{"op":"text","speaker":"羽依里","text":"“……狐火，之类的吗？”"},{"op":"text","speaker":"","text":"毕竟还看到了稻荷。"},{"op":"text","speaker":"羽依里","text":"“哈哈，是超自然现象吧。”"},{"op":"text","speaker":"羽依里","text":"“……超自然现象。”"},{"op":"text","speaker":"","text":"说出口后又开始后怕了。"},{"op":"text","speaker":"羽依里","text":"“呜呜……快点回家吧……”"},{"op":"text","speaker":"","text":"乡下的夜晚，比想象的还要吓人。"},{"op":"set","variable":93,"value":1},{"op":"if","truth":false,"target":555,"value":["==",["v",139],1]},{"op":"text","speaker":"","text":"忽然，我停下了回家的脚步。"},{"op":"text","speaker":"羽依里","text":"“啊……对了，得设置岛可梦对战的饵才行。”"},{"op":"text","speaker":"","text":"就算乡下的夜晚再怎么吓人，也无法阻止身为斗士的我。"},{"op":"text","speaker":"","text":"毕竟，我是斗士啊。"},{"op":"text","speaker":"","text":"不过，今晚应该怎么办呢……"},{"op":"callScene","scene":278,"target":1592},{"op":"goto","target":555},{"op":"goto","target":639},{"op":"text","speaker":"","text":"我用手电筒照了照周围。"},{"op":"text","speaker":"羽依里","text":"“……啊。”"},{"op":"image","layer":0,"image":"i442"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"在树林的缝隙之间，发现了正在缓缓移动的灯火。"},{"op":"text","speaker":"羽依里","text":"（是那个……）"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"我尽量地放轻脚步，逐渐接近远处的灯光。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“唉……”"},{"op":"image","layer":0,"image":"i1141"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"（那是……）"},{"op":"text","speaker":"","text":"那火光原来是灯笼发出的。"},{"op":"text","speaker":"","text":"而提着灯笼的人是――"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"image","layer":0,"image":"i1140"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"（苍……？）"},{"op":"text","speaker":"","text":"穿着和平时不一样，让我不敢太肯定。"},{"op":"text","speaker":"","text":"但是灯笼照亮的那个脸庞，绝对是苍没错。"},{"op":"text","speaker":"羽依里","text":"（她在这种地方到底在干什么呢……？）"},{"op":"text","speaker":"","text":"正打算走出去向她搭话。"},{"op":"text","speaker":"","text":"就在这时。"},{"op":"image","layer":0,"image":"i234"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"（嗯……什么？）"},{"op":"text","speaker":"","text":"森林中出现了另外的光芒，忽暗忽明飘摇着向苍靠近。"},{"op":"text","speaker":"","text":"那是……"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i234"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"（……蝴蝶？）"},{"op":"text","speaker":"羽依里","text":"（蝴蝶……在发光……？）"},{"op":"text","speaker":"","text":"散发着神秘光芒的蝴蝶，正向苍飞去。"},{"op":"text","speaker":"","text":"仿佛是被灯笼的火光所吸引，晃悠悠，轻飘飘地……"},{"op":"image","layer":0,"image":"i1140"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i1142"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"苍","text":"“……过来。”"},{"op":"text","speaker":"","text":"听到了苍的轻声细语。"},{"op":"text","speaker":"","text":"仿佛遥指天空一般，苍举起了没有提着灯笼的那只手。"},{"op":"image","layer":0,"image":"i1143"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"发光的蝴蝶，停在了她的指尖上。"},{"op":"text","speaker":"苍","text":"“……”"},{"op":"text","speaker":"","text":"苍像是在遥望远方一般，注视着自己指尖的蝴蝶。"},{"op":"text","speaker":"","text":"没有任何动作，也没有任何言语，只是那么看着。"},{"op":"text","speaker":"","text":"那身影……"},{"op":"text","speaker":"","text":"那无比神秘的光景……"},{"op":"text","speaker":"","text":"让我无法移开自己的视线。"},{"op":"text","speaker":"苍","text":"“……是吗。”"},{"op":"image","layer":0,"image":"i1140"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"过了一会儿，在苍轻轻说了一声后，蝴蝶离开了苍的指尖。"},{"op":"text","speaker":"","text":"并没有直接飞走，而是依然在灯笼周围飞舞着。"},{"op":"image","layer":0,"image":"i1142"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"苍","text":"“……”"},{"op":"text","speaker":"","text":"苍一言不发继续前进。"},{"op":"text","speaker":"","text":"随着摇曳的灯笼，苍走向山的更深处。"},{"op":"image","layer":0,"image":"i46"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"直到光点渐渐变小，埋没在树影中完全看不见为止，我都没能移动一步。"},{"op":"text","speaker":"","text":"神奇的是，我没有半点想要去追苍的念头。"},{"op":"text","speaker":"","text":"并不是说，怕自己会打扰到她……"},{"op":"text","speaker":"","text":"而是因为我感觉――……"},{"op":"text","speaker":"","text":"我看到了不能看的东西。"},{"op":"set","variable":8,"value":1},{"op":"goto","target":654},{"op":"text","speaker":"羽依里","text":"“不过……这个时间还要往山里跑吗……”"},{"op":"text","speaker":"","text":"确实是够吓人的。"},{"op":"text","speaker":"羽依里","text":"“又不是山火，就不用太在意了吧。”"},{"op":"text","speaker":"羽依里","text":"“毕竟放着暑假，可能是小鬼们在玩试胆游戏。”"},{"op":"text","speaker":"羽依里","text":"“再溜达一下就回家吧……”"},{"op":"text","speaker":"","text":"我转过身子，继续漫步在深夜的小岛上。"},{"op":"set","variable":93,"value":1},{"op":"if","truth":false,"target":654,"value":["==",["v",139],1]},{"op":"text","speaker":"羽依里","text":"“啊……对了。”"},{"op":"text","speaker":"","text":"溜达的同时，顺便去设置下岛可梦对战的饵好了。"},{"op":"text","speaker":"","text":"不管怎么说，我也是个斗士。"},{"op":"text","speaker":"","text":"怎么办呢……"},{"op":"callScene","scene":278,"target":1592},{"op":"goto","target":654},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"image","layer":1,"image":"i10371"},{"op":"text","speaker":"苍","text":"“嗯……那么大的……没法全吞下去……”"},{"op":"text","speaker":"羽依里","text":"“怎么回事啊…这色色的感想……”"},{"op":"goto","target":174},{"op":"image","layer":1,"image":"i10364"},{"op":"text","speaker":"苍","text":"“啾……舔舔……啧……舔舔……啾……”"},{"op":"text","speaker":"羽依里","text":"“等，等下……这有点太刺激了……”"},{"op":"text","speaker":"","text":"情况变得让我无法直视了。"},{"op":"goto","target":190},{"op":"text","speaker":"","text":"乳白色的果冻从苍的嘴角溢了出来。"},{"op":"goto","target":227},{"op":"text","speaker":"","text":"虽然她的嘴唇又软又弹，但现在却顾不上了。"},{"op":"goto","target":230},{"op":"text","speaker":"","text":"这对上男校的我而言，这情景实在是太刺激了。"},{"op":"goto","target":240},{"op":"end"}]