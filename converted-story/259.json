yer":257,"image":"i12153"},{"op":"text","speaker":"良一","text":"“都说了不是啊！”"},{"op":"image","layer":257,"image":"i12165"},{"op":"text","speaker":"良一","text":"“啊哈哈♪干得不错啊～”"},{"op":"image","layer":257,"image":"i12147"},{"op":"text","speaker":"良一","text":"“我说的是那种一边说着这种话一边嬉戏的家伙啊。”"},{"op":"text","speaker":"羽依里","text":"“那个野美希好像也说了吧。”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":1795,"image":"i18201"},{"op":"image","layer":0,"image":"i51"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11814"},{"op":"text","speaker":"美希","text":"“再怎么逃也是没用的。”"},{"op":"image","layer":257,"image":"i12124"},{"op":"text","speaker":"良一","text":"“唔啊!؟”"},{"op":"text","speaker":"","text":"滋……"},{"op":"image","layer":1,"image":"i11792"},{"op":"text","speaker":"美希","text":"“……干掉了吗。”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":1795},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i21"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15065"},{"op":"image","layer":257,"image":"i12150"},{"op":"text","speaker":"良一","text":"“意思完全不一样的好吧！”"},{"op":"image","layer":257,"image":"i12141"},{"op":"text","speaker":"良一","text":"“话说你听我说话了吗？我说的是互相泼水啊。”"},{"op":"image","layer":257,"image":"i12147"},{"op":"text","speaker":"良一","text":"“那家伙完全是单方面地向我滋水啊。”"},{"op":"text","speaker":"羽依里","text":"“那你也泼回去怎么样？”"},{"op":"image","layer":1,"image":"i15086"},{"op":"image","layer":257,"image":"i12150"},{"op":"text","speaker":"良一","text":"“会被杀掉的好吗？”"},{"op":"text","speaker":"羽依里","text":"“这不正是你的愿望吗？”"},{"op":"image","layer":257,"image":"i12153"},{"op":"text","speaker":"良一","text":"“愿望个什么啊！”"},{"op":"image","layer":257,"image":"i12150"},{"op":"text","speaker":"良一","text":"“我……在她的阴影下到底是多么担惊受怕地活到现在的，你知道吗？”"},{"op":"text","speaker":"","text":"那你把衣服穿上不就好了吗。"},{"op":"image","layer":257,"image":"i12141"},{"op":"text","speaker":"羽依里","text":"“还有，这种场景都有些什么来着？”"},{"op":"image","layer":1,"image":"i15068"},{"op":"text","speaker":"天善","text":"“我想想。”"},{"op":"image","layer":1,"image":"i15070"},{"op":"text","speaker":"天善","text":"“游泳游累了睡着了之后，女孩子过来观察。”"},{"op":"image","layer":1,"image":"i15084"},{"op":"text","speaker":"天善","text":"“确认确实睡着了之后，给他披上上衣之类的？”"},{"op":"text","speaker":"","text":"确实是漫画里会出现的场景。"},{"op":"image","layer":1,"image":"i15068"},{"op":"image","layer":257,"image":"i12162"},{"op":"text","speaker":"良一","text":"“噢噢……这感觉不错啊。”"},{"op":"text","speaker":"羽依里","text":"“但是这个场景也看到过很多次了。”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":1795,"image":"i18201"},{"op":"image","layer":0,"image":"i25"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":7,"image":"i12077"},{"op":"text","speaker":"良一","text":"“噢……噢噢……”"},{"op":"image","layer":1,"image":"i11804"},{"op":"text","speaker":"美希","text":"“……死了吗？”"},{"op":"image","layer":1,"image":"i11731"},{"op":"text","speaker":"美希","text":"“这是你脱掉的衣服。”"},{"op":"image","layer":1,"image":"i11766"},{"op":"text","speaker":"美希","text":"“穿上它活下去还是光着身子见阎王，你自己选吧。”"},{"op":"image","layer":1,"image":"i11758"},{"op":"text","speaker":"美希","text":"“要是在回去的路上让我看到你没穿的话，刚才的状况可会重新上演的啊？”"},{"op":"image","layer":7,"image":"i12077"},{"op":"text","speaker":"良一","text":"“……”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":1795},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":0,"i