[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i21"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“呦――”"},{"op":"text","speaker":"","text":"我来到了秘密基地。"},{"op":"image","layer":1,"image":"i12141"},{"op":"text","speaker":"良一","text":"“早啊。”"},{"op":"image","layer":257,"image":"i15093"},{"op":"text","speaker":"天善","text":"“你是过来打乒乓球的吗？”"},{"op":"text","speaker":"羽依里","text":"“不，只是随便过来看看。”"},{"op":"text","speaker":"","text":"良一在无所事事消磨时间，天善则在打乒乓球。"},{"op":"image","layer":1,"image":"i12174"},{"op":"text","speaker":"良一","text":"“你这样真的好吗？”"},{"op":"text","speaker":"羽依里","text":"“什么啊？”"},{"op":"image","layer":1,"image":"i12171"},{"op":"text","speaker":"良一","text":"“随随便便跑到这里来。”"},{"op":"text","speaker":"羽依里","text":"“没什么问题吧。反正仓库的整理镜子阿姨也不让我帮忙。”"},{"op":"image","layer":1,"image":"i12174"},{"op":"text","speaker":"良一","text":"“不是说这个。”"},{"op":"image","layer":1,"image":"i12147"},{"op":"text","speaker":"良一","text":"“我是说你更加享受享受这个暑假不好吗？”"},{"op":"text","speaker":"","text":"这话轮得到你这无所事事的家伙说吗。"},{"op":"text","speaker":"","text":"不过。"},{"op":"text","speaker":"羽依里","text":"“我在这岛上体验了不少事情，也算是挺享受了。”"},{"op":"image","layer":1,"image":"i12156"},{"op":"text","speaker":"良一","text":"“那就好。”"},{"op":"text","speaker":"","text":"良一露出了稍显羞涩的微笑。"},{"op":"text","speaker":"","text":"话说我夸的是岛我可没夸你啊。"},{"op":"image","layer":1,"image":"i12141"},{"op":"text","speaker":"良一","text":"“不过，在好好享受暑假的家伙现在正在做些什么呢？”"},{"op":"text","speaker":"羽依里","text":"“这个吗……”"},{"op":"text","speaker":"","text":"究竟在做些什么呢？"},{"op":"text","speaker":"","text":"对于在男校上学的我们来说，享受暑假的首要条件是……"},{"op":"text","speaker":"羽依里","text":"“怎么也得有个女友或者女性友人吧。”"},{"op":"image","layer":1,"image":"i12147"},{"op":"text","speaker":"良一","text":"“原来如此，这点在岛上倒也是一样的。”"},{"op":"image","layer":1,"image":"i12159"},{"op":"text","speaker":"良一","text":"“那种人真是让人羡慕啊。”"},{"op":"text","speaker":"羽依里","text":"“是吧。”"},{"op":"image","layer":257,"image":"i15078"},{"op":"text","speaker":"天善","text":"“你们俩在说什么呢。”"},{"op":"image","layer":257,"image":"i15082"},{"op":"text","speaker":"天善","text":"“我们不是也有女性朋友的吗？”"},{"op":"text","speaker":"","text":"这么说好像也是。"},{"op":"text","speaker":"","text":"大概是由于长年以来并不是这样让我不禁这么想到。"},{"op":"text","speaker":"羽依里","text":"“来这里之后女性朋友的数量一下子多了不少啊。”"},{"op":"text","speaker":"","text":"原来如此……我在这岛上会觉得快乐，可能正是因为这一点。"},{"op":"text","speaker":"","text":"我试着回想在这里结识的女孩子们。"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":1795,"image":"i18201"},{"op":"image","layer":0,"image":"i1003"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"在夜晚的泳池里游泳的白羽……"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":0,"image":"i1017"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"在路边树荫处睡觉的苍……"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"image","layer":0,"image":"i1035"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"饿到倒在地上的识……"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"image","layer":0,"image":"i1036"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"在灯塔上唱歌的紬……"},{"op":"text","speaker":"羽依里","text":"“………………”"},{"op":"image","layer":0,"image":"i1539"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"把自己叫做吞噬满月之乳房的女孩……"},{"op":"text","speaker":"羽依里","text":"“………………”"},{"op":"image","layer":0,"image":"i1050"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"坐在旅行箱上的鸥……"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"image","layer":0,"image":"i1028"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"还有Hydro Gladiator改小姐……"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1795},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"text","speaker":"羽依里","text":"“哈……”"},{"op":"image","layer":0,"image":"i21"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"好像奇怪的家伙有点多啊……"},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“那么他们都会和那些女性朋友们做些什么啊？”"},{"op":"text","speaker":"羽依里","text":"“大家一起去海边吧。”"},{"op":"image","layer":1,"image":"i12174"},{"op":"text","speaker":"良一","text":"“海边是需要特意去的地方吗？”"},{"op":"image","layer":1,"image":"i12150"},{"op":"text","speaker":"良一","text":"“这到底哪里有趣了？”"},{"op":"text","speaker":"羽依里","text":"“这里是因为四面环海。”"},{"op":"text","speaker":"羽依里","text":"“对于平常看不到海的人来说，偶尔去一次的话兴致会大涨的。”"},{"op":"image","layer":1,"image":"i12147"},{"op":"text","speaker":"良一","text":"“完全无法理解这种感觉……”"},{"op":"text","speaker":"羽依里","text":"“然后大家换上泳装一起游泳。”"},{"op":"image","layer":1,"image":"i12141"},{"op":"text","speaker":"良一","text":"“这不就是在学校的日常吗？像长距离游泳之类的也有的吧？”"},{"op":"text","speaker":"羽依里","text":"“没有啊。”"},{"op":"image","layer":1,"image":"i12168"},{"op":"text","speaker":"良一","text":"“真的假的……”"},{"op":"image","layer":257,"image":"i15076"},{"op":"text","speaker":"天善","text":"“没有吗……”"},{"op":"text","speaker":"","text":"竟然连天善都说这种话了。"},{"op":"image","layer":257,"image":"i15072"},{"op":"text","speaker":"天善","text":"“城里的学校真让人羡慕啊……”"},{"op":"image","layer":1,"image":"i12141"},{"op":"text","speaker":"羽依里","text":"“……你们那个长距离游泳那么痛苦的吗？”"},{"op":"image","layer":257,"image":"i15023"},{"op":"text","speaker":"天善","text":"“那可真是……非常痛苦。”"},{"op":"image","layer":1,"image":"i12150"},{"op":"text","speaker":"良一","text":"“长距离游泳那是真的恐怖……”"},{"op":"image","layer":257,"image":"i15078"},{"op":"text","speaker":"天善","text":"“游完之后的那可是累到连女生的泳装看起来都是一片模糊的。”"},{"op":"text","speaker":"","text":"这……听起来就像地狱一样。"},{"op":"image","layer":1,"image":"i12171"},{"op":"text","speaker":"良一","text":"“那是因为你把眼镜摘掉了……”"},{"op":"image","layer":257,"image":"i15116"},{"op":"text","speaker":"天善","text":"“啊！”"},{"op":"text","speaker":"","text":"原来是这样啊。"},{"op":"image","layer":257,"image":"i15065"},{"op":"image","layer":1,"image":"i12141"},{"op":"text","speaker":"良一","text":"“话说漫画里海边场景的那个，他们会做吗？”"},{"op":"text","speaker":"羽依里","text":"“……那个？”"},{"op":"image","layer":1,"image":"i12174"},{"op":"text","speaker":"良一","text":"“就是那个互相追逐的玩意。”"},{"op":"text","speaker":"羽依里","text":"“……？”"},{"op":"image","layer":1,"image":"i12165"},{"op":"text","speaker":"良一","text":"“啊哈哈，快过来抓我啊～”"},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“类似这种的。”"},{"op":"text","speaker":"羽依里","text":"“我是从来没见过。”"},{"op":"image","layer":257,"image":"i15086"},{"op":"image","layer":1,"image":"i12159"},{"op":"text","speaker":"良一","text":"“我还挺想体验下那个的。”"},{"op":"text","speaker":"羽依里","text":"“你这家伙还真是可怜啊。”"},{"op":"image","layer":1,"image":"i12153"},{"op":"text","speaker":"良一","text":"“不用你管！”"},{"op":"image","layer":257,"image":"i15082"},{"op":"text","speaker":"天善","text":"“话说这种追逐游戏你好像经常玩吧？”"},{"op":"image","layer":1,"image":"i12171"},{"op":"text","speaker":"良一","text":"“哈？什么时候的事？”"},{"op":"image","layer":257,"image":"i15032"},{"op":"text","speaker":"天善","text":"“你基本每天都在玩吧。”"},{"op":"text","speaker":"羽依里","text":"“确实，我之前也看到了。”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":1795,"image":"i18201"},{"op":"image","layer":0,"image":"i11"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i12078"},{"op":"text","speaker":"良一","text":"“哈……哈……没想到你竟然能追到这里！”"},{"op":"image","layer":257,"image":"i11771"},{"op":"text","speaker":"美希","text":"“嚯，今天还真是努力啊。”"},{"op":"image","layer":257,"image":"i11761"},{"op":"text","speaker":"美希","text":"“没想到你竟然能逃到这种地方。”"},{"op":"image","layer":1,"image":"i12131"},{"op":"text","speaker":"良一","text":"“