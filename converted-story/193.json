[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i460"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":7,"image":"i11649"},{"op":"text","speaker":"镜子","text":"“咦，羽依里？”"},{"op":"image","layer":0,"image":"i76"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11667"},{"op":"text","speaker":"羽依里","text":"“早上好。”"},{"op":"image","layer":1,"image":"i11647"},{"op":"text","speaker":"镜子","text":"“你一大早在做什么呢？”"},{"op":"text","speaker":"羽依里","text":"“我在找东西……有点东西让我很在意。”"},{"op":"image","layer":1,"image":"i11667"},{"op":"text","speaker":"镜子","text":"“是吗？”"},{"op":"text","speaker":"","text":"昨天的照片……"},{"op":"text","speaker":"","text":"除了那张照片，还有没有别的呢。"},{"op":"text","speaker":"","text":"那张让人几乎确定就是紬的照片。"},{"op":"text","speaker":"","text":"能证明照片上的人和如今的紬没有关系的铁证。"},{"op":"text","speaker":"","text":"我想找到这个。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"我一张张重新翻看这叠照片。"},{"op":"text","speaker":"","text":"……然而最后，并没有找到这样的铁证。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":0,"image":"i1332"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“这照片到底是怎么回事啊……”"},{"op":"text","speaker":"","text":"要不要当作没看见，就这么扔这儿呢……"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"不，还是带着吧……虽然对不住镜子阿姨。"},{"op":"image","layer":0,"image":"i76"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“嗯，时间差不多了。”"},{"op":"text","speaker":"","text":"出门吧。"},{"op":"text","speaker":"","text":"我整理好旧照片，放进一旁的盒子里。"},{"op":"text","speaker":"","text":"接着把盒子放在一捆书上。"},{"op":"text","speaker":"羽依里","text":"“嗯……这是。”"},{"op":"text","speaker":"","text":"一本书令我有些在意。"},{"op":"text","speaker":"","text":"这个当礼物说不定挺合适。"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i129"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“哟。”"},{"op":"image","layer":1,"image":"i13782"},{"op":"text","speaker":"静久","text":"“唉呀，乳依里。今天有点慢呀？”"},{"op":"text","speaker":"羽依里","text":"“嗯，有点事。”"},{"op":"image","layer":1,"image":"i13820"},{"op":"text","speaker":"静久","text":"“这样啊。那我放心了。”"},{"op":"text","speaker":"羽依里","text":"“放心？”"},{"op":"image","layer":1,"image":"i13816"},{"op":"text","speaker":"静久","text":"“因为你们俩都不在，我还以为你们把我抛下去别的地方了呢。”"},{"op":"text","speaker":"羽依里","text":"“我们俩都不在……紬呢？”"},{"op":"image","layer":1,"image":"i13840"},{"op":"text","speaker":"静久","text":"“不在哦。”"},{"op":"image","layer":1,"image":"i13843"},{"op":"text","speaker":"静久","text":"“会不会是昨晚回家了？”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i13764"},{"op":"text","speaker":"静久","text":"“乳依里？”"},{"op":"text","speaker":"","text":"那张照片一瞬间掠过我的脑海。"},{"op":"text","speaker":"","text":"一股难以名状的不安闪过大脑……"},{"op":"text","speaker":"","text":"去紬的家看看吧……？"},{"op":"image","layer":1,"image":"i14311"},{"op":"text","speaker":"紬","text":"“姆叽～～～～～！”"},{"op":"text","speaker":"羽依里","text":"“!؟”"},{"op":"image","layer":1,"image":"i14231"},{"op":"text","speaker":"紬","text":"“对，对不起，我迟到了！”"},{"op":"image","layer":257,"image":"i13810"},{"op":"text","speaker":"静久","text":"“唉呀，赖床了？”"},{"op":"image","layer":1,"image":"i14291"},{"op":"text","speaker":"紬","text":"“不，不是的……那个……因为系不好丝带。”"},{"op":"image","layer":1,"image":"i14299"},{"op":"text","speaker":"紬","text":"“要是把丝带系得乱糟糟的，感觉没脸见你们俩。”"},{"op":"image","layer":1,"image":"i14314"},{"op":"text","speaker":"紬","text":"“挑战了许多次后，就到了现在……”"},{"op":"image","layer":1,"image":"i14231"},{"op":"text","speaker":"紬","text":"“……对不起。”"},{"op":"image","layer":257,"image":"i13820"},{"op":"text","speaker":"静久","text":"“哈哈♪说一声的话我就可以帮你系嘛。”"},{"op":"image","layer":1,"image":"i14305"},{"op":"text","speaker":"紬","text":"“不，我想自己系好它。”"},{"op":"image","layer":257,"image":"i13816"},{"op":"text","speaker":"静久","text":"“那今天要不要练练这个？”"},{"op":"image","layer":1,"image":"i14320"},{"op":"text","speaker":"紬","text":"“好的，请多指教，师傅！”"},{"op":"image","layer":257,"image":"i13849"},{"op":"text","speaker":"静久","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“……太好了。”"},{"op":"image","layer":257,"image":"i13840"},{"op":"text","speaker":"静久","text":"“哎？”"},{"op":"text","speaker":"羽依里","text":"“啊，不是……没什么。”"},{"op":"text","speaker":"羽依里","text":"“说起来，静久你一直都在这等吧？没中暑吧？”"},{"op":"image","layer":257,"image":"i13807"},{"op":"text","speaker":"静久","text":"“我打了个瞌睡，都梦见自己变成牛肉干了。”"},{"op":"image","layer":1,"image":"i14287"},{"op":"text","speaker":"紬","text":"“好像很好吃呀。”"},{"op":"text","speaker":"","text":"好吃是好吃，但静久不像没事的样子啊。"},{"op":"text","speaker":"羽依里","text":"“今天就在灯塔里玩吧？”"},{"op":"text","speaker":"羽依里","text":"“咱们要练习系丝带，我还有礼物要给你，而且还得防止静久变成牛肉干。”"},{"op":"image","layer":1,"image":"i14234"},{"op":"text","speaker":"紬","text":"“礼物吗？”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i137"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“礼物就是这个。”"},{"op":"text","speaker":"","text":"我把在仓库发现的旧书递给她们俩。"},{"op":"image","layer":0,"image":"i1334"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“童谣曲种……”"},{"op":"image","layer":7,"image":"i13806"},{"op":"text","speaker":"静久","text":"“很旧的童谣集啊……”"},{"op":"text","speaker":"羽依里","text":"“嗯，我在仓库找到的。”"},{"op":"image","layer":0,"image":"i1336"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“那里真是什么都有。”"},{"op":"image","layer":0,"image":"i1337"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“……会不会，还有吕客罐？”"},{"op":"text","speaker":"羽依里","text":"“很遗憾，应该没。”"},{"op":"image","layer":0,"image":"i1339"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“这样啊……”"},{"op":"image","layer":7,"image":"i13806"},{"op":"text","speaker":"静久","text":"“为什么要送这个？”"},{"op":"text","speaker":"羽依里","text":"“嗯，我觉得说不定能找出紬哼的小曲的来源。”"},{"op":"image","layer":0,"image":"i1336"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“哦～！原来如此！”"},{"op":"image","layer":0,"image":"i1334"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“……”"},{"op":"image","layer":0,"image":"i1339"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“……我还是不太懂？”"},{"op":"text","speaker":"羽依里","text":"“你想啊，要是看到歌词或者歌名，说不定你就会想起什么。”"},{"op":"image","layer":0,"image":"i1338"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“原来如此。好主意。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"紬","text":"“呜～”"},{"op":"image","layer":0,"image":"i1340"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“完全看不懂。”"},{"op":"text","speaker":"羽依里","text":"“完全看不懂啊。”"},{"op":"text","speaker":"","text":"这书实在是太旧了，歌名和歌词都模糊不清。"},{"op":"text","speaker":"","text":"而且我根本读不懂音符。"},{"op":"text","speaker":"","text":"一点忙都没帮上。"},{"op":"image","layer":7,"image":"i13774"},{"op":"text","speaker":"静久","text":"“可以给我看看吗？”"},{"op":"image","layer":0,"image":"i1338"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“给。”"},{"op":"image","layer":7,"image":"i13806"},{"op":"text","speaker":"静久","text":"“呃……”"},{"op":"image","layer":7,"image":"i13754"},{"op":"text","speaker":"静久","text":"“～～～♪”"},{"op":"image","layer":7,"image":"i13763"},{"op":"text","speaker":"静久","text":"“……”"},{"op":"image","layer":7,"image":"i13736"},{"op":"text","speaker":"静久","text":"“是这首吗？”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"image","layer":0,"image":"i1341"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“姆啾？”"},{"op":"image","layer":7,"image":"i13739"},{"op":"text","speaker":"静久","text":"“嗯，应该就是这个了。”"},{"op":"text","speaker":"紬","text":"“怎么说？”"},{"op":"image","layer":7,"image":"i13774"},{"op":"text","speaker":"静久","text":"“就是找了找和你那支曲子一致的乐谱。”"},{"op":"text","speaker":"羽依里","text":"“你还看得懂音符啊……”"},{"op":"text","speaker":"","text":"原来她并不是一个只有奶子的人。"},{"op":"image","layer":0,"image":"i1339"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“怎么说？”"},{"op":"image","layer":7,"image":"i13799"},{"op":"text","speaker":"静久","text":"“唉？我刚才说明了啊？”"},{"op":"image","layer":0,"image":"i1338"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“我直接认为静久很厉害就行了吗？”"},{"op":"text","speaker":"羽依里","text":"“应该行。”"},{"op":"image","layer":7,"image":"i13739"},{"op":"text","speaker":"静久","text":"“这样一来，就能把这支曲子哼到最后了哦。”"},{"op":"image","layer":0,"image":"i1334"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“哦～……我还以为我哼的就是全部了呢。”"},{"op":"text","speaker":"羽依里","text":"“可你看，这个好像只是重复你一直唱的部分而已，我都看得出来……”"},{"op":"image","layer":0,"image":"i1336"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“是啊。”"},{"op":"text","speaker":"羽依里","text":"“就剩下歌词和歌名还不知道了。”"},{"op":"image","layer":7,"image":"i13736"},{"op":"text","speaker":"静久","text":"“那么，紬做出歌词就好了啊♪”"},{"op":"image","layer":0,"image":"i1337"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“可，可以吗？”"},{"op":"image","layer":7,"image":"i13778"},{"op":"text","speaker":"静久","text":"“当然可以啦，我陪你一块作词吧。”"},{"op":"text","speaker":"羽依里","text":"“嗯，好像挺好玩的，当然要来了。”"},{"op":"text","speaker":"紬","text":"“怎，怎么说呢。这么郑重其事地决定要作词，感觉好羞耻啊。”"},{"op":"image","layer":7,"image":"i13736"},{"op":"text","speaker":"静久","text":"“尽情地为这支曲子创作歌词吧！”"},{"op":"image","layer":7,"image":"i13769"},{"op":"text","speaker":"静久","text":"“给♪”"},{"op":"image","layer":0,"image":"i1341"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“姆啾!؟”"},{"op":"image","layer":7,"image":"i13736"},{"op":"text","speaker":"静久","text":"“总之，先说点自己喜欢的东西吧。”"},{"op":"image","layer":7,"image":"i13739"},{"op":"text","speaker":"静久","text":"“这样肯定就能写出有紬风格的歌词了。”"},{"op":"image","layer":0,"image":"i1337"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“就，就算你这么说。”"},{"op":"image","layer":7,"image":"i13769"},{"op":"text","speaker":"静久","text":"“预备·唱♪”"},{"op":"image","layer":0,"image":"i1335"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“哦……”"},{"op":"text","speaker":"紬","text":"“哦～……哦―哦―……哦―哦―”"},{"op":"text","speaker":"紬","text":"“哦～哦～哦哦～……哦～哦～哦哦～……哦～哦哦～……哦～哦哦～哦哦哦哦哦～♪”"},{"op":"text","speaker":"羽依里","text":"“真雄壮。”"},{"op":"image","layer":0,"image":"i1340"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“一，一下子也编不出来嘛。”"},{"op":"text","speaker":"羽依里","text":"“说的也是。”"},{"op":"image","layer":7,"image":"i13739"},{"op":"text","speaker":"静久","text":"“那乳依里也来。”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"image","layer":0,"image":"i1338"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“请加油。”"},{"op":"text","speaker":"羽依里","text":"“等一下，我还没做好心理准备……”"},{"op":"text","speaker":"","text":"唉？歌词？这该怎么编？"},{"op":"text","speaker":"","text":"自己喜欢的东西？……呃…呃――…！"},{"op":"image","layer":7,"image":"i13769"},{"op":"text","speaker":"静久","text":"“预备·唱♪”"},{"op":"text","speaker":"羽依里","text":"“姆～啾姆～啾姆～啾姆啾……”"},{"op":"image","layer":0,"image":"i1341"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“………………”"},{"op":"image","layer":0,"image":"i1342"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“～～～～～～～～！”"},{"op":"text","speaker":"","text":"我在脑子里想象着姆啾个不停的紬，直接唱出了口。"},{"op":"text","speaker":"羽依里","text":"“啊～～～～～～～～～”"},{"op":"text","speaker":"","text":"好难为情。"},{"op":"text","speaker":"紬","text":"“姆啾～～～……”"},{"op":"image","layer":7,"image":"i13781"},{"op":"text","speaker":"静久","text":"“叫你把喜欢的东西唱出来，结果竟然是恋人的口头禅啊。”"},{"op":"image","layer":7,"image":"i13778"},{"op":"text","speaker":"静久","text":"“他可真爱你啊，紬。”"},{"op":"text","speaker":"羽依里","text":"“啊～～～～～～～～～”"},{"op":"text","speaker":"","text":"更难为情了。"},{"op":"text","speaker":"紬","text":"“姆啾～～～～～～～～～！”"},{"op":"text","speaker":"羽依里","text":"“啊～～～～～～～～～”"},{"op":"text","speaker":"","text":"不知道该怎么办了。"},{"op":"image","layer":0,"image":"i1336"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“其实……我还是很开心的……”"},{"op":"image","layer":7,"image":"i13742"},{"op":"text","speaker":"静久","text":"“紬啊。”"},{"op":"image","layer":7,"image":"i13739"},{"op":"text","speaker":"静久","text":"“把乳依里也写进歌词里来谢谢他怎么样？”"},{"op":"image","layer":0,"image":"i1340"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"紬","text":"“静久……请不要这样。”"},{"op":"text","speaker":"紬","text":"“我现在害羞得不知所以了。”"},{"op":"text","speaker":"羽依里","text":"“我也不知所以了。”"},{"op":"image","layer":7,"image":"i13769"},{"op":"text","speaker":"静久","text":"“另外也希望我的名字也能加入进去♪”"},{"op":"text","speaker":"","text":"她好像并没有听我们说话。"},{"op":"image","layer":0,"image":"i1341"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":7,"image":"i13772"},{"op":"text","speaker":"静久","text":"“姆～姆啾啾啾啾啾～♪”"},{"op":"image","layer":7,"image":"i13739"},{"op":"text","speaker":"静久","text":"“真不错。”"},{"op":"text","speaker":"羽依里","text":"“啊～～～～～～～～～”"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i137"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i14231"},{"op":"text","speaker":"紬","text":"“好难为情。”"},{"op":"text","speaker":"羽依里","text":"“我也是……”"},{"op":"image","layer":257,"image":"i13740"},{"op":"text","speaker":"静久","text":"“哈哈♪”"},{"op":"text","speaker":"","text":"嗯？……外面传来了奇怪的声音。"},{"op":"text","speaker":"","text":"我朝外面看了看。"},{"op":"image","layer":772,"image":"i317"},{"op":"image","layer":1028,"image":"i13456"},{"op":"image","layer":1284,"image":"i25242"},{"op":"image","layer":1540,"image":"i25242"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"","text":"只见白羽在钓鱼。"},{"op":"clear","layer":772},{"op":"clear","layer":1028},{"op":"clear","layer":1284},{"op":"clear","layer":1540},{"op":"clear","layer":1791},{"op":"clear","layer":1279},{"op":"clear","layer":1023},{"op":"text","speaker":"羽依里","text":"“太意外了……”"},{"op":"image","layer":1,"image":"i14326"},{"op":"text","speaker":"紬","text":"“怎么了？”"},{"op":"text","speaker":"羽依里","text":"“你的挚友在那钓鱼呢。”"},{"op":"image","layer":1,"image":"i14211"},{"op":"text","speaker":"紬","text":"“姆啾？西瓜姐姐吗？”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i129"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13456"},{"op":"text","speaker":"","text":"我们三个走下灯塔。"},{"op":"image","layer":257,"image":"i14284"},{"op":"text","speaker":"紬","text":"“西瓜姐姐。”"},{"op":"image","layer":1,"image":"i13387"},{"op":"text","speaker":"白羽","text":"“……！棉，棉花糖妹妹。”"},{"op":"image","layer":257,"image":"i14317"},{"op":"text","speaker":"紬","text":"“你怎么在这呀？”"},{"op":"image","layer":257,"image":"i14320"},{"op":"text","speaker":"紬","text":"“莫非是来找我玩的？”"},{"op":"image","layer":1,"image":"i13384"},{"op":"text","speaker":"白羽","text":"“不……是。我只是看潮水，觉得今天这个位置很适合钓鱼。”"},{"op":"image","layer":1,"image":"i13381"},{"op":"text","speaker":"白羽","text":"“所以……是偶然来这里。”"},{"op":"image","layer":257,"image":"i14284"},{"op":"text","speaker":"紬","text":"“这样啊。但我还是很开心。”"},{"op":"image","layer":1,"image":"i13235"},{"op":"text","speaker":"白羽","text":"“给，礼物。”"},{"op":"text","speaker":"羽依里","text":"“为什么偶然来这还带了礼物啊……”"},{"op":"image","layer":1,"image":"i13359"},{"op":"text","speaker":"白羽","text":"“呃……这是因为……”"},{"op":"image","layer":257,"image":"i14355"},{"op":"text","speaker":"紬","text":"“难道是棉花糖吗？”"},{"op":"image","layer":1,"image":"i13384"},{"op":"text","speaker":"白羽","text":"“……给。”"},{"op":"image","layer":257,"ima