[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15378"},{"op":"text","speaker":"羽未","text":"“哇――――！哥哥的手臂――――！”"},{"op":"text","speaker":"","text":"看到石膏，大惊失色。"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“哇哇哇……骨头，骨折了……吗？”"},{"op":"text","speaker":"羽依里","text":"“没有骨折哦。”"},{"op":"image","layer":1,"image":"i15579"},{"op":"text","speaker":"羽未","text":"“很痛……？”"},{"op":"text","speaker":"羽依里","text":"“有点，也不至于痛得哇哇叫。”"},{"op":"image","layer":1,"image":"i15582"},{"op":"text","speaker":"羽未","text":"“呜～…”"},{"op":"text","speaker":"羽依里","text":"“没事的，乖啦？”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“怎么会受伤的？”"},{"op":"text","speaker":"羽依里","text":"“爬树的时候掉下来了。”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“只有手臂受伤了？别的地方没事吧？”"},{"op":"text","speaker":"羽依里","text":"“嗯，没事的哦。”"},{"op":"image","layer":257,"image":"i10778"},{"op":"text","speaker":"鸥","text":"“对、对不起。”"},{"op":"image","layer":257,"image":"i10781"},{"op":"text","speaker":"鸥","text":"“都怪我不好。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“唉。”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“谁？”"},{"op":"image","layer":513,"image":"i11632"},{"op":"text","speaker":"镜子","text":"“说起来，这位可爱的小姑娘是？”"},{"op":"image","layer":257,"image":"i10856"},{"op":"text","speaker":"鸥","text":"“初次见面，我是久岛鸥。”"},{"op":"image","layer":513,"image":"i11581"},{"op":"text","speaker":"镜子","text":"“鸥小姐。”"},{"op":"image","layer":257,"image":"i10867"},{"op":"text","speaker":"鸥","text":"“请叫我乔纳森。”"},{"op":"image","layer":513,"image":"i11563"},{"op":"text","speaker":"镜子","text":"“乔、乔纳森。”"},{"op":"text","speaker":"羽依里","text":"“什么时候开始有这种设定的？”"},{"op":"image","layer":257,"image":"i10821"},{"op":"text","speaker":"鸥","text":"“刚才。”"},{"op":"image","layer":257,"image":"i10775"},{"op":"text","speaker":"鸥","text":"“我来说明一下事情原委。”"},{"op":"image","layer":257,"image":"i10766"},{"op":"text","speaker":"鸥","text":"“我请求羽依里帮我一起寻找，我儿时的玩伴们藏起来的钥匙下落。”"},{"op":"image","layer":257,"image":"i10775"},{"op":"text","speaker":"鸥","text":"“然后我们推断出某一把钥匙藏在一棵高树上，于是就决定爬上去。”"},{"op":"image","layer":257,"image":"i10787"},{"op":"text","speaker":"鸥","text":"“顾虑到身为女孩子的我如果爬树，自然而然就能窥视到内衣的羽依里，率先提出由自己来爬。”"},{"op":"image","layer":7,"image":"i11548"},{"op":"text","speaker":"镜子","text":"“哎呀……很体贴呢。”"},{"op":"image","layer":7,"image":"i15371"},{"op":"text","speaker":"羽未","text":"“哥哥，绅士？”"},{"op":"text","speaker":"羽依里","text":"“不是，你的陈述有微妙的误差。”"},{"op":"image","layer":257,"image":"i10802"},{"op":"text","speaker":"鸥","text":"“咦，不是吗？”"},{"op":"text","speaker":"羽依里","text":"“我只说了比起女孩子，一般都是男生来爬而已。”"},{"op":"image","layer":257,"image":"i10813"},{"op":"text","speaker":"鸥","text":"“那不就是因为会让人看到内衣……的意思吗。”"},{"op":"text","speaker":"羽依里","text":"“是有这种说法，但不是我说的。”"},{"op":"image","layer":257,"image":"i10766"},{"op":"text","speaker":"鸥","text":"“好啦好啦，有什么关系。哪样都好。”"},{"op":"text","speaker":"羽依里","text":"“算了……你继续说吧。”"},{"op":"text","speaker":"鸥","text":"“羽依里总算是拿到了藏在鸟巢箱里面的钥匙。”"},{"op":"image","layer":257,"image":"i10824"},{"op":"text","speaker":"鸥","text":"“……”"},{"op":"text","speaker":"","text":"接着鸥好像有些犹豫似的，看向了我。"},{"op":"image","layer":257,"image":"i10829"},{"op":"text","speaker":"鸥","text":"“不知道是不是因为脑海中闪过内衣的关系。”"},{"op":"image","layer":257,"image":"i10825"},{"op":"text","speaker":"鸥","text":"“脚下没踩稳。”"},{"op":"text","speaker":"羽依里","text":"“别夹杂你的奇怪推论。”"},{"op":"text","speaker":"羽依里","text":"“为什么正好在拿到钥匙的一刻，脑海中会闪过都没见过的内衣啊。”"},{"op":"image","layer":257,"image":"i10775"},{"op":"text","speaker":"鸥","text":"“想着要是让我来爬的话，就能看见内衣了也说不定之类的。”"},{"op":"text","speaker":"羽依里","text":"“我到底对这事有多大怨念啊！”"},{"op":"image","layer":257,"image":"i10782"},{"op":"text","speaker":"鸥","text":"“唉，可是……那你说说为什么会掉下来啊。”"},{"op":"image","layer":257,"image":"i10812"},{"op":"text","speaker":"鸥","text":"“除了在想内衣的事，我想不出来别的原因。”"},{"op":"text","speaker":"羽依里","text":"“你没看到吗。”"},{"op":"image","layer":257,"image":"i10766"},{"op":"text","speaker":"鸥","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“就算没看到，也会有很多别的可能性吧。”"},{"op":"image","layer":257,"image":"i10775"},{"op":"text","speaker":"鸥","text":"“突然一下子，你人就掉下来了。”"},{"op":"image","layer":257,"image":"i10813"},{"op":"text","speaker":"鸥","text":"“仔细想想，是为什么呢。”"},{"op":"text","speaker":"羽依里","text":"“因为被鸟啄了啊。”"},{"op":"image","layer":257,"image":"i10815"},{"op":"text","speaker":"鸥","text":"“啊。”"},{"op":"image","layer":257,"image":"i10775"},{"op":"text","speaker":"鸥","text":"“就是这么个情况。”"},{"op":"text","speaker":"羽依里","text":"“什么就是这么个情况啊，你连一半都没搞懂吧。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“钥匙是什么的钥匙？时光胶囊吗？”"},{"op":"image","layer":257,"image":"i10766"},{"op":"text","speaker":"鸥","text":"“不是的，是海盗……”"},{"op":"text","speaker":"羽依里","text":"“差不多吧。”"},{"op":"image","layer":257,"image":"i10776"},{"op":"text","speaker":"","text":"真要说起来会很复杂所以我打断了。"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“时光胶囊好棒――！里面装了什么？”"},{"op":"text","speaker":"","text":"已经充分激起了羽未的兴趣。"},{"op":"image","layer":513,"image":"i11635"},{"op":"text","speaker":"镜子","text":"“好怀念啊，时光胶囊。”"},{"op":"image","layer":513,"image":"i11599"},{"op":"text","speaker":"镜子","text":"“我也挖出来看看吧。”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“镜子阿姨的时光胶囊，里面装了什么？”"},{"op":"image","layer":513,"image":"i11622"},{"op":"text","speaker":"镜子","text":"“过错……吧。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“哦……”"},{"op":"text","speaker":"羽依里","text":"“……如此深邃……”"},{"op":"return"},{"op":"end"}]