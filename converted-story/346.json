[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i131"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"羽依里","text":"“不用在意。”"},{"op":"image","layer":1,"image":"i14448"},{"op":"image","layer":257,"image":"i13943"},{"op":"text","speaker":"紬","text":"“稍微休息一下吧。”"},{"op":"image","layer":257,"image":"i13823"},{"op":"text","speaker":"静久","text":"“嗯，谢谢。”"},{"op":"image","layer":1,"image":"i14526"},{"op":"text","speaker":"紬","text":"“在这里坐一下吧。”"},{"op":"image","layer":257,"image":"i13820"},{"op":"text","speaker":"静久","text":"“嗯……谢谢你，紬。”"},{"op":"text","speaker":"","text":"说完，紬就跑进灯塔里去拿水了。"},{"op":"text","speaker":"","text":"我和静久肩并肩坐着。"},{"op":"text","speaker":"羽依里","text":"“辛苦了。”"},{"op":"image","layer":1,"image":"i13833"},{"op":"text","speaker":"静久","text":"“嗯♪　羽依里也是。”"},{"op":"text","speaker":"","text":"然后，她慢慢地靠了过来。"},{"op":"text","speaker":"羽依里","text":"“你是不是有点太勉强自己了？”"},{"op":"image","layer":1,"image":"i13850"},{"op":"text","speaker":"静久","text":"“……是啊。”"},{"op":"image","layer":1,"image":"i13847"},{"op":"text","speaker":"静久","text":"“但是……我必须要这样。”"},{"op":"text","speaker":"羽依里","text":"“哎？”"},{"op":"image","layer":1,"image":"i13805"},{"op":"text","speaker":"静久","text":"“因为我发现了一些事。”"},{"op":"text","speaker":"","text":"静久带着一丝自嘲的笑容。"},{"op":"text","speaker":"羽依里","text":"“什么呀，发现了什么？”"},{"op":"image","layer":1,"image":"i13880"},{"op":"text","speaker":"静久","text":"“我说，羽依里。”"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"image","layer":1,"image":"i13868"},{"op":"text","speaker":"静久","text":"“猫神大人……它真的存在吗？”"},{"op":"text","speaker":"羽依里","text":"“哎？为什么突然这么说？”"},{"op":"text","speaker":"羽依里","text":"“实际上，你确实失去记忆了没错吧？”"},{"op":"image","layer":1,"image":"i13880"},{"op":"text","speaker":"静久","text":"“是的，记忆确实消失了，一点都不剩。”"},{"op":"text","speaker":"羽依里","text":"“那么，不就是这么回事吗？”"},{"op":"image","layer":1,"image":"i13942"},{"op":"text","speaker":"静久","text":"“但是……我觉得也可以这样想。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"这就是静久之前说过的，对多种可能性进行模拟的思维……"},{"op":"image","layer":1,"image":"i13946"},{"op":"text","speaker":"静久","text":"“遭受虐待或承受巨大压力的孩子，会失去失忆，或者创造出另一个人格。”"},{"op":"image","layer":1,"image":"i13871"},{"op":"text","speaker":"静久","text":"“你应该也听说过这种案例吧？”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"image","layer":1,"image":"i13841"},{"op":"text","speaker":"静久","text":"“说不定……我实际上也是这样的情况。”"},{"op":"image","layer":1,"image":"i13808"},{"op":"text","speaker":"静久","text":"“这只是一种可能性。”"},{"op":"image","layer":1,"image":"i13950"},{"op":"text","speaker":"静久","text":"“我的情况，恰好和当地的传说相吻合。”"},{"op":"image","layer":1,"image":"i13944"},{"op":"text","speaker":"静久","text":"“于是，在身边的人眼里就变得很有说服力……”"},{"op":"image","layer":1,"image":"i13868"},{"op":"text","speaker":"静久","text":"“想要消除记忆的我……就把这些说法……该怎么说呢。”"},{"op":"image","layer":1,"image":"i13950"},{"op":"text","speaker":"静久","text":"“把它们当成了自我催眠，或是说服自己的理由。”"},{"op":"image","layer":1,"image":"i13946"},{"op":"text","speaker":"静久","text":"“……下意识地利用了传说和神明。”"},{"op":"image","layer":1,"image":"i13868"},{"op":"text","speaker":"静久","text":"“是不是也有这种可能？”"},{"op":"text","speaker":"羽依里","text":"“这么一说……”"},{"op":"text","speaker":"羽依里","text":"“确实……听起来很合理。”"},{"op":"text","speaker":"","text":"明明是发生在自己身上的事，却能够客观地做出判断……对当前的状况，以不同的观点和角度去思考。"},{"op":"text","speaker":"","text":"而且这种想法……"},{"op":"image","layer":1,"image":"i13841"},{"op":"text","speaker":"静久","text":"“如果我真的下意识地做了这种事的话……”"},{"op":"image","layer":1,"image":"i13844"},{"op":"text","speaker":"静久","text":"“就意味着，我连因自己软弱所导致的结果……一切的原因都归咎于其他事物上。”"},{"op":"image","layer":1,"image":"i13942"},{"op":"text","speaker":"静久","text":"“这是不是非常不应该的？”"},{"op":"text","speaker":"","text":"……这样的想法会伤害到她自己。"},{"op":"image","layer":1,"image":"i13944"},{"op":"text","speaker":"静久","text":"“你不觉得这很卑鄙吗？”"},{"op":"text","speaker":"羽依里","text":"“这个……”"},{"op":"text","speaker":"","text":"我想起了之前和镜子阿姨的对话。"},{"op":"text","speaker":"","text":"‘从未遭遇过恶意的，纯白无瑕的心灵’。"},{"op":"text","speaker":"","text":"‘人生中从未遭遇过不愉快，毫无偏见的透明感’。"},{"op":"text","speaker":"","text":"她……静久……"},{"op":"text","speaker":"","text":"总是想要从正面面对所有不愉快的事情。"},{"op":"text","speaker":"","text":"我是这么认为的。"},{"op":"text","speaker":"","text":"那么我……"},{"op":"text","speaker":"羽依里","text":"“……那样想也没关系吧？”"},{"op":"image","layer":1,"image":"i13838"},{"op":"text","speaker":"静久","text":"“咦？”"},{"op":"text","speaker":"","text":"我这样回答道。"},{"op":"text","speaker":"羽依里","text":"“我觉得，你是不是太过想从正面迎接一切问题了？”"},{"op":"image","layer":1,"image":"i13805"},{"op":"text","speaker":"静久","text":"“是……这样吗？”"},{"op":"text","speaker":"羽依里","text":"“再稍微放松一点思考问题不是也很好嘛？”"},{"op":"text","speaker":"羽依里","text":"“静久可能会觉得这样很卑鄙，很狡猾……”"},{"op":"text","speaker":"羽依里","text":"“但为了保护自己的内心……这也都是有必要做的吧。”"},{"op":"image","layer":1,"image":"i13798"},{"op":"text","speaker":"静久","text":"“羽依里……”"},{"op":"text","speaker":"羽依里","text":"“如果把所有的痛苦都照单全收，心灵是会疲惫的。”"},{"op":"text","speaker":"羽依里","text":"“我认为那应该是一种正确的逃避方式。”"},{"op":"image","layer":1,"image":"i13821"},{"op":"text","speaker":"静久","text":"“这样啊……是呢。”"},{"op":"text","speaker":"羽依里","text":"“至少……我会原谅你的。”"},{"op":"image","layer":1,"image":"i13856"},{"op":"text","speaker":"静久","text":"“……呵呵，谢谢♪”"},{"op":"image","layer":1,"image":"i13859"},{"op":"text","speaker":"静久","text":"“嗯，感觉轻松多了。”"},{"op":"text","speaker":"","text":"对于从未被宠爱过的她来说，一定……需要被爱的记忆。"},{"op":"text","speaker":"","text":"所以……"},{"op":"text","speaker":"羽依里","text":"“你可以更多地依赖我……”"},{"op":"text","speaker":"羽依里","text":"“找我撒娇也没关系哦？”"},{"op":"image","layer":1,"image":"i13865"},{"op":"text","speaker":"静久","text":"“哎……？”"},{"op":"image","layer":1,"image":"i13889"},{"op":"text","speaker":"静久","text":"“……嗯。”"},{"op":"text","speaker":"","text":"她像平时一样，露出了灿烂的笑容。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i140"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"第二天的送别会热闹非凡。"},{"op":"text","speaker":"","text":"我、静久还有紬都在边笑边哭。"},{"op":"text","speaker":"","text":"在我们的影响下，还有几个人也跟着哭了。"},{"op":"image","layer":0,"image":"i141"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"虽然流了很多眼泪……"},{"op":"text","speaker":"","text":"当然，还是很开心。"},{"op":"text","speaker":"","text":"不，正因为如此才很开心。"},{"op":"image","layer":0,"image":"i142"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"就这样……"},{"op":"text","speaker":"","text":"送别会也结束了。"},{"op":"image","layer":0,"image":"i133"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":1,"image":"i13928"},{"op":"text","speaker":"静久","text":"“31号我还会来这里哦！”"},{"op":"text","speaker":"","text":"她向紬这样说道。"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i27"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"我们踏上了回家的路。"},{"op":"text","speaker":"","text":"不过。"},{"op":"image","layer":0,"image":"i5"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":1,"image":"i13768"},{"op":"text","speaker":"静久","text":"“果然已经没有船了呢。”"},{"op":"text","speaker":"羽依里","text":"“那是当然的。”"},{"op":"text","speaker":"","text":"今天的最后一班渡轮已经结束了。"},{"op":"image","layer":1,"image":"i13853"},{"op":"text","speaker":"静久","text":"“那就是说，我得在海之家过夜――”"},{"op":"image","layer":1,"image":"i13871"},{"op":"text","speaker":"静久","text":"“――对了，已经不行了呢。”"},{"op":"text","speaker":"羽依里","text":"“那就拜托一下镜子阿姨，去我家住吧。”"},{"op":"image","layer":1,"image":"i13865"},{"op":"text","speaker":"静久","text":"“可以吗？”"},{"op":"text","speaker":"羽依里","text":"“当然了。”"},{"op":"image","layer":1,"image":"i13808"},{"op":"text","speaker":"静久","text":"“嗯……虽然妈妈说过要‘有分寸和常识’。”"},{"op":"image","layer":1,"image":"i13841"},{"op":"text","speaker":"静久","text":"“这几天一直在外过夜……”"},{"op":"text","speaker":"羽依里","text":"“好好联系一下，老实说明过原因的话应该没问题吧。”"},{"op":"text","speaker":"羽依里","text":"“再说了，如果要挨骂，我也会陪你一起挨骂的……”"},{"op":"image","layer":1,"image":"i13856"},{"op":"text","speaker":"静久","text":"“……是呢♪”"},{"op":"image","layer":1,"image":"i13880"},{"op":"text","speaker":"静久","text":"“羽依里……”"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"image","layer":1,"image":"i13850"},{"op":"text","speaker":"静久","text":"“我们散散步好吗？”"},{"op":"text","speaker":"羽依里","text":"“当然可以。”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i50"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"于是。"},{"op":"image","layer":0,"image":"i369"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"我们来到了海之家。"},{"op":"text","speaker":"","text":"这个夏天的回忆之地已经不复存在了。"},{"op":"text","speaker":"羽依里","text":"“暑假也快结束了呢。”"},{"op":"image","layer":1,"image":"i13853"},{"op":"text","speaker":"静久","text":"“是啊。”"},{"op":"text","speaker":"羽依里","text":"“不过……回到社团后不知道会被说些什么呢？”"},{"op":"image","layer":1,"image":"i13865"},{"op":"text","speaker":"静久","text":"“……”"},{"op":"image","layer":1,"image":"i13880"},{"op":"text","speaker":"静久","text":"“那个，羽依里。我能问一下吗？”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"image","layer":1,"image":"i13868"},{"op":"text","speaker":"静久","text":"“你是不是有点，骑虎难下的感觉……？”"},{"op":"text","speaker":"羽依里","text":"“哎？”"},{"op":"image","layer":1,"image":"i13768"},{"op":"text","speaker":"静久","text":"“你说要回游泳社团，是为了促成我和妈妈谈心这件事才那么说的吧？”"},{"op":"image","layer":1,"image":"i13765"},{"op":"text","speaker":"静久","text":"“是为了让我努力才这么说的……对吧？”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"也许……是她说的这样。"},{"op":"text","speaker":"","text":"但是。"},{"op":"text","speaker":"羽依里","text":"“既然说出口了，就一定要做到。”"},{"op":"text","speaker":"羽依里","text":"“这也算是和静久的约定吧。”"},{"op":"image","layer":1,"image":"i13795"},{"op":"text","speaker":"静久","text":"“羽依里……但是。”"},{"op":"image","layer":1,"image":"i13798"},{"op":"text","speaker":"静久","text":"“如果……你真的不愿意的话，我觉得也没必要特意主动去受伤。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i13931"},{"op":"text","speaker":"静久","text":"“人们常说骨折痊愈后，那部分的骨头会变得更坚固对吧？”"},{"op":"image","layer":1,"image":"i13950"},{"op":"text","speaker":"静久","text":"“但是，有谁会为了让骨头变得更坚固，而特意去弄断骨头呢？”"},{"op":"text","speaker":"羽依里","text":"“……嗯，应该没有吧。”"},{"op":"image","layer":1,"image":"i13868"},{"op":"text","speaker":"静久","text":"“如果是特意去寻求伤害的话，我真的看不下去……”"},{"op":"image","layer":1,"image":"i13871"},{"op":"text","speaker":"静久","text":"“如果你是为了我，要去做那些你原本并不想做的事。”"},{"op":"image","layer":1,"image":"i13874"},{"op":"text","speaker":"静久","text":"“我希望你可以不要这么做哦？”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i13950"},{"op":"text","speaker":"静久","text":"“如果你觉得收回说过的话很没面子……那么这个想法是不对的。”"},{"op":"image","layer":1,"image":"i13856"},{"op":"text","speaker":"静久","text":"“本来你说那些话，不就是为了让我振作起来吗？”"},{"op":"image","layer":1,"image":"i13887"},{"op":"text","speaker":"静久","text":"“……这样做真的很帅气。”"},{"op":"image","layer":1,"image":"i13889"},{"op":"text","speaker":"静久","text":"“然后，如果你能不在这件事上固执己见……那就更好了。”"},{"op":"text","speaker":"羽依里","text":"“静久……”"},{"op":"text","speaker":"羽依里","text":"“……也许你说得对。”"},{"op":"text","speaker":"","text":"如果静久以后还想靠触碰那个神明来恢复记忆的话……"},{"op":"text","speaker":"","text":"我一定会全力阻止她。"},{"op":"text","speaker":"","text":"因为她要主动承受那些本来可以避免的伤害。"},{"op":"text","speaker":"羽依里","text":"“我明白了……既然你这么说。”"},{"op":"image","layer":1,"image":"i13892"},{"op":"text","speaker":"静久","text":"“嗯♪”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i516"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"如果我是一只受伤的候鸟。"},{"op":"text","speaker":"","text":"那么我已经找到了一个不需要再飞翔的岛屿。"},{"op":"text","speaker":"","text":"因为这里没有天敌，所以不需要再飞翔了。"},{"op":"text","speaker":"","text":"只要静静地休息羽翼就好。"},{"op":"text","speaker":"","text":"如果有人问我为什么过去一直在飞……"},{"op":"text","speaker":"","text":"那一定是因为我在寻找某个乐园。"},{"op":"text","speaker":"","text":"然后……"},{"op":"text","speaker":"","text":"我终于抵达了那个乐园。"},{"op":"text","speaker":"","text":"我会这样回答。"},{"op":"text","speaker":"","text":"那么或许就不需要再让羽翼休息了。"},{"op":"text","speaker":"","text":"或许也不再需要用来飞翔的翅膀了。"},{"op":"text","speaker":"","text":"因为我已经找到了不再需要飞翔的归宿。"},{"op":"text","speaker":"","text":"静久曾经把海之家当作自己的归宿。"},{"op":"text","speaker":"","text":"但那里已经不复存在了。"},{"op":"text","speaker":"","text":"那么，就让我来成为她的归宿吧。"},{"op":"text","speaker":"","text":"我要成为她的容身之所。"},{"op":"text","speaker":"","text":"我只要作为她的归宿活下去就好。"},{"op":"text","speaker":"","text":"彼此都是对方的归宿，彼此都是对方的人生意义。"},{"op":"text","speaker":"","text":"我们都拥有彼此想要的东西。"},{"op":"text","speaker":"","text":"能够相互扶持着活下去。"},{"op":"text","speaker":"羽依里","text":"“我感觉……我们能一直欢声笑语地过下去。”"},{"op":"text","speaker":"静久","text":"“嗯♪　我们永远都要欢笑哦。”"},{"op":"text","speaker":"","text":"我们就保持现在这副模样。"},{"op":"text","speaker":"","text":"这份关系……将会永远……"},{"op":"text","speaker":"","text":"缓缓地。"},{"op":"text","speaker":"","text":"静静地。"},{"op":"text","speaker":"","text":"幸福地。"},{"op":"text","speaker":"","text":"持续下去。"},{"op":"text","speaker":"","text":"我有着这样的确信。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]