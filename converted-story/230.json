[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":2,"image":"i743"},{"op":"image","layer":0,"image":"i513"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":2},{"op":"image","layer":0,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i1455"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":512},{"op":"image","layer":0,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i430"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"从清早起便是万里无云的晴天。"},{"op":"text","speaker":"","text":"完全没有下雨的迹象。"},{"op":"image","layer":0,"image":"i28"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13373"},{"op":"text","speaker":"白羽","text":"“没问题吧？”"},{"op":"text","speaker":"羽依里","text":"“嗯，因为会是一阵骤雨，现在算是一切顺利。”"},{"op":"image","layer":1,"image":"i13405"},{"op":"text","speaker":"白羽","text":"“话是这么说……”"},{"op":"image","layer":1,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“你真的倒挂了晴天娃娃？”"},{"op":"text","speaker":"羽依里","text":"“是啊。”"},{"op":"text","speaker":"羽依里","text":"“我还对着倒挂的晴天娃娃，用加湿器吹了快一个小时呢。”"},{"op":"image","layer":1,"image":"i13294"},{"op":"text","speaker":"白羽","text":"“感觉要遭报应的。”"},{"op":"text","speaker":"羽依里","text":"“如果报应是下雨，那就正中下怀了。”"},{"op":"image","layer":257,"image":"i15974"},{"op":"text","speaker":"羽未","text":"“？”"},{"op":"text","speaker":"羽依里","text":"“羽未你不用在意这个。”"},{"op":"image","layer":1,"image":"i13259"},{"op":"text","speaker":"白羽","text":"“要搞得浑身湿透，就必须要淋雨是吧。”"},{"op":"text","speaker":"羽依里","text":"“是啊。那在下雨之前，我们找个地方玩吧……”"},{"op":"image","layer":1,"image":"i13277"},{"op":"text","speaker":"白羽","text":"“羽未，你有什么想玩的吗？”"},{"op":"image","layer":257,"image":"i15896"},{"op":"text","speaker":"羽未","text":"“……嗯…？”"},{"op":"image","layer":257,"image":"i15901"},{"op":"text","speaker":"羽未","text":"“嗯……伊伊家，塔圆…？”"},{"op":"image","layer":1,"image":"i13334"},{"op":"text","speaker":"白羽","text":"“……伊家…塔圆？”"},{"op":"text","speaker":"羽依里","text":"“大概是一家团圆吧？”"},{"op":"image","layer":257,"image":"i15764"},{"op":"text","speaker":"羽未","text":"“对！”"},{"op":"image","layer":1,"image":"i13259"},{"op":"text","speaker":"白羽","text":"“在户外一家团圆……该做些什么呢？”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“就去那里吧。”"},{"op":"image","layer":1,"image":"i13235"},{"op":"text","speaker":"白羽","text":"“？”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i448"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i51"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"风平浪静。"},{"op":"text","speaker":"","text":"海面上飘着一个小小的浮标。"},{"op":"image","layer":1,"image":"i13284"},{"op":"text","speaker":"白羽","text":"“………”"},{"op":"text","speaker":"","text":"孩子他妈用猎人的目光盯着那浮标。"},{"op":"text","speaker":"","text":"只见那浮标……忽然沉了下去。"},{"op":"image","layer":1,"image":"i13270"},{"op":"text","speaker":"白羽","text":"“咬钩了！”"},{"op":"text","speaker":"","text":"她的目光突然犀利，同时挥起了握着鱼竿的手。"},{"op":"text","speaker":"","text":"从鱼竿的弯曲幅度就能看出猎物有多重。"},{"op":"text","speaker":"","text":"唰！"},{"op":"text","speaker":"","text":"随着一阵水花被钓起来的，是一只鲎。"},{"op":"text","speaker":"羽依里","text":"“你得到了一块活化石。”"},{"op":"image","layer":1,"image":"i13294"},{"op":"text","speaker":"白羽","text":"“………”"},{"op":"image","layer":257,"image":"i15863"},{"op":"text","speaker":"羽未","text":"“要吃了它？”"},{"op":"image","layer":1,"image":"i13262"},{"op":"text","speaker":"白羽","text":"“……这、这才合礼数……”"},{"op":"text","speaker":"羽依里","text":"“呃，鲎是保护动物，不能吃啊。”"},{"op":"image","layer":1,"image":"i13294"},{"op":"text","speaker":"白羽","text":"“对、对哦。不能吃的。”"},{"op":"image","layer":257,"image":"i15870"},{"op":"text","speaker":"羽未","text":"“呜喵……还是什么都没……”"},{"op":"text","speaker":"","text":"脚边的水桶里，至今依旧只有海水。"},{"op":"image","layer":1,"image":"i13262"},{"op":"text","speaker":"白羽","text":"“单纯因为今天的海潮不好。”"},{"op":"text","speaker":"羽依里","text":"“让我试试。”"},{"op":"image","layer":1,"image":"i13284"},{"op":"text","speaker":"白羽","text":"“………”"},{"op":"text","speaker":"","text":"她一脸不爽地把鱼竿交到我手里。"},{"op":"text","speaker":"羽依里","text":"“帮个忙……把鱼饵穿上。”"},{"op":"text","speaker":"","text":"我还是不敢往鱼钩上穿昆虫类。"},{"op":"text","speaker":"","text":"让白羽帮忙穿上鱼饵，把钓钩甩进海里。"},{"op":"text","speaker":"","text":"然后不到5秒，我就感到一股强劲的拉力。"},{"op":"text","speaker":"羽依里","text":"“咬钩了！”"},{"op":"text","speaker":"","text":"我钓到了一条叫不出名字，但是很大的鱼。"},{"op":"image","layer":1,"image":"i13408"},{"op":"text","speaker":"白羽","text":"“……单纯因为刚才海潮转向了。”"},{"op":"text","speaker":"","text":"孩子他妈闹情绪了。"},{"op":"text","speaker":"羽依里","text":"“这是什么鱼啊？”"},{"op":"image","layer":1,"image":"i13390"},{"op":"text","speaker":"白羽","text":"“沙丁鱼。”"},{"op":"text","speaker":"羽依里","text":"“肯定不是的。”"},{"op":"text","speaker":"","text":"这点知识我还是有的。"},{"op":"image","layer":1,"image":"i13284"},{"op":"text","speaker":"白羽","text":"“真鲷……”"},{"op":"text","speaker":"","text":"她用愈发不爽的口气说道。"},{"op":"image","layer":257,"image":"i15806"},{"op":"text","speaker":"羽未","text":"“吃了它？”"},{"op":"image","layer":1,"image":"i13235"},{"op":"text","speaker":"羽依里","text":"“这才合礼数啊。”"},{"op":"image","layer":257,"image":"i15870"},{"op":"text","speaker":"羽未","text":"“大鱼好可怜。”"},{"op":"image","layer":1,"image":"i13277"},{"op":"text","speaker":"白羽","text":"“这个很好吃的哦。”"},{"op":"image","layer":257,"image":"i15988"},{"op":"text","speaker":"羽未","text":"“……那就不客气了。”"},{"op":"text","speaker":"","text":"羽未双手合十向鱼拜了一拜。"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"image","layer":1,"image":"i15788"},{"op":"image","layer":257,"image":"i13277"},{"op":"text","speaker":"羽未","text":"“真好吃。”"},{"op":"text","speaker":"","text":"我们把钓上来的鱼当场烤来吃了。"},{"op":"text","speaker":"羽依里","text":"“刚钓上来的果然不一样啊。”"},{"op":"image","layer":257,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“剩下的那些要不要也烤了？”"},{"op":"text","speaker":"羽依里","text":"“做成刺身怎么样？”"},{"op":"image","layer":257,"image":"i13246"},{"op":"text","speaker":"白羽","text":"“那就这么办。”"},{"op":"text","speaker":"","text":"白羽开始熟练地处理其他的鱼。"},{"op":"text","speaker":"","text":"感觉好怀念啊。"},{"op":"text","speaker":"","text":"刚来到岛上的时候，我也在这里吃过鱼。"},{"op":"text","speaker":"","text":"那时白羽还没有当上妈妈的角色。"},{"op":"text","speaker":"","text":"反而很抵触这个。"},{"op":"text","speaker":"","text":"而如今……"},{"op":"text","speaker":"羽依里","text":"“一家团圆啊。”"},{"op":"image","layer":1,"image":"i13274"},{"op":"text","speaker":"白羽","text":"“嗯？”"},{"op":"text","speaker":"羽依里","text":"“我想起了上次羽未在这里说的话。”"},{"op":"image","layer":1,"image":"i13291"},{"op":"text","speaker":"白羽","text":"“说起来还真是啊。”"},{"op":"image","layer":0,"image":"i239"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":1,"image":"i13292"},{"op":"text","speaker":"","text":"那时候，白羽还不太懂什么叫一家团圆。"},{"op":"text","speaker":"","text":"而现在又如何呢。"},{"op":"text","speaker":"","text":"虽然只是临时组成，但的确作为一家人度过的夏天。"},{"op":"text","speaker":"","text":"真希望这个夏天能给她特别的意义。"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i51"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13291"},{"op":"image","layer":257,"image":"i15920"},{"op":"text","speaker":"羽未","text":"“好吃就是开心。”"},{"op":"image","layer":1,"image":"i13325"},{"op":"text","speaker":"白羽","text":"“嗯，是啊。”"},{"op":"text","speaker":"","text":"白羽点着头，带着慈爱的目光看着羽未。"},{"op":"text","speaker":"","text":"她那温柔的微笑，真像一位母亲――……"},{"op":"image","layer":2,"image":"i731"},{"op":"image","layer":259,"image":"i18131"},{"op":"image","layer":515,"image":"i25638"},{"op":"clear","layer":2},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15436"},{"op":"text","speaker":"羽未","text":"‘……■是■……■■妈的。’"},{"op":"image","layer":1,"image":"i15442"},{"op":"text","speaker":"羽未","text":"‘■为……妈■■经不■了。’"},{"op":"clear","layer":515},{"op":"clear","layer":259},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i51"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"咦……？"},{"op":"text","speaker":"","text":"真像……什么来着…？"},{"op":"image","layer":2,"image":"i731"},{"op":"image","layer":259,"image":"i18131"},{"op":"image","layer":515,"image":"i25638"},{"op":"clear","layer":2},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15422"},{"op":"text","speaker":"羽未","text":"‘因■，■不■解自■■■妈。’"},{"op":"image","layer":1,"image":"i15436"},{"op":"text","speaker":"羽未","text":"‘于■……为■见■■，我■到■这■岛。’"},{"op":"image","layer":1,"image":"i15366"},{"op":"text","speaker":"羽未","text":"‘……――从■来。’"},{"op":"clear","layer":515},{"op":"clear","layer":259},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i51"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"哦，想起来了，真像一位真正的母亲。"},{"op":"text","speaker":"","text":"让人感觉十分温馨。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"嗒……"},{"op":"text","speaker":"羽依里","text":"“嗯……？”"},{"op":"image","layer":0,"image":"i509"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"嗒……嗒……"},{"op":"image","layer":7,"image":"i13386"},{"op":"text","speaker":"白羽","text":"“下雨了……”"},{"op":"text","speaker":"","text":"天上开始嗒嗒地落下雨点。"},{"op":"text","speaker":"羽依里","text":"“真的开始下雨了。”"},{"op":"text","speaker":"","text":"绘图日记应验了。"},{"op":"image","layer":0,"image":"i157"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“咦……？”"},{"op":"text","speaker":"","text":"我好像又要想起些什么了。"},{"op":"text","speaker":"","text":"之前似乎也遇到过类似的事。"},{"op":"text","speaker":"羽依里","text":"“未来……”"},{"op":"image","layer":7,"image":"i13234"},{"op":"text","speaker":"白羽","text":"“未来？”"},{"op":"text","speaker":"","text":"似乎有些话已经到了嘴边，可就是说不出来。"},{"op":"text","speaker":"","text":"就是把握不到。"},{"op":"text","speaker":"","text":"就在我将要直视它的瞬间，它失去了形状。"},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"clear","layer":0},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i240"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13305"},{"op":"text","speaker":"白羽","text":"“你没事吧？”"},{"op":"text","speaker":"","text":"白羽担心地盯着我的脸问道。"},{"op":"text","speaker":"羽依里","text":"“呃，嗯。”"},{"op":"text","speaker":"羽依里","text":"“先不说我，羽未没事吧？”"},{"op":"image","layer":7,"image":"i15820"},{"op":"text","speaker":"羽未","text":"“冲澡啦。”"},{"op":"text","speaker":"","text":"看起来相当没事。"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i52"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"话虽如此，雨越下越大了。"},{"op":"text","speaker":"","text":"转眼间，我们就从头到脚都湿透了。"},{"op":"text","speaker":"羽依里","text":"“快回去吧。”"},{"op":"text","speaker":"","text":"我背起羽未开始跑。"},{"op":"text","speaker":"","text":"白羽也在我身边跑着。"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i32"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i16006"},{"op":"text","speaker":"羽未","text":"“好快呀，耶耶！”"},{"op":"text","speaker":"","text":"看来一边淋雨一边让我背着跑，对她来说是一种余兴节目。"},{"op":"text","speaker":"","text":"羽未在我背上开心地笑闹着。"},{"op":"text","speaker":"羽依里","text":"“白羽，还跟得上吗？”"},{"op":"image","layer":1,"image":"i16006"},{"op":"image","layer":257,"image":"i13331"},{"op":"text","speaker":"白羽","text":"“完……完全…哈啊，哈啊……完全没问……题。”"},{"op":"text","speaker":"","text":"看来是完全不行了。"},{"op":"text","speaker":"","text":"我稍微放慢了一点跑速。"},{"op":"image","layer":1,"image":"i15933"},{"op":"text","speaker":"羽未","text":"“泡澡，到家，要泡澡。”"},{"op":"text","speaker":"羽依里","text":"“行啊，因为事先就烧好了洗澡水，到家就能泡啦。”"},{"op":"image","layer":1,"image":"i16006"},{"op":"text","speaker":"羽未","text":"“嗯，和妈妈一起泡澡。”"},{"op":"image","layer":257,"image":"i13337"},{"op":"text","speaker":"白羽","text":"“哎、哎……嗯，回去就泡。”"},{"op":"image","layer":1,"image":"i15789"},{"op":"text","speaker":"羽未","text":"“爸爸也一起来，泡澡。”"},{"op":"text","speaker":"羽依里","text":"“嗯，回去就泡。”"},{"op":"image","layer":1,"image":"i15796"},{"op":"text","speaker":"羽未","text":"“一家，团圆♪”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"image","layer":257,"image":"i13259"},{"op":"text","speaker":"白羽","text":"“…………”"},{"op":"image","layer":257,"image":"i13367"},{"op":"text","speaker":"羽依里·白羽","text":"“哎؟!”“哎؟!”"},{"op":"text","speaker":"羽依里","text":"“羽未，我也要一起泡吗？”"},{"op":"image","layer":1,"image":"i15813"},{"op":"text","speaker":"羽未","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“呃，这个……”"},{"op":"image","layer":0,"image":"i220"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":1,"image":"i13368"},{"op":"text","speaker":"","text":"我看了看白羽。"},{"op":"image","layer":1,"image":"i13401"},{"op":"text","speaker":"","text":"白羽满脸通红地猛摇脑袋。"},{"op":"text","speaker":"","text":"也是啊。"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i32"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13400"},{"op":"text","speaker":"羽依里","text":"“呃、羽未、这实在有点……”"},{"op":"image","layer":257,"image":"i15939"},{"op":"text","speaker":"羽未","text":"“不行。”"},{"op":"image","layer":257,"image":"i15935"},{"op":"text","speaker":"羽未","text":"“爸爸也要一起。”"},{"op":"text","speaker":"","text":"她在我背上摇来晃去地表示抗议。"},{"op":"text","speaker":"","text":"看来明显是想抗争到底了。"},{"op":"text","speaker":"","text":"我又看了看白羽……"},{"op":"image","layer":0,"image":"i220"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":1,"image":"i13382"},{"op":"text","speaker":"白羽","text":"“～～～～”"},{"op":"text","speaker":"","text":"看她表情都快哭出来了……"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i32"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13381"},{"op":"text","speaker":"羽依里","text":"“总之先回去吧，当心真的着凉。”"},{"op":"image","layer":257,"image":"i16006"},{"op":"text","speaker":"羽未","text":"“一家，团圆♪”"},{"op":"text","speaker":"","text":"那无情的歌声，哪怕混杂在雨声里也切实传入了我的耳朵。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"等我们拼命跑回了家里……"},{"op":"text","speaker":"","text":"刚才还那么大的雨竟像是从未有过，天空重又放晴了。"},{"op":"text","speaker":"","text":"怎么会有这么任性的阵雨……"},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15603"},{"op":"text","speaker":"羽未","text":"“回家啦。”"},{"op":"image","layer":1,"image":"i15615"},{"op":"text","speaker":"羽未","text":"“泡澡啦。”"},{"op":"text","speaker":"","text":"羽未立即开始脱衣服。"},{"op":"image","layer":257,"image":"i13343"},{"op":"text","speaker":"白羽","text":"“啊，羽未，你先等一下。”"},{"op":"text","speaker":"","text":"白羽赶紧拦住了她。"},{"op":"image","layer":257,"image":"i13253"},{"op":"text","speaker":"白羽","text":"“衣服只有在浴室里才可以脱哦。”"},{"op":"image","layer":1,"image":"i15693"},{"op":"text","speaker":"羽未","text":"“我想快些泡嘛。”"},{"op":"image","layer":257,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“嗯，那么我们赛跑去浴室吧。”"},{"op":"image","layer":1,"image":"i15683"},{"op":"text","speaker":"羽未","text":"“嗯。”"},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":1,"image":"i13275"},{"op":"text","speaker":"","text":"白羽向我偷偷瞟了一眼。"},{"op":"text","speaker":"","text":"我默默地点了点头。"},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15706"},{"op":"image","layer":257,"image":"i13421"},{"op":"text","speaker":"白羽","text":"“那么，预备……跑！”"},{"op":"text","speaker":"","text":"没错，白羽的计划就是一步一步地，先把羽未骗进浴室再说。"},{"op":"text","speaker":"","text":"我们现在已经可以仅凭一个眼色就沟通到这一步了。"},{"op":"text","speaker":"","text":"然而……"},{"op":"image","layer":1,"image":"i15599"},{"op":"text","speaker":"羽未","text":"“爸爸也来，跑！”"},{"op":"text","speaker":"","text":"这没有骗过羽未。"},{"op":"image","layer":257,"image":"i13379"},{"op":"text","speaker":"","text":"我们三个一起站在了门口。"},{"op":"text","speaker":"羽依里","text":"“羽未啊，我们家的浴缸不是很大。”"},{"op":"text","speaker":"羽依里","text":"“三个人会很挤吧？”"},{"op":"image","layer":1,"image":"i15735"},{"op":"text","speaker":"羽未","text":"“不行。”"},{"op":"image","layer":1,"image":"i15750"},{"op":"text","speaker":"羽未","text":"“爸爸，一个人关在外面，好可怜……”"},{"op":"image","layer":257,"image":"i13294"},{"op":"text","speaker":"","text":"羽未是为我着想才这么说的啊……"},{"op":"image","layer":1,"image":"i15617"},{"op":"text","speaker":"羽未","text":"“对吧，妈妈？”"},{"op":"image","layer":257,"image":"i13343"},{"op":"text","speaker":"白羽","text":"“嗯，这个……要我说…算不算可怜呢……”"},{"op":"image","layer":1,"image":"i15627"},{"op":"text","speaker":"羽未","text":"“爸爸，也被雨，淋湿啦。”"},{"op":"image","layer":257,"image":"i13310"},{"op":"text","speaker":"白羽","text":"“这个，这个……”"},{"op":"text","speaker":"","text":"她超为难的。"},{"op":"image","layer":1,"image":"i15672"},{"op":"text","speaker":"羽未","text":"“一起，泡吧？”"},{"op":"image","layer":1,"image":"i15662"},{"op":"text","speaker":"羽未","text":"“……不想吗？”"},{"op":"text","speaker":"","text":"看到我们的反应，羽未眼中含泪问道。"},{"op":"image","layer":257,"image":"i13307"},{"op":"text","speaker":"","text":"要我和白羽一起泡澡――……"},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":1,"image":"i13308"},{"op":"text","speaker":"","text":"我当然想啊，毕竟是男人啊！身心健全的男人啊！"},{"op":"text","speaker":"","text":"实话说，这可是个大好机会。"},{"op":"goto","target":998},{"op":"text","speaker":"","text":"但是……对男校出来的我来说这难度太高了。"},{"op":"text","speaker":"","text":"眼下我就紧张到口干舌燥的。"},{"op":"text","speaker":"","text":"哪怕已经被雨淋到湿透。"},{"op":"image","layer":1,"image":"i13323"},{"op":"text","speaker":"白羽","text":"“可以……哦。”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13322"},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"text","speaker":"羽依里","text":"“؟؟؟!!!”"},{"op":"image","layer":1,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“爸爸，被雨淋湿也很可怜啊。”"},{"op":"image","layer":1,"image":"i13277"},{"op":"text","speaker":"白羽","text":"“羽未心真好。”"},{"op":"image","layer":257,"image":"i15731"},{"op":"text","speaker":"","text":"白羽一边说着，一边抚摸着羽未的头。"},{"op":"text","speaker":"","text":"羽未笑得像一朵盛开的花。"},{"op":"image","layer":257,"image":"i15603"},{"op":"text","speaker":"羽未","text":"“嗯！”"},{"op":"image","layer":1,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“那么，你先进浴室吧？”"},{"op":"image","layer":257,"image":"i15683"},{"op":"text","speaker":"羽未","text":"“嗯。”"},{"op":"text","speaker":"","text":"羽未欢欢喜喜地跑过走廊，向着浴室去了。"},{"op":"image","layer":1,"image":"i13235"},{"op":"text","speaker":"","text":"起居室里只留下白羽和我。"},{"op":"text","speaker":"","text":"以一种难以言喻的尴尬气氛。"},{"op":"text","speaker":"羽依里","text":"“一起洗澡，真的好吗？”"},{"op":"image","layer":1,"image":"i13307"},{"op":"text","speaker":"白羽","text":"“一……一…一点都不好……”"},{"op":"image","layer":1,"image":"i13452"},{"op":"text","speaker":"白羽","text":"“和男孩子一起泡澡……光想想就羞到想死了……”"},{"op":"text","speaker":"羽依里","text":"“这么严重……”"},{"op":"image","layer":1,"image":"i13426"},{"op":"text","speaker":"白羽","text":"“可是……”"},{"op":"image","layer":1,"image":"i13384"},{"op":"text","speaker":"白羽","text":"“这是羽未的愿望……”"},{"op":"text","speaker":"羽依里","text":"“就算是羽未的愿望，你也不用这样牺牲自己啊。”"},{"op":"image","layer":1,"image":"i13304"},{"op":"text","speaker":"白羽","text":"“羽依里，你还记得之前你对我说的话吗？”"},{"op":"text","speaker":"羽依里","text":"“之前？”"},{"op":"image","layer":1,"image":"i13235"},{"op":"text","speaker":"白羽","text":"“你说，只要让羽未做那些我自己曾经想做的事就好。”"},{"op":"image","layer":1,"image":"i13274"},{"op":"text","speaker":"白羽","text":"“这样我才更容易投入感情。”"},{"op":"text","speaker":"羽依里","text":"“嗯，我的确说过。”"},{"op":"text","speaker":"","text":"那次好像也下着雨啊。"},{"op":"image","layer":1,"image":"i13253"},{"op":"text","speaker":"白羽","text":"“和家人一起泡澡……是我记忆里没有的经历，所以有点向往。”"},{"op":"image","layer":1,"image":"i13322"},{"op":"text","speaker":"白羽","text":"“所以……就觉得可以……”"},{"op":"image","layer":1,"image":"i13304"},{"op":"text","speaker":"白羽","text":"“虽然害羞……但如果是和你的话，勉强……能承受……”"},{"op":"image","layer":1,"image":"i13294"},{"op":"text","speaker":"白羽","text":"“但愿能吧……”"},{"op":"text","speaker":"羽依里","text":"“那你要是承受不住，到时候我怎么办？”"},{"op":"image","layer":1,"image":"i13296"},{"op":"text","speaker":"白羽","text":"“也只有到了那时才知道了。”"},{"op":"text","speaker":"羽依里","text":"“这样啊……”"},{"op":"text","speaker":"","text":"感觉，有点恐怖。"},{"op":"image","layer":7,"image":"i15607"},{"op":"text","speaker":"羽未","text":"“妈妈～，还没好吗～？”"},{"op":"image","layer":1,"image":"i13337"},{"op":"text","speaker":"白羽","text":"“这就来啦。”"},{"op":"image","layer":1,"image":"i13346"},{"op":"image","layer":1,"image":"i13262"},{"op":"image","layer":1,"image":"i13263"},{"op":"text","speaker":"","text":"白羽说着，做了个深呼吸。"},{"op":"text","speaker":"","text":"就仿佛在给自己下决心。"},{"op":"text","speaker":"羽依里","text":"“好，那我们，去浴室吧。”"},{"op":"image","layer":1,"image":"i13262"},{"op":"text","speaker":"白羽","text":"“……嗯。”"},{"op":"image","layer":1,"image":"i13274"},{"op":"text","speaker":"白羽","text":"“呃……”"},{"op":"text","speaker":"羽依里","text":"“怎么了？”"},{"op":"image","layer":1,"image":"i13347"},{"op":"text","speaker":"白羽","text":"“要是你敢看这边一眼，我戳瞎你眼睛。”"},{"op":"text","speaker":"羽依里","text":"“……是。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"白羽","text":"“有没有哪里痒啊？”"},{"op":"text","speaker":"羽未","text":"“再右边一点。”"},{"op":"text","speaker":"白羽","text":"“这里？”"},{"op":"text","speaker":"羽未","text":"“就这里。”"},{"op":"text","speaker":"","text":"羽未一边让白羽帮忙洗头，一边玩闹着。"},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"text","speaker":"","text":"但我为了避免看到她们两个，只得浸在浴缸里，一直紧闭双眼。"},{"op":"text","speaker":"","text":"…我是背对着她们的，稍微睁开一点也没关系吧……？"},{"op":"text","speaker":"白羽","text":"“不许睁眼哦。”"},{"op":"text","speaker":"羽依里","text":"“是、是！”"},{"op":"text","speaker":"白羽","text":"“……我刚才是对羽未说的。”"},{"op":"text","speaker":"羽依里","text":"“哦，这样啊……”"},{"op":"text","speaker":"白羽","text":"“你……是不是睁眼了？”"},{"op":"text","speaker":"羽依里","text":"“没有……！”"},{"op":"text","speaker":"","text":"好险好险。"},{"op":"text","speaker":"","text":"不过白羽身上裹着浴巾，就算我回过头应该也看不见的。"},{"op":"text","speaker":"","text":"这应该比泳衣露得还要少吧？"},{"op":"text","speaker":"","text":"那不就没问题了。"},{"op":"text","speaker":"","text":"虽然想这么对她说，但为了眼珠子的安全，我还是闭嘴了。"},{"op":"text","speaker":"","text":"只听到背后哗啦一声，是大量热水浇下来的声音。"},{"op":"text","speaker":"羽未","text":"“呀！”"},{"op":"text","speaker":"白羽","text":"“好，洗完啦。”"},{"op":"text","speaker":"羽未","text":"“呼，谢谢妈妈。”"},{"op":"text","speaker":"羽未","text":"“接下来，羽未来帮妈妈洗。”"},{"op":"text","speaker":"白羽","text":"“哎？我？”"},{"op":"text","speaker":"白羽","text":"“我的头发可不好洗哦。”"},{"op":"text","speaker":"羽未","text":"“那就搓背。”"},{"op":"text","speaker":"白羽","text":"“嗯，搓背可以。”"},{"op":"text","speaker":"羽未","text":"“毛巾，解下来。”"},{"op":"text","speaker":"白羽","text":"“……哎？”"},{"op":"text","speaker":"","text":"……嘿嘿，羽未，这一手干得相当漂亮啊。"},{"op":"text","speaker":"羽未","text":"“快一点。”"},{"op":"text","speaker":"白羽","text":"“啊……呜…呜～……”"},{"op":"text","speaker":"白羽","text":"“那么……羽未，拜托啦。”"},{"op":"text","speaker":"羽未","text":"“嗯――！”"},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"text","speaker":"","text":"我要是现在睁眼回头，不就能看到白羽的裸……裸体了吗……"},{"op":"text","speaker":"","text":"只要鼓起一点点勇气就可以了吧？"},{"op":"text","speaker":"","text":"只要先睁开眼睛。"},{"op":"text","speaker":"","text":"然后把脖子这样一扭――"},{"op":"text","speaker":"白羽","text":"“知道看了会有什么后果吧？”"},{"op":"text","speaker":"羽依里","text":"“当然。”"},{"op":"text","speaker":"","text":"我赶紧把本已有些松开的眼睑，再一次紧紧合上。"},{"op":"text","speaker":"羽未","text":"“搓啊搓啊。”"},{"op":"text","speaker":"羽未","text":"“有没有哪里痒呀？”"},{"op":"text","speaker":"白羽","text":"“这个嘛……”"},{"op":"text","speaker":"羽未","text":"“是这里吗？”"},{"op":"text","speaker":"白羽","text":"“呀!؟”"},{"op":"goto","target":1000},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"goto","target":1002},{"op":"text","speaker":"","text":"虽然在意，但是眼睛也很宝贵。"},{"op":"text","speaker":"","text":"可话说回来……"},{"op":"text","speaker":"羽未","text":"“妈妈的背，好滑啊♪”"},{"op":"text","speaker":"","text":"羽未的声音听起来真的很开心。"},{"op":"text","speaker":"","text":"她一直渴求的就是这样的时光吧……"},{"op":"text","speaker":"白羽","text":"“我说，你为什么在笑啊？”"},{"op":"text","speaker":"羽依里","text":"“嗯？别担心，我没在看。”"},{"op":"text","speaker":"","text":"似乎是我不经意间轻笑出声了。"},{"op":"text","speaker":"","text":"白羽应该也知道我没有偷看，她的话语里并不带刺。"},{"op":"text","speaker":"","text":"泡在浴缸里的爸爸，以及正在开心地给妈妈搓背的女儿。"},{"op":"text","speaker":"","text":"嗯，的确是一家团圆。"},{"op":"text","speaker":"羽依里","text":"“话说，羽未啊。”"},{"op":"text","speaker":"羽未","text":"“嗯？”"},{"op":"text","speaker":"羽依里","text":"“接下来能麻烦你给我搓背吗？”"},{"op":"text","speaker":"羽未","text":"“哎……”"},{"op":"text","speaker":"羽未","text":"“不要……”"},{"op":"text","speaker":"羽依里","text":"“哇，居然不愿意……”"},{"op":"text","speaker":"","text":"我被她拒绝了。"},{"op":"text","speaker":"","text":"有点受打击……"},{"op":"text","speaker":"羽未","text":"“搓啊♪搓啊♪哼～♪哼哼～♪”"},{"op":"text","speaker":"","text":"羽未在浴室里哼唱着歌。"},{"op":"text","speaker":"","text":"实在是非常祥和的一段时光。"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"等泡完澡，羽未似乎就困了，进入了午睡时光。"},{"op":"image","layer":7,"image":"i15346"},{"op":"text","speaker":"羽未","text":"“呼……呼……”"},{"op":"text","speaker":"羽依里","text":"“羽未最近睡得好多啊。”"},{"op":"image","layer":1,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“是啊。”"},{"op":"image","layer":1,"image":"i13267"},{"op":"text","speaker":"白羽","text":"“感觉像个小宝宝一样。”"},{"op":"text","speaker":"羽依里","text":"“是啊。”"},{"op":"image","layer":1,"image":"i13238"},{"op":"text","speaker":"","text":"闲来无事，我翻开了羽未的日记。"},{"op":"text","speaker":"","text":"我随意翻看着，忽然注意到一件不可思议的事。"},{"op":"text","speaker":"羽依里","text":"“图画日记的天气，全都料中了啊。”"},{"op":"image","layer":1,"image":"i13314"},{"op":"text","speaker":"白羽","text":"“真的呢，好神奇啊。”"},{"op":"text","speaker":"羽依里","text":"“嗯……”"},{"op":"image","layer":2,"image":"i731"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":2},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":515,"image":"i25638"},{"op":"image","layer":259,"image":"i18131"},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15321"},{"op":"image","layer":257,"image":"i13287"},{"op":"text","speaker":"白羽","text":"‘昨天的雨……早就知道了？’"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"‘■。’"},{"op":"image","layer":257,"image":"i13346"},{"op":"text","speaker":"白羽","text":"‘……――就连明天…也早就知道了？’"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"‘■■。’"},{"op":"clear","layer":515},{"op":"clear","layer":259},{"op":"clear","layer":771},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“咦，又来了……”"},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我好像要回忆起些什么了。"},{"op":"text","speaker":"","text":"说起来，昨天好像也有过类似的事情。"},{"op":"text","speaker":"","text":"昨天好像也聊过天气的话题。"},{"op":"text","speaker":"","text":"最近总觉得脑海中有些怪怪的感觉。"},{"op":"text","speaker":"","text":"虽然一直在隐隐约约感觉有些什么东西在逐渐剥离，对此却没有什么不和谐感。"},{"op":"text","speaker":"","text":"仿佛这种现象是天经地义理所当然一般。"},{"op":"text","speaker":"","text":"明明应该是很重要的事……却有一种力量让我认为这些事可以忘却……"},{"op":"text","speaker":"","text":"――是什么力量……？"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":1795,"image":"i18201"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1795},{"op":"clear","layer":1539},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":259,"image":"i18131"},{"op":"image","layer":515,"image":"i25638"},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15436"},{"op":"text","speaker":"羽未","text":"‘虽■■开始……我■些■怕…’"},{"op":"image","layer":1,"image":"i15426"},{"op":"text","speaker":"羽未","text":"‘■在，已经■■了。’"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"‘爸■■■是，羽■的■■真■■了。’"},{"op":"clear","layer":515},{"op":"clear","layer":259},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":259,"image":"i18131"},{"op":"image","layer":515,"image":"i25638"},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15321"},{"op":"image","layer":257,"image":"i13287"},{"op":"text","speaker":"白羽","text":"‘昨天的雨……早就知道了？’"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"‘■。’"},{"op":"image","layer":257,"image":"i13346"},{"op":"text","speaker":"白羽","text":"‘……――就连明天…也早就知道了？’"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"‘■■。’"},{"op":"clear","layer":515},{"op":"clear","layer":771},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":259,"image":"i18131"},{"op":"image","layer":515,"image":"i25638"},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"‘……真■，■■妈■…’"},{"op":"image","layer":1,"image":"i15360"},{"op":"text","speaker":"羽未","text":"‘■果……总■错■……’"},{"op":"text","speaker":"羽依里","text":"‘……唉？’"},{"op":"image","layer":1,"image":"i15366"},{"op":"text","speaker":"羽未","text":"‘■过，这■夏天■■定……不再■■了……’"},{"op":"image","layer":1,"image":"i15436"},{"op":"text","speaker":"羽未","text":"‘……因■…这一■是最■的■■了……’"},{"op":"clear","layer":515},{"op":"clear","layer":259},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":259,"image":"i18131"},{"op":"image","layer":515,"image":"i25638"},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15436"},{"op":"text","speaker":"羽未","text":"‘……■是■……■■妈的。’"},{"op":"image","layer":1,"image":"i15442"},{"op":"text","speaker":"羽未","text":"‘■为……妈■■经不■了。’"},{"op":"clear","layer":515},{"op":"clear","layer":259},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":259,"image":"i18131"},{"op":"image","layer":515,"image":"i25638"},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15422"},{"op":"text","speaker":"羽未","text":"‘因■，■不■解自■■■妈。’"},{"op":"image","layer":1,"image":"i15436"},{"op":"text","speaker":"羽未","text":"‘于■……为■见■■，我■到■这■岛。’"},{"op":"image","layer":1,"image":"i15366"},{"op":"text","speaker":"羽未","text":"‘……――从■来，来■这里。’"},{"op":"clear","layer":515},{"op":"clear","layer":259},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“啊……”"},{"op":"image","layer":1,"image":"i13274"},{"op":"text","speaker":"白羽","text":"“……羽依里，怎么了？”"},{"op":"text","speaker":"羽依里","text":"“呃……总觉得……”"},{"op":"image","layer":1,"image":"i13235"},{"op":"text","speaker":"白羽","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“我忘了……”"},{"op":"image","layer":1,"image":"i13259"},{"op":"text","speaker":"白羽","text":"“？”"},{"op":"text","speaker":"","text":"不对，我是在不断地忘却。"},{"op":"text","speaker":"","text":"正有些什么东西，正在从我的脑中逐渐离开……"},{"op":"image","layer":1,"image":"i13250"},{"op":"text","speaker":"白羽","text":"“说起来，这本连环画我还没给她念完呢。”"},{"op":"image","layer":1,"image":"i13238"},{"op":"text","speaker":"","text":"她扯来一本放在角落里的连环画。"},{"op":"text","speaker":"","text":"这是我和鸥一起创作，由白羽念给羽未听的手工连环画。"},{"op":"text","speaker":"羽依里","text":"“咦……这是……”"},{"op":"image","layer":2,"image":"i731"},{"op":"image","layer":259,"image":"i18131"},{"op":"image","layer":515,"image":"i25638"},{"op":"clear","layer":2},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15591"},{"op":"image","layer":257,"image":"i13274"},{"op":"image","layer":513,"image":"i11269"},{"op":"image","layer":1,"image":"i15566"},{"op":"text","speaker":"羽未","text":"‘……我■听，■■的故■。’"},{"op":"text","speaker":"羽依里","text":"‘■■的故事啊……’"},{"op":"set","variable":26027,"value":1},{"op":"text","speaker":"羽未","text":"‘……■。’"},{"op":"image","layer":513,"image":"i11301"},{"op":"text","speaker":"鸥","text":"‘■■主题清晰，画起来也简单。’"},{"op":"text","speaker":"羽依里","text":"‘原来如此。’"},{"op":"text","speaker":"羽依里","text":"‘不过，■■的故事，有讲这个的童话吗？’"},{"op":"image","layer":513,"image":"i11299"},{"op":"text","speaker":"鸥","text":"‘拇指公主里面有出场吧。’"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"‘翅■很漂亮的■■，去■行了。’"},{"op":"clear","layer":515},{"op":"clear","layer":259},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……为什么我们最后编了这样一个故事呢？”"},{"op":"text","speaker":"","text":"我的确记得制作过这本连环画。"},{"op":"text","speaker":"","text":"但是，我们是怎么创造出里面的内容的……"},{"op":"text","speaker":"","text":"是以哪个童话作为蓝本吗？"},{"op":"text","speaker":"","text":"我应该没有从零开始编新故事的创作头脑啊……"},{"op":"image","layer":1,"image":"i13317"},{"op":"text","speaker":"白羽","text":"“嗯……到底怎么弄的来着？”"},{"op":"text","speaker":"","text":"白羽也在埋头回想。"},{"op":"text","speaker":"","text":"我翻动着连环画的书页。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"连环画的内容，是一只拥有漂亮翅膀的蝴蝶，在没有色彩的世界里旅行的故事。"},{"op":"text","speaker":"","text":"每次在旅途中遇到人，就把自己美丽翅膀上的“色彩”给予出去。"},{"op":"text","speaker":"","text":"即便翅膀逐渐失去了色彩，变得千疮百孔，蝴蝶也在继续旅途。"},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……旅途…旅途……”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"――如果这个故事中称为‘旅行’东西其实就是‘时间’呢？"},{"op":"text","speaker":"","text":"――如果她把从未来回到过去称为‘旅行’的话……"},{"op":"text","speaker":"","text":"看着眼前的连环画，我不知为何隐约有了这种想法。"},{"op":"text","speaker":"","text":"为什么会有这种想法，我已经记不清了。"},{"op":"set","variable":1,"value":0},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"实在太过荒诞不经。"},{"op":"text","speaker":"","text":"可是，我却笑不出来……"},{"op":"text","speaker":"白羽","text":"“总觉得，我在这个夏天做了弊。”"},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13238"},{"op":"text","speaker":"","text":"白羽的声音，打断了我飞速旋转的思考。"},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i13239"},{"op":"text","speaker":"","text":"我扭头看去，只见白羽正轻抚着熟睡的羽未的脑袋微笑说道。"},{"op":"text","speaker":"羽依里","text":"“作弊？”"},{"op":"image","layer":1,"image":"i13236"},{"op":"text","speaker":"白羽","text":"“听了你的话，开始扮演妈妈。”"},{"op":"image","layer":1,"image":"i13281"},{"op":"text","speaker":"白羽","text":"“一开始我以为，只要做点差不多像样的事就行了。”"},{"op":"image","layer":1,"image":"i13260"},{"op":"text","speaker":"白羽","text":"“这样一来，就有冰棒吃。”"},{"op":"text","speaker":"羽依里","text":"“冰箱里还塞得满满的呢。”"},{"op":"image","layer":1,"image":"i13239"},{"op":"text","speaker":"白羽","text":"“嗯，我知道。”"},{"op":"text","speaker":"羽依里","text":"“不过到中途就完全不见冰棒减少了。”"},{"op":"image","layer":1,"image":"i13278"},{"op":"text","speaker":"白羽","text":"“因为，扮演妈妈让我感到了快乐。”"},{"op":"text","speaker":"羽依里","text":"“不只是有趣，而是快乐？”"},{"op":"image","layer":1,"image":"i13251"},{"op":"text","speaker":"白羽","text":"“嗯。”"},{"op":"image","layer":1,"image":"i13300"},{"op":"text","speaker":"白羽","text":"“能陪在羽未身边，让我感到了快乐。”"},{"op":"image","layer":1,"image":"i13292"},{"op":"text","speaker":"白羽","text":"“现在的我，已经是自愿在当这个妈妈了。”"},{"op":"image","layer":1,"image":"i13281"},{"op":"text","speaker":"白羽","text":"“所以感觉，要是吃了冰棒，就像是承认自己在假扮一样……”"},{"op":"image","layer":1,"image":"i13275"},{"op":"text","speaker":"白羽","text":"“我放弃了冰棒，完全为了羽未当这个妈妈。”"},{"op":"image","layer":1,"image":"i13278"},{"op":"text","speaker":"白羽","text":"“为了让羽未度过一个快乐的暑假。”"},{"op":"image","layer":1,"image":"i13315"},{"op":"text","speaker":"白羽","text":"“为了孩子。”"},{"op":"image","layer":1,"image":"i13302"},{"op":"text","speaker":"白羽","text":"“正常情况下，我肯定不可能体验这样的夏天。”"},{"op":"image","layer":1,"image":"i13338"},{"op":"text","speaker":"白羽","text":"“成为了妈妈的夏天。”"},{"op":"image","layer":1,"image":"i13239"},{"op":"text","speaker":"白羽","text":"“虽说总有一天，我还能经历这样的夏天。”"},{"op":"image","layer":1,"image":"i13247"},{"op":"text","speaker":"白羽","text":"“但我作了弊，抢先体验了一下。”"},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i13246"},{"op":"text","speaker":"羽依里","text":"“这么说，你想快点有个孩子？”"},{"op":"image","layer":1,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“嗯，或许是吧。”"},{"op":"image","layer":1,"image":"i13277"},{"op":"text","speaker":"白羽","text":"“如果是像羽未这样的孩子就好了。”"},{"op":"text","speaker":"羽依里","text":"“这样啊。”"},{"op":"text","speaker":"羽依里","text":"“话说回来。”"},{"op":"text","speaker":"羽依里","text":"“现在，我们算是情侣吧？”"},{"op":"image","layer":1,"image":"i13314"},{"op":"text","speaker":"白羽","text":"“哎？嗯、嗯……”"},{"op":"image","layer":1,"image":"i13322"},{"op":"text","speaker":"白羽","text":"“或许……算吧？”"},{"op":"text","speaker":"羽依里","text":"“而且也……亲过了。”"},{"op":"image","layer":1,"image":"i13253"},{"op":"text","speaker":"白羽","text":"“嗯……亲过了。”"},{"op":"text","speaker":"羽依里","text":"“所以……这个……”"},{"op":"text","speaker":"羽依里","text":"“你对我说想要快点有孩子……”"},{"op":"image","layer":1,"image":"i13259"},{"op":"text","speaker":"白羽","text":"“……？”"},{"op":"text","speaker":"羽依里","text":"“…是想…做接吻之后的……？”"},{"op":"image","layer":1,"image":"i13367"},{"op":"text","speaker":"白羽","text":"“………”"},{"op":"image","layer":1,"image":"i13307"},{"op":"text","speaker":"白羽","text":"“才、才不是呢！就是个修辞罢了！”"},{"op":"image","layer":1,"image":"i13310"},{"op":"text","speaker":"白羽","text":"“虽然我是想要孩子……这个…色色的事情现在还太早了！”"},{"op":"text","speaker":"羽依里","text":"“现在还？”"},{"op":"image","layer":1,"image":"i13384"},{"op":"text","speaker":"白羽","text":"“……还、还…太早。”"},{"op":"text","speaker":"羽依里","text":"“既然这样，我就先忍忍吧。”"},{"op":"image","layer":1,"image":"i13381"},{"op":"text","speaker":"白羽","text":"“………”"},{"op":"image","layer":1,"image":"i13426"},{"op":"text","speaker":"白羽","text":"“暑假，马上就要结束了。”"},{"op":"text","speaker":"羽依里","text":"“是啊。”"},{"op":"image","layer":1,"image":"i13384"},{"op":"text","speaker":"白羽","text":"“到那时候，你就不在岛上了……”"},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"text","speaker":"","text":"实话说，我一直都在回避思考这件事。"},{"op":"text","speaker":"","text":"我现在能在这里是因为暑假，等暑假结束，我自然必须回去。"},{"op":"text","speaker":"","text":"回到我的家乡――"},{"op":"text","speaker":"","text":"回到原来的生活――……"},{"op":"text","speaker":"羽依里","text":"“干脆不回去了，就这样当一个岛民吧……”"},{"op":"text","speaker":"","text":"我喃喃自语……说出了这么一句话。"},{"op":"image","layer":1,"image":"i13314"},{"op":"text","speaker":"白羽","text":"“真的……？”"},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"text","speaker":"羽依里","text":"“……嗯……”"},{"op":"image","layer":1,"image":"i13274"},{"op":"text","speaker":"白羽","text":"“我看不是吧。”"},{"op":"image","layer":1,"image":"i13235"},{"op":"text","speaker":"白羽","text":"“你的眼神在躲着我。”"},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"text","speaker":"羽依里","text":"“对不起……我必须回去。”"},{"op":"image","layer":1,"image":"i13238"},{"op":"text","speaker":"白羽","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“因为我是逃到这座岛上来的。”"},{"op":"text","speaker":"羽依里","text":"“所以我不能一直逃避下去。”"},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i15456"},{"op":"text","speaker":"","text":"我看着熟睡中的羽未。"},{"op":"text","speaker":"羽依里","text":"“羽未说她在这个夏天不会再逃避。”"},{"op":"text","speaker":"羽依里","text":"“虽然我不知道这是怎么回事……”"},{"op":"text","speaker":"羽依里","text":"“但我觉得她之所以能这样欢笑，就是因为她没有逃避。”"},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i13235"},{"op":"text","speaker":"羽依里","text":"“既然这样，那我也一样不能再逃避了。”"},{"op":"image","layer":1,"image":"i13265"},{"op":"text","speaker":"白羽","text":"“为什么？”"},{"op":"text","speaker":"羽依里","text":"“或许是，因为我是羽未的爸爸吧。”"},{"op":"image","layer":1,"image":"i13250"},{"op":"text","speaker":"白羽","text":"“嗯，是啊。”"},{"op":"text","speaker":"羽依里","text":"“等暑假结束，我就要回到老家……”"},{"op":"image","layer":1,"image":"i13235"},{"op":"text","speaker":"羽依里","text":"“可是我接受不了异地恋。”"},{"op":"text","speaker":"羽依里","text":"“会寂寞死的。”"},{"op":"image","layer":1,"image":"i13353"},{"op":"text","speaker":"白羽","text":"“……好沉重……”"},{"op":"text","speaker":"羽依里","text":"“这话有点扎心啊……”"},{"op":"text","speaker":"羽依里","text":"“那么，你就能接受吗？”"},{"op":"image","layer":1,"image":"i13381"},{"op":"text","speaker":"白羽","text":"“……我会不安到死的……”"},{"op":"text","speaker":"羽依里","text":"“……好沉重……”"},{"op":"image","layer":1,"image":"i13408"},{"op":"text","speaker":"白羽","text":"“……还可能诅咒你……”"},{"op":"text","speaker":"羽依里","text":"“好吓人！”"},{"op":"image","layer":1,"image":"i13384"},{"op":"text","speaker":"白羽","text":"“……就是一种修辞嘛……”"},{"op":"text","speaker":"羽依里","text":"“那么为了不被诅咒，我会努力的。”"},{"op":"image","layer":1,"image":"i13259"},{"op":"text","speaker":"白羽","text":"“……努力？”"},{"op":"text","speaker":"羽依里","text":"“打工，攒钱，每周末都过来。”"},{"op":"image","layer":1,"image":"i13307"},{"op":"text","speaker":"白羽","text":"“哎……!؟这、这不可能的。”"},{"op":"text","speaker":"羽依里","text":"“我可以的。”"},{"op":"text","speaker":"羽依里","text":"“而且，这是我想要的。”"},{"op":"text","speaker":"羽依里","text":"“如果我是个大人，就能搬到岛上来……”"},{"op":"image","layer":1,"image":"i13314"},{"op":"text","speaker":"","text":"可我终究是个学生。"},{"op":"text","speaker":"","text":"再怎么硬撑，也成不了大人。"},{"op":"text","speaker":"","text":"也正因此，我才要挣扎。"},{"op":"text","speaker":"","text":"才要放任自己的感情，去做乱来的事。"},{"op":"image","layer":1,"image":"i13322"},{"op":"text","speaker":"白羽","text":"“怎么办……”"},{"op":"image","layer":1,"image":"i13304"},{"op":"text","speaker":"白羽","text":"“明明知道你在说不切实际的话。”"},{"op":"image","layer":0,"image":"i249"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i13305"},{"op":"image","layer":1,"image":"i13326"},{"op":"text","speaker":"白羽","text":"“……可是真的，好开心。”"},{"op":"text","speaker":"","text":"白羽虽然满脸通红，却又对着我微笑说道。"},{"op":"text","speaker":"","text":"没错，我要珍惜这个女朋友。"},{"op":"text","speaker":"","text":"让这夏天的邂逅，成为漫漫长路的开端。"},{"op":"text","speaker":"","text":"企盼着这段旅程能尽量长一点。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"text","speaker":"","text":"如果我以羽未为借口执意要求，她多半会让我一起来泡。"},{"op":"goto","target":406},{"op":"text","speaker":"白羽","text":"“这里不行……呀！”"},{"op":"goto","target":540},{"op":"text","speaker":"","text":"到底碰了哪里啊？"},{"op":"goto","target":542},{"op":"end"}]