[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i11"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我来到了神社。"},{"op":"text","speaker":"","text":"那么……做点什么呢。"},{"op":"if","truth":false,"target":9,"value":["==",["v",6032],9]},{"op":"set","variable":399,"value":1},{"op":"goto","target":9},{"op":"choice","variable":6001,"items":[{"text":"往赛钱箱里投钱","value":0,"condition":1},{"text":"去抽签","value":1,"condition":1},{"text":"开悟","value":2,"condition":["v",399]}]},{"op":"if","truth":false,"target":36,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“既然来都来了，还是先投点香火钱吧。”"},{"op":"choice","variable":6001,"items":[{"text":"10日元","value":0,"condition":1},{"text":"50日元","value":1,"condition":1},{"text":"100日元","value":2,"condition":1}]},{"op":"if","truth":false,"target":17,"value":["==",["v",6001],0]},{"op":"text","speaker":"","text":"叮当。"},{"op":"add","variable":10012,"value":10},{"op":"goto","target":17},{"op":"if","truth":false,"target":21,"value":["==",["v",6001],1]},{"op":"text","speaker":"","text":"叮当。"},{"op":"add","variable":10012,"value":50},{"op":"goto","target":21},{"op":"if","truth":false,"target":25,"value":["==",["v",6001],2]},{"op":"text","speaker":"","text":"叮当。"},{"op":"add","variable":10012,"value":100},{"op":"goto","target":25},{"op":"text","speaker":"羽依里","text":"“唔……”"},{"op":"text","speaker":"","text":"这个夏天，我到底往赛钱箱里投了多少钱啊。"},{"op":"text","speaker":"","text":"究竟能不能得到相应的灵验呢。"},{"op":"text","speaker":"","text":"不对。"},{"op":"text","speaker":"","text":"说不定，我已经得到了。"},{"op":"text","speaker":"","text":"像这样平稳地度过一个暑假。"},{"op":"text","speaker":"","text":"就已经是最大的灵验了。"},{"op":"text","speaker":"","text":"……虽然只是我的自我辩解。"},{"op":"text","speaker":"羽依里","text":"“我还是更想要一个充满波澜和冒险的暑假啊……”"},{"op":"text","speaker":"","text":"总觉得，有点难过。"},{"op":"goto","target":73},{"op":"if","truth":false,"target":41,"value":["==",["v",6001],1]},{"op":"text","speaker":"","text":"去抽签吧。"},{"op":"text","speaker":"","text":"我向存钱箱中投入了100日元。"},{"op":"callScene","scene":256,"target":2},{"op":"goto","target":41},{"op":"if","truth":false,"target":73,"value":["==",["v",6001],2]},{"op":"text","speaker":"","text":"都来了这么多次神社了。"},{"op":"text","speaker":"","text":"现在的话，也许能醒悟出一两个道理吧。"},{"op":"image","layer":0,"image":"i513"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"回想起来，这被自然的优雅所包裹，忘却了都市喧嚣的日子……"},{"op":"text","speaker":"","text":"现代人所忽视的，人与人之间紧密相连的，传统的美好生活。"},{"op":"text","speaker":"","text":"是我来到这里，最先悟到的道理。"},{"op":"text","speaker":"","text":"‘无存于有’"},{"op":"text","speaker":"","text":"无法用肉眼看到的东西，才正是我们最珍贵的宝物。"},{"op":"text","speaker":"","text":"没错。"},{"op":"text","speaker":"","text":"比如说……"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1539},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i11"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“爱之类的……”"},{"op":"text","speaker":"","text":"虽无形，却存于世。"},{"op":"text","speaker":"","text":"人与人之间的相连的牵绊，就是这样称呼的吧。"},{"op":"text","speaker":"","text":"从这大自然中获得的恩惠，也一定如此。"},{"op":"text","speaker":"","text":"爱……"},{"op":"text","speaker":"","text":"爱么……"},{"op":"text","speaker":"","text":"我，如今，知晓了爱。"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"羽依里","text":"“呵……”"},{"op":"text","speaker":"","text":"感觉自己作为一个人得到了些成长。"},{"op":"set","variable":47,"value":1},{"op":"goto","target":73},{"op":"text","speaker":"","text":"回去吧。"},{"op":"set","variable":19,"value":1},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"return"},{"op":"end"}]