[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“我说，羽未啊。”"},{"op":"image","layer":1,"image":"i15496"},{"op":"text","speaker":"羽未","text":"“嗯？”"},{"op":"text","speaker":"羽依里","text":"“还记得之前来过的鸣濑姐姐吗？”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“那个漂亮的姐姐？”"},{"op":"text","speaker":"羽依里","text":"“没，没错。”"},{"op":"text","speaker":"羽依里","text":"“你最近有没有见到她？”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“没见过。”"},{"op":"text","speaker":"羽依里","text":"“哦。”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“怎么了？”"},{"op":"text","speaker":"羽依里","text":"“有点事……”"},{"op":"text","speaker":"羽依里","text":"“嗯，就是想找她聊聊。”"},{"op":"image","layer":1,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“那去找找不就行了？”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"image","layer":1,"image":"i15547"},{"op":"text","speaker":"羽未","text":"“这岛又不大。”"},{"op":"image","layer":1,"image":"i15593"},{"op":"text","speaker":"羽未","text":"“她肯定在岛上。”"},{"op":"text","speaker":"羽依里","text":"“你说得对。”"},{"op":"return"},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“啊，羽依里哥。”"},{"op":"image","layer":1,"image":"i15472"},{"op":"text","speaker":"羽未","text":"“你在外面时有电话找你。”"},{"op":"text","speaker":"羽依里","text":"“电话？谁啊？”"},{"op":"text","speaker":"","text":"好像有人在到处找我，是那人吗？"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“鸣濑姐姐打来的。”"},{"op":"text","speaker":"羽依里","text":"“唉唉!؟”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“‘在泳池等你。’”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“她这么说。”"},{"op":"text","speaker":"羽依里","text":"“她这么说的吗？”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“嗯，就这句。”"},{"op":"text","speaker":"羽依里","text":"“在泳池等我……”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“单挑？”"},{"op":"text","speaker":"羽依里","text":"“别说得那么凶险。”"},{"op":"return"},{"op":"end"}]