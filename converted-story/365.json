[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":513,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“识姐姐，这个给你。”"},{"op":"image","layer":1,"image":"i11581"},{"op":"image","layer":257,"image":"i13001"},{"op":"text","speaker":"识","text":"“这是……”"},{"op":"text","speaker":"","text":"羽未拿来了一个印着饭团图案的三角形小包。"},{"op":"image","layer":257,"image":"i12982"},{"op":"text","speaker":"识","text":"“这不是御结饭团吗！”"},{"op":"text","speaker":"羽依里","text":"“这种小包是从哪里找出来的？”"},{"op":"image","layer":1,"image":"i11546"},{"op":"text","speaker":"镜子","text":"“在仓库里翻出来的哦。”"},{"op":"text","speaker":"羽依里","text":"“这家里的仓库到底是什么情况啊……”"},{"op":"image","layer":1,"image":"i11571"},{"op":"text","speaker":"镜子","text":"“因为你外婆她很喜欢收集这些五花八门的东西。”"},{"op":"image","layer":513,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“我在里面装了午饭，到时候可以吃哦。”"},{"op":"image","layer":513,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“顺便这是羽依里哥的，给。”"},{"op":"text","speaker":"","text":"她递给我一份装在便利店塑料袋里的午饭。"},{"op":"text","speaker":"羽依里","text":"“……无法理解……”"},{"op":"image","layer":513,"image":"i15387"},{"op":"text","speaker":"羽未","text":"“我也不是在欺负你啦。”"},{"op":"image","layer":513,"image":"i15405"},{"op":"text","speaker":"羽未","text":"“只是刚好没有合适的袋子而已。”"},{"op":"image","layer":513,"image":"i15408"},{"op":"text","speaker":"羽未","text":"“里面的东西和识姐姐的是一样的哦。”"},{"op":"text","speaker":"羽依里","text":"“嗯……有我的份就已经很开心了。”"},{"op":"text","speaker":"","text":"而且，在这个没有便利店的岛上，这塑料袋搞不好还挺珍贵的……"},{"op":"image","layer":1,"image":"i13024"},{"op":"text","speaker":"识","text":"“顺便问一下，这里面是御结饭团吗？”"},{"op":"image","layer":513,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“是炒饭。”"},{"op":"text","speaker":"","text":"嗯，我就知道。"},{"op":"image","layer":513,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“不过装进小包之后，就变成三角形了。”"},{"op":"image","layer":1,"image":"i12982"},{"op":"text","speaker":"识","text":"“那就是御结饭团嘛！”"},{"op":"image","layer":513,"image":"i15387"},{"op":"text","speaker":"羽未","text":"“是变成三角形的炒饭啦。”"},{"op":"text","speaker":"","text":"有点害羞地说道。"},{"op":"text","speaker":"","text":"她原来是个傲娇啊。"},{"op":"image","layer":1,"image":"i12978"},{"op":"text","speaker":"识","text":"“嘿嘿，谢谢你啦！”"},{"op":"image","layer":513,"image":"i15445"},{"op":"text","speaker":"羽未","text":"“……不客气。”"},{"op":"text","speaker":"","text":"羽未脸红了。"},{"op":"text","speaker":"","text":"这家伙真是羽未杀手啊……"},{"op":"return"},{"op":"end"}]