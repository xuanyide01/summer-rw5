[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i11"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我来到了神社。"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"image","layer":1,"image":"i10695"},{"op":"text","speaker":"稻荷","text":"“嘭！”"},{"op":"text","speaker":"","text":"稻荷在那里。"},{"op":"text","speaker":"羽依里","text":"“神社里有只狐狸……嗯，没什么问题。”"},{"op":"image","layer":1,"image":"i10698"},{"op":"text","speaker":"稻荷","text":"“嘭！嘭！”"},{"op":"text","speaker":"羽依里","text":"“抱歉啊，我不是苍，听不懂你在说什么。”"},{"op":"image","layer":1,"image":"i10693"},{"op":"text","speaker":"稻荷","text":"“嘭～”"},{"op":"text","speaker":"羽依里","text":"“难道说，这里是稻荷神社吗？”"},{"op":"text","speaker":"","text":"如果是这样的话，这家伙会出现在这里也就可以接受――……"},{"op":"image","layer":1,"image":"i10669"},{"op":"text","speaker":"稻荷","text":"“嘭！”"},{"op":"text","speaker":"","text":"接受……"},{"op":"image","layer":0,"image":"i11"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i10676"},{"op":"text","speaker":"稻荷","text":"“嘭。”"},{"op":"text","speaker":"","text":"……"},{"op":"image","layer":0,"image":"i199"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i10674"},{"op":"text","speaker":"稻荷","text":"“嘭♪”"},{"op":"text","speaker":"","text":"不对，要是接受了的话，不就等于承认这家伙是只狐狸了吗。"},{"op":"text","speaker":"","text":"这……"},{"op":"text","speaker":"","text":"总感觉输了。"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i11"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“总之，还是参拜吧。”"},{"op":"text","speaker":"","text":"我站到了赛钱箱的前面。"},{"op":"text","speaker":"","text":"稻荷也跟了过来。"},{"op":"text","speaker":"","text":"那么，要投多少进去呢。"},{"op":"choice","variable":6001,"items":[{"text":"10日元","value":0,"condition":1},{"text":"50日元","value":1,"condition":1},{"text":"投稻荷","value":2,"condition":1}]},{"op":"if","truth":false,"target":46,"value":["==",["v",6001],0]},{"op":"text","speaker":"","text":"叮当。"},{"op":"add","variable":10012,"value":10},{"op":"goto","target":46},{"op":"if","truth":false,"target":50,"value":["==",["v",6001],1]},{"op":"text","speaker":"","text":"叮当。"},{"op":"add","variable":10012,"value":50},{"op":"goto","target":50},{"op":"if","truth":false,"target":83,"value":["==",["v",6001],2]},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i10670"},{"op":"text","speaker":"","text":"我使劲把稻荷举了起来。"},{"op":"image","layer":1,"image":"i10679"},{"op":"text","speaker":"稻荷","text":"“嘭？”"},{"op":"text","speaker":"","text":"然后，朝着赛钱箱一扔――"},{"op":"image","layer":7,"image":"i10635"},{"op":"text","speaker":"稻荷","text":"“嘭――――！”"},{"op":"image","layer":1,"image":"i10675"},{"op":"text","speaker":"","text":"稻荷在空中转了几圈，然后在赛钱箱上华丽地着陆了。"},{"op":"text","speaker":"羽依里","text":"“稻荷，趁现在摆个帅气的表情！”"},{"op":"image","layer":0,"image":"i199"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i10681"},{"op":"text","speaker":"稻荷","text":"“嘭！”"},{"op":"text","speaker":"羽依里","text":"“哎？那就是你的帅气表情吗？”"},{"op":"image","layer":1,"image":"i10677"},{"op":"text","speaker":"稻荷","text":"“嘭。”"},{"op":"text","speaker":"羽依里","text":"“这与其说是帅气的表情不如说是……”"},{"op":"text","speaker":"羽依里","text":"“算了，也罢。”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i11"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"稻荷成为了这个神社的神体一般的存在。"},{"op":"text","speaker":"","text":"总之，还是先朝它膜拜一下吧。"},{"op":"image","layer":1,"image":"i10672"},{"op":"text","speaker":"稻荷","text":"“嘭！”"},{"op":"text","speaker":"","text":"它看起来一脸满足。"},{"op":"add","variable":10012,"value":0},{"op":"set","variable":43,"value":1},{"op":"goto","target":83},{"op":"text","speaker":"","text":"好了，回去吧。"},{"op":"set","variable":19,"value":1},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"return"},{"op":"end"}]