[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"clear","layer":2},{"op":"image","layer":0,"image":"i65"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“早……”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“早。”"},{"op":"text","speaker":"","text":"羽未今天早上依然准备好了早餐。"},{"op":"text","speaker":"羽依里","text":"“真不好意思。”"},{"op":"image","layer":1,"image":"i15401"},{"op":"text","speaker":"羽未","text":"“说好这么分工的。”"},{"op":"text","speaker":"羽依里","text":"“镜子阿姨还是不在啊。”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“她似乎起得非常早。”"},{"op":"image","layer":1,"image":"i15563"},{"op":"text","speaker":"羽未","text":"“而且……好像非常偏食……”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i456"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"说完还瞅了一眼水槽。"},{"op":"text","speaker":"","text":"那里放着的，是吃完后洗净的乌冬杯面容器。"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"image","layer":0,"image":"i65"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“她早上就吃这东西啊。”"},{"op":"image","layer":1,"image":"i15542"},{"op":"text","speaker":"羽未","text":"“得趁这段时间帮她矫正过来。”"},{"op":"text","speaker":"","text":"燃烧起了使命感。"},{"op":"text","speaker":"","text":"然而……"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i1044"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"羽未做的早餐，依旧是炒饭。"},{"op":"text","speaker":"","text":"还有股不自然的甘甜气味。"},{"op":"text","speaker":"羽依里","text":"“偏食……吗。”"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"两人一起吃早餐。"},{"op":"text","speaker":"","text":"过了这么久，还是感觉怪怪的。"},{"op":"text","speaker":"","text":"炒饭――……总感觉，甜甜的。"},{"op":"image","layer":1,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“帮我拿下酱油，爸爸。”"},{"op":"text","speaker":"羽依里","text":"“……什么？”"},{"op":"image","layer":1,"image":"i15533"},{"op":"text","speaker":"羽未","text":"“啊。”"},{"op":"image","layer":1,"image":"i15563"},{"op":"text","speaker":"羽未","text":"“叫错了。”"},{"op":"text","speaker":"羽依里","text":"“可以理解。”"},{"op":"text","speaker":"羽依里","text":"“就像有时候会不小心把老师叫成妈妈。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“啊对。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“的确是会。”"},{"op":"text","speaker":"羽依里","text":"“是吧。”"},{"op":"text","speaker":"","text":"真的会吗？"},{"op":"text","speaker":"","text":"继续吃炒饭。"},{"op":"text","speaker":"羽依里","text":"“羽未，我也要点酱油。”"},{"op":"return"},{"op":"end"}]