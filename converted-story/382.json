[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"if","truth":false,"target":5,"value":["==",["v",6003],1]},{"op":"callScene","scene":384,"target":2},{"op":"goto","target":152},{"op":"if","truth":false,"target":8,"value":["==",["v",6003],2]},{"op":"callScene","scene":383,"target":2},{"op":"goto","target":152},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“早上好，鹰原哥。”"},{"op":"text","speaker":"羽依里","text":"“嗯……呼啊……啊呼……”"},{"op":"text","speaker":"羽依里","text":"“……咦，羽未？”"},{"op":"text","speaker":"","text":"好久都没有被羽未叫醒了。"},{"op":"text","speaker":"","text":"自从识借住在家里以来，我就一直在起居室睡觉。"},{"op":"text","speaker":"","text":"早上起得比较早的镜子阿姨和羽未为了不把我弄醒，都很体贴地没有叫我起床。"},{"op":"text","speaker":"羽依里","text":"“嗯……？”"},{"op":"text","speaker":"","text":"从厨房那边传来一股香味。"},{"op":"text","speaker":"羽依里","text":"“哦，已经到饭点了啊。”"},{"op":"text","speaker":"羽依里","text":"“是海螺炒饭吗？”"},{"op":"text","speaker":"","text":"昨天拿到的海螺，光是一顿晚饭并不足以全部消耗掉。"},{"op":"image","layer":1,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“不是哦。是识姐姐在给我们做早饭。”"},{"op":"text","speaker":"羽依里","text":"“识在做？”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i65"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我走到厨房一看。"},{"op":"image","layer":1,"image":"i13029"},{"op":"text","speaker":"识","text":"“呀，羽依里你醒了啊。”"},{"op":"text","speaker":"羽依里","text":"“早上好，你……真的会做饭吗？”"},{"op":"image","layer":1,"image":"i13049"},{"op":"text","speaker":"识","text":"“真失礼啊。反过来说，你为什么会觉得我不会做饭呢？”"},{"op":"text","speaker":"羽依里","text":"“我还以为你只会做饭团呢。”"},{"op":"image","layer":1,"image":"i13057"},{"op":"text","speaker":"识","text":"“御结饭团只是我的一道拿手好菜而已。”"},{"op":"image","layer":1,"image":"i13047"},{"op":"text","speaker":"识","text":"“我可从没说过不会做其他菜哦。”"},{"op":"text","speaker":"羽依里","text":"“好像也是……”"},{"op":"image","layer":1,"image":"i13057"},{"op":"text","speaker":"识","text":"“一直都是别人给我做吃的，偶尔我也得回报一下。”"},{"op":"text","speaker":"","text":"说完，识就回去继续做菜了。"},{"op":"text","speaker":"","text":"诱人的香气变得更为浓郁了。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11549"},{"op":"image","layer":257,"image":"i13000"},{"op":"image","layer":513,"image":"i15375"},{"op":"text","speaker":"镜子","text":"“那我开始吃了哦，小识。”"},{"op":"image","layer":513,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“我开始吃了。”"},{"op":"text","speaker":"羽依里","text":"“我开始吃了。”"},{"op":"image","layer":257,"image":"i12978"},{"op":"text","speaker":"识","text":"“请慢用！”"},{"op":"text","speaker":"","text":"餐桌上摆着的菜品，让人久违地感受到了‘和风’。"},{"op":"text","speaker":"","text":"有凉拌山菜、浅渍菜、青菜味噌汤。"},{"op":"text","speaker":"","text":"主食材自然是海螺，有海螺串烧、甜辣炖煮，甚至还有壶烧。"},{"op":"text","speaker":"","text":"最后压轴的是海螺蒸饭。"},{"op":"text","speaker":"","text":"简直是海螺盛宴。"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“啊呜……嚼嚼……”"},{"op":"image","layer":257,"image":"i13000"},{"op":"text","speaker":"识","text":"“怎么样？”"},{"op":"image","layer":1,"image":"i15343"},{"op":"text","speaker":"羽未","text":"“特别……好吃！”"},{"op":"image","layer":257,"image":"i12984"},{"op":"text","speaker":"识","text":"“嗯嘿嘿。”"},{"op":"image","layer":513,"image":"i11584"},{"op":"text","speaker":"镜子","text":"“嗯，真的很好吃呢，小识。”"},{"op":"image","layer":257,"image":"i12993"},{"op":"text","speaker":"识","text":"“你们喜欢就太好了。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“镜子阿姨，你一定要尝尝这个甜辣炖煮！”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“这个真的超级好吃！”"},{"op":"text","speaker":"","text":"难得见到羽未会因为吃的东西这么兴奋。"},{"op":"image","layer":513,"image":"i11549"},{"op":"text","speaker":"镜子","text":"“让我尝尝……啊呜……嗯，真的呢。”"},{"op":"image","layer":513,"image":"i11546"},{"op":"text","speaker":"镜子","text":"“生姜的味道恰到好处，很美味呢。”"},{"op":"image","layer":257,"image":"i12984"},{"op":"text","speaker":"识","text":"“嗯嘿嘿嘿嘿。”"},{"op":"image","layer":257,"image":"i13000"},{"op":"text","speaker":"识","text":"“羽依里呢，觉得怎么――”"},{"op":"text","speaker":"羽依里","text":"“嚼嚼……咕咚。再来一碗。”"},{"op":"image","layer":513,"image":"i11566"},{"op":"image","layer":257,"image":"i13001"},{"op":"image","layer":1,"image":"i15353"},{"op":"text","speaker":"","text":"我把空碗递给了识。"},{"op":"image","layer":1,"image":"i15378"},{"op":"text","speaker":"羽未","text":"“好快！”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“鹰原哥，这么快就吃完了一碗吗？”"},{"op":"text","speaker":"羽依里","text":"“因为太好吃了。”"},{"op":"image","layer":513,"image":"i11581"},{"op":"text","speaker":"","text":"海螺蒸饭的味道实在是太棒了。"},{"op":"image","layer":257,"image":"i13000"},{"op":"text","speaker":"识","text":"“你爱吃吗？”"},{"op":"text","speaker":"羽依里","text":"“嗯。光是这个我就能吃上好几碗。”"},{"op":"text","speaker":"羽依里","text":"“比昨天的海螺炒饭更能品味到海螺的鲜味。”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“什么！”"},{"op":"image","layer":257,"image":"i12984"},{"op":"text","speaker":"识","text":"“听你这么说我很开心哦。嗯嘿嘿。”"},{"op":"text","speaker":"","text":"识开心地接过我的碗，盛了满当当一大碗饭之后还给了我。"},{"op":"image","layer":257,"image":"i12982"},{"op":"text","speaker":"识","text":"“还有很多呢，想吃多少碗都可以哦。”"},{"op":"text","speaker":"羽依里","text":"“好！”"},{"op":"image","layer":1,"image":"i15340"},{"op":"text","speaker":"羽未","text":"“一大早就这么有食欲啊。”"},{"op":"image","layer":513,"image":"i11546"},{"op":"text","speaker":"镜子","text":"“说起来，羽未你的饭也快吃完了呢。”"},{"op":"image","layer":1,"image":"i15369"},{"op":"text","speaker":"羽未","text":"“唔唔……”"},{"op":"image","layer":257,"image":"i12978"},{"op":"text","speaker":"识","text":"“要再来一碗吗？”"},{"op":"image","layer":1,"image":"i15366"},{"op":"text","speaker":"羽未","text":"“……拜托了。”"},{"op":"image","layer":513,"image":"i11581"},{"op":"text","speaker":"镜子","text":"“不过海螺饭真是好怀念呀。”"},{"op":"image","layer":513,"image":"i11549"},{"op":"text","speaker":"镜子","text":"“以前你外婆偶尔会做这个的。”"},{"op":"image","layer":257,"image":"i12982"},{"op":"text","speaker":"识","text":"“这可是岛上的传统料理哦。”"},{"op":"image","layer":513,"image":"i11566"},{"op":"text","speaker":"镜子","text":"“咦，是这样吗？”"},{"op":"text","speaker":"羽依里","text":"“镜子阿姨也不知道吗？”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“这座岛的传统料理难道不是炒饭吗？”"},{"op":"text","speaker":"羽依里","text":"“那只是羽未你自己爱吃而已吧。”"},{"op":"image","layer":513,"image":"i11571"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“呜呜～……”"},{"op":"image","layer":257,"image":"i13000"},{"op":"text","speaker":"识","text":"“如果觉得这道海螺饭好吃的话，希望你们能记住一件事。”"},{"op":"image","layer":257,"image":"i12993"},{"op":"text","speaker":"识","text":"“那就是，这座岛上有很多事物已经被遗忘了。”"},{"op":"image","layer":513,"image":"i11578"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽依里","text":"“识？”"},{"op":"image","layer":257,"image":"i12984"},{"op":"text","speaker":"识","text":"“嗯嘿嘿。”"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i37"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"识说今天想去一趟神社，于是我便带着她一起，慢悠悠地走了过去。"},{"op":"text","speaker":"羽依里","text":"“我说，你刚才为什么突然说那种话？”"},{"op":"image","layer":1,"image":"i12824"},{"op":"text","speaker":"识","text":"“那种话指的是什么？”"},{"op":"text","speaker":"羽依里","text":"“说希望大家记住这座岛上有很多事物已经被遗忘了什么的。”"},{"op":"image","layer":1,"image":"i12818"},{"op":"text","speaker":"识","text":"“我说的是希望你们记住海螺饭哦。”"},{"op":"text","speaker":"羽依里","text":"“真的吗？”"},{"op":"image","layer":1,"image":"i12815"},{"op":"text","speaker":"识","text":"“当然是真的。”"},{"op":"image","layer":1,"image":"i12777"},{"op":"text","speaker":"识","text":"“你们喜欢吃我做的海螺饭。”"},{"op":"image","layer":1,"image":"i12740"},{"op":"text","speaker":"识","text":"“所以只要记住这件事，以后就随时都能吃到了。”"},{"op":"image","layer":1,"image":"i12766"},{"op":"text","speaker":"识","text":"“就是这个意思而已。”"},{"op":"text","speaker":"羽依里","text":"“……这样啊。”"},{"op":"text","speaker":"","text":"继续问下去，识大概也不会再多说什么了。"},{"op":"text","speaker":"","text":"――希望记住那些被遗忘的东西。"},{"op":"text","speaker":"","text":"识的这番话听起来就像是在说，希望大家不要忘记她一样。"},{"op":"text","speaker":"岛上的女孩A","text":"“啊，是鬼姐姐！早上好！”"},{"op":"image","layer":1,"image":"i12743"},{"op":"text","speaker":"识","text":"“呀，是你们啊。”"},{"op":"text","speaker":"","text":"前几天一起玩捉鬼游戏的小女孩们看到了识，走了过来。"},{"op":"text","speaker":"岛上的女孩B","text":"“那边那个没人要的大哥哥也早上好。”"},{"op":"text","speaker":"羽依里","text":"“那什么，你们的情报网是不是有问题啊？”"},{"op":"text","speaker":"岛上的女孩C","text":"“咦，难道你有人要了？”"},{"op":"text","speaker":"羽依里","text":"“………没有。”"},{"op":"text","speaker":"","text":"小孩子真是残酷啊。"},{"op":"text","speaker":"岛上的女孩A","text":"“姐姐，你跑得好快啊！”"},{"op":"text","speaker":"岛上的女孩B","text":"“我们都被惊到了呢！”"},{"op":"image","layer":1,"image":"i12796"},{"op":"text","speaker":"识","text":"“那当然啦，毕竟我可是鬼嘛！”"},{"op":"text","speaker":"岛上的女孩C","text":"“真的跑得像鬼一样快呢。”"},{"op":"image","layer":1,"image":"i12799"},{"op":"text","speaker":"识","text":"“嗯嘿嘿，谢谢夸奖！”"},{"op":"text","speaker":"岛上的女孩A","text":"“我们等下要去小学的操场玩。”"},{"op":"text","speaker":"岛上的女孩A","text":"“姐姐要不要也一起来？”"},{"op":"image","layer":1,"image":"i12783"},{"op":"text","speaker":"识","text":"“我吗？”"},{"op":"text","speaker":"岛上的女孩B","text":"“来嘛，可以的吧？来一起玩嘛！”"},{"op":"text","speaker":"岛上的女孩C","text":"“要不把没人要的大哥哥也一起叫上？”"},{"op":"text","speaker":"羽依里","text":"“我就算了……”"},{"op":"image","layer":1,"image":"i12789"},{"op":"text","speaker":"识","text":"“抱歉啊，我等下要去一个地方。”"},{"op":"image","layer":1,"image":"i12777"},{"op":"text","speaker":"识","text":"“不过谢谢你们邀请我。”"},{"op":"image","layer":1,"image":"i12740"},{"op":"text","speaker":"识","text":"“下次再一起玩吧！”"},{"op":"text","speaker":"岛上的女孩A","text":"“说好了哦？”"},{"op":"image","layer":1,"image":"i12743"},{"op":"text","speaker":"识","text":"“嗯，说好了。拉钩上吊！”"},{"op":"text","speaker":"岛上的女孩B","text":"“那么，再见啦！”"},{"op":"image","layer":1,"image":"i12740"},{"op":"text","speaker":"","text":"识脸上挂着温柔的笑容，目送着跑开的女孩们。"},{"op":"text","speaker":"羽依里","text":"“真受欢迎啊。”"},{"op":"image","layer":1,"image":"i12783"},{"op":"text","speaker":"识","text":"“啊，是说我吗？”"},{"op":"text","speaker":"羽依里","text":"“不只是那些男小鬼，就连小女孩都……”"},{"op":"image","layer":1,"image":"i12777"},{"op":"text","speaker":"识","text":"“该不会是因为自己不受待见就嫉妒我吧？”"},{"op":"text","speaker":"羽依里","text":"“哼、哼哼……就算受小鬼欢迎又怎样……”"},{"op":"image","layer":1,"image":"i12789"},{"op":"text","speaker":"识","text":"“你的声音在发抖哦？”"},{"op":"text","speaker":"羽依里","text":"“我要哭了啊……”"},{"op":"image","layer":1,"image":"i12766"},{"op":"text","speaker":"识","text":"“没事，这样不也挺好嘛。”"},{"op":"text","speaker":"羽依里","text":"“哎……？”"},{"op":"image","layer":1,"image":"i12839"},{"op":"text","speaker":"识","text":"“虽然你可能会觉得我不太够格，但现在就先拿我将就着吧。”"},{"op":"text","speaker":"羽依里","text":"“……识？”"},{"op":"image","layer":1,"image":"i12821"},{"op":"text","speaker":"识","text":"“嗯嘿嘿。”"},{"op":"text","speaker":"识","text":"“好了，我们走吧。”"},{"op":"image","layer":1,"image":"i12839"},{"op":"text","speaker":"识","text":"“神社在等着我们呢。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i25"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"渔夫A","text":"“喂――！鬼姑娘！”"},{"op":"image","layer":1,"image":"i12743"},{"op":"text","speaker":"识","text":"“啊，是渔夫呢！喂――！”"},{"op":"text","speaker":"","text":"这次是那位熟悉的渔夫喊住了我们。"},{"op":"image","layer":1,"image":"i12740"},{"op":"text","speaker":"识","text":"“谢谢昨天你给了我们那么多海螺！”"},{"op":"image","layer":1,"image":"i12746"},{"op":"text","speaker":"识","text":"“真的很好吃哦！”"},{"op":"text","speaker":"渔夫A","text":"“那真是太好了。”"},{"op":"text","speaker":"渔夫A","text":"“今天也要来帮忙吗？”"},{"op":"image","layer":1,"image":"i12789"},{"op":"text","speaker":"识","text":"“抱歉啊，我这会要去别的地方。”"},{"op":"text","speaker":"渔夫B","text":"“什么啊，小姑娘不来了啊……”"},{"op":"text","speaker":"渔夫C","text":"“喂喂，别因为人家拒绝了你就这么寂寞啊。哈哈哈！”"},{"op":"text","speaker":"渔夫A","text":"“要是想吃海螺了，随时都可以来。”"},{"op":"text","speaker":"渔夫A","text":"“好好干完活之后，我会让你吃个够的。”"},{"op":"image","layer":1,"image":"i12740"},{"op":"text","speaker":"识","text":"“嗯，说好了哦！”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"","text":"受孩子们爱戴，被大人们疼爱……"},{"op":"text","speaker":"","text":"不知不觉间，识在这座岛上已经变得颇受欢迎了。"},{"op":"image","layer":1,"image":"i12766"},{"op":"text","speaker":"识","text":"“这座岛上的人，真的都是好人呢。”"},{"op":"image","layer":1,"image":"i12740"},{"op":"text","speaker":"识","text":"“即使时代变了，这一点也从未改变。”"},{"op":"text","speaker":"","text":"说着，识开心地笑了。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":1},{"op":"image","layer":0,"image":"i511"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"","text":"一路上走到哪里都有岛上居民和我们寒暄，等到达神社时，太阳已经快要落山了。"},{"op":"image","layer":0,"image":"i12"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"","text":"虽然蝉鸣声依旧，但染成了红色的神社却散发着一种宁静的气场。"},{"op":"text","speaker":"","text":"或许是因为与白天不同，拉长的影子让人感到一种不可言喻的哀愁。"},{"op":"image","layer":1,"image":"i12766"},{"op":"text","speaker":"识","text":"“羽依里，你还记得吗？”"},{"op":"text","speaker":"识","text":"“之前来这里时，我说过这座神社过去叫的是另一个名字。”"},{"op":"text","speaker":"羽依里","text":"“嗯，我记得。”"},{"op":"image","layer":1,"image":"i12844"},{"op":"text","speaker":"识","text":"“这里呢……以前叫做神山神社。”"},{"op":"text","speaker":"羽依里","text":"“神山……？”"},{"op":"text","speaker":"羽依里","text":"“那不就是你的……”"},{"op":"image","layer":1,"image":"i12849"},{"op":"text","speaker":"识","text":"“我是个无依无靠的婴儿。”"},{"op":"image","layer":1,"image":"i12815"},{"op":"text","speaker":"识","text":"“是神山神社的神主在正殿的屋檐下，发现了被遗弃的我。”"},{"op":"text","speaker":"羽依里","text":"“那是……”"},{"op":"image","layer":1,"image":"i12856"},{"op":"text","speaker":"识","text":"“就是所谓的弃婴啊。”"},{"op":"image","layer":1,"image":"i12853"},{"op":"text","speaker":"识","text":"“父母为什么要抛弃我，这我也不清楚。”"},{"op":"image","layer":1,"image":"i12783"},{"op":"text","speaker":"识","text":"“啊，当然我的父母不是岛上的人。”"},{"op":"image","layer":1,"image":"i12777"},{"op":"text","speaker":"识","text":"“他们特地从别的地方把我带来，遗弃在了神社。”"},{"op":"image","layer":1,"image":"i12786"},{"op":"text","speaker":"识","text":"“也许是想把我扔到很远的地方，让我永远都回不了家。”"},{"op":"text","speaker":"羽依里","text":"“怎么会这样……”"},{"op":"image","layer":1,"image":"i12777"},{"op":"text","speaker":"识","text":"“但是，我很幸运。”"},{"op":"image","layer":1,"image":"i12766"},{"op":"text","speaker":"识","text":"“神主大人是个非常温柔的人。”"},{"op":"image","layer":1,"image":"i12740"},{"op":"text","speaker":"识","text":"“他收养了我，把我当神山家的孩子来照顾。”"},{"op":"image","layer":1,"image":"i12777"},{"op":"text","speaker":"识","text":"“识这个名字，也是神主大人给我取的。”"},{"op":"image","layer":1,"image":"i12786"},{"op":"text","speaker":"识","text":"“但是，神主大人在我小的时候就去世了。”"},{"op":"image","layer":1,"image":"i12789"},{"op":"text","speaker":"识","text":"“毕竟他的年纪也挺大了……”"},{"op":"image","layer":1,"image":"i12773"},{"op":"text","speaker":"识","text":"“我就在这座神社里变成了孤身一人。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i445"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"识","text":"“不过，我并不觉得寂寞。”"},{"op":"text","speaker":"识","text":"“因为岛上的人都很疼爱我。”"},{"op":"text","speaker":"识","text":"“他们把我当作神山家的孩子，当作岛上的孩子抚养长大。”"},{"op":"text","speaker":"识","text":"“就像是对待公主一样珍视我。”"},{"op":"text","speaker":"识","text":"“可以说，我是被鸟白岛的所有人一起养大的。”"},{"op":"text","speaker":"","text":"识这种面对谁都不怯场的性格，大概就是在这样的环境中培养出来的吧。"},{"op":"text","speaker":"","text":"这是件幸福的事。"},{"op":"text","speaker":"","text":"如果只听到这里的话。"},{"op":"text","speaker":"识","text":"“从我懂事起，我就喜欢模仿巫女的一举一动。”"},{"op":"text","speaker":"识","text":"“不知从什么时候开始，大家开始这样称呼我。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i12"},{"op":"set","variable":6714,"value":4},{"op":"image","layer":1,"image":"i12740"},{"op":"text","speaker":"识","text":"“神山家的巫女公主。”"},{"op":"text","speaker":"","text":"巫女公主。"},{"op":"text","speaker":"","text":"这个词，是我第一次读鸟白山海文书时看到的。"},{"op":"text","speaker":"","text":"讲的是岛上一位无依无靠的神社巫女的故事。"},{"op":"text","speaker":"","text":"那个巫女果然就是识啊。"},{"op":"image","layer":1,"image":"i12777"},{"op":"text","speaker":"识","text":"“每次我想帮忙做什么事的时候，大家就会说公主殿下可千万不能干活。”"},{"op":"image","layer":1,"image":"i12773"},{"op":"text","speaker":"识","text":"“一开始我觉得很过意不去。”"},{"op":"image","layer":1,"image":"i12789"},{"op":"text","speaker":"识","text":"“但后来我明白了，这其实也是一种职责。”"},{"op":"image","layer":1,"image":"i12777"},{"op":"text","speaker":"识","text":"“因为我的地位比较接近神官，所以要处于被供奉的立场。”"},{"op":"image","layer":1,"image":"i12740"},{"op":"text","speaker":"识","text":"“岛上的人们敬重我，这样他们就能感到幸福。”"},{"op":"image","layer":1,"image":"i12789"},{"op":"text","speaker":"识","text":"“嗯嘿嘿，这种价值观可能和现在不太相符吧。”"},{"op":"image","layer":1,"image":"i12777"},{"op":"text","speaker":"识","text":"“但归根结底，大家都是很善良的人。”"},{"op":"image","layer":1,"image":"i12766"},{"op":"text","speaker":"识","text":"“大家真的很珍视我，我就在人们的关怀下长大了。”"},{"op":"text","speaker":"","text":"但是，这位巫女公主却从古文书中消失了……"},{"op":"text","speaker":"","text":"取而代之的是海贼鬼姬这样的字眼，在书上写得满满当当。"},{"op":"text","speaker":"","text":"曾经深受大家爱戴的巫女公主，如今正在变成人人憎恶的鬼姬。"},{"op":"image","layer":1,"image":"i12753"},{"op":"text","speaker":"识","text":"“羽依里？”"},{"op":"text","speaker":"羽依里","text":"“……嗯？啊，抱歉。”"},{"op":"image","layer":1,"image":"i12777"},{"op":"text","speaker":"识","text":"“我们去参拜吧。”"},{"op":"text","speaker":"羽依里","text":"“好啊。”"},{"op":"text","speaker":"","text":"在鸟居前行了一礼，进入境内。"},{"op":"text","speaker":"","text":"在手水舍净手，摇响铃铛投入赛钱――"},{"op":"text","speaker":"羽依里","text":"“是三礼三拍手一礼对吧？”"},{"op":"image","layer":1,"image":"i12818"},{"op":"text","speaker":"识","text":"“对，那是以前的参拜方式。”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"image","layer":1,"image":"i12844"},{"op":"text","speaker":"识","text":"“…………”"},{"op":"text","speaker":"","text":"最后行了一礼。"},{"op":"text","speaker":"羽依里","text":"“……我说，识。”"},{"op":"image","layer":1,"image":"i12824"},{"op":"text","speaker":"识","text":"“怎么了？”"},{"op":"text","speaker":"羽依里","text":"“神社的名字为什么会变了呢？”"},{"op":"image","layer":1,"image":"i12849"},{"op":"text","speaker":"识","text":"“不知道呢。”"},{"op":"image","layer":1,"image":"i12815"},{"op":"text","speaker":"识","text":"“也许是幸存下来的人们，为了颂扬鸣濑家的功绩而改的名吧。”"},{"op":"image","layer":1,"image":"i12849"},{"op":"text","speaker":"识","text":"“本来预知到大海啸的，就是鸣濑家的巫女。”"},{"op":"image","layer":1,"image":"i12818"},{"op":"text","speaker":"识","text":"“人们认可了她的能力，于是可能就把这里重建为鸣濑神社了。”"},{"op":"image","layer":1,"image":"i12815"},{"op":"text","speaker":"识","text":"“而且神山也变成了恶鬼。”"},{"op":"text","speaker":"羽依里","text":"“……等一下。”"},{"op":"image","layer":1,"image":"i12824"},{"op":"text","speaker":"羽依里","text":"“为了这座岛付出心血的不是你吗？”"},{"op":"text","speaker":"羽依里","text":"“可是，为什么神山……为什么识要变成坏人呢？”"},{"op":"text","speaker":"羽依里","text":"“为了大家努力却得不到任何回报……”"},{"op":"text","speaker":"羽依里","text":"“这也太不公平了吧？”"},{"op":"image","layer":1,"image":"i12789"},{"op":"text","speaker":"识","text":"“冷静点，羽依里。”"},{"op":"image","layer":1,"image":"i12777"},{"op":"text","speaker":"识","text":"“这只不过是一种假设。”"},{"op":"image","layer":1,"image":"i12740"},{"op":"text","speaker":"识","text":"“而且，预知到大海啸的确实是鸣濑家的巫女。”"},{"op":"image","layer":1,"image":"i12746"},{"op":"text","speaker":"识","text":"“我觉得她做的事情理应得到赞扬。”"},{"op":"text","speaker":"羽依里","text":"“不对！”"},{"op":"image","layer":1,"image":"i12753"},{"op":"text","speaker":"羽依里","text":"“预知当然也很重要，但问题不在这里吧！”"},{"op":"image","layer":1,"image":"i12783"},{"op":"text","speaker":"识","text":"“怎么了，羽依里？”"},{"op":"image","layer":1,"image":"i12789"},{"op":"text","speaker":"识","text":"“你没必要这么激动。”"},{"op":"image","layer":1,"image":"i12786"},{"op":"text","speaker":"识","text":"“这都已经是……一百五十年前的事情了。”"},{"op":"text","speaker":"羽依里","text":"“是现在还是一百五十年前，我都不关心。”"},{"op":"text","speaker":"羽依里","text":"“……我关心的只有你。”"},{"op":"image","layer":1,"image":"i12773"},{"op":"text","speaker":"识","text":"“原来如此，是主观和客观的区别啊。”"},{"op":"text","speaker":"","text":"识这种仿佛事不关己的态度，多少让我有些恼火。"},{"op":"text","speaker":"","text":"我明白这是为了岛上的人们。"},{"op":"text","speaker":"","text":"也明白她是出于善意信任自己的朋友。"},{"op":"text","speaker":"","text":"但是，她也太不为自己考虑了……"},{"op":"text","speaker":"羽依里","text":"“……我说，这样真的好吗？”"},{"op":"text","speaker":"羽依里","text":"“你真的打算就这样变成海盗鬼姫吗？”"},{"op":"image","layer":1,"image":"i12783"},{"op":"text","speaker":"识","text":"“喂喂，怎么到现在还在说这个？”"},{"op":"image","layer":1,"image":"i12786"},{"op":"text","speaker":"识","text":"“我们不就是为了实现这个目标，才做了这么多嘛。”"},{"op":"text","speaker":"羽依里","text":"“是这样没错……”"},{"op":"text","speaker":"羽依里","text":"“虽然是这样没错……”"},{"op":"text","speaker":"","text":"啊，不行了。"},{"op":"text","speaker":"","text":"内心的不安无法平息。"},{"op":"text","speaker":"羽依里","text":"“但是，这样下去你会……！”"},{"op":"text","speaker":"羽依里","text":"“会被岛上的所有人嫌弃！”"},{"op":"image","layer":1,"image":"i12753"},{"op":"text","speaker":"识","text":"“羽依里……？”"},{"op":"text","speaker":"羽依里","text":"“没有任何人会夸赞你。”"},{"op":"text","speaker":"羽依里","text":"“他们会说你是一个可怕的海盗，世世代代流传下去。”"},{"op":"text","speaker":"羽依里","text":"“这样真的好吗？”"},{"op":"image","layer":1,"image":"i12740"},{"op":"text","speaker":"识","text":"“当然好了啊。”"},{"op":"text","speaker":"羽依里","text":"“识……”"},{"op":"image","layer":1,"image":"i12777"},{"op":"text","speaker":"识","text":"“岛上的人们养育了我，温柔对待了我。为了救下他们，我什么都愿意做。”"},{"op":"image","layer":1,"image":"i12750"},{"op":"text","speaker":"识","text":"“就算被嫌弃也无所谓。”"},{"op":"image","layer":1,"image":"i12780"},{"op":"text","speaker":"识","text":"“就算被蔑视也无所谓。”"},{"op":"image","layer":1,"image":"i12773"},{"op":"text","speaker":"识","text":"“……我要变成鬼。”"},{"op":"image","layer":1,"image":"i12766"},{"op":"text","speaker":"识","text":"“我已经下定决心了。”"},{"op":"text","speaker":"羽依里","text":"“唔……”"},{"op":"text","speaker":"","text":"……是啊，这是识的决定。"},{"op":"text","speaker":"","text":"不该由我来多嘴。"},{"op":"text","speaker":"","text":"这点我很清楚。"},{"op":"text","speaker":"","text":"但是……"},{"op":"text","speaker":"","text":"果然还是很难过。"},{"op":"text","speaker":"","text":"太难过了。"},{"op":"image","layer":1,"image":"i12789"},{"op":"text","speaker":"识","text":"“羽依里毕竟很温柔，也许会想要保护我吧。”"},{"op":"text","speaker":"羽依里","text":"“识……”"},{"op":"image","layer":1,"image":"i12786"},{"op":"text","speaker":"识","text":"“但那是不可能的。”"},{"op":"image","layer":1,"image":"i12773"},{"op":"text","speaker":"识","text":"“因为我和你并没有生活在同一个时代。”"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"","text":"……我一直刻意回避着。"},{"op":"text","speaker":"","text":"一直没去提及那个问题。"},{"op":"text","speaker":"","text":"有一天，识可能会回到她原来的时代。"},{"op":"text","speaker":"","text":"她会不知不觉地来到这个时代，自然也会不知不觉地回到原来的时代。"},{"op":"text","speaker":"","text":"这种可能性并非为零。"},{"op":"text","speaker":"","text":"古文书已经被改写了。"},{"op":"text","speaker":"","text":"书上都是一些过去已经发生的事情。"},{"op":"text","speaker":"","text":"所以在将来，识恐怕会回到过去吧。"},{"op":"text","speaker":"","text":"那么，那究竟会是……什么时候呢……？"},{"op":"text","speaker":"羽依里","text":"“唔……！”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i1723"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"我的身体不禁做出了动作。"},{"op":"text","speaker":"识","text":"“啊……羽依里？”"},{"op":"text","speaker":"识","text":"“喂喂，你还真是大胆啊。”"},{"op":"text","speaker":"识","text":"“突然间怎么了啊？”"},{"op":"text","speaker":"羽依里","text":"“那个……”"},{"op":"text","speaker":"羽依里","text":"“说出这种话也许会惹你生气，不过……”"},{"op":"text","speaker":"识","text":"“……不过什么？”"},{"op":"text","speaker":"羽依里","text":"“就不能这样一直待在这里吗？”"},{"op":"text","speaker":"识","text":"“一直……？”"},{"op":"text","speaker":"羽依里","text":"“我知道识很努力，也知道你的目标。”"},{"op":"text","speaker":"羽依里","text":"“我一直都很支持识，也希望你能实现自己的目标。”"},{"op":"text","speaker":"羽依里","text":"“但是……”"},{"op":"text","speaker":"羽依里","text":"“……呃……”"},{"op":"text","speaker":"识","text":"“…………”"},{"op":"text","speaker":"羽依里","text":"“但是，自己喜欢上的女孩子得不到幸福，我才不要这样！”"},{"op":"text","speaker":"羽依里","text":"“这种事我绝对不要！”"},{"op":"text","speaker":"识","text":"“羽依里……”"},{"op":"text","speaker":"羽依里","text":"“我忍不了！这种事怎么可能忍得了！”"},{"op":"image","layer":0,"image":"i1724"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……识？”"},{"op":"text","speaker":"","text":"识的手正温柔地拍打着我的后背。"},{"op":"text","speaker":"","text":"轻轻地拍着。"},{"op":"text","speaker":"","text":"就像安抚孩子的母亲一样。"},{"op":"text","speaker":"识","text":"“……我不会生气的。”"},{"op":"text","speaker":"识","text":"“因为你说的这些话，都来源自你的温柔啊。”"},{"op":"text","speaker":"识","text":"“我真的很高兴哦。”"},{"op":"text","speaker":"识","text":"“谢谢你，羽依里。”"},{"op":"text","speaker":"羽依里","text":"“识……”"},{"op":"text","speaker":"识","text":"“说句心里话。”"},{"op":"text","speaker":"识","text":"“我之前也想过，要是能一直留在这里该有多好。”"},{"op":"text","speaker":"识","text":"“要是能和你一直在一起，该有多么幸福啊。”"},{"op":"text","speaker":"识","text":"“但终有一天，会被罪恶感所折磨。”"},{"op":"text","speaker":"识","text":"“留在那块石碑上的37个名字，会时刻刺痛自己的内心。”"},{"op":"text","speaker":"羽依里","text":"“那并不是你的罪过。”"},{"op":"text","speaker":"羽依里","text":"“你是不需要感到痛苦的！”"},{"op":"text","speaker":"识","text":"“说的不是我，而是你哦。”"},{"op":"text","speaker":"识","text":"“如果因为我留在这里，害得那37个人没能得救，你是会后悔一辈子的。”"},{"op":"text","speaker":"识","text":"“说不定，这个数字还会继续增加。”"},{"op":"text","speaker":"识","text":"“可能会变回原来的78人。”"},{"op":"text","speaker":"识","text":"“那样的话，痛苦的人会是你。”"},{"op":"text","speaker":"识","text":"“你会比我更加的撕心裂肺。”"},{"op":"text","speaker":"识","text":"“以一己私欲让我留下，结果导致他人死去，你肯定无法承受这个事实。”"},{"op":"text","speaker":"识","text":"“因为你已经知道了。”"},{"op":"text","speaker":"识","text":"“那些生命原本是可以获救的。”"},{"op":"text","speaker":"羽依里","text":"“没……没事的！我能承受！我……我这个人其实神经很大条的……！”"},{"op":"text","speaker":"识","text":"“你在说谎。”"},{"op":"text","speaker":"识","text":"“你才不是那样的人。”"},{"op":"text","speaker":"识","text":"“看到石碑上的数字和遇难者减少了，你很高兴对吧？”"},{"op":"text","speaker":"识","text":"“那份温柔，就是你这个人的本质啊。”"},{"op":"text","speaker":"识","text":"“我喜欢上的人呀，是一个非常温柔的人。”"},{"op":"text","speaker":"识","text":"“他是一个很好的人，都值得我去四处炫耀呢。”"},{"op":"text","speaker":"","text":"就像是在为婴儿唱摇篮曲一般……"},{"op":"text","speaker":"","text":"识用温柔的声音对我说道。"},{"op":"text","speaker":"","text":"同时轻轻地拍着我的后背。"},{"op":"text","speaker":"识","text":"“而且，不管你和我的意愿如何，我恐怕早晚都会回到原来的时代。”"},{"op":"text","speaker":"识","text":"“既然那本古文书上记录着鬼姬，就说明肯定会这样。”"},{"op":"text","speaker":"识","text":"“虽然不知道具体是什么时候……”"},{"op":"text","speaker":"识","text":"“在那一天到来之前，我们就好好在一起吧，羽依里。”"},{"op":"text","speaker":"识","text":"“啊，不对。”"},{"op":"image","layer":0,"image":"i1725"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"识","text":"“请务必要和我在一起。”"},{"op":"text","speaker":"","text":"刚才轻拍着我后背的那双手，紧紧地抱住了我。"},{"op":"text","speaker":"","text":"那双小手在微微颤抖着。"},{"op":"text","speaker":"","text":"啊……原来识也在和我想着同样的事。"},{"op":"text","speaker":"","text":"想着那终将到来的离别……"},{"op":"text","speaker":"羽依里","text":"“……嗯，我们在一起吧，识。”"},{"op":"text","speaker":"羽依里","text":"“在那一天到来之前，一直都在一起……！”"},{"op":"text","speaker":"","text":"我也紧紧地抱住了识。"},{"op":"text","speaker":"","text":"识的手停止了颤抖。"},{"op":"text","speaker":"","text":"老实说，我也很害怕那一天的到来。"},{"op":"text","speaker":"","text":"但是，如果识能够接受这样的命运……"},{"op":"text","speaker":"","text":"我也就只能接受了。"},{"op":"image","layer":0,"image":"i12"},{"op":"set","variable":6714,"value":4},{"op":"image","layer":7,"image":"i12782"},{"op":"text","speaker":"识","text":"“……对了。”"},{"op":"text","speaker":"","text":"识稍微松开了身体，从怀里拿出一样东西。"},{"op":"image","layer":1,"image":"i12802"},{"op":"text","speaker":"识","text":"“羽依里，你还带着这个吗？”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i200"},{"op":"set","variable":6714,"value":4},{"op":"image","layer":2304,"image":"i1726"},{"op":"text","speaker":"","text":"是识制作的文蛤护身符。"},{"op":"text","speaker":"羽依里","text":"“嗯，当然带着。”"},{"op":"image","layer":2304,"image":"i1719"},{"op":"text","speaker":"","text":"我也拿出了放在口袋里的护身符。"},{"op":"text","speaker":"","text":"识亲手制作的文蛤护身符，上面还画着饭团的图案。"},{"op":"text","speaker":"","text":"它一半在识的手上，另一半则在我的手上。"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":1792},{"op":"clear","layer":2304},{"op":"image","layer":0,"image":"i12"},{"op":"set","variable":6714,"value":4},{"op":"image","layer":1,"image":"i12799"},{"op":"text","speaker":"识","text":"“嗯嘿嘿，把它……这个样子。”"},{"op":"image","layer":0,"image":"i200"},{"op":"set","variable":6714,"value":4},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i12800"},{"op":"text","speaker":"","text":"识把自己的贝壳拿近我的贝壳，完美地扣合在了一起。"},{"op":"image","layer":1,"image":"i12807"},{"op":"text","speaker":"识","text":"“如果不是同一个蛤的话，文蛤的壳是没法完美契合的。”"},{"op":"image","layer":1,"image":"i12795"},{"op":"text","speaker":"识","text":"“所以作为缔结缘分的护身符，要和重要的人一人拿着一半。”"},{"op":"text","speaker":"羽依里","text":"“原来是这样啊。”"},{"op":"image","layer":1,"image":"i12807"},{"op":"text","speaker":"识","text":"“只要带着它，我们就会永远在一起。”"},{"op":"image","layer":1,"image":"i12803"},{"op":"text","speaker":"识","text":"“无论在哪里，无论身处哪个时代……”"},{"op":"text","speaker":"","text":"识这样说着，露出了笑容。"},{"op":"image","layer":1,"image":"i12800"},{"op":"text","speaker":"识","text":"“嗯嘿嘿。”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i514"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"","text":"我很明白，自己是无法阻止识的。"},{"op":"text","speaker":"","text":"虽然明白，却还是说出了那样的话，我为这样的自己感到羞愧。"},{"op":"text","speaker":"","text":"但是，只要有识送给我的这个护身符。"},{"op":"text","speaker":"","text":"即使那一天真的到来……"},{"op":"text","speaker":"","text":"我或许也能够坚强地面对……"},{"op":"text","speaker":"","text":"我尽可能这么想着。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]