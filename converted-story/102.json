[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“有人在吗～”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“欢迎。”"},{"op":"text","speaker":"羽依里","text":"“啊……你好。”"},{"op":"text","speaker":"","text":"从昏暗的店内现出的是店主老奶奶。"},{"op":"text","speaker":"羽依里","text":"“苍今天休息吗？”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“嗯，今天是在小蓝那边吧。”"},{"op":"text","speaker":"羽依里","text":"“小蓝？”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“大概是要做检查吧。”"},{"op":"text","speaker":"","text":"检查……？医院吗？"},{"op":"text","speaker":"羽依里","text":"“请问……小蓝是谁？”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“小蓝就是小蓝呗。”"},{"op":"if","truth":false,"target":18,"value":["==",["v",88],1]},{"op":"text","speaker":"","text":"难道说，就是那个时候提到的“姐姐”吗。"},{"op":"goto","target":20},{"op":"text","speaker":"羽依里","text":"“那个，我是真不知道……”"},{"op":"text","speaker":"","text":"是苍的家人吗。"},{"op":"set","variable":92,"value":1},{"op":"text","speaker":"小卖铺的老奶奶","text":"“哎呀……我稍微有点事情，看店就交给你了。”"},{"op":"text","speaker":"羽依里","text":"“唉，我？”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“反正你很闲吧？”"},{"op":"text","speaker":"羽依里","text":"“不，别看我这样其实我超忙的。”"},{"op":"text","speaker":"小卖铺的老奶奶","text":"“店里的零食你随便吃。”"},{"op":"text","speaker":"羽依里","text":"“我突然变得超级闲了，就交给我吧。”"},{"op":"text","speaker":"","text":"就这样，我开始在小卖铺打工看店。"},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"text","speaker":"羽依里","text":"“我看看……钱是在这个篮子里吗？”"},{"op":"text","speaker":"","text":"店内的天花板上垂挂着一个篮子，里面放着零钱。"},{"op":"text","speaker":"","text":"客人来的时候，找零的钱从这里拿就行了吧？"},{"op":"text","speaker":"羽依里","text":"“嗯，总有办法的。”"},{"op":"text","speaker":"羽依里","text":"“总之，先把报酬收下吧。”"},{"op":"image","layer":0,"image":"i513"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"从冰柜里拿出一根西瓜棒。"},{"op":"text","speaker":"","text":"坐在店门口的长椅上，静候着客人的到来。"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i8"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……好闲啊……”"},{"op":"text","speaker":"","text":"开始看店后，过去了差不多两个小时。"},{"op":"text","speaker":"","text":"店里只来了一个拿着零食中奖券的小鬼而已。"},{"op":"text","speaker":"羽依里","text":"“而且还是把中奖券放进箱子后，自顾自拿了新的零食就走。”"},{"op":"text","speaker":"羽依里","text":"“看样子是习以为常了。”"},{"op":"text","speaker":"羽依里","text":"“这，还有看店的意义吗……”"},{"op":"text","speaker":"","text":"听说乡下有无人售卖的蔬菜，这家店就很接近那种吧。"},{"op":"text","speaker":"","text":"虽然老奶奶说零食可以随便吃，但这样反而不好意思吃了。"},{"op":"text","speaker":"羽依里","text":"“话说回来，好热啊……”"},{"op":"text","speaker":"稻荷","text":"“嘭。”"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"image","layer":1,"image":"i10322"},{"op":"image","layer":257,"image":"i10669"},{"op":"text","speaker":"","text":"耳边传来了似曾相识的叫声，转头望去发现苍和稻荷在路边。"},{"op":"text","speaker":"羽依里","text":"“欢迎。”"},{"op":"image","layer":1,"image":"i10146"},{"op":"text","speaker":"苍","text":"“咦？你在做什么呢？”"},{"op":"text","speaker":"羽依里","text":"“临时工。”"},{"op":"image","layer":1,"image":"i10118"},{"op":"text","speaker":"苍","text":"“婆婆呢？”"},{"op":"text","speaker":"羽依里","text":"“说有事出门了。”"},{"op":"image","layer":1,"image":"i10269"},{"op":"text","speaker":"苍","text":"“难不成，你是替我干的吗？”"},{"op":"text","speaker":"羽依里","text":"“对的。”"},{"op":"image","layer":1,"image":"i10267"},{"op":"text","speaker":"苍","text":"“这样啊，还真是抱歉了。”"},{"op":"text","speaker":"羽依里","text":"“没事，反正我刚才很闲。”"},{"op":"text","speaker":"羽依里","text":"“虽然现在也很闲。”"},{"op":"image","layer":1,"image":"i10196"},{"op":"text","speaker":"苍","text":"“啊哈哈，这个时间几乎没有客人来吧？”"},{"op":"text","speaker":"羽依里","text":"“就是说啊。”"},{"op":"text","speaker":"羽依里","text":"“……你那边的事办完了？”"},{"op":"image","layer":1,"image":"i10270"},{"op":"text","speaker":"苍","text":"“唉？啊……嗯。”"},{"op":"image","layer":1,"image":"i10243"},{"op":"text","speaker":"苍","text":"“婆婆她，有说什么吗？”"},{"op":"text","speaker":"羽依里","text":"“嗯，说是――”"},{"op":"text","speaker":"","text":"……等等。"},{"op":"text","speaker":"","text":"打听小蓝的事情真的合适吗？"},{"op":"choice","variable":6001,"items":[{"text":"小蓝是谁？","value":0,"condition":1},{"text":"想不想成为偶像？","value":1,"condition":1}]},{"op":"if","truth":false,"target":124,"value":["==",["v",6001],0]},{"op":"text","speaker":"","text":"算了，干脆问了得了。"},{"op":"text","speaker":"羽依里","text":"“小蓝是谁啊？”"},{"op":"image","layer":1,"image":"i10186"},{"op":"text","speaker":"苍","text":"“……唉？”"},{"op":"text","speaker":"羽依里","text":"“那什么，因为老奶奶刚才和我说你去了小蓝那里。”"},{"op":"image","layer":1,"image":"i10316"},{"op":"text","speaker":"苍","text":"“啊……呃，怎么说呢……”"},{"op":"image","layer":1,"image":"i10396"},{"op":"text","speaker":"苍","text":"“这算是个人隐私吧，你就别问了。”"},{"op":"text","speaker":"羽依里","text":"“嗯，抱歉。”"},{"op":"text","speaker":"","text":"看来，我问了不该问的事情。"},{"op":"image","layer":1,"image":"i10235"},{"op":"text","speaker":"苍","text":"“好了，那么，打工还是换我来吧。”"},{"op":"text","speaker":"羽依里","text":"“嗯，既然专家回来了我的任务也就结束了。”"},{"op":"image","layer":1,"image":"i10227"},{"op":"text","speaker":"苍","text":"“唉？你要去哪吗？”"},{"op":"text","speaker":"羽依里","text":"“唉？我的任务不是结束了吗？”"},{"op":"image","layer":1,"image":"i10189"},{"op":"text","speaker":"苍","text":"“啊……哦，也是啊。”"},{"op":"image","layer":1,"image":"i10184"},{"op":"text","speaker":"苍","text":"“还以为你会在这里陪我闲聊呢。”"},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"text","speaker":"羽依里","text":"“也是啊，反正闲着也没事做，就在这里打发一下时间吧。”"},{"op":"image","layer":1,"image":"i10200"},{"op":"text","speaker":"苍","text":"“待在这里的话，至少可以避避暑呢。”"},{"op":"text","speaker":"羽依里","text":"“刨冰？”"},{"op":"image","layer":1,"image":"i10156"},{"op":"text","speaker":"苍","text":"“我请你啦。”"},{"op":"text","speaker":"羽依里","text":"“那，给我份店家推荐好了。”"},{"op":"image","layer":1,"image":"i10330"},{"op":"text","speaker":"苍","text":"“虽然味道都一样。”"},{"op":"text","speaker":"羽依里","text":"“知道。”"},{"op":"image","layer":1,"image":"i10279"},{"op":"text","speaker":"苍","text":"“要炼乳吗？”"},{"op":"text","speaker":"羽依里","text":"“要啊，越多越好。”"},{"op":"image","layer":1,"image":"i10389"},{"op":"text","speaker":"苍","text":"“那么，10日元哦。”"},{"op":"text","speaker":"羽依里","text":"“哦，这个要成本费吗？”"},{"op":"goto","target":189},{"op":"image","layer":1,"image":"i10182"},{"op":"text","speaker":"苍","text":"“小？”"},{"op":"text","speaker":"羽依里","text":"“想……想不想成为偶像？”"},{"op":"image","layer":1,"image":"i10186"},{"op":"text","speaker":"苍","text":"“哈？”"},{"op":"text","speaker":"羽依里","text":"“所以说，偶像啦。”"},{"op":"image","layer":1,"image":"i10121"},{"op":"text","speaker":"苍","text":"“偶像……是那个偶像吗？”"},{"op":"text","speaker":"羽依里","text":"“是那个偶像。”"},{"op":"image","layer":1,"image":"i10258"},{"op":"text","speaker":"苍","text":"“莫非你是星探!؟”"},{"op":"image","layer":1,"image":"i10246"},{"op":"text","speaker":"苍","text":"“你、你到底是……什么人？”"},{"op":"text","speaker":"羽依里","text":"“其实，我是城里某艺人事务所身负挖掘新人偶像使命的星探。”"},{"op":"text","speaker":"羽依里","text":"“你有成为顶级偶像的潜力。”"},{"op":"text","speaker":"羽依里","text":"“武道馆也好东京巨蛋也好横滨体育馆也好，座无虚席不是梦。”"},{"op":"text","speaker":"羽依里","text":"“不一起努力试试吗，目标是那最璀璨的偶像之星。”"},{"op":"image","layer":1,"image":"i10165"},{"op":"text","speaker":"苍","text":"“我、我才不会上当呢！”"},{"op":"image","layer":1,"image":"i10301"},{"op":"text","speaker":"苍","text":"“城里人都这么说……结、结果是要脱的吧!؟”"},{"op":"text","speaker":"羽依里","text":"“怎么会，我们是从杂志写真起步的优良事务所。”"},{"op":"image","layer":1,"image":"i10308"},{"op":"text","speaker":"羽依里","text":"“之后会拍短片，接广告录单曲等等一步步走下来。”"},{"op":"text","speaker":"羽依里","text":"“到最后一步从女演员转型为政客都包在我们身上哦。”"},{"op":"image","layer":1,"image":"i10290"},{"op":"text","speaker":"苍","text":"“不、不过……偶像这种抛头露脸的工作……”"},{"op":"image","layer":1,"image":"i10308"},{"op":"text","speaker":"苍","text":"“别看我这样，其实我很腼腆的……”"},{"op":"text","speaker":"羽依里","text":"“说是朋友擅自帮你报名的就好了。”"},{"op":"image","layer":1,"image":"i10311"},{"op":"text","speaker":"苍","text":"“要……要是真的出名了的话，该怎么办呢……”"},{"op":"image","layer":1,"image":"i10130"},{"op":"text","speaker":"苍","text":"“签名……得快去练习才行……”"},{"op":"image","layer":1,"image":"i10258"},{"op":"text","speaker":"苍","text":"“啊，有正规合约的吧？”"},{"op":"text","speaker":"羽依里","text":"“当然了。”"},{"op":"image","layer":1,"image":"i10184"},{"op":"text","speaker":"苍","text":"“露身子的，最多最多就是温泉桑拿或是换衣服那种程度哦？”"},{"op":"text","speaker":"羽依里","text":"“禁止事项当然会遵守好。”"},{"op":"text","speaker":"羽依里","text":"“你这么可爱，一定会叫座的。”"},{"op":"text","speaker":"羽依里","text":"“我可以保证。你可是百年一遇的人才。”"},{"op":"image","layer":1,"image":"i10295"},{"op":"text","speaker":"苍","text":"“既、既然……都说到这个地步了，那我就试一次吧……”"},{"op":"image","layer":1,"image":"i10322"},{"op":"text","speaker":"苍","text":"“总之我先去和父母商量下。”"},{"op":"image","layer":1,"image":"i10290"},{"op":"text","speaker":"苍","text":"“要是他们反对的话，你要和我一起说服他们哦？”"},{"op":"text","speaker":"羽依里","text":"“……苍。”"},{"op":"image","layer":1,"image":"i10176"},{"op":"text","speaker":"苍","text":"“怎、怎么了？”"},{"op":"text","speaker":"羽依里","text":"“你还是不要去城市为好……”"},{"op":"image","layer":1,"image":"i10269"},{"op":"text","speaker":"苍","text":"“唉？为什么？”"},{"op":"text","speaker":"羽依里","text":"“实在是太好骗了。”"},{"op":"image","layer":1,"image":"i10258"},{"op":"text","speaker":"苍","text":"“啊……”"},{"op":"image","layer":1,"image":"i10138"},{"op":"text","speaker":"苍","text":"“你、你骗我!؟”"},{"op":"image","layer":1,"image":"i10121"},{"op":"text","speaker":"苍","text":"“好过分！”"},{"op":"text","speaker":"羽依里","text":"“这种程度都能被骗到的话我是真担心你。”"},{"op":"text","speaker":"羽依里","text":"“不如说，除担心之外我都不知道说什么才好了。”"},{"op":"image","layer":1,"image":"i10301"},{"op":"text","speaker":"苍","text":"“城里人好可怕……”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"text","speaker":"","text":"之后一段时间，我就坐在小卖铺门口边吃刨冰边打发时间。"},{"op":"text","speaker":"","text":"这期间依然没有客人来。"},{"op":"text","speaker":"","text":"用空闲时间来打发空闲时间。"},{"op":"text","speaker":"","text":"还真是有够奢侈的。"},{"op":"if","truth":false,"target":203,"value":["==",["v",90],1]},{"op":"text","speaker":"羽依里","text":"“说起来。”"},{"op":"image","layer":1,"image":"i10118"},{"op":"text","speaker":"苍","text":"“嗯？”"},{"op":"text","speaker":"羽依里","text":"“昨天说的有关祭典的话题。”"},{"op":"goto","target":220},{"op":"text","speaker":"羽依里","text":"“我说这座岛上。”"},{"op":"image","layer":1,"image":"i10154"},{"op":"text","speaker":"苍","text":"“什么？”"},{"op":"text","speaker":"羽依里","text":"“就没点祭典之类的活动吗？”"},{"op":"image","layer":1,"image":"i10118"},{"op":"text","speaker":"苍","text":"“祭典？”"},{"op":"text","speaker":"羽依里","text":"“比如说，短期内大量的观光客蜂拥到岛上……”"},{"op":"text","speaker":"羽依里","text":"“然后发生杀人事件的那种。”"},{"op":"image","layer":1,"image":"i10208"},{"op":"text","speaker":"苍","text":"“才没那么危险的活动！”"},{"op":"text","speaker":"羽依里","text":"“那，不危险的活动呢？”"},{"op":"image","layer":1,"image":"i10200"},{"op":"text","speaker":"苍","text":"“有啊。”"},{"op":"image","layer":1,"image":"i10274"},{"op":"text","speaker":"苍","text":"“在港口的小册子上印着的。”"},{"op":"text","speaker":"羽依里","text":"“唉？啊……”"},{"op":"text","speaker":"羽依里","text":"“听你这么一说好像确实有这么一回事。”"},{"op":"text","speaker":"羽依里","text":"“具体来说，会做什么呢？”"},{"op":"image","layer":1,"image":"i10241"},{"op":"text","speaker":"苍","text":"“向海里放灯笼。”"},{"op":"image","layer":1,"image":"i10274"},{"op":"text","speaker":"苍","text":"“就是一个送盂兰盆节时归来的先祖回去的仪式啦。”"},{"op":"text","speaker":"羽依里","text":"“哦――”"},{"op":"text","speaker":"","text":"能印在小册子上的话，果然会是很幽美的场景吧。"},{"op":"if","truth":false,"target":232,"value":["==",["v",90],0]},{"op":"text","speaker":"羽依里","text":"“忽然开始有些期待了呢。”"},{"op":"image","layer":1,"image":"i10196"},{"op":"text","speaker":"苍","text":"“一定会印象深刻的哦。”"},{"op":"goto","target":355},{"op":"text","speaker":"羽依里","text":"“那山那边的呢？”"},{"op":"image","layer":1,"image":"i10182"},{"op":"text","speaker":"苍","text":"“都说了山里的只是风俗习惯了吧。”"},{"op":"text","speaker":"羽依里","text":"“这么说反而令人感兴趣了。”"},{"op":"image","layer":1,"image":"i10171"},{"op":"text","speaker":"苍","text":"“你还真喜欢凑热闹。”"},{"op":"text","speaker":"羽依里","text":"“因为我住的地方没这样的活动。”"},{"op":"image","layer":1,"image":"i10168"},{"op":"text","speaker":"苍","text":"“没有才好呢。”"},{"op":"image","layer":1,"image":"i10189"},{"op":"text","speaker":"苍","text":"“那种的。”"},{"op":"text","speaker":"羽依里","text":"“到底是怎么样的风俗啊……？”"},{"op":"image","layer":1,"image":"i10224"},{"op":"text","speaker":"苍","text":"“在深山老林里提着灯漫步。”"},{"op":"text","speaker":"羽依里","text":"“然后？”"},{"op":"image","layer":1,"image":"i10226"},{"op":"text","speaker":"苍","text":"“没了。”"},{"op":"text","speaker":"羽依里","text":"“……这也太朴素了吧？”"},{"op":"image","layer":1,"image":"i10290"},{"op":"text","speaker":"苍","text":"“我一开始不就这么说了吗。”"},{"op":"image","layer":1,"image":"i10344"},{"op":"text","speaker":"苍","text":"“虫子又多，周围又暗，还会有野猪冲过来，尽是麻烦事。”"},{"op":"text","speaker":"羽依里","text":"“还真是充满实际体验的发言呢，你有参加过？”"},{"op":"image","layer":1,"image":"i10308"},{"op":"text","speaker":"苍","text":"“与其说是参加过。”"},{"op":"image","layer":1,"image":"i10322"},{"op":"text","speaker":"苍","text":"“不如说那是我们家的职责。”"},{"op":"text","speaker":"羽依里","text":"“职责……！”"},{"op":"text","speaker":"","text":"忽然出现了让人激动不已的关键词。"},{"op":"image","layer":1,"image":"i10258"},{"op":"text","speaker":"苍","text":"“啊……什么意思啊，你这充满期待的眼神……”"},{"op":"text","speaker":"羽依里","text":"“就是那个吧？”"},{"op":"text","speaker":"羽依里","text":"“空门家其实是守护小岛的巫女一族之类的吧？”"},{"op":"image","layer":1,"image":"i10162"},{"op":"text","speaker":"苍","text":"“我们家可没有你想象的那种特殊力量。”"},{"op":"text","speaker":"羽依里","text":"“……太失望了……发自内心地失望。”"},{"op":"image","layer":1,"image":"i10208"},{"op":"text","speaker":"苍","text":"“别擅自期待又擅自失望啊――！”"},{"op":"text","speaker":"羽依里","text":"“结果只是晚上在山里散步而已吗……唉～……”"},{"op":"image","layer":1,"image":"i10301"},{"op":"text","speaker":"苍","text":"“呜啊啊啊啊啊――！让人火大――！”"},{"op":"text","speaker":"羽依里","text":"“……等等，女孩子独自在山里走不会很危险吗？”"},{"op":"image","layer":1,"image":"i10121"},{"op":"text","speaker":"苍","text":"“为什么？”"},{"op":"text","speaker":"羽依里","text":"“嗯，比如遇到色狼之类的。”"},{"op":"image","layer":1,"image":"i10168"},{"op":"text","speaker":"苍","text":"“别把这里和你们城里混为一谈好吗？才没有那种怪人呢。”"},{"op":"image","layer":515,"image":"i18121"},{"op":"image","layer":1,"image":"i10139"},{"op":"text","speaker":"苍","text":"“话说，你是在炫耀城里有各式各样的人吗――！”"},{"op":"clear","layer":515},{"op":"clear","layer":768},{"op":"clear","layer":1024},{"op":"text","speaker":"羽依里","text":"“等等，这种炫耀方式太奇怪了吧。”"},{"op":"image","layer":1,"image":"i10122"},{"op":"text","speaker":"","text":"都市情结复杂过头了吧。"},{"op":"text","speaker":"羽依里","text":"“既然你都说没问题了，那大概是没问题。”"},{"op":"text","speaker":"羽依里","text":"“不过，果然还是会担心的。”"},{"op":"image","layer":1,"image":"i10146"},{"op":"text","speaker":"苍","text":"“唉……”"},{"op":"image","layer":1,"image":"i10189"},{"op":"text","speaker":"苍","text":"“………”"},{"op":"image","layer":1,"image":"i10267"},{"op":"text","speaker":"苍","text":"“难道说……”"},{"op":"image","layer":1,"image":"i10270"},{"op":"text","speaker":"苍","text":"“你……迷上了我……？”"},{"op":"choice","variable":6001,"items":[{"text":"完全没有","value":0,"condition":1},{"text":"迷上了","value":1,"condition":1}]},{"op":"if","truth":false,"target":332,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“完全没有。”"},{"op":"image","layer":515,"image":"i18121"},{"op":"image","layer":1,"image":"i10125"},{"op":"text","speaker":"苍","text":"“就算是骗人也好请说迷上了啊―――！”"},{"op":"clear","layer":515},{"op":"clear","layer":768},{"op":"clear","layer":1024},{"op":"text","speaker":"羽依里","text":"“好吧。”"},{"op":"choice","variable":6001,"items":[{"text":"迷上了","value":0,"condition":1},{"text":"密上了","value":1,"condition":1}]},{"op":"if","truth":false,"target":319,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“迷上你了。”"},{"op":"image","layer":1,"image":"i10177"},{"op":"text","speaker":"苍","text":"“……哎？真、真的吗……？”"},{"op":"text","speaker":"羽依里","text":"“假的，因为你刚才说骗人也好所以我就这么说了。”"},{"op":"image","layer":1,"image":"i10138"},{"op":"text","speaker":"苍","text":"“啊啊啊啊啊啊啊！”"},{"op":"image","layer":1,"image":"i10124"},{"op":"text","speaker":"苍","text":"“你绝对是在耍我吧――――！”"},{"op":"goto","target":331},{"op":"text","speaker":"羽依里","text":"“密上你了？”"},{"op":"image","layer":1,"image":"i10160"},{"op":"text","speaker":"苍","text":"“嗯？疑问句？”"},{"op":"image","layer":1,"image":"i10182"},{"op":"text","speaker":"苍","text":"“……不如说，感觉好像意思不太对吧？”"},{"op":"text","speaker":"羽依里","text":"“只是稍微想象了一下而已。”"},{"op":"text","speaker":"羽依里","text":"“这风俗，是在晚上深山老林里秘密进行的吧？”"},{"op":"text","speaker":"羽依里","text":"“其实就是为了在没有人的地方下手……”"},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"text","speaker":"羽依里","text":"“……好恐怖……”"},{"op":"image","layer":1,"image":"i10205"},{"op":"text","speaker":"苍","text":"“你在想的东西绝对超级失礼的吧！”"},{"op":"goto","target":352},{"op":"text","speaker":"羽依里","text":"“迷上你了。”"},{"op":"image","layer":1,"image":"i10269"},{"op":"text","speaker":"苍","text":"“……哎？真、真的吗……？”"},{"op":"text","speaker":"羽依里","text":"“看我的眼睛，这像是在骗你的样子吗？”"},{"op":"image","layer":1,"image":"i10258"},{"op":"text","speaker":"苍","text":"“啊……如此正直的目光……”"},{"op":"text","speaker":"","text":"一瞥……"},{"op":"image","layer":515,"image":"i18121"},{"op":"image","layer":1,"image":"i10139"},{"op":"text","speaker":"苍","text":"“喂！为什么瞬间就移开了视线啊――――！”"},{"op":"clear","layer":515},{"op":"clear","layer":768},{"op":"clear","layer":1024},{"op":"text","speaker":"羽依里","text":"“抱歉……”"},{"op":"text","speaker":"羽依里","text":"“看来我比自己想象中还要不擅长。”"},{"op":"image","layer":1,"image":"i10122"},{"op":"text","speaker":"苍","text":"“什么啊！”"},{"op":"text","speaker":"羽依里","text":"“欺骗自己。”"},{"op":"image","layer":1,"image":"i10138"},{"op":"text","speaker":"苍","text":"“啊啊啊啊啊啊啊啊――！让人火大――――！”"},{"op":"text","speaker":"","text":"苍抱住脑袋气到不行。"},{"op":"text","speaker":"","text":"不过说回来，山祭啊。"},{"op":"text","speaker":"","text":"让女孩子一个人大半夜的在山里走，果然还是很不放心。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"return"},{"op":"end"}]