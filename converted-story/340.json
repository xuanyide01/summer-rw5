[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"text","speaker":"","text":"今天――"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i513"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"――是个晴天。"},{"op":"text","speaker":"","text":"仿佛所有的不安都烟消云散了一般。"},{"op":"text","speaker":"","text":"静久与她的母亲面对面地交谈过了。"},{"op":"text","speaker":"","text":"虽然问题依然存在，但这无疑是一个重大的进步。"},{"op":"text","speaker":"","text":"这样一来，消除记忆的可能性……也会大大降低。"},{"op":"text","speaker":"","text":"各种事情似乎都在逐渐好转。"},{"op":"text","speaker":"","text":"我有这样的预感。"},{"op":"text","speaker":"","text":"今天就是这样一个无比晴朗的日子。"},{"op":"image","layer":0,"image":"i366"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i14377"},{"op":"image","layer":257,"image":"i13820"},{"op":"text","speaker":"静久","text":"“今天不可以进海之家哦。”"},{"op":"text","speaker":"羽依里","text":"“哎――”"},{"op":"image","layer":1,"image":"i14534"},{"op":"text","speaker":"紬","text":"“姆啾――”"},{"op":"text","speaker":"","text":"紬也跟着露出不满的表情。"},{"op":"image","layer":257,"image":"i13813"},{"op":"text","speaker":"静久","text":"“抱歉呢，今天忘记带钥匙了，开不了门。”"},{"op":"image","layer":1,"image":"i14520"},{"op":"text","speaker":"紬","text":"“哦！原来是这样啊。那就没办法了。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":1,"image":"i11829"},{"op":"image","layer":257,"image":"i10112"},{"op":"text","speaker":"美希","text":"“早上好啊，三位。”"},{"op":"image","layer":1,"image":"i11753"},{"op":"text","speaker":"美希","text":"“啊，水织学姐。能借用一下钥匙吗？”"},{"op":"image","layer":7,"image":"i13923"},{"op":"text","speaker":"静久","text":"“好的，请用这个。”"},{"op":"image","layer":257,"image":"i10115"},{"op":"text","speaker":"苍","text":"“我把这些搬进去。”"},{"op":"set","variable":484,"value":32},{"op":"image","layer":7,"image":"i13932"},{"op":"text","speaker":"静久","text":"“嗯，拜托了。”"},{"op":"set","variable":484,"value":0},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“你这不是带钥匙了吗？”"},{"op":"image","layer":1,"image":"i14377"},{"op":"image","layer":257,"image":"i13813"},{"op":"text","speaker":"静久","text":"“是这样吗？”"},{"op":"image","layer":1,"image":"i14452"},{"op":"text","speaker":"紬","text":"“静久……”"},{"op":"image","layer":257,"image":"i13782"},{"op":"text","speaker":"静久","text":"“怎么了？”"},{"op":"image","layer":1,"image":"i14447"},{"op":"text","speaker":"紬","text":"“说谎是？”"},{"op":"image","layer":257,"image":"i13935"},{"op":"text","speaker":"静久","text":"“说了哦。”"},{"op":"image","layer":1,"image":"i14396"},{"op":"text","speaker":"紬","text":"“姆啾!؟”"},{"op":"image","layer":257,"image":"i13959"},{"op":"text","speaker":"静久","text":"“不过紬，这个谎话是无伤大雅的哦。”"},{"op":"image","layer":1,"image":"i14529"},{"op":"text","speaker":"紬","text":"“无伤大雅的谎话……”"},{"op":"image","layer":1,"image":"i14518"},{"op":"text","speaker":"紬","text":"“原来是这样啊，那就没问题了。”"},{"op":"text","speaker":"羽依里","text":"“就这么接受了啊？”"},{"op":"image","layer":1,"image":"i14386"},{"op":"text","speaker":"紬","text":"“可是，苍和野村她们就可以进去吗？”"},{"op":"image","layer":257,"image":"i13933"},{"op":"text","speaker":"静久","text":"“今天海之家要庆祝奶子日。”"},{"op":"image","layer":257,"image":"i13938"},{"op":"text","speaker":"静久","text":"“只有被选中的奶子才可以进去哦。”"},{"op":"image","layer":1,"image":"i14445"},{"op":"text","speaker":"紬","text":"“既然是这样，那也没办法呢。”"},{"op":"text","speaker":"羽依里","text":"“又接受了啊。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":1,"image":"i15008"},{"op":"image","layer":257,"image":"i12144"},{"op":"text","speaker":"良一","text":"“早啊，我来帮忙了――”"},{"op":"image","layer":7,"image":"i13845"},{"op":"text","speaker":"静久","text":"“哎呀，早啊。”"},{"op":"image","layer":1,"image":"i15014"},{"op":"text","speaker":"天善","text":"“打扰了。不……我会尽量不给您添麻烦的……”"},{"op":"image","layer":1,"image":"i15035"},{"op":"text","speaker":"天善","text":"“不仅如此，我还要让你们看到我最出色的表现！”"},{"op":"image","layer":7,"image":"i13778"},{"op":"text","speaker":"静久","text":"“好的，拜托了。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“不是奶子的人也进去了啊？”"},{"op":"image","layer":1,"image":"i14377"},{"op":"image","layer":257,"image":"i13743"},{"op":"text","speaker":"静久","text":"“男人也是有奶子的哦。”"},{"op":"text","speaker":"羽依里","text":"“好吧……是这样没错。”"},{"op":"text","speaker":"","text":"唔――"},{"op":"text","speaker":"羽依里","text":"“不多问什么了，总之今天就是进不了海之家。”"},{"op":"text","speaker":"羽依里","text":"“我可以这样理解吗？”"},{"op":"image","layer":257,"image":"i13930"},{"op":"text","speaker":"静久","text":"“是的，就是这样哦♪”"},{"op":"text","speaker":"羽依里","text":"“明白了。”"},{"op":"text","speaker":"羽依里","text":"“那么紬，今天我们两个一起玩吧？”"},{"op":"image","layer":1,"image":"i14529"},{"op":"text","speaker":"紬","text":"“这是出轨吗？”"},{"op":"text","speaker":"羽依里","text":"“不是啦。”"},{"op":"image","layer":257,"image":"i13855"},{"op":"text","speaker":"静久","text":"“不是吗？”"},{"op":"text","speaker":"羽依里","text":"“不是。”"},{"op":"image","layer":1,"image":"i14381"},{"op":"text","speaker":"紬","text":"“那我们要玩什么呢？”"},{"op":"text","speaker":"羽依里","text":"“要不一起去捡垃圾吧？”"},{"op":"image","layer":1,"image":"i14386"},{"op":"text","speaker":"紬","text":"“会很无聊的哦？”"},{"op":"text","speaker":"羽依里","text":"“那我们两个一起快点干完吧。”"},{"op":"image","layer":1,"image":"i14461"},{"op":"text","speaker":"紬","text":"“知道了！”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i48"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"和紬两个人一起捡垃圾。"},{"op":"image","layer":1,"image":"i14381"},{"op":"text","speaker":"紬","text":"“今天的静久，看起来心情很好呢。”"},{"op":"text","speaker":"羽依里","text":"“嗯，因为和妈妈的关系稍微好转了一点。”"},{"op":"image","layer":1,"image":"i14489"},{"op":"text","speaker":"紬","text":"“姆啾！是这样啊……我都不知道。”"},{"op":"text","speaker":"羽依里","text":"“啊，抱歉。”"},{"op":"image","layer":1,"image":"i14530"},{"op":"text","speaker":"紬","text":"“为什么要道歉呢？”"},{"op":"text","speaker":"羽依里","text":"“因为没有把这件事告诉你。”"},{"op":"image","layer":1,"image":"i14526"},{"op":"text","speaker":"紬","text":"“姆啾？在我不知道的时候，羽依里先生一直在帮助静久呢。”"},{"op":"image","layer":1,"image":"i14420"},{"op":"text","speaker":"紬","text":"“羽依里先生真是厉害。”"},{"op":"text","speaker":"羽依里","text":"“这样啊，我还以为你会嫉妒呢。”"},{"op":"image","layer":1,"image":"i14463"},{"op":"text","speaker":"紬","text":"“不会的哦。”"},{"op":"image","layer":1,"image":"i14460"},{"op":"text","speaker":"紬","text":"“我觉得有些难过的事情，确实是不太想让别人知道的。”"},{"op":"image","layer":1,"image":"i14470"},{"op":"text","speaker":"紬","text":"“所以就算有不知道的事情，我也完全不会在意。”"},{"op":"text","speaker":"羽依里","text":"“紬可真是成熟啊。”"},{"op":"image","layer":1,"image":"i14508"},{"op":"text","speaker":"紬","text":"“哎嘿嘿～”"},{"op":"text","speaker":"","text":"人与人之间，各自都存在着不同的距离感、相性和相处方式。"},{"op":"text","speaker":"","text":"紬这样的性格，大概和静久就真的很合得来吧。"},{"op":"text","speaker":"羽依里","text":"“不过，她和母亲的关系，似乎已经好了不少。”"},{"op":"text","speaker":"羽依里","text":"“因为被骂而消除记忆这种事，今后可能不会有了。”"},{"op":"image","layer":1,"image":"i14381"},{"op":"text","speaker":"紬","text":"“那真是太好了♪”"},{"op":"image","layer":1,"image":"i14425"},{"op":"text","speaker":"紬","text":"“今天……我们要玩些什么呢？”"},{"op":"text","speaker":"羽依里","text":"“唔，好像海之家那边在做着什么准备，今天可能玩不了了吧。”"},{"op":"image","layer":1,"image":"i14473"},{"op":"text","speaker":"紬","text":"“是这样啊，那还真让人期待呢。”"},{"op":"text","speaker":"","text":"期待……吗。"},{"op":"text","speaker":"","text":"没想到在暑假快结束的时候，还能听到这样的话。"},{"op":"image","layer":1,"image":"i14512"},{"op":"text","speaker":"紬","text":"“羽依里先生。”"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"image","layer":1,"image":"i14423"},{"op":"text","speaker":"紬","text":"“不过，静久……真的像是在过暑假呢。”"},{"op":"text","speaker":"羽依里","text":"“过暑假？”"},{"op":"image","layer":1,"image":"i14384"},{"op":"text","speaker":"紬","text":"“是的。”"},{"op":"image","layer":1,"image":"i14425"},{"op":"text","speaker":"紬","text":"“每一年，夏天都会如期而至……每一年都会有暑假。”"},{"op":"image","layer":1,"image":"i14423"},{"op":"text","speaker":"紬","text":"“但是，不会有一模一样的夏天……也不存在一模一样的暑假。”"},{"op":"image","layer":1,"image":"i14506"},{"op":"text","speaker":"紬","text":"“就算反复做着同一件事情……”"},{"op":"image","layer":1,"image":"i14508"},{"op":"text","speaker":"紬","text":"“那一定也有着不一样的体会。”"},{"op":"image","layer":1,"image":"i14510"},{"op":"text","speaker":"紬","text":"“去年的事情会稍微有些不记得了，于是又会感到新鲜。”"},{"op":"image","layer":1,"image":"i14473"},{"op":"text","speaker":"紬","text":"“所以无论做多少次，都会觉得开心……都会感到兴奋。”"},{"op":"image","layer":1,"image":"i14417"},{"op":"text","speaker":"紬","text":"“如果能像这样快乐地度过暑假的话。”"},{"op":"image","layer":1,"image":"i14423"},{"op":"text","speaker":"紬","text":"“哪怕静久一次又一次地失去记忆……”"},{"op":"image","layer":1,"image":"i14438"},{"op":"text","speaker":"紬","text":"“我们肯定还是能一起开心地玩耍。”"},{"op":"text","speaker":"羽依里","text":"“紬……”"},{"op":"text","speaker":"羽依里","text":"“也许确实如此啊。”"},{"op":"text","speaker":"","text":"与其回顾上一个的暑假的快乐。"},{"op":"text","speaker":"","text":"不如对下一个暑假心怀期待。"},{"op":"text","speaker":"","text":"静久和紬，一定都是这样想的。"},{"op":"text","speaker":"羽依里","text":"“刚才那番话，真的让我挺感动的。”"},{"op":"image","layer":1,"image":"i14548"},{"op":"text","speaker":"紬","text":"“是吗……”"},{"op":"image","layer":1,"image":"i14530"},{"op":"text","speaker":"紬","text":"“……不过。”"},{"op":"image","layer":1,"image":"i14545"},{"op":"text","speaker":"紬","text":"“因为我没怎么上过学，所以这只是我的想象而已。”"},{"op":"text","speaker":"羽依里","text":"“哎――……”"},{"op":"image","layer":1,"image":"i14381"},{"op":"text","speaker":"紬","text":"“但是，我的朋友们每年都是这样的。”"},{"op":"text","speaker":"羽依里","text":"“这样啊。”"},{"op":"text","speaker":"","text":"不过，她说得对。"},{"op":"image","layer":1,"image":"i14425"},{"op":"text","speaker":"紬","text":"“如果静久就像是在过暑假的话……”"},{"op":"image","layer":1,"image":"i14420"},{"op":"text","speaker":"紬","text":"“无论来多少次，我们都要怀着期待的心情迎接她呢。”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"text","speaker":"","text":"无论忘记多少次……"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i48"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“哇！”"},{"op":"image","layer":1,"image":"i14532"},{"op":"text","speaker":"紬","text":"“姆啾!؟”"},{"op":"text","speaker":"","text":"风吹起了一些沙子。"},{"op":"text","speaker":"羽依里","text":"“风好像变大了啊。”"},{"op":"image","layer":1,"image":"i14534"},{"op":"text","speaker":"紬","text":"“是啊，浪也比平时要高。”"},{"op":"text","speaker":"","text":"云的流动也和平时有些不一样……"},{"op":"text","speaker":"羽依里","text":"“渡轮没问题吗？”"},{"op":"image","layer":1,"image":"i14401"},{"op":"text","speaker":"紬","text":"“如果静久回不去就麻烦了，我们去问问看吧？”"},{"op":"text","speaker":"羽依里","text":"“好啊。”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i1"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"到了渡轮码头，看到售票处贴着一张告示。"},{"op":"text","speaker":"羽依里","text":"“因台风接近，今日全船停航……吗。”"},{"op":"text","speaker":"羽依里","text":"“没看天气预报，不过果然会这样啊。”"},{"op":"image","layer":1,"image":"i14388"},{"op":"text","speaker":"紬","text":"“静久，回不去了呢。”"},{"op":"text","speaker":"羽依里","text":"“是啊。早点告诉她吧。”"},{"op":"image","layer":1,"image":"i14492"},{"op":"text","speaker":"紬","text":"“得帮她找个住的地方呢。”"},{"op":"text","speaker":"羽依里","text":"“让她住紬那里？”"},{"op":"image","layer":1,"image":"i14530"},{"op":"text","speaker":"紬","text":"“当然也可以，不过我觉得直接去羽依里先生的房间住就好了。”"},{"op":"text","speaker":"羽依里","text":"“哎？”"},{"op":"image","layer":1,"image":"i14554"},{"op":"text","speaker":"紬","text":"“反正你们是恋人嘛，没问题的。”"},{"op":"text","speaker":"羽依里","text":"“是恋人的话，反而会有问题。”"},{"op":"image","layer":1,"image":"i14529"},{"op":"text","speaker":"紬","text":"“姆啾？为什么呢？”"},{"op":"text","speaker":"羽依里","text":"“这其中有很多原因。”"},{"op":"image","layer":1,"image":"i14452"},{"op":"text","speaker":"紬","text":"“这样啊……世界还真是复杂呢。”"},{"op":"text","speaker":"羽依里","text":"“啊……不过如果紬也一起的话，或许就没问题了。”"},{"op":"image","layer":1,"image":"i14401"},{"op":"text","speaker":"紬","text":"“姆啾？可以吗？那我也很开心！”"},{"op":"text","speaker":"羽依里","text":"“不过得先去问问镜子阿姨。”"},{"op":"image","layer":1,"image":"i14381"},{"op":"text","speaker":"紬","text":"“走吧！”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11584"},{"op":"text","speaker":"镜子","text":"“可以哦。”"},{"op":"text","speaker":"","text":"看来没问题。"},{"op":"image","layer":1,"image":"i11599"},{"op":"text","speaker":"镜子","text":"“小静久，好久没见她了啊～”"},{"op":"image","layer":1,"image":"i11546"},{"op":"text","speaker":"镜子","text":"“不知道她都变成什么样了呢？”"},{"op":"text","speaker":"羽依里","text":"“你们上次见面，还是我身体不太舒服那次。”"},{"op":"text","speaker":"羽依里","text":"“当时都没怎么说上话吗？”"},{"op":"image","layer":1,"image":"i11557"},{"op":"text","speaker":"镜子","text":"“嗯。”"},{"op":"image","layer":1,"image":"i11581"},{"op":"text","speaker":"镜子","text":"“不过，要是只有羽依里和静久过夜的话，还真有点担心。”"},{"op":"image","layer":1,"image":"i11575"},{"op":"text","speaker":"镜子","text":"“三个人的话就放心了。”"},{"op":"image","layer":257,"image":"i14529"},{"op":"text","speaker":"紬","text":"“为什么两个人会让人担心呢？”"},{"op":"image","layer":1,"image":"i11619"},{"op":"text","speaker":"镜子","text":"“这、这个嘛！”"},{"op":"image","layer":257,"image":"i14522"},{"op":"text","speaker":"紬","text":"“姆啾？脸好红啊……”"},{"op":"text","speaker":"羽依里","text":"“总之，先告诉静久渡轮停运的事吧。”"},{"op":"image","layer":257,"image":"i14381"},{"op":"text","speaker":"紬","text":"“是呢。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i366"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11689"},{"op":"image","layer":257,"image":"i13775"},{"op":"image","layer":513,"image":"i10154"},{"op":"text","speaker":"苍","text":"“这边差不多完成了～”"},{"op":"image","layer":1,"image":"i11750"},{"op":"text","speaker":"美希","text":"“这边也是。剩下的就等当天收尾了。”"},{"op":"image","layer":257,"image":"i13816"},{"op":"text","speaker":"静久","text":"“哎呀！做得真漂亮呢。”"},{"op":"image","layer":257,"image":"i13813"},{"op":"text","speaker":"静久","text":"“谢谢你们两位。”"},{"op":"image","layer":1,"image":"i15008"},{"op":"image","layer":257,"image":"i13775"},{"op":"image","layer":513,"image":"i12174"},{"op":"text","speaker":"良一","text":"“这边今天可能来不及完工了。”"},{"op":"image","layer":1,"image":"i15014"},{"op":"text","speaker":"天善","text":"“可以明天再来帮忙吗？”"},{"op":"image","layer":257,"image":"i13933"},{"op":"text","speaker":"静久","text":"“当然可以♪我这边也快完成了，到时候来帮你。”"},{"op":"image","layer":1,"image":"i15026"},{"op":"text","speaker":"天善","text":"“水、水织学姐，怎么能麻烦您来帮忙――！”"},{"op":"text","speaker":"羽依里","text":"“我回来了。”"},{"op":"image","layer":1,"image":"i14377"},{"op":"image","layer":257,"image":"i13921"},{"op":"text","speaker":"静久","text":"“哎呀，欢迎回来♪”"},{"op":"image","layer":1,"image":"i14386"},{"op":"text","speaker":"紬","text":"“静久……发生了件麻烦的事情。”"},{"op":"image","layer":257,"image":"i13864"},{"op":"text","speaker":"静久","text":"“怎么了？”"},{"op":"text","speaker":"羽依里","text":"“好像说台风要来，渡轮停运了。”"},{"op":"image","layer":257,"image":"i13879"},{"op":"text","speaker":"静久","text":"“是这样啊。明明这会儿看起来还好好的。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"image","layer":1,"image":"i12147"},{"op":"text","speaker":"良一","text":"“不，这个海风的味道还有湿度……肯定要变天。”"},{"op":"image","layer":1,"image":"i12150"},{"op":"text","speaker":"良一","text":"“渔民的直觉是这么说的。”"},{"op":"image","layer":7,"image":"i13875"},{"op":"text","speaker":"静久","text":"“三谷同学真厉害呢。”"},{"op":"image","layer":1,"image":"i12193"},{"op":"text","speaker":"良一","text":"“没什么大不了的。”"},{"op":"text","speaker":"羽依里","text":"“那个，静久，要不要来我家住？”"},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i15076"},{"op":"image","layer":257,"image":"i11718"},{"op":"image","layer":513,"image":"i10135"},{"op":"text","speaker":"美希","text":"“什么!؟”"},{"op":"image","layer":1,"image":"i15035"},{"op":"text","speaker":"天善","text":"“你说什么!؟”"},{"op":"image","layer":513,"image":"i10124"},{"op":"text","speaker":"苍","text":"“等一下!؟”"},{"op":"text","speaker":"羽依里","text":"“不是，别误会啊。紬也会来一起住，而且镜子阿姨也在家的。”"},{"op":"image","layer":257,"image":"i11769"},{"op":"text","speaker":"美希","text":"“这、这样啊……”"},{"op":"image","layer":1,"image":"i15038"},{"op":"text","speaker":"天善","text":"“既然这样的话。”"},{"op":"image","layer":513,"image":"i10138"},{"op":"text","speaker":"苍","text":"“紬、紬和镜子阿姨也要一起!؟”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"image","layer":1,"image":"i13804"},{"op":"image","layer":257,"image":"i12141"},{"op":"text","speaker":"静久","text":"“唔，是呢……不过，会不会打扰到你们啊？”"},{"op":"image","layer":257,"image":"i12174"},{"op":"text","speaker":"良一","text":"“水织学姐错过末班船后，都是在这里过夜的吗？”"},{"op":"image","layer":1,"image":"i13840"},{"op":"text","speaker":"静久","text":"“是啊，没错。”"},{"op":"image","layer":257,"image":"i12147"},{"op":"text","speaker":"良一","text":"“虽然我觉得海浪应该不会涨到这里，不过要是有垃圾之类的东西飞过来把窗户砸碎，那就会很危险了。”"},{"op":"image","layer":257,"image":"i12141"},{"op":"text","speaker":"良一","text":"“我觉得还是老老实实去羽依里家比较好。”"},{"op":"image","layer":1,"image":"i13855"},{"op":"text","speaker":"静久","text":"“也是啊。那么，就让我去打扰一下了？”"},{"op":"text","speaker":"羽依里","text":"“好的。”"},{"op":"image","layer":1,"image":"i13930"},{"op":"text","speaker":"静久","text":"“那么各位，今天谢谢大家♪”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":1,"image":"i15008"},{"op":"image","layer":257,"image":"i11689"},{"op":"image","layer":513,"image":"i10154"},{"op":"image","layer":769,"image":"i12141"},{"op":"text","speaker":"苍","text":"“哪里哪里，我们也正想这么做呢。”"},{"op":"image","layer":257,"image":"i11869"},{"op":"text","speaker":"美希","text":"“到那天之前，也要跟白羽和那个黑头发的女孩说一声。”"},{"op":"image","layer":769,"image":"i12188"},{"op":"text","speaker":"良一","text":"“毕竟她们没来欢迎会，至少――”"},{"op":"image","layer":1,"image":"i15038"},{"op":"text","speaker":"天善","text":"“――这话就说到这里吧。”"},{"op":"image","layer":769,"image":"i12174"},{"op":"text","speaker":"良一","text":"“啊，抱歉抱歉。”"},{"op":"text","speaker":"","text":"大家一边说着这些，一边散去了。"},{"op":"text","speaker":"羽依里","text":"“你们这是聚起来干嘛啊？”"},{"op":"image","layer":1,"image":"i13935"},{"op":"text","speaker":"静久","text":"“保密哦♪”"},{"op":"text","speaker":"","text":"算了，无所谓。"},{"op":"image","layer":1,"image":"i13894"},{"op":"text","speaker":"静久","text":"“那么，待会儿我就去你们家打扰了。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"clear","layer":769},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“啊……”"},{"op":"text","speaker":"静久","text":"“晚上好―”"},{"op":"text","speaker":"","text":"好像她来了。"},{"op":"image","layer":1,"image":"i11549"},{"op":"text","speaker":"镜子","text":"“来啦。”"},{"op":"text","speaker":"","text":"镜子阿姨朝玄关走去。"},{"op":"image","layer":7,"image":"i11616"},{"op":"text","speaker":"镜子","text":"“……哎？”"},{"op":"text","speaker":"","text":"“……哎？”是什么？"},{"op":"text","speaker":"","text":"我也朝玄关走去。"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i60"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":1,"image":"i14566"},{"op":"image","layer":257,"image":"i14140"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"看到了不得了的东西。"},{"op":"image","layer":257,"image":"i14141"},{"op":"text","speaker":"静久","text":"“我是前几天羽依里从陷阱里救出来的牛。”"},{"op":"image","layer":1,"image":"i14616"},{"op":"text","speaker":"紬","text":"“我是猫。”"},{"op":"image","layer":7,"image":"i11562"},{"op":"text","speaker":"镜子","text":"“哈啊……”"},{"op":"image","layer":257,"image":"i14193"},{"op":"text","speaker":"静久","text":"“我们是来报恩的。”"},{"op":"image","layer":1,"image":"i14737"},{"op":"text","speaker":"紬","text":"“不会给您添麻烦的。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":1,"image":"i11571"},{"op":"text","speaker":"镜子","text":"“真是太客气了。”"},{"op":"image","layer":1,"image":"i11638"},{"op":"text","speaker":"镜子","text":"“那么，请进。”"},{"op":"image","layer":257,"image":"i14701"},{"op":"image","layer":513,"image":"i14137"},{"op":"text","speaker":"静久","text":"“打扰了。”"},{"op":"image","layer":257,"image":"i14661"},{"op":"text","speaker":"紬","text":"“失礼了。”"},{"op":"image","layer":513,"image":"i14188"},{"op":"text","speaker":"静久","text":"“紬，把肉球擦干净再进来哦。”"},{"op":"image","layer":257,"image":"i14649"},{"op":"text","speaker":"紬","text":"“姆喵！”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"擦完脚底后，她们走了进来。"},{"op":"image","layer":1,"image":"i11563"},{"op":"text","speaker":"镜子","text":"“你、你救了她们？”"},{"op":"text","speaker":"羽依里","text":"“没有救过。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i14656"},{"op":"image","layer":257,"image":"i14063"},{"op":"text","speaker":"","text":"回到起居室，看到一牛一猫规规矩矩地正坐着。"},{"op":"text","speaker":"羽依里","text":"“你们这是什么打扮？”"},{"op":"image","layer":1,"image":"i14566"},{"op":"image","layer":257,"image":"i14141"},{"op":"text","speaker":"静久","text":"“刚才一直在做各种工作，把衣服都弄脏了。”"},{"op":"image","layer":257,"image":"i14160"},{"op":"text","speaker":"静久","text":"“觉得直接那样来打扰不太礼貌。”"},{"op":"image","layer":1,"image":"i14613"},{"op":"text","speaker":"紬","text":"“但是能换的衣服也只有这件了。”"},{"op":"text","speaker":"羽依里","text":"“穿这个就有礼貌了吗？”"},{"op":"image","layer":257,"image":"i14172"},{"op":"text","speaker":"静久","text":"“但是这么穿很可爱吧？”"},{"op":"text","speaker":"羽依里","text":"“……确实很可爱。”"},{"op":"image","layer":1,"image":"i14570"},{"op":"image","layer":257,"image":"i14157"},{"op":"text","speaker":"静久","text":"“哎嘿嘿……”"},{"op":"text","speaker":"","text":"害羞了。"},{"op":"image","layer":513,"image":"i11584"},{"op":"text","speaker":"镜子","text":"“啊，我要不要帮你们洗下衣服？”"},{"op":"image","layer":1,"image":"i14570"},{"op":"image","layer":257,"image":"i14151"},{"op":"text","speaker":"静久","text":"“可以吗？”"},{"op":"image","layer":513,"image":"i11549"},{"op":"text","speaker":"镜子","text":"“当然可以。”"},{"op":"image","layer":513,"image":"i11595"},{"op":"text","speaker":"镜子","text":"“到明天早上应该能干。”"},{"op":"text","speaker":"","text":"之后静久和镜子阿姨互相道了问候。"},{"op":"text","speaker":"","text":"时隔许久的见面，两人都露出了怀念的表情。"},{"op":"text","speaker":"","text":"静久给家里打了电话，听说她母亲的语气有些为难。"},{"op":"text","speaker":"","text":"不过，犹豫了一会儿后。"},{"op":"text","speaker":"","text":"“要有分寸，做事要讲常识。”"},{"op":"text","speaker":"","text":"她好像是这么说的。"},{"op":"text","speaker":"","text":"看来并没有生气。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i72"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"然后，三个人天南地北地聊了许多。"},{"op":"text","speaker":"","text":"聊了以前没怎么提到过的家乡。"},{"op":"text","speaker":"","text":"聊了除了我们以外的朋友。"},{"op":"text","speaker":"","text":"聊了这个夏天。"},{"op":"text","speaker":"","text":"聊了从今往后的事情。"},{"op":"image","layer":1,"image":"i14717"},{"op":"image","layer":257,"image":"i14113"},{"op":"text","speaker":"紬","text":"“呼喵～～～～～～……”"},{"op":"image","layer":257,"image":"i14137"},{"op":"text","speaker":"静久","text":"“哎呀？已经撑不住了？”"},{"op":"image","layer":1,"image":"i14644"},{"op":"text","speaker":"紬","text":"“没有的事……虽然没有……但是我要向……困意投降了……”"},{"op":"image","layer":1,"image":"i14627"},{"op":"text","speaker":"紬","text":"“对不起……我好像……要输了。”"},{"op":"text","speaker":"羽依里","text":"“看来是撑不住了。”"},{"op":"image","layer":257,"image":"i14111"},{"op":"text","speaker":"静久","text":"“那我们去房间里吧。”"},{"op":"text","speaker":"羽依里","text":"“嗯，我来把紬抱过去吧。”"},{"op":"text","speaker":"","text":"静久抱起了紬。"},{"op":"image","layer":257,"image":"i14164"},{"op":"text","speaker":"静久","text":"“没关系，紬很轻的哦。”"},{"op":"image","layer":257,"image":"i14165"},{"op":"text","speaker":"静久","text":"“……？”"},{"op":"text","speaker":"羽依里","text":"“怎么了？要不要换我来？”"},{"op":"image","layer":257,"image":"i14176"},{"op":"text","speaker":"静久","text":"“没事的不用，。”"},{"op":"text","speaker":"","text":"说完，静久抱着紬回房间去了。"},{"op":"text","speaker":"羽依里","text":"“那么……”"},{"op":"text","speaker":"","text":"该铺被褥了。"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i73"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……睡觉吧。”"},{"op":"image","layer":0,"image":"i75"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"外面传来强劲的风雨声。"},{"op":"text","speaker":"羽依里","text":"“看来台风还挺大的……”"},{"op":"text","speaker":"","text":"听到的声音不像以前住在老家时那样，感觉有些可怕。"},{"op":"text","speaker":"","text":"不管了，睡觉吧。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“……嗯？”"},{"op":"image","layer":1,"image":"i14133"},{"op":"text","speaker":"静久","text":"“打扰了。”"},{"op":"text","speaker":"羽依里","text":"“咦？静久？”"},{"op":"text","speaker":"羽依里","text":"“怎么了？”"},{"op":"image","layer":1,"image":"i14124"},{"op":"text","speaker":"静久","text":"“我想起来还没说晚安。”"},{"op":"text","speaker":"羽依里","text":"“特地为了这个？”"},{"op":"image","layer":1,"image":"i14190"},{"op":"text","speaker":"静久","text":"“就是特地为了这个。”"},{"op":"image","layer":1,"image":"i14141"},{"op":"text","speaker":"静久","text":"“毕竟，能道晚安的机会很少呀？”"},{"op":"text","speaker":"羽依里","text":"“确实是这样。”"},{"op":"image","layer":1,"image":"i14152"},{"op":"text","speaker":"静久","text":"“而且……还有些别的话想跟你说。”"},{"op":"text","speaker":"羽依里","text":"“咦？”"},{"op":"text","speaker":"","text":"静久在我身边坐下。"},{"op":"image","layer":1,"image":"i14159"},{"op":"text","speaker":"静久","text":"“谢谢你。”"},{"op":"text","speaker":"羽依里","text":"“那个……”"},{"op":"image","layer":1,"image":"i14156"},{"op":"text","speaker":"静久","text":"“一直喜欢着总是会忘记的我……”"},{"op":"image","layer":1,"image":"i14141"},{"op":"text","speaker":"静久","text":"“……谢谢你。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“我才要谢谢你，一次又一次地喜欢上我……”"},{"op":"image","layer":1,"image":"i14118"},{"op":"text","speaker":"静久","text":"“不用谢♪”"},{"op":"text","speaker":"","text":"静久说着，闭上了眼睛。"},{"op":"image","layer":1,"image":"i14135"},{"op":"text","speaker":"静久","text":"“遇见你之后……很多事情都变得顺利起来了。”"},{"op":"text","speaker":"羽依里","text":"“有吗？”"},{"op":"image","layer":1,"image":"i14137"},{"op":"text","speaker":"静久","text":"“嗯，看到了来了好多客人的海之家。”"},{"op":"image","layer":1,"image":"i14066"},{"op":"text","speaker":"静久","text":"“也和妈妈聊了很多。”"},{"op":"image","layer":1,"image":"i14190"},{"op":"text","speaker":"静久","text":"“一切都很顺利。”"},{"op":"text","speaker":"羽依里","text":"“你说得也太夸张了。”"},{"op":"image","layer":1,"image":"i14183"},{"op":"text","speaker":"静久","text":"“哼……明明都是真的……”"},{"op":"text","speaker":"羽依里","text":"“如果一切都很顺利的话，就不会有这场台风了吧？”"},{"op":"image","layer":1,"image":"i14155"},{"op":"text","speaker":"静久","text":"“……”"},{"op":"image","layer":1,"image":"i14186"},{"op":"text","speaker":"静久","text":"“不过，也是多亏了台风……才能在这里留宿呢。”"},{"op":"text","speaker":"羽依里","text":"“嗯……也是。”"},{"op":"text","speaker":"","text":"静久就这样躺下来，望着天花板。"},{"op":"image","layer":1,"image":"i14153"},{"op":"text","speaker":"静久","text":"“虽然遇到不好的事情，可能还是会忘记……”"},{"op":"image","layer":1,"image":"i14143"},{"op":"text","speaker":"静久","text":"“但是，不好的事情也许不会再发生了……”"},{"op":"image","layer":1,"image":"i14193"},{"op":"text","speaker":"静久","text":"“因为发生了太多好事，让我不禁这么想。”"},{"op":"image","layer":1,"image":"i14118"},{"op":"text","speaker":"静久","text":"“希望暑假的最后，能留下一段最棒的回忆。”"},{"op":"text","speaker":"羽依里","text":"“是啊。”"},{"op":"text","speaker":"羽依里","text":"“想做一些更难忘的，开心到让人无法忘怀的事。”"},{"op":"text","speaker":"羽依里","text":"“把大家都叫上。”"},{"op":"image","layer":1,"image":"i14091"},{"op":"text","speaker":"静久","text":"“听起来很有趣呢♪”"},{"op":"text","speaker":"羽依里","text":"“那我去联系他们吧？”"},{"op":"image","layer":1,"image":"i14111"},{"op":"text","speaker":"静久","text":"“不用，这次让我来。”"},{"op":"image","layer":1,"image":"i14087"},{"op":"text","speaker":"静久","text":"“一直以来都是羽依里在帮我的忙。”"},{"op":"image","layer":1,"image":"i14118"},{"op":"text","speaker":"静久","text":"“所以……偶尔也来让我做点事吧？”"},{"op":"text","speaker":"羽依里","text":"“当然可以。”"},{"op":"image","layer":1,"image":"i14141"},{"op":"text","speaker":"静久","text":"“太好了♪”"},{"op":"image","layer":1,"image":"i14143"},{"op":"text","speaker":"静久","text":"“期待着吧，一定会让你吃惊的。”"},{"op":"text","speaker":"羽依里","text":"“说得怎么好像已经准备好了似的啊？”"},{"op":"image","layer":1,"image":"i14160"},{"op":"text","speaker":"静久","text":"“呵呵♪怎么可能呢？”"},{"op":"text","speaker":"","text":"我们就这样聊着天，享受着两个人独处的时光。"},{"op":"text","speaker":"","text":"有时对话也会中断，一时陷入沉默……"},{"op":"text","speaker":"","text":"但这种共享同一段时光的感觉，也让人觉得十分惬意。"},{"op":"text","speaker":"","text":"……不过。"},{"op":"image","layer":1,"image":"i14145"},{"op":"text","speaker":"静久","text":"“……？”"},{"op":"image","layer":1,"image":"i14184"},{"op":"text","speaker":"静久","text":"“你有没有听到什么声音？”"},{"op":"text","speaker":"羽依里","text":"“哎？”"},{"op":"text","speaker":"","text":"竖起耳朵仔细听。"},{"op":"text","speaker":"","text":"在雨声和风声中……"},{"op":"text","speaker":"羽依里","text":"“……好像在播放广播？”"},{"op":"text","speaker":"","text":"我们两人走近窗边。"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i157"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"美希","text":"‘目前，受大型台风影响，海面出现剧烈波动。’"},{"op":"text","speaker":"美希","text":"‘非常危险，请不要做出靠近海边，或是查看船只等行为。’"},{"op":"text","speaker":"美希","text":"‘重复播报――’"},{"op":"image","layer":7,"image":"i14147"},{"op":"text","speaker":"静久","text":"“看来是相当大的台风呢。”"},{"op":"text","speaker":"羽依里","text":"“是啊。”"},{"op":"text","speaker":"美希","text":"‘另外……由于可能发生山体滑坡等灾害，请相关地区的居民及时避难。’"},{"op":"text","speaker":"美希","text":"‘鸟白岛西北部――沿――地区周边。’"},{"op":"image","layer":0,"image":"i75"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":1,"image":"i14131"},{"op":"text","speaker":"静久","text":"“刚才那句，你听清了吗？”"},{"op":"text","speaker":"羽依里","text":"“没有，没听清……不过。”"},{"op":"image","layer":1,"image":"i14104"},{"op":"text","speaker":"静久","text":"“是海之家那边……对吧？”"},{"op":"text","speaker":"羽依里","text":"“嗯……”"},{"op":"image","layer":1,"image":"i14150"},{"op":"text","speaker":"静久","text":"“那里……会没事吗？”"},{"op":"text","speaker":"羽依里","text":"“放心吧，一定会没事的。”"},{"op":"image","layer":1,"image":"i14148"},{"op":"text","speaker":"静久","text":"“……”"},{"op":"image","layer":1,"image":"i14146"},{"op":"text","speaker":"静久","text":"“那里，是我最重要的地方……”"},{"op":"text","speaker":"羽依里","text":"“我知道。”"},{"op":"image","layer":1,"image":"i14150"},{"op":"text","speaker":"静久","text":"“在那里，跟爷爷和奶奶……”"},{"op":"image","layer":1,"image":"i14131"},{"op":"text","speaker":"静久","text":"“还有羽依里和紬……还有大家一起……”"},{"op":"image","layer":1,"image":"i14133"},{"op":"text","speaker":"静久","text":"“还跟妈妈和好了……”"},{"op":"image","layer":1,"image":"i14122"},{"op":"text","speaker":"静久","text":"“所以……那个地方……！”"},{"op":"text","speaker":"羽依里","text":"“放心，一定会没事的。”"},{"op":"text","speaker":"羽依里","text":"“有我在的时候，不是一切都很顺利吗？”"},{"op":"text","speaker":"羽依里","text":"“所以，不用想那么多。”"},{"op":"image","layer":1,"image":"i14148"},{"op":"text","speaker":"静久","text":"“是、呢。说得对……”"},{"op":"image","layer":1,"image":"i14153"},{"op":"text","speaker":"静久","text":"“一定没事的。因为有羽依里在嘛♪”"},{"op":"text","speaker":"","text":"她像往常一样笑着说道。"},{"op":"text","speaker":"","text":"但是。"},{"op":"image","layer":1,"image":"i14168"},{"op":"text","speaker":"静久","text":"“……”"},{"op":"text","speaker":"","text":"指尖却依然在颤抖。"},{"op":"text","speaker":"","text":"所以。"},{"op":"image","layer":1,"image":"i14173"},{"op":"text","speaker":"静久","text":"“啊……”"},{"op":"text","speaker":"羽依里","text":"“之前也是这样，一直握着你的手，直到你能平静下来。”"},{"op":"text","speaker":"","text":"我握住了她的手。"},{"op":"image","layer":1,"image":"i14168"},{"op":"text","speaker":"静久","text":"“……”"},{"op":"image","layer":1,"image":"i14166"},{"op":"text","speaker":"静久","text":"“这样的话，反而会因为别的原因平静不下来……”"},{"op":"image","layer":1,"image":"i14174"},{"op":"text","speaker":"静久","text":"“心跳加快了……”"},{"op":"text","speaker":"羽依里","text":"“……嗯。”"},{"op":"text","speaker":"","text":"我们就这样一直握着手……直到天亮。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]