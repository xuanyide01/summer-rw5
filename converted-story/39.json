[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“早上好……”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“哥哥！”"},{"op":"text","speaker":"","text":"羽未一路小跑了过来。"},{"op":"text","speaker":"羽依里","text":"“怎么了？”"},{"op":"image","layer":1,"image":"i15381"},{"op":"text","speaker":"羽未","text":"“来，快看，我攒了好多积分呢。”"},{"op":"text","speaker":"","text":"眉飞色舞地给我看了盖着印章的卡片。"},{"op":"image","layer":1,"image":"i15511"},{"op":"text","speaker":"羽未","text":"“广播体操！”"},{"op":"text","speaker":"羽依里","text":"“喔喔。”"},{"op":"text","speaker":"","text":"说起来，广播体操好像是有这种机制？"},{"op":"text","speaker":"","text":"把挂在脖子上的卡片拿给现场负责人盖章。"},{"op":"image","layer":1,"image":"i15355"},{"op":"text","speaker":"羽未","text":"“直奔全勤奖！”"},{"op":"text","speaker":"","text":"一副欢欣雀跃的样子。"},{"op":"image","layer":1,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“啊，镜子阿姨，你快看。”"},{"op":"text","speaker":"","text":"想必是相当开心吧，接着又把卡片拿给镜子阿姨看。"},{"op":"text","speaker":"","text":"我小时候或许也是那个样吧。"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“哥哥也一起的话就好了。”"},{"op":"text","speaker":"羽依里","text":"“嗯，下次有机会就一起去吧。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“下次……”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“嗯，好的。”"},{"op":"text","speaker":"","text":"虽然是自己说出口的，但还是觉得有些敷衍了。"},{"op":"text","speaker":"","text":"下次……"},{"op":"text","speaker":"","text":"都无法保证明年还能来这里。"},{"op":"return"},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i63"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“哥哥。”"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“差不多该洗澡了。”"},{"op":"if","truth":false,"target":50,"value":["==",["v",48],1]},{"op":"text","speaker":"羽依里","text":"“洗澡……”"},{"op":"text","speaker":"","text":"对这个词产生了过多的反应。"},{"op":"text","speaker":"","text":"怎么说呢……"},{"op":"text","speaker":"","text":"感觉有歉意……"},{"op":"text","speaker":"","text":"心中有愧无颜面对。"},{"op":"goto","target":53},{"op":"text","speaker":"羽依里","text":"“抱歉，我好困……”"},{"op":"text","speaker":"","text":"我依旧趴在地上，站不起来。"},{"op":"text","speaker":"","text":"已经没有去洗澡的体力了。"},{"op":"text","speaker":"羽依里","text":"“我就这样在这里睡了……”"},{"op":"image","layer":1,"image":"i15331"},{"op":"text","speaker":"羽未","text":"“不可以，你都流汗啦。”"},{"op":"text","speaker":"羽依里","text":"“没事的啦……”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“唔！”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“有那么累吗？”"},{"op":"text","speaker":"羽依里","text":"“嗯，有吧。”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“嗯……”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“啊，有了。”"},{"op":"text","speaker":"","text":"羽未绕到我身后。"},{"op":"text","speaker":"羽依里","text":"“做…做什么？”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“给你按摩。”"},{"op":"text","speaker":"","text":"揉捏。"},{"op":"text","speaker":"羽依里","text":"“噢！”"},{"op":"text","speaker":"羽依里","text":"“这是！”"},{"op":"image","layer":1,"image":"i15343"},{"op":"text","speaker":"羽未","text":"“唔…嘿咻…”"},{"op":"text","speaker":"","text":"揉捏。"},{"op":"text","speaker":"羽依里","text":"“啊哼！”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“哇，好好玩的声音。”"},{"op":"text","speaker":"","text":"揉捏。"},{"op":"text","speaker":"羽依里","text":"“嘛哼！”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“真好玩！”"},{"op":"text","speaker":"","text":"揉揉捏捏。"},{"op":"text","speaker":"羽依里","text":"“嘛哼！喏哼！嘛呀！”"},{"op":"image","layer":1,"image":"i15499"},{"op":"text","speaker":"羽未","text":"“哇哈哈哈，好奇怪的声音！”"},{"op":"text","speaker":"羽依里","text":"“羽未，能用力点吗？”"},{"op":"image","layer":1,"image":"i15474"},{"op":"text","speaker":"羽未","text":"“嗯，我已经用足力了呢。”"},{"op":"text","speaker":"羽依里","text":"“那干脆用踩的吧。”"},{"op":"text","speaker":"羽依里","text":"“羽未的重量感觉刚好合适呢。”"},{"op":"image","layer":1,"image":"i15468"},{"op":"text","speaker":"羽未","text":"“踩吗？像这样？”"},{"op":"text","speaker":"","text":"踩压。"},{"op":"text","speaker":"羽依里","text":"“!؟”"},{"op":"text","speaker":"","text":"这……"},{"op":"text","speaker":"","text":"踩压。"},{"op":"text","speaker":"","text":"何等……舒适……"},{"op":"text","speaker":"羽依里","text":"“呼嘛……好舒服……”"},{"op":"image","layer":1,"image":"i15347"},{"op":"text","speaker":"羽未","text":"“唉嘿嘿，厉害不？厉害不？”"},{"op":"text","speaker":"羽依里","text":"“嗯嗯，好舒服的哦。”"},{"op":"text","speaker":"","text":"踩压。"},{"op":"text","speaker":"羽依里","text":"“呼嘛……”"},{"op":"text","speaker":"羽依里","text":"“羽未，再用力一些。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“嗯，嘿！嘿！”"},{"op":"text","speaker":"","text":"重重踩压。"},{"op":"text","speaker":"羽依里","text":"“哈啊…舒服！”"},{"op":"text","speaker":"羽依里","text":"“羽未…继续踩！”"},{"op":"image","layer":257,"image":"i11563"},{"op":"text","speaker":"镜子","text":"“羽依里……？”"},{"op":"text","speaker":"羽依里","text":"“哇唉……”"},{"op":"image","layer":257,"image":"i11566"},{"op":"text","speaker":"镜子","text":"“你在让羽未…做什么呢？”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“哥哥说，踩了他就舒服。”"},{"op":"image","layer":257,"image":"i11574"},{"op":"text","speaker":"镜子","text":"“……我必须给姐姐……打电话。”"},{"op":"text","speaker":"羽依里","text":"“不是的！这是按摩！仅仅只是足踩按摩而已！”"},{"op":"text","speaker":"","text":"感觉……最近镜子阿姨看我的眼神有些危险了……"},{"op":"return"},{"op":"end"}]