[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"if","truth":false,"target":5,"value":["==",["v",6003],1]},{"op":"callScene","scene":112,"target":2},{"op":"goto","target":62},{"op":"if","truth":false,"target":8,"value":["==",["v",6003],2]},{"op":"callScene","scene":111,"target":2},{"op":"goto","target":62},{"op":"image","layer":0,"image":"i457"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"一反常态，今天我完全没有离开房间的兴致。"},{"op":"text","speaker":"","text":"也提不起劲去小卖铺见苍。"},{"op":"text","speaker":"","text":"昨天和野美希他们的对话，让我察觉到了自己的真心。"},{"op":"text","speaker":"","text":"即便苍不知道这件事，现在的我看到苍也会有点不好意思。"},{"op":"image","layer":0,"image":"i68"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“而且每天都去的话，要是被讨厌了也不好……”"},{"op":"text","speaker":"羽依里","text":"“一天不去应该也没事……”"},{"op":"text","speaker":"羽依里","text":"“……嗯？”"},{"op":"image","layer":1,"image":"i15709"},{"op":"text","speaker":"","text":"敞开的拉门对面，羽未正好经过。"},{"op":"text","speaker":"","text":"手上拿着捕虫用的网兜，肩上挂着塑料做的虫笼。"},{"op":"text","speaker":"羽依里","text":"“羽未，要出去吗？”"},{"op":"image","layer":1,"image":"i15713"},{"op":"text","speaker":"羽未","text":"“是。去捉虫。”"},{"op":"text","speaker":"羽依里","text":"“蝉？还是说……虾？”"},{"op":"image","layer":1,"image":"i15738"},{"op":"text","speaker":"羽未","text":"“……是蝉。”"},{"op":"text","speaker":"羽依里","text":"“要吃吗？”"},{"op":"image","layer":1,"image":"i15658"},{"op":"text","speaker":"羽未","text":"“……回来给你吃。”"},{"op":"text","speaker":"羽依里","text":"“抱歉，我的错。”"},{"op":"image","layer":1,"image":"i15659"},{"op":"text","speaker":"羽未","text":"“绝对要塞给你吃。”"},{"op":"text","speaker":"羽依里","text":"“别，真的对不起……”"},{"op":"text","speaker":"","text":"似乎比我想象的更记恨。"},{"op":"text","speaker":"羽依里","text":"“说起捉虫来。”"},{"op":"text","speaker":"羽依里","text":"“岛上好像有奇怪的蝴蝶。”"},{"op":"image","layer":1,"image":"i15630"},{"op":"text","speaker":"羽未","text":"“……是什么样的蝴蝶？”"},{"op":"text","speaker":"羽依里","text":"“怎么说呢，是会微微发光很漂亮的那种。”"},{"op":"image","layer":1,"image":"i15632"},{"op":"text","speaker":"羽未","text":"“发光的……蝴蝶吗？”"},{"op":"text","speaker":"羽依里","text":"“之前我在晚上看到过。”"},{"op":"text","speaker":"羽依里","text":"“说来，那种蝴蝶叫什么名字呢？”"},{"op":"image","layer":1,"image":"i15678"},{"op":"text","speaker":"羽未","text":"“……如果是会发光的蝴蝶，仓库里就放着。”"},{"op":"text","speaker":"羽依里","text":"“真的假的!؟”"},{"op":"text","speaker":"羽依里","text":"“等等，放着？不是飞进去过？”"},{"op":"image","layer":1,"image":"i15657"},{"op":"text","speaker":"羽未","text":"“对，是放着。”"},{"op":"image","layer":1,"image":"i15635"},{"op":"text","speaker":"羽未","text":"“和镜子阿姨说一声的话应该会给你看。”"},{"op":"text","speaker":"羽依里","text":"“这样啊……”"},{"op":"text","speaker":"羽依里","text":"“知道了，谢谢！”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"被挑起兴趣后，我立刻就朝仓库那边走去。"},{"op":"image","layer":0,"image":"i76"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"仓库里，镜子阿姨还是一个人在整理着遗物。"},{"op":"text","speaker":"羽依里","text":"“那个，镜子阿姨。”"},{"op":"image","layer":0,"image":"i1012"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"镜子","text":"“哎呀，羽依里？”"},{"op":"text","speaker":"羽依里","text":"“有点事想请教你。”"},{"op":"text","speaker":"羽依里","text":"“你知道发光的蝴蝶吗？”"},{"op":"image","layer":0,"image":"i1015"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"镜子","text":"“发光的蝴蝶？”"},{"op":"text","speaker":"羽依里","text":"“羽未说在这个仓库里有，问镜子阿姨的话会知道。”"},{"op":"image","layer":0,"image":"i1011"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"镜子","text":"“哦……那个啊……”"},{"op":"image","layer":0,"image":"i76"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"镜子阿姨开始在箱子里翻找。"},{"op":"image","layer":1,"image":"i11650"},{"op":"text","speaker":"镜子","text":"“……是不是这个？”"},{"op":"text","speaker":"","text":"她拿出来的，是一个古老的木盒和一本旧书。"},{"op":"text","speaker":"","text":"盒子其中一面是透明玻璃。"},{"op":"text","speaker":"羽依里","text":"“标本……？”"},{"op":"text","speaker":"","text":"原来如此，这确实是‘放在’仓库里。"},{"op":"text","speaker":"","text":"不过……"},{"op":"text","speaker":"羽依里","text":"“这就是，发光的蝴蝶？”"},{"op":"text","speaker":"","text":"翅膀上确实是散发着不可思议的光。"},{"op":"text","speaker":"","text":"不过，和那天晚上看到的相比，光芒要黯淡不少。"},{"op":"text","speaker":"","text":"蝴蝶的标本下面，还贴了张写着什么的纸。"},{"op":"text","speaker":"羽依里","text":"“七影蝶……？”"},{"op":"text","speaker":"","text":"这是这种蝴蝶的名字？"},{"op":"image","layer":1,"image":"i11650"},{"op":"text","speaker":"镜子","text":"“关于七影蝶，这本书上有写哦。”"},{"op":"text","speaker":"羽依里","text":"“……请借我看一下。”"},{"op":"text","speaker":"","text":"翻开看看。"},{"op":"text","speaker":"羽依里","text":"“原来如此……”"},{"op":"image","layer":1,"image":"i11667"},{"op":"text","speaker":"镜子","text":"“怎么样？”"},{"op":"text","speaker":"羽依里","text":"“这种古文我看不懂。”"},{"op":"image","layer":1,"image":"i11673"},{"op":"text","speaker":"镜子","text":"“呵呵，里面写的是这座岛的过去哦。”"},{"op":"image","layer":1,"image":"i11667"},{"op":"text","speaker":"镜子","text":"“让我看看。”"},{"op":"text","speaker":"","text":"将书递还过去后，镜子阿姨脱下手套，从衣服里取出了眼镜。"},{"op":"image","layer":1,"image":"i11498"},{"op":"text","speaker":"","text":"一下子就变得非常有知性了。"},{"op":"text","speaker":"","text":"……镜子阿姨戴眼镜的啊。"},{"op":"text","speaker":"","text":"我不自禁地看呆了的时候，镜子阿姨开始快速地浏览起书本。"},{"op":"image","layer":1,"image":"i11495"},{"op":"text","speaker":"镜子","text":"“啊，是这里呢。”"},{"op":"image","layer":1,"image":"i11542"},{"op":"text","speaker":"镜子","text":"“这里写着有关七影蝶的故事。”"},{"op":"image","layer":1,"image":"i11541"},{"op":"text","speaker":"镜子","text":"“我看看……简单来说……”"},{"op":"image","layer":1,"image":"i11500"},{"op":"text","speaker":"镜子","text":"“人在死后，为了将自己的思念传达给后人，逝者的灵魂会变成蝴蝶……”"},{"op":"image","layer":1,"image":"i11494"},{"op":"text","speaker":"镜子","text":"“那蝴蝶就是七影蝶。”"},{"op":"text","speaker":"羽依里","text":"“镜子阿姨，你看得懂吗？”"},{"op":"image","layer":1,"image":"i11543"},{"op":"text","speaker":"镜子","text":"“古董和古文可是不分家的。”"},{"op":"text","speaker":"羽依里","text":"“逝者的灵魂变成蝴蝶……”"},{"op":"text","speaker":"羽依里","text":"“那，这标本是人的灵魂？”"},{"op":"image","layer":1,"image":"i11500"},{"op":"text","speaker":"镜子","text":"“不知道呢？这蝴蝶好像不怎么常见。”"},{"op":"image","layer":1,"image":"i11495"},{"op":"text","speaker":"镜子","text":"“对这蝴蝶有兴趣吗？”"},{"op":"text","speaker":"羽依里","text":"“嗯，算是吧。”"},{"op":"image","layer":1,"image":"i11496"},{"op":"text","speaker":"镜子","text":"“也就是说……”"},{"op":"text","speaker":"","text":"感觉镜子阿姨的眼睛忽然一亮。"},{"op":"image","layer":1,"image":"i11544"},{"op":"text","speaker":"镜子","text":"“你对古董的世界有兴趣，对不对？”"},{"op":"text","speaker":"羽依里","text":"“唉……不……怎，怎么说呢……”"},{"op":"text","speaker":"","text":"如此兴致勃勃的镜子阿姨非常罕见。"},{"op":"text","speaker":"羽依里","text":"“我还不至于要深入古董的世界……”"},{"op":"image","layer":1,"image":"i11540"},{"op":"text","speaker":"镜子","text":"“……什么呀……也是呢。”"},{"op":"text","speaker":"","text":"让她空欢喜一场。"},{"op":"text","speaker":"羽依里","text":"“但，但是，我对这本书的内容很有兴趣。”"},{"op":"image","layer":1,"image":"i11500"},{"op":"text","speaker":"镜子","text":"“是吗，那我把内容翻译成你看得懂的？”"},{"op":"text","speaker":"羽依里","text":"“唉，可以吗？”"},{"op":"image","layer":1,"image":"i11497"},{"op":"text","speaker":"镜子","text":"“反正也不是很长。”"},{"op":"image","layer":1,"image":"i11495"},{"op":"text","speaker":"镜子","text":"“3天左右就能翻好。”"},{"op":"text","speaker":"羽依里","text":"“那就多麻烦了。”"},{"op":"image","layer":1,"image":"i11501"},{"op":"text","speaker":"镜子","text":"“了解。”"},{"op":"image","layer":1,"image":"i11495"},{"op":"text","speaker":"镜子","text":"“对了，就算是交换条件吧。”"},{"op":"image","layer":1,"image":"i11499"},{"op":"text","speaker":"镜子","text":"“能帮我一个忙吗？”"},{"op":"text","speaker":"羽依里","text":"“用不着说什么交换条件，只要开口我随时可以来帮忙。”"},{"op":"text","speaker":"羽依里","text":"“而且，我本来就是来这座岛帮忙的。”"},{"op":"image","layer":1,"image":"i11538"},{"op":"text","speaker":"镜子","text":"“说起来还真是呢。”"},{"op":"image","layer":1,"image":"i11500"},{"op":"text","speaker":"镜子","text":"“那能帮我把那边的藤箱放到地上吗？”"},{"op":"text","speaker":"羽依里","text":"“好的。”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i158"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"这天，我一整天都在用心整理仓库。"},{"op":"text","speaker":"","text":"其实这才是我每天应该做的事吧……"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i72"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"晚饭过后，我回到房间后打开窗乘了会儿凉。"},{"op":"text","speaker":"","text":"月色被云朵遮蔽，外头很暗。"},{"op":"image","layer":0,"image":"i170"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"向山那边望去，那里一片漆黑――……"},{"op":"text","speaker":"","text":"……――本应如此才对。"},{"op":"text","speaker":"","text":"然而在山脚处，我看到了一点微弱的灯火。"},{"op":"image","layer":0,"image":"i72"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……苍？”"},{"op":"text","speaker":"","text":"忽暗忽明的灯火，渐渐向山顶靠近。"},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"text","speaker":"","text":"她叫我别去。"},{"op":"text","speaker":"","text":"如果刚才没有看到那灯火，我或许也就不会去了。"},{"op":"text","speaker":"","text":"但是，毕竟是看到了。"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i39"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"走在漆黑的道路上，我快步向山那边赶去。"},{"op":"text","speaker":"羽依里","text":"“看来又要惹苍生气了啊……”"},{"op":"text","speaker":"","text":"不过，既然已经看到了那灯火，我也没法默默待在房间里。"},{"op":"text","speaker":"","text":"担心苍会出事――……这说辞，早已成了借口。"},{"op":"text","speaker":"","text":"我只是单纯地――"},{"op":"text","speaker":"","text":"想要见到苍。"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i442"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"手电筒照亮了周围，我在山路上慢慢前行。"},{"op":"text","speaker":"羽依里","text":"“……她到哪里去了呢？”"},{"op":"text","speaker":"","text":"对如何追上苍，我没有半点头绪。"},{"op":"text","speaker":"","text":"说不定我们擦肩而过，苍其实已经下山了。"},{"op":"image","layer":0,"image":"i46"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“我居然会做出这么蠢的事情……”"},{"op":"image","layer":0,"image":"i47"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“嗯……奇怪？”"},{"op":"text","speaker":"","text":"这时，手电筒突然暗了下来。"},{"op":"text","speaker":"羽依里","text":"“等等……莫非，这是没电了？”"},{"op":"text","speaker":"羽依里","text":"“骗人的吧，喂……”"},{"op":"text","speaker":"羽依里","text":"“偏偏是在山里……这下该怎么办啊……”"},{"op":"text","speaker":"羽依里","text":"“这可不是开玩笑的……”"},{"op":"text","speaker":"","text":"周围是一丝星光都不见的漆黑。"},{"op":"text","speaker":"","text":"虽然随着时间的流逝眼睛多少适应了一些，但毕竟不是在平坦的马路上。"},{"op":"text","speaker":"","text":"在这种崎岖的山路上，一个不注意就会一脚踩空。"},{"op":"text","speaker":"羽依里","text":"“实在不行，在这里等到天亮吧……”"},{"op":"text","speaker":"","text":"正当恐惧一点点占据我的内心和身体时――"},{"op":"image","layer":0,"image":"i235"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“唉……”"},{"op":"text","speaker":"","text":"黑暗之中，一点小小的光飘然而过。"},{"op":"text","speaker":"羽依里","text":"“啊，是苍吗？”"},{"op":"text","speaker":"羽依里","text":"“不……那是……”"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"image","layer":0,"image":"i235"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“……七影蝶。”"},{"op":"text","speaker":"","text":"眼前的光，毫无疑问是七影蝶。"},{"op":"text","speaker":"","text":"前几天也看到过的，会发光的蝴蝶。"},{"op":"text","speaker":"","text":"蝴蝶像是飘在空气中一般。"},{"op":"text","speaker":"","text":"带着一丝虚幻，却绽放着最为纯粹的微光。"},{"op":"text","speaker":"","text":"晃悠悠，轻飘飘地。"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"向我飞来。"},{"op":"image","layer":0,"image":"i47"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"其身影与今天在仓库中看到的标本完全不同。"},{"op":"text","speaker":"","text":"发光和飞翔的样子看起来极为神秘，说是神圣也不为过。"},{"op":"text","speaker":"羽依里","text":"“这就是……真正的七影蝶……”"},{"op":"text","speaker":"","text":"我模仿当时苍所做的那样，将自己的手伸了过去。"},{"op":"image","layer":0,"image":"i235"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"蝴蝶似乎是有些犹豫，在稍微悬浮了一会儿后……"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"停落到了我的手指尖上。"},{"op":"text","speaker":"羽依里","text":"“啊……”"},{"op":"text","speaker":"","text":"这瞬间，不可思议……"},{"op":"text","speaker":"","text":"不，应该说是不知所谓的事情发生在了我的身上。"},{"op":"image","layer":1795,"image":"i18201"},{"op":"image","layer":0,"image":"i228"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i199"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i219"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i189"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"（这，是……什么……）"},{"op":"text","speaker":"羽依里","text":"（好像……有什么……在流向……体内……）"},{"op":"text","speaker":"羽依里","text":"（这是……）"},{"op":"clear","layer":1795},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"我正站在一片黑暗之中。"},{"op":"text","speaker":"","text":"可即便如此，也依然能看到。"},{"op":"text","speaker":"","text":"看到那陌生的场所。"},{"op":"text","speaker":"","text":"看到那从未相识的面庞。"},{"op":"text","speaker":"","text":"看到那未曾体验过的回忆断片。"},{"op":"text","speaker":"","text":"忽地，我理解了。"},{"op":"text","speaker":"","text":"这是‘记忆’。"},{"op":"text","speaker":"","text":"身体有种神奇的感觉，自内向外渐渐被覆盖为他人的颜色。"},{"op":"text","speaker":"","text":"不仅是身体，连‘思想’也逐渐被他人所吞没。"},{"op":"text","speaker":"","text":"不知是谁体验过的，欢乐与高兴的记忆。"},{"op":"text","speaker":"","text":"还有凌驾于这一切的，极度的悔恨与悲伤……"},{"op":"image","layer":0,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":259,"image":"i18131"},{"op":"image","layer":1795,"image":"i18141"},{"op":"clear","layer":259},{"op":"clear","layer":1795},{"op":"clear","layer":771},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":2048},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":259,"image":"i18131"},{"op":"image","layer":0,"image":"i235"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"身子开始慢慢向前进。"},{"op":"text","speaker":"","text":"一步，又一步……"},{"op":"text","speaker":"","text":"脱离了我的意志……"},{"op":"text","speaker":"羽依里","text":"“……现在……就去……”"},{"op":"text","speaker":"羽依里","text":"“我也……来找你们了……”"},{"op":"text","speaker":"","text":"朝向黑暗，又跨出一步……"},{"op":"text","speaker":"","text":"――啊，这下就轻松了……"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":1539},{"op":"clear","layer":259},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"苍","text":"“――羽依里！”"},{"op":"text","speaker":"","text":"熟悉的声音，在我的脑海中一闪而过。"},{"op":"text","speaker":"苍","text":"“这……笨蛋！”"},{"op":"text","speaker":"","text":"然后啪的一声，从我脸庞传来。"},{"op":"text","speaker":"","text":"我在稍微愣了一会儿后才反应过来，原来自己是被扇了一耳光。"},{"op":"image","layer":0,"image":"i235"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"不过在反应过来的同时，‘记忆’也从自己身上慢慢剥离了出去。"},{"op":"image","layer":0,"image":"i235"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":1,"image":"i10423"},{"op":"text","speaker":"羽依里","text":"“……苍？”"},{"op":"image","layer":1,"image":"i10426"},{"op":"text","speaker":"苍","text":"“别动！”"},{"op":"text","speaker":"羽依里","text":"“唉……”"},{"op":"text","speaker":"","text":"不知为什么，苍紧紧抓着我衣服的前襟。"},{"op":"image","layer":1,"image":"i10457"},{"op":"text","speaker":"苍","text":"“你看下面……”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"苍带着凝重的神情，用灯笼照了照我的脚边。"},{"op":"text","speaker":"","text":"左脚踩在地面上。"},{"op":"text","speaker":"","text":"而跨出半步的右脚下面，是一无所有的虚空……"},{"op":"text","speaker":"","text":"我就站在悬崖边上。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i47"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i47"},{"op":"set","variable":6714,"value":1},{"op":"set","variable":30013,"value":1},{"op":"text","speaker":"羽依里","text":"“……!؟”"},{"op":"image","layer":0,"image":"i235"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":1,"image":"i10444"},{"op":"text","speaker":"苍","text":"“听好了？慢慢往后退哦？”"},{"op":"text","speaker":"羽依里","text":"“啊，好……”"},{"op":"text","speaker":"","text":"苍拉着我，开始慢慢后退。"},{"op":"image","layer":1,"image":"i10441"},{"op":"text","speaker":"苍","text":"“可以把脚放下了。”"},{"op":"text","speaker":"","text":"慢慢放下的右脚，踏实地踩在了地上。"},{"op":"text","speaker":"","text":"然后继续后退了几步。"},{"op":"image","layer":1,"image":"i10496"},{"op":"text","speaker":"苍","text":"“已经没事了。”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i47"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"在松了一口气的同时，腿一软直接瘫在了地上。"},{"op":"image","layer":1,"image":"i10529"},{"op":"text","speaker":"苍","text":"“喂!؟没事吧？”"},{"op":"text","speaker":"羽依里","text":"“站，站不起来了……”"},{"op":"image","layer":1,"image":"i10493"},{"op":"text","speaker":"苍","text":"“真是的……”"},{"op":"image","layer":257,"image":"i10669"},{"op":"text","speaker":"稻荷","text":"“嘭。”"},{"op":"text","speaker":"","text":"稻荷来到了瘫座在地上的我的身边。"},{"op":"image","layer":1,"image":"i10509"},{"op":"text","speaker":"苍","text":"“你得感谢稻荷才行。”"},{"op":"image","layer":1,"image":"i10510"},{"op":"text","speaker":"苍","text":"“是它把我硬拉到这里来的。”"},{"op":"text","speaker":"羽依里","text":"“稻荷吗……？”"},{"op":"image","layer":257,"image":"i10698"},{"op":"text","speaker":"稻荷","text":"“嘭。”"},{"op":"text","speaker":"羽依里","text":"“谢啊……谢谢你了，稻荷……”"},{"op":"text","speaker":"","text":"我轻轻抚摸稻荷的脑袋。"},{"op":"image","layer":1,"image":"i10489"},{"op":"text","speaker":"苍","text":"“我说你啊！”"},{"op":"image","layer":1,"image":"i10492"},{"op":"text","speaker":"苍","text":"“都说了晚上不要靠近山的吧！”"},{"op":"image","layer":1,"image":"i10457"},{"op":"text","speaker":"苍","text":"“普通人接触到他人的记忆，百分百没好事发生的！”"},{"op":"text","speaker":"羽依里","text":"“他人的记忆……”"},{"op":"text","speaker":"羽依里","text":"“刚，刚才我看到的……果然是那样吗？”"},{"op":"image","layer":1,"image":"i10460"},{"op":"text","speaker":"苍","text":"“是啊。虽说我不知道你看到了什么。”"},{"op":"image","layer":1,"image":"i10461"},{"op":"text","speaker":"苍","text":"“但你的身体和思想都被那记忆给占据了。”"},{"op":"image","layer":1,"image":"i10475"},{"op":"text","speaker":"苍","text":"“你所看到的，是原本主人的记忆……”"},{"op":"image","layer":1,"image":"i10471"},{"op":"text","speaker":"苍","text":"“你所体验的，也是原本主人体验过的。”"},{"op":"text","speaker":"羽依里","text":"“他一直在寻死……想要别人来杀掉他……”"},{"op":"text","speaker":"","text":"不对……不是这样……"},{"op":"text","speaker":"","text":"恐怕记忆原本的主人……打算由自己来结束自己的生命。"},{"op":"text","speaker":"羽依里","text":"“我，我说……那发光的蝴蝶到底是什么？”"},{"op":"image","layer":1,"image":"i10538"},{"op":"text","speaker":"苍","text":"“……唉？你看得见吗？”"},{"op":"text","speaker":"羽依里","text":"“看得见……？”"},{"op":"image","layer":1,"image":"i10551"},{"op":"text","speaker":"苍","text":"“啊……那个……”"},{"op":"text","speaker":"羽依里","text":"“苍……，你到底在做什么？”"},{"op":"image","layer":1,"image":"i10565"},{"op":"text","speaker":"苍","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“你之前也接触过那蝴蝶吧？”"},{"op":"text","speaker":"羽依里","text":"“那个……七影蝶。”"},{"op":"image","layer":1,"image":"i10517"},{"op":"text","speaker":"苍","text":"“唉……为什么你会知道这个名字啊？”"},{"op":"text","speaker":"羽依里","text":"“在外婆的仓库里看到的。”"},{"op":"text","speaker":"羽依里","text":"“有七影蝶的标本，以及相关的书籍。”"},{"op":"image","layer":1,"image":"i10473"},{"op":"text","speaker":"苍","text":"“七影蝶的标本？”"},{"op":"image","layer":1,"image":"i10551"},{"op":"text","speaker":"苍","text":"“那标本，大概是假货。”"},{"op":"text","speaker":"羽依里","text":"“假货？”"},{"op":"image","layer":1,"image":"i10577"},{"op":"text","speaker":"苍","text":"“这种蝴蝶是做不成标本的。”"},{"op":"text","speaker":"羽依里","text":"“……是这样的吗？”"},{"op":"image","layer":1,"image":"i10517"},{"op":"text","speaker":"苍","text":"“不过，我对那书倒是有点兴趣……”"},{"op":"text","speaker":"","text":"苍低下头，似乎是在考虑什么。"},{"op":"text","speaker":"羽依里","text":"“我说，能告诉我七影蝶的事吗？”"},{"op":"image","layer":1,"image":"i10493"},{"op":"text","speaker":"苍","text":"“……你啊，都遇到刚才那种情况了，居然还有心思打听。”"},{"op":"image","layer":1,"image":"i10488"},{"op":"text","speaker":"苍","text":"“而且，我现在可是非常认真地在教训你啊？”"},{"op":"text","speaker":"羽依里","text":"“啊……对不起……”"},{"op":"text","speaker":"","text":"看来是相当的生气……"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i39"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"","text":"被穿着巫女服的苍带下了山。"},{"op":"text","speaker":"","text":"而稻荷，也夹在我们俩之间。"},{"op":"image","layer":1,"image":"i10563"},{"op":"text","speaker":"苍","text":"“………”"},{"op":"text","speaker":"","text":"好像还在生气。"},{"op":"text","speaker":"羽依里","text":"“呃……那些蝴蝶其实是幽灵一类的东西吗？”"},{"op":"image","layer":1,"image":"i10550"},{"op":"text","speaker":"苍","text":"“………”"},{"op":"text","speaker":"羽依里","text":"“别这样瞪着我啊……”"},{"op":"image","layer":1,"image":"i10563"},{"op":"text","speaker":"苍","text":"“唉……”"},{"op":"image","layer":1,"image":"i10551"},{"op":"text","speaker":"苍","text":"“那个蝴蝶，可不是谁都看得到的……”"},{"op":"text","speaker":"羽依里","text":"“唉？是这样吗？”"},{"op":"image","layer":1,"image":"i10471"},{"op":"text","speaker":"苍","text":"“只有感受性强的人，或者是小孩子……再或者动物之类的……”"},{"op":"image","layer":1,"image":"i10468"},{"op":"text","speaker":"苍","text":"“简单说，只有敏感的人才看得见。”"},{"op":"text","speaker":"羽依里","text":"“也就是有灵感的人吗？”"},{"op":"image","layer":1,"image":"i10504"},{"op":"text","speaker":"苍","text":"“这么说也没错。”"},{"op":"image","layer":7,"image":"i10630"},{"op":"text","speaker":"稻荷","text":"“嘭。”"},{"op":"text","speaker":"羽依里","text":"“原来如此，稻荷就看得见吧。”"},{"op":"text","speaker":"羽依里","text":"“所以，到头来是什么呢？”"},{"op":"image","layer":1,"image":"i10526"},{"op":"text","speaker":"苍","text":"“……嗯～……”"},{"op":"text","speaker":"羽依里","text":"“不方便说吗？”"},{"op":"image","layer":1,"image":"i10493"},{"op":"text","speaker":"苍","text":"“唉～……”"},{"op":"image","layer":1,"image":"i10494"},{"op":"text","speaker":"苍","text":"“都已经看到了，再隐瞒也没什么意思了……”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i512"},{"op":"set","variable":6714,"value":1},{"op":"text","speaker":"苍","text":"“……其实这座岛，被称为是记忆回归之地。”"},{"op":"text","speaker":"苍","text":"“虽然不知道是何时开始的，但在很久之前，就有人看到过七影蝶了。”"},{"op":"text","speaker":"苍","text":"“不如说，是它们聚集在了这座岛。”"},{"op":"text","speaker":"苍","text":"“听说世上有好几个类似的地方，这座岛就是其中之一。”"},{"op":"image","layer":0,"image":"i39"},{"op":"set","variable":6714,"value":1},{"op":"image","layer":1,"image":"i10561"},{"op":"text","speaker":"羽依里","text":"“呃……抱歉，我没太听明白。”"},{"op":"text","speaker":"羽依里","text":"“所以，七影蝶到底是什么？”"},{"op":"image","layer":1,"image":"i10551"},{"op":"text","speaker":"苍","text":"“七影蝶，是人们记忆的残渣……”"},{"op":"image","layer":1,"image":"i10454"},{"op":"text","speaker":"苍","text":"“那些还有依恋或是遗憾的人的‘记忆’，化为蝴蝶留在了这世上。”"},{"op":"image","layer":1,"image":"i10471"},{"op":"text","speaker":"苍","text":"“那些蝴蝶，说是人的记忆本身也不为过。”"},{"op":"text","speaker":"羽依里","text":"“幽灵……？”"},{"op":"image","layer":1,"image":"i10443"},{"op":"text","speaker":"苍","text":"“虽然不怎么好听，但也没错。”"},{"op":"text","speaker":"羽依里","text":"“确实没法做成标本呢……”"},{"op":"image","layer":1,"image":"i10561"},{"op":"text","speaker":"苍","text":"“不过，即便只是记忆，也是不应该留在这世上的东西。”"},{"op":"image","layer":1,"image":"i10563"},{"op":"text","speaker":"苍","text":"“所以，需要有人来引导它们回到原本应去的地方。”"},{"op":"image","layer":1,"image":"i10561"},{"op":"text","speaker":"苍","text":"“而这就是空门家代代负责的，山祭的内容。”"},{"op":"image","layer":1,"image":"i10504"},{"op":"text","speaker":"苍","text":"“在山中提着灯笼漫步，是为了引导迷路的七影蝶。”"},{"op":"image","layer":1,"image":"i10503"},{"op":"text","speaker":"苍","text":"“虽然在一部分岛民眼里，这只不过是走个过场而已……”"},{"op":"image","layer":1,"image":"i10443"},{"op":"text","speaker":"苍","text":"“但，这是有实际意义的。”"},{"op":"image","layer":1,"image":"i10430"},{"op":"text","speaker":"苍","text":"“是非常重要……必须有人来做的事。”"},{"op":"image","layer":1,"image":"i10475"},{"op":"text","speaker":"苍","text":"“当然，最重要的是不能让人碰到七影蝶。”"},{"op":"text","speaker":"羽依里","text":"“……确实……那太危险了……”"},{"op":"text","speaker":"","text":"我十分赞同苍所说的。"},{"op":"text","speaker":"","text":"如果没有刚才的体验，我恐怕不会轻易相信这件事。"},{"op":"text","speaker":"","text":"……我刚才，确实体验了一次别人的记忆。"},{"op":"text","speaker":"羽依里","text":"“……咦？”"},{"op":"text","speaker":"","text":"忽然，我停下脚步。"},{"op":"text","speaker":"羽依里","text":"“说起来，你之前不也碰到过七影蝶吗？”"},{"op":"image","layer":1,"image":"i10435"},{"op":"text","speaker":"苍","text":"“………呃！”"},{"op":"text","speaker":"羽依里","text":"“呜哇……我还是第一次在现实里听到人会惊讶成这样……”"},{"op":"image","layer":1,"image":"i10557"},{"op":"text","speaker":"苍","text":"“……啊…说，说起来…之前你看到了…呢？”"},{"op":"text","speaker":"羽依里","text":"“嗯……”"},{"op":"text","speaker":"羽依里","text":"“说实话，今天就是模仿你才会落得那个下场。”"},{"op":"image","layer":1,"image":"i10625"},{"op":"text","speaker":"苍","text":"“嘘！”"},{"op":"text","speaker":"羽依里","text":"“嘘什么啊……”"},{"op":"image","layer":1,"image":"i10520"},{"op":"text","speaker":"苍","text":"“这么小一座岛，这事你要是说漏嘴了，一传十十传百，迟早会传到我爸妈那里。”"},{"op":"image","layer":1,"image":"i10492"},{"op":"text","speaker":"苍","text":"“求你了，这件事可真的是秘密。”"},{"op":"image","layer":1,"image":"i10489"},{"op":"text","speaker":"苍","text":"“那就是偷窥别人的记忆，可以说是最为严重的侵犯个人隐私。”"},{"op":"image","layer":1,"image":"i10523"},{"op":"text","speaker":"苍","text":"“要是被发现了的话，我会被骂的很惨很惨的。”"},{"op":"text","speaker":"羽依里","text":"“这理由……还真是有够世俗的。”"},{"op":"image","layer":1,"image":"i10504"},{"op":"text","speaker":"苍","text":"“还有，被记忆给影响了很危险的。”"},{"op":"text","speaker":"羽依里","text":"“……啊，确实……不如说，这点更为重要。”"},{"op":"text","speaker":"羽依里","text":"“那为什么，苍要特地违反禁忌呢？”"},{"op":"image","layer":1,"image":"i10519"},{"op":"text","speaker":"苍","text":"“……”"},{"op":"image","layer":1,"image":"i10461"},{"op":"text","speaker":"苍","text":"“这问题，现在要问？”"},{"op":"image","layer":1,"image":"i10460"},{"op":"text","speaker":"苍","text":"“我就是不想你问，才说是秘密的……”"},{"op":"text","speaker":"羽依里","text":"“不行吗？”"},{"op":"image","layer":1,"image":"i10563"},{"op":"text","speaker":"苍","text":"“唉……”"},{"op":"image","layer":1,"image":"i10561"},{"op":"text","speaker":"","text":"稍微沉思了一下后，苍看了看周围。"},{"op":"text","speaker":"","text":"确认没有人之后，把声音压更低回答了我的问题。"},{"op":"image","layer":1,"image":"i10440"},{"op":"text","speaker":"苍","text":"“我无论如何都要找到某个人的记忆……”"},{"op":"text","speaker":"羽依里","text":"“无论如何都要找到的记忆……？”"},{"op":"image","layer":1,"image":"i10443"},{"op":"text","speaker":"苍","text":"“………”"},{"op":"image","layer":1,"image":"i10471"},{"op":"text","speaker":"苍","text":"“……明天，你有时间吗？”"},{"op":"image","layer":1,"image":"i10485"},{"op":"text","speaker":"苍","text":"“我想带你去见一个人。”"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]