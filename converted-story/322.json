[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i364"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我来到了海之家。"},{"op":"text","speaker":"","text":"本想着能来这边见到静久……"},{"op":"image","layer":0,"image":"i508"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"……她没来。"},{"op":"text","speaker":"","text":"今天她不会来了吗？"},{"op":"text","speaker":"三毛猫","text":"“喵――……”"},{"op":"text","speaker":"羽依里","text":"“嗯，怎么了，在这种地方？是要陪我一起等吗？”"},{"op":"text","speaker":"三毛猫","text":"“喵――”"},{"op":"text","speaker":"羽依里","text":"“这样啊……是喵啊。”"},{"op":"if","truth":false,"target":27,"value":["==",["v",7126],2]},{"op":"image","layer":0,"image":"i364"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"和三毛猫一起等了静久一会儿。"},{"op":"text","speaker":"","text":"但是，静久却迟迟没有出现。"},{"op":"text","speaker":"羽依里","text":"“是因为看奶子看太多了吗？”"},{"op":"text","speaker":"","text":"不对，静久不会因为看奶子这种小事生气。"},{"op":"text","speaker":"","text":"是有其他事情要做吗？"},{"op":"text","speaker":"","text":"看了看海之家。"},{"op":"text","speaker":"羽依里","text":"“一个人打扫这里确实很辛苦吧……”"},{"op":"text","speaker":"羽依里","text":"“也许我应该再多帮她一点？”"},{"op":"goto","target":729},{"op":"text","speaker":"","text":"我和和三毛猫一起看着天空，等待了一段时间。"},{"op":"image","layer":7,"image":"i13842"},{"op":"text","speaker":"静久","text":"“你来啦。等了很久吗？”"},{"op":"text","speaker":"","text":"听到了声音。"},{"op":"image","layer":0,"image":"i364"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“哟。还以为你今天不来了呢。”"},{"op":"image","layer":1,"image":"i13867"},{"op":"text","speaker":"静久","text":"“对不起。今天出门的时候被妈妈骂了……”"},{"op":"image","layer":1,"image":"i13870"},{"op":"text","speaker":"静久","text":"“因为她很少生气，就一直说这说那的……于是就迟到了。”"},{"op":"text","speaker":"羽依里","text":"“原来静久也会被骂啊。”"},{"op":"image","layer":1,"image":"i13873"},{"op":"text","speaker":"静久","text":"“对不起……”"},{"op":"text","speaker":"羽依里","text":"“没事，我和这家伙一起等着，没关系的。”"},{"op":"text","speaker":"","text":"咦？它不见了……"},{"op":"image","layer":1,"image":"i13898"},{"op":"text","speaker":"静久","text":"“先不说那些了，欢迎光临♪”"},{"op":"text","speaker":"羽依里","text":"“嗯，正宗的鸡白咖喱我可是期待已久了呢。”"},{"op":"image","layer":1,"image":"i13959"},{"op":"text","speaker":"静久","text":"“呵呵♪那我可得好好给你做一顿好吃的。”"},{"op":"text","speaker":"羽依里","text":"“我很期待哦。”"},{"op":"image","layer":1,"image":"i13775"},{"op":"text","speaker":"静久","text":"“不过在那之前，要请你帮忙打扫一下呢。”"},{"op":"text","speaker":"羽依里","text":"“当然没问题。”"},{"op":"image","layer":1,"image":"i13740"},{"op":"text","speaker":"静久","text":"“再在那之前，先来做个自我介绍如何？”"},{"op":"text","speaker":"羽依里","text":"“自我介绍？”"},{"op":"text","speaker":"","text":"向谁介绍？"},{"op":"image","layer":1,"image":"i13881"},{"op":"text","speaker":"静久","text":"“今天我在渡轮码头遇到了朋友，就把她一起带过来了。”"},{"op":"image","layer":1,"image":"i13927"},{"op":"text","speaker":"静久","text":"“所以，想让你们互相自我介绍一下。”"},{"op":"text","speaker":"羽依里","text":"“啊，原来如此。”"},{"op":"text","speaker":"","text":"学生会长的朋友……"},{"op":"text","speaker":"","text":"感觉肯定是很认真的人。"},{"op":"text","speaker":"","text":"不知道能不能好好相处。"},{"op":"image","layer":1,"image":"i13899"},{"op":"text","speaker":"静久","text":"“那么，请过来这边～♪”"},{"op":"text","speaker":"","text":"她这么说着。"},{"op":"image","layer":257,"image":"i14445"},{"op":"text","speaker":"؟؟؟","text":"“姆啾。”"},{"op":"text","speaker":"","text":"姆啾？"},{"op":"text","speaker":"","text":"从静久身后传来了女孩的声音。"},{"op":"text","speaker":"","text":"而且，好像还有什么金色的东西在晃来晃去。"},{"op":"text","speaker":"","text":"这个特别的口头禅和金色……"},{"op":"image","layer":257,"image":"i14518"},{"op":"image","layer":1,"image":"i13820"},{"op":"text","speaker":"紬","text":"“你好。”"},{"op":"text","speaker":"羽依里","text":"“啊……！”"},{"op":"text","speaker":"","text":"是紬同学。"},{"op":"image","layer":257,"image":"i14506"},{"op":"image","layer":1,"image":"i13898"},{"op":"text","speaker":"静久","text":"“呵呵♪紬，这位是我的新朋友哦。”"},{"op":"image","layer":1,"image":"i13927"},{"op":"text","speaker":"静久","text":"“听说是趁着暑假来到岛上的。”"},{"op":"image","layer":257,"image":"i14518"},{"op":"text","speaker":"紬","text":"“嗯！我知道的。”"},{"op":"image","layer":1,"image":"i13807"},{"op":"text","speaker":"静久","text":"“咦？是这样吗？”"},{"op":"image","layer":257,"image":"i14463"},{"op":"text","speaker":"紬","text":"“其实我们之前已经见过面了，也说过几句话。”"},{"op":"text","speaker":"羽依里","text":"“嗯。我和紬同学是认识的。”"},{"op":"image","layer":1,"image":"i13740"},{"op":"text","speaker":"静久","text":"“原来是这样啊♪”"},{"op":"image","layer":257,"image":"i14417"},{"op":"text","speaker":"紬","text":"“是的。除了名字以外我都记得很清楚。”"},{"op":"text","speaker":"羽依里","text":"“请你记住名字啊。”"},{"op":"image","layer":1,"image":"i13952"},{"op":"text","speaker":"静久","text":"“是乳依里哦。鹰原乳依里。”"},{"op":"image","layer":257,"image":"i14556"},{"op":"text","speaker":"紬","text":"“鹰原乳依里先生！我想起来了――！”"},{"op":"text","speaker":"","text":"完全没想起来嘛。"},{"op":"image","layer":257,"image":"i14547"},{"op":"text","speaker":"紬","text":"“鹰原先生真是个很好的人呢。”"},{"op":"text","speaker":"羽依里","text":"“看来是这样呢。”"},{"op":"image","layer":1,"image":"i13855"},{"op":"text","speaker":"静久","text":"“是呢♪”"},{"op":"text","speaker":"羽依里","text":"“紬同学是无敌的呢。”"},{"op":"image","layer":257,"image":"i14381"},{"op":"text","speaker":"紬","text":"“是的，我是无敌的哦。”"},{"op":"text","speaker":"羽依里","text":"“而且还是女神。”"},{"op":"image","layer":257,"image":"i14446"},{"op":"text","speaker":"紬","text":"“是女神哦。”"},{"op":"text","speaker":"羽依里","text":"“而且是夏天结束后就要回家的伙伴。”"},{"op":"image","layer":257,"image":"i14441"},{"op":"text","speaker":"紬","text":"“是伙伴哦。”"},{"op":"image","layer":257,"image":"i14489"},{"op":"text","speaker":"紬","text":"“――姆啾！”"},{"op":"image","layer":1,"image":"i13807"},{"op":"text","speaker":"静久","text":"“紬，怎么了？”"},{"op":"image","layer":257,"image":"i14522"},{"op":"text","speaker":"紬","text":"“之前聊到过我们是要回家的伙伴。”"},{"op":"image","layer":257,"image":"i14524"},{"op":"text","speaker":"紬","text":"“那时候，鹰原先生对我‘呱呱’叫了几声。”"},{"op":"image","layer":257,"image":"i14534"},{"op":"text","speaker":"紬","text":"“现在才想起来，当时没明白那是什么意思。”"},{"op":"image","layer":257,"image":"i14386"},{"op":"text","speaker":"紬","text":"“那到底是什么呢？”"},{"op":"text","speaker":"","text":"现在才来追究这种事情真是让人困扰。"},{"op":"image","layer":1,"image":"i13779"},{"op":"text","speaker":"静久","text":"“紬。”"},{"op":"image","layer":257,"image":"i14377"},{"op":"text","speaker":"紬","text":"“姆啾？”"},{"op":"image","layer":1,"image":"i13829"},{"op":"text","speaker":"静久","text":"“那是双关语哦！”"},{"op":"image","layer":257,"image":"i14529"},{"op":"text","speaker":"紬","text":"“哦！原来是双关语啊！”"},{"op":"text","speaker":"羽依里","text":"“别说了。”"},{"op":"image","layer":1,"image":"i13962"},{"op":"text","speaker":"静久","text":"“因为‘回去’（kaeru）和‘青蛙’（kaeru）发音相同，是个很有趣的双关语哦♪”"},{"op":"image","layer":257,"image":"i14548"},{"op":"text","speaker":"紬","text":"“这样啊。原来是回去和青蛙呀，真的很有意思呢。”"},{"op":"image","layer":257,"image":"i14420"},{"op":"text","speaker":"紬","text":"“对不起，当时没能领会到笑点。”"},{"op":"image","layer":257,"image":"i14463"},{"op":"text","speaker":"紬","text":"“现在我要笑了哦。”"},{"op":"text","speaker":"羽依里","text":"“别这样，那只会让我尴尬……”"},{"op":"text","speaker":"羽依里","text":"“不过，这倒是有点意外啊。”"},{"op":"image","layer":1,"image":"i13864"},{"op":"text","speaker":"静久","text":"“什么意外？”"},{"op":"text","speaker":"羽依里","text":"“没想到静久和紬同学是朋友。”"},{"op":"image","layer":1,"image":"i13807"},{"op":"text","speaker":"静久","text":"“有什么意外的吗？”"},{"op":"image","layer":257,"image":"i14515"},{"op":"text","speaker":"紬","text":"“会很意外吗？”"},{"op":"image","layer":257,"image":"i14545"},{"op":"text","speaker":"紬","text":"“我和静久从第一次见面时起，就是独一无二的好朋友了！”"},{"op":"image","layer":1,"image":"i13746"},{"op":"text","speaker":"静久","text":"“咦？第一次见面的时候还不是这样的吧。”"},{"op":"image","layer":257,"image":"i14497"},{"op":"text","speaker":"紬","text":"“姆啾――……”"},{"op":"image","layer":1,"image":"i13797"},{"op":"text","speaker":"静久","text":"“不过从第二次见面开始，我们就成为好朋友了呢♪”"},{"op":"image","layer":257,"image":"i14420"},{"op":"text","speaker":"紬","text":"“静久――！”"},{"op":"image","layer":1,"image":"i14509"},{"op":"image","layer":257,"image":"i13833"},{"op":"text","speaker":"","text":"紧紧地抱住了她。"},{"op":"image","layer":257,"image":"i13915"},{"op":"text","speaker":"静久","text":"“好啦好啦♪”"},{"op":"text","speaker":"","text":"确实是名副其实的好朋友。"},{"op":"text","speaker":"","text":"她们看起来关系真的很好。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i364"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"于是，我们就开始打扫卫生了。"},{"op":"text","speaker":"","text":"这时。"},{"op":"image","layer":1,"image":"i10241"},{"op":"image","layer":257,"image":"i14377"},{"op":"image","layer":513,"image":"i13737"},{"op":"text","speaker":"苍","text":"“哎～真的重新开张了呀。”"},{"op":"image","layer":513,"image":"i13740"},{"op":"text","speaker":"静久","text":"“哎呀，空门同学。”"},{"op":"image","layer":1,"image":"i10112"},{"op":"text","speaker":"苍","text":"“你们好。紬和羽依里也来了啊。”"},{"op":"text","speaker":"羽依里","text":"“嗯，我是来帮忙的。”"},{"op":"image","layer":257,"image":"i14445"},{"op":"text","speaker":"紬","text":"“你好。”"},{"op":"image","layer":1,"image":"i10112"},{"op":"image","layer":257,"image":"i13775"},{"op":"text","speaker":"静久","text":"“不过，你怎么会来这里？”"},{"op":"image","layer":1,"image":"i10154"},{"op":"text","speaker":"苍","text":"“听羽依里之前说海之家要重新开张，于是就想来看看。”"},{"op":"image","layer":1,"image":"i10118"},{"op":"text","speaker":"苍","text":"“而且听说还要开咨询室。”"},{"op":"image","layer":257,"image":"i13864"},{"op":"text","speaker":"静久","text":"“是的，因为有不少同学想找我咨询升学和社团活动之类的事情。”"},{"op":"image","layer":1,"image":"i10252"},{"op":"text","speaker":"苍","text":"“哇――明明是暑假还这么辛苦……”"},{"op":"image","layer":257,"image":"i13914"},{"op":"text","speaker":"静久","text":"“没关系的，我也只是当个听众而已。”"},{"op":"image","layer":1,"image":"i10269"},{"op":"text","speaker":"苍","text":"“说起来……现在有空吗？”"},{"op":"image","layer":257,"image":"i13864"},{"op":"text","speaker":"静久","text":"“咦？你有事想找我咨询吗？”"},{"op":"image","layer":1,"image":"i10231"},{"op":"text","speaker":"苍","text":"“嗯，有一点……”"},{"op":"image","layer":257,"image":"i13933"},{"op":"text","speaker":"静久","text":"“好的，那就说来听听吧♪”"},{"op":"image","layer":1,"image":"i10112"},{"op":"text","speaker":"苍","text":"“谢谢你。”"},{"op":"image","layer":1,"image":"i10112"},{"op":"image","layer":257,"image":"i14547"},{"op":"image","layer":513,"image":"i13779"},{"op":"text","speaker":"紬","text":"“会是什么样的事情呢？”"},{"op":"text","speaker":"羽依里","text":"“感觉心跳都要加速了。”"},{"op":"image","layer":1,"image":"i10162"},{"op":"text","speaker":"苍","text":"“你们不准偷听。”"},{"op":"image","layer":257,"image":"i14529"},{"op":"text","speaker":"紬","text":"“姆啾!؟”"},{"op":"text","speaker":"羽依里","text":"“哎――……”"},{"op":"image","layer":1,"image":"i10189"},{"op":"text","speaker":"苍","text":"“不管是姆啾还是哎都不行。”"},{"op":"image","layer":513,"image":"i13782"},{"op":"text","speaker":"静久","text":"“抱歉啊，这些事情应该是不想被别人听到的。”"},{"op":"text","speaker":"","text":"这倒也是。"},{"op":"image","layer":1,"image":"i14515"},{"op":"text","speaker":"羽依里","text":"“那么紬同学，我们就两个人来聊天吧。”"},{"op":"image","layer":1,"image":"i14518"},{"op":"text","speaker":"紬","text":"“好的，请多指教。”"},{"op":"image","layer":257,"image":"i10276"},{"op":"image","layer":513,"image":"i13962"},{"op":"text","speaker":"静久","text":"“那么，待会见。”"},{"op":"text","speaker":"","text":"静久和苍走进了店里面。"},{"op":"text","speaker":"羽依里","text":"“该怎么办呢？”"},{"op":"image","layer":1,"image":"i14381"},{"op":"text","speaker":"紬","text":"“趁现在，我们来……加深一下关系吧。”"},{"op":"text","speaker":"羽依里","text":"“啊？”"},{"op":"image","layer":1,"image":"i14463"},{"op":"text","speaker":"紬","text":"“你可以直接称呼我紬哦？”"},{"op":"text","speaker":"羽依里","text":"“啊，那你也叫我羽依里就好。”"},{"op":"image","layer":1,"image":"i14564"},{"op":"text","speaker":"紬","text":"“知道了，羽依里先生。”"},{"op":"set","variable":132,"value":1},{"op":"set","variable":474,"value":1},{"op":"image","layer":1,"image":"i14475"},{"op":"text","speaker":"紬","text":"“羽依里先生……她们差不多该结束了吧？”"},{"op":"text","speaker":"羽依里","text":"“唔……”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i1596"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"静久","text":"“这样啊……那就是说，你每天都会和那孩子？”"},{"op":"text","speaker":"苍","text":"“是的。”"},{"op":"text","speaker":"静久","text":"“你这不是很努力嘛。”"},{"op":"text","speaker":"苍","text":"“啊哈哈。但这只不过是我的一厢情愿而已，说不定对方会觉得困扰……”"},{"op":"text","speaker":"静久","text":"“嗯……”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i364"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“感觉还要等一阵子呢。”"},{"op":"text","speaker":"","text":"啊，说起来她既然和静久关系不错的话……"},{"op":"text","speaker":"羽依里","text":"“那个，我想问一件关于静久的事。”"},{"op":"image","layer":1,"image":"i14467"},{"op":"text","speaker":"紬","text":"“什么事呢？”"},{"op":"text","speaker":"羽依里","text":"“静久是不是在说话的时候……会突然夹杂一些奶子的话题？”"},{"op":"image","layer":1,"image":"i14489"},{"op":"text","speaker":"紬","text":"“啊――……”"},{"op":"image","layer":1,"image":"i14520"},{"op":"text","speaker":"紬","text":"“这个说法不太对。”"},{"op":"text","speaker":"羽依里","text":"“什么意思？”"},{"op":"image","layer":1,"image":"i14381"},{"op":"text","speaker":"紬","text":"“是反过来的。”"},{"op":"text","speaker":"羽依里","text":"“反过来？”"},{"op":"image","layer":1,"image":"i14384"},{"op":"text","speaker":"紬","text":"“是在奶子里夹杂其他话题。”"},{"op":"text","speaker":"羽依里","text":"“哎？”"},{"op":"image","layer":1,"image":"i14381"},{"op":"text","speaker":"紬","text":"“静久本质上就是奶子。”"},{"op":"image","layer":1,"image":"i14470"},{"op":"text","speaker":"紬","text":"“是在聊着奶子的时候，偶尔会插入一些正经的对话。”"},{"op":"text","speaker":"","text":"她原来奶子的境界已经到这种地步了啊。"},{"op":"text","speaker":"羽依里","text":"“那果然，她会经常说奶子对吧？”"},{"op":"image","layer":1,"image":"i14520"},{"op":"text","speaker":"紬","text":"“是的，她会说很多奶子，说得都快让人怀疑其实是奶子在说话了。”"},{"op":"text","speaker":"","text":"果然如此。"},{"op":"image","layer":1,"image":"i14524"},{"op":"text","speaker":"紬","text":"“那个……羽依里先生。”"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"image","layer":1,"image":"i14534"},{"op":"text","speaker":"紬","text":"“请一定要和静久好好相处哦。”"},{"op":"text","speaker":"羽依里","text":"“啊？那当然没问题了。”"},{"op":"image","layer":1,"image":"i14388"},{"op":"text","speaker":"紬","text":"“就像之前说过的，等夏天结束后，我就要回去了。”"},{"op":"image","layer":1,"image":"i14404"},{"op":"text","speaker":"紬","text":"“会去一个很远很远的地方，可能就没太有机会见面了。”"},{"op":"text","speaker":"羽依里","text":"“是这样啊……”"},{"op":"image","layer":1,"image":"i14388"},{"op":"text","speaker":"紬","text":"“我想静久她肯定会很寂寞的。”"},{"op":"image","layer":1,"image":"i14446"},{"op":"text","speaker":"紬","text":"“所以如果你今后能继续和她好好相处的话，我会很开心的。”"},{"op":"text","speaker":"羽依里","text":"“这当然没问题，不过暑假结束后我也要回家去了。”"},{"op":"text","speaker":"羽依里","text":"“再说，反正学校里好像也有很多仰慕她的人。”"},{"op":"image","layer":1,"image":"i14547"},{"op":"text","speaker":"紬","text":"“但是，羽依里先生肯定是最合适的。”"},{"op":"text","speaker":"羽依里","text":"“哎……为什么？”"},{"op":"image","layer":1,"image":"i14543"},{"op":"text","speaker":"紬","text":"“因为你是为数不多，知道静久本质就是奶子的人。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"……搞不太懂。"},{"op":"image","layer":1,"image":"i14534"},{"op":"text","speaker":"紬","text":"“总感觉大家都会把静久当作一个特别的人去对待。”"},{"op":"image","layer":1,"image":"i14384"},{"op":"text","speaker":"紬","text":"“但羽依里先生就没有这样的感觉。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i14420"},{"op":"text","speaker":"紬","text":"“所以请一定要和静久好好相处下去哦。”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i364"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i10112"},{"op":"image","layer":257,"image":"i13779"},{"op":"text","speaker":"静久","text":"“让你们久等了。”"},{"op":"image","layer":1,"image":"i10235"},{"op":"text","speaker":"苍","text":"“水织学姐，多谢你了。”"},{"op":"image","layer":257,"image":"i13891"},{"op":"text","speaker":"静久","text":"“没事，不用谢哦。”"},{"op":"image","layer":1,"image":"i10210"},{"op":"text","speaker":"苍","text":"“抱歉啊你们两个，一不小心聊了这么久。”"},{"op":"image","layer":1,"image":"i10235"},{"op":"image","layer":257,"image":"i14445"},{"op":"image","layer":513,"image":"i13891"},{"op":"text","speaker":"紬","text":"“没关系。这段时间我和羽依里先生已经熟络起来了。”"},{"op":"text","speaker":"羽依里","text":"“是啊。”"},{"op":"image","layer":513,"image":"i13855"},{"op":"text","speaker":"静久","text":"“呵呵♪那我们聊得久也算是有意义了呢。”"},{"op":"image","layer":257,"image":"i14446"},{"op":"text","speaker":"紬","text":"“你们是在说奶子的话题吗？”"},{"op":"image","layer":1,"image":"i10233"},{"op":"text","speaker":"苍","text":"“紬……水织学姐她可是个非常认真又容易害羞的人。”"},{"op":"image","layer":1,"image":"i10224"},{"op":"text","speaker":"苍","text":"“所以，像是奶子这种话要尽量少说一些哦。”"},{"op":"image","layer":257,"image":"i14377"},{"op":"text","speaker":"紬","text":"“是这样啊。”"},{"op":"image","layer":513,"image":"i13924"},{"op":"text","speaker":"静久","text":"“没关系，奶子是不算在内的。”"},{"op":"image","layer":1,"image":"i10218"},{"op":"text","speaker":"苍","text":"“……”"},{"op":"image","layer":1,"image":"i10412"},{"op":"text","speaker":"苍","text":"“那、那个……那我先回店里去了。”"},{"op":"image","layer":513,"image":"i13852"},{"op":"text","speaker":"静久","text":"“啊，如果可以的话，要不要吃点咖喱再走？”"},{"op":"image","layer":513,"image":"i13962"},{"op":"text","speaker":"静久","text":"“因为我想复原以前的食谱，想让知道那个味道的人来品尝一下。”"},{"op":"image","layer":1,"image":"i10241"},{"op":"text","speaker":"苍","text":"“当然可以。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i378"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i10350"},{"op":"image","layer":257,"image":"i14516"},{"op":"image","layer":513,"image":"i13914"},{"op":"text","speaker":"苍","text":"“我开始吃啦。”"},{"op":"image","layer":257,"image":"i14471"},{"op":"text","speaker":"紬","text":"“我开始吃啦～”"},{"op":"text","speaker":"","text":"我也双手合十，四个人一起吃了起来。"},{"op":"image","layer":7,"image":"i14419"},{"op":"text","speaker":"紬","text":"“太好吃了！”"},{"op":"text","speaker":"羽依里","text":"“啊……嗯！感觉比上次香气更加浓郁了。”"},{"op":"image","layer":1,"image":"i14467"},{"op":"image","layer":257,"image":"i13782"},{"op":"text","speaker":"静久","text":"“太好了♪”"},{"op":"image","layer":1,"image":"i14529"},{"op":"text","speaker":"紬","text":"“既然说了上次，就是说之前也吃过吗？”"},{"op":"text","speaker":"羽依里","text":"“对，上次吃的是猪肉的。”"},{"op":"image","layer":257,"image":"i13952"},{"op":"text","speaker":"静久","text":"“今天我照着食谱，试着做了海鲜咖喱。”"},{"op":"text","speaker":"羽依里","text":"“就我个人而言，之前的做法也很喜欢就是了。”"},{"op":"image","layer":257,"image":"i13898"},{"op":"text","speaker":"静久","text":"“那下次再给你做哦。”"},{"op":"text","speaker":"羽依里","text":"“太好了。”"},{"op":"image","layer":1,"image":"i14543"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"image","layer":257,"image":"i13840"},{"op":"text","speaker":"静久","text":"“怎么了，紬？”"},{"op":"image","layer":1,"image":"i14530"},{"op":"text","speaker":"紬","text":"“看到你们这么要好，我很开心。”"},{"op":"image","layer":257,"image":"i13782"},{"op":"text","speaker":"静久","text":"“是啊，如果看起来是这样的话，我也很开心♪”"},{"op":"text","speaker":"羽依里","text":"“……是吗。”"},{"op":"text","speaker":"","text":"感觉好害羞。"},{"op":"image","layer":1,"image":"i14477"},{"op":"text","speaker":"紬","text":"“看着羽依里先生和静久的友情培养得越来越深厚，我都有点羡慕了呢。”"},{"op":"image","layer":257,"image":"i13775"},{"op":"text","speaker":"静久","text":"“那紬也一起来培养吧。”"},{"op":"image","layer":1,"image":"i14492"},{"op":"text","speaker":"紬","text":"“可以吗？”"},{"op":"image","layer":257,"image":"i13740"},{"op":"text","speaker":"静久","text":"“当然可以♪要是我没去灯塔的话，你就过来这边吧。”"},{"op":"image","layer":257,"image":"i13832"},{"op":"text","speaker":"静久","text":"“我应该会在这里打扫卫生，或者听人倾诉烦恼的。”"},{"op":"image","layer":1,"image":"i14470"},{"op":"text","speaker":"紬","text":"“我知道了！”"},{"op":"image","layer":1,"image":"i10350"},{"op":"image","layer":257,"image":"i14471"},{"op":"image","layer":513,"image":"i13864"},{"op":"text","speaker":"静久","text":"“啊……空门同学觉得这个咖喱怎么样？”"},{"op":"image","layer":1,"image":"i10382"},{"op":"text","speaker":"苍","text":"“这个真的很好吃……！”"},{"op":"image","layer":1,"image":"i10377"},{"op":"text","speaker":"苍","text":"“啊……不过。”"},{"op":"image","layer":513,"image":"i13879"},{"op":"text","speaker":"静久","text":"“果然还是缺了点什么？”"},{"op":"image","layer":1,"image":"i10400"},{"op":"text","speaker":"苍","text":"“是的……感觉少了一点味道。”"},{"op":"image","layer":513,"image":"i13807"},{"op":"text","speaker":"静久","text":"“果然是这样呢。明明我是按照食谱做的……”"},{"op":"text","speaker":"羽依里","text":"“不，我是真的觉得很好吃。”"},{"op":"image","layer":1,"image":"i10142"},{"op":"text","speaker":"苍","text":"“啊，嗯，好吃是真的好吃啦。”"},{"op":"image","layer":1,"image":"i10255"},{"op":"text","speaker":"苍","text":"“只不过和以前的味道相比……就是感觉缺了点什么。”"},{"op":"image","layer":257,"image":"i14525"},{"op":"text","speaker":"紬","text":"“是这样啊。毕竟我们都没尝到过以前的味道呢。”"},{"op":"image","layer":1,"image":"i10409"},{"op":"text","speaker":"苍","text":"“是海鲜的问题吗？可能当时用的是岛上的新鲜食材？”"},{"op":"text","speaker":"羽依里","text":"“但是，现在用的材料也是在岛上买的吧？”"},{"op":"text","speaker":"","text":"她也说是用岛上新鲜海鲜做出的咖喱。"},{"op":"text","speaker":"羽依里","text":"“说是渔夫刚捕上来的那种……”"},{"op":"text","speaker":"羽依里","text":"“一定要那么新鲜才行吗？”"},{"op":"image","layer":513,"image":"i13775"},{"op":"text","speaker":"静久","text":"“可能是这样呢。”"},{"op":"text","speaker":"羽依里","text":"“我和紬虽然觉得很好吃，但毕竟是不知道以前的味道啊。”"},{"op":"image","layer":513,"image":"i13849"},{"op":"text","speaker":"静久","text":"“我也去问问其他人吧。”"},{"op":"text","speaker":"羽依里","text":"“还有就是，新鲜海鲜该怎么办呢？”"},{"op":"image","layer":1,"image":"i10390"},{"op":"text","speaker":"苍","text":"“啊！那么。”"},{"op":"image","layer":1,"image":"i10296"},{"op":"text","speaker":"苍","text":"“我会把这里海之家和咨询室开张的事情告诉大家的。”"},{"op":"image","layer":513,"image":"i13891"},{"op":"text","speaker":"静久","text":"“谢谢你。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i378"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"苍走后，紬为了感谢招待的这顿咖喱，开始帮忙洗起了碗。"},{"op":"text","speaker":"","text":"我擦拭着桌子。"},{"op":"image","layer":1,"image":"i13807"},{"op":"text","speaker":"静久","text":"“关于空门同学的咨询……”"},{"op":"text","speaker":"","text":"静久在便利贴上写着什么。"},{"op":"text","speaker":"羽依里","text":"“你在做什么？”"},{"op":"image","layer":1,"image":"i13876"},{"op":"text","speaker":"静久","text":"“啊？”"},{"op":"image","layer":1,"image":"i13867"},{"op":"text","speaker":"静久","text":"“啊……那个，我在记录采取了什么样的应对方式。”"},{"op":"text","speaker":"羽依里","text":"“……？”"},{"op":"image","layer":1,"image":"i13879"},{"op":"text","speaker":"静久","text":"“这个时候对她说了这样的话……就是类似这样的记录。”"},{"op":"image","layer":1,"image":"i13767"},{"op":"text","speaker":"静久","text":"“这么一来，当其他有同样烦恼的人来咨询的时候。”"},{"op":"image","layer":1,"image":"i13755"},{"op":"text","speaker":"静久","text":"“就能作为参考，知道该如何应对了吧？”"},{"op":"text","speaker":"羽依里","text":"“确实……”"},{"op":"text","speaker":"","text":"这咨询室比我想象中还要正经得多啊。"},{"op":"text","speaker":"羽依里","text":"“我能看看吗？”"},{"op":"image","layer":1,"image":"i13870"},{"op":"text","speaker":"静久","text":"“哎哎？”"},{"op":"image","layer":1,"image":"i13867"},{"op":"text","speaker":"静久","text":"“可、可以是可以……”"},{"op":"text","speaker":"","text":"她好像有点害羞……"},{"op":"text","speaker":"","text":"看了看最新的便利贴。"},{"op":"text","speaker":"","text":"‘紧紧握住她的手，一遍又一遍地告诉她没关系’。"},{"op":"text","speaker":"","text":"上面是这样写的。"},{"op":"text","speaker":"","text":"苍的手……被静久紧紧握住……"},{"op":"text","speaker":"","text":"不知为何心跳加快了。"},{"op":"text","speaker":"羽依里","text":"“静久……你和苍做了这种事啊……”"},{"op":"image","layer":1,"image":"i13884"},{"op":"text","speaker":"静久","text":"“呜呜呜～～～……”"},{"op":"text","speaker":"羽依里","text":"“不过，原来你是这样帮大家解决烦恼的啊。”"},{"op":"image","layer":1,"image":"i13902"},{"op":"text","speaker":"静久","text":"“并没有解决哦。”"},{"op":"text","speaker":"羽依里","text":"“哎？……但是良一说你帮他解决了很多问题啊。”"},{"op":"image","layer":1,"image":"i13930"},{"op":"text","speaker":"静久","text":"“我的人生经验还很不足，知识和行动力也完全不够。”"},{"op":"image","layer":1,"image":"i13898"},{"op":"text","speaker":"静久","text":"“我只是倾听、给出建议，帮助他们理清思绪而已。”"},{"op":"text","speaker":"羽依里","text":"“原来如此。”"},{"op":"text","speaker":"","text":"理清思绪啊。"},{"op":"image","layer":1,"image":"i13755"},{"op":"text","speaker":"静久","text":"“然后呢，比如给出什么样的建议会让对方开心，或者让对方振作起来了。”"},{"op":"image","layer":1,"image":"i13743"},{"op":"text","speaker":"静久","text":"“我就把这些记在便利贴上，贴到笔记本上。”"},{"op":"image","layer":1,"image":"i13807"},{"op":"text","speaker":"静久","text":"“如果遇到类似的咨询，就可以用同样的方式去帮助他们。”"},{"op":"text","speaker":"羽依里","text":"“真了不起啊。”"},{"op":"image","layer":1,"image":"i13832"},{"op":"text","speaker":"静久","text":"“没什么了不起的。”"},{"op":"image","layer":1,"image":"i13816"},{"op":"text","speaker":"静久","text":"“既然大家愿意来找我商量事情，我就想尽可能地帮到他们。”"},{"op":"text","speaker":"羽依里","text":"“不，我觉得很了不起哦。”"},{"op":"image","layer":1,"image":"i13884"},{"op":"text","speaker":"静久","text":"“这、这种事……”"},{"op":"text","speaker":"羽依里","text":"“静久在学校里也是这样做的吧。”"},{"op":"text","speaker":"","text":"难怪会成为深受大家爱戴的学生会长。"},{"op":"text","speaker":"羽依里","text":"“我真心觉得很厉害，不愧是深受大家欢迎的学生会长啊。”"},{"op":"image","layer":1,"image":"i13886"},{"op":"text","speaker":"静久","text":"“真是的……从刚才就一直在说这种话。”"},{"op":"image","layer":1,"image":"i13952"},{"op":"text","speaker":"静久","text":"“我只是个奶子而已。”"},{"op":"text","speaker":"羽依里","text":"“是、是吗？”"},{"op":"image","layer":1,"image":"i13807"},{"op":"text","speaker":"静久","text":"“咦？我有跟羽依里提到过我是学生会长吗？”"},{"op":"text","speaker":"羽依里","text":"“是从苍他们那里听说的。”"},{"op":"image","layer":1,"image":"i13770"},{"op":"text","speaker":"静久","text":"“这样啊。”"},{"op":"set","variable":7120,"value":1},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i367"},{"op":"set","variable":6714,"value":4},{"op":"image","layer":1,"image":"i14377"},{"op":"image","layer":257,"image":"i13794"},{"op":"text","speaker":"静久","text":"“那么，我差不多该回去了。”"},{"op":"image","layer":1,"image":"i14547"},{"op":"text","speaker":"紬","text":"“该呱呱了哦。”"},{"op":"text","speaker":"羽依里","text":"“别这样。”"},{"op":"image","layer":1,"image":"i14545"},{"op":"text","speaker":"紬","text":"“我打算在回灯塔的路上捡一捡垃圾。”"},{"op":"text","speaker":"羽依里","text":"“紬也很伟大啊……”"},{"op":"image","layer":1,"image":"i14445"},{"op":"text","speaker":"紬","text":"“没有这回事。”"},{"op":"text","speaker":"","text":"一个会帮人解决烦恼的静久，一个会帮忙捡垃圾的紬。"},{"op":"text","speaker":"羽依里","text":"“真了不起。”"},{"op":"text","speaker":"羽依里","text":"“那我也边走边捡一捡吧。”"},{"op":"image","layer":1,"image":"i14554"},{"op":"text","speaker":"紬","text":"“真了不起呢。”"},{"op":"image","layer":257,"image":"i13898"},{"op":"text","speaker":"静久","text":"“那我也一起。”"},{"op":"image","layer":1,"image":"i14545"},{"op":"text","speaker":"紬","text":"“真的特别了不起。”"},{"op":"text","speaker":"","text":"我们都变得很了不起。"},{"op":"text","speaker":"","text":"三个人都能这么了不起，这可不太常见。"},{"op":"text","speaker":"","text":"我们三个一边捡垃圾一边走着。"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i34"},{"op":"set","variable":6714,"value":4},{"op":"text","speaker":"羽依里","text":"“意外还挺多的……”"},{"op":"image","layer":1,"image":"i14404"},{"op":"image","layer":257,"image":"i13785"},{"op":"text","speaker":"紬","text":"“是啊……稍微有点重呢。”"},{"op":"text","speaker":"","text":"捡到的垃圾多到惊人。"},{"op":"image","layer":257,"image":"i13870"},{"op":"text","speaker":"静久","text":"“附近有垃圾场吗？”"},{"op":"image","layer":1,"image":"i14534"},{"op":"text","speaker":"紬","text":"“姆啾～……”"},{"op":"text","speaker":"","text":"紬把垃圾放到了地上。"},{"op":"text","speaker":"","text":"看起来确实蛮重的。"},{"op":"image","layer":1,"image":"i14532"},{"op":"text","speaker":"紬","text":"“捡了这么多，有点后悔了。”"},{"op":"image","layer":257,"image":"i13959"},{"op":"text","speaker":"静久","text":"“呵呵♪　再坚持一下哦。”"},{"op":"image","layer":1,"image":"i14440"},{"op":"text","speaker":"紬","text":"“好的！我会加油的！”"},{"op":"text","speaker":"","text":"紬正要把垃圾抬起来的时候……"},{"op":"text","speaker":"家庭主妇B","text":"“那个……”"},{"op":"image","layer":1,"image":"i14492"},{"op":"image","layer":257,"image":"i13864"},{"op":"text","speaker":"紬","text":"“姆啾？什么事？”"},{"op":"text","speaker":"家庭主妇B","text":"“我这里可不是垃圾场。”"},{"op":"text","speaker":"羽依里","text":"“啊，对不起！”"},{"op":"text","speaker":"","text":"慌忙把垃圾抬起来。"},{"op":"text","speaker":"家庭主妇B","text":"“可以不要在我家门前做这种事吗？”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“啊……那个，我们不是想要丢垃圾。”"},{"op":"text","speaker":"羽依里","text":"“是在海边捡垃圾，正在搬运的途中……”"},{"op":"text","speaker":"家庭主妇B","text":"“是、是这样吗？”"},{"op":"text","speaker":"羽依里","text":"“是的。”"},{"op":"text","speaker":"家庭主妇B","text":"“……”"},{"op":"text","speaker":"家庭主妇B","text":"“别做这种容易引起误会的事啊……”"},{"op":"text","speaker":"羽依里","text":"“……是。”"},{"op":"text","speaker":"","text":"那个人回到了屋里。"},{"op":"text","speaker":"羽依里","text":"“总之先搬走吧。”"},{"op":"image","layer":257,"image":"i13852"},{"op":"text","speaker":"静久","text":"“嗯。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i3"},{"op":"set","variable":6714,"value":4},{"op":"image","layer":1,"image":"i14404"},{"op":"image","layer":257,"image":"i13794"},{"op":"text","speaker":"紬","text":"“姆啾～……”"},{"op":"image","layer":257,"image":"i13807"},{"op":"text","speaker":"静久","text":"“怎么了？”"},{"op":"image","layer":1,"image":"i14388"},{"op":"text","speaker":"紬","text":"“那个人，好可怕……”"},{"op":"image","layer":257,"image":"i13794"},{"op":"text","speaker":"静久","text":"“因为她以为有人要在自己家门前丢垃圾，所以表情才变得那么吓人。”"},{"op":"image","layer":257,"image":"i13775"},{"op":"text","speaker":"静久","text":"“只是误会而已，不用在意的。”"},{"op":"text","speaker":"羽依里","text":"“但是，明明在做好事却要被骂……最后还是那种态度，就总觉得……”"},{"op":"image","layer":257,"image":"i13852"},{"op":"text","speaker":"静久","text":"“这种事很正常哦。”"},{"op":"image","layer":257,"image":"i13952"},{"op":"text","speaker":"静久","text":"“生气其实还挺不容易的，一旦发起火来就很难收场。”"},{"op":"image","layer":257,"image":"i13898"},{"op":"text","speaker":"静久","text":"“那个人肯定也是鼓起了十足的勇气才发火的，结果却发现是误会。”"},{"op":"image","layer":257,"image":"i13914"},{"op":"text","speaker":"静久","text":"“觉得很难为情，所以自己也不好找台阶下。”"},{"op":"image","layer":257,"image":"i13773"},{"op":"text","speaker":"静久","text":"“所以没关系的♪”"},{"op":"text","speaker":"羽依里","text":"“这样啊。”"},{"op":"image","layer":257,"image":"i13775"},{"op":"text","speaker":"静久","text":"“如果你还在意的话，那我来替那个人表扬你们。”"},{"op":"text","speaker":"羽依里","text":"“哎……？”"},{"op":"image","layer":1,"image":"i14459"},{"op":"text","speaker":"紬","text":"“拜托了。”"},{"op":"image","layer":257,"image":"i13952"},{"op":"text","speaker":"静久","text":"“紬很了不起哦，紬真棒。”"},{"op":"image","layer":257,"image":"i13896"},{"op":"text","speaker":"静久","text":"“给你一个抱抱。”"},{"op":"image","layer":1,"image":"i14508"},{"op":"text","speaker":"紬","text":"“姆啾！”"},{"op":"image","layer":1,"image":"i14509"},{"op":"image","layer":257,"image":"i13833"},{"op":"text","speaker":"","text":"被紧紧抱住了。"},{"op":"image","layer":1,"image":"i13962"},{"op":"text","speaker":"静久","text":"“羽依里也很了不起哦，非常棒。”"},{"op":"text","speaker":"羽依里","text":"“啊，谢谢。”"},{"op":"image","layer":1,"image":"i13914"},{"op":"text","speaker":"静久","text":"“要过来吗？”"},{"op":"text","speaker":"羽依里","text":"“哎？”"},{"op":"choice","variable":6001,"items":[{"text":"要的","value":0,"condition":1},{"text":"还是太害羞了","value":1,"condition":1}]},{"op":"if","truth":false,"target":692,"value":["==",["v",6001],0]},{"op":"set","variable":480,"value":1},{"op":"text","speaker":"羽依里","text":"“那就拜托了。”"},{"op":"image","layer":1,"image":"i13837"},{"op":"text","speaker":"静久","text":"“哎？嗯、嗯……！”"},{"op":"image","layer":0,"image":"i191"},{"op":"set","variable":6714,"value":4},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":1,"image":"i13922"},{"op":"text","speaker":"","text":"被紧紧抱住了。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"好柔软。"},{"op":"image","layer":1,"image":"i13904"},{"op":"text","speaker":"静久","text":"“……”"},{"op":"text","speaker":"","text":"分开了。"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i3"},{"op":"set","variable":6714,"value":4},{"op":"image","layer":1,"image":"i13884"},{"op":"text","speaker":"静久","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“……怎、怎么了？”"},{"op":"image","layer":1,"image":"i13888"},{"op":"text","speaker":"静久","text":"“没想到你真的会过来……”"},{"op":"text","speaker":"羽依里","text":"“啊，抱歉！”"},{"op":"image","layer":1,"image":"i13834"},{"op":"text","speaker":"静久","text":"“不，没关系的。”"},{"op":"image","layer":1,"image":"i13849"},{"op":"text","speaker":"静久","text":"“如果能当作羽依里努力捡垃圾的一点奖励的话，我也很乐意。”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"image","layer":257,"image":"i14467"},{"op":"text","speaker":"紬","text":"“……？”"},{"op":"goto","target":713},{"op":"text","speaker":"羽依里","text":"“突然被抱住还是会觉得害羞。”"},{"op":"image","layer":1,"image":"i13921"},{"op":"text","speaker":"静久","text":"“呵呵♪　其实我也是。”"},{"op":"text","speaker":"羽依里","text":"“那你为什么要说啊。”"},{"op":"image","layer":1,"image":"i13939"},{"op":"text","speaker":"静久","text":"“因为有时候可能不是冲着拥抱来的，而是冲着奶子来的，对吧？”"},{"op":"text","speaker":"羽依里","text":"“冲着奶子……？”"},{"op":"text","speaker":"羽依里","text":"“如果是冲着奶子来抱的话。”"},{"op":"text","speaker":"羽依里","text":"“虽然抱住很害羞……但是可以接受？”"},{"op":"image","layer":1,"image":"i13820"},{"op":"text","speaker":"静久","text":"“如果是这样的话，也就情有可原了呢。”"},{"op":"text","speaker":"羽依里","text":"“这标准也太奇怪了。”"},{"op":"image","layer":257,"image":"i14470"},{"op":"text","speaker":"紬","text":"“羽依里先生。”"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"image","layer":257,"image":"i14473"},{"op":"text","speaker":"紬","text":"“你要习惯。”"},{"op":"image","layer":257,"image":"i14461"},{"op":"text","speaker":"紬","text":"“和静久在一起，就是奶子天堂呢。”"},{"op":"image","layer":1,"image":"i13927"},{"op":"text","speaker":"静久","text":"“是啊，真是奶子天堂呢。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i4"},{"op":"set","variable":6714,"value":4},{"op":"image","layer":1,"image":"i13852"},{"op":"text","speaker":"静久","text":"“那我先走了。”"},{"op":"image","layer":1,"image":"i13779"},{"op":"text","speaker":"静久","text":"“再见，羽依里，紬。”"},{"op":"image","layer":257,"image":"i14508"},{"op":"text","speaker":"紬","text":"“拜拜！”"},{"op":"text","speaker":"羽依里","text":"“回头见。”"},{"op":"text","speaker":"羽依里","text":"“那我们也回去吧。”"},{"op":"image","layer":257,"image":"i14381"},{"op":"text","speaker":"紬","text":"“好的呢。”"},{"op":"text","speaker":"","text":"我和紬也都各回各家了。"},{"op":"set","variable":426,"value":1},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"return"},{"op":"end"}]