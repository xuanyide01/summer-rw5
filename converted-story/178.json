[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i31"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"声音","text":"“呀吼～”"},{"op":"text","speaker":"声音","text":"“羽依里。”"},{"op":"text","speaker":"羽依里","text":"“哎。”"},{"op":"text","speaker":"","text":"莫名熟络的声音使我回过头。"},{"op":"image","layer":1,"image":"i11306"},{"op":"text","speaker":"","text":"映入眼帘的是一个长发随风飘动，慢步走来的身影。"},{"op":"text","speaker":"","text":"久岛鸥……"},{"op":"text","speaker":"","text":"咦？"},{"op":"text","speaker":"","text":"今天也拖着个大大的行李箱。"},{"op":"image","layer":1,"image":"i11243"},{"op":"text","speaker":"鸥","text":"“哟。”"},{"op":"text","speaker":"羽依里","text":"“哟。”"},{"op":"text","speaker":"羽依里","text":"“今天要回去吗。”"},{"op":"image","layer":1,"image":"i11252"},{"op":"text","speaker":"鸥","text":"“哎，不回去啊。”"},{"op":"image","layer":1,"image":"i11259"},{"op":"text","speaker":"鸥","text":"“为什么这么问。”"},{"op":"text","speaker":"羽依里","text":"“因为你拖着一个行李箱啊。”"},{"op":"image","layer":1,"image":"i11240"},{"op":"text","speaker":"鸥","text":"“我一直都会拖着它的。”"},{"op":"text","speaker":"羽依里","text":"“为什么呢。”"},{"op":"text","speaker":"羽依里","text":"“不会觉得重吗？”"},{"op":"image","layer":1,"image":"i11245"},{"op":"text","speaker":"鸥","text":"“不重哦。”"},{"op":"text","speaker":"羽依里","text":"“那里面到底装了什么啊。”"},{"op":"text","speaker":"","text":"要随时带在身边，又只能放在行李箱里的东西……"},{"op":"text","speaker":"","text":"是什么呢？"},{"op":"image","layer":1,"image":"i11288"},{"op":"text","speaker":"鸥","text":"“各种东西。”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i219"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15269"},{"op":"text","speaker":"","text":"咚咚，我试着轻轻敲打。"},{"op":"text","speaker":"","text":"响起了轻快的回音。"},{"op":"text","speaker":"","text":"里面说不定没装多少东西。"},{"op":"text","speaker":"羽依里","text":"“各种东西是指？”"},{"op":"text","speaker":"谜之声音","text":"“就是各种东西啦。”"},{"op":"text","speaker":"","text":"箱子中传来了低沉的声音。"},{"op":"text","speaker":"羽依里","text":"“!؟”"},{"op":"text","speaker":"","text":"我不禁往后一退。"},{"op":"text","speaker":"羽依里","text":"“里，里面装了什么……？”"},{"op":"text","speaker":"谜之声音","text":"“秘密哦～”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"咚咚，我试着敲打箱子。"},{"op":"text","speaker":"","text":"这下没有反应了。"},{"op":"text","speaker":"","text":"不，总感觉在微微颤动。"},{"op":"text","speaker":"","text":"里面是生物吗？"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"image","layer":0,"image":"i31"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":257,"image":"i11307"},{"op":"text","speaker":"羽依里","text":"“我说，这个行李箱里面装了什么？”"},{"op":"image","layer":257,"image":"i11311"},{"op":"text","speaker":"鸥","text":"“唔，这个嘛。”"},{"op":"image","layer":257,"image":"i11314"},{"op":"text","speaker":"鸥","text":"“过来过来。悄悄说给你听。”"},{"op":"text","speaker":"羽依里","text":"“哎。”"},{"op":"text","speaker":"羽依里","text":"“什么嘛。煞有其事的。”"},{"op":"image","layer":257,"image":"i11241"},{"op":"text","speaker":"鸥","text":"“里面啊……”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"image","layer":257,"image":"i11250"},{"op":"text","speaker":"鸥","text":"“装的是……”"},{"op":"text","speaker":"羽依里","text":"“啊。”"},{"op":"image","layer":257,"image":"i11276"},{"op":"text","speaker":"鸥","text":"“就不告诉你！”"},{"op":"image","layer":257,"image":"i11272"},{"op":"text","speaker":"鸥","text":"“锵。”"},{"op":"text","speaker":"羽依里","text":"“不爽。”"},{"op":"image","layer":257,"image":"i11265"},{"op":"text","speaker":"鸥","text":"“别不爽啦。”"},{"op":"text","speaker":"","text":"真是个难搞的家伙。"},{"op":"image","layer":257,"image":"i11259"},{"op":"text","speaker":"羽依里","text":"“告辞。虽然弄不懂内情，总之你加油。”"},{"op":"image","layer":257,"image":"i11252"},{"op":"text","speaker":"鸥","text":"“哎，你要回去啦。”"},{"op":"text","speaker":"羽依里","text":"“我也有自己的事情要做。”"},{"op":"image","layer":257,"image":"i11259"},{"op":"text","speaker":"鸥","text":"“什么事情？”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“……闲逛。”"},{"op":"image","layer":257,"image":"i11286"},{"op":"text","speaker":"鸥","text":"“啊哈。那不就是没事吗。”"},{"op":"text","speaker":"羽依里","text":"“那你自己都在做什么呢。”"},{"op":"text","speaker":"羽依里","text":"“观光吗？”"},{"op":"image","layer":257,"image":"i11344"},{"op":"text","speaker":"鸥","text":"“嗯，差不多吧。”"},{"op":"image","layer":257,"image":"i11342"},{"op":"text","speaker":"鸥","text":"“我以前来过这座岛。这次是久违地重游。”"},{"op":"text","speaker":"羽依里","text":"“是吗。”"},{"op":"text","speaker":"羽依里","text":"“以前是多久之前？”"},{"op":"image","layer":257,"image":"i11357"},{"op":"text","speaker":"鸥","text":"“很久远了。”"},{"op":"text","speaker":"羽依里","text":"“所以有多久远。”"},{"op":"image","layer":257,"image":"i11345"},{"op":"text","speaker":"鸥","text":"“我还和这个行李箱差不多大的时候。”"},{"op":"text","speaker":"羽依里","text":"“嘿。”"},{"op":"text","speaker":"","text":"那确实是‘很久远’了啊。小学时代了吧。"},{"op":"text","speaker":"羽依里","text":"“那应该感觉很怀念吧。”"},{"op":"image","layer":257,"image":"i11344"},{"op":"text","speaker":"鸥","text":"“非常怀念。”"},{"op":"text","speaker":"羽依里","text":"“我也不知道为什么，总觉得对这座岛很怀念。”"},{"op":"image","layer":257,"image":"i11301"},{"op":"text","speaker":"鸥","text":"“不是因为你来过的缘故吗。”"},{"op":"text","speaker":"羽依里","text":"“不，我没来过。”"},{"op":"image","layer":257,"image":"i11299"},{"op":"text","speaker":"鸥","text":"“说不定只是你不记得了？”"},{"op":"text","speaker":"羽依里","text":"“不记得了？”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"会是这样吗？"},{"op":"text","speaker":"","text":"毕竟外婆家在岛上，难道真的有被带来过，只是我不记得了？"},{"op":"text","speaker":"羽依里","text":"“嗯，算了……可能真的是在我记事之前来过。”"},{"op":"text","speaker":"","text":"那种事情有可能吗？"},{"op":"text","speaker":"羽依里","text":"“应该还是没来过的。”"},{"op":"text","speaker":"","text":"如果来过，老妈至少会跟我提一下吧。"},{"op":"image","layer":1,"image":"i11307"},{"op":"text","speaker":"鸥","text":"“是吗？”"},{"op":"text","speaker":"羽依里","text":"“我家本来就是不怎么去旅游的。”"},{"op":"text","speaker":"羽依里","text":"“父母都上班，特别是老爸的工作不怎么能请假。”"},{"op":"text","speaker":"","text":"小时候当然不会明白这些情况。"},{"op":"text","speaker":"","text":"好像还羡慕过能去旅行好几天的朋友。"},{"op":"image","layer":1,"image":"i11240"},{"op":"text","speaker":"鸥","text":"“嗯――”"},{"op":"image","layer":1,"image":"i11261"},{"op":"text","speaker":"鸥","text":"“那你小时候，暑假是怎么过的？”"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"text","speaker":"羽依里","text":"“暑假啊。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i158"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"我眯起眼睛看着阳光。"},{"op":"text","speaker":"","text":"仿佛透过阳光，能看见当时的光景。"},{"op":"text","speaker":"羽依里","text":"“是怎么度过的呢。”"},{"op":"text","speaker":"羽依里","text":"“去公园……和朋友一起玩耍。”"},{"op":"text","speaker":"羽依里","text":"“以及学习。”"},{"op":"text","speaker":"羽依里","text":"“偶尔被父母带去一次当天来回的旅行。”"},{"op":"text","speaker":"羽依里","text":"“具体我也记不清了。”"},{"op":"text","speaker":"羽依里","text":"“挺普通的。”"},{"op":"image","layer":0,"image":"i31"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11245"},{"op":"text","speaker":"鸥","text":"“是吗。”"},{"op":"text","speaker":"羽依里","text":"“你以前，住在这座岛上过吗？”"},{"op":"text","speaker":"羽依里","text":"“那应该会有熟人吧。”"},{"op":"image","layer":1,"image":"i11240"},{"op":"text","speaker":"鸥","text":"“不是。并不算是住。”"},{"op":"image","layer":1,"image":"i11261"},{"op":"text","speaker":"鸥","text":"“我只是夏天逗留在这里。并没有在这里定居上学。”"},{"op":"text","speaker":"羽依里","text":"“逗留是指……”"},{"op":"image","layer":1,"image":"i11361"},{"op":"text","speaker":"鸥","text":"“暑假的时候，这里曾经举办过一个全国小朋友都能参加的夏令营活动。”"},{"op":"image","layer":1,"image":"i11363"},{"op":"text","speaker":"鸥","text":"“可以说是夏天的合宿吧。”"},{"op":"image","layer":1,"image":"i11361"},{"op":"text","speaker":"鸥","text":"“我有参加那个活动。”"},{"op":"text","speaker":"羽依里","text":"“哦。”"},{"op":"text","speaker":"羽依里","text":"“于是，追寻当时的记忆来到了这里啊。”"},{"op":"image","layer":1,"image":"i11364"},{"op":"text","speaker":"鸥","text":"“差不多吧。”"},{"op":"image","layer":1,"image":"i11240"},{"op":"text","speaker":"鸥","text":"“你是为什么而来呢。”"},{"op":"text","speaker":"羽依里","text":"“我？”"},{"op":"text","speaker":"","text":"该怎么说呢。"},{"op":"image","layer":1,"image":"i11275"},{"op":"text","speaker":"鸥","text":"“我来猜猜看吧。”"},{"op":"text","speaker":"羽依里","text":"“哦？”"},{"op":"image","layer":1,"image":"i11289"},{"op":"text","speaker":"鸥","text":"“……我猜猜。”"},{"op":"image","layer":1,"image":"i11287"},{"op":"text","speaker":"鸥","text":"“探险。”"},{"op":"text","speaker":"羽依里","text":"“……不对。”"},{"op":"image","layer":1,"image":"i11291"},{"op":"text","speaker":"鸥","text":"“咦，不对啊？”"},{"op":"text","speaker":"羽依里","text":"“这么小的岛，探哪门子险啊。”"},{"op":"image","layer":1,"image":"i11245"},{"op":"text","speaker":"鸥","text":"“哼哼哼。”"},{"op":"image","layer":1,"image":"i11275"},{"op":"text","speaker":"鸥","text":"“那可说不定啊。”"},{"op":"image","layer":1,"image":"i11307"},{"op":"text","speaker":"鸥","text":"“来。”"},{"op":"text","speaker":"羽依里","text":"“？”"},{"op":"image","layer":1,"image":"i11310"},{"op":"text","speaker":"鸥","text":"“过来，这边。”"},{"op":"text","speaker":"","text":"搞什么啊。"},{"op":"text","speaker":"羽依里","text":"“要去哪里啊。”"},{"op":"image","layer":1,"image":"i11313"},{"op":"text","speaker":"鸥","text":"“都说了，要去探险呀。”"},{"op":"text","speaker":"羽依里","text":"“什么。”"},{"op":"image","layer":1,"image":"i11338"},{"op":"text","speaker":"鸥","text":"“快来快来。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"去探险吗؟؟"},{"op":"text","speaker":"","text":"总之，跟着鸥走吧。"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i18"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“泳池？”"},{"op":"text","speaker":"羽依里","text":"“要游泳吗。”"},{"op":"image","layer":1,"image":"i11307"},{"op":"text","speaker":"鸥","text":"“不是。这边哦。”"},{"op":"text","speaker":"","text":"鸥说完，便爬起了泳池周边的铁丝网。"},{"op":"text","speaker":"","text":"爬上去后，顺势将手搭上了邻接校舍的屋檐。"},{"op":"image","layer":1,"image":"i11336"},{"op":"text","speaker":"鸥","text":"“嘿咻。”"},{"op":"text","speaker":"羽依里","text":"“喂喂，你做什么……”"},{"op":"text","speaker":"","text":"话音未落，她已经爬上了屋顶。"},{"op":"image","layer":7,"image":"i11239"},{"op":"text","speaker":"鸥","text":"“行李箱给我。”"},{"op":"text","speaker":"羽依里","text":"“你要带上这玩意吗。”"},{"op":"image","layer":7,"image":"i11260"},{"op":"text","speaker":"鸥","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“当心点啊。”"},{"op":"text","speaker":"","text":"我嘿咻一声，举起行李箱递给屋顶上的鸥。"},{"op":"text","speaker":"","text":"行李箱比想象中要轻。"},{"op":"image","layer":7,"image":"i11244"},{"op":"text","speaker":"鸥","text":"“谢谢。”"},{"op":"image","layer":7,"image":"i11239"},{"op":"text","speaker":"鸥","text":"“羽依里也过来啊。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"搞不清楚她到底要做什么……"},{"op":"text","speaker":"","text":"但女孩子都这么轻易爬上去了，作为男生可不能退缩。"},{"op":"text","speaker":"","text":"我学着鸥的样子爬上铁丝网，来到校舍的屋顶上。"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i158"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":7,"image":"i11306"},{"op":"text","speaker":"鸥","text":"“爬上来了呢。”"},{"op":"text","speaker":"羽依里","text":"“结构上有缺陷啊。这种构造，小孩子会乱爬的。”"},{"op":"image","layer":7,"image":"i11313"},{"op":"text","speaker":"鸥","text":"“哦，很聪明嘛。”"},{"op":"text","speaker":"羽依里","text":"“？”"},{"op":"image","layer":7,"image":"i11335"},{"op":"text","speaker":"鸥","text":"“好了，接下来是这边哦。”"},{"op":"text","speaker":"羽依里","text":"“喂。”"},{"op":"text","speaker":"","text":"在小学的天台……应该说是屋顶上拖着行李箱行走。"},{"op":"text","speaker":"","text":"这也太超现实了。"},{"op":"text","speaker":"羽依里","text":"“等一下啊。”"},{"op":"text","speaker":"羽依里","text":"“你这样很危险的。”"},{"op":"image","layer":7,"image":"i11310"},{"op":"text","speaker":"鸥","text":"“没事没事。”"},{"op":"image","layer":7,"image":"i11306"},{"op":"text","speaker":"鸥","text":"“这边这边。”"},{"op":"text","speaker":"羽依里","text":"“这是要去哪里啊？”"},{"op":"image","layer":7,"image":"i11335"},{"op":"text","speaker":"鸥","text":"“马上就到了。”"},{"op":"image","layer":7,"image":"i11338"},{"op":"text","speaker":"鸥","text":"“这里，这里面。”"},{"op":"text","speaker":"","text":"鸥打开一扇突出屋顶的窗户。"},{"op":"text","speaker":"","text":"弯下腰，钻了进去。"},{"op":"text","speaker":"羽依里","text":"“喂，别擅自进去啊。”"},{"op":"image","layer":7,"image":"i11310"},{"op":"text","speaker":"鸥","text":"“没关系没关系。”"},{"op":"image","layer":7,"image":"i11335"},{"op":"text","speaker":"鸥","text":"“到啦～”"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“这里是……”"},{"op":"text","speaker":"","text":"大概就是那种阁楼储物间的感觉。"},{"op":"text","speaker":"","text":"进去的瞬间，一股独特的味道就扑面而来。"},{"op":"text","speaker":"","text":"该怎么说呢，像是灰尘和湿气……各种物品长年堆积所散发出的气味。"},{"op":"text","speaker":"","text":"这味道并不让人讨厌。"},{"op":"text","speaker":"","text":"暗沉沉的房间里，堆放着地球仪、实验器材……还有旧字典之类的东西。"},{"op":"text","speaker":"","text":"这些老旧物品就静静地陈列在柜子上。"},{"op":"text","speaker":"","text":"这里不像镜子阿姨整理的仓库，或许因为是小学的储物间，看上去存在着一定的统一感。"},{"op":"text","speaker":"","text":"咳咳。好多灰尘。"},{"op":"text","speaker":"","text":"但是，积了这么多灰，就证明了宝物放在这里没有被人动过。"},{"op":"text","speaker":"","text":"为了寻找目标，鸥钻进了柜子里面。"},{"op":"image","layer":7,"image":"i11335"},{"op":"text","speaker":"鸥","text":"“啊……”"},{"op":"image","layer":7,"image":"i11338"},{"op":"text","speaker":"鸥","text":"“找到了！”"},{"op":"text","speaker":"羽依里","text":"“？”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i1224"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“太好了。”"},{"op":"text","speaker":"鸥","text":"“还在这里呢。”"},{"op":"text","speaker":"","text":"鸥从柜子深处拖出了某样东西。"},{"op":"text","speaker":"羽依里","text":"“旗子？”"},{"op":"text","speaker":"鸥","text":"“是的。”"},{"op":"text","speaker":"羽依里","text":"“为什么这里会有旗子？”"},{"op":"text","speaker":"鸥","text":"“10年前，我藏在这里的。”"},{"op":"text","speaker":"鸥","text":"“就这么保存到了现在。”"},{"op":"text","speaker":"羽依里","text":"“这是什么旗子？”"},{"op":"image","layer":0,"image":"i1225"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“……”"},{"op":"text","speaker":"鸥","text":"“那是和朋友一起……”"},{"op":"text","speaker":"鸥","text":"“在夏天结束的时候……我们爬上了这里。”"},{"op":"text","speaker":"鸥","text":"“然后，立起了这面旗子。”"},{"op":"text","speaker":"鸥","text":"“将来重逢的时候，就可以当做标记啦。”"},{"op":"text","speaker":"羽依里","text":"“喔～”"},{"op":"text","speaker":"羽依里","text":"“这画的是猫吗？”"},{"op":"image","layer":0,"image":"i1223"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“胡子猫。”"},{"op":"text","speaker":"鸥","text":"“是我们队伍的旗子哦。”"},{"op":"text","speaker":"羽依里","text":"“队伍？”"},{"op":"text","speaker":"羽依里","text":"“类似于关系好的小团体吗？”"},{"op":"text","speaker":"鸥","text":"“是啊。”"},{"op":"text","speaker":"鸥","text":"“那个夏天，我们还带着这面旗子去探险了。”"},{"op":"text","speaker":"羽依里","text":"“哦～”"},{"op":"text","speaker":"鸥","text":"“然后和这面旗子一起，埋下了一些秘密。”"},{"op":"image","layer":2304,"image":"i1226"},{"op":"text","speaker":"","text":"她说完之后交到我手上的，是一本古老的笔记本。"},{"op":"text","speaker":"","text":"我打开看了看。"},{"op":"image","layer":2304,"image":"i1227"},{"op":"text","speaker":"羽依里","text":"“…………”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“岛上的秘密？”"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":1792},{"op":"clear","layer":2304},{"op":"text","speaker":"羽依里","text":"“你说的秘密，就藏在这个箱子里吗？”"},{"op":"text","speaker":"鸥","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“这箱子锁上了啊。”"},{"op":"text","speaker":"","text":"上面挂着四把小锁。"},{"op":"text","speaker":"羽依里","text":"“砸开吧。”"},{"op":"clear","layer":512},{"op":"image","layer":0,"image":"i1228"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“喂喂。”"},{"op":"text","speaker":"羽依里","text":"“什么啊。发现了什么。什么秘密。”"},{"op":"text","speaker":"鸥","text":"“……”"},{"op":"text","speaker":"","text":"鸥没有回答。"},{"op":"image","layer":0,"image":"i1225"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“抱歉。”"},{"op":"text","speaker":"","text":"算了，都说是秘密了。仅限伙伴之间的。"},{"op":"image","layer":0,"image":"i1223"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"她转向大海。"},{"op":"text","speaker":"鸥","text":"“快看。”"},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"text","speaker":"鸥","text":"“这里风景很好哦。”"},{"op":"image","layer":2050,"image":"i187"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i187"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i363"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"从飘窗眺望外面的景色。"},{"op":"text","speaker":"","text":"因为小学本身就在略高的地方吧。"},{"op":"text","speaker":"","text":"从屋顶上能将大海的景色尽收眼底。"},{"op":"text","speaker":"","text":"感觉还挺新鲜的。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"我就是从这片大海的彼岸来的啊。"},{"op":"image","layer":7,"image":"i11239"},{"op":"text","speaker":"鸥","text":"“……”"},{"op":"text","speaker":"","text":"鸥略显怀念地一直望着大海。"},{"op":"text","speaker":"","text":"可能正沉浸于曾经的某些回忆中吧。"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i31"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i11243"},{"op":"text","speaker":"鸥","text":"“谢谢你今天陪我。”"},{"op":"text","speaker":"羽依里","text":"“啊。”"},{"op":"image","layer":1,"image":"i11381"},{"op":"text","speaker":"鸥","text":"“过得开心吗？”"},{"op":"text","speaker":"羽依里","text":"“唉。”"},{"op":"text","speaker":"羽依里","text":"“……挺开心，吧。”"},{"op":"text","speaker":"","text":"虽然这点小事，要说是探险有点勉强了。"},{"op":"text","speaker":"","text":"但登上泳池的铁丝网所抵达的小学阁楼里，似乎有着鸥小时候所藏下的宝物。"},{"op":"text","speaker":"","text":"这样的展开，果然会让人雀跃不已。"},{"op":"text","speaker":"","text":"的确，算得上是探险。"},{"op":"image","layer":1,"image":"i11288"},{"op":"text","speaker":"鸥","text":"“哼哼。”"},{"op":"text","speaker":"","text":"我感到意外地看着鸥。"},{"op":"text","speaker":"","text":"原本还以为她是哪户人家的大小姐呢。"},{"op":"text","speaker":"","text":"可她更像是，怎么说呢……一个奇怪的家伙。"},{"op":"image","layer":1,"image":"i11261"},{"op":"text","speaker":"鸥","text":"“羽依里！”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"image","layer":1,"image":"i11243"},{"op":"text","speaker":"鸥","text":"“有时间的话再一起玩吧。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"image","layer":1,"image":"i11261"},{"op":"text","speaker":"鸥","text":"“下次再玩吧。”"},{"op":"image","layer":1,"image":"i11295"},{"op":"text","speaker":"鸥","text":"“我会带你去更厉害的终极探险啊。”"},{"op":"text","speaker":"羽依里","text":"“……终极探险？”"},{"op":"image","layer":1,"image":"i11273"},{"op":"text","speaker":"鸥","text":"“嗯。”"},{"op":"text","speaker":"","text":"说着，朝我比了一个剪刀手。"},{"op":"text","speaker":"","text":"充满活力的家伙。"},{"op":"text","speaker":"","text":"即使知道只是玩耍而已，但这种说法多少还是引起了我的兴趣。"},{"op":"text","speaker":"","text":"说不定，男生到死都无法抵抗探险这个词。"},{"op":"image","layer":1,"image":"i11311"},{"op":"text","speaker":"鸥","text":"“那下次见。”"},{"op":"text","speaker":"羽依里","text":"“再见了。”"},{"op":"text","speaker":"","text":"鸥嘎啦嘎啦地拖着行李箱离开了。"},{"op":"image","layer":7,"image":"i11328"},{"op":"text","speaker":"鸥","text":"“……”"},{"op":"text","speaker":"","text":"很快停下了脚步。"},{"op":"text","speaker":"","text":"略带抱歉地回过了头。"},{"op":"image","layer":1,"image":"i11323"},{"op":"text","speaker":"鸥","text":"“累了。”"},{"op":"text","speaker":"羽依里","text":"“什么。”"},{"op":"image","layer":1,"image":"i11329"},{"op":"text","speaker":"鸥","text":"“拖着箱子回去，看来有些困难了。”"},{"op":"text","speaker":"羽依里","text":"“那就把箱子丢一边回家如何。”"},{"op":"image","layer":1,"image":"i11316"},{"op":"text","speaker":"鸥","text":"“那可不行。”"},{"op":"image","layer":1,"image":"i11301"},{"op":"text","speaker":"鸥","text":"“所以说。”"},{"op":"text","speaker":"","text":"她轻轻地坐到了行李箱上。"},{"op":"text","speaker":"","text":"央求似的晃动着双脚。"},{"op":"image","layer":1,"image":"i11314"},{"op":"text","speaker":"鸥","text":"“帮我推。”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i1051"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"鸥","text":"“麻烦你了。”"},{"op":"text","speaker":"羽依里","text":"“真心麻烦啊。”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"羽依里","text":"“话说回来。”"},{"op":"text","speaker":"羽依里","text":"“要去哪里呢。”"},{"op":"text","speaker":"鸥","text":"“港口。”"},{"op":"text","speaker":"羽依里","text":"“港口？”"},{"op":"text","speaker":"羽依里","text":"“你要坐船吗？”"},{"op":"text","speaker":"鸥","text":"“差不多。”"},{"op":"text","speaker":"羽依里","text":"“哦，你不住在岛上啊？”"},{"op":"text","speaker":"鸥","text":"“嗯……像是住在岛上，又像不住在岛上。”"},{"op":"text","speaker":"羽依里","text":"“什么嘛，模棱两可的。”"},{"op":"text","speaker":"鸥","text":"“唉嘿嘿，有什么不好。”"},{"op":"text","speaker":"羽依里","text":"“我是无所谓。”"},{"op":"text","speaker":"","text":"包括行李箱里装的东西，这家伙简直浑身是谜。"},{"op":"text","speaker":"鸥","text":"“你住在哪里？”"},{"op":"text","speaker":"羽依里","text":"“那片住宅区中的加藤家。”"},{"op":"text","speaker":"鸥","text":"“哦……那是反方向呢。”"},{"op":"text","speaker":"鸥","text":"“麻烦你了啊。”"},{"op":"text","speaker":"羽依里","text":"“事到如今还说什么麻烦不麻烦的。”"},{"op":"text","speaker":"羽依里","text":"“反正我很闲就是了。”"},{"op":"text","speaker":"鸥","text":"“呵呵，好体贴啊。”"},{"op":"text","speaker":"羽依里","text":"“并没有。”"},{"op":"text","speaker":"鸥","text":"“羽依里is好孩子。”"},{"op":"text","speaker":"羽依里","text":"“什、什么嘛。”"},{"op":"text","speaker":"鸥","text":"“呵呵。”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i1"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"我把行李箱送到港口后，鸥道完谢人便不见了。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"return"},{"op":"end"}]