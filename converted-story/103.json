[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i48"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"来到了海边。"},{"op":"text","speaker":"","text":"虽然现在是绝佳的海水浴时节，但几乎没有人在游泳。"},{"op":"text","speaker":"","text":"阳光最为强烈的这个时间点，本地人不是有事的话不太会选择出门。"},{"op":"text","speaker":"","text":"话是这么说，但总会有例外。"},{"op":"image","layer":0,"image":"i236"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i10152"},{"op":"text","speaker":"苍","text":"“……嘶……嘶……”"},{"op":"text","speaker":"羽依里","text":"“这人还真是哪儿都能睡呢。”"},{"op":"text","speaker":"","text":"苍在树荫下，吹着凉爽的海风，一脸平和地打着瞌睡。"},{"op":"text","speaker":"稻荷","text":"“……唔……唔……”"},{"op":"text","speaker":"","text":"就没见派上过用场的看门狗……准确说，看门狐也在一起。"},{"op":"text","speaker":"","text":"这也代表着这座岛就是如此的安全吧。"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i48"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":7,"image":"i10167"},{"op":"text","speaker":"苍","text":"“……嗯……嗯嗯……”"},{"op":"text","speaker":"","text":"翻了个身后，苍的身体开始微微颤抖。"},{"op":"text","speaker":"","text":"是因为一直躲在树荫里的身体有些冷了吗，她抱紧了身边的稻荷。"},{"op":"image","layer":7,"image":"i10191"},{"op":"text","speaker":"苍","text":"“嗯……呼……呼……”"},{"op":"text","speaker":"","text":"在得到温暖的东西后，心满意足的苍又传出了熟睡的呼吸声。"},{"op":"text","speaker":"稻荷","text":"“……嘭…啾……唔……”"},{"op":"text","speaker":"","text":"另一边，被紧紧抱住的稻荷则露出了痛苦的表情。"},{"op":"text","speaker":"羽依里","text":"“唔……”"},{"op":"choice","variable":6001,"items":[{"text":"为她盖上衣服","value":0,"condition":1},{"text":"轻轻抱住她","value":1,"condition":1}]},{"op":"text","speaker":"羽依里","text":"“先得把稻荷解救出来才行。”"},{"op":"text","speaker":"","text":"强行从苍的手中把稻荷解救了出来。"},{"op":"image","layer":0,"image":"i48"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i10670"},{"op":"text","speaker":"稻荷","text":"“……啾…嘭？”"},{"op":"text","speaker":"羽依里","text":"“你差点就被闷死了哦。”"},{"op":"image","layer":1,"image":"i10679"},{"op":"text","speaker":"稻荷","text":"“嘭……？”"},{"op":"image","layer":7,"image":"i10150"},{"op":"text","speaker":"苍","text":"“嗯～……嗯嗯―……”"},{"op":"text","speaker":"","text":"苍为了寻找温暖伸出手摸索着。"},{"op":"if","truth":false,"target":123,"value":["==",["v",6001],0]},{"op":"text","speaker":"羽依里","text":"“那就换这个给你。”"},{"op":"text","speaker":"","text":"我把自己穿着的T恤脱了下来，盖在了苍的身上。"},{"op":"image","layer":0,"image":"i236"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i10152"},{"op":"text","speaker":"苍","text":"“嗯……呼……呼……”"},{"op":"text","speaker":"","text":"苍的脸上浮现出满足的表情……"},{"op":"image","layer":1,"image":"i10277"},{"op":"text","speaker":"苍","text":"“呼～……嗅嗅…呼～…嗅嗅……”"},{"op":"text","speaker":"","text":"开始闻我T恤的味道了。"},{"op":"text","speaker":"","text":"突然感觉莫名的害羞。"},{"op":"image","layer":1,"image":"i10296"},{"op":"text","speaker":"苍","text":"“……哎嘿……”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i48"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“能让你满意真是太好了。”"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":1},{"op":"image","layer":0,"image":"i49"},{"op":"set","variable":6714,"value":4},{"op":"image","layer":7,"image":"i10150"},{"op":"text","speaker":"苍","text":"“……嘶……嘶……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“那什么，这也实在是太能睡了吧？”"},{"op":"text","speaker":"","text":"苍就这样抱着我的T恤，一直睡着。"},{"op":"text","speaker":"","text":"就算怎么扯也不肯放开，也没有要醒过来的迹象。"},{"op":"image","layer":7,"image":"i10634"},{"op":"text","speaker":"稻荷","text":"“嘭……”"},{"op":"text","speaker":"","text":"像是在同情我一般，稻荷在旁边叫唤。"},{"op":"image","layer":7,"image":"i10150"},{"op":"text","speaker":"苍","text":"“……嗯……嗯呜呜……呼啊……”"},{"op":"image","layer":1,"image":"i10168"},{"op":"text","speaker":"苍","text":"“阿嚏！”"},{"op":"text","speaker":"","text":"打了个喷嚏后，苍终于醒了过来。"},{"op":"image","layer":1,"image":"i10189"},{"op":"text","speaker":"苍","text":"“……唔～……睡得有些着凉了呢……”"},{"op":"text","speaker":"羽依里","text":"“……早安。”"},{"op":"image","layer":1,"image":"i10179"},{"op":"text","speaker":"苍","text":"“啊……嗯，早…安安安安安安安安!؟”"},{"op":"image","layer":1,"image":"i10135"},{"op":"text","speaker":"苍","text":"“为什么你会在这里啊!؟”"},{"op":"text","speaker":"羽依里","text":"“碰巧路过而已。”"},{"op":"image","layer":1,"image":"i10146"},{"op":"text","speaker":"苍","text":"“碰巧……”"},{"op":"image","layer":1,"image":"i10161"},{"op":"text","speaker":"苍","text":"“哈!؟你不会趁我睡着，做了什么奇怪的――”"},{"op":"text","speaker":"羽依里","text":"“才不会。”"},{"op":"image","layer":1,"image":"i10205"},{"op":"text","speaker":"苍","text":"“为什么؟!”"},{"op":"text","speaker":"羽依里","text":"“不……难道说我还是做点什么比较好…？”"},{"op":"image","layer":1,"image":"i10249"},{"op":"text","speaker":"苍","text":"“怎、怎么可能啊！”"},{"op":"image","layer":1,"image":"i10290"},{"op":"text","speaker":"苍","text":"“只是，一点都没的话……”"},{"op":"image","layer":1,"image":"i10308"},{"op":"text","speaker":"苍","text":"“岂不是挺对不起我的……？”"},{"op":"text","speaker":"羽依里","text":"“那下次就做点什么吧。”"},{"op":"image","layer":1,"image":"i10162"},{"op":"text","speaker":"苍","text":"“禽兽！”"},{"op":"text","speaker":"羽依里","text":"“我说你啊……还真是够麻烦的……”"},{"op":"image","layer":1,"image":"i10118"},{"op":"text","speaker":"苍","text":"“咦？这是什么？”"},{"op":"image","layer":1,"image":"i10146"},{"op":"text","speaker":"苍","text":"“被子……不对，衣服？”"},{"op":"text","speaker":"羽依里","text":"“既然你都醒过来了，也该还我了。”"},{"op":"image","layer":1,"image":"i10160"},{"op":"text","speaker":"苍","text":"“唉，啊……嗯……”"},{"op":"image","layer":1,"image":"i10182"},{"op":"text","speaker":"苍","text":"“是你给我盖上的吗？”"},{"op":"text","speaker":"羽依里","text":"“谁让你看上去很冷呢。”"},{"op":"image","layer":1,"image":"i10308"},{"op":"text","speaker":"苍","text":"“……是、是吗。”"},{"op":"goto","target":231},{"op":"text","speaker":"羽依里","text":"“那就换我来……”"},{"op":"image","layer":0,"image":"i236"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i10152"},{"op":"text","speaker":"","text":"我在苍身边躺了下来，轻轻抱住了她。"},{"op":"text","speaker":"苍","text":"“嗯……呼……呼……”"},{"op":"text","speaker":"","text":"感受到我的体温后又传出了熟睡的呼吸声。"},{"op":"text","speaker":"羽依里","text":"（呜哇――呜哇哇――――！超软的――――！）"},{"op":"text","speaker":"羽依里","text":"（有股好闻的味道――――――！）"},{"op":"text","speaker":"羽依里","text":"（还有，苍的身体凉凉的也好舒服啊――――！）"},{"op":"text","speaker":"","text":"虽说是我主动这么做的，不过现在兴奋指数已经完全爆表了。"},{"op":"text","speaker":"羽依里","text":"（一开始只是想开个玩笑而已，这可不妙啊……！）"},{"op":"text","speaker":"羽依里","text":"（具体哪里不妙就不明言了，但真的很不妙啊……!!）"},{"op":"image","layer":1,"image":"i10128"},{"op":"text","speaker":"苍","text":"“……嗯……嗯呜……？”"},{"op":"text","speaker":"羽依里","text":"“啊……”"},{"op":"image","layer":1,"image":"i10131"},{"op":"text","speaker":"","text":"果然还是感觉到了不对劲，苍微微睁开了眼睛。"},{"op":"image","layer":1,"image":"i10293"},{"op":"text","speaker":"苍","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"用还没睡醒的双眼直直地看着我。"},{"op":"text","speaker":"","text":"好了，叫吧，我做好心理准备了……"},{"op":"text","speaker":"","text":"撑住啊，我的鼓膜！"},{"op":"image","layer":1,"image":"i10296"},{"op":"text","speaker":"苍","text":"“……哎嘿。”"},{"op":"text","speaker":"羽依里","text":"“哎嘿？”"},{"op":"image","layer":1,"image":"i10277"},{"op":"text","speaker":"","text":"还在想苍刚才是不是笑了，结果她忽然主动抱了过来。"},{"op":"text","speaker":"","text":"然后继续闭上了眼睛。"},{"op":"image","layer":1,"image":"i10296"},{"op":"text","speaker":"苍","text":"“唉嘿嘿～……呼……呼……”"},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"text","speaker":"","text":"这出乎预料的行动，让我一下子愣住了。"},{"op":"text","speaker":"羽依里","text":"（唉？这是怎么了？到底是什么情况？）"},{"op":"text","speaker":"羽依里","text":"（脸太近了啊，还有各种地方都很柔软。）"},{"op":"text","speaker":"羽依里","text":"（稻荷，帮我……！）"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i48"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"稻荷","text":"“……嘶……嘶……”"},{"op":"text","speaker":"羽依里","text":"（这小畜生……！）"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":1},{"op":"image","layer":0,"image":"i49"},{"op":"set","variable":6714,"value":4},{"op":"image","layer":7,"image":"i10150"},{"op":"text","speaker":"苍","text":"“……嘶……嘶……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"就这样，到底过去了多久呢。"},{"op":"image","layer":1,"image":"i10128"},{"op":"text","speaker":"苍","text":"“……嗯……嗯呜呜……呼哇啊……啊呼……”"},{"op":"image","layer":1,"image":"i10131"},{"op":"text","speaker":"苍","text":"“……嗯？”"},{"op":"text","speaker":"羽依里","text":"“……早安。”"},{"op":"image","layer":1,"image":"i10119"},{"op":"text","speaker":"苍","text":"“………”"},{"op":"image","layer":515,"image":"i18121"},{"op":"image","layer":1,"image":"i10180"},{"op":"text","speaker":"苍","text":" “呜哇哇哇哇哇啊啊啊啊啊――――――!؟” "},{"op":"clear","layer":515},{"op":"clear","layer":768},{"op":"clear","layer":1024},{"op":"image","layer":1,"image":"i10177"},{"op":"text","speaker":"苍","text":"“为……为为为为什么!؟为什么……”"},{"op":"image","layer":1,"image":"i10302"},{"op":"text","speaker":"苍","text":"“我、我第一胎想要女儿――――！”"},{"op":"text","speaker":"羽依里","text":"“冷静点。”"},{"op":"image","layer":515,"image":"i18121"},{"op":"image","layer":1,"image":"i10180"},{"op":"text","speaker":"苍","text":" “怎么可能冷静啊――――――！” "},{"op":"clear","layer":515},{"op":"clear","layer":768},{"op":"clear","layer":1024},{"op":"image","layer":1,"image":"i10247"},{"op":"text","speaker":"苍","text":"“在、在我睡着的时候……！被、被你单方面地…!؟”"},{"op":"image","layer":1,"image":"i10302"},{"op":"text","speaker":"苍","text":"“虽然我不讨厌硬来……但这里可是在外面…！”"},{"op":"text","speaker":"羽依里","text":"“都说了，冷静点。”"},{"op":"text","speaker":"羽依里","text":"“先整理下情况吧。”"},{"op":"text","speaker":"羽依里","text":"“我现在可一动都动不了……”"},{"op":"text","speaker":"羽依里","text":"“被你单方面地抱得死死的啊，现在。”"},{"op":"image","layer":1,"image":"i10299"},{"op":"text","speaker":"苍","text":"“唉？”"},{"op":"image","layer":1,"image":"i10177"},{"op":"text","speaker":"苍","text":"“………”"},{"op":"text","speaker":"","text":"被我这么一说后，苍终于发现自己在做的事情了。"},{"op":"text","speaker":"","text":"没错，是她死死地抱住了我。"},{"op":"text","speaker":"","text":"我这是被当成抱枕了吧。"},{"op":"image","layer":1,"image":"i10291"},{"op":"text","speaker":"苍","text":"“啊……呜…呜～……”"},{"op":"image","layer":515,"image":"i18121"},{"op":"image","layer":1,"image":"i10139"},{"op":"text","speaker":"苍","text":" “呜哇啊啊啊啊啊啊啊啊啊啊啊啊――――――！” "},{"op":"image","layer":1,"image":"i10302"},{"op":"text","speaker":"苍","text":" “放手啊啊啊啊啊啊啊啊啊啊啊――――――！” "},{"op":"text","speaker":"羽依里","text":" “该放手的是你啊啊啊啊啊――――――！” "},{"op":"clear","layer":515},{"op":"clear","layer":768},{"op":"clear","layer":1024},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i49"},{"op":"set","variable":6714,"value":4},{"op":"image","layer":1,"image":"i10302"},{"op":"text","speaker":"","text":"让我去和谁说理啊。"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"text","speaker":"","text":"苍在深呼吸之后，总算是稍微冷静一些了。"},{"op":"text","speaker":"","text":"与此同时受了凉的身体也开始颤抖起来。"},{"op":"text","speaker":"羽依里","text":"“吹着海风睡觉不是很危险吗？”"},{"op":"image","layer":1,"image":"i10189"},{"op":"text","speaker":"苍","text":"“比想象的还要冷呢。”"},{"op":"text","speaker":"羽依里","text":"“你可是女孩子，不能着凉的啊。”"},{"op":"image","layer":1,"image":"i10290"},{"op":"text","speaker":"苍","text":"“经常有人这么说，到底是为什么呢？”"},{"op":"text","speaker":"羽依里","text":"“身体着凉后，血液循环也会变慢。”"},{"op":"text","speaker":"羽依里","text":"“据说很多女生都容易体寒。”"},{"op":"text","speaker":"羽依里","text":"“结果可能就会造成内脏功能低下，好像还会造成不孕。”"},{"op":"image","layer":1,"image":"i10176"},{"op":"text","speaker":"苍","text":"“呜哇……好可怕。”"},{"op":"text","speaker":"羽依里","text":"“嗯，很吓人吧。”"},{"op":"image","layer":1,"image":"i10121"},{"op":"text","speaker":"苍","text":"“是知道这种知识的你很吓人。”"},{"op":"text","speaker":"羽依里","text":"“单纯的知识而已！我是游泳部的当然要知道！”"},{"op":"image","layer":1,"image":"i10168"},{"op":"text","speaker":"苍","text":"“城市里的游泳部好可怕。”"},{"op":"text","speaker":"羽依里","text":"“训练后的身体护养是必须的啊！”"},{"op":"text","speaker":"羽依里","text":"“还是说想要在什么都不知道的情况下，等到将来后悔？”"},{"op":"image","layer":1,"image":"i10243"},{"op":"text","speaker":"苍","text":"“那可不好。”"},{"op":"image","layer":1,"image":"i10274"},{"op":"text","speaker":"苍","text":"“毕竟我也想要生个健康的小宝宝。”"},{"op":"text","speaker":"羽依里","text":"“嗯，是吧。”"},{"op":"image","layer":1,"image":"i10162"},{"op":"text","speaker":"苍","text":"“……喂！我可不是说要生你的小宝宝哦!؟”"},{"op":"text","speaker":"羽依里","text":"“不，这，我也完全没有这个意思就是了。”"},{"op":"text","speaker":"","text":"幸好，这家伙是在这个与世无争的小岛上长大的。"},{"op":"text","speaker":"","text":"真是绝对不能去城市的类型呢，嗯。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"return"},{"op":"end"}]