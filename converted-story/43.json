[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“早。”"},{"op":"if","truth":false,"target":13,"value":["==",["v",93],1]},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“早。”"},{"op":"text","speaker":"","text":"羽未今早也依旧在准备着早餐。"},{"op":"text","speaker":"羽依里","text":"“感觉每天早上都麻烦你，感觉挺过意不去啊。”"},{"op":"image","layer":7,"image":"i15320"},{"op":"text","speaker":"羽未","text":"“一开始不就是这样分配的嘛。”"},{"op":"goto","target":31},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“……真恶心。”"},{"op":"text","speaker":"羽依里","text":"“早上第一句话就是这个，还真是扎心。”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“因为你老是发出怪声嘛。”"},{"op":"text","speaker":"羽依里","text":"“说明已经舒服得让我忘记了理性。”"},{"op":"image","layer":1,"image":"i15363"},{"op":"text","speaker":"羽未","text":"“还趴着睡着了。”"},{"op":"text","speaker":"羽依里","text":"“抱歉抱歉。”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“到最后，还是没去洗澡嘛。”"},{"op":"text","speaker":"羽依里","text":"“哎，一天不洗而已，问题不大啦。”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“……龌龊……”"},{"op":"text","speaker":"羽依里","text":"“呃，那句话…有点伤人了……”"},{"op":"text","speaker":"羽依里","text":"“对了，羽未在做什么呢。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“准备做早饭。”"},{"op":"text","speaker":"羽依里","text":"“噢。”"},{"op":"text","speaker":"羽依里","text":"“要不让我试试吧。”"},{"op":"image","layer":1,"image":"i15378"},{"op":"text","speaker":"羽未","text":"“唉唉？”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“太让人不放心了。”"},{"op":"text","speaker":"羽依里","text":"“放心好啦。”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“你会做饭吗？”"},{"op":"text","speaker":"羽依里","text":"“完全不会。”"},{"op":"image","layer":1,"image":"i15487"},{"op":"text","speaker":"羽未","text":"“唉唉？”"},{"op":"text","speaker":"羽依里","text":"“但我会尽力一试啦。”"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i65"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"……开始做饭。"},{"op":"image","layer":7,"image":"i15371"},{"op":"text","speaker":"羽未","text":"“……”"},{"op":"text","speaker":"","text":"总感觉到一股视线。"},{"op":"text","speaker":"羽依里","text":"“怎么一直盯着我的屁股看。”"},{"op":"image","layer":1,"image":"i15465"},{"op":"text","speaker":"羽未","text":"“我在看你做饭。”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“感觉你的手法很不靠谱。”"},{"op":"text","speaker":"羽依里","text":"“哦，这样啊。因为感觉到一股视线直奔屁股附近而来。”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“没办法，身高决定的。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“……”"},{"op":"text","speaker":"","text":"还是感觉到了猛烈的视线。"},{"op":"text","speaker":"","text":"一想到被人看着，屁股就痒痒的。"},{"op":"text","speaker":"","text":"扭捏。"},{"op":"image","layer":1,"image":"i15504"},{"op":"text","speaker":"羽未","text":"“!؟”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"扭捏。"},{"op":"image","layer":1,"image":"i15378"},{"op":"text","speaker":"羽未","text":"“!؟”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“……好恶心！”"},{"op":"image","layer":1,"image":"i15331"},{"op":"text","speaker":"羽未","text":"“为什么时不时的要莫名其妙地可爱地扭屁股？”"},{"op":"text","speaker":"羽依里","text":"“一想到被人看着就安稳不下来嘛。”"},{"op":"image","layer":1,"image":"i15465"},{"op":"text","speaker":"羽未","text":"“就算是这样，也不用‘扭扭捏捏’的吧！”"},{"op":"text","speaker":"羽依里","text":"“这我也不知道。”"},{"op":"text","speaker":"羽依里","text":"“毕竟我看不见自己的屁股。”"},{"op":"text","speaker":"羽依里","text":"“总之你别老盯着看了。”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“行吧……”"},{"op":"image","layer":1,"image":"i15363"},{"op":"text","speaker":"羽未","text":"“我去看会电视。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"羽依里","text":"“好了，做好了。”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“哇……”"},{"op":"image","layer":1,"image":"i15363"},{"op":"text","speaker":"羽未","text":"“好黑……”"},{"op":"image","layer":1,"image":"i15366"},{"op":"text","speaker":"羽未","text":"“已经不知道该怎么形容了……”"},{"op":"image","layer":1,"image":"i15360"},{"op":"text","speaker":"羽未","text":"“反正就是黑……”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“请你向食材谢罪。”"},{"op":"text","speaker":"羽依里","text":"“呼，至少我的努力还是值得赞赏的吧。”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“一副事有所成的表情就让人来气……”"},{"op":"text","speaker":"羽依里","text":"“试过之后才知道。”"},{"op":"text","speaker":"羽依里","text":"“原来做早餐这么难啊。”"},{"op":"text","speaker":"羽依里","text":"“味道暂且不提，但是每天都坚持为我做早餐的羽未真的很厉害。”"},{"op":"image","layer":1,"image":"i15499"},{"op":"text","speaker":"羽未","text":"“哪有，你过奖啦。”"},{"op":"image","layer":1,"image":"i15496"},{"op":"text","speaker":"羽未","text":"“…………”"},{"op":"image","layer":1,"image":"i15502"},{"op":"text","speaker":"羽未","text":"“你说什么？”"},{"op":"image","layer":1,"image":"i15461"},{"op":"text","speaker":"羽未","text":"“味道暂且不提……？”"},{"op":"text","speaker":"羽依里","text":"“啊……”"},{"op":"image","layer":1,"image":"i15502"},{"op":"text","speaker":"羽未","text":"“你是说炒饭不好吃吗？”"},{"op":"text","speaker":"羽依里","text":"“呃……”"},{"op":"text","speaker":"羽依里","text":"“比较有个性。”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“这是夸奖吗？”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"text","speaker":"羽未","text":"“既然如此。”"},{"op":"image","layer":1,"image":"i15401"},{"op":"text","speaker":"羽未","text":"“好吧。”"},{"op":"text","speaker":"羽依里","text":"“呼……”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“反正这个看起来也吃不得。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“就混进炒饭里吧。”"},{"op":"text","speaker":"羽依里","text":"“你说什么？”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“没事的。”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“炒饭是万能的。”"},{"op":"text","speaker":"羽依里","text":"“等一下，你太过相信炒饭的可能性了！”"},{"op":"image","layer":1,"image":"i15401"},{"op":"text","speaker":"羽未","text":"“炒饭是万能的。”"},{"op":"text","speaker":"羽依里","text":"“不要把这句话当成标志性台词！”"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"text","speaker":"","text":"结果……"},{"op":"image","layer":0,"image":"i1059"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"她对炒饭是万能的这句话深信不疑。"},{"op":"text","speaker":"","text":"把我做的炒饭当作“食材”，开始制作新的炒饭。"},{"op":"text","speaker":"","text":"但是……"},{"op":"image","layer":0,"image":"i1044"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"可能是在烹饪的过程中，发现了这句话并不成立吧。"},{"op":"text","speaker":"","text":"她一脸不满地挥动着平底锅……"},{"op":"image","layer":2050,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":2050},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"摆放在餐桌上的灰色炒饭。"},{"op":"text","speaker":"","text":"苦死人了。"},{"op":"text","speaker":"","text":"用麦茶中和掉口中的苦味。"},{"op":"image","layer":7,"image":"i15931"},{"op":"text","speaker":"羽未","text":"“我走啦。”"},{"op":"text","speaker":"","text":"羽未活泼的声音从玄关传来。"},{"op":"text","speaker":"","text":"她平时到底是去哪里玩呢？"},{"op":"return"},{"op":"end"}]