[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i129"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13843"},{"op":"text","speaker":"静久","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"紬今天也迟到了。"},{"op":"image","layer":1,"image":"i13804"},{"op":"text","speaker":"静久","text":"“这样连续好几天迟到，是不是紬身体不舒服啊。”"},{"op":"text","speaker":"羽依里","text":"“有这个可能。”"},{"op":"image","layer":1,"image":"i13807"},{"op":"text","speaker":"静久","text":"“紬是不是真的只吃棉花糖？”"},{"op":"text","speaker":"羽依里","text":"“不啊，怎么可能？”"},{"op":"text","speaker":"羽依里","text":"“她说过，会吃很多章鱼的。”"},{"op":"image","layer":1,"image":"i13737"},{"op":"text","speaker":"静久","text":"“也是呢。”"},{"op":"image","layer":1,"image":"i13743"},{"op":"text","speaker":"静久","text":"“我们上次留宿灯塔时，紬也有正常的吃东西，应该有好好的摄取营养。”"},{"op":"text","speaker":"羽依里","text":"“是啊。”"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"text","speaker":"羽依里","text":"“而且她昨天说是睡过头了。”"},{"op":"image","layer":1,"image":"i13764"},{"op":"text","speaker":"静久","text":"“也是。”"},{"op":"image","layer":1,"image":"i13767"},{"op":"text","speaker":"静久","text":"“如果今天也是睡过头了的话，说不定紬会不吃早饭出门。”"},{"op":"text","speaker":"羽依里","text":"“有这个可能。”"},{"op":"image","layer":1,"image":"i13816"},{"op":"text","speaker":"静久","text":"“海港那里有食堂，我去那里买些简单的东西来。”"},{"op":"text","speaker":"羽依里","text":"“啊，嗯。”"},{"op":"text","speaker":"羽依里","text":"“那我就在这里等着，防止紬来了却不见我们人影吧。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i507"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"真安静。"},{"op":"text","speaker":"","text":"灯塔前真是安静……安静得让人感到孤寂。"},{"op":"text","speaker":"","text":"总觉得，会不自觉的就那么想。"},{"op":"image","layer":0,"image":"i129"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"话说回来，今天紬也会在灯塔里面吗？"},{"op":"text","speaker":"","text":"稍微进去看看吧。"},{"op":"text","speaker":"","text":"门……"},{"op":"text","speaker":"羽依里","text":"“没锁。”"},{"op":"text","speaker":"","text":"作为女孩子也太不小心了。"},{"op":"text","speaker":"","text":"过会我得提醒一下她。"},{"op":"text","speaker":"羽依里","text":"“紬――”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"","text":"没有回答。"},{"op":"text","speaker":"羽依里","text":"“紬――……我进来咯―？”"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i137"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“……紬。”"},{"op":"text","speaker":"","text":"里面没有人。"},{"op":"text","speaker":"","text":"今天可能是回自己家了吧。"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i129"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"总之，像往常一样在这里等着她好了。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i13740"},{"op":"text","speaker":"静久","text":"“我回来了～”"},{"op":"text","speaker":"羽依里","text":"“啊，你回来了。”"},{"op":"image","layer":1,"image":"i13737"},{"op":"text","speaker":"静久","text":"“紬呢？”"},{"op":"text","speaker":"羽依里","text":"“还没来呢。”"},{"op":"image","layer":1,"image":"i13807"},{"op":"text","speaker":"静久","text":"“哦……”"},{"op":"image","layer":7,"image":"i13742"},{"op":"text","speaker":"静久","text":"“啊……紬好像来了！”"},{"op":"text","speaker":"","text":"……唉？"},{"op":"image","layer":0,"image":"i317"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i14800"},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i14800"},{"op":"text","speaker":"紬","text":"“……早上好。”"},{"op":"image","layer":1,"image":"i14802"},{"op":"text","speaker":"紬","text":"“羽依里先生，静久……对不起。”"},{"op":"image","layer":1,"image":"i14788"},{"op":"text","speaker":"紬","text":"“昨天明明刚说过不会再迟到了。”"},{"op":"image","layer":1,"image":"i14806"},{"op":"text","speaker":"紬","text":"“明明刚说过……”"},{"op":"clear","layer":1280},{"op":"clear","layer":1536},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i129"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i14805"},{"op":"text","speaker":"","text":"紬……刚刚是从灯塔中走出来的？"},{"op":"text","speaker":"","text":"但是。"},{"op":"text","speaker":"","text":"刚才进入灯塔的时候……"},{"op":"image","layer":257,"image":"i13767"},{"op":"text","speaker":"静久","text":"“紬……”"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"静久","text":"“作为惩罚，今天你可要陪我们玩到很晚哦♪”"},{"op":"image","layer":257,"image":"i13770"},{"op":"text","speaker":"静久","text":"“对吧～乳依里。”"},{"op":"text","speaker":"","text":"你怎么了？"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":257,"image":"i13764"},{"op":"text","speaker":"静久","text":"“乳依里？”"},{"op":"text","speaker":"羽依里","text":"“啊……嗯。”"},{"op":"image","layer":1,"image":"i14749"},{"op":"text","speaker":"紬","text":"“你怎么了？”"},{"op":"text","speaker":"羽依里","text":"“紬……”"},{"op":"text","speaker":"羽依里","text":"“为什么你会从灯塔中走出来？”"},{"op":"image","layer":1,"image":"i14739"},{"op":"text","speaker":"紬","text":"“……唉？”"},{"op":"text","speaker":"羽依里","text":"“刚刚我明明进入灯塔了……却没有找到你啊？”"},{"op":"image","layer":1,"image":"i14796"},{"op":"text","speaker":"紬","text":"“……啊。”"},{"op":"image","layer":7,"image":"i13806"},{"op":"text","speaker":"静久","text":"“……？”"},{"op":"image","layer":0,"image":"i317"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":1,"image":"i14788"},{"op":"text","speaker":"紬","text":"“那是因为……”"},{"op":"image","layer":1,"image":"i14802"},{"op":"text","speaker":"紬","text":"“我想……吓你一跳……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"image","layer":1,"image":"i14808"},{"op":"text","speaker":"紬","text":"“所以就藏起来了……”"},{"op":"image","layer":1,"image":"i14788"},{"op":"text","speaker":"紬","text":"“想给你个……惊喜。”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i129"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i14787"},{"op":"text","speaker":"","text":"确实灯塔中有可以藏身的场所。"},{"op":"text","speaker":"","text":"而且我也没有认真在里面找过。"},{"op":"text","speaker":"","text":"但是……"},{"op":"text","speaker":"羽依里","text":"“我还在想是不是你的身体不舒服。”"},{"op":"text","speaker":"羽依里","text":"“很担心你啊……”"},{"op":"image","layer":1,"image":"i14804"},{"op":"text","speaker":"紬","text":"“那个……这个……”"},{"op":"text","speaker":"羽依里","text":"“………”"},{"op":"image","layer":1,"image":"i14753"},{"op":"text","speaker":"紬","text":"“对，对不起……”"},{"op":"image","layer":257,"image":"i13820"},{"op":"text","speaker":"静久","text":"“好了，那么既然紬已经反省过了。”"},{"op":"image","layer":257,"image":"i13816"},{"op":"text","speaker":"静久","text":"“早饭还没吃过吧？那我们一起去吃早饭吧。”"},{"op":"image","layer":1,"image":"i14787"},{"op":"text","speaker":"紬","text":"“好的……”"},{"op":"image","layer":257,"image":"i13846"},{"op":"text","speaker":"静久","text":"“我稍微去准备一下。”"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"羽依里","text":"“――”"},{"op":"text","speaker":"","text":"不行！"},{"op":"text","speaker":"","text":"你在做什么，鹰原羽依里！"},{"op":"text","speaker":"","text":"这根本就是乱发脾气。"},{"op":"text","speaker":"","text":"我们的夏天，应该更加――"},{"op":"text","speaker":"羽依里","text":"“对了，紬。”"},{"op":"image","layer":1,"image":"i14749"},{"op":"text","speaker":"紬","text":"“啊，嗯。”"},{"op":"text","speaker":"羽依里","text":"“明天如果再迟到的话，那么作为惩罚――”"},{"op":"text","speaker":"羽依里","text":"“你要尽全力朝着我们微笑着打招呼。”"},{"op":"image","layer":1,"image":"i14739"},{"op":"text","speaker":"紬","text":"“姆啾？”"},{"op":"text","speaker":"羽依里","text":"“这对于不善变通太过认真的紬来说，也许稍微有点难。”"},{"op":"text","speaker":"羽依里","text":"“不过迟到真的没什么大不了的。”"},{"op":"image","layer":1,"image":"i14744"},{"op":"text","speaker":"紬","text":"“但是。”"},{"op":"text","speaker":"羽依里","text":"“比起那个，我更不想看到紬这样失落的表情。”"},{"op":"image","layer":1,"image":"i14753"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“刚刚如果是‘给你惊喜！’这样的语气，可能我会笑出来。”"},{"op":"text","speaker":"羽依里","text":"“我还有静久，只要看到你在笑，就没什么事不能包容的……我们都希望你保持笑容。”"},{"op":"image","layer":1,"image":"i14749"},{"op":"text","speaker":"紬","text":"“羽依里先生……”"},{"op":"image","layer":1,"image":"i14784"},{"op":"text","speaker":"紬","text":"“我知道了。”"},{"op":"image","layer":1,"image":"i14781"},{"op":"text","speaker":"紬","text":"“唉嘿嘿……”"},{"op":"image","layer":0,"image":"i317"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":1,"image":"i14782"},{"op":"image","layer":1,"image":"i14743"},{"op":"text","speaker":"紬","text":"“是这样的吗？”"},{"op":"text","speaker":"","text":"……唔。"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i129"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i14742"},{"op":"text","speaker":"羽依里","text":"“好可爱啊……紬小姐。”"},{"op":"text","speaker":"","text":"不小心就使用敬语了。"},{"op":"image","layer":1,"image":"i14804"},{"op":"text","speaker":"紬","text":"“……谢，谢谢夸奖。”"},{"op":"image","layer":1,"image":"i14787"},{"op":"text","speaker":"紬","text":"“羽依里先生刚刚也是，怎么说好呢……”"},{"op":"image","layer":1,"image":"i14830"},{"op":"text","speaker":"紬","text":"“太帅了……”"},{"op":"text","speaker":"羽依里","text":"“谢……谢谢。”"},{"op":"image","layer":1,"image":"i14807"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“现在这种气氛……”"},{"op":"text","speaker":"羽依里","text":"“下一步是不是就该抱在一起了？”"},{"op":"image","layer":1,"image":"i14796"},{"op":"text","speaker":"紬","text":"“那个……！”"},{"op":"image","layer":1,"image":"i14753"},{"op":"text","speaker":"紬","text":"“难度高的没边了！”"},{"op":"text","speaker":"羽依里","text":"“也，也是呢。”"},{"op":"image","layer":1,"image":"i14757"},{"op":"text","speaker":"紬","text":"“静久在场的话，倒也不是完全做不到。”"},{"op":"text","speaker":"羽依里","text":"“这么说……确实。”"},{"op":"image","layer":1,"image":"i14758"},{"op":"text","speaker":"紬","text":"“对吧对吧。”"},{"op":"image","layer":1,"image":"i14787"},{"op":"text","speaker":"紬","text":"“但是……”"},{"op":"image","layer":1,"image":"i14807"},{"op":"text","speaker":"紬","text":"“……要不要牵个手？”"},{"op":"text","speaker":"羽依里","text":"“也，也好啊。”"},{"op":"image","layer":1,"image":"i14810"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"好软啊。"},{"op":"text","speaker":"","text":"这小手摸起来就知道是个可爱的女孩子。"},{"op":"text","speaker":"羽依里","text":"“好了，我们去给静久帮忙吧？”"},{"op":"image","layer":1,"image":"i14785"},{"op":"text","speaker":"紬","text":"“唉嘿嘿，一起去一起去。”"},{"op":"image","layer":1,"image":"i14782"},{"op":"text","speaker":"紬","text":"“～～～♪”"},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i184"},{"op":"image","layer":0,"image":"i137"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13843"},{"op":"image","layer":257,"image":"i14810"},{"op":"text","speaker":"静久","text":"“啊啦……？”"},{"op":"image","layer":1,"image":"i13846"},{"op":"text","speaker":"静久","text":"“嘿嘿，不愧是乳依里呢～♪”"},{"op":"text","speaker":"羽依里","text":"“还，还好吧。”"},{"op":"image","layer":257,"image":"i14785"},{"op":"text","speaker":"紬","text":"“静久。”"},{"op":"image","layer":1,"image":"i13816"},{"op":"text","speaker":"静久","text":"“怎么啦～？”"},{"op":"image","layer":257,"image":"i14810"},{"op":"text","speaker":"紬","text":"“我刚刚和羽依里先生聊了很多。”"},{"op":"image","layer":257,"image":"i14812"},{"op":"text","speaker":"紬","text":"“最后的结论是，我要一直保持着微笑。”"},{"op":"image","layer":257,"image":"i14785"},{"op":"text","speaker":"紬","text":"“所以今后也要拜托静久了。”"},{"op":"text","speaker":"羽依里","text":"“说明是不是太粗糙了？”"},{"op":"image","layer":1,"image":"i13840"},{"op":"text","speaker":"静久","text":"“……”"},{"op":"image","layer":1,"image":"i13846"},{"op":"text","speaker":"静久","text":"“明白了♪”"},{"op":"text","speaker":"","text":"这竟然都能懂。"},{"op":"text","speaker":"羽依里","text":"“这恐怖的理解力。”"},{"op":"image","layer":1,"image":"i13807"},{"op":"text","speaker":"静久","text":"“刚刚是不是说了巨大的奶子之力？”"},{"op":"text","speaker":"羽依里","text":"“没说过。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"clear","layer":1539},{"op":"image","layer":1,"image":"i14818"},{"op":"text","speaker":"紬","text":"“～～～♪”"},{"op":"text","speaker":"","text":"今天也要创作歌词。"},{"op":"text","speaker":"","text":"……在夏天结束之前。"},{"op":"text","speaker":"","text":"希望在紬回去之前能把歌词写出来。"},{"op":"text","speaker":"","text":"大家肯定都是这么想的。"},{"op":"image","layer":1,"image":"i14760"},{"op":"text","speaker":"紬","text":"“话说两位，明天的准备，都做好了吗？”"},{"op":"image","layer":257,"image":"i13804"},{"op":"text","speaker":"静久","text":"“明天？”"},{"op":"image","layer":1,"image":"i14799"},{"op":"text","speaker":"紬","text":"“唉……？”"},{"op":"image","layer":257,"image":"i13832"},{"op":"text","speaker":"静久","text":"“除了要去岛外购物，还有什么需要做的吗？”"},{"op":"image","layer":1,"image":"i14805"},{"op":"text","speaker":"紬","text":"“姆啾！静久你真是坏心眼！”"},{"op":"image","layer":1,"image":"i14840"},{"op":"text","speaker":"紬","text":"“要吞千根针的哦。”"},{"op":"text","speaker":"羽依里","text":"“那样的话，明天静久是不是就不能去我们一起出岛玩了？”"},{"op":"image","layer":1,"image":"i14825"},{"op":"text","speaker":"紬","text":"“……”"},{"op":"image","layer":1,"image":"i14753"},{"op":"text","speaker":"紬","text":"“那我就忍耐一下好了。”"},{"op":"image","layer":257,"image":"i13846"},{"op":"text","speaker":"静久","text":"“呵呵♪ 一起好好玩个够吧。”"},{"op":"image","layer":1,"image":"i14742"},{"op":"text","speaker":"紬","text":"“好啊♪”"},{"op":"image","layer":1,"image":"i14823"},{"op":"text","speaker":"紬","text":"“真是非常期待明天呢，不知道晚上会不会兴奋的睡不着觉。”"},{"op":"image","layer":1,"image":"i14827"},{"op":"text","speaker":"紬","text":"“如果明天睡过头了，那就非常抱歉了。”"},{"op":"image","layer":257,"image":"i13816"},{"op":"text","speaker":"静久","text":"“那样的话，我会去叫醒你的。”"},{"op":"image","layer":1,"image":"i14776"},{"op":"text","speaker":"紬","text":"“一定要不留情面地把我喊起来！”"},{"op":"image","layer":257,"image":"i13849"},{"op":"text","speaker":"静久","text":"“嗯，我不会手下留情的♪”"},{"op":"text","speaker":"","text":"她到底打算做什么。"},{"op":"text","speaker":"羽依里","text":"“但是最好还是不要睡过头，所以紬也早点睡吧。”"},{"op":"image","layer":257,"image":"i13816"},{"op":"text","speaker":"静久","text":"“就定在中午在灯塔集合，然后出到岛外再吃午饭如何？”"},{"op":"set","variable":26027,"value":1},{"op":"text","speaker":"","text":"我和紬都表示同意。"},{"op":"image","layer":1,"image":"i14809"},{"op":"text","speaker":"紬","text":"“两位，明天就请多关照了。”"},{"op":"image","layer":257,"image":"i13740"},{"op":"text","speaker":"静久","text":"“嗯。”"},{"op":"text","speaker":"羽依里","text":"“好啊。”"},{"op":"text","speaker":"","text":"结果这天我们三人也一起玩到了夜晚。"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]