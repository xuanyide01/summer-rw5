[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i18"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"今天，我们在野美希的邀请下，来到小学校参加制作灯笼的活动。"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“你们来了啊。”"},{"op":"image","layer":257,"image":"i10118"},{"op":"text","speaker":"苍","text":"“咦，你们也要参加这个啊？”"},{"op":"text","speaker":"羽依里","text":"“是野美希叫我们来的。”"},{"op":"image","layer":513,"image":"i12162"},{"op":"text","speaker":"良一","text":"“噢，我的徒弟们都来了啊。”"},{"op":"image","layer":1,"image":"i12740"},{"op":"text","speaker":"识","text":"“船长，今天就请多多关照了。”"},{"op":"image","layer":257,"image":"i15038"},{"op":"text","speaker":"天善","text":"“船长？”"},{"op":"text","speaker":"羽依里","text":"“前几天我们请他指导了一下如何开船。”"},{"op":"image","layer":257,"image":"i15011"},{"op":"text","speaker":"天善","text":"“原来如此，所以才叫船长啊。”"},{"op":"image","layer":257,"image":"i15032"},{"op":"text","speaker":"天善","text":"“等等。”"},{"op":"image","layer":257,"image":"i15044"},{"op":"text","speaker":"天善","text":"“如果我教鹰原你们打乒乓球的话，该让你们怎么称呼我呢……”"},{"op":"image","layer":257,"image":"i15014"},{"op":"text","speaker":"天善","text":"“主将？或者部长？”"},{"op":"text","speaker":"羽依里","text":"“不，我不会找你来教我们的，放心吧。”"},{"op":"text","speaker":"岛上的男孩A","text":"“啊！是鬼姐姐！”"},{"op":"text","speaker":"岛上的男孩B","text":"“还有那个没人要的大哥哥！”"},{"op":"text","speaker":"岛上的男孩C","text":"“你现在有人要了吗？”"},{"op":"text","speaker":"羽依里","text":"“你们到底要让我哭出来多少次啊……”"},{"op":"text","speaker":"岛上的男孩A","text":"“大哥哥你们也要做灯笼吗？”"},{"op":"text","speaker":"羽依里","text":"“是啊，机会难得，正好可以学一下怎么做。”"},{"op":"text","speaker":"小学女教师","text":"“好～那么大家来开始制作灯笼吧。”"},{"op":"text","speaker":"小学女教师","text":"“今天，少年团的哥哥姐姐们也过来帮忙了。”"},{"op":"text","speaker":"小学女教师","text":"“有不懂的地方，可以尽管问他们哦。”"},{"op":"text","speaker":"孩子们","text":"“好～！”"},{"op":"image","layer":1,"image":"i12743"},{"op":"text","speaker":"识","text":"“好！”"},{"op":"text","speaker":"羽依里","text":"“真有活力啊……”"},{"op":"image","layer":257,"image":"i11696"},{"op":"text","speaker":"美希","text":"“第一次参加的人到我这边来。”"},{"op":"text","speaker":"羽依里","text":"“那我和识就去野美希那边了。”"},{"op":"image","layer":1,"image":"i12789"},{"op":"text","speaker":"识","text":"“总觉得有点紧张呢。”"},{"op":"image","layer":257,"image":"i11696"},{"op":"text","speaker":"美希","text":"“放心，也不会很难的。”"},{"op":"image","layer":257,"image":"i11728"},{"op":"text","speaker":"美希","text":"“我也会一起做的，你们照着我的样子做就行了。”"},{"op":"text","speaker":"羽依里","text":"“明白了。”"},{"op":"image","layer":1,"image":"i12740"},{"op":"text","speaker":"识","text":"“那就请多指教了，野美希老师。”"},{"op":"image","layer":257,"image":"i11731"},{"op":"text","speaker":"美希","text":"“野美希老师吗……”"},{"op":"image","layer":257,"image":"i11750"},{"op":"text","speaker":"美希","text":"“虽然前辈这个称呼很难割舍……嗯，这样叫也不坏。”"},{"op":"text","speaker":"","text":"和貌似很高兴的野美希还有孩子们一起，开始做起了灯笼。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i422"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“说起来，白羽没来吗？”"},{"op":"image","layer":7,"image":"i11727"},{"op":"text","speaker":"美希","text":"“因为她要担任夏鸟之仪的巫女。”"},{"op":"text","speaker":"羽依里","text":"“巫女？”"},{"op":"image","layer":7,"image":"i11714"},{"op":"text","speaker":"美希","text":"“类似于仪式的主人公。”"},{"op":"image","layer":7,"image":"i11727"},{"op":"text","speaker":"美希","text":"“现在正忙着做准备呢。”"},{"op":"text","speaker":"羽依里","text":"“这样啊……”"},{"op":"image","layer":0,"image":"i18"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i12165"},{"op":"text","speaker":"良一","text":"“做好啦～！”"},{"op":"image","layer":1,"image":"i12162"},{"op":"text","speaker":"良一","text":"“喂喂，快来看看我的杰作！”"},{"op":"text","speaker":"羽依里","text":"“……和我们做的有什么区别？”"},{"op":"image","layer":1,"image":"i12159"},{"op":"text","speaker":"良一","text":"“所以说你们城里人就是不行啊。”"},{"op":"text","speaker":"羽依里","text":"“这跟城里人有什么关系？”"},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“我这个可是别有玄机的哦。”"},{"op":"text","speaker":"羽依里","text":"“什么玄机？”"},{"op":"image","layer":1,"image":"i12162"},{"op":"text","speaker":"良一","text":"“过上一段时间，灯笼的纸就会脱落！”"},{"op":"text","speaker":"羽依里","text":"“脱落？”"},{"op":"image","layer":1,"image":"i12165"},{"op":"text","speaker":"良一","text":"“其名为，脱衣灯笼！”"},{"op":"text","speaker":"","text":"啪！"},{"op":"image","layer":1,"image":"i12220"},{"op":"text","speaker":"良一","text":"“呜哇――！灯笼被打穿了――！”"},{"op":"image","layer":257,"image":"i11789"},{"op":"text","speaker":"美希","text":"“你这家伙，把祭奠先祖的仪式当成什么了？”"},{"op":"image","layer":257,"image":"i11792"},{"op":"text","speaker":"美希","text":"“马上给我重做。”"},{"op":"image","layer":1,"image":"i12153"},{"op":"text","speaker":"良一","text":"“就算有这种灯笼，又有什么所谓啊！”"},{"op":"image","layer":257,"image":"i11789"},{"op":"text","speaker":"美希","text":"“当天会来很多游客的。”"},{"op":"image","layer":257,"image":"i11786"},{"op":"text","speaker":"美希","text":"“我绝不允许把这种不正经的灯笼放流到海里。”"},{"op":"image","layer":1,"image":"i12150"},{"op":"text","speaker":"良一","text":"“什么叫不正经……”"},{"op":"image","layer":1,"image":"i12159"},{"op":"text","speaker":"良一","text":"“哼，这件艺术品小孩子果然欣赏不来啊。”"},{"op":"image","layer":257,"image":"i11800"},{"op":"text","speaker":"美希","text":"“嚯。”"},{"op":"text","speaker":"","text":"砰！ "},{"op":"text","speaker":"","text":"砰！"},{"op":"image","layer":1,"image":"i12220"},{"op":"text","speaker":"良一","text":"“呜啊啊!؟灯笼被打成渣渣了――！”"},{"op":"image","layer":257,"image":"i11792"},{"op":"text","speaker":"美希","text":"“艺术就是爆炸，不是吗？”"},{"op":"image","layer":257,"image":"i11786"},{"op":"text","speaker":"美希","text":"“赶紧重做。”"},{"op":"image","layer":1,"image":"i12147"},{"op":"text","speaker":"良一","text":"“呜呜……太过分了……呜呜……”"},{"op":"image","layer":513,"image":"i15011"},{"op":"text","speaker":"天善","text":"“好，我也完成了。”"},{"op":"text","speaker":"羽依里","text":"“……球拍？”"},{"op":"image","layer":513,"image":"i15014"},{"op":"text","speaker":"天善","text":"“对，球拍形状的灯笼。”"},{"op":"image","layer":513,"image":"i15011"},{"op":"text","speaker":"天善","text":"“看看这优美的造型。”"},{"op":"image","layer":513,"image":"i15041"},{"op":"text","speaker":"天善","text":"“其名为，直板――”"},{"op":"image","layer":1,"image":"i11789"},{"op":"text","speaker":"美希","text":"“驳回。”"},{"op":"text","speaker":"","text":"砰！"},{"op":"text","speaker":"","text":"咻！"},{"op":"image","layer":1,"image":"i11786"},{"op":"text","speaker":"美希","text":"“什么؟!”"},{"op":"image","layer":513,"image":"i15014"},{"op":"text","speaker":"天善","text":"“哼……我给它贴上了一层球拍胶皮。”"},{"op":"text","speaker":"羽依里","text":"“那个，能浮起来吗？”"},{"op":"image","layer":257,"image":"i10224"},{"op":"text","speaker":"苍","text":"“嗯――让我看看。”"},{"op":"text","speaker":"","text":"苍一把提起天善的灯笼，放进了游泳池。"},{"op":"image","layer":257,"image":"i10227"},{"op":"text","speaker":"","text":"扑通……"},{"op":"text","speaker":"","text":"径直就沉了下去。"},{"op":"image","layer":1,"image":"i15035"},{"op":"text","speaker":"天善","text":"“直板乒乓号――――！”"},{"op":"image","layer":257,"image":"i10330"},{"op":"text","speaker":"苍","text":"“得重做咯。”"},{"op":"image","layer":513,"image":"i12740"},{"op":"text","speaker":"识","text":"“我也做好了！”"},{"op":"image","layer":513,"image":"i12777"},{"op":"text","speaker":"识","text":"“这样如何？”"},{"op":"image","layer":1,"image":"i11728"},{"op":"text","speaker":"美希","text":"“让我看看。”"},{"op":"image","layer":257,"image":"i10241"},{"op":"text","speaker":"苍","text":"“哎呀，做得还不错嘛。”"},{"op":"image","layer":1,"image":"i11689"},{"op":"text","speaker":"美希","text":"“嗯，这个是合格的。”"},{"op":"image","layer":513,"image":"i12746"},{"op":"text","speaker":"识","text":"“嗯嘿嘿，太好了！”"},{"op":"text","speaker":"羽依里","text":"“我的这个怎么样？”"},{"op":"image","layer":1,"image":"i11731"},{"op":"image","layer":513,"image":"i12783"},{"op":"image","layer":257,"image":"i10285"},{"op":"text","speaker":"苍","text":"“嗯――唔……还行吧？”"},{"op":"image","layer":1,"image":"i11782"},{"op":"text","speaker":"美希","text":"“说不上差，但也说不上好……”"},{"op":"text","speaker":"岛上的男孩A","text":"“大哥哥，你是不是手不太巧啊？”"},{"op":"text","speaker":"岛上的男孩B","text":"“不会做手工可是在岛上混不下去的哦？”"},{"op":"text","speaker":"岛上的男孩C","text":"“追不到女孩子哦？”"},{"op":"text","speaker":"羽依里","text":"“……能浮起来就行了。”"},{"op":"text","speaker":"","text":"小孩子真是残酷……"},{"op":"image","layer":1,"image":"i12753"},{"op":"text","speaker":"识","text":"“是要把这个点着之后放到大海里吗？”"},{"op":"text","speaker":"羽依里","text":"“好像是这样。”"},{"op":"image","layer":1,"image":"i12766"},{"op":"text","speaker":"识","text":"“那肯定会很漂亮吧。”"},{"op":"text","speaker":"岛上的男孩A","text":"“鬼姐姐，你的灯笼做好了吧？”"},{"op":"image","layer":1,"image":"i12740"},{"op":"text","speaker":"识","text":"“嗯，如你所见。”"},{"op":"text","speaker":"岛上的男孩C","text":"“那我们去玩吧！”"},{"op":"image","layer":1,"image":"i12783"},{"op":"text","speaker":"岛上的男孩A","text":"“再来玩捉鬼游戏吧！”"},{"op":"text","speaker":"岛上的女孩A","text":"“等等，你们这些男生！先把东西收拾好再说啊！”"},{"op":"text","speaker":"岛上的男孩B","text":"“好烦啊，你们一起顺便收拾了不就行了。”"},{"op":"text","speaker":"岛上的女孩B","text":"“才不要呢。捉鬼游戏可太幼稚了。”"},{"op":"text","speaker":"岛上的男孩C","text":"“啊，你们肯定不知道吧。”"},{"op":"text","speaker":"岛上的男孩C","text":"“这位姐姐啊，她跑得超快的！”"},{"op":"text","speaker":"岛上的男孩A","text":"“有这位姐姐在，捉鬼游戏的境界马上就不一样了！”"},{"op":"text","speaker":"岛上的女孩C","text":"“捉鬼游戏再怎么也只是捉鬼游戏，无聊透顶。”"},{"op":"text","speaker":"岛上的男孩B","text":"“那你们也一起来玩玩看啊！”"},{"op":"text","speaker":"岛上的男孩C","text":"“要是能从这位姐姐手里逃脱，今天的收拾工作我们全包了！”"},{"op":"text","speaker":"岛上的女孩A","text":"“这可是你说的！说定了！”"},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“哦！这下有意思了啊。我也来！”"},{"op":"image","layer":257,"image":"i15011"},{"op":"text","speaker":"天善","text":"“捉鬼游戏考验的是敏捷性。”"},{"op":"image","layer":257,"image":"i15041"},{"op":"text","speaker":"天善","text":"“而且还非常适合用来训练脚法。我也参加。”"},{"op":"image","layer":1,"image":"i12165"},{"op":"text","speaker":"良一","text":"“好――那么现在开始大型捉鬼大赛！”"},{"op":"text","speaker":"孩子们","text":"“好――！"},{"op":"text","speaker":"孩子们","text":"的哦。”"},{"op":"image","layer":513,"image":"i12746"},{"op":"text","speaker":"识","text":"“喔！”"},{"op":"image","layer":513,"image":"i12743"},{"op":"text","speaker":"识","text":"“变得有趣起来了呢，羽依里！”"},{"op":"text","speaker":"羽依里","text":"“怎么变得这么声势浩大了……”"},{"op":"image","layer":769,"image":"i10215"},{"op":"text","speaker":"苍","text":"“真是群小孩子啊。”"},{"op":"image","layer":1,"image":"i11783"},{"op":"text","speaker":"美希","text":"“可不是嘛。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"clear","layer":769},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i11"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"因为人数众多，又要找一个能尽情奔跑的地方，于是我们来到了神社。"},{"op":"text","speaker":"","text":"好像每天早上的广播体操都是在这里做的。"},{"op":"text","speaker":"岛上的男孩A","text":"“大哥哥，今天要玩什么样的规则？”"},{"op":"text","speaker":"羽依里","text":"“让我想想……”"},{"op":"text","speaker":"羽依里","text":"“人这么多，要不两个人当鬼，玩‘冰鬼游戏’如何？”"},{"op":"text","speaker":"岛上的女孩A","text":"“冰鬼游戏是什么？”"},{"op":"text","speaker":"羽依里","text":"“被鬼碰到的人就要在原地冻住，不能动。”"},{"op":"text","speaker":"羽依里","text":"“要保持被碰到时的姿势，一动都不能动哦。”"},{"op":"text","speaker":"岛上的女孩B","text":"“听起来很有意思！”"},{"op":"text","speaker":"岛上的男孩A","text":"“被冻住了就要一直保持那样下去吗？”"},{"op":"text","speaker":"羽依里","text":"“不会，让其他还能动的人碰一下，被冻住的人就又可以活动了。”"},{"op":"text","speaker":"岛上的女孩C","text":"“好像蛮有意思的呢。”"},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“冰鬼游戏啊……这个要抓到所有人还挺难的。”"},{"op":"text","speaker":"","text":"说着，良一活动起了腿脚。"},{"op":"image","layer":257,"image":"i15149"},{"op":"text","speaker":"天善","text":"“呼！哈！呼！哈！”"},{"op":"text","speaker":"","text":"天善正在全力挥舞着球拍，可能也是在做准备运动。"},{"op":"text","speaker":"羽依里","text":"“你们还真是干劲十足啊……”"},{"op":"text","speaker":"","text":"真是一点都不像大人。"},{"op":"image","layer":1,"image":"i11731"},{"op":"text","speaker":"羽依里","text":"“野美希这次还是不参加吗？”"},{"op":"image","layer":1,"image":"i11777"},{"op":"text","speaker":"美希","text":"“是啊。”"},{"op":"image","layer":1,"image":"i11750"},{"op":"text","speaker":"美希","text":"“我就做裁判好了，杜绝作弊行为发生。”"},{"op":"image","layer":1,"image":"i11801"},{"op":"text","speaker":"美希","text":"“我可要用这个毫不留情地招呼作弊的人，所以大家要堂堂正正地比赛哦。”"},{"op":"text","speaker":"","text":"说着，她举起Hydro对准了孩子们。"},{"op":"text","speaker":"岛上的男孩A","text":"“糟了，野美希姐姐当裁判。”"},{"op":"text","speaker":"岛上的男孩B","text":"“这下可不能耍赖了。”"},{"op":"image","layer":257,"image":"i10226"},{"op":"text","speaker":"羽依里","text":"“苍，那你呢？”"},{"op":"image","layer":257,"image":"i10203"},{"op":"text","speaker":"苍","text":"“我？”"},{"op":"image","layer":257,"image":"i10282"},{"op":"text","speaker":"苍","text":"“倒是可以参加啦，不过要玩的话我可是会很认真的哦？”"},{"op":"text","speaker":"","text":"她在原地轻快地蹦跳了几下。"},{"op":"text","speaker":"羽依里","text":"“嗯，看了另外两个人，就知道你们有多孩子气了。”"},{"op":"image","layer":257,"image":"i10322"},{"op":"text","speaker":"苍","text":"“鬼要怎么选？用猜拳吗？”"},{"op":"text","speaker":"羽依里","text":"“不，这么多人猜拳不好出结果。”"},{"op":"text","speaker":"羽依里","text":"“识，我们来当鬼怎么样？”"},{"op":"image","layer":1,"image":"i12743"},{"op":"text","speaker":"识","text":"“正合我意！”"},{"op":"image","layer":1,"image":"i12799"},{"op":"text","speaker":"识","text":"“毕竟我就是鬼嘛！”"},{"op":"image","layer":257,"image":"i10133"},{"op":"text","speaker":"苍","text":"“啊……说起来是这么回事来着。”"},{"op":"text","speaker":"","text":"苍用温柔的眼神看着识。"},{"op":"image","layer":1,"image":"i12768"},{"op":"text","speaker":"识","text":"“呜哎……这眼神，让我久违地感到了心痛……”"},{"op":"image","layer":1,"image":"i12761"},{"op":"text","speaker":"识","text":"“羽依里，这是为什么呢……？”"},{"op":"text","speaker":"羽依里","text":"“你就认了吧。”"},{"op":"image","layer":1,"image":"i12773"},{"op":"text","speaker":"识","text":"“十分不解……”"},{"op":"image","layer":513,"image":"i11834"},{"op":"text","speaker":"美希","text":"“那么我们开始吧。”"},{"op":"image","layer":513,"image":"i11829"},{"op":"text","speaker":"美希","text":"“第一轮由羽依里和识当鬼。”"},{"op":"image","layer":513,"image":"i11826"},{"op":"text","speaker":"美希","text":"“鬼要数到十才能开始追人。”"},{"op":"image","layer":513,"image":"i11834"},{"op":"text","speaker":"美希","text":"“大家，准备好了吗？”"},{"op":"image","layer":513,"image":"i11696"},{"op":"text","speaker":"美希","text":"“好……冰鬼游戏，开始！”"},{"op":"text","speaker":"","text":"野美希一声令下，小孩子和良一他们一齐四散而逃。"},{"op":"text","speaker":"羽依里","text":"“一、二、三、四、五。”"},{"op":"image","layer":1,"image":"i12743"},{"op":"text","speaker":"识","text":"“六、七、八、九、十！”"},{"op":"text","speaker":"羽依里","text":"“好，识，我们上！”"},{"op":"image","layer":1,"image":"i12746"},{"op":"text","speaker":"识","text":"“来吧，羽依里！”"},{"op":"text","speaker":"","text":"识像往常一样，用手指在太阳穴旁比出角的样子，模仿着鬼的样子。"},{"op":"image","layer":1,"image":"i12818"},{"op":"text","speaker":"识","text":"“我是鬼哦――！”"},{"op":"text","speaker":"岛上的男孩A","text":"“哇啊！出现了！”"},{"op":"text","speaker":"岛上的女孩A","text":"“哎？哎？那是什么？”"},{"op":"text","speaker":"岛上的男孩B","text":"“鬼姐姐一上来拿出真本事了！”"},{"op":"text","speaker":"岛上的女孩B","text":"“虽然不太明白，但是好可怕！”"},{"op":"text","speaker":"岛上的男孩C","text":"“大家快逃啊！鬼来了！”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"clear","layer":513},{"op":"image","layer":0,"image":"i1707"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"识","text":"“第一个猎物就是你――！”"},{"op":"text","speaker":"","text":"首先被盯上的是苍。"},{"op":"image","layer":7,"image":"i10217"},{"op":"text","speaker":"苍","text":"“哎哎!؟好快！她怎么跑这么快!؟”"},{"op":"image","layer":0,"image":"i1708"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"识","text":"“看，碰到你啦！”"},{"op":"image","layer":7,"image":"i10220"},{"op":"text","speaker":"苍","text":"“不会吧!؟”"},{"op":"text","speaker":"","text":"被识碰到后，苍就立刻冻在了原地。"},{"op":"image","layer":0,"image":"i1711"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"识","text":"“下一个是谁――！”"},{"op":"text","speaker":"岛上的女孩A","text":"“她过来了!؟”"},{"op":"text","speaker":"识","text":"“嘿！碰到你了！”"},{"op":"image","layer":0,"image":"i1708"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"识","text":"“还有你也是！”"},{"op":"text","speaker":"岛上的女孩B","text":"“呀啊啊啊!؟”"},{"op":"text","speaker":"岛上的女孩A","text":"“太、太快了……她到底是怎么回事……”"},{"op":"text","speaker":"岛上的男孩A","text":"“我不是说过了吗！那个姐姐很厉害的！”"},{"op":"text","speaker":"岛上的男孩B","text":"“那个姐姐可是真正的鬼啊！”"},{"op":"image","layer":0,"image":"i1711"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"识","text":"“来来来！不逃的话，就要被我一个接一个冻住了哦！嗯嘿嘿嘿！”"},{"op":"text","speaker":"岛上的女孩C","text":"“真的好可怕啊！”"},{"op":"image","layer":0,"image":"i11"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“哦哦，识这家伙玩得很起劲啊。”"},{"op":"text","speaker":"羽依里","text":"“好，这下我也得……”"},{"op":"image","layer":1,"image":"i12144"},{"op":"text","speaker":"良一","text":"“哦，来了吗，羽依里！”"},{"op":"text","speaker":"羽依里","text":"“抱歉了，良一。看，我碰到你了！”"},{"op":"image","layer":1,"image":"i12211"},{"op":"text","speaker":"良一","text":"“哈！”"},{"op":"text","speaker":"","text":"我以为自己碰到了良一的衬衫，但下一瞬间，良一便留下衬衫消失不见了。"},{"op":"text","speaker":"羽依里","text":"“什么!؟”"},{"op":"image","layer":1,"image":"i12106"},{"op":"text","speaker":"良一","text":"“看到了吗羽依里！这就是金蝉脱壳之术！”"},{"op":"text","speaker":"","text":"半裸的良一在一旁得意地笑着。"},{"op":"image","layer":1,"image":"i12111"},{"op":"text","speaker":"良一","text":"“怎么样，很厉害吧！”"},{"op":"text","speaker":"羽依里","text":"“虽然确实很厉害，但你――”"},{"op":"image","layer":7,"image":"i11796"},{"op":"text","speaker":"美希","text":"“不准脱衣服。”"},{"op":"image","layer":1,"image":"i12131"},{"op":"text","speaker":"良一","text":"“呀――!؟”"},{"op":"text","speaker":"羽依里","text":"“是不是忘记野美希在站岗了？”"},{"op":"text","speaker":"","text":"趁良一中枪动弹不得时碰了下他。"},{"op":"image","layer":1,"image":"i12072"},{"op":"text","speaker":"良一","text":"“可恶，这下我动不了了！”"},{"op":"image","layer":257,"image":"i11789"},{"op":"text","speaker":"美希","text":"“快穿上衣服。”"},{"op":"image","layer":1,"image":"i12078"},{"op":"text","speaker":"良一","text":"“呀――!؟”"},{"op":"text","speaker":"良一","text":"“都、都说了动不了了！我被冻住了啊！”"},{"op":"image","layer":257,"image":"i11786"},{"op":"text","speaker":"美希","text":"“闭嘴，暴露狂。”"},{"op":"image","layer":1,"image":"i12087"},{"op":"text","speaker":"良一","text":"“呀――!؟”"},{"op":"image","layer":1,"image":"i12078"},{"op":"text","speaker":"良一","text":"“知、知道了！我穿衣服！这就穿！”"},{"op":"image","layer":257,"image":"i11797"},{"op":"text","speaker":"美希","text":"“不准动。”"},{"op":"image","layer":1,"image":"i12087"},{"op":"text","speaker":"良一","text":"“呀――!؟”"},{"op":"image","layer":257,"image":"i11792"},{"op":"text","speaker":"美希","text":"“被冻住的时候活动是犯规的。”"},{"op":"image","layer":1,"image":"i12078"},{"op":"text","speaker":"良一","text":"“太不讲理了――！”"},{"op":"text","speaker":"","text":"看着野美希无情的连续射击，我不禁有点同情良一。"},{"op":"text","speaker":"羽依里","text":"“野美希是在拿良一找乐子啊……”"},{"op":"text","speaker":"","text":"另一边――"},{"op":"image","layer":1,"image":"i15017"},{"op":"image","layer":257,"image":"i12818"},{"op":"text","speaker":"识","text":"“你进到死路了，天善前辈！”"},{"op":"image","layer":1,"image":"i15023"},{"op":"text","speaker":"天善","text":"“唔……看来到此为止了。”"},{"op":"text","speaker":"","text":"识把天善逼到了死胡同。"},{"op":"image","layer":257,"image":"i12820"},{"op":"text","speaker":"识","text":"“认命吧！”"},{"op":"image","layer":1,"image":"i15044"},{"op":"text","speaker":"天善","text":"“……好的，我心甘情愿地认输。”"},{"op":"image","layer":1,"image":"i15035"},{"op":"text","speaker":"天善","text":"“但是，我也有不能让步的东西！”"},{"op":"image","layer":1,"image":"i15116"},{"op":"image","layer":257,"image":"i12824"},{"op":"text","speaker":"","text":"天善从口袋里掏出了球拍。"},{"op":"image","layer":257,"image":"i12783"},{"op":"text","speaker":"识","text":"“你想干什么？”"},{"op":"image","layer":1,"image":"i15096"},{"op":"text","speaker":"天善","text":"“哼，这还用说。”"},{"op":"image","layer":1,"image":"i15116"},{"op":"text","speaker":"天善","text":"“就是这样！”"},{"op":"image","layer":257,"image":"i12780"},{"op":"text","speaker":"识","text":"“嗯!؟”"},{"op":"image","layer":1,"image":"i15149"},{"op":"text","speaker":"","text":"摆出一个持拍的姿势。"},{"op":"image","layer":1,"image":"i15137"},{"op":"text","speaker":"天善","text":"“至少让我以这个姿势冻住吧！”"},{"op":"image","layer":257,"image":"i12783"},{"op":"text","speaker":"识","text":"“呃……那好吧。”"},{"op":"text","speaker":"","text":"识碰到了天善，造就出一尊诡异的冰像。"},{"op":"image","layer":1,"image":"i15133"},{"op":"text","speaker":"天善","text":"“哼……还不错。”"},{"op":"text","speaker":"羽依里","text":"“那家伙到底想干什么啊……”"},{"op":"text","speaker":"岛上的男孩A","text":"“嘿，碰到你了！这下你能动了！”"},{"op":"text","speaker":"岛上的女孩A","text":"“啊……谢谢。”"},{"op":"text","speaker":"羽依里","text":"“糟了！”"},{"op":"text","speaker":"","text":"趁着我发呆的时候，其他人碰到了被冻住的孩子。"},{"op":"text","speaker":"","text":"这就是冰鬼游戏最可怕的地方。"},{"op":"text","speaker":"岛上的男孩B","text":"“也碰到师父了！”"},{"op":"image","layer":1,"image":"i10200"},{"op":"text","speaker":"苍","text":"“谢谢！这下我也自由了！”"},{"op":"image","layer":1,"image":"i10208"},{"op":"text","speaker":"苍","text":"“好嘞，那么……识！”"},{"op":"text","speaker":"羽依里","text":"“喔……”"},{"op":"image","layer":7,"image":"i12782"},{"op":"text","speaker":"识","text":"“怎么了？”"},{"op":"image","layer":1,"image":"i10322"},{"op":"text","speaker":"苍","text":"“别以为自己跑得快就得意忘形了！”"},{"op":"image","layer":1,"image":"i10282"},{"op":"text","speaker":"苍","text":"“要是你以为能把我轻松冻住，那可就大错特错了！”"},{"op":"text","speaker":"岛上的男孩A","text":"“哦！师父宣战了！”"},{"op":"text","speaker":"岛上的男孩B","text":"“这是向鬼姐姐发起的挑战！”"},{"op":"text","speaker":"岛上的男孩C","text":"“师父，太帅了！”"},{"op":"image","layer":1,"image":"i10276"},{"op":"text","speaker":"苍","text":"“哼哼！”"},{"op":"if","truth":false,"target":445,"value":["!=",["v",77],1]},{"op":"text","speaker":"羽依里","text":"“话说，师父是……什么意思？”"},{"op":"text","speaker":"岛上的男孩A","text":"“苍姐是我们的师父！”"},{"op":"text","speaker":"岛上的男孩B","text":"“她教了我们很多东西！”"},{"op":"text","speaker":"岛上的男孩C","text":"“师父可厉害了！”"},{"op":"text","speaker":"羽依里","text":"“苍……你到底教了这些孩子什么……”"},{"op":"image","layer":1,"image":"i10138"},{"op":"text","speaker":"苍","text":"“呜啊啊啊啊！别用那种怜悯的眼神看我啊！”"},{"op":"goto","target":445},{"op":"image","layer":257,"image":"i12818"},{"op":"text","speaker":"识","text":"“碰――到了。”"},{"op":"image","layer":1,"image":"i10135"},{"op":"text","speaker":"苍","text":"“哈啊啊啊啊!؟”"},{"op":"text","speaker":"","text":"识从毫无防备的苍背后碰到了她。"},{"op":"image","layer":1,"image":"i10124"},{"op":"text","speaker":"苍","text":"“等、等一下！太卑鄙了！耍赖！”"},{"op":"text","speaker":"羽依里","text":"“是你自己大意了。”"},{"op":"text","speaker":"岛上的男孩A","text":"“鬼姐姐果然是鬼啊。”"},{"op":"text","speaker":"岛上的男孩B","text":"“大意的话，就会被从后面偷袭。”"},{"op":"text","speaker":"岛上的男孩C","text":"“好可怕……”"},{"op":"text","speaker":"羽依里","text":"“上吧，识！把他们全都冻住！”"},{"op":"image","layer":257,"image":"i12820"},{"op":"text","speaker":"识","text":"“遵命！”"},{"op":"text","speaker":"","text":"识眼里闪着光，追赶着还能动的小鬼们。"},{"op":"image","layer":1,"image":"i12743"},{"op":"text","speaker":"识","text":"“嘿！呀！嘿！”"},{"op":"text","speaker":"岛上的男孩A","text":"“啊!؟”"},{"op":"text","speaker":"岛上的男孩B","text":"“糟了!؟”"},{"op":"text","speaker":"岛上的男孩C","text":"“被抓到了――！”"},{"op":"text","speaker":"","text":"识从孩子们背后连续碰到了三个人。"},{"op":"image","layer":1,"image":"i12746"},{"op":"text","speaker":"识","text":"“嗯嘿嘿，你们还嫩着呢！”"},{"op":"text","speaker":"岛上的男孩A","text":"“可恶，还是一点都不留情啊。”"},{"op":"text","speaker":"羽依里","text":"“干得好，识！”"},{"op":"text","speaker":"岛上的女孩C","text":"“碰到你了！”"},{"op":"text","speaker":"羽依里","text":"“啊……”"},{"op":"image","layer":1,"image":"i12085"},{"op":"text","speaker":"良一","text":"“太好了！谢谢！”"},{"op":"text","speaker":"岛上的女孩B","text":"“还有你！”"},{"op":"image","layer":257,"image":"i15133"},{"op":"text","speaker":"天善","text":"“……屈辱的时间结束了。”"},{"op":"image","layer":257,"image":"i15116"},{"op":"text","speaker":"天善","text":"“加纳天善！复活！”"},{"op":"text","speaker":"羽依里","text":"“啊，可恶。”"},{"op":"text","speaker":"","text":"小女孩们碰到了良一和天善，两个人都复活了。"},{"op":"text","speaker":"羽依里","text":"“唉……又得重来了。”"},{"op":"image","layer":1,"image":"i12777"},{"op":"text","speaker":"识","text":"“别垂头丧气啊，羽依里！”"},{"op":"image","layer":1,"image":"i12794"},{"op":"text","speaker":"识","text":"“我们可是鬼啊！”"},{"op":"image","layer":1,"image":"i12796"},{"op":"text","speaker":"识","text":"“既然是鬼，就要像鬼一样对他们穷追不舍！”"},{"op":"text","speaker":"羽依里","text":"“识……”"},{"op":"text","speaker":"岛上的女孩C","text":"“我碰碰碰！”"},{"op":"text","speaker":"岛上的男孩A","text":"“成功了！”"},{"op":"text","speaker":"岛上的男孩B","text":"“这下我们也复活了！”"},{"op":"text","speaker":"岛上的男孩C","text":"“好，快逃吧！”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i1708"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"识","text":"“大家，尽管逃吧！”"},{"op":"text","speaker":"识","text":"“我是可怕的鬼！是无情的鬼姬！”"},{"op":"text","speaker":"识","text":"“不想被海盗鬼姬抓到的话，就赶紧逃啊！”"},{"op":"image","layer":0,"image":"i1710"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"识","text":"“呜咻――――!!”"},{"op":"text","speaker":"岛上的男孩A","text":"“哇！出现了！鬼的吼叫！”"},{"op":"text","speaker":"岛上的女孩A","text":"“好可怕！”"},{"op":"text","speaker":"","text":"扮成鬼的识追得小孩子们满地乱跑。"},{"op":"text","speaker":"","text":"一边笑着，一边开心地奔跑着。"},{"op":"text","speaker":"","text":"她的笑容，一点都不像是鬼该有的表情。"},{"op":"image","layer":2,"image":"i740"},{"op":"image","layer":0,"image":"i513"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":7,"image":"i10134"},{"op":"text","speaker":"苍","text":"“喂！只有我还不能动耶！”"},{"op":"image","layer":7,"image":"i10123"},{"op":"text","speaker":"苍","text":"“谁来碰我一下啊！”"},{"op":"image","layer":7,"image":"i10137"},{"op":"text","speaker":"苍","text":"“喂！听我说啊――！”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":2},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":2},{"op":"image","layer":0,"image":"i72"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"夜晚――"},{"op":"text","speaker":"","text":"识那白天玩闹得疲惫不堪的身体躺在了榻榻米上。"},{"op":"text","speaker":"","text":"不过，其实她并不是在休息。"},{"op":"text","speaker":"","text":"向右滚……"},{"op":"text","speaker":"","text":"――向左滚……"},{"op":"text","speaker":"","text":"她正在专心致志地锻炼着半规管。"},{"op":"image","layer":7,"image":"i12717"},{"op":"text","speaker":"识","text":"“嗯嘿嘿，好像，慢慢，有点，习惯，了，呢。”"},{"op":"text","speaker":"羽依里","text":"“那真是太好了。”"},{"op":"text","speaker":"","text":"这次我没有陪她，而是在查看古文书的内容。"},{"op":"text","speaker":"羽依里","text":"“……咦？”"},{"op":"image","layer":7,"image":"i12705"},{"op":"text","speaker":"识","text":"“怎么，了，吗？”"},{"op":"text","speaker":"羽依里","text":"“古文书的内容变了。”"},{"op":"image","layer":1,"image":"i12697"},{"op":"text","speaker":"识","text":"“咦……真的吗!؟”"},{"op":"text","speaker":"","text":"识一下子蹦了起来，扑到了我的背上。"},{"op":"image","layer":1,"image":"i12632"},{"op":"text","speaker":"识","text":"“是哪里？哪里发生了什么变化？”"},{"op":"text","speaker":"","text":"她越过我的肩膀，盯着古文书看。"},{"op":"text","speaker":"羽依里","text":"“唔……”"},{"op":"text","speaker":"","text":"感觉各种意义上都凑得好近。"},{"op":"text","speaker":"","text":"后背还蹭到了各种地方。"},{"op":"image","layer":1,"image":"i12664"},{"op":"text","speaker":"识","text":"“羽依里？”"},{"op":"text","speaker":"羽依里","text":"“啊，嗯……那个……”"},{"op":"text","speaker":"","text":"虽然心潮澎湃，但我还是故作淡定地把书中变化的部分指给识看。"},{"op":"text","speaker":"羽依里","text":"“你看，这里。”"},{"op":"image","layer":1,"image":"i12641"},{"op":"text","speaker":"羽依里","text":"“岛上的居民中，有人开始对鬼姬感到恐惧了。”"},{"op":"image","layer":1,"image":"i12632"},{"op":"text","speaker":"识","text":"“哦！终于有人开始害怕我了呢！”"},{"op":"text","speaker":"羽依里","text":"“确实如此。”"},{"op":"image","layer":1,"image":"i12641"},{"op":"text","speaker":"识","text":"“不过，我今天做了什么吗？”"},{"op":"text","speaker":"羽依里","text":"“做灯笼和玩冰鬼游戏吧。”"},{"op":"text","speaker":"羽依里","text":"“大概是冰鬼游戏的缘故吧？”"},{"op":"image","layer":1,"image":"i12664"},{"op":"text","speaker":"识","text":"“但是捉鬼不是一直都有在玩吗？”"},{"op":"text","speaker":"羽依里","text":"“不，今天你追着那些小鬼跑的时候可是相当不留情面的。”"},{"op":"image","layer":1,"image":"i12669"},{"op":"text","speaker":"识","text":"“稍微动了点真格呢。”"},{"op":"image","layer":1,"image":"i12660"},{"op":"text","speaker":"识","text":"“也就是说，这让我的恶鬼气息变得更加锐利了吧。”"},{"op":"text","speaker":"羽依里","text":"“虽然你笑得蛮开心的就是了。”"},{"op":"image","layer":1,"image":"i12629"},{"op":"text","speaker":"识","text":"“即使如此，历史还是改变了。”"},{"op":"image","layer":1,"image":"i12632"},{"op":"text","speaker":"识","text":"“照这样下去，鬼姬应该就能成为恐怖的代名词了。”"},{"op":"image","layer":1,"image":"i12635"},{"op":"text","speaker":"识","text":"“不，一定会的！我一定要做到！”"},{"op":"text","speaker":"","text":"识兴奋地大口地喘着粗气。"},{"op":"text","speaker":"","text":"确实古文书正在朝着识所期望的方向改变。"},{"op":"text","speaker":"","text":"虽然在改变……"},{"op":"text","speaker":"","text":"但总觉得有些在意。"},{"op":"text","speaker":"","text":"这样下去……真的没问题吗……？"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]