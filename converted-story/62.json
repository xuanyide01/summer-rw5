[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":1,"image":"i15378"},{"op":"text","speaker":"羽未","text":"“呃。”"},{"op":"text","speaker":"羽依里","text":"“用得着这么惊讶吗？”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“居然带女人回来了。”"},{"op":"image","layer":257,"image":"i13124"},{"op":"text","speaker":"白羽","text":"“你好。”"},{"op":"image","layer":1,"image":"i15445"},{"op":"text","speaker":"羽未","text":"“……你好。”"},{"op":"text","speaker":"羽依里","text":"“害羞什么啊你？”"},{"op":"image","layer":1,"image":"i15560"},{"op":"text","speaker":"羽未","text":"“唉？”"},{"op":"text","speaker":"羽依里","text":"“脸都红透了。”"},{"op":"image","layer":1,"image":"i15573"},{"op":"text","speaker":"羽未","text":"“因为这姐姐好漂亮……”"},{"op":"image","layer":257,"image":"i13191"},{"op":"text","speaker":"白羽","text":"“唉？”"},{"op":"image","layer":257,"image":"i13196"},{"op":"text","speaker":"白羽","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“你也用不着跟着害羞吧。”"},{"op":"image","layer":1,"image":"i15450"},{"op":"text","speaker":"羽未","text":"“正好，我刚打算准备午饭。”"},{"op":"image","layer":1,"image":"i15384"},{"op":"text","speaker":"羽未","text":"“不介意的话……”"},{"op":"image","layer":257,"image":"i13131"},{"op":"text","speaker":"白羽","text":"“啊，可以吗？”"},{"op":"text","speaker":"羽依里","text":"“等一下。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“唉？等什么？”"},{"op":"text","speaker":"羽依里","text":"“白羽她很擅长做饭。难得来一次，就让她做吧。”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“可是哪有这样冷不丁麻烦客人来做饭的，太没礼貌了。”"},{"op":"text","speaker":"羽依里","text":"“不用在意这些。”"},{"op":"text","speaker":"羽依里","text":"“毕、毕竟我们……是朋友。”"},{"op":"image","layer":257,"image":"i13201"},{"op":"text","speaker":"白羽","text":"“……啊？”"},{"op":"text","speaker":"白羽","text":"“……那个。”"},{"op":"text","speaker":"白羽","text":"“啊，嗯……算是吧。”"},{"op":"image","layer":1,"image":"i15560"},{"op":"text","speaker":"羽未","text":"“为什么说是朋友，你们要这么害羞啊？”"},{"op":"text","speaker":"羽依里","text":"“呃，不。”"},{"op":"image","layer":257,"image":"i13121"},{"op":"text","speaker":"白羽","text":"“才没有害羞。”"},{"op":"text","speaker":"羽依里","text":"“那么，可以请你做个饭吗？”"},{"op":"text","speaker":"羽依里","text":"“当然，前提是你不介意。”"},{"op":"image","layer":257,"image":"i13196"},{"op":"text","speaker":"白羽","text":"“这样没问题吗？让我这外人碰厨房。”"},{"op":"image","layer":1,"image":"i15450"},{"op":"text","speaker":"羽未","text":"“请。羽依里哥看来是吃腻我做的炒饭了。”"},{"op":"image","layer":1,"image":"i15412"},{"op":"text","speaker":"羽未","text":"“就给他做不一样的炒饭吧。”"},{"op":"image","layer":257,"image":"i13141"},{"op":"text","speaker":"白羽","text":"“想吃炒饭吗？”"},{"op":"text","speaker":"羽依里","text":"“我诚挚请求炒饭以外的料理。”"},{"op":"image","layer":1,"image":"i15343"},{"op":"text","speaker":"羽未","text":"“什么!؟”"},{"op":"image","layer":257,"image":"i13170"},{"op":"text","speaker":"白羽","text":"“好的。我能打开冰箱看看吗？”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“请看请看。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i65"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13201"},{"op":"text","speaker":"白羽","text":"“材料有……”"},{"op":"text","speaker":"羽依里","text":"“要是不够的话，我可以去买。”"},{"op":"image","layer":1,"image":"i13068"},{"op":"text","speaker":"白羽","text":"“不用。看起来应该够了。”"},{"op":"image","layer":1,"image":"i13105"},{"op":"text","speaker":"白羽","text":"“我想想……冷面可以吧？”"},{"op":"text","speaker":"羽依里","text":"“没问题。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13141"},{"op":"text","speaker":"白羽","text":"“好了，请用。”"},{"op":"image","layer":257,"image":"i15325"},{"op":"text","speaker":"羽依里·羽未","text":"“不客气了！”“不客气了！”"},{"op":"image","layer":257,"image":"i15375"},{"op":"image","layer":1,"image":"i13124"},{"op":"text","speaker":"","text":"……"},{"op":"text","speaker":"羽依里","text":"“噢噢。”"},{"op":"image","layer":257,"image":"i15399"},{"op":"text","speaker":"羽未","text":"“这……”"},{"op":"image","layer":257,"image":"i15499"},{"op":"text","speaker":"羽依里·羽未","text":"“好吃！”“真好吃啊！”"},{"op":"image","layer":1,"image":"i13108"},{"op":"text","speaker":"白羽","text":"“谢、谢谢。”"},{"op":"text","speaker":"","text":"……"},{"op":"image","layer":1,"image":"i15415"},{"op":"text","speaker":"羽依里·羽未","text":"“再来一碗！”“再来一碗！”"},{"op":"image","layer":257,"image":"i13204"},{"op":"text","speaker":"白羽","text":"“我再去捞点。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"image","layer":257,"image":"i13201"},{"op":"text","speaker":"羽依里","text":"“慢着慢着。”"},{"op":"text","speaker":"羽依里","text":"“怎么就光我们自己吃了。”"},{"op":"text","speaker":"羽依里","text":"“还厚脸皮要再来。”"},{"op":"image","layer":1,"image":"i15573"},{"op":"text","speaker":"羽未","text":"“啊，因为太好吃忍不住就……”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“不过，羽依里哥你刚才不也说了要再来一碗！”"},{"op":"text","speaker":"羽依里","text":"“我，我有说吗？”"},{"op":"image","layer":257,"image":"i13183"},{"op":"text","speaker":"白羽","text":"“噗……”"},{"op":"image","layer":1,"image":"i15372"},{"op":"image","layer":257,"image":"i13170"},{"op":"text","speaker":"白羽","text":"“你们两个，是兄妹吗？”"},{"op":"image","layer":1,"image":"i15563"},{"op":"text","speaker":"羽依里·羽未","text":"“唉？”“唉？”"},{"op":"image","layer":1,"image":"i15589"},{"op":"text","speaker":"羽未","text":"“才才、才不是呢！”"},{"op":"text","speaker":"","text":"不假思索就否认了。"},{"op":"image","layer":1,"image":"i15394"},{"op":"text","speaker":"羽未","text":"“我才不要这样的哥哥！”"},{"op":"text","speaker":"羽依里","text":"“这么直白很伤人的。”"},{"op":"image","layer":257,"image":"i13111"},{"op":"text","speaker":"白羽","text":"“那个，我就是觉得你们有点像。”"},{"op":"image","layer":1,"image":"i15560"},{"op":"text","speaker":"羽未","text":"“唉？”"},{"op":"image","layer":257,"image":"i13108"},{"op":"text","speaker":"白羽","text":"“啊，对不起。”"},{"op":"text","speaker":"羽依里","text":"“你干嘛道歉啊。这不就像说错话似的了。”"},{"op":"image","layer":1,"image":"i15485"},{"op":"text","speaker":"羽未","text":"“居然说我像羽依里哥……”"},{"op":"image","layer":1,"image":"i15479"},{"op":"image","layer":257,"image":"i13124"},{"op":"text","speaker":"羽未","text":"“我可是一直以长得像妈妈为豪……”"},{"op":"text","speaker":"羽依里","text":"“那就是说，我可能跟羽未的妈妈长得挺像吧。”"},{"op":"image","layer":1,"image":"i15387"},{"op":"text","speaker":"羽未","text":"“绝对不可能。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i58"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13062"},{"op":"text","speaker":"白羽","text":"“打扰了。”"},{"op":"text","speaker":"羽依里","text":"“抱歉。突然把你拉到家里。”"},{"op":"text","speaker":"羽依里","text":"“还麻烦你给我们做饭。”"},{"op":"image","layer":1,"image":"i13081"},{"op":"text","speaker":"白羽","text":"“没、没关系。”"},{"op":"image","layer":1,"image":"i13111"},{"op":"text","speaker":"白羽","text":"“我也很开心……所以……”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"image","layer":1,"image":"i13105"},{"op":"text","speaker":"白羽","text":"“那么热闹的饭桌，很久没见到过了。”"},{"op":"text","speaker":"羽依里","text":"“是吗。”"},{"op":"text","speaker":"羽依里","text":"“那个……你不介意的话，改天再来吧。”"},{"op":"image","layer":1,"image":"i13131"},{"op":"text","speaker":"白羽","text":"“…………”"},{"op":"text","speaker":"","text":"白羽她似乎有点为难，缩起双肩。"},{"op":"image","layer":1,"image":"i13170"},{"op":"text","speaker":"白羽","text":"“再见了。”"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"set","variable":7120,"value":1},{"op":"image","layer":2,"image":"i751"},{"op":"image","layer":0,"image":"i514"},{"op":"set","variable":6714,"value":4},{"op":"clear","layer":2},{"op":"image","layer":0,"image":"i70"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“羽依里哥。”"},{"op":"text","speaker":"羽依里","text":"“怎么了？”"},{"op":"image","layer":1,"image":"i15325"},{"op":"text","speaker":"羽未","text":"“有你的信。”"},{"op":"text","speaker":"羽依里","text":"“我的？”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"","text":"怎么会寄到这种地方来……"},{"op":"text","speaker":"","text":"寄信人是……"},{"op":"text","speaker":"羽依里","text":"“啊……”"},{"op":"image","layer":1,"image":"i15538"},{"op":"text","speaker":"羽未","text":"“好可爱的信封啊。”"},{"op":"image","layer":1,"image":"i15536"},{"op":"text","speaker":"羽未","text":"“惠……小姐？”"},{"op":"text","speaker":"羽依里","text":"“喂，不准偷看。”"},{"op":"image","layer":1,"image":"i15455"},{"op":"text","speaker":"羽未","text":"“又不会少斤肉。”"},{"op":"image","layer":1,"image":"i15408"},{"op":"text","speaker":"羽未","text":"“女朋友？”"},{"op":"image","layer":1,"image":"i15401"},{"op":"text","speaker":"羽未","text":"“啊，不可能吧。”"},{"op":"text","speaker":"羽依里","text":"“不准说不可能。”"},{"op":"image","layer":1,"image":"i15408"},{"op":"text","speaker":"羽未","text":"“羽依里哥，你来这里是另有隐情的对吧？”"},{"op":"text","speaker":"羽依里","text":"“唉？”"},{"op":"text","speaker":"羽依里","text":"“……嗯。”"},{"op":"text","speaker":"羽依里","text":"“我是离家出走来这里的。”"},{"op":"image","layer":1,"image":"i15353"},{"op":"text","speaker":"羽未","text":"“……”"},{"op":"text","speaker":"","text":"羽未怔怔看着我。"},{"op":"text","speaker":"","text":"对年纪还小的羽未来说，也许离家出走这种事太过刺激。"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“的确。”"},{"op":"image","layer":1,"image":"i15375"},{"op":"text","speaker":"羽未","text":"“大家都有自己的隐情。”"},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“毕竟是夏天。”"},{"op":"text","speaker":"羽依里","text":"“是啊。”"},{"op":"text","speaker":"羽依里","text":"“夏天……”"},{"op":"text","speaker":"羽依里","text":"“说不出口的隐情……”"},{"op":"text","speaker":"","text":"我也是，羽未也是。"},{"op":"text","speaker":"","text":"独自一人来到这座岛。"},{"op":"text","speaker":"","text":"就说明这孩子，也有“隐情”吧。"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“干什么？”"},{"op":"text","speaker":"羽依里","text":"“不，没什么。”"},{"op":"text","speaker":"","text":"要踏进她的心扉，现在的我应该还没资格。"},{"op":"text","speaker":"","text":"我如此想到。"},{"op":"return"},{"op":"end"}]