[{"op":"set","variable":30001,"value":1920},{"op":"set","variable":30002,"value":1080},{"op":"image","layer":0,"image":"i68"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“嗯～～～～～～！”"},{"op":"text","speaker":"","text":"天亮了。"},{"op":"text","speaker":"","text":"今天天气也很不错。"},{"op":"text","speaker":"","text":"不过，感觉比平时更加耀眼。"},{"op":"text","speaker":"羽依里","text":"“整个世界都在闪闪发光啊……”"},{"op":"text","speaker":"","text":"毕竟我有了恋人嘛。"},{"op":"text","speaker":"","text":"那也难怪会闪闪发光。"},{"op":"text","speaker":"羽依里","text":"“那么……”"},{"op":"image","layer":0,"image":"i61"},{"op":"set","variable":6714,"value":0},{"op":"if","truth":false,"target":30,"value":["==",["v",6003],2]},{"op":"image","layer":1,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“早上好～哥哥。”"},{"op":"text","speaker":"羽依里","text":"“早上好，羽未。”"},{"op":"image","layer":1,"image":"i15560"},{"op":"text","speaker":"羽未","text":"“你好像心情很好呀～？”"},{"op":"text","speaker":"羽依里","text":"“还行吧。”"},{"op":"text","speaker":"羽依里","text":"“我正沉浸在世界的光辉中呢。”"},{"op":"image","layer":1,"image":"i15337"},{"op":"text","speaker":"羽未","text":"“光辉……？”"},{"op":"image","layer":1,"image":"i15442"},{"op":"text","speaker":"羽未","text":"“不可以直视太阳哦？”"},{"op":"text","speaker":"羽依里","text":"“现在的话，应该没问题。”"},{"op":"text","speaker":"","text":"等会有咖喱可以吃，就不用吃早饭了吧。"},{"op":"text","speaker":"羽依里","text":"“那我出门了啊。”"},{"op":"goto","target":59},{"op":"if","truth":false,"target":44,"value":["==",["v",6003],1]},{"op":"image","layer":1,"image":"i15458"},{"op":"text","speaker":"羽未","text":"“早上好，羽依里哥。”"},{"op":"text","speaker":"羽依里","text":"“早上好，羽未。”"},{"op":"image","layer":1,"image":"i15560"},{"op":"text","speaker":"羽未","text":"“你怎么看起来这么开心？”"},{"op":"text","speaker":"羽依里","text":"“我正沉浸在世界的光辉中呢。”"},{"op":"image","layer":1,"image":"i15372"},{"op":"text","speaker":"羽未","text":"“哈啊。”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“现在是夏天，白天就是一直会很耀眼的。”"},{"op":"text","speaker":"","text":"等会有咖喱可以吃，就不用吃早饭了吧。"},{"op":"text","speaker":"羽依里","text":"“那我出门了啊。”"},{"op":"goto","target":59},{"op":"if","truth":false,"target":59,"value":["==",["v",6003],0]},{"op":"image","layer":1,"image":"i15321"},{"op":"text","speaker":"羽未","text":"“早上好，鹰原哥。”"},{"op":"text","speaker":"羽依里","text":"“早上好，羽未。”"},{"op":"image","layer":1,"image":"i15357"},{"op":"text","speaker":"羽未","text":"“你看起来好像很开心啊？”"},{"op":"text","speaker":"羽依里","text":"“还行吧。”"},{"op":"text","speaker":"羽依里","text":"“我正沉浸在世界的光辉中呢。”"},{"op":"image","layer":1,"image":"i15350"},{"op":"text","speaker":"羽未","text":"“啊。”"},{"op":"image","layer":1,"image":"i15328"},{"op":"text","speaker":"羽未","text":"“毕竟是夏天，白天一直会很耀眼的。”"},{"op":"text","speaker":"","text":"等会有咖喱可以吃，就不用吃早饭了吧。"},{"op":"text","speaker":"羽依里","text":"“那我出门了啊。”"},{"op":"goto","target":59},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i58"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"骑着幼兽前往海之家。"},{"op":"image","layer":0,"image":"i366"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“嗯？”"},{"op":"text","speaker":"","text":"看到紬在捡垃圾。"},{"op":"text","speaker":"羽依里","text":"“哟，今天也在捡垃圾啊。”"},{"op":"image","layer":1,"image":"i14508"},{"op":"text","speaker":"紬","text":"“姆啾！羽依里先生！”"},{"op":"text","speaker":"","text":"紬跑了过来。"},{"op":"image","layer":1,"image":"i14384"},{"op":"text","speaker":"紬","text":"“羽依里先生，恭喜你！”"},{"op":"text","speaker":"","text":"边说边为我鼓掌。"},{"op":"text","speaker":"羽依里","text":"“呃，谢谢。”"},{"op":"text","speaker":"羽依里","text":"“是静久告诉你的吗？”"},{"op":"image","layer":1,"image":"i14461"},{"op":"text","speaker":"紬","text":"“是的哦，她的脸都红透了。”"},{"op":"text","speaker":"羽依里","text":"“静久吗？”"},{"op":"image","layer":1,"image":"i14381"},{"op":"text","speaker":"紬","text":"“她都害羞到把脸埋进玩偶里，在地上滚来滚去呢。”"},{"op":"text","speaker":"羽依里","text":"“这倒是有点意外啊。”"},{"op":"image","layer":1,"image":"i14520"},{"op":"text","speaker":"紬","text":"“是啊。我看到了也在想‘喔～……’？”"},{"op":"text","speaker":"羽依里","text":"“明明她看上去挺冷静的……在紬面前却会变成那副模样啊。”"},{"op":"image","layer":1,"image":"i14470"},{"op":"text","speaker":"紬","text":"“我也有点被吓到了。”"},{"op":"text","speaker":"羽依里","text":"“有那么夸张啊……”"},{"op":"image","layer":1,"image":"i14420"},{"op":"text","speaker":"紬","text":"“不过我真的很高兴！祝你们白头偕老永远幸福！”"},{"op":"text","speaker":"","text":"紬的鼓掌让我有些害羞。"},{"op":"image","layer":1,"image":"i14446"},{"op":"text","speaker":"紬","text":"“大家一定也会祝福你们的。”"},{"op":"text","speaker":"羽依里","text":"“哪里会呢。”"},{"op":"image","layer":1,"image":"i14460"},{"op":"text","speaker":"紬","text":"“你们两个交往的事情，在岛上已经是很出名的话题了哦。”"},{"op":"text","speaker":"羽依里","text":"“真的吗!؟”"},{"op":"text","speaker":"","text":"这也太羞耻了。"},{"op":"text","speaker":"羽依里","text":"“说起来，静久呢？”"},{"op":"image","layer":1,"image":"i14506"},{"op":"text","speaker":"紬","text":"“她还没来，门好像也没开。”"},{"op":"text","speaker":"羽依里","text":"“这样啊。比平时都要晚呢。”"},{"op":"text","speaker":"","text":"和紬两个人等待静久。"},{"op":"text","speaker":"","text":"过了一会热……"},{"op":"image","layer":1,"image":"i13820"},{"op":"text","speaker":"静久","text":"“抱歉，我来晚了～”"},{"op":"text","speaker":"","text":"静久总算来了。"},{"op":"text","speaker":"羽依里","text":"“哟。”"},{"op":"image","layer":1,"image":"i13782"},{"op":"text","speaker":"静久","text":"“哟♪”"},{"op":"image","layer":7,"image":"i14466"},{"op":"text","speaker":"紬","text":"“静久，今天是发生什么事了吗？”"},{"op":"image","layer":1,"image":"i13867"},{"op":"text","speaker":"静久","text":"“嗯，因为擅自在外面过夜……昨天一直都在挨骂……”"},{"op":"image","layer":1,"image":"i13864"},{"op":"text","speaker":"静久","text":"“结果今天出门前，又被妈妈唠叨了好多……”"},{"op":"text","speaker":"羽依里","text":"“真是不容易啊。”"},{"op":"image","layer":1,"image":"i13873"},{"op":"text","speaker":"静久","text":"“是啊……真的是被说了一大堆话，感觉都有点累了。”"},{"op":"image","layer":1,"image":"i13919"},{"op":"text","speaker":"静久","text":"“好想被安慰啊～”"},{"op":"text","speaker":"","text":"她故意用撒娇的语气说道。"},{"op":"text","speaker":"","text":"也许是在努力做一些恋人间会做的事情吧。"},{"op":"text","speaker":"","text":"那么我也要。"},{"op":"text","speaker":"羽依里","text":"“嗯，只要是我能做到的，什么都可以。”"},{"op":"text","speaker":"","text":"我尽可能说得帅气一点。"},{"op":"image","layer":1,"image":"i13823"},{"op":"text","speaker":"静久","text":"“那就拜托你啦？”"},{"op":"text","speaker":"","text":"静久蹦蹦跳跳地向我靠近过来。"},{"op":"image","layer":1,"image":"i13850"},{"op":"text","speaker":"静久","text":"“拜托了哦～♪”"},{"op":"text","speaker":"","text":"说着，她就把额头靠到了我的胸口上。"},{"op":"text","speaker":"羽依里","text":"“静久!؟”"},{"op":"image","layer":1,"image":"i13865"},{"op":"text","speaker":"静久","text":"“怎么了？”"},{"op":"text","speaker":"羽依里","text":"“这也太大胆了吧!؟”"},{"op":"image","layer":1,"image":"i13859"},{"op":"text","speaker":"静久","text":"“我们不是恋人嘛。”"},{"op":"text","speaker":"羽依里","text":"“是这样没错……！”"},{"op":"text","speaker":"","text":"但是突然这样会很害羞的。"},{"op":"text","speaker":"羽依里","text":"“再说，紬还在看着呢。”"},{"op":"image","layer":7,"image":"i14488"},{"op":"text","speaker":"紬","text":"“姆啾!؟等一下哦。”"},{"op":"image","layer":7,"image":"i14485"},{"op":"text","speaker":"","text":"她闭上了眼睛。"},{"op":"image","layer":7,"image":"i14398"},{"op":"text","speaker":"紬","text":"“不看，不看不看，不看不看……”"},{"op":"text","speaker":"","text":"已经太迟了。"},{"op":"image","layer":1,"image":"i13889"},{"op":"text","speaker":"静久","text":"“你讨厌这样吗？”"},{"op":"text","speaker":"羽依里","text":"“……完全不讨厌就是了。”"},{"op":"image","layer":1,"image":"i13865"},{"op":"text","speaker":"静久","text":"“嗯～……”"},{"op":"image","layer":1,"image":"i13880"},{"op":"text","speaker":"静久","text":"“对不起啊。因为被狠狠骂了一顿，其实我还挺消沉的。”"},{"op":"image","layer":1,"image":"i13874"},{"op":"text","speaker":"静久","text":"“所以想让你稍微安慰我一下下～”"},{"op":"image","layer":1,"image":"i13868"},{"op":"text","speaker":"静久","text":"“如果你不讨厌的话，可以让我这样靠一会儿吗？”"},{"op":"text","speaker":"羽依里","text":"“哎……”"},{"op":"text","speaker":"","text":"静久居然把紬晾在一边，找我来做这种事……"},{"op":"text","speaker":"","text":"好像闻所未闻。"},{"op":"text","speaker":"","text":"可能她是真的特别消沉吧。"},{"op":"text","speaker":"羽依里","text":"“好吧。”"},{"op":"image","layer":1,"image":"i13856"},{"op":"text","speaker":"静久","text":"“……谢谢。”"},{"op":"image","layer":1,"image":"i13833"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"果然看起来有些难过的样子。"},{"op":"text","speaker":"","text":"虽然不太习惯这些动作，不过我还是轻轻摸了摸她的头。"},{"op":"image","layer":1,"image":"i13847"},{"op":"text","speaker":"静久","text":"“呵呵♪”"},{"op":"text","speaker":"","text":"好害羞……"},{"op":"image","layer":1,"image":"i13737"},{"op":"text","speaker":"静久","text":"“嗯……我没事了♪”"},{"op":"text","speaker":"羽依里","text":"“是吗。”"},{"op":"image","layer":1,"image":"i13770"},{"op":"text","speaker":"静久","text":"“谢谢你♪”"},{"op":"text","speaker":"羽依里","text":"“嗯，随时都可以再来找我。”"},{"op":"image","layer":1,"image":"i13896"},{"op":"text","speaker":"静久","text":"“那么，我们去给海之家开门吧。”"},{"op":"text","speaker":"羽依里","text":"“明白。”"},{"op":"image","layer":1,"image":"i13962"},{"op":"text","speaker":"静久","text":"“紬，要开始做咖喱了哦。”"},{"op":"image","layer":257,"image":"i14452"},{"op":"text","speaker":"紬","text":"“……不看不看不看不看。”"},{"op":"text","speaker":"羽依里","text":"“还没完啊……”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i378"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i14384"},{"op":"image","layer":257,"image":"i13737"},{"op":"text","speaker":"紬","text":"“希望今天也会来很多客人来呢。”"},{"op":"image","layer":257,"image":"i13858"},{"op":"text","speaker":"静久","text":"“是啊。不过，和羽依里在一起的话，可能会被说不少闲话呢。”"},{"op":"image","layer":1,"image":"i14445"},{"op":"text","speaker":"紬","text":"“是呀，毕竟你们两个的事已经很有名了。”"},{"op":"image","layer":1,"image":"i14547"},{"op":"text","speaker":"紬","text":"“羽依里先生昨天去摊牌的那件事也很惊人呢。”"},{"op":"image","layer":1,"image":"i14520"},{"op":"text","speaker":"紬","text":"“我听的时候也都一直提心吊胆的。”"},{"op":"image","layer":257,"image":"i13843"},{"op":"text","speaker":"静久","text":"“那是什么事啊？”"},{"op":"text","speaker":"羽依里","text":"“连这个都传开了吗？”"},{"op":"image","layer":1,"image":"i14547"},{"op":"text","speaker":"紬","text":"“听说是去找了另一个喜欢静久的人，和他聊了很多很多，最后还跟他决斗了。”"},{"op":"image","layer":257,"image":"i13837"},{"op":"text","speaker":"静久","text":"“哎哎？”"},{"op":"image","layer":1,"image":"i14438"},{"op":"text","speaker":"紬","text":"“听说把他打到体无完肤，是一场碾压式的胜利呢。”"},{"op":"image","layer":257,"image":"i13870"},{"op":"text","speaker":"静久","text":"“你、你去做了这种事吗？”"},{"op":"text","speaker":"羽依里","text":"“不……做了是做了……但我们并没有打架。”"},{"op":"text","speaker":"羽依里","text":"“就是想把事情给说清楚，于是去跟人家谈了谈而已。”"},{"op":"image","layer":257,"image":"i13876"},{"op":"text","speaker":"静久","text":"“啊！这、这样啊……吓了我一跳。”"},{"op":"image","layer":257,"image":"i13884"},{"op":"text","speaker":"静久","text":"“不过……你会去说这些事情，说明你有在认真考虑我们的关系吧？”"},{"op":"text","speaker":"羽依里","text":"“那当然了。”"},{"op":"image","layer":257,"image":"i13886"},{"op":"text","speaker":"静久","text":"“呵呵，我很开心哦♪”"},{"op":"image","layer":1,"image":"i14554"},{"op":"text","speaker":"紬","text":"“羽依里先生真的很――”"},{"op":"image","layer":1,"image":"i14529"},{"op":"text","speaker":"紬","text":"“……――姆啾!؟”"},{"op":"image","layer":1,"image":"i14399"},{"op":"text","speaker":"紬","text":"“不看不看不看不看……”"},{"op":"text","speaker":"羽依里","text":"“没事，我什么都不会做的，你不用在意。”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i365"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“多谢款待。”"},{"op":"image","layer":7,"image":"i13926"},{"op":"text","speaker":"静久","text":"“不用客气。”"},{"op":"image","layer":7,"image":"i14376"},{"op":"text","speaker":"紬","text":"“今天做得也好好吃哦。”"},{"op":"text","speaker":"","text":"我们三人度过了一段悠闲的时光。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"是啊……时光正在不断地流逝。"},{"op":"text","speaker":"","text":"等到夏天结束的时候，紬就要离开这里了。"},{"op":"text","speaker":"","text":"既然如此……那就……"},{"op":"image","layer":0,"image":"i378"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"羽依里","text":"“我说，我们偶尔也放下海之家的事情，去玩些别的怎么样？”"},{"op":"image","layer":1,"image":"i14377"},{"op":"image","layer":257,"image":"i13740"},{"op":"text","speaker":"静久","text":"“嗯，当然可以哦。”"},{"op":"text","speaker":"羽依里","text":"“紬想做什么？”"},{"op":"image","layer":1,"image":"i14524"},{"op":"text","speaker":"紬","text":"“姆啾……让我想想。”"},{"op":"image","layer":1,"image":"i14518"},{"op":"text","speaker":"紬","text":"“比如说，在灯塔上用吕客搭一个的阳台之类的吧？”"},{"op":"text","speaker":"羽依里","text":"“原来如此……”"},{"op":"text","speaker":"","text":"玩这个可太危险了。"},{"op":"text","speaker":"羽依里","text":"“静久有什么想和紬一起做的事吗？”"},{"op":"image","layer":257,"image":"i13782"},{"op":"text","speaker":"静久","text":"“有很多哦。”"},{"op":"text","speaker":"羽依里","text":"“那我们从里面选一个吧。”"},{"op":"image","layer":1,"image":"i14529"},{"op":"text","speaker":"紬","text":"“姆啾？”"},{"op":"image","layer":1,"image":"i14560"},{"op":"text","speaker":"紬","text":"“羽依里先生……我们还没听你想做的事情呢。”"},{"op":"image","layer":1,"image":"i14386"},{"op":"text","speaker":"紬","text":"“说的都是静久和我的想法。”"},{"op":"text","speaker":"羽依里","text":"“没关系，我只是希望在夏天结束前，让你们两个好朋友能尽可能多留下一些回忆。”"},{"op":"image","layer":1,"image":"i14532"},{"op":"text","speaker":"紬","text":"“姆啾？……姆啾～？”"},{"op":"text","speaker":"羽依里","text":"“哎？怎么了吗？”"},{"op":"image","layer":1,"image":"i14554"},{"op":"text","speaker":"紬","text":"“我觉得羽依里先生也是我们的好朋友哦。”"},{"op":"image","layer":1,"image":"i14461"},{"op":"text","speaker":"紬","text":"“所以，也想创造一些你跟我们在一起的回忆。”"},{"op":"text","speaker":"羽依里","text":"“是、是吗。”"},{"op":"text","speaker":"","text":"她说得这么直白，听了真是让人难为情。"},{"op":"image","layer":257,"image":"i13891"},{"op":"text","speaker":"静久","text":"“她都这么说了哦。该怎么办呢，羽依里？”"},{"op":"text","speaker":"羽依里","text":"“好吧……那就我们三个人一起吧。”"},{"op":"image","layer":1,"image":"i14463"},{"op":"text","speaker":"紬","text":"“嗯，要三个人一起。”"},{"op":"text","speaker":"","text":"我们聊着这些事情，三个人一起欢笑着。"},{"op":"text","speaker":"","text":"但是，等夏天结束后……也许就再也没有机会三个人聚在一起了。"},{"op":"text","speaker":"","text":"虽然我们三个才见过几次面，但一想到夏天结束后的情景……就不禁有些寂寞。"},{"op":"image","layer":257,"image":"i13743"},{"op":"text","speaker":"静久","text":"“那个，像刚才那样的顾虑……或者是善意的谎言……以后就不要说了吧？”"},{"op":"text","speaker":"羽依里","text":"“哎？”"},{"op":"image","layer":257,"image":"i13832"},{"op":"text","speaker":"静久","text":"“只用真心话传达心意♪”"},{"op":"image","layer":257,"image":"i13743"},{"op":"text","speaker":"静久","text":"“我觉得，我们已经没有时间去说谎，或者掩盖自己的真情实感了。”"},{"op":"image","layer":257,"image":"i13962"},{"op":"text","speaker":"静久","text":"“如果喜欢的话就直说喜欢，好不好？”"},{"op":"image","layer":257,"image":"i13933"},{"op":"text","speaker":"静久","text":"“讨厌的话就要好好说出讨厌。”"},{"op":"image","layer":257,"image":"i13879"},{"op":"text","speaker":"静久","text":"“把想说的话全部说出来……彼此倾诉各种各样的感情。”"},{"op":"image","layer":257,"image":"i13852"},{"op":"text","speaker":"静久","text":"“就算是因此吵架了，也要告诉对方‘我不想就这样分开’。”"},{"op":"image","layer":257,"image":"i13813"},{"op":"text","speaker":"静久","text":"“怎么说呢……大概就是这种感觉？”"},{"op":"image","layer":257,"image":"i13820"},{"op":"text","speaker":"静久","text":"“你们觉得呢？”"},{"op":"text","speaker":"","text":"这个嘛……"},{"op":"text","speaker":"羽依里","text":"“或许也不错吧。”"},{"op":"image","layer":257,"image":"i13855"},{"op":"text","speaker":"静久","text":"“对吧？”"},{"op":"text","speaker":"","text":"虽然感觉会很害羞。"},{"op":"text","speaker":"","text":"不过跟这两个人的话，感觉什么话都能说得出口。"},{"op":"text","speaker":"","text":"紬从一开始就不像是会说谎的人。"},{"op":"text","speaker":"","text":"而且……我感觉三个人在一起，还能变得更加要好。"},{"op":"image","layer":1,"image":"i14558"},{"op":"text","speaker":"紬","text":"“我有问题！”"},{"op":"image","layer":257,"image":"i13938"},{"op":"text","speaker":"静久","text":"“说吧，紬！”"},{"op":"image","layer":1,"image":"i14446"},{"op":"text","speaker":"紬","text":"“我不太明白！”"},{"op":"image","layer":257,"image":"i13959"},{"op":"text","speaker":"静久","text":"“紬一直都做得很好，所以没问题的！”"},{"op":"image","layer":1,"image":"i14438"},{"op":"text","speaker":"紬","text":"“那就太好了！”"},{"op":"image","layer":257,"image":"i13898"},{"op":"text","speaker":"静久","text":"“对啦，那从今以后就不许说谎了哦♪”"},{"op":"text","speaker":"","text":"她开心地笑着说道。"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i184"},{"op":"clear","layer":65281},{"op":"image","layer":0,"image":"i378"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13864"},{"op":"text","speaker":"静久","text":"“啊……！差不多要去赶船了吧。”"},{"op":"text","speaker":"羽依里","text":"“咦？今天是不是早了点？”"},{"op":"text","speaker":"","text":"比平时提前了大约两班船。"},{"op":"image","layer":1,"image":"i13881"},{"op":"text","speaker":"静久","text":"“哎呀，毕竟才刚刚因为擅自在外面过夜被骂了，今天必须得早点回去了。”"},{"op":"text","speaker":"","text":"这么说倒也没错。"},{"op":"image","layer":1,"image":"i13927"},{"op":"text","speaker":"静久","text":"“如果你想的话，我可以把钥匙留下来，你们可以在海之家里接着待一会儿哦。”"},{"op":"image","layer":257,"image":"i14529"},{"op":"text","speaker":"紬","text":"“哦！听起来很有意思呢。”"},{"op":"image","layer":1,"image":"i13930"},{"op":"text","speaker":"静久","text":"“也可以打扫打扫卫生哦。”"},{"op":"image","layer":257,"image":"i14564"},{"op":"text","speaker":"紬","text":"“我会打扫得闪闪发亮的！”"},{"op":"image","layer":1,"image":"i13820"},{"op":"text","speaker":"静久","text":"“谢谢你♪”"},{"op":"text","speaker":"羽依里","text":"“那我送你去渡轮码头吧。”"},{"op":"image","layer":1,"image":"i13794"},{"op":"text","speaker":"静久","text":"“那就麻烦你啦。”"},{"op":"text","speaker":"羽依里","text":"“紬也一起去吧。”"},{"op":"image","layer":257,"image":"i14463"},{"op":"text","speaker":"紬","text":"“我还要打扫卫生，就不去了。”"},{"op":"text","speaker":"羽依里","text":"“这样啊。”"},{"op":"image","layer":1,"image":"i13782"},{"op":"text","speaker":"静久","text":"“那回头见♪”"},{"op":"image","layer":257,"image":"i14446"},{"op":"text","speaker":"紬","text":"“好的♪”"},{"op":"clear","layer":1},{"op":"clear","layer":257},{"op":"image","layer":0,"image":"i48"},{"op":"set","variable":6714,"value":0},{"op":"text","speaker":"","text":"两个人走在海滩上。"},{"op":"text","speaker":"羽依里","text":"“静久。”"},{"op":"text","speaker":"","text":"我伸出手。"},{"op":"image","layer":1,"image":"i13927"},{"op":"text","speaker":"静久","text":"“嗯♪”"},{"op":"text","speaker":"","text":"她自然地握住了。"},{"op":"text","speaker":"","text":"我和她并肩走着。"},{"op":"text","speaker":"","text":"虽然没有发生像漫画或电视剧里那样戏剧性的事情。"},{"op":"text","speaker":"","text":"就这样慢慢地走着。"},{"op":"text","speaker":"","text":"感到十分地身心舒畅。"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i2"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13820"},{"op":"text","speaker":"静久","text":"“那么，我去买票啦。”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"text","speaker":"","text":"静久的手从我的手中滑落了出去。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"","text":"感觉有点不舍。"},{"op":"text","speaker":"","text":"早知道就跟她一块过去了。"},{"op":"text","speaker":"؟؟؟","text":"“喂。”"},{"op":"text","speaker":"羽依里","text":"“……？”"},{"op":"text","speaker":"؟؟؟","text":"“就是你，外地人。”"},{"op":"text","speaker":"","text":"在这个岛上说到外地人的话。"},{"op":"text","speaker":"羽依里","text":"“是在说我……吗？”"},{"op":"text","speaker":"؟؟؟","text":"“对，就是你。你可以过来一下吗？”"},{"op":"text","speaker":"羽依里","text":"“你是谁啊……”"},{"op":"text","speaker":"德田","text":"“我是德田。”"},{"op":"text","speaker":"羽依里","text":"“就算你说是德田……”"},{"op":"text","speaker":"德田","text":"“难道你不认识德田!؟”"},{"op":"text","speaker":"羽依里","text":"“不认识。”"},{"op":"text","speaker":"德田","text":"“……明明我是德田。”"},{"op":"text","speaker":"","text":"看来他不打算进一步解释了。"},{"op":"text","speaker":"德田","text":"“算了无所谓，总之请你过来一下。”"},{"op":"text","speaker":"羽依里","text":"“不行啊，德田，我这会正在等人呢，不能随便去别的地方。”"},{"op":"text","speaker":"德田","text":"“那就在这里吧。”"},{"op":"text","speaker":"","text":"意外地还挺通情达理。"},{"op":"text","speaker":"羽依里","text":"“那个……什么事？”"},{"op":"text","speaker":"德田","text":"“为什么水织会长，会和你这样的人……”"},{"op":"text","speaker":"羽依里","text":"“你是静久的熟人吗？”"},{"op":"text","speaker":"德田","text":"“对，我是学生会的书记……德田。”"},{"op":"text","speaker":"羽依里","text":"“我已经知道你叫德田了。”"},{"op":"text","speaker":"羽依里","text":"“不过，原来你是学生会的人啊。想必会很优秀吧。”"},{"op":"text","speaker":"德田","text":"“当然。顺便说一下，我是岛上德田体育用品店老板的儿子。”"},{"op":"text","speaker":"德田","text":"“家里还算是有点钱。”"},{"op":"text","speaker":"","text":"虽然在炫耀，但又微妙地有分寸。"},{"op":"text","speaker":"德田","text":"“可是，为什么水织会长会和你这样的人……”"},{"op":"text","speaker":"德田","text":"“我不明白……！”"},{"op":"text","speaker":"羽依里","text":"“德田……你该不会是喜欢静久吧？”"},{"op":"text","speaker":"德田","text":"“不是！这种事……我怎么敢呢！”"},{"op":"text","speaker":"羽依里","text":"“哎……有那么夸张吗？”"},{"op":"text","speaker":"德田","text":"“当然。”"},{"op":"text","speaker":"德田","text":"“水织会长她是个完美的人……”"},{"op":"text","speaker":"德田","text":"“不仅成绩优秀，还很热心助人。”"},{"op":"text","speaker":"德田","text":"“从她身上，简直感觉不到任何的恶意。”"},{"op":"text","speaker":"","text":"这……倒是没错。"},{"op":"text","speaker":"德田","text":"“在学校里，不管遇到多么讨厌的事，遇到多么讨厌的人，她都不会在意。”"},{"op":"text","speaker":"德田","text":"“即便是一般人会忍不住发火骂人的情况下，她也会原谅对方。”"},{"op":"text","speaker":"德田","text":"“到第二天，她就像是什么都没发生过一样……继续和那个人友好相处。”"},{"op":"text","speaker":"羽依里","text":"“她真的好成熟啊。”"},{"op":"text","speaker":"德田","text":"“是啊，甚至说她太过成熟……也并不为过。”"},{"op":"text","speaker":"德田","text":"“就算遭遇了显而易见的恶意，第二天她也还是能若无其事。”"},{"op":"text","speaker":"羽依里","text":"“你很了解她啊……”"},{"op":"text","speaker":"德田","text":"“是啊。实不相瞒……因为我德田就曾经向她发泄过恶意。”"},{"op":"text","speaker":"","text":"确实，我多少也有这种感觉……"},{"op":"text","speaker":"德田","text":"“我仗着有钱有势，平时总是一副高高在上的态度……”"},{"op":"text","speaker":"德田","text":"“但有一天，我遇到真正的强者。”"},{"op":"text","speaker":"德田","text":"“成绩、人格、受人信赖、做事认真，还有其他很多方面……在她的优秀面前，我实在是相形见绌。”"},{"op":"text","speaker":"德田","text":"“我这才明白，她才是名副其实的人上之人……同时也是一个完美的人。”"},{"op":"text","speaker":"德田","text":"“不管我怎么努力，都无法企及她的高度。”"},{"op":"text","speaker":"德田","text":"“我的自尊心化作嫉妒……对她说了一些明显充斥着恶意的话。”"},{"op":"text","speaker":"德田","text":"“说了一次又一次……”"},{"op":"text","speaker":"德田","text":"“但她却每次都对我报以微笑。”"},{"op":"text","speaker":"德田","text":"“我在一气之下……触犯了禁忌。”"},{"op":"text","speaker":"羽依里","text":"“哎……”"},{"op":"text","speaker":"德田","text":"“因为我想要狠狠地伤害她……”"},{"op":"text","speaker":"德田","text":"“所以我对她说了……”"},{"op":"text","speaker":"德田","text":"“死……开……”"},{"op":"text","speaker":"羽依里","text":"“……原来如此。”"},{"op":"text","speaker":"德田","text":"“但这对她来说，似乎也没有什么效果。”"},{"op":"text","speaker":"德田","text":"“老实说，我甚至觉得很可怕……”"},{"op":"text","speaker":"德田","text":"“正面对抗赢不了她，而带着恶意接近她，也会被她一一化解。”"},{"op":"text","speaker":"德田","text":"“世上竟会有这样的人……”"},{"op":"text","speaker":"德田","text":"“但是……”"},{"op":"text","speaker":"德田","text":"“我意识到……她这样的人才是真正的强者。”"},{"op":"text","speaker":"德田","text":"“我……开始尊敬她了。”"},{"op":"text","speaker":"羽依里","text":"“这样啊……”"},{"op":"text","speaker":"羽依里","text":"“静久她……真是个了不起的人啊。”"},{"op":"text","speaker":"德田","text":"“所以我才很不解。”"},{"op":"text","speaker":"德田","text":"“为什么……她会和你这样的人交往？”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"德田","text":"“不……我倒也不是说你不好。”"},{"op":"text","speaker":"德田","text":"“只是她突然间……开始做起了咖喱，想要重建海之家。”"},{"op":"text","speaker":"德田","text":"“还会喊出一些下流的话……”"},{"op":"text","speaker":"羽依里","text":"“下流？”"},{"op":"text","speaker":"羽依里","text":"“你是指奶子吗？”"},{"op":"text","speaker":"德田","text":"“――什么!؟”"},{"op":"text","speaker":"德田","text":"“你、你这个不知羞耻的家伙！”"},{"op":"text","speaker":"","text":"真是纯情啊。"},{"op":"text","speaker":"德田","text":"“我希望水织会长……能变回从前的样子。”"},{"op":"text","speaker":"德田","text":"“你不这么想吗？”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“毕竟我……从来没见过你说的那个完美的静久。”"},{"op":"text","speaker":"德田","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“她会聊着天的时候说起奶子，又突然想要重建海之家，又开始做起了咖喱。”"},{"op":"text","speaker":"羽依里","text":"“她会害怕虫子大声尖叫，有时还会赶不上渡轮。”"},{"op":"text","speaker":"羽依里","text":"“我认识的静久，一点也不完美。”"},{"op":"text","speaker":"羽依里","text":"“但是我……就是喜欢上了这样的女孩。”"},{"op":"text","speaker":"德田","text":"“……是吗。”"},{"op":"text","speaker":"羽依里","text":"“她好像……不太喜欢为了迎合他人而行动的自己。”"},{"op":"text","speaker":"羽依里","text":"“似乎想要改变那个别人要求完美就会乖乖照做的自己。”"},{"op":"text","speaker":"羽依里","text":"“她为了建立自己的价值观……正在努力尝试各种各样的事情。”"},{"op":"text","speaker":"羽依里","text":"“虽然她的这副模样一点也不完美……但是在我看来，这样的她……该怎么说呢。”"},{"op":"text","speaker":"羽依里","text":"“是很有魅力……的吧。”"},{"op":"text","speaker":"德田","text":"“原来如此……”"},{"op":"text","speaker":"德田","text":"“没想到……我居然会听到这么大夸特夸的肉麻情话。”"},{"op":"text","speaker":"德田","text":"“你这家伙难道不知道害臊吗……！”"},{"op":"text","speaker":"羽依里","text":"“你刚才不也差不多吗？”"},{"op":"text","speaker":"","text":"性格别扭的德田。"},{"op":"text","speaker":"","text":"他这种人居然能像刚才那样夸个不停。"},{"op":"text","speaker":"","text":"为什么大家没有注意到静久的‘奶子’发言，我也总算有点理解了。"},{"op":"text","speaker":"","text":"刚才我听说的那个完美的人，确实不会说那种话。"},{"op":"text","speaker":"","text":"就算说了，我也会以为是自己听错了。"},{"op":"text","speaker":"德田","text":"“那我走了。”"},{"op":"text","speaker":"羽依里","text":"“嗯，好的。”"},{"op":"text","speaker":"羽依里","text":"“本以为你会跟我多纠缠一会儿，没想到这么干脆就走了。”"},{"op":"text","speaker":"德田","text":"“一直待在这种阳光下面，不习惯的人可是会晕倒的。”"},{"op":"text","speaker":"","text":"没想到是个好人……！"},{"op":"text","speaker":"羽依里","text":"“难道说，你刚才想换个地方也是为了……”"},{"op":"text","speaker":"德田","text":"“为了预防中暑。”"},{"op":"text","speaker":"","text":"没想到这么懂事！"},{"op":"text","speaker":"德田","text":"“那么再见了。”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"text","speaker":"","text":"我跟德田道别。"},{"op":"text","speaker":"静久","text":"“……你们聊完了？”"},{"op":"text","speaker":"羽依里","text":"“嗯。”"},{"op":"image","layer":1,"image":"i13846"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“咦？你什么时候回来的？”"},{"op":"image","layer":1,"image":"i13832"},{"op":"text","speaker":"静久","text":"“应该有一会儿了吧？”"},{"op":"image","layer":1,"image":"i13823"},{"op":"text","speaker":"静久","text":"“羽依里刚才夸了我好几句呢♪”"},{"op":"text","speaker":"羽依里","text":"“你都听到了啊……”"},{"op":"text","speaker":"","text":"好害羞。"},{"op":"image","layer":1,"image":"i13858"},{"op":"text","speaker":"静久","text":"“我很有魅力？”"},{"op":"text","speaker":"羽依里","text":"“……是啊。”"},{"op":"image","layer":1,"image":"i13886"},{"op":"text","speaker":"静久","text":"“呵呵♪谢谢。”"},{"op":"image","layer":1,"image":"i13959"},{"op":"text","speaker":"静久","text":"“还有……我听到了……”"},{"op":"image","layer":1,"image":"i13820"},{"op":"text","speaker":"静久","text":"“你好像说喜欢我？”"},{"op":"text","speaker":"羽依里","text":"“啊……”"},{"op":"text","speaker":"","text":"被她听到了。"},{"op":"image","layer":1,"image":"i13849"},{"op":"text","speaker":"静久","text":"“不是像之前说的‘会喜欢上’。”"},{"op":"image","layer":1,"image":"i13782"},{"op":"text","speaker":"静久","text":"“……说的是喜欢？”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“是啊。”"},{"op":"image","layer":1,"image":"i13884"},{"op":"text","speaker":"静久","text":"“……”"},{"op":"image","layer":1,"image":"i13888"},{"op":"text","speaker":"静久","text":"“这样啊。”"},{"op":"text","speaker":"羽依里","text":"“嗯，因为不能说谎嘛。”"},{"op":"image","layer":0,"image":"i190"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"image","layer":1,"image":"i13892"},{"op":"text","speaker":"静久","text":"“呵呵♪我也觉得羽依里很有魅力哦。”"},{"op":"text","speaker":"羽依里","text":"“谢谢。”"},{"op":"image","layer":1,"image":"i13887"},{"op":"text","speaker":"静久","text":"“而且……”"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"三毛猫","text":"“喵――”"},{"op":"clear","layer":1},{"op":"image","layer":0,"image":"i2"},{"op":"set","variable":6714,"value":0},{"op":"image","layer":1,"image":"i13911"},{"op":"text","speaker":"静久","text":"“哎？”"},{"op":"text","speaker":"","text":"不知什么时候，那只熟悉的猫出现在了我的脚边。"},{"op":"image","layer":1,"image":"i13837"},{"op":"text","speaker":"静久","text":"“啊！渡轮要出发了！”"},{"op":"text","speaker":"羽依里","text":"“嗯，得抓紧了！”"},{"op":"image","layer":1,"image":"i13884"},{"op":"text","speaker":"静久","text":"“嗯、嗯……！”"},{"op":"image","layer":1,"image":"i13957"},{"op":"text","speaker":"静久","text":"“那……明天见。”"},{"op":"text","speaker":"羽依里","text":"“嗯，明天见。”"},{"op":"text","speaker":"","text":"静久依依不舍地跟我挥了挥手，朝渡轮跑去。"},{"op":"text","speaker":"羽依里","text":"“……”"},{"op":"text","speaker":"羽依里","text":"“啊。谢谢你提醒渡轮要开了。”"},{"op":"text","speaker":"三毛猫","text":"“喵―”"},{"op":"text","speaker":"","text":"我和猫咪一起，目送着渡轮离开。"},{"op":"text","speaker":"","text":"不过，有点在意她最后没说完的那句话……"},{"op":"text","speaker":"羽依里","text":"“没事，反正明天还能见到她。”"},{"op":"image","layer":0,"image":"i184"},{"op":"set","variable":6714,"value":0},{"op":"clear","layer":1},{"op":"clear","layer":65281},{"op":"set","variable":23,"value":0},{"op":"set","variable":19,"value":0},{"op":"set","variable":20,"value":0},{"op":"set","variable":21,"value":0},{"op":"set","variable":7120,"value":0},{"op":"return"},{"op":"end"}]